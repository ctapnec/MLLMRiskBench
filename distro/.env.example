# URA-Bench rig secrets - copy to ~/.ura_env (chmod 600) and fill in.
# ~/.ura_env is the CANONICAL operator secrets file: distro/install.sh, the
# console launcher and distro/repin.sh source it LAST (so it wins), and the
# console's Config page writes rotated keys into it. ~/.ura_secrets is an
# optional legacy file from earlier installers, sourced first and overridden by
# ~/.ura_env. This file is a template only and must never contain real keys;
# neither ~/.ura_env nor ~/.ura_secrets is tracked by git.

# Hugging Face token (gated datasets - AgentHarm, DecodingTrust, HoliSafe - and
# higher rate limits). The console holds it write-only/process-memory.
export HF_TOKEN=

# --- Provider API keys (only needed for measured/paid campaigns, never for the
# offline dry-run / preflight lanes). Full roster the code reads:
#   src/ura/targets/api.py + experiments/rig_web_app/{settings,lifecycle}.py
export ANTHROPIC_API_KEY=          # Anthropic (focal Fable + Haiku judge)
export OPENAI_API_KEY=             # OpenAI (focal Sol)
export GEMINI_API_KEY=             # Google Gemini (GOOGLE_API_KEY honored too)
export DEEPSEEK_API_KEY=           # DeepSeek
export MOONSHOT_API_KEY=           # Moonshot (Kimi)
export DASHSCOPE_API_KEY=          # Alibaba DashScope (Qwen)
export ZHIPU_API_KEY=              # Zhipu (GLM / z.ai)
export ARK_API_KEY=                # ByteDance Volc Ark (Doubao)

# --- Optional endpoint overrides (defaults live in src/ura/targets/api.py):
# export URA_DEEPSEEK_BASE_URL=
# export URA_KIMI_BASE_URL=
# export URA_QWEN_BASE_URL=
# export URA_GLM_BASE_URL=

# --- Checkout + interpreter (NOT secrets). distro/install.sh locators appends
# these two bindings to ~/.ura_campaign_env; the runbook's ura_native_session /
# ura_native_run wrapper runs its logger with $URA_PY (the main venv
# interpreter) from $URA_REPO (the tracked checkout). Set them here only on a
# rig provisioned by hand, without distro/install.sh.
# export URA_REPO=$HOME/MLLMRiskBench
# export URA_PY=$URA_REPO/.venv/bin/python
