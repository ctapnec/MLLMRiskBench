# URA-Bench rig secrets - copy to ~/.ura_secrets and fill in.
# distro/install.sh sources ~/.ura_secrets; this file is a template only and must
# never contain real keys. ~/.ura_secrets is NOT tracked by git.

# Hugging Face token (gated datasets - AgentHarm, DecodingTrust, HoliSafe - and
# higher rate limits). The console holds it write-only/process-memory.
export HF_TOKEN=

# --- Provider API keys (only needed for measured/paid campaigns, never for the
# offline dry-run / preflight lanes). Full roster the code reads:
#   src/ura/targets/api.py + experiments/rig_web_app/{settings,lifecycle}.py
export ANTHROPIC_API_KEY=          # Anthropic (focal Fable + Haiku judge)
export OPENAI_API_KEY=             # OpenAI (focal Sol)
export GEMINI_API_KEY=             # Google Gemini (GOOGLE_API_KEY honored too)
export DEEPSEEK_API_KEY=           # DeepSeek
export MOONSHOT_API_KEY=           # Moonshot (Kimi)
export DASHSCOPE_API_KEY=          # Alibaba DashScope (Qwen)
export ZHIPU_API_KEY=              # Zhipu (GLM / z.ai)
export ARK_API_KEY=                # ByteDance Volc Ark (Doubao)

# --- Optional endpoint overrides (defaults live in src/ura/targets/api.py):
# export URA_DEEPSEEK_BASE_URL=
# export URA_KIMI_BASE_URL=
# export URA_QWEN_BASE_URL=
# export URA_GLM_BASE_URL=
