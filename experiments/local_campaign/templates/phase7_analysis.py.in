                                        }
                                    ],
                                }
                            }
                        }
                    }
                }
            )
        )
        artifact_inputs["eligibility_plan"] = descriptor(eligibility_path)
        acquisition_receipt_path = Path(
            artifact_inputs["acquisition_receipt"]["path"]
        )
        target_revision = "1" * 40
        receipt_resources = [
            {
                "resource_id": f"hf://Qwen/Qwen3-VL-8B-Instruct@{target_revision}",
                "repo_id": "Qwen/Qwen3-VL-8B-Instruct",
                "revision": target_revision,
                "roles": ["vllm_target"],
            },
            {
                "resource_id": (
                    f"hf://{EXPECTED_DEFENSE_GUARDRAIL_MODEL}@"
                    f"{EXPECTED_DEFENSE_GUARDRAIL_REVISION}"
                ),
                "repo_id": EXPECTED_DEFENSE_GUARDRAIL_MODEL,
                "revision": EXPECTED_DEFENSE_GUARDRAIL_REVISION,
