                evidence_path = temp / (
                    f"live-attestation-{source_live['sha256'][:24]}.json"
                )
                evidence_path.write_bytes(Path(source_live["path"]).read_bytes())
            else:
                evidence_path = temp / f"defense-v2-{name}.fixture"
                evidence_path.write_bytes(
                    b"" if name.startswith("empty_") else b"{}\n"
                )
            artifact_v2["artifacts"][name] = descriptor(evidence_path)
        retained_live = artifact_v2["artifacts"]["retained_live_attestation"]
