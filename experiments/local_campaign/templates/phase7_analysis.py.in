            "acquisition_receipt",
            "acquisition_result_log",
            "live_attestation",
            "local_config",
            "project_revision",
            "source_config",
            "source_conformance",
        ):
            path = temp / f"{name}.json"
            path.write_bytes(canonical({"fixture": name}))
            artifact_inputs[name] = descriptor(path)
        attestation_id = "live-attestation-" + "a" * 24
        live_attestation_path = Path(artifact_inputs["live_attestation"]["path"])
        live_attestation_path.write_bytes(
            canonical({"attestation_id": attestation_id})
        )
        artifact_inputs["live_attestation"] = descriptor(live_attestation_path)
        eligibility_path = Path(artifact_inputs["eligibility_plan"]["path"])
        eligibility_path.write_bytes(
