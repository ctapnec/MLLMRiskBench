                                    "max_age_hours": 24.0,
                                    "artifacts": [
                                        {
                                            "file": live_attestation_path.name,
                                            "sha256": artifact_inputs[
                                                "live_attestation"
                                            ]["sha256"],
                                            "bytes": artifact_inputs[
