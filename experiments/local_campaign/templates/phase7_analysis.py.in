                "source_conformance_sha256": EXPECTED_SOURCE_CONFORMANCE_SHA256,
                "source_config_sha256": artifact_inputs["source_config"]["sha256"],
                "cuda_visible_devices": "0,1",
                "target": {
                    "spec": "vllm:Qwen/Qwen3-VL-8B-Instruct",
                    "revision": target_revision,
                    "config_sha256": artifact_inputs["local_config"]["sha256"],
                },
                "scoring_guard": {
