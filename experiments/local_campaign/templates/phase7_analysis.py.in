            },
            {
                "resource_id": (
                    f"hf://{EXPECTED_GUARDRAIL_MODEL}@{EXPECTED_GUARDRAIL_REVISION}"
                ),
                "repo_id": EXPECTED_GUARDRAIL_MODEL,
                "revision": EXPECTED_GUARDRAIL_REVISION,
                "roles": ["guardrail_judge"],
            },
        ]
        acquisition_receipt_path.write_bytes(
