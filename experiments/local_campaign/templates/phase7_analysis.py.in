        ),
        "planned_contrast_missing": True,
        "reason_code": RR_RUNTIME_TERMINAL_REASON_CODE,
        "reason": RR_RUNTIME_TERMINAL_REASON,
        "terminal_lanes": list(RR_RUNTIME_TERMINAL_LANES),
        "target_runtime_terminal_artifact": dict(rr_terminal_descriptor),
        "analysis_ready_real_run": False,
        "estimate": None,
        "paired_compare_invoked": False,
        "rr_responses_admitted": 0,
        "human_audit_eligible": False,
    }
    AnalysisController._validate_non_estimable_rr_contrast(
        None,
        value=contrast,
        corpus=contrast_corpus,
        terminal_descriptor=rr_terminal_descriptor,
    )
    for mutation_name, mutate in (
        ("fabricated-estimate", lambda value: value.__setitem__("estimate", 0.0)),
        (
            "paired-invocation",
            lambda value: value.__setitem__("paired_compare_invoked", True),
        ),
        (
            "human-audit-eligible",
            lambda value: value.__setitem__("human_audit_eligible", True),
        ),
        (
            "wrong-terminal",
            lambda value: value["target_runtime_terminal_artifact"].__setitem__(
                "sha256", "e" * 64
            ),
        ),
    ):
        mutation = copy.deepcopy(contrast)
        mutate(mutation)
        must_fail(
            f"rr-non-estimable-contrast-{mutation_name}",
            lambda mutation=mutation: AnalysisController._validate_non_estimable_rr_contrast(
                None,
                value=mutation,
                corpus=contrast_corpus,
                terminal_descriptor=rr_terminal_descriptor,
            ),
        )

    with tempfile.TemporaryDirectory(
        prefix="ura-phase7-conditional-defense-contract-"
    ) as temp_value:
        temp = Path(temp_value).resolve(strict=True)
        artifact_inputs: dict[str, dict[str, Any]] = {}
        for name in (
            "runner_log",
            "budget_ledger",
            "invocation_deadline",
            "request_envelope",
            "eligibility_plan",
            "lane_projection",
