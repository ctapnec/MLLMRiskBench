                {
                    "receipt_id": "conditional-defense-self-test",
                    "resources": receipt_resources,
                }
            )
        )
        artifact_inputs["acquisition_receipt"] = descriptor(
            acquisition_receipt_path
        )
        acquisition_result_path = Path(
            artifact_inputs["acquisition_result_log"]["path"]
        )
        acquisition_result_path.write_bytes(
            canonical(
                {
                    "downloaded_bytes": 0,
                    "receipt_id": "conditional-defense-self-test",
                    "receipt_sha256": artifact_inputs["acquisition_receipt"][
                        "sha256"
                    ],
                }
            )
        )
        artifact_inputs["acquisition_result_log"] = descriptor(
            acquisition_result_path
        )
        original_project_sha = EXPECTED_PROJECT_REVISION_SHA256
        original_source_sha = EXPECTED_SOURCE_CONFORMANCE_SHA256
        globals()["EXPECTED_PROJECT_REVISION_SHA256"] = artifact_inputs[
            "project_revision"
        ]["sha256"]
        globals()["EXPECTED_SOURCE_CONFORMANCE_SHA256"] = artifact_inputs[
            "source_conformance"
        ]["sha256"]
        artifact = {
            "schema": DEFENSE_LOCAL_CONDITIONAL_SCHEMA,
            "status": "N/A",
            "lane_id": DEFENSE_LOCAL_LANE,
            "disposition": "conditional_na",
            "reason_code": DEFENSE_LOCAL_CONDITIONAL_REASON_CODE,
            "reason": DEFENSE_LOCAL_CONDITIONAL_REASON,
            "classified_at_utc": "2026-08-22T00:00:00Z",
            "classification": {
                "category": "co_resident_cuda_oom",
                "runner_lifecycle_phase": "model_preload_before_grid_start",
                "positive_evidence": "run_matrix_lifecycle_error_cuda_out_of_memory",
