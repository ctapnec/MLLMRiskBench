            "call_accounting": copy.deepcopy(variant_v2["accounting"]),
            "runner_outputs": copy.deepcopy(variant_v2["runner_outputs"]),
            "evidence_limits": copy.deepcopy(variant_v2["evidence_limits"]),
        })
        for name in variant_v2["artifacts"] - set(artifact_v2["artifacts"]):
            if name == "retained_live_attestation":
