    zero_contracts = {
        "phase6-core": (
            "hosted_target_calls",
            "hosted_judge_calls",
            "provider_http_attempts",
            "downloads_observed_bytes",
        ),
        "phase6-extended": (
            "hosted_target_calls",
            "hosted_judge_calls",
            "http_attempts",
            "paid_provider_calls",
            "model_downloads",
            "downloads_observed_bytes",
        ),
        "phase6-native": (
            "hosted_target_calls",
            "hosted_judge_calls",
            "provider_http_attempts",
            "downloads_observed_bytes",
        ),
    }
    for label, fields in zero_contracts.items():
        valid = {field: 0 for field in fields}
        require_zero_accounting(valid, fields=fields, label=label)
        for field in fields:
            missing = dict(valid)
            missing.pop(field)
            must_fail(
                f"{label}-missing-{field}",
                lambda missing=missing, fields=fields, label=label: (
                    require_zero_accounting(missing, fields=fields, label=label)
                ),
            )
            nonzero = dict(valid)
            nonzero[field] = 1
            must_fail(
                f"{label}-nonzero-{field}",
                lambda nonzero=nonzero, fields=fields, label=label: (
                    require_zero_accounting(nonzero, fields=fields, label=label)
                ),
            )
            boolean_zero = dict(valid)
            boolean_zero[field] = False
            must_fail(
                f"{label}-boolean-zero-{field}",
                lambda boolean_zero=boolean_zero, fields=fields, label=label: (
                    require_zero_accounting(boolean_zero, fields=fields, label=label)
                ),
            )

    for controller, identity in FROZEN_PHASE6_PAYLOADS.items():
        valid_payload = {"path": f"/frozen/{controller}", **identity}
        require_frozen_phase6_payload(
            valid_payload,
            controller=controller,
            label=f"Phase 6 {controller} payload",
        )
        for mutation_name, field, replacement in (
            ("forged-sha", "sha256", "d" * 64),
            ("forged-bytes", "bytes", identity["bytes"] + 1),
            ("boolean-bytes", "bytes", False),
        ):
            mutation = dict(valid_payload)
            mutation[field] = replacement
            must_fail(
                f"phase6-{controller}-payload-{mutation_name}",
                lambda mutation=mutation, controller=controller: (
                    require_frozen_phase6_payload(
                        mutation,
                        controller=controller,
                        label=f"Phase 6 {controller} payload",
                    )
                ),
            )

    order_contracts = {
        "phase6-core-lanes": CORE_LANES,
        "phase6-extended-lanes": EXTENDED_LANES,
        "phase6-native-engines": NATIVE_ENGINES,
    }
    for label, expected in order_contracts.items():
        valid = list(expected)
        require_exact_order(valid, expected=expected, label=label)
        missing = valid[:-1]
        must_fail(
            f"{label}-missing",
            lambda missing=missing, expected=expected, label=label: require_exact_order(
                missing, expected=expected, label=label
            ),
        )
        swapped = list(valid)
        swapped[0], swapped[1] = swapped[1], swapped[0]
        must_fail(
            f"{label}-swapped",
            lambda swapped=swapped, expected=expected, label=label: require_exact_order(
                swapped, expected=expected, label=label
            ),
        )
        forged = [*valid, "forged-upstream-item"]
        must_fail(
            f"{label}-forged",
            lambda forged=forged, expected=expected, label=label: require_exact_order(
                forged, expected=expected, label=label
            ),
        )

    partition_order = ("lane-a", "lane-b", "lane-c")
    partition_states = {
        "lane-a": "measured_complete",
        "lane-b": "failed",
        "lane-c": "measured_complete",
    }
    require_terminal_partition(
        partition_states,
        order=partition_order,
        success_state="measured_complete",
        success_keys={"lane-a", "lane-c"},
        failure_keys={"lane-b"},
        label="terminal-partition-self-test",
    )
    for label, states, successes, failures in (
        (
            "terminal-partition-missing-state",
            {"lane-a": "measured_complete", "lane-b": "failed"},
            {"lane-a"},
            {"lane-b", "lane-c"},
        ),
        (
            "terminal-partition-invalid-state",
            {**partition_states, "lane-b": "complete"},
            {"lane-a", "lane-c"},
            {"lane-b"},
        ),
        (
            "terminal-partition-overlap",
            partition_states,
            {"lane-a", "lane-b", "lane-c"},
            {"lane-b"},
        ),
        (
            "terminal-partition-swapped",
            partition_states,
            {"lane-a", "lane-b"},
            {"lane-c"},
        ),
    ):
        must_fail(
            label,
            lambda states=states, successes=successes, failures=failures: (
                require_terminal_partition(
                    states,
                    order=partition_order,
                    success_state="measured_complete",
                    success_keys=successes,
                    failure_keys=failures,
                    label="terminal-partition-self-test",
                )
            ),
        )

    lifecycle_states = {
        "lane-a": "complete",
        "lane-b": "partial",
        "lane-c": "complete",
    }
    require_lifecycle_metric_partition(
        scheduled_lanes=partition_order,
        terminal_states=partition_states,
        metric_lanes=("lane-a", "lane-c"),
        lifecycle_states=lifecycle_states,
    )
    lifecycle_cases = {
        "complete": lifecycle_authorization_status(
            terminal_state="measured_complete",
            lifecycle_state="complete",
            artifact_kinds=lifecycle_artifact_kinds(
                grid_statuses=["complete"],
                measured_request_envelopes=1,
                eligibility_artifacts=1,
                error_artifacts=0,
            ),
        ),
        "partial": lifecycle_authorization_status(
            terminal_state="failed",
            lifecycle_state="partial",
            artifact_kinds=lifecycle_artifact_kinds(
                grid_statuses=["partial"],
                measured_request_envelopes=1,
                eligibility_artifacts=1,
                error_artifacts=1,
            ),
        ),
        "failed-after-request": lifecycle_authorization_status(
            terminal_state="failed",
            lifecycle_state="failed",
            artifact_kinds=lifecycle_artifact_kinds(
                grid_statuses=["running"],
                measured_request_envelopes=0,
                eligibility_artifacts=0,
                error_artifacts=1,
            ),
        ),
        "pre-runner-no-request": lifecycle_authorization_status(
            terminal_state="failed",
            lifecycle_state="failed",
            artifact_kinds=lifecycle_artifact_kinds(
                grid_statuses=[],
                measured_request_envelopes=0,
                eligibility_artifacts=0,
                error_artifacts=0,
                pre_runner_failure_artifacts=1,
            ),
        ),
    }
    if lifecycle_cases != {
        "complete": "complete_runner_grid",
        "partial": "partial_runner_grid",
        "failed-after-request": "failed_after_runner_request",
        "pre-runner-no-request": "pre_runner_failure_no_request_artifact",
    }:
        raise Phase7Error("lifecycle authorization case self-test changed")
    empty_kinds = lifecycle_artifact_kinds(
        grid_statuses=[],
        measured_request_envelopes=0,
        eligibility_artifacts=0,
        error_artifacts=0,
    )
    envelope_only_kinds = lifecycle_artifact_kinds(
        grid_statuses=[],
        measured_request_envelopes=1,
        eligibility_artifacts=0,
        error_artifacts=0,
    )
    for label, terminal, lifecycle, kinds in (
        (
            "lifecycle-complete-without-artifact",
            "measured_complete",
            "complete",
            empty_kinds,
        ),
        ("lifecycle-partial-without-artifact", "failed", "partial", empty_kinds),
        (
            "lifecycle-pre-runner-without-typed-artifact",
            "failed",
            "failed",
            empty_kinds,
        ),
        (
            "lifecycle-failed-marked-complete",
            "failed",
            "complete",
            envelope_only_kinds,
        ),
        ("lifecycle-unknown-terminal", "running", "failed", empty_kinds),
    ):
        must_fail(
            label,
            lambda terminal=terminal, lifecycle=lifecycle, kinds=kinds: (
                lifecycle_authorization_status(
                    terminal_state=terminal,
                    lifecycle_state=lifecycle,
                    artifact_kinds=kinds,
                )
            ),
        )
    for label, metric_lanes, lifecycle in (
        (
            "lifecycle-failure-promoted-to-metric",
            ("lane-a", "lane-b", "lane-c"),
            lifecycle_states,
        ),
        (
            "lifecycle-failure-omitted",
            ("lane-a", "lane-c"),
            {"lane-a": "complete", "lane-c": "complete"},
        ),
        (
            "lifecycle-failure-misreported-complete",
            ("lane-a", "lane-c"),
            {**lifecycle_states, "lane-b": "complete"},
        ),
    ):
        must_fail(
            label,
            lambda metric_lanes=metric_lanes, lifecycle=lifecycle: (
                require_lifecycle_metric_partition(
                    scheduled_lanes=partition_order,
                    terminal_states=partition_states,
                    metric_lanes=metric_lanes,
                    lifecycle_states=lifecycle,
                )
            ),
        )

    boundary_fixture = {
        "metric_lane_order": [
            "common-lane", "classification-lane", "proxy-lane"
        ],
        "classification_lanes": ["classification-lane"],
        "cascade_expected_lanes": ["common-lane", "proxy-lane"],
        "proxy_expected_conditions": [{
            "lane_id": "proxy-lane", "model_spec": "vllm:fixture/model",
            "corpus_arm": PROMPT_PROXY_ARM, "attacker": "purplellama",
            "required_metric": PROMPT_PROXY_METRIC,
        }],
    }
    boundary = expected_metric_boundary_contract(boundary_fixture)
    if (
        boundary["expected_classification"] is not True
        or boundary["expected_cascade"] is not True
        or boundary["expected_approximate"] is not True
    ):
        raise Phase7Error("metric-boundary self-test did not realize exact modes")
    no_proxy = copy.deepcopy(boundary_fixture)
    no_proxy["proxy_expected_conditions"] = []
    no_proxy_boundary = expected_metric_boundary_contract(no_proxy)
    if (
        no_proxy_boundary["expected_cascade"] is not True
        or no_proxy_boundary["expected_approximate"] is not False
    ):
        raise Phase7Error(
            "rules/guardrail cascade was incorrectly treated as realized approximation"
        )
    proxy_not_cascade = copy.deepcopy(boundary_fixture)
    proxy_not_cascade["cascade_expected_lanes"] = ["common-lane"]
    must_fail(
        "metric-boundary-proxy-without-cascade",
        lambda: expected_metric_boundary_contract(proxy_not_cascade),
    )
    duplicate_proxy = copy.deepcopy(boundary_fixture)
    duplicate_proxy["proxy_expected_conditions"].append(
        copy.deepcopy(duplicate_proxy["proxy_expected_conditions"][0])
    )
    must_fail(
        "metric-boundary-duplicate-proxy",
        lambda: expected_metric_boundary_contract(duplicate_proxy),
    )
    unknown_proxy = copy.deepcopy(boundary_fixture)
    unknown_proxy["proxy_expected_conditions"][0]["lane_id"] = "missing-lane"
    must_fail(
        "metric-boundary-unknown-proxy-lane",
        lambda: expected_metric_boundary_contract(unknown_proxy),
    )
    overlapping_modes = copy.deepcopy(boundary_fixture)
    overlapping_modes["classification_lanes"].append("common-lane")
    must_fail(
        "metric-boundary-overlapping-modes",
        lambda: expected_metric_boundary_contract(overlapping_modes),
    )

    proxy_key = next(iter(boundary["proxy_conditions"]))
    abstained_stratum = {
        "model_spec": proxy_key[0],
        "corpus_arm": proxy_key[1],
        "attacker": proxy_key[2],
        "source_metric_family": proxy_key[3],
        "common_metrics_eligible": False,
        "execution_mode": "static_or_exact_replay",
        "expected_behavior": "safe_answer",
        "measurement_families": [
            "approximate_benign_refusal_rate",
            "classification_quality",
        ],
        "n_completed_records": 2,
        "n_source_clusters": 2,
        "label_counts": {"not_applicable": 2},
        "approximate_proxy_label_counts": {},
        "n_approximate_proxy_abstained": 2,
        "n_approximate_strongreject_graded": 0,
        "descriptive_common_endpoint": {
            "endpoint": "approximate_over_refusal_rate",
            "value": None,
            "reason": "no_decided_judgments",
            "decision_support": {
                "judgments_completed": 2,
                "judgments_evaluable": 2,
                "judgments_decided": 0,
                "judgments_abstained": 2,
                "decision_coverage": 0.0,
            },
            "metric_authority": "supplementary_non_authoritative",
        },
    }
    abstained_suite = {"runner": {"strata": [abstained_stratum]}}

    def require_exact_abstained_suite(value: Mapping[str, Any]) -> None:
        if all_abstained_proxy_conditions(
            value, boundary["proxy_conditions"]
        ) != {proxy_key}:
            raise Phase7Error("exact all-abstained proxy condition was not retained")

    require_exact_abstained_suite(abstained_suite)
    if proxy_condition_observation_counts(
        abstained_suite, boundary["proxy_conditions"]
    ) != {
        proxy_key: {"completed_records": 2, "typed_abstentions": 2}
    }:
        raise Phase7Error("proxy condition realization counts changed")
    for label, mutate in (
        (
            "metric-boundary-abstention-reason",
            lambda value: value["runner"]["strata"][0][
                "descriptive_common_endpoint"
            ].__setitem__("reason", "generic_failure"),
        ),
        (
            "metric-boundary-abstention-coverage",
            lambda value: value["runner"]["strata"][0][
                "descriptive_common_endpoint"
            ]["decision_support"].__setitem__("decision_coverage", 1.0),
        ),
        (
            "metric-boundary-abstention-count",
            lambda value: value["runner"]["strata"][0].__setitem__(
                "n_approximate_proxy_abstained", 1
            ),
        ),
    ):
        mutation = copy.deepcopy(abstained_suite)
        mutate(mutation)
        must_fail(
            label,
            lambda mutation=mutation: require_exact_abstained_suite(mutation),
        )
    malformed_counts = copy.deepcopy(abstained_suite)
    malformed_counts["runner"]["strata"][0]["n_completed_records"] = True
    must_fail(
        "metric-boundary-boolean-condition-count",
        lambda: proxy_condition_observation_counts(
            malformed_counts, boundary["proxy_conditions"]
        ),
    )

    aggregate_rows: list[dict[str, Any]] = []
    for cohort in CAMPAIGN_COHORTS:
        state = {
            "canonical": "measured_complete",
            "output_policy_amendment": "measured_complete",
            "followon_prepared": "measured_complete",
            "native": "run",
        }[cohort]
        for index in range(CAMPAIGN_COHORT_COUNTS[cohort]):
            logical_id = f"fixture-{index:02d}"
            aggregate_rows.append({
                "key": f"{cohort}:{logical_id}",
                "cohort": cohort,
                "logical_id": logical_id,
                "terminal_state": state,
                "failure": False,
                "project_revision_stratum": "a" * 64,
                "source_conformance_stratum": (
                    "not_applicable" if cohort == "native" else "b" * 64
                ),
                "evidence": {"fixture": True},
            })

    def aggregate_fixture(rows: Sequence[Mapping[str, Any]]) -> dict[str, Any]:
        copied = copy.deepcopy(list(rows))
        failures = [row["key"] for row in copied if row["failure"]]
        project_strata: dict[str, list[str]] = {}
        source_strata: dict[str, list[str]] = {}
        for row in copied:
            project_strata.setdefault(row["project_revision_stratum"], []).append(row["key"])
            source_strata.setdefault(row["source_conformance_stratum"], []).append(row["key"])
        return {
            "schema": PHASE6_CAMPAIGN_INVENTORY_SCHEMA,
            "status": "complete_with_failures" if failures else "complete",
            "cohort_order": list(CAMPAIGN_COHORTS),
            "cohort_counts": dict(CAMPAIGN_COHORT_COUNTS),
            "row_order": [row["key"] for row in copied],
            "rows": copied,
            "failure_rows": failures,
            "project_revision_strata": project_strata,
            "source_conformance_strata": source_strata,
            "all_rows_terminal": True,
            "cross_revision_pooling_permitted": False,
            "cross_source_pooling_permitted": False,
            "accounting": {
                "hosted_target_calls": 0, "hosted_judge_calls": 0,
                "provider_http_attempts": 0, "paid_provider_calls": 0,
                "model_downloads": 0,
            },
        }

    valid_aggregate = aggregate_fixture(aggregate_rows)
    validate_phase6_campaign_terminal_inventory(valid_aggregate)
    must_fail(
        "campaign-terminal-64-rows",
        lambda: validate_phase6_campaign_terminal_inventory(
            aggregate_fixture(aggregate_rows[:-1])
        ),
    )
    extra_rows = copy.deepcopy(aggregate_rows)
    extra = copy.deepcopy(extra_rows[0])
    extra["logical_id"] = "fixture-extra"
    extra["key"] = "canonical:fixture-extra"
    extra_rows.append(extra)
    must_fail(
        "campaign-terminal-66-rows",
        lambda: validate_phase6_campaign_terminal_inventory(
            aggregate_fixture(extra_rows)
        ),
    )
    for label, mutate in (
        (
            "campaign-terminal-duplicate-key",
            lambda rows: rows[1].update({
                "key": rows[0]["key"], "logical_id": rows[0]["logical_id"]
            }),
        ),
        (
            "campaign-terminal-unnamespaced-key",
            lambda rows: rows[0].__setitem__("key", rows[0]["logical_id"]),
        ),
        (
            "campaign-terminal-invalid-state",
            lambda rows: rows[0].__setitem__("terminal_state", "running"),
        ),
        (
            "campaign-terminal-invalid-project-stratum",
            lambda rows: rows[0].__setitem__("project_revision_stratum", "c" * 63),
        ),
    ):
        mutation_rows = copy.deepcopy(aggregate_rows)
        mutate(mutation_rows)
        must_fail(
            label,
            lambda mutation_rows=mutation_rows: validate_phase6_campaign_terminal_inventory(
                aggregate_fixture(mutation_rows)
            ),
        )
    invalid_status = copy.deepcopy(valid_aggregate)
    invalid_status["status"] = "running"
    must_fail(
        "campaign-terminal-invalid-status",
        lambda: validate_phase6_campaign_terminal_inventory(invalid_status),
    )
    early_failure_rows = copy.deepcopy(aggregate_rows)
    early_failure_rows[0]["terminal_state"] = "partial"
    early_failure_rows[0]["failure"] = True
    early_failure = aggregate_fixture(early_failure_rows)
    validated_early_failure = validate_phase6_campaign_terminal_inventory(
        early_failure
    )
    if (
        validated_early_failure["status"] != "complete_with_failures"
        or validated_early_failure["failure_rows"] != [early_failure_rows[0]["key"]]
        or len(validated_early_failure["rows"]) != 65
    ):
        raise Phase7Error("early terminal failure suppressed independent rows")

    print(
        json.dumps(
            {
                "schema": "ura-phase7-contract-self-test/1",
                "status": "passed",
                "mutations_rejected": len(rejected),
                "contracts": sorted(
                    {
                        *field_contracts,
                        *zero_contracts,
                        *order_contracts,
                        "gate5-terminal-inventory",
                        "gate5-conditional-defense-profiles",
                        "phase6-completion-identities",
                        "phase6-frozen-controller-payloads",
                        "phase6-terminal-partitions",
                        "phase7-lifecycle-vs-metric-partition",
                        "phase7-lifecycle-authorization-cases",
                        "phase7-conditional-analysis-prerequisites",
                        "phase7-adaptivity-non-estimable-contrasts",
                        "phase7-transfer-faceted-index",
                        "phase7-runner-view-content-binding",
                        "phase7-metric-boundary-derivation",
                        "phase7-all-abstained-proxy-boundary",
                        "phase7-proxy-condition-realization-counts",
                        "phase6-campaign-terminal-inventory-65-row-union",
                        "phase6-campaign-terminal-early-failure-independence",
                        "source-conformance-45-row-portfolio",
                    }
                ),
            },
            sort_keys=True,
        )
    )
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description="Prepare or execute sealed, read-only Phase 7 analysis"
    )
    subparsers = parser.add_subparsers(dest="command", required=True)
    prepare_parser = subparsers.add_parser("prepare")
    prepare_parser.add_argument("--out", required=True)
    prepare_parser.add_argument("--gate5-manifest", required=True)
    prepare_parser.add_argument("--gate5-runnote", required=True)
    prepare_parser.add_argument("--gate5-promotion-receipt", required=True)
    prepare_parser.add_argument("--phase6-core-completion", required=True)
    prepare_parser.add_argument("--phase6-extended-completion", required=True)
    prepare_parser.add_argument("--phase6-native-completion", required=True)
    prepare_parser.add_argument(
        "--phase6-recovery-completion", action="append", default=[]
    )
    prepare_parser.add_argument("--seven-output-policy-amendment", required=True)
    prepare_parser.add_argument(
        "--phase6-seven-output-policy-completion", required=True
    )
    prepare_parser.add_argument("--followon-gate5-amendment", required=True)
    prepare_parser.add_argument("--phase6-followon-completion", required=True)
    execute_parser = subparsers.add_parser("execute")
    execute_parser.add_argument("--launch", required=True)
    subparsers.add_parser("contract-self-test")
    return parser


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    try:
        if args.command == "prepare":
            return prepare(args)
        if args.command == "contract-self-test":
            return contract_self_test()
        return execute(args)
    except Phase7Error as exc:
        print(f"Phase 7 validation failed: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
