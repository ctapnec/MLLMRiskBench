def utc_now() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def canonical(value: object) -> bytes:
    return (
        json.dumps(
            value,
            ensure_ascii=False,
            sort_keys=True,
            separators=(",", ":"),
            allow_nan=False,
        )
        + "\n"
    ).encode("utf-8")


def sha256_bytes(value: bytes) -> str:
    return hashlib.sha256(value).hexdigest()


def descriptor(path: Path) -> dict[str, object]:
    resolved = path.resolve(strict=True)
    if path.is_symlink() or not resolved.is_file():
        raise ValueError(f"unsafe descriptor path: {path}")
    payload = resolved.read_bytes()
    return {
        "path": str(resolved),
        "sha256": sha256_bytes(payload),
        "bytes": len(payload),
    }


def write_new(path: Path, payload: bytes) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    descriptor_fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(descriptor_fd, "wb") as handle:
        handle.write(payload)
        handle.flush()
        os.fsync(handle.fileno())


def strict_json(path: Path) -> dict[str, Any]:
    value = json.loads(path.read_text(encoding="utf-8"))
    if not isinstance(value, dict):
        raise TypeError(f"{path} is not one JSON object")
    return value


def failed_subset_from_completion(value: Mapping[str, Any]) -> tuple[str, ...]:
    """Return exactly the failed ordered subset from one terminal recovery."""

    lane_order = value.get("runnable_lanes")
    states = value.get("lane_terminal_states")
    results = value.get("lane_results")
    failures = value.get("lane_failures")
    if (
        set(value) != PRIOR_RECOVERY_COMPLETION_FIELDS
        or value.get("schema") != "ura-phase6-failed-lane-recovery-completion/1"
        or value.get("status") != "complete_with_failures"
        or value.get("controller_exit_code") != 1
        or value.get("inventory_complete") is not True
        or value.get("all_independent_lanes_attempted") is not True
        or value.get("generation_caps_changed") is not False
        or value.get("unrelated_passed_work_repeated") is not False
        or value.get("paid_provider_calls") != 0
        or value.get("output_policy")
        != "retain_length_capped_text_and_typed_model_nonresponse"
        or not isinstance(lane_order, list)
        or not lane_order
        or len(set(lane_order)) != len(lane_order)
        or tuple(lane for lane in LANE_ORDER if lane in set(lane_order))
        != tuple(lane_order)
        or not isinstance(states, dict)
        or set(states) != set(lane_order)
        or set(states.values()) - {"measured_complete", "failed"}
        or not isinstance(results, dict)
        or not isinstance(failures, dict)
    ):
        raise ValueError("retry source completion contract changed")
    failed = tuple(lane for lane in lane_order if states[lane] == "failed")
    succeeded = set(lane_order) - set(failed)
    if (
        not failed
        or set(results) != succeeded
        or set(failures) != set(failed)
    ):
        raise ValueError("retry source terminal partition changed")
    return failed


def validate_failed_subset_source(
    completion_path: Path, expected_sha256: str
) -> dict[str, Any]:
    """Bind a retry to the immutable failures of one prior terminal attempt."""

    if (
        not completion_path.is_absolute()
        or completion_path.is_symlink()
        or completion_path.resolve(strict=True) != completion_path
        or not completion_path.is_file()
        or re.fullmatch(r"[0-9a-f]{64}", expected_sha256) is None
    ):
        raise ValueError("retry source completion path or digest is invalid")
    payload = completion_path.read_bytes()
    if sha256_bytes(payload) != expected_sha256:
        raise ValueError("retry source completion content identity changed")
    completion = json.loads(payload.decode("utf-8"))
    if not isinstance(completion, dict):
        raise ValueError("retry source completion is not one object")
    failed = failed_subset_from_completion(completion)
    attempt = completion_path.parent
    control = attempt.parent.parent
    if (
        completion_path != attempt / "completion.json"
        or attempt.parent != control / "attempts"
        or completion.get("attempt") != attempt.name
        or (attempt / ".exit").read_bytes() != b"1\n"
        or not isinstance(completion.get("expected_commit"), str)
        or re.fullmatch(r"[0-9a-f]{40}", completion["expected_commit"]) is None
        or completion.get("framework_lock_id")
        != os.environ["URA_FRAMEWORK_LOCK_ID"]
    ):
        raise ValueError("retry source attempt identity changed")
    for lane, raw in completion["lane_results"].items():
        _nested_descriptor_path(
            raw,
            label=f"retry source {lane} result",
            parent=attempt,
            exact=attempt / f"{lane}.complete.json",
        )
    for lane, raw in completion["lane_failures"].items():
        _nested_descriptor_path(
            raw,
            label=f"retry source {lane} failure",
            parent=attempt,
            exact=attempt / f"{lane}.failure.json",
        )
    amendment_path = _nested_descriptor_path(
        completion["amendment"], label="retry source amendment", parent=control
    )
    launch_path = _nested_descriptor_path(
        completion["launch"],
        label="retry source launch",
        parent=control,
        exact=control / "launch.json",
    )
    summary_path = _nested_descriptor_path(
        completion["summary"],
        label="retry source summary",
        parent=attempt,
        exact=attempt / "summary.json",
    )
    _nested_descriptor_path(
        completion["controller"], label="retry source controller"
    )
    _nested_descriptor_path(
        completion["retained_executor_payload"],
        label="retry source retained executor payload",
    )
    amendment = strict_json(amendment_path)
    launch = strict_json(launch_path)
    summary = strict_json(summary_path)
    rows = amendment.get("affected_lanes")
    lane_order = completion["runnable_lanes"]
    if (
        amendment.get("schema") not in {BASE_AMENDMENT_SCHEMA, RETRY_AMENDMENT_SCHEMA}
        or amendment.get("project_commit") != completion["expected_commit"]
        or amendment.get("framework_lock_id") != completion["framework_lock_id"]
        or amendment.get("unrelated_passed_work_repeated") is not False
        or amendment.get("paid_provider_calls") != 0
        or not isinstance(rows, list)
        or [row.get("lane_id") for row in rows if isinstance(row, dict)]
        != lane_order
        or launch.get("lane_order") != lane_order
        or launch.get("amendment") != descriptor(amendment_path)
        or summary.get("runnable_inventory") != lane_order
        or summary.get("lane_terminal_states")
        != completion["lane_terminal_states"]
    ):
        raise ValueError("retry source provenance chain changed")
    return {
        "completion": completion,
        "descriptor": descriptor(completion_path),
        "failed_lanes": failed,
    }


def parse_retry_source(args: Sequence[str]) -> dict[str, Any] | None:
    if not args:
        return None
    if (
        len(args) != 4
        or args[0] != "--retry-failures-from"
        or args[2] != "--retry-failures-sha256"
    ):
        raise ValueError("unsupported corrective-controller arguments")
    return validate_failed_subset_source(Path(args[1]), args[3])


def _nested_descriptor_path(
    raw: object,
    *,
    label: str,
    parent: Path | None = None,
    exact: Path | None = None,
) -> Path:
    path = _verified_file_descriptor(raw, label=label, parent=parent)
    if exact is not None and path != exact:
        raise ValueError(f"{label}.path is not the required artifact")
    return path


def validate_prior_recovery_completion(
    *,
    attempt: Path,
    exit_marker: Path,
    completion_file: Path,
    retained_payload: Path,
    recovery_control: Path | None = None,
    recovery_lane_specs: Mapping[str, Path] | None = None,
) -> None:
    if (
        attempt.is_symlink()
        or attempt.resolve(strict=True) != attempt
        or not attempt.is_dir()
        or attempt.parent.name != "attempts"
        or exit_marker != attempt / ".exit"
        or completion_file != attempt / "completion.json"
    ):
        raise ValueError("prior recovery attempt binding changed")
    control = attempt.parent.parent
    if recovery_control is not None and control != recovery_control:
        raise ValueError("prior recovery control differs from its bound base control")
    if exit_marker.read_bytes() != b"0\n":
        raise ValueError("prior recovery is not terminal success")
    if recovery_lane_specs is not None:
        if set(recovery_lane_specs) != set(PRIOR_RECOVERY_SOURCE_SPEC_FILES):
            raise ValueError("prior recovery lane-spec role set changed")
        for name in PRIOR_RECOVERY_SOURCE_SPEC_FILES:
            path = recovery_lane_specs[name]
            if path != control / "lane-specs" / name:
                raise ValueError("prior recovery lane spec escaped its control")
            descriptor(path)

    completion = strict_json(completion_file)
    expected_states = {lane: "measured_complete" for lane in PRIOR_RECOVERY_LANES}
    results = completion.get("lane_results")
    if (
        set(completion) != PRIOR_RECOVERY_COMPLETION_FIELDS
        or completion.get("schema")
        != "ura-phase6-failed-lane-recovery-completion/1"
        or completion.get("status") != "complete"
        or completion.get("controller_exit_code") != 0
        or completion.get("attempt") != attempt.name
        or completion.get("expected_commit") != PRIOR_RECOVERY_EXPECTED_COMMIT
        or completion.get("framework_lock_id")
        != PRIOR_RECOVERY_FRAMEWORK_LOCK_ID
        or completion.get("inventory_complete") is not True
        or completion.get("runnable_lanes") != list(PRIOR_RECOVERY_LANES)
        or completion.get("lane_terminal_states") != expected_states
        or not isinstance(results, dict)
        or set(results) != set(PRIOR_RECOVERY_LANES)
        or completion.get("lane_failures") != {}
        or completion.get("all_independent_lanes_attempted") is not True
        or completion.get("output_policy")
        != "retain_length_capped_text_and_typed_model_nonresponse"
        or completion.get("generation_caps_changed") is not False
        or completion.get("unrelated_passed_work_repeated") is not False
        or completion.get("paid_provider_calls") != 0
    ):
        raise ValueError("prior recovery completion contract changed")

    amendment_path = _nested_descriptor_path(
        completion["amendment"],
        label="prior recovery amendment",
        parent=control,
        exact=control / "runner-2.24-source-metric-amendment.json",
    )
    launch_path = _nested_descriptor_path(
        completion["launch"],
        label="prior recovery launch",
        parent=control,
        exact=control / "launch.json",
    )
    _nested_descriptor_path(
        completion["controller"], label="prior recovery controller"
    )
    _nested_descriptor_path(
        completion["retained_executor_payload"],
        label="prior recovery retained executor payload",
        exact=retained_payload,
    )
    summary_path = _nested_descriptor_path(
        completion["summary"],
        label="prior recovery summary",
        parent=attempt,
        exact=attempt / "summary.json",
    )
    for lane in PRIOR_RECOVERY_LANES:
        _nested_descriptor_path(
            results[lane],
            label=f"prior recovery {lane} result",
            parent=attempt,
            exact=attempt / f"{lane}.complete.json",
        )

    launch = strict_json(launch_path)
    if (
        set(launch) != PRIOR_RECOVERY_LAUNCH_FIELDS
        or launch.get("schema") != "ura-phase6-failed-lane-recovery-launch/1"
        or launch.get("expected_commit") != PRIOR_RECOVERY_EXPECTED_COMMIT
        or launch.get("framework_lock_id")
        != PRIOR_RECOVERY_FRAMEWORK_LOCK_ID
        or launch.get("execution_scope_id")
        != os.environ.get("URA_EXECUTION_SCOPE_ID")
        or launch.get("control_root") != str(control)
        or launch.get("attempt") != attempt.name
        or launch.get("controller") != completion["controller"]
        or launch.get("retained_executor_payload")
        != completion["retained_executor_payload"]
        or launch.get("amendment") != completion["amendment"]
        or launch.get("lane_order") != list(PRIOR_RECOVERY_LANES)
    ):
        raise ValueError("prior recovery launch chain changed")

    amendment = strict_json(amendment_path)
    affected = amendment.get("affected_lanes")
    if (
        set(amendment) != PRIOR_RECOVERY_AMENDMENT_FIELDS
        or amendment.get("schema") != "ura-local-campaign-model-output-amendment/1"
        or amendment.get("status")
        != "approved_for_targeted_recanary_and_measured_recovery"
        or amendment.get("project_commit") != PRIOR_RECOVERY_EXPECTED_COMMIT
        or amendment.get("runner_code_version") != "ura-runner/2.24"
        or amendment.get("framework_lock_id")
        != PRIOR_RECOVERY_FRAMEWORK_LOCK_ID
        or amendment.get("output_policy") != PRIOR_RECOVERY_OUTPUT_POLICY
        or amendment.get("retained_completed_lanes") != [
            "bridge-pyrit", "bridge-deepteam", "bridge-h4rm3l",
            "bridge-spikee", "bridge-purplellama", "harmbench-replay",
        ]
        or not isinstance(affected, list)
        or len(affected) != len(PRIOR_RECOVERY_LANES)
        or amendment.get("unrelated_passed_work_repeated") is not False
        or amendment.get("paid_provider_calls") != 0
    ):
        raise ValueError("prior recovery amendment contract changed")
    project_revision_path = _nested_descriptor_path(
        amendment["project_revision"],
        label="prior recovery amendment project_revision",
    )
    project_revision = strict_json(project_revision_path)
    repository = project_revision.get("repository")
    if (
        set(project_revision) != {
            "schema", "status", "purpose", "revision_id", "repository",
            "source", "limitations",
        }
        or project_revision.get("schema") != "ura-project-revision/1"
        or project_revision.get("status") != "complete"
        or project_revision.get("purpose") != "immutable_clean_project_source_receipt"
        or not isinstance(repository, dict)
        or set(repository) != {
            "clean", "expected_commit", "observed_commit", "head_tree",
            "root_relationship",
        }
        or repository.get("clean") is not True
        or repository.get("expected_commit") != PRIOR_RECOVERY_EXPECTED_COMMIT
        or repository.get("observed_commit") != PRIOR_RECOVERY_EXPECTED_COMMIT
    ):
        raise ValueError("prior recovery project-revision chain changed")
    for field in (
        "runnote", "source_conformance", "focused_tests", "mutation_tests",
    ):
        _nested_descriptor_path(
            amendment[field], label=f"prior recovery amendment {field}"
        )
    historical_gate5 = amendment.get("historical_gate5")
    if not isinstance(historical_gate5, dict) or set(historical_gate5) != {
        "manifest", "runnote", "promotion",
    }:
        raise ValueError("prior recovery historical Gate 5 chain changed")
    for field in ("manifest", "runnote", "promotion"):
        _nested_descriptor_path(
            historical_gate5[field],
            label=f"prior recovery historical Gate 5 {field}",
        )
    expected_caps = {
        "deadline_seconds": 86_400,
        "http_attempts": 0,
        "model_judge_calls": 0,
        "target_calls": 50,
        "wall_time_seconds": 86_400,
    }
    for lane, source_name, row in zip(
        PRIOR_RECOVERY_LANES,
        PRIOR_RECOVERY_SOURCE_SPEC_FILES,
        affected,
        strict=True,
    ):
        if (
            not isinstance(row, dict)
            or set(row) != {
                "lane_id", "retained_lane_spec", "approved_caps",
                "selection_and_sampling_changed",
            }
            or row.get("lane_id") != lane
            or row.get("approved_caps") != expected_caps
            or row.get("selection_and_sampling_changed") is not False
        ):
            raise ValueError(f"{lane}: prior recovery amendment row changed")
        _nested_descriptor_path(
            row["retained_lane_spec"],
            label=f"{lane} prior recovery source spec",
            exact=retained_payload.parent / "lane-specs" / source_name,
        )

    summary = strict_json(summary_path)
    if (
        set(summary) != PRIOR_RECOVERY_SUMMARY_FIELDS
        or summary.get("schema") != "ura-phase6-failed-lane-recovery-summary/1"
        or summary.get("status") != "complete"
        or summary.get("controller_exit_code") != 0
        or summary.get("attempt") != attempt.name
        or summary.get("runnable_inventory") != list(PRIOR_RECOVERY_LANES)
        or summary.get("lane_terminal_states") != expected_states
        or summary.get("completed_lanes") != list(PRIOR_RECOVERY_LANES)
        or summary.get("failed_lanes") != []
        or summary.get("failures") != []
        or summary.get("all_independent_lanes_attempted") is not True
        or summary.get("output_policy") != completion["output_policy"]
        or summary.get("generation_caps_changed") is not False
        or summary.get("unrelated_passed_work_repeated") is not False
        or any(
            summary.get(field) != 0
            for field in (
                "paid_provider_calls", "hosted_judge_calls", "http_attempts",
                "model_downloads",
            )
        )
    ):
        raise ValueError("prior recovery summary contract changed")


def replace_option(argv: Sequence[str], name: str, value: str) -> list[str]:
    result = list(argv)
    positions = [index for index, token in enumerate(result) if token == name]
    if len(positions) != 1 or positions[0] + 1 >= len(result):
        raise ValueError(f"expected one complete {name} option")
    result[positions[0] + 1] = value
    return result


def option_value(argv: Sequence[str], name: str) -> str:
    positions = [index for index, token in enumerate(argv) if token == name]
    if len(positions) != 1 or positions[0] + 1 >= len(argv):
        raise ValueError(f"expected one complete {name} option")
    value = argv[positions[0] + 1]
    if not isinstance(value, str) or not value:
        raise ValueError(f"expected a nonempty {name} value")
    return value


def single_arm_canary_argv(argv: Sequence[str]) -> list[str]:
    result = replace_option(argv, "--limit", "1")
    source_arm = option_value(result, "--corpora").split(",", 1)[0]
    if not source_arm:
        raise ValueError("diagnostic canary source arm is empty")
    result = replace_option(result, "--corpora", source_arm)
    trajectory_seed = option_value(result, "--seeds").split(",", 1)[0]
    if not trajectory_seed:
        raise ValueError("diagnostic canary trajectory seed is empty")
    return replace_option(result, "--seeds", trajectory_seed)


def no_call_preflight_argv(spec: Mapping[str, Any], out: Path) -> list[str]:
    caps = spec["approved_caps"]
    return [
        *spec["base_argv"],
        "--max-total-target-calls",
        str(caps["target_calls"]),
        "--max-total-judge-calls",
        str(caps["model_judge_calls"]),
        "--max-total-http-attempts",
        str(caps["http_attempts"]),
        "--deadline-seconds",
        str(caps["deadline_seconds"]),
        "--out",
        str(out),
        "--preflight-only",
    ]


def one_file(root: Path, pattern: str) -> Path:
    paths = sorted(root.glob(pattern))
    if len(paths) != 1 or paths[0].is_symlink() or not paths[0].is_file():
        raise ValueError(f"expected one safe {pattern} under {root}, found {len(paths)}")
    return paths[0]


def load_payload():
    _revalidate_payload_before_import()
    spec = importlib.util.spec_from_file_location("ura_length_recovery_payload", PAYLOAD_PATH)
    if spec is None or spec.loader is None:
        raise RuntimeError("cannot load retained Phase 6 payload")
    module = importlib.util.module_from_spec(spec)
    sys.modules[spec.name] = module
    spec.loader.exec_module(module)
    module.EXPECTED_COMMIT = EXPECTED_COMMIT
    module.LANE_ORDER[:] = list(LANE_ORDER)
    module.TERMINALS.clear()

    def reservation_identity(
        prestate_path: Path,
        spec_path: Path,
        spec_value: Mapping[str, Any],
        result_root: Path,
    ) -> tuple[Path, bytes, dict[str, Any]]:
        lane_control = prestate_path.parent
        control_root = lane_control.parents[1]
        reservation_path = corrective_reservation_path(
            prestate_path, spec_value, result_root
        )
        payload = module.canonical(
            {
                "schema": "ura-phase6-extended-result-root-reservation/1",
                "status": "reserved",
                "controller_root": str(control_root),
                "lane_id": spec_value["lane_id"],
                "lane_spec": module.frozen_descriptor(spec_path),
                "result_root": str(result_root),
            }
        )
        return reservation_path, payload, {
            "path": str(reservation_path),
            "sha256": sha256_bytes(payload),
            "bytes": len(payload),
        }

    module.reservation_identity = reservation_identity
    return module


def corrective_reservation_path(
    prestate_path: Path,
    spec: Mapping[str, Any],
    result_root: Path,
) -> Path:
    lane_control = prestate_path.parent
    if lane_control.name != spec["lane_id"] or lane_control.parent.name != "lanes":
        raise ValueError("prestate path is outside the exact lane-control namespace")
    control_root = lane_control.parents[1]
    return (
        result_root.parent
        / ".phase6-extended-reservations"
        / f"{control_root.name}.reservation.json"
    )


def assert_inputs(module: Any, *, runnote: Path) -> list[dict[str, Any]]:
    _revalidate_bound_inputs()
    if CONTROL.exists() or CONTROL.is_symlink():
        raise FileExistsError(f"corrective control root already exists: {CONTROL}")
    if runnote.exists() or runnote.is_symlink():
        raise FileExistsError(f"corrective RUNNOTE already exists: {runnote}")
    if os.environ.get("REF_URA") != EXPECTED_COMMIT:
        raise ValueError("campaign environment is not rebound to Runner 2.24")
    if DEPLOYMENT_EXIT.read_bytes() != b"0\n":
        raise ValueError("Runner 2.24 targeted deployment is not terminal success")
    validate_prior_recovery_completion(
        attempt=PRIOR_RECOVERY_ATTEMPT,
        exit_marker=PRIOR_RECOVERY_EXIT,
        completion_file=PRIOR_RECOVERY_COMPLETION,
        retained_payload=PAYLOAD_PATH,
    )
    for path in (
        PAYLOAD_PATH,
        OLD_GATE5_MANIFEST,
        OLD_GATE5_RUNNOTE,
        OLD_GATE5_PROMOTION,
        FOCUSED_TESTS,
        MUTATION_TESTS,
    ):
        descriptor(path)
    if "4 passed" not in FOCUSED_TESTS.read_text(encoding="utf-8"):
        raise ValueError("focused Runner 2.24 verification did not pass")
    mutation_text = MUTATION_TESTS.read_text(encoding="utf-8")
    if "2 failed" not in mutation_text:
        raise ValueError("model-output regressions were not mutation-tested")
    specs = [strict_json(path) for path in OLD_LANE_SPECS]
    if tuple(row.get("lane_id") for row in specs) != LANE_ORDER:
        raise ValueError("retained affected lane order changed")
    module.assert_environment()
    return specs


def prepare_base_argv(spec: dict[str, Any]) -> None:
    argv = spec.get("base_argv")
    if not isinstance(argv, list) or any(not isinstance(token, str) for token in argv):
        raise TypeError(f"{spec.get('lane_id')}: retained base argv is invalid")
    argv = replace_option(
        argv,
        "--project-revision",
        os.environ["URA_PROJECT_REVISION_MANIFEST"],
    )
    argv = replace_option(
        argv,
        "--project-revision-sha256",
        os.environ["URA_PROJECT_REVISION_SHA256"],
    )
    spec["base_argv"] = argv
    spec["schema"] = "ura-phase6-core-length-recovery-lane-spec/1"
    spec["family"] = "core"
    spec["runtime_engine"] = None
    spec["acquisition_mode"] = "required_zero_download"
    spec["cuda_visible_devices"] = "0,1"
    spec.pop("gate5", None)


def core_lane_contract(spec: Mapping[str, Any]) -> dict[str, Any]:
    return {
        "expected_judges": list(spec["expected_judges"]),
        "approximate": bool(spec["approximate_common_metrics"]),
        "classification": bool(spec["classification"]),
    }


def validate_specs_contract(module: Any, specs: Sequence[dict[str, Any]]) -> None:
    expected_caps = {
        "local-qwen3-vl-text-primary-100": 3854,
        "local-qwen3-vl-image-primary-100": 1632,
        "local-llava-base-text-primary-100": 3854,
        "local-llava-base-image-primary-100": 1632,
        "gptgeochat-qwen3-vl": 2020,
        "crescendo-qwen3-vl": 2800,
    }
    qwen = {
        "spec": "vllm:Qwen/Qwen3-VL-8B-Instruct",
        "repo_id": "Qwen/Qwen3-VL-8B-Instruct",
        "revision": "60595ebc30ec8e3b1d3b9e65d4943ca011c0006a",
    }
    llava_base = {
        "spec": "vllm:llava-hf/llava-v1.6-mistral-7b-hf",
        "repo_id": "llava-hf/llava-v1.6-mistral-7b-hf",
        "revision": "2424fdd47412fccc66d91719126b420e9fbd7065",
    }
    expected_targets = {
        "local-qwen3-vl-text-primary-100": qwen,
        "local-qwen3-vl-image-primary-100": qwen,
        "local-llava-base-text-primary-100": llava_base,
        "local-llava-base-image-primary-100": llava_base,
        "gptgeochat-qwen3-vl": qwen,
        "crescendo-qwen3-vl": qwen,
    }
    text_arms = (
        "strongreject_official,advbench_harmful,jailbreakbench_harmful,"
        "jailbreakbench_benign,harmbench_text,cyberseceval_mitre,"
        "cyberseceval_interpreter,cyberseceval_insecure_coding,saladbench_base,"
        "airbench_full,xstest_full,simplesafetytests_full,decodingtrust_stereotype"
    )
    image_arms = (
        "mmsafety_official,jailbreakv_full,harmbench_multimodal,vlsbench_release,"
        "mossbench_official,siuo_release,figstep_full,mllmguard_privacy,"
        "mllmguard_bias,mllmguard_toxicity,mllmguard_legality,holisafe_full"
    )
    adaptive_arms = (
        "strongreject_official,advbench_harmful,jailbreakbench_harmful,"
        "harmbench_text,cyberseceval_mitre,cyberseceval_interpreter,"
        "cyberseceval_insecure_coding"
    )
    expected_selection = {
        "local-qwen3-vl-text-primary-100": (
            text_arms, "replay", "rules,guardrail", True,
        ),
        "local-qwen3-vl-image-primary-100": (
            image_arms, "replay", "rules,guardrail", True,
        ),
        "local-llava-base-text-primary-100": (
            text_arms, "replay", "rules,guardrail", True,
        ),
        "local-llava-base-image-primary-100": (
            image_arms, "replay", "rules,guardrail", True,
        ),
        "gptgeochat-qwen3-vl": (
            "gptgeochat_release", "replay", "rules", False,
        ),
        "crescendo-qwen3-vl": (
            adaptive_arms, "crescendo", "rules,guardrail", True,
        ),
    }
    source_conformance_raw = Path(os.environ["URA_SOURCE_CONFORMANCE_MANIFEST"])
    source_conformance = source_conformance_raw.resolve(strict=True)
    source_conformance_sha = os.environ["URA_SOURCE_CONFORMANCE_SHA256"]
    source_config_raw = PROJECT / "experiments" / "source-instances.json"
    source_config = source_config_raw.resolve(strict=True)
    if (
        source_conformance_raw.is_symlink()
        or source_conformance_raw != source_conformance
        or sha256_bytes(source_conformance.read_bytes()) != source_conformance_sha
        or source_config_raw.is_symlink()
        or source_config_raw != source_config
    ):
        raise ValueError("current source admission bindings are unsafe or changed")
    source_config_sha = sha256_bytes(source_config.read_bytes())
    if tuple(spec.get("lane_id") for spec in specs) != LANE_ORDER:
        raise ValueError("retained affected lane order changed")
    for spec in specs:
        prepare_base_argv(spec)
        lane = spec["lane_id"]
        argv = spec["base_argv"]
        corpora, attacker, judges, approximate = expected_selection[lane]
        if (
            option_value(argv, "--sample-seed") != "0"
            or option_value(argv, "--seeds") != "0"
            or "--sampling-policy" in argv
            or option_value(argv, "--corpora") != corpora
            or option_value(argv, "--attackers") != attacker
            or option_value(argv, "--judges") != judges
            or argv.count("--approximate-common-metrics") != int(approximate)
            or spec.get("expected_corpora") != corpora.split(",")
            or spec.get("expected_attacker") != attacker
            or spec.get("expected_judges") != judges.split(",")
            or spec.get("approximate_common_metrics") is not approximate
            or option_value(argv, "--source-conformance")
            != str(source_conformance)
            or option_value(argv, "--source-conformance-sha256")
            != source_conformance_sha
            or option_value(argv, "--source-config") != str(source_config)
            or option_value(argv, "--source-config-sha256") != source_config_sha
        ):
            raise ValueError(f"{lane}: retained selection or source binding changed")
        module.validate_gate5_judge_selection(
            lane, core_lane_contract(spec), argv
        )
        canary_argv = single_arm_canary_argv(argv)
        if (
            option_value(canary_argv, "--limit") != "1"
            or "," in option_value(canary_argv, "--corpora")
            or "," in option_value(canary_argv, "--seeds")
            or "," in option_value(canary_argv, "--attackers")
        ):
            raise ValueError(f"{lane}: canary is not one source arm")
        preflight_argv = no_call_preflight_argv(spec, Path("/no-call-preflight"))
        if "--preflight-only" not in preflight_argv or any(
            flag in preflight_argv
            for flag in (
                "--execution-scope-id",
                "--live-attestation",
                "--live-attestation-sha256",
                "--live-attestation-max-age-hours",
                "--diagnostic-canary",
            )
        ):
            raise ValueError(f"{lane}: preflight consumes live state")
        result_root = module.expected_result_root(
            Path(os.environ["URA_WORK"]), spec, CONTROL
        )
        reservation_path = corrective_reservation_path(
            CONTROL / "lanes" / lane / "measured-prestate.json",
            spec,
            result_root,
        )
        if reservation_path.name != f"{CONTROL.name}.reservation.json":
            raise ValueError(f"{lane}: corrective reservation can collide")
        caps = spec.get("approved_caps")
        if (
            not isinstance(caps, dict)
            or caps.get("wall_time_seconds") != 86_400
            or caps.get("deadline_seconds") != 86_400
            or caps.get("model_judge_calls") != 0
            or caps.get("http_attempts") != 0
            or caps.get("target_calls") != expected_caps[lane]
        ):
            raise ValueError(f"{lane}: retained caps changed")
        if option_value(argv, "--limit") != "100":
            raise ValueError(f"{lane}: bounded selection changed")
        if (
            spec.get("target") != expected_targets[lane]
            or option_value(argv, "--local")
            != expected_targets[lane]["spec"]
        ):
            raise ValueError(f"{lane}: retained target identity changed")


def write_runnote(
    specs: Sequence[Mapping[str, Any]],
    *,
    runnote: Path,
    retry_source: Mapping[str, Any] | None,
) -> None:
    if retry_source is None:
        title = "# Runner 2.24 core length-output recovery cohort"
        scope = [
            "Approved scope: only the six Phase 6 core lanes that failed under Runner",
            "2.21 because a nonempty length-capped response was rejected. The three",
            "completed core lanes and the completed extended lanes are not repeated.",
        ]
    else:
        title = "# Runner 2.24 failed-only core recovery overlay"
        prior = retry_source["descriptor"]
        scope = [
            "Approved scope: only the lanes still failed in the bound prior recovery",
            "completion are attempted. Every prior measured-complete lane is retained",
            "and is not repeated.",
            "",
            f"Prior completion: `{prior['path']}`",
            f"Prior completion SHA-256: `{prior['sha256']}`",
        ]
    lines = [
        title,
        "",
        *scope,
        "Runner 2.24 retains nonempty length-capped text and its terminal reason.",
        "The per-lane selections, sampling seeds, model identities and measured caps",
        "below are unchanged from the retained Gate 5 schedule. Caps are not raised.",
        "Every lane is bound to one fresh transport attestation, one limit-1 diagnostic",
        "canary and one no-call preflight before its measured attempt. Completed retry",
        "prerequisites are reused by content identity. Completed core lanes and unrelated",
        "admission work are not repeated.",
        "",
        "| Lane | Target-call cap | Model-judge cap | HTTP cap | Deadline | Wall time |",
        "|---|---:|---:|---:|---:|---:|",
    ]
    for spec in specs:
        caps = spec["approved_caps"]
        lines.append(
            f"| {spec['lane_id']} | {caps['target_calls']} | "
            f"{caps['model_judge_calls']} | {caps['http_attempts']} | "
            f"{caps['deadline_seconds']} | {caps['wall_time_seconds']} |"
        )
    lines.extend(
        [
            "",
        "This is local campaign orchestration, not a product phase. No generation",
        "cap, population selection, model identity, or approved call cap is changed.",
            "",
        ]
    )
    write_new(runnote, "\n".join(lines).encode("ascii"))


def write_amendment(
    specs: Sequence[Mapping[str, Any]],
    *,
    runnote: Path,
    retry_source: Mapping[str, Any] | None,
) -> tuple[Path, str]:
    path = CONTROL / (
        "runner-2.24-core-length-output-amendment.json"
        if retry_source is None
        else "runner-2.24-core-failed-subset-amendment.json"
    )
    value = {
        "schema": (
            BASE_AMENDMENT_SCHEMA
            if retry_source is None
            else RETRY_AMENDMENT_SCHEMA
        ),
        "status": "approved_for_targeted_recanary_and_measured_recovery",
        "created_at_utc": utc_now(),
        "project_commit": EXPECTED_COMMIT,
        "runner_code_version": "ura-runner/2.24",
        "output_policy": {
            "nonempty_length_capped_text": "retain_and_analyze",
            "successful_empty_completion": "retain_as_typed_model_nonresponse",
            "common_metric_denominator": "exclude_model_nonresponse",
            "source_specific_parser": "retain_invalid_prediction",
            "terminal_reason_retained": True,
            "unknown_terminal_reason": "error",
            "generation_caps_changed": False,
        },
        "operator_authorization": (
            "operator explicitly directed that nonempty text reaching the generation "
            "cap remains analyzable model output"
        ),
        "runnote": descriptor(runnote),
        "project_revision": descriptor(Path(os.environ["URA_PROJECT_REVISION_MANIFEST"])),
        "source_conformance": descriptor(Path(os.environ["URA_SOURCE_CONFORMANCE_MANIFEST"])),
        "framework_lock_id": os.environ["URA_FRAMEWORK_LOCK_ID"],
        "focused_tests": descriptor(FOCUSED_TESTS),
        "mutation_tests": descriptor(MUTATION_TESTS),
        "historical_gate5": {
            "manifest": descriptor(OLD_GATE5_MANIFEST),
            "runnote": descriptor(OLD_GATE5_RUNNOTE),
            "promotion": descriptor(OLD_GATE5_PROMOTION),
        },
        "retained_completed_core_lanes": [
            "rjudge-qwen3-vl", "rjudge-llava-base",
            "gptgeochat-llava-base",
        ],
        "prior_extended_recovery": descriptor(PRIOR_RECOVERY_COMPLETION),
        "affected_lanes": [
            {
                "lane_id": spec["lane_id"],
                "retained_lane_spec": descriptor(
                    OLD_LANE_SPECS[index]
                ),
                "approved_caps": spec["approved_caps"],
                "selection_and_sampling_changed": False,
            }
            for index, spec in enumerate(specs)
        ],
        "unrelated_passed_work_repeated": False,
        "paid_provider_calls": 0,
    }
    if retry_source is not None:
        value["prior_recovery_completion"] = retry_source["descriptor"]
    write_new(path, canonical(value))
    return path, sha256_bytes(path.read_bytes())


def acquisition_for(
    module: Any,
    ctl: Any,
    spec: Mapping[str, Any],
    label: str,
    args: Sequence[str],
    root: Path,
) -> Mapping[str, Any] | None:
    if spec["acquisition_mode"] != "required_zero_download":
        return None
    root.mkdir(parents=True, mode=0o700)
    role_mode = "target_only" if spec["classification"] else "target_and_guard"
    return module.plan_acquire(
        ctl,
        spec,
        label,
        args,
        root / "plan",
        root / "receipts",
        role_mode,
    )


def runner_args_with_acquisition(
    module: Any,
    args: Sequence[str],
    acquisition: Mapping[str, Any] | None,
) -> list[str]:
    result = list(args)
    if acquisition is not None:
        result.extend(module.acquisition_args(acquisition))
    return result


def canary_id(root: Path) -> str:
    matches: list[str] = []
    for path in sorted(root.glob("*.json")):
        try:
            value = strict_json(path)
        except (OSError, UnicodeError, ValueError, TypeError):
            continue
        value_id = value.get("canary_id")
        if isinstance(value_id, str) and value_id.startswith("lane-canary-"):
            matches.append(value_id)
    if len(set(matches)) != 1:
        raise ValueError(f"expected one lane-canary identity under {root}")
    return matches[0]


def derive_core_attestation(
    module: Any,
    ctl: Any,
    spec: Mapping[str, Any],
    lane_control: Path,
) -> dict[str, Any]:
    """Derive a fresh text or physical-image transport receipt for one core lane."""

    lane = str(spec["lane_id"])
    base = spec["base_argv"]
    modality = str(spec["modality"])
    if modality not in {"text", "image"}:
        raise ValueError(f"{lane}: unsupported core attestation modality")
    corpus = "synth" if modality == "text" else "figstep_full"
    probe_parent = (
        ctl.work
        / "runs"
        / "thesis"
        / "attestation"
        / f"phase6-core-recovery-{ctl.attempt_tag}"
        / lane
    )
    if probe_parent.exists() or probe_parent.is_symlink():
        raise ValueError(f"fresh core attestation root already exists: {probe_parent}")
    probe_parent.mkdir(parents=True, mode=0o700)
    probe_root = probe_parent / "probe"
    receipt_path = probe_parent / f"{lane}.live-attestation.json"
    probe_args = [
        "--attestation-probe",
        "--execution-scope-id", os.environ["URA_EXECUTION_SCOPE_ID"],
        "--project-revision", option_value(base, "--project-revision"),
        "--project-revision-sha256",
        option_value(base, "--project-revision-sha256"),
        "--local", option_value(base, "--local"),
        "--local-config", option_value(base, "--local-config"),
        "--local-config-sha256", option_value(base, "--local-config-sha256"),
        "--attackers", "replay",
        "--judges", "rules",
        "--corpora", corpus,
    ]
    if modality == "image":
        probe_args.extend([
            "--source-config", option_value(base, "--source-config"),
            "--source-config-sha256", option_value(base, "--source-config-sha256"),
            "--source-conformance", option_value(base, "--source-conformance"),
            "--source-conformance-sha256",
            option_value(base, "--source-conformance-sha256"),
        ])
    probe_args.extend([
        "--limit", "1",
        "--sample-seed", "0",
        "--seeds", "0",
        "--max-queries", "1",
        "--max-turns", "1",
        "--group",
        "model,source,risk,effective_modality,expected_behavior,attacker,"
        "source_policy_id,source_policy_version",
        "--max-total-target-calls", "1",
        "--max-total-judge-calls", "0",
        "--max-total-http-attempts", "0",
        "--deadline-seconds", "900",
        "--out", str(probe_root),
    ])
    acquisition = module.plan_acquire(
        ctl,
        spec,
        f"{lane}.probe",
        probe_args,
        lane_control / f"probe-plan-{ctl.attempt_tag}",
        lane_control / "receipts",
        "target_only",
    )
    ctl.run(
        lane,
        "fresh-attestation-probe",
        [
            str(PYTHON), "-m", "experiments.run_matrix", *probe_args,
            *module.acquisition_args(acquisition),
        ],
        f"{lane}.probe.run.log",
    )
    ctl.run(
        lane,
        "fresh-attestation-derive",
        [
            str(PYTHON), "-m", "experiments.live_attestation",
            "--probe-root", str(probe_root),
            "--execution-scope-id", os.environ["URA_EXECUTION_SCOPE_ID"],
            "--out", str(receipt_path),
        ],
        f"{lane}.probe.derive.log",
    )
    receipt_sha = sha256_bytes(receipt_path.read_bytes())
    ctl.run(
        lane,
        "fresh-attestation-validate",
        [
            str(PYTHON), "-m", "experiments.live_attestation",
            "--validate", str(receipt_path), "--sha256", receipt_sha,
        ],
        f"{lane}.probe.validate.log",
    )
    receipt, _ = module.load_live_attestation_file(receipt_path, receipt_sha)
    records = receipt.get("records") if isinstance(receipt, dict) else None
    expected_modalities = ["text"] if modality == "text" else ["text", "image"]
    expected_target = f"{spec['target']['spec']}@{spec['target']['revision']}"
    if (
        not isinstance(records, list)
        or len(records) != 1
        or records[0].get("requested_target_spec") != spec["target"]["spec"]
        or records[0].get("exact_input_modalities") != expected_modalities
        or records[0].get("resolved_target") != expected_target
        or records[0].get("route_kind") != "local_runtime"
        or records[0].get("realized_target_identity") != {
            "target": expected_target,
            "resolved_model": spec["target"]["repo_id"],
            "model_revision": spec["target"]["revision"],
        }
    ):
        raise ValueError(f"{lane}: fresh core attestation identity/modality changed")
    return {
        "path": str(receipt_path),
        "sha256": receipt_sha,
        "probe_root": str(probe_root),
    }


def prepare_harmbench_canary_argv(
    spec: Mapping[str, Any], gate_root: Path, canary_argv: Sequence[str]
) -> tuple[list[str], dict[str, object]]:
    """Derive the exact one-cluster canary from the measured replay bundle."""

    from experiments import run_matrix
    from ura.adapters.harmbench import _canonical_sha256, _source_request

    config_path = Path(option_value(spec["base_argv"], "--attacker-config"))
    config_raw = config_path.resolve(strict=True).read_bytes()
    if sha256_bytes(config_raw) != option_value(
        spec["base_argv"], "--attacker-config-sha256"
    ):
        raise ValueError("HarmBench measured attacker config digest changed")
    config = json.loads(config_raw.decode("utf-8"))
    harmbench = config.get("harmbench") if isinstance(config, dict) else None
    if not isinstance(harmbench, dict):
        raise ValueError("HarmBench measured attacker config is invalid")
    artifact_path = Path(str(harmbench.get("replay_artifact"))).resolve(strict=True)
    artifact_raw = artifact_path.read_bytes()
    if sha256_bytes(artifact_raw) != harmbench.get("replay_artifact_sha256"):
        raise ValueError("HarmBench measured replay artifact digest changed")
    bundle = json.loads(artifact_raw.decode("utf-8"))
    if not isinstance(bundle, dict):
        raise ValueError("HarmBench measured replay artifact is invalid")
    unsigned = {key: value for key, value in bundle.items() if key != "content_sha256"}
    if bundle.get("content_sha256") != _canonical_sha256(unsigned):
        raise ValueError("HarmBench measured replay content digest changed")

    arm = option_value(canary_argv, "--corpora")
    sample_seed = int(option_value(canary_argv, "--sample-seed"))
    source_instances, _ = run_matrix._load_source_config(
        option_value(canary_argv, "--source-config"),
        [arm],
        option_value(canary_argv, "--source-config-sha256"),
    )
    selected, _ = run_matrix.load_corpus_with_audit(
        arm,
        1,
        sample_seed,
        source_instance=source_instances[arm],
    )
    expected_requests = [_source_request(datapoint) for datapoint in selected]
    full_requests = bundle.get("source_requests")
    full_cases = bundle.get("cases")
    if not isinstance(full_requests, list) or not isinstance(full_cases, list):
        raise ValueError("HarmBench measured replay request/case inventory is invalid")
    request_by_id = {
        request.get("datapoint_id"): request
        for request in full_requests
        if isinstance(request, dict)
    }
    if any(
        request_by_id.get(request["datapoint_id"]) != request
        for request in expected_requests
    ):
        raise ValueError(
            "HarmBench one-cluster corpus is not an exact subset of measured replay"
        )
    selected_ids = {request["datapoint_id"] for request in expected_requests}
    selected_cases = [
        case for case in full_cases
        if isinstance(case, dict) and case.get("datapoint_id") in selected_ids
    ]
    expected_case_count = (
        len(expected_requests)
        * len(bundle.get("methods", []))
        * int(bundle.get("cases_per_method", 0))
    )
    if len(selected_cases) != expected_case_count:
        raise ValueError("HarmBench one-cluster replay case inventory is incomplete")

    selection = dict(bundle.get("selection", {}))
    selection["corpus_name"] = arm
    selection["limit"] = 1
    selection["sample_seed"] = sample_seed
    canary_unsigned = {
        **unsigned,
        "selection": selection,
        "source_requests": expected_requests,
        "cases": selected_cases,
    }
    canary_bundle = {
        **canary_unsigned,
        "content_sha256": _canonical_sha256(canary_unsigned),
    }
    prepared_root = gate_root / "harmbench-canary-prepared"
    artifact_out = prepared_root / "harmbench-replay-limit1.json"
    write_new(artifact_out, canonical(canary_bundle))
    artifact_sha = sha256_bytes(artifact_out.read_bytes())
    canary_config = {
        **config,
        "harmbench": {
            **harmbench,
            "replay_artifact": str(artifact_out.resolve(strict=True)),
            "replay_artifact_sha256": artifact_sha,
        },
    }
    config_out = prepared_root / "harmbench-replay-limit1-config.json"
    write_new(config_out, canonical(canary_config))
    config_sha = sha256_bytes(config_out.read_bytes())
    argv = replace_option(canary_argv, "--attacker-config", str(config_out))
    argv = replace_option(argv, "--attacker-config-sha256", config_sha)
    return argv, {
        "measured_replay_artifact": descriptor(artifact_path),
        "canary_replay_artifact": descriptor(artifact_out),
        "canary_attacker_config": descriptor(config_out),
        "source_request_ids": sorted(selected_ids),
        "source_request_count": len(expected_requests),
        "case_count": len(selected_cases),
    }


def corrective_gate5(
    module: Any,
    ctl: Any,
    spec: dict[str, Any],
    amendment_sha: str,
) -> Mapping[str, Any]:
    lane = spec["lane_id"]
    gate_root = CONTROL / "gate5" / lane
    gate_root.mkdir(parents=True, mode=0o700)
    caps = spec["approved_caps"]
    if lane not in LANE_ORDER:
        raise ValueError(f"{lane}: lane is outside the exact core recovery cohort")
    else:
        attestation = derive_core_attestation(module, ctl, spec, gate_root)
        canary_root = gate_root / "canary"
        canary_base = single_arm_canary_argv(spec["base_argv"])
        if lane == "harmbench-replay":
            canary_base, canary_preparation = prepare_harmbench_canary_argv(
                spec, gate_root, canary_base
            )
            ctl.event(
                lane,
                "harmbench-canary-preparation",
                "complete-new",
                str(canary_preparation["canary_replay_artifact"]["sha256"]),
            )
        canary_args = [
            *canary_base,
            "--diagnostic-canary",
            "--execution-scope-id",
            os.environ["URA_EXECUTION_SCOPE_ID"],
            "--live-attestation",
            attestation["path"],
            "--live-attestation-sha256",
            attestation["sha256"],
            "--live-attestation-max-age-hours",
            "24",
            "--max-total-target-calls",
            str(caps["target_calls"]),
            "--max-total-judge-calls",
            str(caps["model_judge_calls"]),
            "--max-total-http-attempts",
            str(caps["http_attempts"]),
            "--deadline-seconds",
            str(caps["deadline_seconds"]),
            "--out",
            str(canary_root),
        ]
        canary_acquisition = acquisition_for(
            module, ctl, spec, f"{lane}.corrective-canary", canary_args,
            gate_root / "canary-acquisition",
        )
        ctl.run(
            lane,
            "corrective-canary-run",
            [
                str(PYTHON),
                "-m",
                "experiments.run_matrix",
                *runner_args_with_acquisition(module, canary_args, canary_acquisition),
            ],
            f"{lane}.corrective-canary.run.log",
        )
        eligibility = one_file(canary_root, "eligibility-*.eligibility.json")
        ctl.run(
            lane,
            "corrective-lane-canary",
            [
                str(PYTHON),
                "-m",
                "experiments.lane_canary",
                "--results",
                str(canary_root),
                "--eligibility",
                str(eligibility),
                "--out-dir",
                str(canary_root),
            ],
            f"{lane}.corrective-lane-canary.log",
        )
        retained_canary_id = canary_id(canary_root)

    if lane not in LANE_ORDER:
        raise ValueError(f"{lane}: lane is outside the exact core recovery cohort")
    else:
        preflight_root = gate_root / "preflight"
        preflight_args = no_call_preflight_argv(spec, preflight_root)
        preflight_acquisition = acquisition_for(
            module, ctl, spec, f"{lane}.corrective-preflight", preflight_args,
            gate_root / "preflight-acquisition",
        )
        ctl.run(
            lane,
            "corrective-preflight-run",
            [
                str(PYTHON),
                "-m",
                "experiments.run_matrix",
                *runner_args_with_acquisition(
                    module, preflight_args, preflight_acquisition
                ),
            ],
            f"{lane}.corrective-preflight.run.log",
        )
        projection = descriptor(
            one_file(preflight_root, "lane-projection-*.lane-projection.json")
        )
        projection["file"] = Path(str(projection["path"])).name
        eligibility_desc = descriptor(
            one_file(preflight_root, "eligibility-*.eligibility.json")
        )
        envelope = descriptor(
            one_file(preflight_root, "request-envelope-*.request-envelope.json")
        )
        envelope_value = strict_json(Path(str(envelope["path"])))
        envelope["file"] = Path(str(envelope["path"])).name
        envelope["envelope_id"] = envelope_value["envelope_id"]
    spec["gate5"] = {
        "manifest_sha256": amendment_sha,
        "preliminary_projection": projection,
        "final_projection": dict(projection),
        "final_eligibility": eligibility_desc,
        "final_request_envelope": envelope,
        "canary_id": retained_canary_id,
    }
    return attestation


def prepare_measured_prestate(
    module: Any,
    ctl: Any,
    spec: Mapping[str, Any],
    spec_path: Path,
    attestation: Mapping[str, Any],
) -> None:
    lane = spec["lane_id"]
    lane_control = CONTROL / "lanes" / lane
    lane_control.mkdir(parents=True, mode=0o700, exist_ok=True)
    retained_spec = lane_control / "lane-spec.json"
    module.write_or_match(retained_spec, spec_path.read_bytes())
    prestate_path = lane_control / "measured-prestate.json"
    result_root = module.expected_result_root(ctl.work, spec, CONTROL)
    if prestate_path.exists() or result_root.exists() or result_root.is_symlink():
        raise ValueError(f"{lane}: corrective measured reservation is not fresh")
    reservation_path, _reservation_payload, reservation = module.reservation_identity(
        prestate_path, retained_spec, spec, result_root
    )
    if reservation_path.exists() or reservation_path.is_symlink():
        raise ValueError(f"{lane}: corrective reservation path is occupied")
    value = {
        "schema": "ura-phase6-extended-measured-prestate/1",
        "lane_spec": module.frozen_descriptor(retained_spec),
        "result_root": str(result_root),
        "result_root_reservation": reservation,
        "live_attestation": dict(attestation),
        "measured_args_without_acquisition": module.expected_measured_args(
            spec, attestation, result_root
        ),
        "measured_plan_root": str(lane_control / f"measured-plan-{ATTEMPT_TAG}"),
        "receipts_root": str(lane_control / "receipts"),
        "request_ordering": (
            "fresh_attestation_then_durable_prestate_and_root_reservation_then_"
            "exact_measured_purpose_plan_then_run"
        ),
    }
    module.write_new_atomic(prestate_path, module.canonical(value))
    recovered = module.recover_reserved_result_root(
        prestate_path, value, retained_spec, spec
    )
    if recovered != result_root:
        raise ValueError(f"{lane}: corrective result-root reservation changed")


def write_launch(
    amendment: Path, amendment_sha: str, *, lane_order: Sequence[str]
) -> None:
    value = {
        "schema": "ura-phase6-failed-lane-recovery-launch/1",
        "launched_at_utc": utc_now(),
        "expected_commit": EXPECTED_COMMIT,
        "framework_lock_id": os.environ["URA_FRAMEWORK_LOCK_ID"],
        "execution_scope_id": os.environ["URA_EXECUTION_SCOPE_ID"],
        "control_root": str(CONTROL),
        "attempt": ATTEMPT_TAG,
        "controller": descriptor(Path(__file__)),
        "retained_executor_payload": descriptor(PAYLOAD_PATH),
        "amendment": {**descriptor(amendment), "sha256": amendment_sha},
        "lane_order": list(lane_order),
    }
    write_new(CONTROL / "launch.json", canonical(value))


def record_gate5_failure(
    ctl: Any,
    lane: str,
    exc: BaseException,
    *,
    spec_path: Path,
) -> None:
    spec = strict_json(spec_path)
    if spec.get("lane_id") != lane or spec.get("gate5") is not None:
        raise ValueError(f"{lane}: failed Gate 5 spec is not a truthful pre-Gate spec")
    error_type = type(exc).__name__
    error = str(exc).strip()[:4000] or error_type
    value = {
        "schema": "ura-phase6-gate5-lane-failure/1",
        "status": "failed",
        "failed_at_utc": utc_now(),
        "attempt": ctl.attempt.name,
        "lane_id": lane,
        "stage": "gate5",
        "reason_code": "corrective_gate5_failed",
        "error_type": error_type,
        "error": error,
        "lane_spec": descriptor(spec_path),
        "evidence_eligible": False,
    }
    ctl.failures.append(value)
    write_new(ctl.attempt / f"{lane}.failure.json", canonical(value))
    ctl.event(lane, "gate5", "failed", f"{error_type}: {error}")
    ctl.emit(f"LANE={lane} STAGE=gate5 FAILED: {error_type}: {error}")


def finalize(
    module: Any,
    ctl: Any,
    amendment: Path,
    amendment_sha: str,
    *,
    lane_order: Sequence[str],
) -> int:
    completed = list(ctl.completed)
    failures = list(ctl.failures)
    failed = [str(value["lane_id"]) for value in failures]
    if set(completed) & set(failed) or set(completed) | set(failed) != set(lane_order):
        raise ValueError("corrective lane terminal partition is incomplete")
    status = "complete" if not failed else "complete_with_failures"
    exit_code = 0 if not failed else 1
    summary = {
        "schema": "ura-phase6-failed-lane-recovery-summary/1",
        "status": status,
        "controller_exit_code": exit_code,
        "completed_at_utc": utc_now(),
        "attempt": ATTEMPT_TAG,
        "runnable_inventory": list(lane_order),
        "lane_terminal_states": {
            lane: "measured_complete" if lane in completed else "failed"
            for lane in lane_order
        },
        "completed_lanes": completed,
        "failed_lanes": failed,
        "failures": failures,
        "all_independent_lanes_attempted": True,
        "output_policy": "retain_length_capped_text_and_typed_model_nonresponse",
        "generation_caps_changed": False,
        "unrelated_passed_work_repeated": False,
        "paid_provider_calls": 0,
        "hosted_judge_calls": 0,
        "http_attempts": 0,
        "model_downloads": 0,
    }
    summary_path = ctl.attempt / "summary.json"
    module.write_new(summary_path, module.canonical(summary))
    completion = {
        "schema": "ura-phase6-failed-lane-recovery-completion/1",
        "status": status,
        "controller_exit_code": exit_code,
        "completed_at_utc": utc_now(),
        "attempt": ATTEMPT_TAG,
        "expected_commit": EXPECTED_COMMIT,
        "framework_lock_id": os.environ["URA_FRAMEWORK_LOCK_ID"],
        "inventory_complete": True,
        "runnable_lanes": list(lane_order),
        "lane_terminal_states": summary["lane_terminal_states"],
        "amendment": {**descriptor(amendment), "sha256": amendment_sha},
        "launch": descriptor(CONTROL / "launch.json"),
        "controller": descriptor(Path(__file__)),
        "retained_executor_payload": descriptor(PAYLOAD_PATH),
        "summary": descriptor(summary_path),
        "lane_results": {
            lane: descriptor(ctl.attempt / f"{lane}.complete.json")
            for lane in completed
        },
        "lane_failures": {
            lane: descriptor(ctl.attempt / f"{lane}.failure.json")
            for lane in failed
        },
        "all_independent_lanes_attempted": True,
        "output_policy": "retain_length_capped_text_and_typed_model_nonresponse",
        "generation_caps_changed": False,
        "unrelated_passed_work_repeated": False,
        "paid_provider_calls": 0,
    }
    module.write_new(ctl.attempt / "completion.json", module.canonical(completion))
    return exit_code


def execute_core_lane(module: Any, ctl: Any, spec_path: Path) -> None:
    """Execute one augmented core spec through the retained measured machinery."""

    spec = module.strict_object(spec_path)
    lane = spec["lane_id"]
    module.assert_environment()
    if module.shutil.disk_usage(ctl.work).free < spec["storage"][
        "free_space_floor_bytes"
    ]:
        raise ValueError("resolved filesystem is below the Gate 5 free-space floor")
    lane_control = ctl.control / "lanes" / lane
    lane_control.mkdir(mode=0o700, exist_ok=True)
    retained_spec = lane_control / "lane-spec.json"
    module.write_or_match(retained_spec, spec_path.read_bytes())
    state_path = lane_control / "exact-measured-argv.json"
    prestate_path = lane_control / "measured-prestate.json"
    result_root = module.expected_result_root(ctl.work, spec, ctl.control)
    if state_path.exists():
        try:
            result = module.validate_completed_lane(
                ctl, spec, retained_spec, state_path, "existing"
            )
        except Exception as validation_error:
            ctl.event(
                lane, "existing-revalidation", "incomplete", str(validation_error)
            )
            _state, runner_argv = module.validate_state(
                state_path, spec, retained_spec
            )
            ctl.run_measured(
                lane,
                "runner-resume",
                runner_argv,
                f"{lane}.runner-resume.log",
                spec=spec,
                result_root=result_root,
            )
            result = module.validate_completed_lane(
                ctl, spec, retained_spec, state_path, "resumed"
            )
    else:
        prestate = module.validate_prestate(prestate_path, spec, retained_spec)
        recovered_root = module.recover_reserved_result_root(
            prestate_path, prestate, retained_spec, spec
        )
        if recovered_root != result_root:
            raise ValueError(
                "recovered measured result root differs from the exact lane root"
            )
        measured_args = list(prestate["measured_args_without_acquisition"])
        role_mode = "target_only" if spec["classification"] else "target_and_guard"
        acquisition = module.plan_acquire(
            ctl,
            spec,
            f"{lane}.measured",
            measured_args,
            Path(prestate["measured_plan_root"]),
            Path(prestate["receipts_root"]),
            role_mode,
        )
        runner_argv = [*measured_args, *module.acquisition_args(acquisition)]
        module.write_state(
            state_path, retained_spec, prestate, acquisition, runner_argv
        )
        module.validate_state(state_path, spec, retained_spec)
        ctl.run_measured(
            lane,
            "measured-run",
            runner_argv,
            f"{lane}.measured.run.log",
            spec=spec,
            result_root=result_root,
        )
        result = module.validate_completed_lane(
            ctl, spec, retained_spec, state_path, "complete"
        )
    ctl.event(lane, "measured", "complete", result["grid_id"])
    ctl.emit(f"LANE={lane} MEASURED COMPLETE")
    module.write_new(
        ctl.attempt / f"{lane}.complete.json", module.canonical(result)
    )
    ctl.completed.append(lane)


def main(args: Sequence[str]) -> int:
    retry_source = parse_retry_source(args)
    runnote = RETRY_RUNNOTE if retry_source is not None else BASE_RUNNOTE
    module = load_payload()
    all_specs = assert_inputs(module, runnote=runnote)
    validate_specs_contract(module, all_specs)
    if retry_source is None:
        specs = all_specs
    else:
        by_lane = {str(spec["lane_id"]): spec for spec in all_specs}
        specs = [by_lane[lane] for lane in retry_source["failed_lanes"]]
    lane_order = tuple(str(spec["lane_id"]) for spec in specs)
    CONTROL.mkdir(mode=0o700)
    (CONTROL / "attempts").mkdir(mode=0o700)
    (CONTROL / "lane-specs").mkdir(mode=0o700)
    os.environ["CONTROL_ROOT"] = str(CONTROL)
    os.environ["ATTEMPT_TAG"] = ATTEMPT_TAG
    write_runnote(specs, runnote=runnote, retry_source=retry_source)
    amendment, amendment_sha = write_amendment(
        specs, runnote=runnote, retry_source=retry_source
    )
    write_launch(amendment, amendment_sha, lane_order=lane_order)
    ctl = module.Controller()
    exit_code = 1
    for signum in (signal.SIGHUP, signal.SIGINT, signal.SIGTERM):
        signal.signal(signum, module.abort_signal)
    try:
        for index, spec in enumerate(specs, start=1):
            lane = spec["lane_id"]
            spec_path = CONTROL / "lane-specs" / f"{index:02d}-{lane}.json"
            ctl.begin_lane(lane, spec["approved_caps"]["wall_time_seconds"])
            gate5_error: Exception | None = None
            measured_error: Exception | None = None
            try:
                signal.setitimer(
                    signal.ITIMER_REAL, spec["approved_caps"]["wall_time_seconds"]
                )
                try:
                    attestation = corrective_gate5(
                        module, ctl, spec, amendment_sha
                    )
                except module.ControllerInterrupted:
                    raise
                except Exception as exc:  # noqa: BLE001 - retain each Gate 5 failure
                    gate5_error = exc
                if gate5_error is None:
                    write_new(spec_path, canonical(spec))
                    try:
                        prepare_measured_prestate(
                            module, ctl, spec, spec_path, attestation
                        )
                        execute_core_lane(module, ctl, spec_path)
                    except module.ControllerInterrupted:
                        raise
                    except Exception as exc:  # noqa: BLE001 - retain measured failure
                        measured_error = exc
            except module.ControllerInterrupted:
                raise
            finally:
                signal.setitimer(signal.ITIMER_REAL, 0)
                ctl.end_lane(lane)
            if gate5_error is not None:
                write_new(spec_path, canonical(spec))
                record_gate5_failure(
                    ctl, lane, gate5_error, spec_path=spec_path
                )
            elif measured_error is not None:
                ctl.record_failure(
                    lane, "measured", measured_error, spec_path=spec_path
                )
        exit_code = finalize(
            module, ctl, amendment, amendment_sha, lane_order=lane_order
        )
    except Exception as exc:  # noqa: BLE001 - retain controller failure
        if isinstance(exc, module.ControllerInterrupted):
            exit_code = exc.exit_code
        ctl.record_failure("controller", "controller", exc)
        ctl.log.write(traceback.format_exc() + "\n")
        module.write_new(
            ctl.attempt / "controller-failure.json",
            module.canonical(
                {
                    "schema": "ura-phase6-failed-lane-recovery-failure/1",
                    "status": "failed",
                    "failed_at_utc": utc_now(),
                    "error_type": type(exc).__name__,
                    "error": str(exc)[:4000],
                }
            ),
        )
    finally:
        ctl.log.flush()
        os.fsync(ctl.log.fileno())
        ctl.log.close()
        module.write_new(ctl.attempt / ".exit", f"{exit_code}\n".encode("ascii"))
    return exit_code


def contract_self_test() -> int:
    module = load_payload()
    specs = assert_inputs(module, runnote=RETRY_RUNNOTE)
    validate_specs_contract(module, specs)
    print(
        json.dumps(
            {
                "schema": "ura-phase6-failed-lane-recovery-contract-self-test/1",
                "status": "passed",
                "project_commit": EXPECTED_COMMIT,
                "lane_order": list(LANE_ORDER),
                "runner_code_version": "ura-runner/2.24",
                "generation_caps_changed": False,
                "unrelated_passed_work_repeated": False,
                "canary_selection": "one_source_arm_one_attacker_one_seed",
                "retained_completed_core_lanes": [
                    "rjudge-qwen3-vl", "rjudge-llava-base",
                    "gptgeochat-llava-base",
                ],
                "preflight_live_state": False,
                "reservation_scope": "lane_and_corrective_control_root",
                "model_calls": 0,
                "failed_subset_retry_supported": True,
            },
            sort_keys=True,
            separators=(",", ":"),
        )
    )
    return 0


if __name__ == "__main__":
    if sys.argv[1:] == ["--contract-self-test"]:
        raise SystemExit(contract_self_test())
    raise SystemExit(main(sys.argv[1:]))
