def exact_typed_int_contract(
    raw: object, expected: Mapping[str, Any], int_fields: Iterable[str]
) -> bool:
    return (
        isinstance(raw, Mapping)
        and dict(raw) == dict(expected)
        and all(type(raw.get(field)) is int for field in int_fields)
    )


def exact_json_contract(raw: object, expected: object) -> bool:
    """Compare retained JSON without Python's bool/int equality aliasing."""

    if type(raw) is not type(expected):
        return False
    if isinstance(expected, dict):
        return set(raw) == set(expected) and all(
            exact_json_contract(raw[key], expected[key]) for key in expected
        )
    if isinstance(expected, list):
        return len(raw) == len(expected) and all(
            exact_json_contract(item, wanted) for item, wanted in zip(raw, expected)
        )
    return raw == expected


def defense_na_variant_from_value(value: object) -> Mapping[str, Any]:
    if not isinstance(value, Mapping):
        raise Gate5Error("defense-local: conditional N/A artifact is not an object")
    variant = DEFENSE_NA_VARIANTS.get(value.get("schema"))
    if variant is None:
        raise Gate5Error("defense-local: conditional N/A schema is not an allowed variant")
    expected_top = {
        "schema", "status", "lane_id", "disposition", "reason_code", "reason",
        "classified_at_utc", "classification", "bindings", "call_accounting",
        "runner_outputs", "artifacts", "resource_identities",
    }
    if variant["evidence_limits"] is not None:
        expected_top.add("evidence_limits")
    if set(value) != expected_top:
        raise Gate5Error("defense-local: conditional N/A top-level schema changed")
    if (
        value.get("status") != "N/A"
        or value.get("lane_id") != "defense-local"
        or value.get("disposition") != DEFENSE_NA_DISPOSITION
        or value.get("reason_code") != variant["reason_code"]
        or value.get("reason") != variant["reason"]
        or not exact_json_contract(value.get("classification"), variant["classification"])
        or not exact_json_contract(value.get("call_accounting"), variant["call_accounting"])
        or not exact_json_contract(value.get("runner_outputs"), variant["runner_outputs"])
        or not exact_json_contract(value.get("evidence_limits"), variant["evidence_limits"])
    ):
        raise Gate5Error(
            "defense-local: conditional N/A variant fields are cross-mixed or changed"
        )
    return variant


def defense_na_manifest_variant(raw: Mapping[str, Any]) -> Mapping[str, Any]:
    matches = [
        variant for variant in DEFENSE_NA_VARIANTS.values()
        if raw.get("reason_code") == variant["reason_code"]
        and raw.get("reason") == variant["reason"]
        and exact_json_contract(
            raw.get("canary", {}).get("call_accounting")
            if isinstance(raw.get("canary"), Mapping) else None,
            variant["call_accounting"],
        )
    ]
    if len(matches) != 1:
        raise Gate5Error(
            "defense-local: conditional N/A manifest variant is cross-mixed or changed"
        )
    return matches[0]


