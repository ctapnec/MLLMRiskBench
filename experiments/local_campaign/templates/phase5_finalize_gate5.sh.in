#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

# Gate 5 has a deliberate two-step control surface:
#   1. omit --launch to validate the complete evidence inventory and print its digest;
#   2. repeat the command with --launch and --authorize-manifest-sha256 <that digest>.
# Nothing is written before the second invocation has revalidated the same digest.

if [[ ! -r "$HOME/.ura_campaign_env" ]]; then
  printf 'missing campaign environment: %s/.ura_campaign_env\n' "$HOME" >&2
  exit 2
fi
# shellcheck disable=SC1091
source "$HOME/.ura_campaign_env"

PROJECT_ROOT="${URA_PROJECT_ROOT:-$HOME/MLLMRiskBench}"
if [[ ! -d "$PROJECT_ROOT" ]]; then
  printf 'missing project checkout: %s\n' "$PROJECT_ROOT" >&2
  exit 2
fi
cd "$PROJECT_ROOT"

PY="$PROJECT_ROOT/.venv/bin/python"
if [[ ! -x "$PY" ]]; then
  printf 'missing project interpreter: %s\n' "$PY" >&2
  exit 2
fi

export URA_GATE5_FINALIZER_SCRIPT
test -e "/proc/$$/fd/255" || { printf 'controller script descriptor is unavailable\n' >&2; exit 2; }
URA_GATE5_FINALIZER_SCRIPT="$(readlink -f -- "/proc/$$/fd/255")"
test -f "$URA_GATE5_FINALIZER_SCRIPT" && test ! -L "$URA_GATE5_FINALIZER_SCRIPT"
export PYTHONDONTWRITEBYTECODE=1

exec "$PY" - "$@" <<'PY'
from __future__ import annotations

