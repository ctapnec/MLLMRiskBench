class Gate5Error(RuntimeError):
    pass


def utc_now() -> str:
    return datetime.now(timezone.utc).isoformat().replace("+00:00", "Z")


def canonical_bytes(value: object) -> bytes:
    return (
        json.dumps(
            value,
            ensure_ascii=False,
            sort_keys=True,
            separators=(",", ":"),
            allow_nan=False,
        )
        + "\n"
    ).encode("utf-8")


def sha256_bytes(payload: bytes) -> str:
    return hashlib.sha256(payload).hexdigest()


def stable_file_observation(
    path_value: str | Path,
    *,
    max_bytes: int | None,
    retain_payload: bool = False,
) -> tuple[Path, str, int, bytes | None]:
    """Read one regular file through a stable, no-follow descriptor."""

    path = Path(path_value).expanduser()
    try:
        unresolved_before = path.lstat()
        resolved = path.resolve(strict=True)
        resolved_before = resolved.lstat()
    except OSError as exc:
        raise Gate5Error(f"cannot resolve required file {path}: {exc}") from exc
    if (
        stat.S_ISLNK(unresolved_before.st_mode)
        or not stat.S_ISREG(unresolved_before.st_mode)
        or stat.S_ISLNK(resolved_before.st_mode)
        or not stat.S_ISREG(resolved_before.st_mode)
        or (unresolved_before.st_dev, unresolved_before.st_ino)
        != (resolved_before.st_dev, resolved_before.st_ino)
    ):
        raise Gate5Error(f"required file is not regular and symlink-free: {path}")
    flags = (
        os.O_RDONLY
        | getattr(os, "O_BINARY", 0)
        | getattr(os, "O_CLOEXEC", 0)
        | getattr(os, "O_NOFOLLOW", 0)
    )
    try:
        fd = os.open(resolved, flags)
    except OSError as exc:
        raise Gate5Error(
            f"cannot open required file without following links: {resolved}: {exc}"
        ) from exc
    digest = hashlib.sha256()
    observed = 0
    chunks: list[bytes] | None = [] if retain_payload else None
    try:
        opened_before = os.fstat(fd)
        if (
            not stat.S_ISREG(opened_before.st_mode)
            or (opened_before.st_dev, opened_before.st_ino)
            != (resolved_before.st_dev, resolved_before.st_ino)
        ):
            raise Gate5Error(f"required file changed before it was opened: {resolved}")
        if max_bytes is not None and opened_before.st_size > max_bytes:
            raise Gate5Error(f"required file exceeds {max_bytes} bytes: {resolved}")
        while True:
            block = os.read(fd, 1024 * 1024)
            if not block:
                break
            observed += len(block)
            if max_bytes is not None and observed > max_bytes:
                raise Gate5Error(f"required file exceeds {max_bytes} bytes: {resolved}")
            digest.update(block)
            if chunks is not None:
                chunks.append(block)
        opened_after = os.fstat(fd)
    finally:
        os.close(fd)
    try:
        unresolved_after = path.lstat()
        resolved_after = resolved.lstat()
        current_resolution = path.resolve(strict=True)
    except OSError as exc:
        raise Gate5Error(f"required file changed after reading: {path}: {exc}") from exc
    identity_before = (
        opened_before.st_dev,
        opened_before.st_ino,
        opened_before.st_size,
        opened_before.st_mtime_ns,
    )
    if (
        current_resolution != resolved
        or stat.S_ISLNK(unresolved_after.st_mode)
        or not stat.S_ISREG(unresolved_after.st_mode)
        or stat.S_ISLNK(resolved_after.st_mode)
        or not stat.S_ISREG(resolved_after.st_mode)
        or identity_before
        != (
            opened_after.st_dev,
            opened_after.st_ino,
            opened_after.st_size,
            opened_after.st_mtime_ns,
        )
        or (opened_after.st_dev, opened_after.st_ino)
        != (unresolved_after.st_dev, unresolved_after.st_ino)
        or (opened_after.st_dev, opened_after.st_ino)
        != (resolved_after.st_dev, resolved_after.st_ino)
        or observed != opened_after.st_size
    ):
        raise Gate5Error(f"required file changed while reading: {resolved}")
    payload = b"".join(chunks) if chunks is not None else None
    return resolved, digest.hexdigest(), observed, payload


def sha256_file(path: Path, *, max_bytes: int | None = None) -> str:
    return stable_file_observation(
        path, max_bytes=max_bytes, retain_payload=False
    )[1]


def stable_text(
    path_value: str | Path,
    *,
    max_bytes: int,
    errors: str = "strict",
) -> tuple[Path, str]:
    path, _digest, _size, payload = stable_file_observation(
        path_value, max_bytes=max_bytes, retain_payload=True
    )
    assert payload is not None
    try:
        text = payload.decode("utf-8", errors=errors)
    except UnicodeError as exc:
        raise Gate5Error(f"required text file is not UTF-8: {path}") from exc
    return path, text


def descriptor(path: Path, *, max_bytes: int | None = None) -> dict[str, Any]:
    resolved, digest, size, _payload = stable_file_observation(
        path, max_bytes=max_bytes, retain_payload=False
    )
    return {
        "path": str(resolved),
        "sha256": digest,
        "bytes": size,
    }


def checked_file(path_value: str | Path, *, max_bytes: int | None = None) -> Path:
    path = Path(path_value).expanduser()
    try:
        info = path.lstat()
        resolved = path.resolve(strict=True)
    except OSError as exc:
        raise Gate5Error(f"cannot resolve required file {path}: {exc}") from exc
    if path.is_symlink() or not stat.S_ISREG(info.st_mode):
        raise Gate5Error(f"required file is not a regular non-symlink: {path}")
    final = resolved.lstat()
    if not stat.S_ISREG(final.st_mode):
        raise Gate5Error(f"resolved file is not regular: {resolved}")
    if max_bytes is not None and final.st_size > max_bytes:
        raise Gate5Error(f"required file exceeds {max_bytes} bytes: {resolved}")
    return resolved


def checked_project_python(project_root: Path) -> Path:
    """Validate a standard venv interpreter symlink without resolving it for execution."""

    venv_root = checked_dir(project_root / ".venv", label="project virtual environment")
    bin_root = checked_dir(venv_root / "bin", label="project virtual-environment bin")
    checked_file(venv_root / "pyvenv.cfg", max_bytes=1024 * 1024)
    interpreter = bin_root / "python"
    try:
        entry = interpreter.lstat()
        target = interpreter.resolve(strict=True)
        target_entry = target.lstat()
    except OSError as exc:
        raise Gate5Error(f"cannot resolve project virtual-environment interpreter: {exc}") from exc
    if (
        not (stat.S_ISREG(entry.st_mode) or stat.S_ISLNK(entry.st_mode))
        or not stat.S_ISREG(target_entry.st_mode)
        or not os.access(interpreter, os.X_OK)
        or not os.access(target, os.X_OK)
    ):
        raise Gate5Error("project virtual-environment interpreter is not an executable regular target")
    # Preserve the venv entry path. Invoking its resolved base-Python target would
    # bypass pyvenv.cfg and therefore the pinned project environment.
    return interpreter


def checked_dir(path_value: str | Path, *, label: str) -> Path:
    path = Path(path_value).expanduser()
    try:
        info = path.lstat()
        resolved = path.resolve(strict=True)
    except OSError as exc:
        raise Gate5Error(f"cannot resolve {label} {path}: {exc}") from exc
    if path.is_symlink() or not stat.S_ISDIR(info.st_mode):
        raise Gate5Error(f"{label} is not a non-symlink directory: {path}")
    if not resolved.is_dir():
        raise Gate5Error(f"resolved {label} is not a directory: {resolved}")
    return resolved


def read_strict_json(path_value: str | Path, *, max_bytes: int = MAX_JSON_BYTES) -> dict[str, Any]:
    path, _digest, _size, raw = stable_file_observation(
        path_value, max_bytes=max_bytes, retain_payload=True
    )
    assert raw is not None
    try:
        value = strict_json_loads(raw.decode("utf-8"))
    except (UnicodeError, TypeError, ValueError) as exc:
        raise Gate5Error(f"strict JSON validation failed for {path}: {exc}") from exc
    if not isinstance(value, dict):
        raise Gate5Error(f"expected a JSON object: {path}")
    return value


def eligibility_descriptor_from_bytes(
    path: Path, *, digest: str, payload: bytes
) -> dict[str, Any]:
    try:
        text = payload.decode("utf-8")
    except UnicodeError as exc:
        raise Gate5Error(f"eligibility artifact is not UTF-8: {path}") from exc
    records = sum(1 for line in text.splitlines() if line.strip())
    if records <= 0:
        raise Gate5Error(f"eligibility artifact has no nonblank records: {path}")
    return {
        "file": path.name,
        "sha256": digest,
        "bytes": len(payload),
        "records": records,
    }


def eligibility_binding_descriptor(path_value: str | Path) -> dict[str, Any]:
    """Rebuild run_matrix's exact line-counted eligibility descriptor."""

    path, digest, _size, payload = stable_file_observation(
        path_value, max_bytes=MAX_JSON_BYTES, retain_payload=True
    )
    assert payload is not None
    return eligibility_descriptor_from_bytes(path, digest=digest, payload=payload)


def load_eligibility_artifact(
    path_value: str | Path,
) -> tuple[dict[str, Any], dict[str, Any]]:
    """Parse, validate, and describe eligibility from one stable file read."""

    path, digest, _size, payload = stable_file_observation(
        path_value, max_bytes=MAX_JSON_BYTES, retain_payload=True
    )
    assert payload is not None
    try:
        raw = strict_json_loads(payload.decode("utf-8"))
        eligibility = validate_eligibility_plan(raw)
    except (UnicodeError, TypeError, ValueError) as exc:
        raise Gate5Error(f"eligibility validation failed for {path}: {exc}") from exc
    return eligibility, eligibility_descriptor_from_bytes(
        path, digest=digest, payload=payload
    )


def load_stable_lane_projection_file(
    path_value: str | Path,
    expected_sha256: str | None = None,
) -> tuple[dict[str, Any], dict[str, Any]]:
    """Parse and describe one lane projection from one stable observation."""

    path, digest, size, payload = stable_file_observation(
        path_value, max_bytes=MAX_LANE_PROJECTION_BYTES, retain_payload=True
    )
    assert payload is not None
    if expected_sha256 is not None and digest != expected_sha256:
        raise Gate5Error(f"lane-projection byte digest changed: {path}")
    try:
        raw = strict_json_loads(payload.decode("utf-8"))
        projection = validate_lane_projection(raw)
    except (UnicodeError, TypeError, ValueError) as exc:
        raise Gate5Error(f"lane-projection validation failed for {path}: {exc}") from exc
    if path.name != f"{projection['projection_id']}.lane-projection.json":
        raise Gate5Error(f"lane-projection filename/content identity changed: {path}")
    return projection, {"file": path.name, "sha256": digest, "bytes": size}


def load_stable_request_envelope_file(
    path_value: str | Path,
) -> tuple[dict[str, Any], dict[str, Any]]:
    """Parse and describe one envelope from the same stable observation."""

    path, digest, size, payload = stable_file_observation(
        path_value, max_bytes=MAX_REQUEST_ENVELOPE_BYTES, retain_payload=True
    )
    assert payload is not None
    try:
        raw = strict_json_loads(payload.decode("utf-8"))
        envelope = validate_request_envelope(raw)
        canonical = request_envelope_bytes(envelope)
    except (UnicodeError, TypeError, ValueError) as exc:
        raise Gate5Error(f"request-envelope validation failed for {path}: {exc}") from exc
    expected_name = f"{envelope['envelope_id']}.request-envelope.json"
    if path.name != expected_name or payload != canonical:
        raise Gate5Error(f"request-envelope filename or canonical bytes changed: {path}")
    descriptor_value = {
        "envelope_id": envelope["envelope_id"],
        "file": path.name,
        "sha256": digest,
        "bytes": size,
    }
    try:
        envelope_descriptor = validate_request_envelope_descriptor(descriptor_value)
    except ValueError as exc:
        raise Gate5Error(f"request-envelope descriptor is invalid for {path}: {exc}") from exc
    return envelope, envelope_descriptor


def validate_eligibility_envelope_binding(
    eligibility: Mapping[str, Any],
    envelope_descriptor: Mapping[str, Any],
    *,
    label: str,
) -> None:
    """Require eligibility and acquisition admission to bind this envelope."""

    bindings = eligibility.get("bindings")
    retained = bindings.get("request_envelope") if isinstance(bindings, dict) else None
    if retained != dict(envelope_descriptor):
        raise Gate5Error(f"{label}: eligibility does not bind the retained request envelope")
    acquisition = bindings.get("model_acquisition")
    selection = acquisition.get("selection") if isinstance(acquisition, dict) else None
    input_bindings = selection.get("input_bindings") if isinstance(selection, dict) else None
    if (
        not isinstance(input_bindings, dict)
        or input_bindings.get("request_envelope_sha256")
        != envelope_descriptor.get("sha256")
    ):
        raise Gate5Error(
            f"{label}: model acquisition does not bind the retained request envelope"
        )


def retained_binding_contract_self_test() -> dict[str, Any]:
    """Exercise real multiline bytes and an envelope-swap mutation."""

    with tempfile.TemporaryDirectory(prefix="ura-gate5-binding-") as temp_root:
        eligibility_path = Path(temp_root) / "eligibility-fixture.eligibility.json"
        payload = b'{\n  "fixture": true\n}\n'
        with eligibility_path.open("xb") as handle:
            handle.write(payload)
            handle.flush()
            os.fsync(handle.fileno())
        observed = eligibility_binding_descriptor(eligibility_path)
    if observed["records"] != 3 or observed["bytes"] != len(payload):
        raise Gate5Error("multiline eligibility descriptor self-test failed")
    envelope_descriptor = {
        "envelope_id": "request-envelope-" + "a" * 24,
        "file": "request-envelope-" + "a" * 24 + ".request-envelope.json",
        "sha256": "b" * 64,
        "bytes": 123,
    }
    eligibility = {
        "bindings": {
            "request_envelope": dict(envelope_descriptor),
            "model_acquisition": {
                "selection": {
                    "input_bindings": {
                        "request_envelope_sha256": envelope_descriptor["sha256"]
                    }
                }
            },
        }
    }
    validate_eligibility_envelope_binding(
        eligibility, envelope_descriptor, label="binding self-test"
    )
    swapped = {**envelope_descriptor, "sha256": "c" * 64}
    try:
        validate_eligibility_envelope_binding(
            eligibility, swapped, label="binding self-test mutation"
        )
    except Gate5Error:
        swap_rejected = True
    else:
        raise Gate5Error("request-envelope swap self-test did not fail closed")
    return {
        "eligibility_nonblank_records": observed["records"],
        "hardcoded_one_rejected": observed["records"] != 1,
        "request_envelope_swap_rejected": swap_rejected,
    }


def exact_descriptor(raw: object, *, label: str) -> Path:
    if not isinstance(raw, dict) or set(raw) != {"path", "sha256", "bytes"}:
        raise Gate5Error(f"{label} descriptor fields changed")
    if (
        not isinstance(raw.get("path"), str)
        or not Path(raw["path"]).is_absolute()
        or not isinstance(raw.get("sha256"), str)
        or HEX64_RE.fullmatch(raw["sha256"]) is None
        or isinstance(raw.get("bytes"), bool)
        or not isinstance(raw.get("bytes"), int)
        or raw["bytes"] <= 0
    ):
        raise Gate5Error(f"{label} descriptor values changed")
    path = checked_file(raw["path"], max_bytes=MAX_JSON_BYTES)
    if descriptor(path, max_bytes=MAX_JSON_BYTES) != raw:
        raise Gate5Error(f"{label} descriptor bytes changed")
    return path


# BEGIN_RR_EVIDENCE_TREE_DESCRIPTOR
def rr_tree_inventory(
    root: Path,
    *,
    label: str = "RR evidence",
) -> tuple[list[tuple[str, Path]], dict[str, tuple[int, int, int, int, int]]]:
    """Enumerate one exact, symlink-free evidence-tree inventory."""

    files: list[tuple[str, Path]] = []
    identities: dict[str, tuple[int, int, int, int, int]] = {}
    try:
        members = list(root.rglob("*"))
    except OSError as exc:
        raise Gate5Error(f"cannot enumerate {label} root {root}: {exc}") from exc
    for member in members:
        relative = member.relative_to(root).as_posix()
        try:
            entry = member.lstat()
        except OSError as exc:
            raise Gate5Error(f"cannot inspect {label} member {member}: {exc}") from exc
        if stat.S_ISLNK(entry.st_mode):
            raise Gate5Error(f"{label} root contains a symlink: {member}")
        if stat.S_ISDIR(entry.st_mode):
            kind = stat.S_IFDIR
        elif stat.S_ISREG(entry.st_mode):
            kind = stat.S_IFREG
            files.append((relative, member))
        else:
            raise Gate5Error(f"{label} root contains a non-regular member: {member}")
        identities[relative] = (
            kind,
            entry.st_dev,
            entry.st_ino,
            entry.st_size,
            entry.st_mtime_ns,
        )
    files.sort(key=lambda item: item[0])
    return files, identities


def rr_tree_descriptor(path_value: str | Path) -> dict[str, Any]:
    root = checked_dir(path_value, label="RR evidence root")
    try:
        root_before = root.lstat()
    except OSError as exc:
        raise Gate5Error(f"cannot inspect RR evidence root {root}: {exc}") from exc
    if not stat.S_ISDIR(root_before.st_mode):
        raise Gate5Error(f"RR evidence root is not a directory: {root}")
    files, inventory_before = rr_tree_inventory(root)
    if not files:
        raise Gate5Error(f"RR evidence root is empty: {root}")
    tree_hash = hashlib.sha256()
    total_bytes = 0
    for relative, member in files:
        _resolved, file_sha, file_bytes, _payload = stable_file_observation(
            member, max_bytes=None, retain_payload=False
        )
        try:
            current = member.lstat()
        except OSError as exc:
            raise Gate5Error(
                f"RR evidence member changed after reading: {member}: {exc}"
            ) from exc
        current_identity = (
            stat.S_IFMT(current.st_mode),
            current.st_dev,
            current.st_ino,
            current.st_size,
            current.st_mtime_ns,
        )
        if current_identity != inventory_before[relative]:
            raise Gate5Error(f"RR evidence member changed during tree scan: {member}")
        total_bytes += file_bytes
        tree_hash.update(relative.encode("utf-8"))
        tree_hash.update(b"\0")
        tree_hash.update(str(file_bytes).encode("ascii"))
        tree_hash.update(b"\0")
        tree_hash.update(file_sha.encode("ascii"))
        tree_hash.update(b"\n")
    files_after, inventory_after = rr_tree_inventory(root)
    try:
        root_after = root.lstat()
    except OSError as exc:
        raise Gate5Error(f"RR evidence root changed after scanning: {root}: {exc}") from exc
    root_identity_before = (
        stat.S_IFMT(root_before.st_mode),
        root_before.st_dev,
        root_before.st_ino,
        root_before.st_size,
        root_before.st_mtime_ns,
    )
    root_identity_after = (
        stat.S_IFMT(root_after.st_mode),
        root_after.st_dev,
        root_after.st_ino,
        root_after.st_size,
        root_after.st_mtime_ns,
    )
    if (
        [relative for relative, _member in files_after]
        != [relative for relative, _member in files]
        or inventory_after != inventory_before
        or root_identity_after != root_identity_before
    ):
        raise Gate5Error(f"RR evidence root changed during tree scan: {root}")
    return {
        "path": str(root),
        "sha256": tree_hash.hexdigest(),
        "bytes": total_bytes,
        "files": len(files),
    }
# END_RR_EVIDENCE_TREE_DESCRIPTOR


def validate_rr_tree_descriptor(raw: object, *, key: str, work: Path) -> Path:
    if not isinstance(raw, dict) or set(raw) != {"path", "sha256", "bytes", "files"}:
        raise Gate5Error(f"RR {key} tree descriptor fields changed")
    expected_path = checked_dir(
        EXPECTED_RR_EVIDENCE_ROOTS[key], label=f"RR {key} evidence root"
    )
    if (
        raw.get("path") != str(expected_path)
        or not expected_path.is_relative_to(work)
        or not isinstance(raw.get("sha256"), str)
        or HEX64_RE.fullmatch(raw["sha256"]) is None
        or isinstance(raw.get("bytes"), bool)
        or not isinstance(raw.get("bytes"), int)
        or raw["bytes"] < 0
        or isinstance(raw.get("files"), bool)
        or not isinstance(raw.get("files"), int)
        or raw["files"] <= 0
        or rr_tree_descriptor(expected_path) != raw
    ):
        raise Gate5Error(f"RR {key} tree descriptor changed")
    return expected_path


def engineering_probe_record(path: Path, schema: str) -> dict[str, Any]:
    matches = [
        value for value in json_objects_from_log(path)
        if value.get("schema") == schema
    ]
    if len(matches) != 1:
        raise Gate5Error(f"RR probe log lacks one exact {schema} record")
    return matches[0]


def write_create_only(path: Path, payload: bytes, *, mode: int = 0o600) -> dict[str, Any]:
    if path.exists() or path.is_symlink():
        raise Gate5Error(f"create-only destination already exists: {path}")
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
    fd = os.open(path, flags, mode)
    try:
        with os.fdopen(fd, "wb", closefd=True) as handle:
            fd = -1
            handle.write(payload)
            handle.flush()
            os.fsync(handle.fileno())
    finally:
        if fd >= 0:
            os.close(fd)
    return {
        "path": str(path.resolve()),
        "sha256": sha256_bytes(payload),
        "bytes": len(payload),
    }


def mkdir_create_only(path: Path, *, mode: int = 0o700) -> Path:
    if path.exists() or path.is_symlink():
        raise Gate5Error(f"create-only directory already exists: {path}")
    try:
        path.mkdir(mode=mode)
    except OSError as exc:
        raise Gate5Error(f"cannot create directory {path}: {exc}") from exc
    return path.resolve()


def run_capture(argv: Sequence[str], *, cwd: Path, timeout: int = 30) -> str:
    try:
        result = subprocess.run(
            list(argv),
            cwd=cwd,
            check=False,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=timeout,
        )
    except (OSError, subprocess.SubprocessError) as exc:
        raise Gate5Error(f"cannot execute read-only command {argv!r}: {exc}") from exc
    if result.returncode != 0:
        message = result.stderr.strip() or result.stdout.strip()
        raise Gate5Error(f"read-only command failed ({result.returncode}): {message[:2000]}")
    return result.stdout.strip()


def validate_checkout(project_root: Path) -> dict[str, Any]:
    commit = run_capture(["git", "rev-parse", "HEAD"], cwd=project_root)
    if commit != EXPECTED_COMMIT:
        raise Gate5Error(f"checkout commit {commit!r} is not {EXPECTED_COMMIT}")
    status_text = run_capture(["git", "status", "--porcelain"], cwd=project_root)
    if status_text:
        raise Gate5Error("project checkout is not clean")
    lock = os.environ.get("URA_FRAMEWORK_LOCK_ID", "")
    state = os.environ.get("URA_FRAMEWORK_STATE", "")
    work = Path(required_env("URA_WORK")).expanduser().resolve(strict=True)
    expected_state = work / "runs" / "engineering" / (
        "framework-runtime-" + EXPECTED_FRAMEWORK_LOCK[:12]
    )
    if lock != EXPECTED_FRAMEWORK_LOCK:
        raise Gate5Error("framework lock identity is absent or mismatched")
    if Path(state).expanduser().resolve(strict=True) != expected_state.resolve(strict=True):
        raise Gate5Error("framework runtime state is not bound to the expected lock")
    return {
        "commit": commit,
        "clean": True,
        "framework_lock_id": lock,
        "framework_state": str(expected_state.resolve()),
    }


def required_env(name: str) -> str:
    value = os.environ.get(name, "").strip()
    if not value:
        raise Gate5Error(f"required campaign environment variable is empty: {name}")
    return value


def validate_project_receipt(project_root: Path) -> dict[str, Any]:
    manifest_env = required_env("URA_PROJECT_REVISION_MANIFEST")
    if manifest_env != EXPECTED_PROJECT_RECEIPT:
        raise Gate5Error("URA_PROJECT_REVISION_MANIFEST is not the recascaded receipt")
    manifest = checked_file(manifest_env, max_bytes=MAX_JSON_BYTES)
    expected_sha = required_env("URA_PROJECT_REVISION_SHA256").lower()
    if expected_sha != EXPECTED_PROJECT_RECEIPT_SHA256:
        raise Gate5Error("URA_PROJECT_REVISION_SHA256 is not the recascaded digest")
    receipt, binding = load_project_revision_file(
        manifest,
        expected_sha,
        project_root / "experiments" / "run_matrix.py",
        recheck_checkout=True,
    )
    return {
        "artifact": descriptor(manifest, max_bytes=MAX_JSON_BYTES),
        "revision_id": receipt["revision_id"],
        "binding": binding,
    }


def validate_source_receipt() -> dict[str, Any]:
    manifest_env = required_env("URA_SOURCE_CONFORMANCE_MANIFEST")
    if manifest_env != EXPECTED_SOURCE_RECEIPT:
        raise Gate5Error("URA_SOURCE_CONFORMANCE_MANIFEST is not the 45-arm receipt")
    manifest = checked_file(manifest_env, max_bytes=MAX_JSON_BYTES)
    expected_sha = required_env("URA_SOURCE_CONFORMANCE_SHA256").lower()
    if expected_sha != EXPECTED_SOURCE_RECEIPT_SHA256:
        raise Gate5Error("URA_SOURCE_CONFORMANCE_SHA256 is not the 45-arm digest")
    observed = sha256_file(manifest, max_bytes=MAX_JSON_BYTES)
    if observed != expected_sha:
        raise Gate5Error("source-conformance manifest digest mismatch")
    value = validate_source_conformance_manifest(read_strict_json(manifest))
    dispositions: dict[str, int] = {}
    raw_totals = {
        "discovered": 0,
        "accepted": 0,
        "excluded_by_design": 0,
        "rejected_invalid": 0,
    }
    arm_rows: list[dict[str, Any]] = []
    for arm in value["arms"]:
        disposition = arm["disposition"]
        dispositions[disposition] = dispositions.get(disposition, 0) + 1
        raw = arm.get("raw_records")
        if isinstance(raw, dict):
            for field in raw_totals:
                raw_totals[field] += raw[field]
        review = arm.get("semantic_review")
        arm_rows.append({
            "arm_id": arm["arm_id"],
            "converter": arm["converter"],
            "disposition": disposition,
            "reason": arm["reason"],
            "requested_revision": arm.get("requested_revision"),
            "observed_revision": arm.get("observed_revision"),
            "consumed_input": arm.get("consumed_input"),
            "components": arm.get("components", []),
            "raw_records": raw,
            "semantic_review_status": review.get("status") if isinstance(review, dict) else None,
            "reviewed_converted_corpus_sha256": (
                review.get("reviewed_converted_corpus_sha256")
                if isinstance(review, dict) else None
            ),
        })
    blocked_ids = {
        arm["arm_id"] for arm in value["arms"] if arm["disposition"] == "blocked"
    }
    if (
        len(value["arms"]) != EXPECTED_SOURCE_ARM_COUNT
        or dispositions != EXPECTED_SOURCE_DISPOSITIONS
        or blocked_ids != {EXPECTED_BLOCKED_SOURCE_ARM}
    ):
        raise Gate5Error(
            "source-conformance receipt is not exactly 45 arms: "
            "44 admitted and bipia_test_qa blocked"
        )
    return {
        "artifact": descriptor(manifest, max_bytes=MAX_JSON_BYTES),
        "claim_scope": value["claim_scope"],
        "arm_count": len(value["arms"]),
        "dispositions": dict(sorted(dispositions.items())),
        "raw_record_totals": raw_totals,
        "arms": arm_rows,
        "runtime_rehash_caveat": (
            "file inputs and declared components carry exact bytes/SHA-256; directory inputs "
            "are rebound by converted-corpus and selected runtime media evidence rather than "
            "a recursive directory digest"
        ),
    }


def read_tsv(path: Path) -> list[dict[str, str]]:
    source, text = stable_text(path, max_bytes=16 * 1024 * 1024)
    rows = list(csv.DictReader(io.StringIO(text, newline=""), delimiter="\t"))
    if not rows:
        raise Gate5Error(f"TSV has no data rows: {source}")
    if any(None in row for row in rows):
        raise Gate5Error(f"TSV contains surplus columns: {source}")
    return [{str(k): str(v) for k, v in row.items()} for row in rows]


def read_failed_attestation_tsv(path: Path) -> list[dict[str, str]]:
    """Read the create-only retry ledger, permitting its canonical empty state."""

    source, text = stable_text(path, max_bytes=16 * 1024 * 1024)
    expected_header = "\t".join(FAILED_ATTESTATION_TSV_FIELDS)
    lines = text.splitlines()
    if (
        not text.endswith("\n")
        or "\r" in text
        or "\0" in text
        or not lines
        or lines[0] != expected_header
        or any(not line for line in lines[1:])
    ):
        raise Gate5Error(
            f"failed live-attestation TSV is not canonical LF-delimited data: {source}"
        )
    reader = csv.DictReader(io.StringIO(text, newline=""), delimiter="\t")
    if tuple(reader.fieldnames or ()) != FAILED_ATTESTATION_TSV_FIELDS:
        raise Gate5Error(f"failed live-attestation TSV header changed: {source}")
    rows = list(reader)
    if any(
        None in row
        or set(row) != FAILED_ATTESTATION_ROW_FIELDS
        or any(value is None for value in row.values())
        for row in rows
    ):
        raise Gate5Error(f"failed live-attestation TSV row shape changed: {source}")
    return [{str(key): str(value) for key, value in row.items()} for row in rows]


def read_json_artifact(
    path_value: str | Path, *, max_bytes: int = MAX_JSON_BYTES
) -> tuple[dict[str, Any], dict[str, Any]]:
    path, digest, size, raw = stable_file_observation(
        path_value, max_bytes=max_bytes, retain_payload=True
    )
    assert raw is not None
    try:
        value = strict_json_loads(raw.decode("utf-8"))
    except (UnicodeError, TypeError, ValueError) as exc:
        raise Gate5Error(f"strict JSON validation failed for {path}: {exc}") from exc
    if not isinstance(value, dict):
        raise Gate5Error(f"expected a JSON object: {path}")
    return value, {"path": str(path), "sha256": digest, "bytes": size}


def failed_attestation_tree_descriptor(root: Path) -> dict[str, Any]:
    """Bind every retained file in one failed transport-probe tree."""

    label = "failed live-attestation attempt"
    try:
        root_before = root.lstat()
    except OSError as exc:
        raise Gate5Error(f"cannot inspect {label} root {root}: {exc}") from exc
    files, inventory_before = rr_tree_inventory(root, label=label)
    if not files or len(files) > MAX_CONTROL_FILES:
        raise Gate5Error(f"{label} root has an invalid file inventory: {root}")
    artifacts: list[dict[str, Any]] = []
    tree_hash = hashlib.sha256()
    total_bytes = 0
    for relative, member in files:
        _resolved, digest, size, _payload = stable_file_observation(
            member, max_bytes=MAX_LOG_BYTES, retain_payload=False
        )
        try:
            current = member.lstat()
        except OSError as exc:
            raise Gate5Error(f"{label} member changed after reading: {member}") from exc
        current_identity = (
            stat.S_IFMT(current.st_mode), current.st_dev, current.st_ino,
            current.st_size, current.st_mtime_ns,
        )
        if current_identity != inventory_before[relative]:
            raise Gate5Error(f"{label} member changed during tree scan: {member}")
        artifacts.append({"file": relative, "sha256": digest, "bytes": size})
        total_bytes += size
        tree_hash.update(relative.encode("utf-8"))
        tree_hash.update(b"\0")
        tree_hash.update(str(size).encode("ascii"))
        tree_hash.update(b"\0")
        tree_hash.update(digest.encode("ascii"))
        tree_hash.update(b"\n")
    files_after, inventory_after = rr_tree_inventory(root, label=label)
    try:
        root_after = root.lstat()
    except OSError as exc:
        raise Gate5Error(f"{label} root changed after scanning: {root}") from exc
    if (
        [relative for relative, _path in files_after]
        != [relative for relative, _path in files]
        or inventory_after != inventory_before
        or (
            root_before.st_dev, root_before.st_ino, root_before.st_size,
            root_before.st_mtime_ns,
        )
        != (
            root_after.st_dev, root_after.st_ino, root_after.st_size,
            root_after.st_mtime_ns,
        )
    ):
        raise Gate5Error(f"{label} root changed during tree scan: {root}")
    return {
        "path": str(root),
        "sha256": tree_hash.hexdigest(),
        "bytes": total_bytes,
        "files": len(artifacts),
        "artifacts": artifacts,
    }


def failed_attestation_int(raw: str, *, label: str, allow_zero: bool) -> int:
    if re.fullmatch(r"0|[1-9][0-9]*", raw) is None:
        raise Gate5Error(f"failed live-attestation {label} is not canonical decimal")
    value = int(raw, 10)
    if (not allow_zero and value == 0) or value > 255:
        raise Gate5Error(f"failed live-attestation {label} is outside its bound")
    return value


def validate_failed_attestation_budget(
    raw: object, *, grid_id: str
) -> dict[str, Any]:
    fields = {
        "budget_id", "max_target_calls", "max_judge_calls", "max_http_attempts",
        "deadline_epoch", "target_calls", "judge_calls", "http_attempts",
        "accounting_semantics",
    }
    if not isinstance(raw, dict) or set(raw) != fields:
        raise Gate5Error("failed live-attestation durable budget fields changed")
    deadline = raw.get("deadline_epoch")
    if (
        raw.get("budget_id") != grid_id
        or raw.get("accounting_semantics")
        != "durable_pre_call_logical_reservation_v1"
        or raw.get("max_target_calls") != 1
        or type(raw.get("max_target_calls")) is not int
        or raw.get("max_judge_calls") is not None
        or raw.get("max_http_attempts") is not None
        or isinstance(deadline, bool)
        or not isinstance(deadline, (int, float))
        or not math.isfinite(float(deadline))
        or type(raw.get("target_calls")) is not int
        or not 0 <= raw["target_calls"] <= 1
        or type(raw.get("judge_calls")) is not int
        or raw["judge_calls"] != 0
        or type(raw.get("http_attempts")) is not int
        or raw["http_attempts"] != 0
    ):
        raise Gate5Error("failed live-attestation durable budget values changed")
    return dict(raw)


def validate_failed_attestation_call_audit(
    raw: object, *, label: str
) -> dict[str, Any]:
    if (
        not isinstance(raw, dict)
        or set(raw) - FAILED_ATTESTATION_CALL_AUDIT_FIELDS
    ):
        raise Gate5Error(f"{label} has invalid failed-call audit provenance")
    for key, value in raw.items():
        if key in {"transport_attempt_count", "logical_call_count"}:
            if isinstance(value, bool) or not isinstance(value, int) or value < 0:
                raise Gate5Error(f"{label} has invalid failed-call audit {key}")
        elif not (
            (isinstance(value, int) and not isinstance(value, bool))
            or (isinstance(value, str) and len(value) <= 512)
        ):
            raise Gate5Error(f"{label} has invalid failed-call audit {key}")
    return dict(raw)


def validate_failed_attestation_circuit(
    raw: object,
    *,
    key: str,
    budget: Mapping[str, Any],
    target_key: str,
) -> dict[str, Any]:
    expected_stage = {
        "budget": ("unknown", "BudgetExhausted"),
        "judge": ("judge_call", "ExternalCallFailure"),
        target_key: ("target_call", "ExternalCallFailure"),
    }.get(key)
    if expected_stage is None:
        raise Gate5Error(f"failed live-attestation retained an unexpected circuit: {key}")
    if not isinstance(raw, dict) or set(raw) != FAILED_ATTESTATION_CIRCUIT_FIELDS:
        raise Gate5Error(f"failed live-attestation circuit fields changed: {key}")
    for field in ("opened_at", "exception_type", "phase", "message"):
        value = raw.get(field)
        if not isinstance(value, str) or not value or len(value) > 2000:
            raise Gate5Error(
                f"failed live-attestation circuit {field} is invalid: {key}"
            )
    if (raw["phase"], raw["exception_type"]) != expected_stage:
        raise Gate5Error(f"failed live-attestation circuit stage changed: {key}")
    if raw.get("budget_snapshot") != budget:
        raise Gate5Error(f"failed live-attestation circuit budget changed: {key}")
    return {
        **raw,
        "call_audit": validate_failed_attestation_call_audit(
            raw.get("call_audit"), label=f"failed live-attestation circuit {key}"
        ),
    }


def failed_checkpoint_descriptor(
    path: Path,
    *,
    run_id: str,
    budget: Mapping[str, Any],
    response_only: bool,
) -> dict[str, Any]:
    before = descriptor(path, max_bytes=MAX_LOG_BYTES)
    try:
        if response_only:
            records = Runner.load_response_checkpoint(path, expected_run_id=run_id)
            snapshots = Runner.response_checkpoint_budget_snapshots(path)
        else:
            records = Runner.load_checkpoint(path, expected_run_id=run_id)
            snapshots = Runner.checkpoint_budget_snapshots(path)
    except (OSError, TypeError, ValueError) as exc:
        raise Gate5Error(f"failed live-attestation checkpoint is invalid: {path}: {exc}") from exc
    after = descriptor(path, max_bytes=MAX_LOG_BYTES)
    if before != after:
        raise Gate5Error(f"failed live-attestation checkpoint changed while validating: {path}")
    if not snapshots or any(snapshot != budget for snapshot in snapshots):
        raise Gate5Error(f"failed live-attestation checkpoint budget differs: {path}")
    return {"artifact": before, "records": len(records)}


def validate_failed_attestation_candidate(
    raw: Mapping[str, str], *, work: Path
) -> dict[str, Any]:
    """Bind one rejected transport-probe candidate without admitting it."""

    if set(raw) != FAILED_ATTESTATION_ROW_FIELDS:
        raise Gate5Error("failed live-attestation TSV fields changed")
    target = raw["target"]
    modality = raw["modality"]
    arm = raw["arm"]
    seed = failed_attestation_int(raw["sample_seed"], label="sample seed", allow_zero=True)
    exit_code = failed_attestation_int(raw["exit_code"], label="exit code", allow_zero=False)
    probe = (target, modality, arm)
    if probe not in EXPECTED_FAILED_ATTESTATION_PROBES:
        raise Gate5Error(f"unexpected failed live-attestation probe identity: {probe!r}")
    if seed not in EXPECTED_FAILED_ATTESTATION_PROBES[probe]:
        raise Gate5Error(f"unexpected failed live-attestation sample seed: {probe!r}/{seed}")

    supplied_root = Path(raw["run_root"]).expanduser()
    if not supplied_root.is_absolute():
        raise Gate5Error("failed live-attestation run root is not absolute")
    run_root = checked_dir(supplied_root, label="failed live-attestation run root")
    if Path(os.path.abspath(supplied_root)) != run_root:
        raise Gate5Error("failed live-attestation run root is not already resolved")
    attestation_root = checked_dir(
        work / "runs" / "thesis" / "attestation",
        label="thesis live-attestation root",
    )
    parent_pattern = re.compile(
        rf"{re.escape(target)}-{re.escape(modality)}-seed{seed}-"
        r"20[0-9]{2}[01][0-9][0-3][0-9]T[0-2][0-9][0-5][0-9][0-5][0-9]Z"
    )
    if (
        not run_root.is_relative_to(attestation_root)
        or run_root.name != "run"
        or parent_pattern.fullmatch(run_root.parent.name) is None
        or run_root.parent.parent != attestation_root
    ):
        raise Gate5Error("failed live-attestation run root escaped its exact layout")

    tree_before = failed_attestation_tree_descriptor(run_root)
    grid_paths = sorted(run_root.glob("grid-*.grid.json"))
    budget_paths = sorted(run_root.glob("grid-*.budget.json"))
    circuit_paths = sorted(run_root.glob("grid-*.circuits.json"))
    if (
        len(grid_paths) != 1
        or len(budget_paths) != 1
        or len(circuit_paths) > 1
    ):
        raise Gate5Error(
            "failed live-attestation root must retain one grid/budget and at most one circuit artifact"
        )
    grid, grid_artifact = read_json_artifact(grid_paths[0])
    grid_id = grid.get("grid_id")
    if (
        not isinstance(grid_id, str)
        or re.fullmatch(r"grid-[0-9a-f]{24}", grid_id) is None
        or grid_paths[0].name != f"{grid_id}.grid.json"
        or budget_paths[0].name != f"{grid_id}.budget.json"
        or (
            circuit_paths
            and circuit_paths[0].name != f"{grid_id}.circuits.json"
        )
    ):
        raise Gate5Error("failed live-attestation grid artifact identity changed")
    budget_raw, budget_artifact = read_json_artifact(
        budget_paths[0], max_bytes=64 * 1024
    )
    budget = validate_failed_attestation_budget(budget_raw, grid_id=grid_id)
    if grid.get("call_budget_snapshot") != budget:
        raise Gate5Error("failed live-attestation grid rolled back its durable budget")

    request = grid.get("request")
    expected_global_budget = {
        "accounting_semantics": "durable_pre_call_logical_reservation_v1",
        "call_start_deadline_seconds_from_first_invocation": 3600,
        "max_http_attempts": None,
        "max_judge_calls": None,
        "max_target_calls": 1,
    }
    if not isinstance(request, dict):
        raise Gate5Error("failed live-attestation grid lacks its request")
    models = request.get("models")
    project_revision = request.get("project_revision")
    if (
        request.get("execution_purpose") != "attestation_probe"
        or request.get("attestation_probe") is not True
        or request.get("dry_run") is not False
        or request.get("attackers") != ["replay"]
        or request.get("corpora") != [arm]
        or request.get("judges") != ["rules"]
        or request.get("limit") != 1
        or type(request.get("limit")) is not int
        or request.get("sample_seed") != seed
        or type(request.get("sample_seed")) is not int
        or request.get("seeds") != [0]
        or request.get("max_queries") != 1
        or request.get("max_turns") != 1
        or request.get("global_call_budget") != expected_global_budget
        or not isinstance(models, list)
        or len(models) != 1
        or not isinstance(models[0], str)
        or not models[0].startswith(FAILED_ATTESTATION_MODEL_PREFIXES[target])
        or not isinstance(project_revision, dict)
        or project_revision.get("expected_commit") != EXPECTED_COMMIT
        or project_revision.get("observed_commit") != EXPECTED_COMMIT
    ):
        raise Gate5Error("failed live-attestation request binding changed")
    projection = request.get("call_projection")
    if (
        not isinstance(projection, dict)
        or projection.get("semantics") != "conservative_complete_grid_upper_bound_v1"
        or projection.get("trajectories") != 1
        or projection.get("target_calls") != 1
        or projection.get("judge_calls") != 0
        or projection.get("local_guardrail_evaluations") != 0
        or projection.get("http_attempts") != 0
        or any(type(projection.get(field)) is not int for field in (
            "trajectories", "target_calls", "judge_calls",
            "local_guardrail_evaluations", "http_attempts",
        ))
    ):
        raise Gate5Error("failed live-attestation call projection changed")

    is_derivation_failure = exit_code == 90
    cells = grid.get("cells")
    expected_status = "complete" if is_derivation_failure else "partial"
    if (
        grid.get("status") != expected_status
        or type(grid.get("requested_cells")) is not int
        or grid.get("requested_cells") != 1
        or type(grid.get("accounted_cells")) is not int
        or grid.get("accounted_cells") != 1
        or not isinstance(cells, list)
        or len(cells) != 1
        or not isinstance(cells[0], dict)
        or cells[0].get("model_spec") != models[0]
        or cells[0].get("attacker") != "replay"
        or cells[0].get("corpus") != arm
    ):
        raise Gate5Error("failed live-attestation grid lifecycle changed")
    if is_derivation_failure:
        if (
            grid.get("n_errors") != 0
            or grid.get("n_new_complete") != 1
            or grid.get("n_existing_complete") != 0
            or cells[0].get("status") != "complete"
        ):
            raise Gate5Error("live-attestation derivation failure lacks a complete probe grid")
    elif (
        type(grid.get("n_errors")) is not int
        or grid["n_errors"] <= 0
        or grid.get("n_new_complete") != 0
        or grid.get("n_existing_complete") != 0
        or cells[0].get("status") != "error"
    ):
        raise Gate5Error("failed live-attestation runner failure lifecycle changed")

    error_rows: list[dict[str, Any]] = []
    completed_attempt_counts: set[int] = set()
    for error_path in sorted(run_root.glob("*.error.json")):
        error, error_artifact = read_json_artifact(error_path)
        completed = error.get("completed_attempts")
        exception_type = error.get("exception_type")
        execution_started = error.get("execution_started")
        call_audit = validate_failed_attestation_call_audit(
            error.get("call_audit"), label=f"failed live-attestation error {error_path}"
        )
        if (
            error.get("status") != "error"
            or error.get("grid_id") != grid_id
            or error.get("call_budget_snapshot") != budget
            or error.get("phase") != "cell_execution_or_validation"
            or error.get("corpus") != arm
            or error.get("model_spec") != models[0]
            or error.get("attacker") != "replay"
            or not isinstance(exception_type, str)
            or not exception_type
            or len(exception_type) > 2000
            or type(execution_started) is not bool
            or type(completed) is not int
            or completed < 0
        ):
            raise Gate5Error(f"failed live-attestation error artifact changed: {error_path}")
        completed_attempt_counts.add(completed)
        error_rows.append({
            "artifact": error_artifact,
            "run_id": error.get("run_id"),
            "exception_type": exception_type,
            "execution_started": execution_started,
            "call_audit": call_audit,
            "completed_attempts": completed,
        })
    if is_derivation_failure:
        if error_rows:
            raise Gate5Error("live-attestation derivation failure retained runner errors")
        completed_attempts = 1
    else:
        if len(error_rows) != 1 or len(completed_attempt_counts) != 1:
            raise Gate5Error("failed live-attestation runner failure lacks one exact error")
        completed_attempts = next(iter(completed_attempt_counts))
        cell_error = cells[0].get("error_artifact")
        error_artifact = error_rows[0]["artifact"]
        if cell_error != {
            "file": Path(error_artifact["path"]).name,
            "sha256": error_artifact["sha256"],
            "bytes": error_artifact["bytes"],
        }:
            raise Gate5Error("failed live-attestation cell/error descriptor changed")
        if (
            cells[0].get("run_id") != error_rows[0]["run_id"]
            or cells[0].get("execution_started")
            is not error_rows[0]["execution_started"]
        ):
            raise Gate5Error("failed live-attestation cell/error lifecycle changed")

    circuit_artifact: dict[str, Any] | None = None
    circuit_values: dict[str, dict[str, Any]] = {}
    if circuit_paths:
        circuits, circuit_artifact = read_json_artifact(
            circuit_paths[0], max_bytes=4 * 1024 * 1024
        )
        raw_circuits = circuits.get("circuits")
        if (
            set(circuits) != {"format_version", "grid_id", "circuits"}
            or circuits.get("format_version") != 1
            or type(circuits.get("format_version")) is not int
            or circuits.get("grid_id") != grid_id
            or not isinstance(raw_circuits, dict)
            or len(raw_circuits) != 1
        ):
            raise Gate5Error("failed live-attestation circuit accounting changed")
        target_circuit_key = f"target:{models[0]}"
        circuit_values = {
            key: validate_failed_attestation_circuit(
                value, key=key, budget=budget, target_key=target_circuit_key
            )
            for key, value in raw_circuits.items()
        }
        if not is_derivation_failure:
            retained_circuit = next(iter(circuit_values.values()))
            if (
                error_rows[0]["exception_type"]
                != retained_circuit["exception_type"]
                or error_rows[0]["call_audit"] != retained_circuit["call_audit"]
            ):
                raise Gate5Error(
                    "failed live-attestation error/circuit provenance changed"
                )

    run_ids = {
        value for value in (
            cells[0].get("run_id"),
            *(item["run_id"] for item in error_rows),
        )
        if value is not None
    }
    response_paths = sorted(run_root.glob("*.responses.checkpoint.jsonl"))
    completed_paths = sorted(
        path for path in run_root.glob("*.checkpoint.jsonl")
        if not path.name.endswith(".responses.checkpoint.jsonl")
    )
    if response_paths or completed_paths:
        if len(run_ids) != 1 or not isinstance(next(iter(run_ids)), str):
            raise Gate5Error("failed live-attestation checkpoint run identity changed")
        run_id = next(iter(run_ids))
    else:
        run_id = None
    response_checkpoints = [
        failed_checkpoint_descriptor(
            path, run_id=run_id, budget=budget, response_only=True
        )
        for path in response_paths
        if run_id is not None
    ]
    completed_checkpoints = [
        failed_checkpoint_descriptor(
            path, run_id=run_id, budget=budget, response_only=False
        )
        for path in completed_paths
        if run_id is not None
    ]
    response_records = sum(item["records"] for item in response_checkpoints)
    completed_records = sum(item["records"] for item in completed_checkpoints)
    if is_derivation_failure:
        if (
            response_checkpoints
            or completed_checkpoints
            or circuit_values
            or budget["target_calls"] != 1
        ):
            raise Gate5Error("live-attestation derivation failure retained incomplete checkpoints")
        runner_failure_stage = "not_applicable"
    else:
        if (
            completed_records != completed_attempts
            or completed_attempts != 0
            or completed_checkpoints
        ):
            raise Gate5Error(
                "failed live-attestation completed-checkpoint accounting changed"
            )
        target_circuit_key = f"target:{models[0]}"
        circuit_keys = set(circuit_values)
        error_type = error_rows[0]["exception_type"]
        if error_type == "ExternalCallFailure":
            if circuit_keys not in ({"judge"}, {target_circuit_key}):
                raise Gate5Error(
                    "failed live-attestation external-call error lacks its exact circuit"
                )
        elif error_type == "BudgetExhausted":
            if circuit_keys != {"budget"}:
                raise Gate5Error(
                    "failed live-attestation budget error lacks its exact circuit"
                )
        elif circuit_keys:
            raise Gate5Error(
                "failed live-attestation circuit has no matching runner exception"
            )
        if budget["target_calls"] == 1 and response_records == 1:
            if (
                len(response_checkpoints) != 1
                or circuit_keys not in (set(), {"judge"})
            ):
                raise Gate5Error(
                    "failed live-attestation post-target provenance changed"
                )
            runner_failure_stage = (
                "judge_call_after_checkpointed_target_response"
                if circuit_keys == {"judge"}
                else "local_scoring_after_checkpointed_target_response"
            )
        elif budget["target_calls"] == 1 and response_records == 0:
            if response_checkpoints:
                raise Gate5Error(
                    "failed live-attestation response-checkpoint inventory changed"
                )
            if circuit_keys == {target_circuit_key}:
                runner_failure_stage = "target_call_after_durable_reservation"
            elif not circuit_keys and error_type not in {
                "ExternalCallFailure", "BudgetExhausted"
            }:
                runner_failure_stage = (
                    "target_response_validation_after_durable_reservation"
                )
            else:
                raise Gate5Error(
                    "failed live-attestation reserved target call lacks exact provenance"
                )
        elif budget["target_calls"] == 0 and response_records == 0:
            if response_checkpoints or circuit_keys not in (set(), {"budget"}):
                raise Gate5Error(
                    "failed live-attestation pre-target provenance changed"
                )
            runner_failure_stage = (
                "budget_before_target_reservation"
                if circuit_keys == {"budget"}
                else "runner_before_target_reservation"
            )
        else:
            raise Gate5Error(
                "failed live-attestation checkpoint/call accounting changed"
            )

    tree_after = failed_attestation_tree_descriptor(run_root)
    if tree_after != tree_before:
        raise Gate5Error("failed live-attestation tree changed during semantic validation")
    return {
        "schema": FAILED_ATTESTATION_SCHEMA,
        "status": "failed_not_accepted_as_gate5_evidence",
        "evidence_accepted": False,
        "failure_stage": (
            "live_attestation_receipt_derivation" if is_derivation_failure
            else "runner_transport_probe"
        ),
        "runner_failure_stage": runner_failure_stage,
        "controller_status_row": {
            "target": target,
            "modality": modality,
            "arm": arm,
            "sample_seed": seed,
            "run_root": str(run_root),
            "exit_code": exit_code,
        },
        "retained_run_tree": tree_after,
        "artifacts": {
            "grid": grid_artifact,
            "budget_ledger": budget_artifact,
            "response_checkpoints": response_checkpoints,
            "completed_checkpoints": completed_checkpoints,
            "errors": error_rows,
            "circuits": circuit_artifact,
        },
        "call_accounting": {
            "accounting_semantics": budget["accounting_semantics"],
            "budget_id": budget["budget_id"],
            "target_calls": budget["target_calls"],
            "model_judge_calls": budget["judge_calls"],
            "http_attempts": budget["http_attempts"],
            "checkpointed_target_responses": response_records,
            "completed_attempts": completed_attempts,
        },
        "acceptance_boundary": (
            "The failed candidate is content-bound for call accounting only. It is not "
            "a live-attestation receipt, Gate-5 canary, cap, or launch authorization."
        ),
    }


def status_path(root: Path, kind: str) -> Path:
    names = (
        ("projections.tsv", "status.tsv")
        if kind == "projection"
        else ("canaries.tsv", "status.tsv")
    )
    for name in names:
        path = root / name
        if path.is_file() and not path.is_symlink():
            rows = read_tsv(path)
            needed = (
                {"projection_id", "preliminary_projection_id"}
                if kind == "projection"
                else {"canary_id"}
            )
            if rows and any(field in rows[0] for field in needed):
                return path
    raise Gate5Error(f"{root} has no {kind} status TSV with the required identity column")


def validate_control_root(
    root_value: str | Path, *, kind: str, work: Path
) -> dict[str, Any]:
    root = checked_dir(root_value, label=f"{kind} control root")
    exit_path = checked_file(root / ".exit", max_bytes=128)
    _exit_path, exit_text = stable_text(exit_path, max_bytes=128)
    if exit_text.strip() != "0":
        raise Gate5Error(f"{kind} control root did not finish successfully: {root}")
    status = status_path(root, kind)
    files: list[dict[str, Any]] = [
        descriptor(exit_path, max_bytes=128),
        descriptor(status, max_bytes=16 * 1024 * 1024),
    ]
    for candidate in sorted(root.glob("*.log")):
        files.append(descriptor(candidate, max_bytes=MAX_LOG_BYTES))
        if len(files) > MAX_CONTROL_FILES:
            raise Gate5Error(f"too many controller files in {root}")
    for candidate in sorted(root.glob("*.tsv")):
        resolved = candidate.resolve()
        if any(item["path"] == str(resolved) for item in files):
            continue
        files.append(descriptor(candidate, max_bytes=16 * 1024 * 1024))
    attempt_failures: list[dict[str, Any]] = []
    attempt_failure_path = root / "attestation-failures.tsv"
    if attempt_failure_path.is_file() and not attempt_failure_path.is_symlink():
        attempt_failures = [
            validate_failed_attestation_candidate(row, work=work)
            for row in read_failed_attestation_tsv(attempt_failure_path)
        ]
    return {
        "root": str(root),
        "kind": kind,
        "status_path": str(status.resolve()),
        "files": files,
        "upstream_attestation_candidate_failures": attempt_failures,
    }


def validate_failed_attempt_root(root_value: str | Path) -> dict[str, Any]:
    """Bind a failed controller tree without admitting it as Gate-5 evidence."""
    root = checked_dir(root_value, label="failed-attempt control root")
    exit_path = checked_file(root / ".exit", max_bytes=128)
    _exit_path, exit_text_raw = stable_text(exit_path, max_bytes=128)
    exit_text = exit_text_raw.strip()
    try:
        exit_code = int(exit_text, 10)
    except ValueError as exc:
        raise Gate5Error(f"failed-attempt root has an invalid .exit marker: {root}") from exc
    known_details = KNOWN_FAILED_CORE_CANARIES.get(root.name)
    if exit_code == 0 and not (
        isinstance(known_details, dict)
        and known_details.get("allow_incomplete_zero_exit_marker") is True
    ):
        raise Gate5Error(
            f"failed-attempt root claims success and cannot enter the failure ledger: {root}"
        )

    files: list[dict[str, Any]] = []
    for candidate in sorted(root.iterdir(), key=lambda item: item.name):
        if candidate.is_dir():
            continue
        if candidate.is_symlink() or not candidate.is_file():
            raise Gate5Error(
                f"failed-attempt control root contains a non-regular direct artifact: {candidate}"
            )
        files.append(descriptor(candidate, max_bytes=MAX_LOG_BYTES))
        if len(files) > MAX_CONTROL_FILES:
            raise Gate5Error(f"too many direct artifacts in failed-attempt root {root}")
    if not any(Path(item["path"]).suffix == ".log" for item in files):
        raise Gate5Error(f"failed-attempt root retains no direct controller log: {root}")

    if exit_code == 0:
        controller_log = checked_file(root / "phase5-canary.log", max_bytes=MAX_LOG_BYTES)
        _controller_log, controller_log_text = stable_text(
            controller_log, max_bytes=MAX_LOG_BYTES
        )
        if "PHASE5_CORE_CANARIES_COMPLETE=" in controller_log_text:
            raise Gate5Error(
                f"zero-exit failed-attempt root contains a completion marker: {root}"
            )
        status_rows = read_tsv(
            checked_file(root / "status.tsv", max_bytes=16 * 1024 * 1024)
        )
        if len(status_rows) >= len(EXPECTED_CORE_LANES):
            raise Gate5Error(
                f"zero-exit failed-attempt root has a complete core inventory: {root}"
            )
        failure_rows = read_tsv(
            checked_file(
                root / "attestation-failures.tsv", max_bytes=16 * 1024 * 1024
            )
        )
        if len(failure_rows) < 3 or any(
            row.get("exit_code") != "134" for row in failure_rows[:3]
        ):
            raise Gate5Error(
                f"zero-exit failed-attempt root lacks the observed failure sequence: {root}"
            )

    if known_details is not None:
        details = {
            **known_details,
            "failure_description_provenance": FAILED_ATTEMPT_PROVENANCE,
        }
    else:
        details = {
            "attempt_kind": "operator_supplied_failed_attempt",
            "status": "failed_not_accepted_as_gate5_evidence",
            "evidence_accepted": False,
            "primary_failure": "CANNOT-VERIFY from controller exit marker alone",
            "secondary_failure": "CANNOT-VERIFY from controller exit marker alone",
            "failure_description_provenance": {
                "kind": "artifact_observation",
                "authentication": "not_applicable",
            },
        }
    return {
        **details,
        "root": str(root),
        "controller_exit_code": exit_code,
        "retained_direct_artifacts": files,
        "acceptance_boundary": (
            "This tree is retained only as a failed-attempt audit record. It supplies no "
            "projection, canary, cap, or launch authorization evidence."
        ),
    }


def failed_attempt_ledger(args: argparse.Namespace, *, work: Path) -> list[dict[str, Any]]:
    rows_by_root: dict[str, dict[str, Any]] = {}
    for raw in args.failed_attempt_root:
        row = validate_failed_attempt_root(raw)
        rows_by_root[row["root"]] = row
    for root_name, known in KNOWN_FAILED_CORE_CANARIES.items():
        known_path = work / "runs" / "engineering" / root_name
        if known_path.exists() or known_path.is_symlink():
            row = validate_failed_attempt_root(known_path)
            rows_by_root[row["root"]] = row
            continue
        expected_root = str(known_path)
        if expected_root not in rows_by_root:
            rows_by_root[expected_root] = {
                **known,
                "failure_description_provenance": FAILED_ATTEMPT_PROVENANCE,
                "root": expected_root,
                "controller_exit_code": None,
                "retained_direct_artifacts": [],
                "retained_artifact_status": "CANNOT-VERIFY_not_present_at_finalization",
                "acceptance_boundary": (
                    "The operator-reported failed attempt is recorded for completeness but "
                    "its controller tree was not present. It supplies no Gate-5 evidence."
                ),
            }
    rows = [
        {**row, "failure_statement_covered_by_manifest_approval": True}
        for row in rows_by_root.values()
    ]
    return sorted(rows, key=lambda row: row["root"])


def lane_key(row: Mapping[str, str]) -> str:
    lane = (row.get("lane") or row.get("lane_id") or "").strip()
    if LANE_RE.fullmatch(lane) is None:
        raise Gate5Error(f"invalid lane identifier in status row: {lane!r}")
    return lane


def indexed_status(rows: Sequence[Mapping[str, str]], identity_field: str) -> dict[str, dict[str, str]]:
    output: dict[str, dict[str, str]] = {}
    for raw in rows:
        row = dict(raw)
        lane = lane_key(row)
        identity = row.get(identity_field, "").strip()
        if identity_field == "projection_id" and not identity:
            identity = row.get("preliminary_projection_id", "").strip()
            row["projection_id"] = identity
        disposition = row.get("disposition", "").strip()
        conditional_artifact = row.get("conditional_na_artifact", "").strip()
        rr_terminal_artifact = row.get(
            "target_runtime_terminal_artifact", ""
        ).strip()
        if identity_field == "canary_id" and lane in RR_TERMINAL_LANES:
            if (
                identity
                or disposition != "unavailable"
                or conditional_artifact
                or not rr_terminal_artifact
            ):
                raise Gate5Error(
                    f"{lane}: RR terminal status requires a blank canary id and "
                    "one target-runtime artifact"
                )
            row["canary_id"] = ""
            if lane in output:
                raise Gate5Error(f"duplicate lane in status TSV: {lane}")
            output[lane] = row
            continue
        if (
            identity_field == "canary_id"
            and lane == "defense-local"
            and disposition == DEFENSE_NA_DISPOSITION
        ):
            if identity or not conditional_artifact:
                raise Gate5Error(
                    "defense-local: conditional N/A status requires a blank canary id "
                    "and one artifact path"
                )
            row["canary_id"] = ""
            if lane in output:
                raise Gate5Error(f"duplicate lane in status TSV: {lane}")
            output[lane] = row
            continue
        if (
            disposition not in {"", "runnable"}
            or conditional_artifact
            or rr_terminal_artifact
        ):
            raise Gate5Error(f"{lane}: unexpected status disposition or conditional artifact")
        pattern = PROJECTION_ID_RE if identity_field == "projection_id" else CANARY_ID_RE
        if pattern.fullmatch(identity) is None:
            raise Gate5Error(f"{lane}: invalid {identity_field} {identity!r}")
        if lane in output:
            raise Gate5Error(f"duplicate lane in status TSV: {lane}")
        output[lane] = row
    return output


def json_objects_from_log(path: Path) -> Iterable[dict[str, Any]]:
    _source, text = stable_text(path, max_bytes=MAX_LOG_BYTES)
    for raw in text.splitlines():
        line = raw.strip()
        if not line or len(line) > MAX_JSON_BYTES:
            continue
        try:
            value = strict_json_loads(line)
        except (TypeError, ValueError):
            continue
        if isinstance(value, dict):
            yield value


def nested_strings(value: object) -> Iterable[str]:
    if isinstance(value, str):
        yield value
    elif isinstance(value, list):
        for item in value:
            yield from nested_strings(item)
    elif isinstance(value, dict):
        for item in value.values():
            yield from nested_strings(item)


def tag_from_root(root: Path) -> str | None:
    match = re.search(r"(20[0-9]{6}T[0-9]{6}Z)$", root.name)
    return match.group(1) if match else None


def candidates_from_status_row(row: Mapping[str, str], *, kind: str) -> Iterable[Path]:
    fields = (
        (
            "projection_path", "projection_artifact", "artifact", "preliminary_root",
            "run_root", "output_root",
        )
        if kind == "projection"
        else (
            "canary_path", "canary_artifact", "artifact", "diagnostic_root",
            "run_root", "results_root",
        )
    )
    for field in fields:
        value = row.get(field, "").strip()
        if not value:
            continue
        path = Path(value).expanduser()
        if path.is_dir():
            pattern = (
                "lane-projection-*.lane-projection.json"
                if kind == "projection"
                else "lane-canary-*.lane-canary.json"
            )
            yield from sorted(path.glob(pattern))
        else:
            yield path


def find_artifact_from_control(
    *,
    control: Path,
    row: Mapping[str, str],
    lane: str,
    identity: str,
    kind: str,
    work: Path,
) -> Path:
    suffix = (
        ".lane-projection.json" if kind == "projection" else ".lane-canary.json"
    )
    expected_name = identity + suffix
    candidates: list[Path] = list(candidates_from_status_row(row, kind=kind))
    for log in sorted(control.glob(f"{lane}*.log")):
        for value in json_objects_from_log(log):
            for text in nested_strings(value):
                path = Path(text).expanduser()
                if path.name == expected_name:
                    candidates.append(path)

    tag = tag_from_root(control)
    if tag and kind == "projection":
        conventional = (
            work / "runs" / "thesis" / "preflight" / f"{lane}-prelim-{tag}" / "run"
        )
        if conventional.is_dir():
            candidates.append(conventional / expected_name)
        ollama = (
            work / "runs" / "thesis" / "preflight" / "ollama-phase5" /
            f"{lane}-prelim-{tag}"
        )
        if ollama.is_dir():
            candidates.extend(sorted(ollama.rglob(expected_name)))
    if tag and kind == "canary":
        conventional = (
            work / "runs" / "thesis" / "diagnostics" / "canary-live" /
            f"{lane}-{tag}" / "run"
        )
        if conventional.is_dir():
            candidates.append(conventional / expected_name)
        ollama = (
            work / "runs" / "thesis" / "diagnostics" / "canary-live" /
            "ollama-phase5" / f"{lane}-{tag}"
        )
        if ollama.is_dir():
            candidates.extend(sorted(ollama.rglob(expected_name)))

    valid: dict[str, Path] = {}
    for candidate in candidates:
        try:
            path = checked_file(candidate, max_bytes=MAX_JSON_BYTES)
        except Gate5Error:
            continue
        if path.name == expected_name:
            valid[str(path)] = path
    if len(valid) != 1:
        raise Gate5Error(
            f"{lane}: expected exactly one discoverable {kind} artifact {expected_name}; "
            f"found {len(valid)}. Supply an explicit lane manifest if this controller "
            "did not retain absolute artifact paths."
        )
    return next(iter(valid.values()))


def find_single(root: Path, pattern: str, *, label: str) -> Path:
    candidates = sorted(root.glob(pattern))
    if len(candidates) != 1:
        raise Gate5Error(
            f"{label}: expected exactly one {pattern}, found {len(candidates)}"
        )
    return checked_file(candidates[0], max_bytes=MAX_JSON_BYTES)


def load_projection_bundle(projection_path: Path) -> dict[str, Any]:
    projection, projection_desc = load_stable_lane_projection_file(projection_path)
    root = projection_path.parent
    eligibility_path = find_single(root, "eligibility-*.eligibility.json", label=str(root))
    envelope_path = find_single(root, "request-envelope-*.request-envelope.json", label=str(root))
    eligibility, eligibility_desc = load_eligibility_artifact(eligibility_path)
    envelope, envelope_desc = load_stable_request_envelope_file(envelope_path)
    validate_lane_projection_binding(
        projection,
        eligibility_plan=eligibility,
        eligibility_artifact=eligibility_desc,
    )
    validate_eligibility_envelope_binding(
        eligibility,
        envelope_desc,
        label=str(projection_path),
    )
    execution = eligibility.get("execution", {})
    if (
        execution.get("whole_request_preflight_complete") is not True
        or execution.get("request_status") != "whole_request_compatible"
        or execution.get("units_blocked") != 0
    ):
        raise Gate5Error(f"{projection_path}: eligibility is not a complete whole-request preflight")
    request = envelope["request"]
    if request.get("execution_purpose") != "preflight_only" or request.get("dry_run") is not False:
        raise Gate5Error(f"{projection_path}: preliminary request is not a real preflight")
    if request.get("hosted_judge_data_transfer_acknowledged") is not False:
        raise Gate5Error(f"{projection_path}: hosted-judge transfer acknowledgement is forbidden")
    if "llm" in request.get("judges", []):
        raise Gate5Error(f"{projection_path}: hosted/local LLM-judge lanes are outside this campaign")
    calls = projection["call_projection"]
    if calls["judge_calls"] != 0 or calls["http_attempts"] != 0:
        raise Gate5Error(f"{projection_path}: local-only projection has judge/HTTP exposure")
    if calls["target_calls"] <= 0:
        raise Gate5Error(f"{projection_path}: runnable projection has no target-call exposure")
    error_paths = [
        *root.glob("request-error-*.request.error.json"),
        *root.glob("*.error.json"),
    ]
    if error_paths:
        raise Gate5Error(
            f"{projection_path}: preflight retains error artifacts: "
            + ", ".join(sorted(path.name for path in error_paths))
        )
    return {
        "root": root,
        "projection_path": projection_path,
        "projection": projection,
        "projection_descriptor": {
            "path": str(projection_path),
            **projection_desc,
        },
        "eligibility_path": eligibility_path,
        "eligibility": eligibility,
        "eligibility_descriptor": descriptor(eligibility_path, max_bytes=MAX_JSON_BYTES),
        "envelope_path": envelope_path,
        "envelope": envelope,
        "envelope_descriptor": {
            "path": str(envelope_path),
            **envelope_desc,
        },
    }


def find_canary_grid(results_root: Path) -> Path:
    paths = sorted(results_root.rglob("*.grid.json"))
    paths = [checked_file(path, max_bytes=MAX_JSON_BYTES) for path in paths]
    if len(paths) != 1:
        raise Gate5Error(f"{results_root}: expected exactly one canary grid, found {len(paths)}")
    return paths[0]


def validate_canary_live_attestations(
    *,
    results_root: Path,
    grid: Mapping[str, Any],
    eligibility: Mapping[str, Any],
    condition: Mapping[str, Any],
) -> dict[str, Any]:
    request = grid.get("request")
    if not isinstance(request, dict):
        raise Gate5Error(f"{results_root}: canary grid lacks its request object")
    if request.get("execution_purpose") != "diagnostic_canary" or request.get("dry_run") is not False:
        raise Gate5Error(f"{results_root}: accepted canary is not a live diagnostic request")
    live = request.get("live_attestation")
    if not isinstance(live, dict) or set(live) != {
        "mode", "execution_scope_id", "max_age_hours", "artifacts"
    }:
        raise Gate5Error(f"{results_root}: canary live-attestation projection is malformed")
    if live.get("mode") != "measured":
        raise Gate5Error(
            f"{results_root}: live diagnostic did not consume measured-mode attestation inputs"
        )
    scope = live.get("execution_scope_id")
    max_age = live.get("max_age_hours")
    artifacts = live.get("artifacts")
    if not isinstance(scope, str) or not scope.strip():
        raise Gate5Error(f"{results_root}: live diagnostic lacks an execution scope")
    if (
        not isinstance(max_age, (int, float))
        or isinstance(max_age, bool)
        or not 0 < float(max_age) <= 24 * 365
    ):
        raise Gate5Error(f"{results_root}: live diagnostic has an invalid attestation age bound")
    if not isinstance(artifacts, list) or not artifacts:
        raise Gate5Error(f"{results_root}: live diagnostic consumed no attestation receipt")

    manifests: list[dict[str, Any]] = []
    receipts: list[dict[str, Any]] = []
    for index, artifact in enumerate(artifacts):
        if not isinstance(artifact, dict) or set(artifact) != {
            "file", "sha256", "bytes", "attestation_id"
        }:
            raise Gate5Error(
                f"{results_root}: live-attestation artifact {index} has invalid fields"
            )
        filename = artifact.get("file")
        digest = artifact.get("sha256")
        size = artifact.get("bytes")
        if (
            not isinstance(filename, str)
            or Path(filename).name != filename
            or not isinstance(digest, str)
            or HEX64_RE.fullmatch(digest) is None
            or isinstance(size, bool)
            or not isinstance(size, int)
            or size <= 0
        ):
            raise Gate5Error(f"{results_root}: live-attestation descriptor {index} is invalid")
        path = checked_file(results_root / filename, max_bytes=4 * 1024 * 1024)
        try:
            manifest, observed = load_live_attestation_file(path, digest)
        except (OSError, TypeError, ValueError) as exc:
            raise Gate5Error(
                f"{results_root}: live-attestation receipt {filename} failed validation: {exc}"
            ) from exc
        if observed != {"file": filename, "sha256": digest, "bytes": size}:
            raise Gate5Error(f"{results_root}: retained live-attestation descriptor mismatch")
        if manifest["attestation_id"] != artifact["attestation_id"]:
            raise Gate5Error(f"{results_root}: live-attestation ID/descriptor mismatch")
        manifests.append(manifest)
        receipts.append({
            "artifact": {"path": str(path), **observed},
            "attestation_id": manifest["attestation_id"],
            "record_count": len(manifest["records"]),
            "records": [
                {
                    "record_id": record["record_id"],
                    "execution_scope_id": record["execution_scope_id"],
                    "requested_target_spec": record["requested_target_spec"],
                    "resolved_target": record["resolved_target"],
                    "route_kind": record["route_kind"],
                    "route_config_sha256": record["route_config_sha256"],
                    "exact_input_modalities": record["exact_input_modalities"],
                    "observed_at_utc": record["observed_at_utc"],
                    "probe_evidence_kind": record["probe"]["evidence_kind"],
                    "probe_grid_id": record["probe"]["grid_id"],
                    "probe_run_id": record["probe"]["run_id"],
                    "probe_realized_identities_sha256": record["probe"][
                        "realized_identities_sha256"
                    ],
                    "probe_attempt_media_hashes_sha256": record["probe"][
                        "attempt_media_hashes_sha256"
                    ],
                }
                for record in manifest["records"]
            ],
        })

    try:
        required = required_attestation_keys(
            execution_scope_id=scope,
            requested_target_specs={
                str(item["requested_target_spec"])
                for item in eligibility["items"]
                if item.get("status") == "compatible_if_isolated"
            },
            eligibility_items=eligibility["items"],
        )
        if not required:
            raise ValueError("canary eligibility produced no live-attestation prerequisites")
        requested_specs = sorted({key[1] for key in required})
        if len(requested_specs) != 1:
            raise ValueError("canary does not have exactly one requested target prerequisite")
        raw_requested = requested_specs[0]
        local_configs = request.get("local_configs")
        if not isinstance(local_configs, dict) or len(local_configs) != 1:
            raise ValueError("local canary does not retain exactly one route config")
        local_config = next(iter(local_configs.values()))
        if not isinstance(local_config, dict):
            raise ValueError("local canary route config is not an object")
        resolved_target = condition.get("resolved_target")
        if not isinstance(resolved_target, str) or not resolved_target:
            raise ValueError("canary condition lacks a resolved target")
        target_conditions = request.get("target_execution_conditions")
        if (
            not isinstance(target_conditions, dict)
            or set(target_conditions) != {raw_requested}
            or HEX64_RE.fullmatch(str(target_conditions.get(raw_requested))) is None
        ):
            raise ValueError("canary target-execution condition binding is invalid")
        harness_source = request.get("harness_source")
        driver_source = request.get("driver_source")
        if not isinstance(harness_source, dict) or not isinstance(driver_source, dict):
            raise ValueError("canary source-code descriptors are absent")
        started_text = grid.get("started_at")
        if not isinstance(started_text, str):
            raise ValueError("canary grid lacks started_at")
        reference_time = datetime.fromisoformat(started_text.replace("Z", "+00:00"))
        if reference_time.tzinfo is None:
            raise ValueError("canary grid started_at is timezone-naive")
        admitted = validate_required_live_attestations(
            manifests,
            required_keys=required,
            resolved_targets={raw_requested: resolved_target},
            route_config_sha256={
                raw_requested: route_config_sha256(
                    route_kind="local_runtime",
                    requested_target_spec=raw_requested,
                    resolved_target=resolved_target,
                    route_config=local_config,
                )
            },
            route_kind={raw_requested: "local_runtime"},
            target_condition_sha256={
                raw_requested: str(target_conditions[raw_requested])
            },
            current_harness_source_sha256=str(harness_source["sha256"]),
            current_driver_source_sha256=str(driver_source["sha256"]),
            current_project_revision=request["project_revision"],
            reference_time=reference_time,
            max_age_hours=float(max_age),
        )
    except (KeyError, TypeError, ValueError) as exc:
        raise Gate5Error(
            f"{results_root}: independent live-attestation admission failed: {exc}"
        ) from exc

    admitted_ids = sorted(record["record_id"] for record in admitted.values())
    all_combinations = {
        tuple(record["exact_input_modalities"])
        for manifest in manifests
        for record in manifest["records"]
    }
    return {
        "status": "independently_revalidated",
        "execution_scope_id": scope,
        "max_age_hours_at_canary_admission": float(max_age),
        "freshness_reference_utc": reference_time.astimezone(timezone.utc).isoformat().replace(
            "+00:00", "Z"
        ),
        "freshness_semantics": (
            "validated against the original canary call-start time; not a claim of "
            "continued freshness at finalization"
        ),
        "required_scope_target_modality_keys": [
            {
                "execution_scope_id": key[0],
                "requested_target_spec": key[1],
                "exact_input_modalities": list(key[2]),
            }
            for key in sorted(required)
        ],
        "admitted_required_record_ids": admitted_ids,
        "combined_modality_receipt_present": any(
            len({
                tuple(record["exact_input_modalities"])
                for record in manifest["records"]
            }) > 1
            for manifest in manifests
        ),
        "distinct_modality_combinations_across_all_receipts": [
            list(combination) for combination in sorted(all_combinations)
        ],
        "receipts": receipts,
    }


def validate_common_stage_contract(
    stages: object,
    *,
    completed_judgments: int,
    evaluable_judgments: int,
    label: str,
) -> None:
    if not isinstance(stages, list):
        raise Gate5Error(f"{label}: rules/guardrail stage inventory is not an array")
    if (
        isinstance(completed_judgments, bool)
        or not isinstance(completed_judgments, int)
        or completed_judgments <= 0
        or isinstance(evaluable_judgments, bool)
        or not isinstance(evaluable_judgments, int)
        or evaluable_judgments <= 0
        or evaluable_judgments > completed_judgments
    ):
        raise Gate5Error(f"{label}: policy-evaluable judgment support is invalid")
    expected_stage_projection = [(0, "rules"), (1, "guardrail")]
    observed_stage_projection: list[tuple[int, str]] = []
    for stage in stages:
        if not isinstance(stage, dict):
            raise Gate5Error(f"{label}: rules/guardrail role row is not an object")
        projected = (stage.get("stage"), stage.get("judge"))
        if not observed_stage_projection or observed_stage_projection[-1] != projected:
            observed_stage_projection.append(projected)
        if (
            stage.get("role") not in {"authoritative", "shadow"}
            or isinstance(stage.get("trail_records"), bool)
            or not isinstance(stage.get("trail_records"), int)
            or stage["trail_records"] <= 0
            or isinstance(stage.get("queried_records"), bool)
            or not isinstance(stage.get("queried_records"), int)
            or stage["queried_records"] < 0
            or isinstance(stage.get("not_queried_records"), bool)
            or not isinstance(stage.get("not_queried_records"), int)
            or stage["not_queried_records"] < 0
            or stage["trail_records"]
            != stage["queried_records"] + stage["not_queried_records"]
            or stage.get("reached") is not (stage["queried_records"] > 0)
        ):
            raise Gate5Error(f"{label}: rules/guardrail stage support does not reconcile")
    if observed_stage_projection != expected_stage_projection:
        raise Gate5Error(f"{label}: stage projection is not exactly ordered rules,guardrail")
    for stage_index, judge_name in expected_stage_projection:
        stage_rows = [
            row for row in stages
            if row["stage"] == stage_index and row["judge"] == judge_name
        ]
        if (
            sum(row["trail_records"] for row in stage_rows) != completed_judgments
            or sum(row["queried_records"] for row in stage_rows) != evaluable_judgments
            or sum(row["not_queried_records"] for row in stage_rows)
            != completed_judgments - evaluable_judgments
        ):
            raise Gate5Error(
                f"{label}: stage support does not equal policy-evaluable judgments"
            )
    if (
        sum(row["trail_records"] for row in stages if row["role"] == "authoritative")
        != completed_judgments
        or sum(row["trail_records"] for row in stages if row["role"] == "shadow")
        != completed_judgments
    ):
        raise Gate5Error(
            f"{label}: expected one authoritative and one shadow stage per judgment"
        )


def validate_classification_stage_contract(stages: object, *, label: str) -> None:
    if (
        not isinstance(stages, list)
        or len(stages) != 1
        or not isinstance(stages[0], dict)
        or stages[0].get("stage") != 0
        or stages[0].get("judge") != "rules"
        or stages[0].get("role") != "authoritative"
        or stages[0].get("reached") is not False
        or stages[0].get("queried_records") != 0
        or isinstance(stages[0].get("trail_records"), bool)
        or not isinstance(stages[0].get("trail_records"), int)
        or stages[0]["trail_records"] <= 0
        or stages[0].get("not_queried_records") != stages[0]["trail_records"]
    ):
        raise Gate5Error(f"{label}: classification rules placeholder changed")


def validate_prompt_proxy_summary(value: object, *, label: str) -> dict[str, Any]:
    expected_fields = {
        "status", "arm", "required_metric", "authority", "method", "metrics",
        "evaluable", "decisions", "abstentions", "decision_coverage",
        "aggregate_results", "guardrail_trail_queries",
        "selected_judges", "selected_guardrail_decisions",
        "selected_guardrail_aggregate_results", "guardrail_model",
        "guardrail_revision",
    }
    if not isinstance(value, dict) or set(value) != expected_fields:
        raise Gate5Error(f"{label}: approximate-proxy summary shape changed")
    integer_fields = (
        "evaluable", "decisions", "abstentions", "aggregate_results",
        "guardrail_trail_queries", "selected_guardrail_decisions",
        "selected_guardrail_aggregate_results",
    )
    decision_coverage = value.get("decision_coverage")
    selected_judges = value.get("selected_judges")
    if (
        value.get("status") != "validated"
        or value.get("arm") != PROMPT_PROXY_ARM
        or value.get("required_metric") != PROMPT_PROXY_METRIC
        or value.get("authority") != "supplementary_non_authoritative"
        or value.get("method") != "common_judge_cascade_response_proxy"
        or not isinstance(value.get("metrics"), list)
        or any(
            isinstance(value.get(field), bool)
            or not isinstance(value.get(field), int)
            or value[field] < 0
            for field in integer_fields
        )
        or value["evaluable"] <= 0
        or value["guardrail_trail_queries"] != value["evaluable"]
        or value["decisions"] + value["abstentions"] != value["evaluable"]
        or type(decision_coverage) is not float
        or not math.isfinite(float(decision_coverage))
        or decision_coverage != value["decisions"] / value["evaluable"]
        or not isinstance(selected_judges, list)
        or selected_judges != sorted(set(selected_judges))
        or set(selected_judges) - {"rules", "guardrail"}
        or value["selected_guardrail_decisions"] > value["decisions"]
        or value["selected_guardrail_aggregate_results"]
        > value["aggregate_results"]
        or ("guardrail" in selected_judges)
        is not (value["selected_guardrail_decisions"] > 0)
        or ("guardrail" in selected_judges)
        is not (value["selected_guardrail_aggregate_results"] > 0)
        or value.get("guardrail_model") != EXPECTED_SCORE_GUARD
        or value.get("guardrail_revision") != EXPECTED_SCORE_GUARD_REVISION
    ):
        raise Gate5Error(f"{label}: approximate-proxy summary is not exact")
    decided = value["decisions"] > 0
    if decided:
        if (
            value["metrics"] != ["approximate_over_refusal_rate"]
            or value["aggregate_results"] <= 0
            or not value["selected_judges"]
        ):
            raise Gate5Error(f"{label}: decided proxy summary lacks its metric support")
    elif (
        value["metrics"] != []
        or value["aggregate_results"] != 0
        or value["selected_judges"] != []
        or value["selected_guardrail_decisions"] != 0
        or value["selected_guardrail_aggregate_results"] != 0
    ):
        raise Gate5Error(f"{label}: abstained proxy summary invents a metric decision")
    return value


def _canary_artifact_rows(
    results_root: Path, marker: Mapping[str, Any], kind: str, *, label: str,
) -> list[dict[str, Any]]:
    artifacts = marker.get("artifacts")
    retained = artifacts.get(kind) if isinstance(artifacts, dict) else None
    if not isinstance(retained, dict) or set(retained) != {
        "file", "sha256", "bytes", "records"
    }:
        raise Gate5Error(f"{label}: {kind} descriptor changed")
    name = retained.get("file")
    if not isinstance(name, str) or Path(name).name != name:
        raise Gate5Error(f"{label}: {kind} artifact filename is unsafe")
    path, observed_sha, observed_bytes, payload = stable_file_observation(
        results_root / name, max_bytes=MAX_JSON_BYTES, retain_payload=True
    )
    assert payload is not None
    if (
        path.parent != results_root.resolve(strict=True)
        or observed_sha != retained.get("sha256")
        or observed_bytes != retained.get("bytes")
    ):
        raise Gate5Error(f"{label}: {kind} artifact identity changed")
    rows: list[dict[str, Any]] = []
    try:
        text = payload.decode("utf-8")
    except UnicodeError as exc:
        raise Gate5Error(f"{label}: {kind} is not UTF-8") from exc
    for line in text.splitlines():
        if not line.strip():
            continue
        value = strict_json_loads(line)
        if not isinstance(value, dict):
            raise Gate5Error(f"{label}: {kind} contains a non-object row")
        rows.append(value)
    if len(rows) != retained.get("records"):
        raise Gate5Error(f"{label}: {kind} record count changed")
    return rows


def _validate_prompt_proxy_abstention_judgment(
    judgment: Mapping[str, Any], *, label: str
) -> None:
    """Accept only the exact terminal Guard N/A proxy disposition."""

    raw = judgment.get("raw")
    source = raw.get("source_evaluation") if isinstance(raw, Mapping) else None
    score = judgment.get("score")
    if (
        judgment.get("judge") != "guardrail"
        or judgment.get("label") != "not_applicable"
        or isinstance(score, bool)
        or not isinstance(score, (int, float))
        or float(score) != 0.0
        or not isinstance(raw, Mapping)
        or raw.get("expected_behavior") not in {"safe_answer", "comply_safely"}
        or raw.get("policy_evaluable_turn") is not True
        or raw.get("common_metrics_eligible") is not False
        or raw.get("policy_evaluation_status")
        != "approximate_common_security_proxy"
        or raw.get("metric_authority") != "supplementary_non_authoritative"
        or raw.get("required_metric") != PROMPT_PROXY_METRIC
        or raw.get("cascade_stage") != 1
        or raw.get("cascade_role") != "authoritative"
        or raw.get("cascade_confident") is not True
        or raw.get("stage_queried") is not True
        or type(raw.get("confidence")) is not float
        or raw.get("confidence") != 0.0
        or raw.get("parsed") is not True
        or raw.get("unsafe") is not False
        or raw.get("guardrail_queried") is not True
        or raw.get("over_refusal_expressible") is not False
        or raw.get("automated_decision_status") != "abstained"
        or raw.get("approximate_decision_status") != "abstained"
        or raw.get("abstention_reason")
        != "guardrail_safe_cannot_adjudicate_benign_over_refusal"
        or raw.get("approximate_security_decision") is not None
        or "approximate_rubric_stage_binding" not in raw
        or raw.get("approximate_rubric_stage_binding") is not None
        or raw.get("judge_model") != EXPECTED_SCORE_GUARD
        or raw.get("model_revision") != EXPECTED_SCORE_GUARD_REVISION
        or raw.get("model_identity")
        != f"{EXPECTED_SCORE_GUARD}@{EXPECTED_SCORE_GUARD_REVISION}"
        or not isinstance(source, Mapping)
        or source.get("family") != PROMPT_PROXY_METRIC
        or source.get("implemented") is not False
        or source.get("valid") is not False
    ):
        raise Gate5Error(f"{label}: prompt-proxy abstention is not exact")


def _validate_prompt_proxy_trail_attempt(
    rows: Sequence[Mapping[str, Any]],
    *,
    disposition: str,
    selected_judge: str | None,
    label: str,
    selected_label: str | None = None,
    selected_score: float | None = None,
) -> None:
    """Require one authority and the exact ordered rules/Guard trail."""

    if (
        [(row.get("stage"), row.get("judge")) for row in rows]
        != [(0, "rules"), (1, "guardrail")]
        or any(type(row.get("stage")) is not int for row in rows)
        or any(
            row.get("stage_queried") is not True
            or row.get("policy_evaluation_status")
            != "approximate_common_security_proxy"
            or row.get("metric_authority")
            != "supplementary_non_authoritative"
            or row.get("required_metric") != PROMPT_PROXY_METRIC
            or row.get("cascade_role") not in {"authoritative", "shadow"}
            for row in rows
        )
    ):
        raise Gate5Error(f"{label}: prompt-proxy trail policy changed")
    authorities = [
        row for row in rows if row.get("cascade_role") == "authoritative"
    ]
    if (
        len(authorities) != 1
        or any(
            row.get("cascade_role") != "shadow"
            or row.get("cascade_confident") is not False
            for row in rows
            if row is not authorities[0]
        )
        or authorities[0].get("cascade_confident") is not True
    ):
        raise Gate5Error(f"{label}: prompt-proxy trail lacks one authority")

    guard = rows[1]
    if (
        guard.get("guardrail_queried") is not True
        or guard.get("judge_model") != EXPECTED_SCORE_GUARD
        or guard.get("judge_model_revision") != EXPECTED_SCORE_GUARD_REVISION
        or guard.get("judge_model_identity")
        != f"{EXPECTED_SCORE_GUARD}@{EXPECTED_SCORE_GUARD_REVISION}"
    ):
        raise Gate5Error(f"{label}: retained exact Guard query changed")
    if disposition == "decision":
        authority_score = authorities[0].get("score")
        if (
            selected_judge not in {"rules", "guardrail"}
            or authorities[0].get("judge") != selected_judge
            or not isinstance(selected_label, str)
            or authorities[0].get("label") != selected_label
            or type(selected_score) is not float
            or type(authority_score) is not float
            or authority_score != selected_score
        ):
            raise Gate5Error(
                f"{label}: decision does not name the sole trail authority"
            )
        return
    if disposition != "abstention" or selected_judge is not None:
        raise Gate5Error(f"{label}: prompt-proxy disposition is invalid")
    guard_score = guard.get("score")
    guard_confidence = guard.get("confidence")
    if (
        authorities[0] is not guard
        or guard.get("label") != "not_applicable"
        or isinstance(guard_score, bool)
        or not isinstance(guard_score, (int, float))
        or float(guard_score) != 0.0
        or type(guard_confidence) is not float
        or guard_confidence != 0.0
        or guard.get("parsed") is not True
        or guard.get("guardrail_unsafe") is not False
        or guard.get("over_refusal_expressible") is not False
        or guard.get("automated_decision_status") != "abstained"
        or guard.get("abstention_reason")
        != "guardrail_safe_cannot_adjudicate_benign_over_refusal"
    ):
        raise Gate5Error(
            f"{label}: abstention is not an exact terminal Guard N/A disposition"
        )


def validate_prompt_proxy_artifacts(results_root: Path, *, label: str) -> dict[str, Any]:
    marker_paths = sorted(results_root.glob("*.complete.json"))
    if len(marker_paths) != 1:
        raise Gate5Error(f"{label}: prompt proxy requires exactly one completed cell")
    marker = read_strict_json(marker_paths[0])
    judgments = _canary_artifact_rows(
        results_root, marker, "judgments", label=label
    )
    trails = _canary_artifact_rows(results_root, marker, "trails", label=label)
    results = _canary_artifact_rows(results_root, marker, "results", label=label)
    if not judgments:
        raise Gate5Error(f"{label}: prompt proxy retained no judgments")

    attempt_states: dict[
        str, tuple[str, str | None, str | None, float | None]
    ] = {}
    selected_judges: set[str] = set()
    selected_guardrail_decisions = 0
    decisions = 0
    abstentions = 0
    for judgment in judgments:
        attempt_id = judgment.get("attempt_id")
        raw = judgment.get("raw")
        if (
            not isinstance(attempt_id, str)
            or not attempt_id.strip()
            or not isinstance(raw, dict)
        ):
            raise Gate5Error(f"{label}: prompt-proxy judgment lineage changed")
        if attempt_id in attempt_states:
            raise Gate5Error(f"{label}: duplicate prompt-proxy judgment attempt")
        if (
            raw.get("common_metrics_eligible") is not False
            or raw.get("policy_evaluable_turn") is not True
            or raw.get("expected_behavior")
            not in {"safe_answer", "comply_safely"}
            or raw.get("policy_evaluation_status")
            != "approximate_common_security_proxy"
            or raw.get("metric_authority")
            != "supplementary_non_authoritative"
            or raw.get("required_metric") != PROMPT_PROXY_METRIC
            or raw.get("stage_queried") is not True
        ):
            raise Gate5Error(f"{label}: prompt-proxy judgment construct changed")
        raw_decision = raw.get("approximate_security_decision")
        decision_status = raw.get("approximate_decision_status")
        if raw_decision is None:
            if decision_status != "abstained":
                raise Gate5Error(
                    f"{label}: prompt proxy has neither a decision nor typed abstention"
                )
            _validate_prompt_proxy_abstention_judgment(
                judgment, label=f"{label} attempt {attempt_id}"
            )
            attempt_states[attempt_id] = (
                "abstention", None, None, None
            )
            abstentions += 1
            continue
        if decision_status is not None:
            raise Gate5Error(
                f"{label}: prompt-proxy decision also claims an abstention"
            )
        try:
            decision = validate_approximate_decision(raw_decision)
        except (TypeError, ValueError) as exc:
            raise Gate5Error(f"{label}: approximate decision is invalid: {exc}") from exc
        if (
            decision.source_required_metric != PROMPT_PROXY_METRIC
            or decision.source_evaluator_implemented is not False
            or decision.authority != "supplementary_non_authoritative"
            or decision.method != "common_judge_cascade_response_proxy"
            or decision.construct_mismatch is not True
            or decision.selected_judge not in {"rules", "guardrail"}
        ):
            raise Gate5Error(f"{label}: approximate decision provenance changed")
        source = raw.get("source_evaluation")
        authorities = [
            stage for stage in decision.retained_trail
            if stage.cascade_role == "authoritative"
        ]
        if (
            not isinstance(source, Mapping)
            or source.get("family") != PROMPT_PROXY_METRIC
            or source.get("implemented") is not False
            or source.get("valid") is not False
            or len(authorities) != 1
            or attempt_id != authorities[0].attempt_id
            or judgment.get("judge") != authorities[0].judge
            or judgment.get("label") != authorities[0].label
            or type(judgment.get("score")) is not float
            or judgment.get("score") != authorities[0].score
            or type(raw.get("cascade_stage")) is not int
            or raw.get("cascade_stage") != authorities[0].stage
            or raw.get("cascade_role") != "authoritative"
            or raw.get("cascade_confident") is not True
        ):
            raise Gate5Error(
                f"{label}: approximate decision is detached from its sole authority"
            )
        guard_stages = [
            stage for stage in decision.retained_trail
            if stage.stage == 1 and stage.judge == "guardrail"
        ]
        if len(guard_stages) != 1 or (
            guard_stages[0].judge_model != EXPECTED_SCORE_GUARD
            or guard_stages[0].judge_model_identity != EXPECTED_SCORE_GUARD_REVISION
            or guard_stages[0].judge_model_identity_type != "revision"
            or guard_stages[0].judge_model_identity_kind != "exact"
            or guard_stages[0].judge_model_queried is not True
        ):
            raise Gate5Error(f"{label}: approximate decision lacks exact queried Guard trail")
        if decision.selected_judge == "guardrail":
            selected_guardrail_decisions += 1
            if (
                decision.selected_judge_kind != "guardrail"
                or decision.judge_model != EXPECTED_SCORE_GUARD
                or decision.judge_model_identity != EXPECTED_SCORE_GUARD_REVISION
                or decision.judge_model_identity_type != "revision"
                or decision.judge_model_identity_kind != "exact"
                or decision.judge_model_queried is not True
            ):
                raise Gate5Error(f"{label}: selected Guard identity/query changed")
        selected_judges.add(decision.selected_judge)
        attempt_states[attempt_id] = (
            "decision",
            decision.selected_judge,
            authorities[0].label,
            authorities[0].score,
        )
        decisions += 1

    trails_by_attempt: dict[object, list[dict[str, Any]]] = {}
    for row in trails:
        trails_by_attempt.setdefault(row.get("attempt_id"), []).append(row)
    if set(trails_by_attempt) != set(attempt_states):
        raise Gate5Error(f"{label}: prompt-proxy trail inventory differs")
    guardrail_trail_queries = 0
    for attempt_id, rows in trails_by_attempt.items():
        disposition, selected_judge, selected_label, selected_score = (
            attempt_states[attempt_id]
        )
        _validate_prompt_proxy_trail_attempt(
            rows,
            disposition=disposition,
            selected_judge=selected_judge,
            label=f"{label} attempt {attempt_id}",
            selected_label=selected_label,
            selected_score=selected_score,
        )
        guardrail_trail_queries += 1

    approximate_results = [
        row for row in results
        if str(row.get("metric", "")).startswith("approximate_")
    ]
    if decisions:
        if not approximate_results or {
            row.get("metric") for row in approximate_results
        } != {"approximate_over_refusal_rate"}:
            raise Gate5Error(f"{label}: approximate over-refusal result is absent")
    elif approximate_results:
        raise Gate5Error(f"{label}: abstained prompt proxy retained metric results")
    selected_guardrail_results = 0
    aggregate_selected_judges: set[str] = set()
    for result in approximate_results:
        nested = result.get("provenance")
        try:
            provenance = validate_approximate_metric_provenance(
                result["metric"],
                nested.get("approximate_security") if isinstance(nested, dict) else None,
            )
        except (TypeError, ValueError) as exc:
            raise Gate5Error(f"{label}: approximate aggregate is invalid: {exc}") from exc
        if (
            provenance.source_required_metric != PROMPT_PROXY_METRIC
            or provenance.source_evaluator_implemented is not False
            or provenance.authority != "supplementary_non_authoritative"
            or provenance.method != "common_judge_cascade_response_proxy"
            or not provenance.selected_judges
            or set(provenance.selected_judges) - {"rules", "guardrail"}
        ):
            raise Gate5Error(f"{label}: approximate aggregate provenance changed")
        aggregate_selected_judges.update(provenance.selected_judges)
        if "guardrail" in provenance.selected_judges:
            selected_guardrail_results += 1
            if (
                provenance.judge_models != [EXPECTED_SCORE_GUARD]
                or provenance.judge_model_identities != [EXPECTED_SCORE_GUARD_REVISION]
                or provenance.judge_model_identity_types != ["revision"]
                or "exact" not in provenance.judge_identity_kinds
                or provenance.n_model_queried_decisions <= 0
            ):
                raise Gate5Error(f"{label}: selected aggregate Guard provenance changed")
        elif (
            provenance.n_model_queried_decisions != 0
            or provenance.judge_models
            or provenance.judge_model_identities
            or provenance.judge_model_identity_types
        ):
            raise Gate5Error(f"{label}: rules-selected aggregate credits a model")
    if aggregate_selected_judges != selected_judges:
        raise Gate5Error(
            f"{label}: aggregate selected judges differ from judgment decisions"
        )

    return validate_prompt_proxy_summary({
        "status": "validated",
        "arm": PROMPT_PROXY_ARM,
        "required_metric": PROMPT_PROXY_METRIC,
        "authority": "supplementary_non_authoritative",
        "method": "common_judge_cascade_response_proxy",
        "metrics": (
            ["approximate_over_refusal_rate"] if approximate_results else []
        ),
        "evaluable": len(judgments),
        "decisions": decisions,
        "abstentions": abstentions,
        "decision_coverage": decisions / len(judgments),
        "aggregate_results": len(approximate_results),
        "guardrail_trail_queries": guardrail_trail_queries,
        "selected_judges": sorted(selected_judges),
        "selected_guardrail_decisions": selected_guardrail_decisions,
        "selected_guardrail_aggregate_results": selected_guardrail_results,
        "guardrail_model": EXPECTED_SCORE_GUARD,
        "guardrail_revision": EXPECTED_SCORE_GUARD_REVISION,
    }, label=label)


def canary_stage_contract_self_test() -> list[str]:
    import copy

    common = [
        {"stage": 0, "judge": "rules", "role": "authoritative", "trail_records": 1,
         "queried_records": 1, "not_queried_records": 0, "reached": True},
        {"stage": 0, "judge": "rules", "role": "shadow", "trail_records": 1,
         "queried_records": 1, "not_queried_records": 0, "reached": True},
        {"stage": 1, "judge": "guardrail", "role": "authoritative", "trail_records": 1,
         "queried_records": 1, "not_queried_records": 0, "reached": True},
        {"stage": 1, "judge": "guardrail", "role": "shadow", "trail_records": 1,
         "queried_records": 1, "not_queried_records": 0, "reached": True},
    ]
    classification = [{
        "stage": 0, "judge": "rules", "role": "authoritative", "trail_records": 2,
        "queried_records": 0, "not_queried_records": 2, "reached": False,
    }]
    adaptive = [
        {"stage": 0, "judge": "rules", "role": "authoritative", "trail_records": 3,
         "queried_records": 1, "not_queried_records": 2, "reached": True},
        {"stage": 1, "judge": "guardrail", "role": "shadow", "trail_records": 3,
         "queried_records": 1, "not_queried_records": 2, "reached": True},
    ]
    validate_common_stage_contract(
        common, completed_judgments=2, evaluable_judgments=2,
        label="self-test"
    )
    validate_common_stage_contract(
        adaptive, completed_judgments=3, evaluable_judgments=1,
        label="self-test"
    )
    validate_classification_stage_contract(classification, label="self-test")
    mutations: list[tuple[str, Any, str]] = []
    missing = copy.deepcopy(common)
    missing.pop()
    mutations.append(("missing_guard_role", missing, "common"))
    wrong_order = copy.deepcopy(common)
    wrong_order[0], wrong_order[2] = wrong_order[2], wrong_order[0]
    mutations.append(("wrong_stage_order", wrong_order, "common"))
    unqueried = copy.deepcopy(common)
    unqueried[0].update(queried_records=0, not_queried_records=1, reached=False)
    mutations.append(("unqueried_common_role", unqueried, "common"))
    all_authoritative = copy.deepcopy(common)
    for row in all_authoritative:
        row["role"] = "authoritative"
    mutations.append(("no_dynamic_shadow", all_authoritative, "common"))
    missing_evaluable_query = copy.deepcopy(adaptive)
    missing_evaluable_query[1].update(
        queried_records=0, not_queried_records=3, reached=False
    )
    mutations.append((
        "adaptive_policy_evaluable_query_missing",
        missing_evaluable_query,
        "adaptive",
    ))
    queried_classification = copy.deepcopy(classification)
    queried_classification[0].update(queried_records=1, not_queried_records=1, reached=True)
    mutations.append(("queried_classification_placeholder", queried_classification, "classification"))
    rejected: list[str] = []
    for name, value, kind in mutations:
        try:
            if kind in {"common", "adaptive"}:
                validate_common_stage_contract(
                    value,
                    completed_judgments=3 if kind == "adaptive" else 2,
                    evaluable_judgments=1 if kind == "adaptive" else 2,
                    label="self-test",
                )
            else:
                validate_classification_stage_contract(value, label="self-test")
        except Gate5Error:
            rejected.append(name)
        else:
            raise Gate5Error(f"canary-stage mutation did not fail closed: {name}")
    proxy = {
        "status": "validated",
        "arm": PROMPT_PROXY_ARM,
        "required_metric": PROMPT_PROXY_METRIC,
        "authority": "supplementary_non_authoritative",
        "method": "common_judge_cascade_response_proxy",
        "metrics": ["approximate_over_refusal_rate"],
        "evaluable": 1,
        "decisions": 1,
        "abstentions": 0,
        "decision_coverage": 1.0,
        "aggregate_results": 1,
        "guardrail_trail_queries": 1,
        "selected_judges": ["guardrail"],
        "selected_guardrail_decisions": 1,
        "selected_guardrail_aggregate_results": 1,
        "guardrail_model": EXPECTED_SCORE_GUARD,
        "guardrail_revision": EXPECTED_SCORE_GUARD_REVISION,
    }
    validate_prompt_proxy_summary(proxy, label="self-test")
    for name, field, replacement in (
        ("proxy_wrong_arm", "arm", "cyberseceval_mitre"),
        ("proxy_unprefixed_metric", "metrics", ["over_refusal_rate"]),
        ("proxy_zero_guard_query", "guardrail_trail_queries", 0),
        ("proxy_mutable_guard", "guardrail_revision", "main"),
        ("proxy_authoritative", "authority", "authoritative"),
    ):
        mutated = dict(proxy)
        mutated[field] = replacement
        try:
            validate_prompt_proxy_summary(mutated, label="self-test")
        except Gate5Error:
            rejected.append(name)
        else:
            raise Gate5Error(f"proxy-summary mutation did not fail closed: {name}")
    abstained_proxy = {
        **proxy,
        "metrics": [],
        "decisions": 0,
        "abstentions": 1,
        "decision_coverage": 0.0,
        "aggregate_results": 0,
        "selected_judges": [],
        "selected_guardrail_decisions": 0,
        "selected_guardrail_aggregate_results": 0,
    }
    validate_prompt_proxy_summary(abstained_proxy, label="self-test")
    summary_mutations = (
        (
            "proxy_decision_missing_metric",
            proxy,
            {
                "metrics": [],
                "aggregate_results": 0,
                "selected_guardrail_aggregate_results": 0,
            },
        ),
        (
            "proxy_decision_abstention_mismatch",
            proxy,
            {"abstentions": 1},
        ),
        (
            "proxy_abstention_invents_metric",
            abstained_proxy,
            {"metrics": ["approximate_over_refusal_rate"], "aggregate_results": 1},
        ),
        (
            "proxy_abstention_invents_selected_judge",
            abstained_proxy,
            {"selected_judges": ["guardrail"]},
        ),
        (
            "proxy_abstention_wrong_coverage",
            abstained_proxy,
            {"decision_coverage": 1.0},
        ),
        (
            "proxy_abstention_integer_coverage",
            abstained_proxy,
            {"decision_coverage": 0},
        ),
    )
    for name, original, changes in summary_mutations:
        mutated = {**original, **changes}
        try:
            validate_prompt_proxy_summary(mutated, label="self-test")
        except Gate5Error:
            rejected.append(name)
        else:
            raise Gate5Error(f"proxy-summary mutation did not fail closed: {name}")

    trail_common = {
        "stage_queried": True,
        "policy_evaluation_status": "approximate_common_security_proxy",
        "metric_authority": "supplementary_non_authoritative",
        "required_metric": PROMPT_PROXY_METRIC,
    }
    decision_trail = [
        {
            **trail_common,
            "stage": 0,
            "judge": "rules",
            "cascade_role": "shadow",
            "cascade_confident": False,
        },
        {
            **trail_common,
            "stage": 1,
            "judge": "guardrail",
            "cascade_role": "authoritative",
            "cascade_confident": True,
            "confidence": 0.0,
            "guardrail_queried": True,
            "judge_model": EXPECTED_SCORE_GUARD,
            "judge_model_revision": EXPECTED_SCORE_GUARD_REVISION,
            "judge_model_identity": (
                f"{EXPECTED_SCORE_GUARD}@{EXPECTED_SCORE_GUARD_REVISION}"
            ),
            "label": "violation",
            "score": 1.0,
        },
    ]
    _validate_prompt_proxy_trail_attempt(
        decision_trail,
        disposition="decision",
        selected_judge="guardrail",
        label="self-test",
        selected_label="violation",
        selected_score=1.0,
    )
    abstention_trail = copy.deepcopy(decision_trail)
    abstention_trail[1].update({
        "label": "not_applicable",
        "score": 0.0,
        "parsed": True,
        "guardrail_unsafe": False,
        "over_refusal_expressible": False,
        "automated_decision_status": "abstained",
        "abstention_reason": (
            "guardrail_safe_cannot_adjudicate_benign_over_refusal"
        ),
    })
    _validate_prompt_proxy_trail_attempt(
        abstention_trail,
        disposition="abstention",
        selected_judge=None,
        label="self-test",
    )
    trail_mutations: list[tuple[str, list[dict[str, Any]], str, str | None]] = []
    multiple_authorities = copy.deepcopy(decision_trail)
    multiple_authorities[0].update(
        cascade_role="authoritative", cascade_confident=True
    )
    trail_mutations.append((
        "proxy_multiple_authorities",
        multiple_authorities,
        "decision",
        "guardrail",
    ))
    trail_mutations.append((
        "proxy_decision_authority_mismatch",
        copy.deepcopy(decision_trail),
        "decision",
        "rules",
    ))
    rules_authority = copy.deepcopy(abstention_trail)
    rules_authority[0].update(
        cascade_role="authoritative", cascade_confident=True
    )
    rules_authority[1]["cascade_role"] = "shadow"
    trail_mutations.append((
        "proxy_abstention_rules_authority",
        rules_authority,
        "abstention",
        None,
    ))
    non_na_abstention = copy.deepcopy(abstention_trail)
    non_na_abstention[1]["label"] = "safe"
    trail_mutations.append((
        "proxy_abstention_not_terminal_na",
        non_na_abstention,
        "abstention",
        None,
    ))
    boolean_stage = copy.deepcopy(abstention_trail)
    boolean_stage[1]["stage"] = True
    trail_mutations.append((
        "proxy_boolean_stage",
        boolean_stage,
        "abstention",
        None,
    ))
    confident_shadow = copy.deepcopy(abstention_trail)
    confident_shadow[0]["cascade_confident"] = True
    trail_mutations.append((
        "proxy_confident_shadow",
        confident_shadow,
        "abstention",
        None,
    ))
    boolean_trail_confidence = copy.deepcopy(abstention_trail)
    boolean_trail_confidence[1]["confidence"] = False
    trail_mutations.append((
        "proxy_boolean_trail_confidence",
        boolean_trail_confidence,
        "abstention",
        None,
    ))
    nonzero_trail_confidence = copy.deepcopy(abstention_trail)
    nonzero_trail_confidence[1]["confidence"] = 0.1
    trail_mutations.append((
        "proxy_nonzero_trail_confidence",
        nonzero_trail_confidence,
        "abstention",
        None,
    ))
    decision_score = copy.deepcopy(decision_trail)
    decision_score[1]["score"] = 0.0
    trail_mutations.append((
        "proxy_decision_score_detached",
        decision_score,
        "decision",
        "guardrail",
    ))
    for name, rows, disposition, selected_judge in trail_mutations:
        try:
            _validate_prompt_proxy_trail_attempt(
                rows,
                disposition=disposition,
                selected_judge=selected_judge,
                label="self-test",
                selected_label=(
                    "violation" if disposition == "decision" else None
                ),
                selected_score=(1.0 if disposition == "decision" else None),
            )
        except Gate5Error:
            rejected.append(name)
        else:
            raise Gate5Error(f"proxy-trail mutation did not fail closed: {name}")

    abstention_judgment = {
        "attempt_id": "attempt-self-test",
        "judge": "guardrail",
        "label": "not_applicable",
        "score": 0.0,
        "raw": {
            "expected_behavior": "safe_answer",
            "policy_evaluable_turn": True,
            "common_metrics_eligible": False,
            "policy_evaluation_status": "approximate_common_security_proxy",
            "metric_authority": "supplementary_non_authoritative",
            "required_metric": PROMPT_PROXY_METRIC,
            "cascade_stage": 1,
            "cascade_role": "authoritative",
            "cascade_confident": True,
            "stage_queried": True,
            "confidence": 0.0,
            "parsed": True,
            "unsafe": False,
            "guardrail_queried": True,
            "over_refusal_expressible": False,
            "automated_decision_status": "abstained",
            "approximate_decision_status": "abstained",
            "abstention_reason": (
                "guardrail_safe_cannot_adjudicate_benign_over_refusal"
            ),
            "approximate_security_decision": None,
            "approximate_rubric_stage_binding": None,
            "model": "fixture-target",
            "judge_model": EXPECTED_SCORE_GUARD,
            "model_revision": EXPECTED_SCORE_GUARD_REVISION,
            "model_identity": (
                f"{EXPECTED_SCORE_GUARD}@{EXPECTED_SCORE_GUARD_REVISION}"
            ),
            "source_evaluation": {
                "family": PROMPT_PROXY_METRIC,
                "implemented": False,
                "valid": False,
            },
        },
    }
    _validate_prompt_proxy_abstention_judgment(
        abstention_judgment, label="self-test"
    )
    source_claim = copy.deepcopy(abstention_judgment)
    source_claim["raw"]["source_evaluation"]["implemented"] = True
    wrong_judge_model = copy.deepcopy(abstention_judgment)
    wrong_judge_model["raw"]["judge_model"] = "fixture/wrong-guard"
    wrong_judge_revision = copy.deepcopy(abstention_judgment)
    wrong_judge_revision["raw"]["model_revision"] = "0" * 40
    wrong_judge_identity = copy.deepcopy(abstention_judgment)
    wrong_judge_identity["raw"]["model_identity"] = (
        f"fixture/wrong-guard@{'0' * 40}"
    )
    missing_proxy_status = copy.deepcopy(abstention_judgment)
    missing_proxy_status["raw"].pop("approximate_decision_status")
    boolean_judgment_confidence = copy.deepcopy(abstention_judgment)
    boolean_judgment_confidence["raw"]["confidence"] = False
    nonzero_judgment_confidence = copy.deepcopy(abstention_judgment)
    nonzero_judgment_confidence["raw"]["confidence"] = 0.1
    for name, value in (
        ("proxy_abstention_source_evaluator_claim", source_claim),
        ("proxy_abstention_wrong_judge_model", wrong_judge_model),
        ("proxy_abstention_wrong_judge_revision", wrong_judge_revision),
        ("proxy_abstention_wrong_judge_identity", wrong_judge_identity),
        ("proxy_abstention_missing_status", missing_proxy_status),
        (
            "proxy_abstention_boolean_judgment_confidence",
            boolean_judgment_confidence,
        ),
        (
            "proxy_abstention_nonzero_judgment_confidence",
            nonzero_judgment_confidence,
        ),
    ):
        try:
            _validate_prompt_proxy_abstention_judgment(value, label="self-test")
        except Gate5Error:
            rejected.append(name)
        else:
            raise Gate5Error(
                f"proxy-abstention mutation did not fail closed: {name}"
            )
    return rejected


def validate_common_source_evaluator(
    source: object, *, arm: str, label: str
) -> None:
    """Validate the exact source-evaluator role for common/proxy canaries."""

    if not isinstance(source, Mapping):
        raise Gate5Error(f"{label}: source-evaluator role is not an object")
    required = source.get("required_records")
    observed = source.get("observed_records")
    valid = source.get("valid_records")
    if arm == PROMPT_PROXY_ARM:
        if (
            source.get("status") != "not_exercised"
            or isinstance(required, bool)
            or not isinstance(required, int)
            or required <= 0
            or observed != 0
            or valid != 0
        ):
            raise Gate5Error(
                f"{label}: prompt-proxy source evaluator is not the exact "
                "required-but-unimplemented role"
            )
        return
    if source != {
        "status": "not_applicable",
        "required_records": 0,
        "observed_records": 0,
        "valid_records": 0,
    }:
        raise Gate5Error(
            f"{label}: common-metric canary unexpectedly requires or uses a source evaluator"
        )


def validate_canary_bundle(canary_path: Path, *, expected_id: str) -> dict[str, Any]:
    retained = validate_lane_canary_summary(read_strict_json(canary_path))
    if retained["canary_id"] != expected_id or canary_path.name != f"{expected_id}.lane-canary.json":
        raise Gate5Error(f"canary identity/path mismatch: {canary_path}")
    if retained.get("evidence_class") != "live_diagnostic":
        raise Gate5Error(f"canary is not live diagnostic evidence: {canary_path}")
    results_root = canary_path.parent
    eligibility_path = find_single(
        results_root, "eligibility-*.eligibility.json", label=str(results_root)
    )
    with tempfile.TemporaryDirectory(prefix="ura-gate5-canary-revalidate-") as temporary:
        rebuilt, rebuilt_path = summarize_canary(
            results=results_root,
            eligibility_path=eligibility_path,
            out_dir=Path(temporary),
        )
        if rebuilt != retained:
            raise Gate5Error(f"full canary-tree revalidation changed the summary: {canary_path}")
        if sha256_file(rebuilt_path, max_bytes=MAX_JSON_BYTES) != sha256_file(
            canary_path, max_bytes=MAX_JSON_BYTES
        ):
            raise Gate5Error(f"full canary-tree revalidation changed canonical bytes: {canary_path}")

    roles = retained["role_reachability"]
    execution = roles["execution_roles"]
    if execution["attacker"]["status"] != "exercised":
        raise Gate5Error(f"canary attacker was not exercised: {canary_path}")
    if execution["target"]["status"] != "exercised":
        raise Gate5Error(f"canary target was not exercised: {canary_path}")
    if roles["all_configured_stages_represented"] is not True:
        raise Gate5Error(f"canary did not represent every configured stage: {canary_path}")
    judges = retained["condition"]["judges"]
    stages = roles["stages"]
    if judges == ["rules", "guardrail"]:
        validate_common_stage_contract(
            stages,
            completed_judgments=retained["workload"]["completed_judgments"],
            evaluable_judgments=retained["decision_support"]["evaluable"],
            label=str(canary_path),
        )
        validate_common_source_evaluator(
            execution.get("source_evaluator"),
            arm=retained["condition"]["logical_source_arm"],
            label=str(canary_path),
        )
        policy = "common_or_adaptive_rules_guardrail_policy_evaluable_stages_queried"
    elif judges == ["rules"]:
        validate_classification_stage_contract(stages, label=str(canary_path))
        source = execution["source_evaluator"]
        # Parser-invalid predictions remain complete source observations and
        # contribute validity=0 rather than disappearing from the campaign.
        if (
            source.get("status") != "exercised"
            or not isinstance(source.get("required_records"), int)
            or source["required_records"] <= 0
            or not isinstance(source.get("observed_records"), int)
            or source["observed_records"] <= 0
            or not isinstance(source.get("valid_records"), int)
            or source["required_records"] != source["observed_records"]
            or source["observed_records"] != retained["workload"]["completed_judgments"]
            or source["valid_records"] < 0
            or source["valid_records"] > source["observed_records"]
        ):
            raise Gate5Error(
                "classification source evaluator lacks complete implemented "
                f"observations: {canary_path}"
            )
        policy = "source_classification_evaluator_exercised_rules_placeholder_not_reached"
    else:
        raise Gate5Error(f"unsupported local canary judge inventory {judges!r}: {canary_path}")

    grid_path = find_canary_grid(results_root)
    grid = read_strict_json(grid_path)
    eligibility, observed_eligibility_identity = load_eligibility_artifact(
        eligibility_path
    )
    projection_binding = grid.get("request", {}).get("lane_projection")
    if not isinstance(projection_binding, dict):
        raise Gate5Error(f"canary grid lacks its exact lane-projection binding: {grid_path}")
    projection_name = projection_binding.get("file")
    if (
        not isinstance(projection_name, str)
        or not projection_name
        or Path(projection_name).name != projection_name
    ):
        raise Gate5Error(f"canary lane-projection filename is unsafe: {grid_path}")
    canary_projection_path = checked_file(
        grid_path.parent / projection_name, max_bytes=MAX_LANE_PROJECTION_BYTES
    )
    canary_projection, observed_projection_identity = (
        load_stable_lane_projection_file(canary_projection_path)
    )
    if {
        key: projection_binding.get(key) for key in observed_projection_identity
    } != observed_projection_identity:
        raise Gate5Error(f"canary lane-projection artifact binding changed: {grid_path}")
    eligibility_binding = grid.get("request", {}).get("eligibility_plan")
    if not isinstance(eligibility_binding, dict):
        raise Gate5Error(f"canary grid lacks its exact eligibility binding: {grid_path}")
    if {
        key: eligibility_binding.get(key) for key in observed_eligibility_identity
    } != observed_eligibility_identity:
        raise Gate5Error(f"canary eligibility artifact binding changed: {grid_path}")
    canary_projection = validate_lane_projection_binding(
        canary_projection,
        eligibility_plan=eligibility,
        eligibility_artifact=observed_eligibility_identity,
    )
    envelope_path = find_single(
        results_root,
        "request-envelope-*.request-envelope.json",
        label=str(results_root),
    )
    _envelope, envelope_descriptor = load_stable_request_envelope_file(envelope_path)
    validate_eligibility_envelope_binding(
        eligibility,
        envelope_descriptor,
        label=f"canary {canary_path}",
    )
    if canary_projection.get("projection_id") != projection_binding.get("projection_id"):
        raise Gate5Error(f"canary lane-projection identity changed: {grid_path}")

    realized = retained["condition"]["realized_identities"]
    target_identity = realized.get("target")
    realized_judges = realized.get("judges")
    if (
        not isinstance(target_identity, dict)
        or isinstance(target_identity.get("observations"), bool)
        or not isinstance(target_identity.get("observations"), int)
        or target_identity["observations"] <= 0
        or not isinstance(target_identity.get("snapshot"), dict)
        or not isinstance(realized_judges, list)
    ):
        raise Gate5Error(f"canary lacks positive realized target/judge identity support: {canary_path}")
    expected_realized_names = ["rules", "guardrail"] if judges == ["rules", "guardrail"] else ["rules"]
    if [item.get("judge") if isinstance(item, dict) else None for item in realized_judges] != expected_realized_names:
        raise Gate5Error(f"canary realized judge order/inventory changed: {canary_path}")
    for index, (item, judge) in enumerate(zip(realized_judges, expected_realized_names)):
        if (
            not isinstance(item, dict)
            or item.get("stage") != index
            or item.get("judge") != judge
            or isinstance(item.get("observations"), bool)
            or not isinstance(item.get("observations"), int)
            or item["observations"] <= 0
            or not isinstance(item.get("snapshot"), dict)
            or item["snapshot"].get("judge") != judge
        ):
            raise Gate5Error(f"canary realized judge identity support changed: {canary_path}")
    if realized_judges[0]["snapshot"] != {"judge": "rules"}:
        raise Gate5Error(f"canary realized rules identity changed: {canary_path}")
    if judges == ["rules", "guardrail"]:
        request = grid.get("request", {})
        model = request.get("guardrail_model")
        revision = request.get("guardrail_revision")
        if (
            not isinstance(model, str)
            or not model.strip()
            or not isinstance(revision, str)
            or re.fullmatch(r"[0-9a-f]{40,64}", revision) is None
        ):
            raise Gate5Error(f"canary selected Guardrail judge lacks immutable identity: {grid_path}")
        expected_guard_snapshot = {
            "judge": "guardrail",
            "requested_model": model,
            "model_revision": revision,
            "model_identity": f"{model}@{revision}",
        }
        if realized_judges[1]["snapshot"] != expected_guard_snapshot:
            raise Gate5Error(f"canary did not realize the exact selected Guardrail identity: {canary_path}")
    live_attestation = validate_canary_live_attestations(
        results_root=results_root,
        grid=grid,
        eligibility=eligibility,
        condition=retained["condition"],
    )
    return {
        "results_root": results_root,
        "canary_path": canary_path,
        "canary": retained,
        "canary_descriptor": descriptor(canary_path, max_bytes=MAX_JSON_BYTES),
        "eligibility_path": eligibility_path,
        "grid_path": grid_path,
        "grid": grid,
        "eligibility": eligibility,
        "lane_projection_path": canary_projection_path,
        "lane_projection": canary_projection,
        "live_attestation": live_attestation,
        "acceptance_policy": policy,
    }


def validate_defense_response_audit(results_root: Path, *, label: str) -> dict[str, int]:
    """Require exact queried 1B input/output defense evidence for the canary."""

    response_paths = sorted(results_root.rglob("*.responses.jsonl"))
    if len(response_paths) != 1:
        raise Gate5Error(
            f"{label}: expected one defense response stream, found {len(response_paths)}"
        )
    responses: list[dict[str, Any]] = []
    _response_path, _response_sha, _response_bytes, response_payload = (
        stable_file_observation(
            response_paths[0], max_bytes=MAX_LOG_BYTES, retain_payload=True
        )
    )
    assert response_payload is not None
    for raw_line in response_payload.splitlines():
        if not raw_line.strip():
            continue
        try:
            value = strict_json_loads(raw_line)
        except (TypeError, ValueError) as exc:
            raise Gate5Error(f"{label}: invalid defense response JSON: {exc}") from exc
        if not isinstance(value, dict):
            raise Gate5Error(f"{label}: defense response stream contains a non-object")
        responses.append(value)
    if not responses:
        raise Gate5Error(f"{label}: no response-level defense evidence")
    exact_fields = {
        "schema", "stage", "judge", "label", "model", "model_revision",
        "model_identity", "device", "guardrail_queried", "parsed",
    }
    stages = 0
    for response in responses:
        raw = response.get("raw")
        audit = raw.get("defense_judge_audit") if isinstance(raw, dict) else None
        if not isinstance(audit, list) or len(audit) != 2:
            raise Gate5Error(f"{label}: defense canary lacks its input/output audit pair")
        if [item.get("stage") for item in audit if isinstance(item, dict)] != [
            "input", "output"
        ]:
            raise Gate5Error(f"{label}: defense audit stage order changed")
        for item in audit:
            if (
                not isinstance(item, dict)
                or set(item) != exact_fields
                or item.get("schema") != "ura-defense-judge-audit/1"
                or item.get("judge") != "guardrail"
                or item.get("label") not in {"safe", "violation"}
                or item.get("model") != EXPECTED_DEFENSE_GUARD
                or item.get("model_revision") != EXPECTED_DEFENSE_GUARD_REVISION
                or item.get("model_identity")
                != f"{EXPECTED_DEFENSE_GUARD}@{EXPECTED_DEFENSE_GUARD_REVISION}"
                or item.get("device") != "cuda:1"
                or item.get("guardrail_queried") is not True
                or item.get("parsed") is not True
            ):
                raise Gate5Error(f"{label}: defense Guard identity/query facts changed")
        if (
            audit[0].get("label") != "safe"
            or raw.get("base_target_queried") is not True
            or raw.get("defense_stages_evaluated") != ["input", "output"]
        ):
            raise Gate5Error(f"{label}: defense canary did not exercise both stages")
        stages += len(audit)
    return {"responses": len(responses), "queried_defense_stages": stages}


def selected_source_instances(
    project_root: Path, arms: Sequence[str], *, label: str
) -> tuple[dict[str, dict[str, object]], dict[str, str]]:
    source_config = checked_file(
        project_root / "experiments" / "source-instances.json",
        max_bytes=4 * 1024 * 1024,
    )
    try:
        instances, artifact = _load_source_config(
            str(source_config), list(arms), sha256_file(source_config)
        )
    except ValueError as exc:
        raise Gate5Error(f"{label}: pinned source config cannot be normalized: {exc}") from exc
    normalized = artifact.get("normalized_selected_sha256") if artifact else None
    if not isinstance(normalized, str) or HEX64_RE.fullmatch(normalized) is None:
        raise Gate5Error(f"{label}: pinned source config lacks its selected identity")
    return instances, {"normalized_selected_sha256": normalized}


def validate_selected_config_relationship(
    *,
    lane: str,
    preliminary_values: Mapping[str, Any],
    canary_values: Mapping[str, Any],
    preliminary_source_identity: Mapping[str, str],
    canary_source_identity: Mapping[str, str],
) -> None:
    """Allow only the two purpose-bound config-identity differences."""

    fields = {
        "source_config", "source_conformance", "attacker_config",
        "engine_runtime_config", "api_config", "local_config",
    }
    preliminary = preliminary_values.get("selected_config_identities")
    canary = canary_values.get("selected_config_identities")
    if (
        not isinstance(preliminary, Mapping)
        or set(preliminary) != fields
        or not isinstance(canary, Mapping)
        or set(canary) != fields
    ):
        raise Gate5Error(f"{lane}: selected config-identity inventory changed")
    if preliminary.get("source_config") != dict(preliminary_source_identity):
        raise Gate5Error(f"{lane}: bounded source-config selection identity changed")
    if canary.get("source_config") != dict(canary_source_identity):
        raise Gate5Error(f"{lane}: canary source-config selection identity changed")
    for field in (
        "source_conformance", "engine_runtime_config", "api_config", "local_config",
    ):
        if canary.get(field) != preliminary.get(field):
            raise Gate5Error(f"{lane}: canary/bounded {field} identity differs")
    preliminary_attacker = preliminary.get("attacker_config")
    canary_attacker = canary.get("attacker_config")
    if lane != "harmbench-replay":
        if canary_attacker != preliminary_attacker:
            raise Gate5Error(f"{lane}: canary/bounded attacker-config identity differs")
        return
    for label, value in (
        ("bounded", preliminary_attacker), ("canary", canary_attacker)
    ):
        if (
            not isinstance(value, Mapping)
            or set(value) != {"normalized_selected_sha256"}
            or HEX64_RE.fullmatch(str(value.get("normalized_selected_sha256", ""))) is None
        ):
            raise Gate5Error(
                f"harmbench-replay: {label} selection-bound attacker identity is invalid"
            )
    if preliminary_attacker == canary_attacker:
        raise Gate5Error(
            "harmbench-replay: limit-1 and limit-50 replay identities were not regenerated"
        )


def sampling_binding_from_audit(audit: Mapping[str, Any]) -> dict[str, Any]:
    return {
        "converter": audit.get("converter"),
        "full_converted_corpus_sha256": audit.get("full_converted_corpus_sha256"),
        "selected_converted_corpus_sha256": audit.get(
            "selected_converted_corpus_sha256"
        ),
        "selected_datapoint_ids_sha256": canonical_json_sha256(
            sorted(audit.get("selected_ids") or [])
        ),
        "selected_records": audit.get("selected_records"),
        "sample_seed": audit.get("sample_seed"),
        "limit": audit.get("limit"),
    }


def projection_arm_from_audit(
    audit: Mapping[str, Any], *, logical_source_arm: str
) -> dict[str, Any]:
    return {
        "logical_source_arm": logical_source_arm,
        "converter": audit.get("converter"),
        "selected_converted_corpus_sha256": audit.get(
            "selected_converted_corpus_sha256"
        ),
        "selected_datapoint_ids_sha256": canonical_json_sha256(
            sorted(audit.get("selected_ids") or [])
        ),
        "total_records": audit.get("total_records"),
        "selected_records": audit.get("selected_records"),
        "total_clusters": audit.get("total_clusters"),
        "selected_clusters": audit.get("selected_clusters"),
        "selected_cluster_ids_sha256": canonical_json_sha256(
            sorted(audit.get("selected_cluster_ids") or [])
        ),
        "sample_seed": audit.get("sample_seed"),
        "limit": audit.get("limit"),
    }


def validate_recomputed_sampling_arm(
    *,
    lane: str,
    label: str,
    arm: str,
    expected_limit: int,
    projection_arm: Mapping[str, Any],
    selected_binding: Mapping[str, Any],
    audit: Mapping[str, Any],
) -> None:
    if (
        audit.get("selection_method") != BOUNDED_SELECTION_METHOD
        or audit.get("sample_seed") != 0
        or audit.get("limit") != expected_limit
        or audit.get("selected_clusters")
        != min(audit.get("total_clusters", 0), expected_limit)
    ):
        raise Gate5Error(
            f"{lane}: recomputed {label} sample is not the deterministic bounded prefix"
        )
    if dict(selected_binding) != sampling_binding_from_audit(audit):
        raise Gate5Error(f"{lane}: {label} selected-corpus binding failed recomputation")
    expected_arm = projection_arm_from_audit(audit, logical_source_arm=arm)
    for field, value in expected_arm.items():
        if projection_arm.get(field) != value:
            raise Gate5Error(
                f"{lane}: {label} projection arm {field} failed recomputation"
            )


def validate_sampling_relationship_evidence(
    *,
    lane: str,
    arm: str,
    expected_limit: int,
    preliminary_arm: Mapping[str, Any],
    preliminary_binding: Mapping[str, Any],
    canary_arm: Mapping[str, Any],
    canary_binding: Mapping[str, Any],
    bounded_audit: Mapping[str, Any],
    canary_audit: Mapping[str, Any],
    canary_workload: Mapping[str, Any] | None,
) -> None:
    """Prove a limit-1 canary is nested in the exact bounded source sample."""

    validate_recomputed_sampling_arm(
        lane=lane,
        label="bounded",
        arm=arm,
        expected_limit=expected_limit,
        projection_arm=preliminary_arm,
        selected_binding=preliminary_binding,
        audit=bounded_audit,
    )
    validate_recomputed_sampling_arm(
        lane=lane,
        label="canary",
        arm=arm,
        expected_limit=1,
        projection_arm=canary_arm,
        selected_binding=canary_binding,
        audit=canary_audit,
    )
    if (
        bounded_audit.get("converter") != canary_audit.get("converter")
        or bounded_audit.get("full_converted_corpus_sha256")
        != canary_audit.get("full_converted_corpus_sha256")
        or bounded_audit.get("total_records") != canary_audit.get("total_records")
        or bounded_audit.get("total_clusters") != canary_audit.get("total_clusters")
    ):
        raise Gate5Error(f"{lane}: canary and bounded source universes differ")
    bounded_clusters = bounded_audit.get("selected_cluster_ids")
    canary_clusters = canary_audit.get("selected_cluster_ids")
    if (
        not isinstance(bounded_clusters, list)
        or not isinstance(canary_clusters, list)
        or len(canary_clusters) != 1
        or not set(canary_clusters).issubset(set(bounded_clusters))
    ):
        raise Gate5Error(f"{lane}: canary cluster is not nested in the bounded sample")
    if canary_workload is not None:
        expected_clusters = sorted(canary_audit.get("selected_cluster_ids") or [])
        expected_rows = sorted(canary_audit.get("selected_ids") or [])
        expected_workload = {
            "selected_clusters": 1,
            "selected_cluster_ids": expected_clusters,
            "selected_cluster_ids_sha256": canonical_json_sha256(expected_clusters),
            "selected_rows": len(expected_rows),
            "selected_row_ids": expected_rows,
            "selected_row_ids_sha256": canonical_json_sha256(expected_rows),
        }
        for field, value in expected_workload.items():
            if canary_workload.get(field) != value:
                raise Gate5Error(
                    f"{lane}: canary workload {field} failed source recomputation"
                )


def revalidate_nested_selection(
    *,
    lane: str,
    prelim: Mapping[str, Any],
    canary_eligibility: Mapping[str, Any],
    canary_projection: Mapping[str, Any],
    arm: str,
    project_root: Path,
    canary_workload: Mapping[str, Any] | None,
    observed_canary_instances: object | None,
) -> tuple[dict[str, str], dict[str, str]]:
    request = prelim["envelope"]["request"]
    expected_limit = EXPECTED_MEASURED_LIMITS[lane]
    instances, preliminary_source_identity = selected_source_instances(
        project_root, request["logical_source_arms"], label=f"{lane} bounded request"
    )
    canary_instances, canary_source_identity = selected_source_instances(
        project_root, [arm], label=f"{lane} canary request"
    )
    if observed_canary_instances is not None and observed_canary_instances != canary_instances:
        raise Gate5Error(f"{lane}: canary grid source-instance mapping changed")
    request_arms = request["logical_source_arms"]
    preliminary_arms = {
        item.get("logical_source_arm"): item
        for item in prelim["projection"].get("selection", {}).get("arms", [])
        if isinstance(item, Mapping)
    }
    preliminary_bindings = prelim["eligibility"]["bindings"].get("selected_corpora")
    if (
        len(request_arms) != len(set(request_arms))
        or set(preliminary_arms) != set(request_arms)
        or len(preliminary_arms)
        != len(prelim["projection"].get("selection", {}).get("arms", []))
        or not isinstance(preliminary_bindings, Mapping)
        or set(preliminary_bindings) != set(request_arms)
    ):
        raise Gate5Error(f"{lane}: bounded source-arm inventory changed")
    bounded_audits: dict[str, Mapping[str, Any]] = {}
    try:
        for bounded_arm in request_arms:
            _rows, audit = load_corpus_with_audit(
                bounded_arm,
                expected_limit,
                0,
                source_instance=instances[bounded_arm],
            )
            bounded_audits[bounded_arm] = audit
            selected_binding = preliminary_bindings[bounded_arm]
            if not isinstance(selected_binding, Mapping):
                raise Gate5Error(
                    f"{lane}: bounded selected-corpus binding is not an object"
                )
            validate_recomputed_sampling_arm(
                lane=lane,
                label=f"bounded {bounded_arm}",
                arm=bounded_arm,
                expected_limit=expected_limit,
                projection_arm=preliminary_arms[bounded_arm],
                selected_binding=selected_binding,
                audit=audit,
            )
        _canary_rows, canary_audit = load_corpus_with_audit(
            arm, 1, 0, source_instance=canary_instances[arm]
        )
    except Gate5Error:
        raise
    except (KeyError, OSError, ValueError) as exc:
        raise Gate5Error(f"{lane}: source selection cannot be recomputed: {exc}") from exc
    canary_arms = canary_projection.get("selection", {}).get("arms")
    if (
        arm not in preliminary_arms
        or not isinstance(canary_arms, list)
        or len(canary_arms) != 1
        or not isinstance(canary_arms[0], Mapping)
        or canary_arms[0].get("logical_source_arm") != arm
    ):
        raise Gate5Error(f"{lane}: source arm is not unique in both projections")
    canary_bindings = canary_eligibility["bindings"].get("selected_corpora")
    if (
        not isinstance(preliminary_bindings, Mapping)
        or not isinstance(preliminary_bindings.get(arm), Mapping)
        or not isinstance(canary_bindings, Mapping)
        or set(canary_bindings) != {arm}
        or not isinstance(canary_bindings.get(arm), Mapping)
    ):
        raise Gate5Error(f"{lane}: selected-corpus binding inventory changed")
    validate_sampling_relationship_evidence(
        lane=lane,
        arm=arm,
        expected_limit=expected_limit,
        preliminary_arm=preliminary_arms[arm],
        preliminary_binding=preliminary_bindings[arm],
        canary_arm=canary_arms[0],
        canary_binding=canary_bindings[arm],
        bounded_audit=bounded_audits[arm],
        canary_audit=canary_audit,
        canary_workload=canary_workload,
    )
    return preliminary_source_identity, canary_source_identity


def validate_lane_relationship(
    lane: str,
    prelim: Mapping[str, Any],
    canary: Mapping[str, Any],
    *,
    project_root: Path,
) -> None:
    request = prelim["envelope"]["request"]
    condition = canary["canary"]["condition"]
    grid_request = canary["grid"].get("request")
    if not isinstance(grid_request, dict):
        raise Gate5Error(f"{lane}: canary grid lacks its request object")
    expected_limit = EXPECTED_MEASURED_LIMITS.get(lane)
    if expected_limit is None:
        raise Gate5Error(f"{lane}: runnable lane has no prospective population tier")
    if request.get("limit") != expected_limit or request.get("sample_seed") != 0:
        raise Gate5Error(
            f"{lane}: bounded population must use limit {expected_limit} and sample seed 0"
        )
    selection_arms = prelim["projection"].get("selection", {}).get("arms")
    if not isinstance(selection_arms, list) or not selection_arms:
        raise Gate5Error(f"{lane}: bounded projection has no arm inventory")
    for selected_arm in selection_arms:
        if not isinstance(selected_arm, dict):
            raise Gate5Error(f"{lane}: bounded projection arm is not an object")
        total = selected_arm.get("total_clusters")
        selected = selected_arm.get("selected_clusters")
        if (
            isinstance(total, bool)
            or not isinstance(total, int)
            or total <= 0
            or isinstance(selected, bool)
            or not isinstance(selected, int)
            or selected != min(total, expected_limit)
            or selected_arm.get("sample_seed") != 0
            or selected_arm.get("limit") != expected_limit
        ):
            raise Gate5Error(
                f"{lane}: projection arm is not the complete deterministic bounded prefix"
            )
    requested_targets = request["requested_target_keys"]
    if len(requested_targets) != 1:
        raise Gate5Error(
            f"{lane}: prospective measured lane does not bind exactly one requested target"
        )
    requested_target = requested_targets[0]
    if requested_target.startswith("ollama:"):
        local_configs = grid_request.get("local_configs")
        if not isinstance(local_configs, dict) or len(local_configs) != 1:
            raise Gate5Error(f"{lane}: Ollama canary lacks one exact realized local config")
        realized_name, local_config = next(iter(local_configs.items()))
        digest = local_config.get("digest") if isinstance(local_config, dict) else None
        if not isinstance(digest, str) or HEX64_RE.fullmatch(digest) is None:
            raise Gate5Error(f"{lane}: Ollama canary local config lacks a model digest")
        expected_realized = f"{requested_target}@sha256:{digest}"
        if (
            realized_name != expected_realized
            or condition["requested_model_spec"] != expected_realized
            or condition["resolved_target"] != expected_realized
        ):
            raise Gate5Error(f"{lane}: raw Ollama request does not map to its exact digest identity")
        realized = condition.get("realized_identities")
        snapshot = (
            realized.get("target", {}).get("snapshot", {})
            if isinstance(realized, dict)
            else {}
        )
        if snapshot.get("model_digest") != digest or snapshot.get("target") != expected_realized:
            raise Gate5Error(f"{lane}: Ollama realized target snapshot/digest mismatch")
    elif requested_targets != [condition["requested_model_spec"]]:
        raise Gate5Error(f"{lane}: canary target does not match the bounded request")
    if request["selected_attackers"] != [condition["attacker"]]:
        raise Gate5Error(f"{lane}: canary attacker does not match the bounded request")
    if request["judges"] != condition["judges"]:
        raise Gate5Error(f"{lane}: canary judges do not match the bounded request")
    if request["defense"] != condition["defense"]:
        raise Gate5Error(f"{lane}: canary defense does not match the bounded request")
    if canary["canary"]["workload"]["selected_clusters"] != 1:
        raise Gate5Error(f"{lane}: diagnostic canary did not retain exactly one cluster")

    arm = condition["logical_source_arm"]
    if arm not in request["logical_source_arms"]:
        raise Gate5Error(f"{lane}: canary arm is outside the bounded arm inventory")
    if lane == "bridge-purplellama":
        expected_arms = {
            "cyberseceval_mitre",
            "cyberseceval_interpreter",
            "cyberseceval_insecure_coding",
            PROMPT_PROXY_ARM,
        }
        if (
            arm != PROMPT_PROXY_ARM
            or set(request["logical_source_arms"]) != expected_arms
            or len(request["logical_source_arms"]) != len(expected_arms)
        ):
            raise Gate5Error(
                "bridge-purplellama: bounded-projection/canary prompt-proxy arm contract changed"
            )
        if not isinstance(canary, dict):
            raise Gate5Error("bridge-purplellama: canary bundle is not mutable")
        canary["approximate_proxy"] = validate_prompt_proxy_artifacts(
            canary["results_root"], label="bridge-purplellama canary"
        )
    if lane == "defense-local":
        if (
            requested_targets != ["vllm:Qwen/Qwen3-VL-8B-Instruct"]
            or set(request["logical_source_arms"]) != DEFENSE_LANE_TEXT_ARMS
            or len(request["logical_source_arms"]) != len(DEFENSE_LANE_TEXT_ARMS)
            or arm != "jailbreakbench_benign"
            or request.get("defense") != "both"
            or request.get("defense_guard") != "guardrail"
            or request.get("judges") != ["rules", "guardrail"]
            or request.get("approximate_common_metrics") is not True
        ):
            raise Gate5Error(
                "defense-local: bounded-projection/canary request contract changed"
            )
        expected_defense = {
            "defense_guardrail_model": EXPECTED_DEFENSE_GUARD,
            "defense_guardrail_revision": EXPECTED_DEFENSE_GUARD_REVISION,
            "defense_guardrail_device": "cuda:1",
        }
        for field, expected in expected_defense.items():
            if grid_request.get(field) != expected:
                raise Gate5Error(f"defense-local: canary field {field} changed")
        if not isinstance(canary, dict):
            raise Gate5Error("defense-local: canary bundle is not mutable")
        canary["defense_judge_audit"] = validate_defense_response_audit(
            canary["results_root"], label="defense-local canary"
        )
    if grid_request.get("corpora") != [arm] or grid_request.get("attackers") != [condition["attacker"]]:
        raise Gate5Error(f"{lane}: canary grid is not the exact one-arm/one-attacker representative")
    if grid_request.get("models") != [condition["requested_model_spec"]]:
        raise Gate5Error(f"{lane}: canary grid target inventory differs from its realized condition")

    preliminary_arms = {
        item.get("logical_source_arm"): item
        for item in prelim["projection"].get("selection", {}).get("arms", [])
        if isinstance(item, dict)
    }
    canary_arms = canary["lane_projection"].get("selection", {}).get("arms")
    if (
        len(preliminary_arms) != len(prelim["projection"]["selection"]["arms"])
        or arm not in preliminary_arms
        or not isinstance(canary_arms, list)
        or len(canary_arms) != 1
        or canary_arms[0].get("logical_source_arm") != arm
    ):
        raise Gate5Error(f"{lane}: canary arm is not uniquely represented in both projections")
    preliminary_arm = preliminary_arms[arm]
    canary_arm = canary_arms[0]
    preliminary_source_identity, canary_source_identity = revalidate_nested_selection(
        lane=lane,
        prelim=prelim,
        canary_eligibility=canary["eligibility"],
        canary_projection=canary["lane_projection"],
        arm=arm,
        project_root=project_root,
        canary_workload=canary["canary"]["workload"],
        observed_canary_instances=grid_request.get("source_instances"),
    )

    def media_modalities(item: Mapping[str, Any], *, label: str) -> tuple[str, ...]:
        media = item.get("selected_input_media")
        if not isinstance(media, dict):
            raise Gate5Error(f"{lane}: {label} lacks selected-input-media evidence")
        refs = media.get("refs_by_modality")
        unique_bytes = media.get("unique_bytes_by_modality")
        if not isinstance(refs, dict) or not isinstance(unique_bytes, dict) or set(refs) != set(unique_bytes):
            raise Gate5Error(f"{lane}: {label} media modality inventories differ")
        for modality in refs:
            if (
                not isinstance(modality, str)
                or not modality
                or isinstance(refs[modality], bool)
                or not isinstance(refs[modality], int)
                or refs[modality] <= 0
                or isinstance(unique_bytes[modality], bool)
                or not isinstance(unique_bytes[modality], int)
                or unique_bytes[modality] <= 0
            ):
                raise Gate5Error(f"{lane}: {label} has invalid media evidence for {modality!r}")
        expected_status = "available" if refs else "not_applicable"
        if media.get("status") != expected_status:
            raise Gate5Error(f"{lane}: {label} media status/inventory differs")
        return tuple(sorted(refs))

    preliminary_modalities = media_modalities(
        preliminary_arm, label="bounded projection arm"
    )
    canary_modalities = media_modalities(canary_arm, label="canary projection arm")
    if canary_modalities != preliminary_modalities:
        raise Gate5Error(
            f"{lane}: canary physical-media modalities differ from the bounded projection"
        )
    attested_combinations = {
        tuple(item["exact_input_modalities"])
        for item in canary["live_attestation"]["required_scope_target_modality_keys"]
    }
    if not attested_combinations or {
        modality for combination in attested_combinations for modality in combination
        if modality != "text"
    } != set(canary_modalities):
        raise Gate5Error(f"{lane}: live attestation modalities do not represent the selected arm")

    preliminary_values = prelim["eligibility"]["bindings"]["experiment_conditions"]["values"]
    canary_values = canary["eligibility"]["bindings"]["experiment_conditions"]["values"]
    exact_fields = (
        "project_revision",
        "defense",
        "defense_guard",
        "judges",
        "judge_model",
        "guardrail_model",
        "guardrail_revision",
        "guardrail_device",
        "defense_guardrail_model",
        "defense_guardrail_revision",
        "defense_guardrail_device",
        "seeds",
        "sample_seed",
        "max_queries",
        "max_turns",
        "group_keys",
        "quantization",
        "dtype",
        "engine_runtimes",
        "model_acquisition",
    )
    for field in exact_fields:
        if canary_values.get(field) != preliminary_values.get(field):
            raise Gate5Error(
                f"{lane}: canary/bounded projection experiment condition {field} differs"
            )
    validate_selected_config_relationship(
        lane=lane,
        preliminary_values=preliminary_values,
        canary_values=canary_values,
        preliminary_source_identity=preliminary_source_identity,
        canary_source_identity=canary_source_identity,
    )
    for field in (
        "defense", "defense_guard", "judges", "judge_model", "guardrail_model",
        "guardrail_revision", "guardrail_device", "defense_guardrail_model",
        "defense_guardrail_revision", "defense_guardrail_device", "seeds", "sample_seed",
        "max_queries", "max_turns", "group_keys", "quantization", "dtype",
    ):
        if grid_request.get(field) != canary_values.get(field):
            raise Gate5Error(f"{lane}: canary grid/eligibility condition {field} differs")

    approximate = request.get("approximate_common_metrics")
    if (
        not isinstance(approximate, bool)
        or grid_request.get("approximate_common_metrics") is not approximate
    ):
        raise Gate5Error(f"{lane}: approximate-common-metrics policy differs in the canary")
    expected_approximate = condition["judges"] == ["rules", "guardrail"]
    if approximate is not expected_approximate:
        raise Gate5Error(
            f"{lane}: common rules/Guardrail lanes must select approximate common metrics, "
            "and source-classification rules lanes must not"
        )
    if request.get("hosted_judge_data_transfer_acknowledged") is not False or grid_request.get(
        "hosted_judge_data_transfer_acknowledged"
    ) is not False:
        raise Gate5Error(f"{lane}: local canary carries a hosted-judge transfer acknowledgement")


def config_descriptor_from_grid(grid: Mapping[str, Any], field: str) -> dict[str, Any] | None:
    request = grid.get("request")
    if not isinstance(request, dict):
        raise Gate5Error("canary grid lacks request object")
    value = request.get(field)
    if value is None:
        return None
    if not isinstance(value, dict):
        raise Gate5Error(f"canary grid {field} is not an artifact descriptor")
    digest = value.get("sha256")
    size = value.get("bytes")
    name = value.get("file")
    if (
        not isinstance(digest, str)
        or HEX64_RE.fullmatch(digest) is None
        or isinstance(size, bool)
        or not isinstance(size, int)
        or size <= 0
        or not isinstance(name, str)
        or not name
    ):
        raise Gate5Error(f"canary grid {field} descriptor is invalid")
    return dict(value)


def bounded_rglob(root: Path, name: str, *, limit: int = MAX_CONTROL_FILES) -> list[Path]:
    output: list[Path] = []
    if not root.is_dir():
        return output
    for path in root.rglob(name):
        output.append(path)
        if len(output) > limit:
            raise Gate5Error(f"config lookup exceeded {limit} candidates under {root}")
    return output


def find_config_by_descriptor(
    artifact: Mapping[str, Any], *, search_roots: Sequence[Path], preferred: Sequence[Path] = (), label: str
) -> Path:
    digest = str(artifact["sha256"])
    basename = str(artifact["file"])
    candidates: list[Path] = list(preferred)
    if Path(basename).name == basename:
        for root in search_roots:
            candidates.extend(bounded_rglob(root, basename))
    valid: dict[str, Path] = {}
    for candidate in candidates:
        try:
            path = checked_file(candidate, max_bytes=4 * 1024 * 1024)
        except Gate5Error:
            continue
        if sha256_file(path, max_bytes=4 * 1024 * 1024) == digest:
            valid[str(path)] = path
    if len(valid) != 1:
        raise Gate5Error(
            f"{label}: expected exactly one config matching sha256:{digest}; found {len(valid)}. "
            "Use an explicit lane manifest with a retained base_argv if the controller used a private transient config."
        )
    return next(iter(valid.values()))


def option(argv: Sequence[str], name: str) -> str | None:
    values: list[str] = []
    index = 0
    while index < len(argv):
        token = argv[index]
        if token == name:
            if index + 1 >= len(argv):
                raise Gate5Error(f"argument {name} lacks its value")
            values.append(argv[index + 1])
            index += 2
            continue
        if token.startswith(name + "="):
            values.append(token.split("=", 1)[1])
        index += 1
    if len(values) > 1:
        raise Gate5Error(f"argument {name} is repeated")
    return values[0] if values else None


def validate_base_argv(argv: object, *, lane: str) -> list[str]:
    if (
        not isinstance(argv, list)
        or not argv
        or any(not isinstance(item, str) or not item for item in argv)
    ):
        raise Gate5Error(f"{lane}: base_argv must be a non-empty list of strings")
    output = list(argv)
    for token in output:
        key = token.split("=", 1)[0]
        if key in OWNED_FLAGS_WITH_VALUE or key in OWNED_BOOLEAN_FLAGS:
            raise Gate5Error(f"{lane}: finalizer-owned flag is forbidden in base_argv: {key}")
    if option(output, "--api") or option(output, "--api-config"):
        raise Gate5Error(f"{lane}: hosted target arguments are forbidden")
    judges = (option(output, "--judges") or "").split(",")
    if "llm" in judges:
        raise Gate5Error(f"{lane}: LLM judge is forbidden in local Gate 5")
    if option(output, "--local") is None:
        raise Gate5Error(f"{lane}: base_argv must bind one explicit --local target")
    if option(output, "--local-config") is None:
        raise Gate5Error(f"{lane}: base_argv must bind an explicit --local-config")
    if "--ack-hosted-judge-data-transfer" in output:
        raise Gate5Error(f"{lane}: hosted judge transfer acknowledgement is forbidden")
    parser = build_parser()
    try:
        parser.parse_args([
            *output,
            "--max-total-target-calls", "1",
            "--max-total-judge-calls", "0",
            "--max-total-http-attempts", "0",
            "--deadline-seconds", str(CALL_START_DEADLINE_SECONDS),
            "--out", "/gate5/parser-only",
            "--preflight-only",
        ])
    except SystemExit as exc:
        raise Gate5Error(f"{lane}: base_argv is not accepted by run_matrix parser") from exc
    return output


def bridge_private_args(
    *, lane: str, projection_control: Path, work: Path
) -> list[str]:
    tag = tag_from_root(projection_control)
    if tag is None:
        raise Gate5Error(f"{lane}: cannot derive bridge projection controller tag")
    private = work / "state" / "bridge-configs" / tag
    prepared = work / "runs" / "thesis" / "prepared" / tag
    if lane in {"bridge-pyrit", "bridge-deepteam", "bridge-h4rm3l", "bridge-spikee"}:
        engine = lane.removeprefix("bridge-")
        attacker = checked_file(private / f"attacker-{engine}.json", max_bytes=4 * 1024 * 1024)
        runtime = checked_file(private / f"engine-runtime-{engine}.json", max_bytes=4 * 1024 * 1024)
        return [
            "--attacker-config", str(attacker),
            "--attacker-config-sha256", sha256_file(attacker),
            "--engine-runtime-config", str(runtime),
            "--engine-runtime-config-sha256", sha256_file(runtime),
        ]
    if lane == "harmbench-replay":
        attacker = checked_file(
            prepared / "harmbench-direct-exploratory-50-config.json",
            max_bytes=4 * 1024 * 1024,
        )
        return [
            "--attacker-config", str(attacker),
            "--attacker-config-sha256", sha256_file(attacker),
        ]
    return []


def derive_base_argv(
    *,
    lane: str,
    family: str,
    prelim: Mapping[str, Any],
    canary: Mapping[str, Any],
    project_root: Path,
    projection_control: Path,
    canary_control: Path,
    work: Path,
) -> tuple[list[str], str]:
    request = prelim["envelope"]["request"]
    condition = prelim["eligibility"]["bindings"]["experiment_conditions"]["values"]
    grid = canary["grid"]
    targets = request["requested_target_keys"]
    if len(targets) != 1:
        raise Gate5Error(f"{lane}: exact finalizer requires one local target per lane")
    target = targets[0]
    source_config = checked_file(project_root / "experiments" / "source-instances.json")
    source_artifact = config_descriptor_from_grid(grid, "source_config_artifact")
    if source_artifact is None or sha256_file(source_config) != source_artifact["sha256"]:
        raise Gate5Error(f"{lane}: current source-config bytes do not match canary evidence")

    local_artifact = config_descriptor_from_grid(grid, "local_config_artifact")
    if local_artifact is None:
        raise Gate5Error(f"{lane}: canary lacks a local-config artifact binding")
    search_roots = [
        project_root / "experiments",
        projection_control,
        canary_control,
    ]
    preferred: list[Path] = []
    model_map = {
        "vllm:Qwen/Qwen3-VL-8B-Instruct": project_root / "experiments" / "local-qwen3-vl.json",
        "vllm:llava-hf/llava-v1.6-mistral-7b-hf": project_root / "experiments" / "local-llava-base.json",
        "vllm:GraySwanAI/llava-v1.6-mistral-7b-hf-RR": project_root / "experiments" / "local-llava-rr.json",
    }
    if target in model_map:
        preferred.append(model_map[target])
    local_config = find_config_by_descriptor(
        local_artifact,
        search_roots=search_roots,
        preferred=preferred,
        label=f"{lane} local config",
    )

    project_manifest = checked_file(required_env("URA_PROJECT_REVISION_MANIFEST"))
    source_receipt = checked_file(required_env("URA_SOURCE_CONFORMANCE_MANIFEST"))
    argv = [
        "--project-revision", str(project_manifest),
        "--project-revision-sha256", required_env("URA_PROJECT_REVISION_SHA256").lower(),
        "--local", target,
        "--local-config", str(local_config),
        "--local-config-sha256", sha256_file(local_config),
        "--attackers", ",".join(request["selected_attackers"]),
        "--judges", ",".join(request["judges"]),
        "--corpora", ",".join(request["logical_source_arms"]),
        "--source-config", str(source_config),
        "--source-config-sha256", sha256_file(source_config),
        "--source-conformance", str(source_receipt),
        "--source-conformance-sha256", required_env("URA_SOURCE_CONFORMANCE_SHA256").lower(),
        "--limit", str(request["limit"]),
        "--sample-seed", str(request["sample_seed"]),
        "--seeds", ",".join(str(seed) for seed in request["seeds"]),
        "--max-queries", str(request["max_queries"]),
        "--max-turns", str(request["max_turns"]),
        "--group", ",".join(request["group_keys"]),
        "--dtype", request["dtype"],
    ]
    if request["approximate_common_metrics"]:
        argv.append("--approximate-common-metrics")
    if request["defense"] != "none":
        argv.extend(["--defense", request["defense"], "--defense-guard", request["defense_guard"]])
    if request["quantization"]:
        argv.extend(["--quantization", request["quantization"]])
    if request["judge_model"] is not None:
        argv.extend(["--judge-model", request["judge_model"]])
    if "guardrail" in request["judges"]:
        for field, flag in (
            ("guardrail_model", "--guardrail-model"),
            ("guardrail_revision", "--guardrail-revision"),
            ("guardrail_device", "--guardrail-device"),
        ):
            value = condition.get(field)
            if value:
                argv.extend([flag, str(value)])
    if request["defense"] != "none" and request["defense_guard"] == "guardrail":
        for field, flag in (
            ("defense_guardrail_model", "--defense-guardrail-model"),
            ("defense_guardrail_revision", "--defense-guardrail-revision"),
            ("defense_guardrail_device", "--defense-guardrail-device"),
        ):
            value = condition.get(field)
            if value:
                argv.extend([flag, str(value)])
    if family == "bridge":
        argv.extend(bridge_private_args(
            lane=lane, projection_control=projection_control, work=work
        ))
    acquisition_mode = (
        "not_applicable_no_managed_hub_resource"
        if target.startswith("ollama:")
        and "guardrail" not in request["judges"]
        and not (
            request["defense"] != "none" and request["defense_guard"] == "guardrail"
        )
        else "required_zero_download"
    )
    return validate_base_argv(argv, lane=lane), acquisition_mode


def validate_bounded_harmbench_attacker_config(
    *,
    path_value: object,
    sha_value: object,
    expected_identity: object,
) -> Path:
    if (
        not isinstance(path_value, str)
        or not path_value
        or not isinstance(sha_value, str)
        or HEX64_RE.fullmatch(sha_value) is None
    ):
        raise Gate5Error(
            "harmbench-replay: bounded attacker-config binding is incomplete"
        )
    attacker_config = checked_file(path_value, max_bytes=4 * 1024 * 1024)
    if sha256_file(attacker_config, max_bytes=4 * 1024 * 1024) != sha_value:
        raise Gate5Error("harmbench-replay: bounded attacker-config SHA differs")
    try:
        configs, artifact = _load_attacker_config(
            str(attacker_config), ["harmbench"], sha_value
        )
    except (OSError, ValueError) as exc:
        raise Gate5Error(
            f"harmbench-replay: bounded attacker config is invalid: {exc}"
        ) from exc
    observed_identity = (
        {"normalized_selected_sha256": artifact.get("normalized_selected_sha256")}
        if artifact else None
    )
    if set(configs) != {"harmbench"} or observed_identity != expected_identity:
        raise Gate5Error(
            "harmbench-replay: bounded attacker config does not match projection evidence"
        )
    return attacker_config


def validate_base_argv_evidence_parity(
    argv: Sequence[str], *, lane: str, prelim: Mapping[str, Any],
    canary: Mapping[str, Any], project_root: Path,
) -> None:
    """Bind even explicit-manifest argv to the exact reviewed request/config bytes."""

    request = prelim["envelope"]["request"]
    condition = prelim["eligibility"]["bindings"]["experiment_conditions"]["values"]
    grid = canary["grid"]

    def bound_config(
        path_flag: str, sha_flag: str, descriptor_field: str, *, required: bool,
    ) -> Path | None:
        path_value = option(argv, path_flag)
        sha_value = option(argv, sha_flag)
        retained = config_descriptor_from_grid(grid, descriptor_field)
        if retained is None:
            if required or path_value is not None or sha_value is not None:
                raise Gate5Error(f"{lane}: {descriptor_field} presence differs from canary evidence")
            return None
        if not path_value or not sha_value:
            raise Gate5Error(f"{lane}: {descriptor_field} argv binding is incomplete")
        path = checked_file(path_value, max_bytes=4 * 1024 * 1024)
        observed = descriptor(path, max_bytes=4 * 1024 * 1024)
        if (
            sha_value != retained["sha256"]
            or observed["sha256"] != retained["sha256"]
            or observed["bytes"] != retained["bytes"]
            or path.name != Path(str(retained["file"])).name
        ):
            raise Gate5Error(f"{lane}: {descriptor_field} argv bytes differ from canary evidence")
        return path

    source_config = bound_config(
        "--source-config", "--source-config-sha256", "source_config_artifact",
        required=True,
    )
    expected_source_config = checked_file(project_root / "experiments" / "source-instances.json")
    if source_config != expected_source_config:
        raise Gate5Error(f"{lane}: base argv source config is not the pinned project artifact")
    local_config = bound_config(
        "--local-config", "--local-config-sha256", "local_config_artifact",
        required=True,
    )
    if lane == "harmbench-replay":
        attacker_config = validate_bounded_harmbench_attacker_config(
            path_value=option(argv, "--attacker-config"),
            sha_value=option(argv, "--attacker-config-sha256"),
            expected_identity=condition["selected_config_identities"]["attacker_config"],
        )
    else:
        attacker_config = bound_config(
            "--attacker-config", "--attacker-config-sha256", "attacker_config_artifact",
            required=False,
        )
    runtime_config = bound_config(
        "--engine-runtime-config", "--engine-runtime-config-sha256",
        "engine_runtime_config_artifact", required=False,
    )
    if config_descriptor_from_grid(grid, "api_config_artifact") is not None:
        raise Gate5Error(f"{lane}: local Gate 5 canary unexpectedly binds an API config")

    project_manifest = checked_file(required_env("URA_PROJECT_REVISION_MANIFEST"))
    source_receipt = checked_file(required_env("URA_SOURCE_CONFORMANCE_MANIFEST"))
    expected = [
        "--project-revision", str(project_manifest),
        "--project-revision-sha256", required_env("URA_PROJECT_REVISION_SHA256").lower(),
        "--local", request["requested_target_keys"][0],
        "--local-config", str(local_config),
        "--local-config-sha256", sha256_file(local_config),
        "--attackers", ",".join(request["selected_attackers"]),
        "--judges", ",".join(request["judges"]),
        "--corpora", ",".join(request["logical_source_arms"]),
        "--source-config", str(source_config),
        "--source-config-sha256", sha256_file(source_config),
        "--source-conformance", str(source_receipt),
        "--source-conformance-sha256", required_env("URA_SOURCE_CONFORMANCE_SHA256").lower(),
        "--limit", str(request["limit"]),
        "--sample-seed", str(request["sample_seed"]),
        "--seeds", ",".join(str(seed) for seed in request["seeds"]),
        "--max-queries", str(request["max_queries"]),
        "--max-turns", str(request["max_turns"]),
        "--group", ",".join(request["group_keys"]),
        "--dtype", request["dtype"],
    ]
    if request["approximate_common_metrics"]:
        expected.append("--approximate-common-metrics")
    if request["defense"] != "none":
        expected.extend(["--defense", request["defense"], "--defense-guard", request["defense_guard"]])
    if request["quantization"]:
        expected.extend(["--quantization", request["quantization"]])
    if request["judge_model"] is not None:
        expected.extend(["--judge-model", request["judge_model"]])
    if "guardrail" in request["judges"]:
        for field, flag in (
            ("guardrail_model", "--guardrail-model"),
            ("guardrail_revision", "--guardrail-revision"),
            ("guardrail_device", "--guardrail-device"),
        ):
            if condition.get(field):
                expected.extend([flag, str(condition[field])])
    if request["defense"] != "none" and request["defense_guard"] == "guardrail":
        for field, flag in (
            ("defense_guardrail_model", "--defense-guardrail-model"),
            ("defense_guardrail_revision", "--defense-guardrail-revision"),
            ("defense_guardrail_device", "--defense-guardrail-device"),
        ):
            if condition.get(field):
                expected.extend([flag, str(condition[field])])
    if attacker_config is not None:
        expected.extend([
            "--attacker-config", str(attacker_config),
            "--attacker-config-sha256", sha256_file(attacker_config),
        ])
    if runtime_config is not None:
        expected.extend([
            "--engine-runtime-config", str(runtime_config),
            "--engine-runtime-config-sha256", sha256_file(runtime_config),
        ])
    if list(argv) != expected:
        raise Gate5Error(f"{lane}: base argv is not the exact evidence-derived ordered request")


def value_or_na(disposition: str) -> dict[str, Any]:
    status = "N/A" if disposition == "structural_na" else disposition.upper()
    return {"status": status, "value": None}


def terminal_row(raw: Mapping[str, Any]) -> dict[str, Any]:
    lane = str(raw.get("lane_id") or raw.get("lane") or "").strip()
    if LANE_RE.fullmatch(lane) is None:
        raise Gate5Error(f"invalid terminal lane id: {lane!r}")
    disposition = str(raw.get("disposition", "")).strip().lower().replace("-", "_")
    if disposition in {"blocked_unpinned", "blocked"}:
        disposition = "unavailable"
    if disposition not in ALLOWED_DISPOSITIONS - {"runnable", DEFENSE_NA_DISPOSITION}:
        raise Gate5Error(f"{lane}: invalid terminal disposition {disposition!r}")
    reason = str(raw.get("reason", "")).strip()
    if not reason:
        raise Gate5Error(f"{lane}: terminal disposition requires a reason")
    reason_code = str(raw.get("reason_code") or "operator_recorded_unavailable").strip()
    row = {
        "lane_id": lane,
        "family": str(raw.get("family") or "operator_inventory"),
        "disposition": disposition,
        "reason_code": reason_code,
        "reason": reason,
        "projection": value_or_na(disposition),
        "canary": value_or_na(disposition),
        "final_preflight": value_or_na(disposition),
        "approved_caps": value_or_na(disposition),
    }
    return row


def validate_defense_conditional_na_manifest_row(raw: Mapping[str, Any]) -> None:
    if set(raw) != {
        "lane_id", "family", "disposition", "reason_code", "reason",
        "projection", "canary", "final_preflight", "approved_caps",
    }:
        raise Gate5Error("defense-local: conditional N/A manifest fields changed")
    if (
        raw.get("lane_id") != "defense-local"
        or raw.get("family") != "core"
        or raw.get("disposition") != DEFENSE_NA_DISPOSITION
        or raw.get("projection") != DEFENSE_NA_TYPED_VALUE
        or raw.get("final_preflight") != DEFENSE_NA_TYPED_VALUE
        or raw.get("approved_caps") != DEFENSE_NA_TYPED_VALUE
    ):
        raise Gate5Error("defense-local: conditional N/A manifest contract changed")
    canary = raw.get("canary")
    if not isinstance(canary, dict) or set(canary) != {
        "status", "value", "conditional_na_artifact", "call_accounting"
    }:
        raise Gate5Error("defense-local: conditional N/A canary descriptor changed")
    variant = defense_na_manifest_variant(raw)
    if (
        {"status": canary.get("status"), "value": canary.get("value")}
        != DEFENSE_NA_TYPED_VALUE
        or not exact_json_contract(
            canary.get("call_accounting"), variant["call_accounting"]
        )
    ):
        raise Gate5Error("defense-local: conditional N/A canary accounting changed")
    artifact = canary.get("conditional_na_artifact")
    if not isinstance(artifact, dict) or set(artifact) != {"path", "sha256", "bytes"}:
        raise Gate5Error("defense-local: conditional N/A artifact descriptor fields changed")
    if (
        not isinstance(artifact.get("path"), str)
        or not Path(artifact["path"]).is_absolute()
        or Path(artifact["path"]).name != "defense-local.conditional-na.json"
        or not isinstance(artifact.get("sha256"), str)
        or HEX64_RE.fullmatch(artifact["sha256"]) is None
        or isinstance(artifact.get("bytes"), bool)
        or not isinstance(artifact.get("bytes"), int)
        or artifact["bytes"] <= 0
    ):
        raise Gate5Error("defense-local: conditional N/A artifact descriptor is invalid")


def parse_bridge_dispositions(root: Path) -> list[dict[str, Any]]:
    candidates = [root / "unavailable.tsv", root / "dispositions.tsv"]
    source = next((path for path in candidates if path.is_file() and not path.is_symlink()), None)
    if source is None:
        raise Gate5Error(f"bridge projection root lacks unavailable/dispositions TSV: {root}")
    output: list[dict[str, Any]] = []
    seen_raw: set[str] = set()
    for row in read_tsv(source):
        if set(row) != {"lane", "disposition", "reason"}:
            raise Gate5Error(f"bridge terminal TSV field inventory changed: {source}")
        lane = lane_key(row)
        if lane in seen_raw:
            raise Gate5Error(f"bridge terminal inventory duplicates {lane!r}: {source}")
        seen_raw.add(lane)
        disposition_raw = (row.get("disposition") or "").strip().lower()
        disposition = "unavailable" if disposition_raw in {
            "unavailable", "blocked-unpinned", "blocked_unpinned", "blocked"
        } else disposition_raw.replace("-", "_")
        reason = str(row.get("reason", "")).strip()
        expected_reasons = EXPECTED_BRIDGE_SOURCE_REASONS.get(lane)
        expected_disposition_raw = (
            "blocked-unpinned" if lane == "t3mp3st" else "unavailable"
        )
        if (
            expected_reasons is None
            or reason not in expected_reasons
            or disposition_raw != expected_disposition_raw
            or disposition != EXPECTED_BRIDGE_TERMINALS.get(lane)
        ):
            raise Gate5Error(
                f"bridge terminal row is not the exact reviewed disposition/reason: {lane!r}"
            )
        canonical_raw = next(
            item for item in EXPECTED_BRIDGE_TERMINAL_ROWS if item["lane_id"] == lane
        )
        output.append(terminal_row(canonical_raw))
    observed = {row["lane_id"]: row["disposition"] for row in output}
    if observed != EXPECTED_BRIDGE_TERMINALS:
        raise Gate5Error(
            f"bridge terminal inventory mismatch: expected {EXPECTED_BRIDGE_TERMINALS}, observed {observed}"
        )
    return output


def status_int(row: Mapping[str, str], key: str, *, lane: str) -> int:
    value = row.get(key, "")
    try:
        parsed = int(value)
    except ValueError as exc:
        raise Gate5Error(f"{lane}: status {key} is not an integer") from exc
    if parsed < 0:
        raise Gate5Error(f"{lane}: status {key} is negative")
    return parsed


def validated_artifact_descriptor(
    raw: object, *, label: str, max_bytes: int = MAX_JSON_BYTES,
    allow_empty: bool = False,
) -> Path:
    if not isinstance(raw, dict) or set(raw) != {"path", "sha256", "bytes"}:
        raise Gate5Error(f"{label}: artifact descriptor fields changed")
    path_value = raw.get("path")
    size = raw.get("bytes")
    digest = raw.get("sha256")
    if (
        not isinstance(path_value, str)
        or not Path(path_value).is_absolute()
        or not isinstance(size, int)
        or isinstance(size, bool)
        or size < (0 if allow_empty else 1)
        or not isinstance(digest, str)
        or HEX64_RE.fullmatch(digest) is None
    ):
        raise Gate5Error(f"{label}: artifact descriptor values are invalid")
    path = checked_file(path_value, max_bytes=max_bytes)
    if descriptor(path, max_bytes=max_bytes) != raw:
        raise Gate5Error(f"{label}: artifact descriptor does not match exact retained bytes")
    return path


def validate_zero_download_result_rows(
    rows: Sequence[Mapping[str, Any]], *, receipt_id: str, receipt_sha256: str
) -> None:
    if (
        len(rows) != 1
        or not isinstance(rows[0], Mapping)
        or set(rows[0]) != {"receipt_id", "receipt_sha256", "downloaded_bytes"}
        or rows[0].get("receipt_id") != receipt_id
        or rows[0].get("receipt_sha256") != receipt_sha256
        or type(rows[0].get("downloaded_bytes")) is not int
        or rows[0].get("downloaded_bytes") != 0
    ):
        raise Gate5Error("defense-local: acquisition result is not exact zero-download evidence")


def validate_defense_na_artifact_inventory_shape(
    raw: object, *, expected_keys: frozenset[str] = DEFENSE_NA_ARTIFACT_KEYS
) -> dict[str, dict[str, Any]]:
    if not isinstance(raw, dict) or set(raw) != expected_keys:
        raise Gate5Error("defense-local: conditional N/A artifact inventory changed")
    for name, item in raw.items():
        if not isinstance(item, dict) or set(item) != {"path", "sha256", "bytes"}:
            raise Gate5Error(f"defense-local: conditional N/A {name} descriptor fields changed")
        if (
            not isinstance(item.get("path"), str)
            or not Path(item["path"]).is_absolute()
            or not isinstance(item.get("sha256"), str)
            or HEX64_RE.fullmatch(item["sha256"]) is None
            or isinstance(item.get("bytes"), bool)
            or not isinstance(item.get("bytes"), int)
            or item["bytes"] < (
                0 if name in {
                    "empty_attempts", "empty_responses", "empty_judge_trails",
                    "empty_results",
                } else 1
            )
        ):
            raise Gate5Error(f"defense-local: conditional N/A {name} descriptor is invalid")
    return raw


def validate_defense_na_live_binding_shape(
    raw: object, *, attestation: Mapping[str, Any], filename: str
) -> list[dict[str, Any]]:
    artifacts = raw.get("artifacts") if isinstance(raw, dict) else None
    if (
        not isinstance(raw, dict)
        or set(raw) != {"mode", "execution_scope_id", "max_age_hours", "artifacts"}
        or raw.get("mode") != "measured"
        or not isinstance(raw.get("execution_scope_id"), str)
        or not raw["execution_scope_id"].strip()
        or type(raw.get("max_age_hours")) is not float
        or raw.get("max_age_hours") != 24.0
        or not isinstance(artifacts, list)
        or len(artifacts) != 1
        or not isinstance(artifacts[0], dict)
        or set(artifacts[0]) != {"file", "sha256", "bytes", "attestation_id"}
        or artifacts[0].get("file") != filename
        or artifacts[0].get("sha256") != attestation.get("sha256")
        or artifacts[0].get("bytes") != attestation.get("bytes")
        or re.fullmatch(
            r"live-attestation-[0-9a-f]{24}",
            str(artifacts[0].get("attestation_id", "")),
        ) is None
    ):
        raise Gate5Error("defense-local: conditional N/A live-attestation binding changed")
    return artifacts


def validate_defense_conditional_na_artifact(
    path_value: str | Path,
    *,
    canary_control: Path,
    prelim: Mapping[str, Any],
    project_root: Path,
    work: Path,
) -> dict[str, Any]:
    """Validate the sole allowed resource-conditional Gate-5 terminal."""

    artifact_path = checked_file(path_value, max_bytes=MAX_JSON_BYTES)
    if (
        artifact_path.parent != canary_control
        or artifact_path.name != "defense-local.conditional-na.json"
    ):
        raise Gate5Error(
            "defense-local: conditional N/A artifact is not the canonical canary-control child"
        )
    value = read_strict_json(artifact_path)
    variant = defense_na_variant_from_value(value)
    is_output_noncompletion = value.get("schema") == DEFENSE_NA_V2_SCHEMA
    classified = value.get("classified_at_utc")
    if not isinstance(classified, str):
        raise Gate5Error("defense-local: conditional N/A lacks its classification time")
    try:
        classified_at = datetime.strptime(classified, "%Y-%m-%dT%H:%M:%SZ").replace(
            tzinfo=timezone.utc
        )
    except ValueError as exc:
        raise Gate5Error("defense-local: conditional N/A time is not canonical UTC") from exc
    if classified_at > datetime.now(timezone.utc):
        raise Gate5Error("defense-local: conditional N/A classification time is in the future")

    artifacts = validate_defense_na_artifact_inventory_shape(
        value.get("artifacts"), expected_keys=variant["artifact_keys"]
    )
    resolved_artifacts = {
        name: validated_artifact_descriptor(
            raw,
            label=f"defense-local conditional N/A {name}",
            max_bytes=(
                MAX_LOG_BYTES
                if name in {"runner_log", "acquisition_result_log"}
                else MAX_JSON_BYTES
            ),
            allow_empty=name in {
                "empty_attempts", "empty_responses", "empty_judge_trails",
                "empty_results",
            },
        )
        for name, raw in artifacts.items()
    }
    runner_log = resolved_artifacts["runner_log"]
    if runner_log.parent != canary_control or runner_log.name != "defense-local.canary.log":
        raise Gate5Error("defense-local: conditional N/A Runner log location changed")
    acquisition_log = resolved_artifacts["acquisition_result_log"]
    if (
        acquisition_log.parent != canary_control
        or acquisition_log.name != "defense-local-canary.acquire.log"
    ):
        raise Gate5Error("defense-local: conditional N/A acquisition log location changed")
    _runner_log, log_text = stable_text(
        runner_log, max_bytes=MAX_LOG_BYTES, errors="replace"
    )
    if is_output_noncompletion:
        failure_lines = re.findall(
            r"^  ! cell failed \[[^\r\n]+\]: ExternalCallFailure: target_call failed "
            r"\(LocalTargetOutputError\): vLLM completion is truncated or incomplete: "
            r"'length'$",
            log_text,
            flags=re.MULTILINE,
        )
        if (
            len(failure_lines) != 1
            or log_text.count("done: 0 cells written, 0 already complete, 2 failed") != 1
            or "CUDA out of memory" in log_text
        ):
            raise Gate5Error(
                "defense-local: conditional N/A lacks exact target-output noncompletion"
            )
    else:
        oom_lines = re.findall(
            r"^cannot initialize matrix lifecycle: [^\r\n]*CUDA out of memory[^\r\n]*$",
            log_text,
            flags=re.IGNORECASE | re.MULTILINE,
        )
        if len(oom_lines) != 1:
            raise Gate5Error(
                "defense-local: conditional N/A lacks one positive Runner lifecycle CUDA OOM"
            )

    run_root = checked_dir(
        resolved_artifacts["budget_ledger"].parent,
        label="defense-local conditional N/A diagnostic root",
    )
    if not run_root.is_relative_to(work):
        raise Gate5Error("defense-local: conditional N/A diagnostic root is outside URA_WORK")
    root_local = {
        "budget_ledger", "invocation_deadline", "request_envelope",
        "eligibility_plan", "lane_projection",
    }
    if is_output_noncompletion:
        root_local.update({
            "partial_grid", "circuit_ledger", "target_error", "failed_cell_manifest",
            "empty_attempts", "empty_responses", "empty_judge_trails", "empty_results",
            "parquet_placeholder", "retained_live_attestation",
        })
    if any(resolved_artifacts[name].parent != run_root for name in root_local):
        raise Gate5Error("defense-local: conditional N/A Runner artifacts span roots")
    if is_output_noncompletion:
        expected_inventory = {
            "partial_grid": "grid-*.grid.json",
            "circuit_ledger": "grid-*.circuits.json",
            "target_error": "*.error.json",
            "failed_cell_manifest": "*.manifest.json",
            "empty_attempts": "*.attempts.jsonl",
            "empty_responses": "*.responses.jsonl",
            "empty_judge_trails": "*.trails.jsonl",
            "empty_results": "*.jsonl",
            "parquet_placeholder": "*.parquet",
            "retained_live_attestation": "live-attestation-*.json",
        }
        for name, pattern in expected_inventory.items():
            matches = sorted(
                candidate.resolve()
                for candidate in run_root.rglob(pattern)
                if candidate.is_file() and not candidate.is_symlink()
                and (
                    name != "empty_results"
                    or not candidate.name.endswith(
                        (".attempts.jsonl", ".responses.jsonl", ".trails.jsonl")
                    )
                )
            )
            if matches != [resolved_artifacts[name]]:
                raise Gate5Error(
                    f"defense-local: conditional N/A {name} is not unique"
                )
        if list(run_root.rglob("*.complete.json")):
            raise Gate5Error(
                "defense-local: output-noncompletion N/A contains completion evidence"
            )
        for name in (
            "empty_attempts", "empty_responses", "empty_judge_trails", "empty_results"
        ):
            if resolved_artifacts[name].stat().st_size != 0:
                raise Gate5Error(
                    f"defense-local: output-noncompletion {name} is not empty"
                )
    elif (
        list(run_root.glob("grid-*.grid.json"))
        or list(run_root.rglob("*.responses.jsonl"))
        or list(run_root.rglob("*.complete.json"))
        or list(run_root.rglob("*.error.json"))
    ):
        raise Gate5Error("defense-local: conditional N/A root contains post-preload outputs")
    expected_singletons = {
        "budget_ledger": "grid-*.budget.json",
        "invocation_deadline": "request-envelope-*.deadline.json",
        "request_envelope": "request-envelope-*.request-envelope.json",
        "eligibility_plan": "eligibility-*.eligibility.json",
        "lane_projection": "lane-projection-*.lane-projection.json",
    }
    for name, pattern in expected_singletons.items():
        matches = sorted(
            candidate.resolve()
            for candidate in run_root.glob(pattern)
            if candidate.is_file() and not candidate.is_symlink()
        )
        if matches != [resolved_artifacts[name]]:
            raise Gate5Error(f"defense-local: conditional N/A {name} is not unique")

    prelim_request = prelim["envelope"]["request"]
    prelim_projection = prelim["projection"]
    prelim_arms = {
        item.get("logical_source_arm"): item
        for item in prelim_projection.get("selection", {}).get("arms", [])
        if isinstance(item, dict)
    }
    if (
        prelim_request.get("requested_target_keys")
        != ["vllm:Qwen/Qwen3-VL-8B-Instruct"]
        or set(prelim_request.get("logical_source_arms", [])) != DEFENSE_LANE_TEXT_ARMS
        or len(prelim_request.get("logical_source_arms", [])) != len(DEFENSE_LANE_TEXT_ARMS)
        or prelim_request.get("selected_attackers") != ["replay"]
        or prelim_request.get("judges") != ["rules", "guardrail"]
        or prelim_request.get("defense") != "both"
        or prelim_request.get("defense_guard") != "guardrail"
        or prelim_request.get("approximate_common_metrics") is not True
        or "jailbreakbench_benign" not in prelim_arms
    ):
        raise Gate5Error("defense-local: preliminary defense request contract changed")

    envelope_path = resolved_artifacts["request_envelope"]
    envelope, envelope_descriptor = load_stable_request_envelope_file(envelope_path)
    expected_request = {
        "execution_purpose": "diagnostic_canary",
        "requested_target_keys": ["vllm:Qwen/Qwen3-VL-8B-Instruct"],
        "logical_source_arms": ["jailbreakbench_benign"],
        "selected_attackers": ["replay"],
        "judges": ["rules", "guardrail"],
        "judge_model": None,
        "seeds": [0],
        "sample_seed": 0,
        "limit": 1,
        "max_queries": 1,
        "max_turns": 1,
        "defense": "both",
        "defense_guard": "guardrail",
        "group_keys": prelim_request.get("group_keys"),
        "quantization": "",
        "dtype": "auto",
        "dry_run": False,
        "approximate_common_metrics": True,
        "hosted_judge_data_transfer_acknowledged": False,
        "call_caps": {
            "target": 1,
            "judge": None,
            "http_attempts": None,
            "deadline_seconds": 3600,
        },
    }
    if envelope.get("request") != expected_request:
        raise Gate5Error("defense-local: conditional N/A request envelope changed")
    project_binding = envelope.get("bindings", {}).get("project_revision")
    if (
        not isinstance(project_binding, dict)
        or project_binding.get("mode") != "verified"
        or project_binding.get("expected_commit") != EXPECTED_COMMIT
        or project_binding.get("observed_commit") != EXPECTED_COMMIT
        or project_binding.get("sha256") != EXPECTED_PROJECT_RECEIPT_SHA256
    ):
        raise Gate5Error("defense-local: conditional N/A project binding changed")

    eligibility_path = resolved_artifacts["eligibility_plan"]
    eligibility, observed_eligibility_identity = load_eligibility_artifact(
        eligibility_path
    )
    execution = eligibility.get("execution", {})
    if (
        execution.get("whole_request_preflight_complete") is not True
        or execution.get("request_status") != "whole_request_compatible"
        or execution.get("units_blocked") != 0
    ):
        raise Gate5Error("defense-local: conditional N/A eligibility is not compatible")
    conditions = eligibility.get("bindings", {}).get("experiment_conditions", {}).get("values")
    if not isinstance(conditions, dict):
        raise Gate5Error("defense-local: conditional N/A eligibility lacks conditions")
    expected_conditions = {
        "execution_purpose": "diagnostic_canary",
        "judges": ["rules", "guardrail"],
        "seeds": [0],
        "sample_seed": 0,
        "limit": 1,
        "max_queries": 1,
        "max_turns": 1,
        "group_keys": prelim_request.get("group_keys"),
        "defense": "both",
        "defense_guard": "guardrail",
        "quantization": "",
        "dtype": "auto",
        "dry_run": False,
        "guardrail_model": EXPECTED_SCORE_GUARD,
        "guardrail_revision": EXPECTED_SCORE_GUARD_REVISION,
        "guardrail_device": "cuda:1",
        "defense_guardrail_model": EXPECTED_DEFENSE_GUARD,
        "defense_guardrail_revision": EXPECTED_DEFENSE_GUARD_REVISION,
        "defense_guardrail_device": "cuda:1",
    }
    if any(conditions.get(field) != expected for field, expected in expected_conditions.items()):
        raise Gate5Error("defense-local: conditional N/A eligibility conditions changed")

    projection_path = resolved_artifacts["lane_projection"]
    projection_sha = artifacts["lane_projection"]["sha256"]
    projection, _ = load_stable_lane_projection_file(projection_path, projection_sha)
    validate_lane_projection_binding(
        projection,
        eligibility_plan=eligibility,
        eligibility_artifact=observed_eligibility_identity,
    )
    validate_eligibility_envelope_binding(
        eligibility,
        envelope_descriptor,
        label="defense-local conditional N/A",
    )
    calls = projection.get("call_projection")
    expected_calls = {
        "trajectories": 1, "target_calls": 1, "judge_calls": 0,
        "local_guardrail_evaluations": 3, "http_attempts": 0,
    }
    if (
        not isinstance(calls, dict)
        or calls.get("semantics") != "conservative_complete_grid_upper_bound_v1"
        or any(type(calls.get(field)) is not int for field in expected_calls)
        or any(calls.get(field) != expected for field, expected in expected_calls.items())
        or calls.get("by_attacker") != {"replay": expected_calls}
    ):
        raise Gate5Error("defense-local: conditional N/A projected call accounting changed")
    canary_arms = projection.get("selection", {}).get("arms")
    if not isinstance(canary_arms, list) or len(canary_arms) != 1:
        raise Gate5Error("defense-local: conditional N/A projection is not one cluster")
    canary_arm = canary_arms[0]
    if canary_arm.get("logical_source_arm") != "jailbreakbench_benign":
        raise Gate5Error("defense-local: conditional N/A selected the wrong source arm")
    preliminary_source_identity, canary_source_identity = revalidate_nested_selection(
        lane="defense-local",
        prelim=prelim,
        canary_eligibility=eligibility,
        canary_projection=projection,
        arm="jailbreakbench_benign",
        project_root=project_root,
        canary_workload=None,
        observed_canary_instances=None,
    )
    validate_selected_config_relationship(
        lane="defense-local",
        preliminary_values=prelim["eligibility"]["bindings"]
        ["experiment_conditions"]["values"],
        canary_values=conditions,
        preliminary_source_identity=preliminary_source_identity,
        canary_source_identity=canary_source_identity,
    )

    deadline = read_strict_json(resolved_artifacts["invocation_deadline"])
    budget_path = resolved_artifacts["budget_ledger"]
    budget = read_strict_json(budget_path)
    budget_id = budget_path.name.removesuffix(".budget.json")
    expected_target_calls = 1 if is_output_noncompletion else 0
    if budget != {
        "budget_id": budget_id,
        "max_target_calls": 1,
        "max_judge_calls": None,
        "max_http_attempts": None,
        "deadline_epoch": budget.get("deadline_epoch"),
        "target_calls": expected_target_calls,
        "judge_calls": 0,
        "http_attempts": 0,
        "accounting_semantics": "durable_pre_call_logical_reservation_v1",
    }:
        raise Gate5Error("defense-local: conditional N/A budget ledger changed")
    deadline_epoch = budget.get("deadline_epoch")
    if (
        re.fullmatch(r"grid-[0-9a-f]{24}", budget_id) is None
        or any(
            type(budget.get(field)) is not int
            for field in ("target_calls", "judge_calls", "http_attempts")
        )
        or isinstance(deadline_epoch, bool)
        or not isinstance(deadline_epoch, (int, float))
        or not math.isfinite(float(deadline_epoch))
        or deadline != {
            "schema": "ura-invocation-deadline/1",
            "request_envelope_id": envelope.get("envelope_id"),
            "deadline_seconds": 3600,
            "deadline_epoch": deadline_epoch,
        }
    ):
        raise Gate5Error("defense-local: conditional N/A deadline binding changed")

    if is_output_noncompletion:
        expected_target = (
            "vllm:Qwen/Qwen3-VL-8B-Instruct@"
            "60595ebc30ec8e3b1d3b9e65d4943ca011c0006a+guard"
        )
        expected_message = (
            "target_call failed (LocalTargetOutputError): vLLM completion is "
            "truncated or incomplete: 'length'"
        )
        error = read_strict_json(resolved_artifacts["target_error"])
        error_fields = {
            "attacker", "call_audit", "call_budget_snapshot", "completed_attempts",
            "corpus", "exception_type", "execution_started", "grid_id", "message",
            "model_spec", "phase", "run_id", "status", "target",
        }
        if (
            not isinstance(error, dict)
            or set(error) != error_fields
            or error.get("attacker") != "replay"
            or error.get("call_audit") != {}
            or error.get("call_budget_snapshot") != budget
            or type(error.get("completed_attempts")) is not int
            or error.get("completed_attempts") != 0
            or error.get("corpus") != "jailbreakbench_benign"
            or error.get("exception_type") != "ExternalCallFailure"
            or error.get("execution_started") is not True
            or error.get("grid_id") != budget_id
            or error.get("message") != expected_message
            or error.get("model_spec") != expected_target
            or error.get("phase") != "cell_execution_or_validation"
            or error.get("status") != "error"
            or error.get("target") != expected_target
            or re.fullmatch(r"run-[0-9a-f]{24}", str(error.get("run_id", ""))) is None
        ):
            raise Gate5Error(
                "defense-local: output-noncompletion target error changed"
            )
        grid = read_strict_json(resolved_artifacts["partial_grid"])
        cells = grid.get("cells") if isinstance(grid, dict) else None
        cell = cells[0] if isinstance(cells, list) and len(cells) == 1 else None
        if (
            not isinstance(grid, dict)
            or grid.get("grid_id") != budget_id
            or grid.get("status") != "partial"
            or type(grid.get("requested_cells")) is not int
            or grid.get("requested_cells") != 1
            or type(grid.get("accounted_cells")) is not int
            or grid.get("accounted_cells") != 1
            or type(grid.get("n_errors")) is not int
            or grid.get("n_errors") != 2
            or type(grid.get("n_new_complete")) is not int
            or grid.get("n_new_complete") != 0
            or type(grid.get("n_existing_complete")) is not int
            or grid.get("n_existing_complete") != 0
            or grid.get("call_budget_snapshot") != budget
            or grid.get("engine_runtime_close") is not None
            or not isinstance(cell, dict)
            or cell.get("status") != "error"
            or cell.get("execution_started") is not True
            or cell.get("phase") != "cell_execution_or_validation"
            or cell.get("run_id") != error.get("run_id")
            or cell.get("model_spec") != expected_target
            or cell.get("target") != expected_target
        ):
            raise Gate5Error(
                "defense-local: output-noncompletion partial grid changed"
            )
        request = grid.get("request")
        if (
            not isinstance(request, dict)
            or request.get("execution_purpose") != "diagnostic_canary"
            or request.get("corpora") != ["jailbreakbench_benign"]
            or request.get("attackers") != ["replay"]
            or request.get("judges") != ["rules", "guardrail"]
            or request.get("models") != [expected_target]
            or request.get("approximate_common_metrics") is not True
            or request.get("limit") != 1
            or request.get("sample_seed") != 0
            or request.get("seeds") != [0]
            or request.get("defense") != "both"
            or request.get("defense_guard") != "guardrail"
        ):
            raise Gate5Error(
                "defense-local: output-noncompletion grid request changed"
            )
        circuits = read_strict_json(resolved_artifacts["circuit_ledger"])
        circuit_map = circuits.get("circuits") if isinstance(circuits, dict) else None
        circuit_key = f"target:{expected_target}"
        circuit = circuit_map.get(circuit_key) if isinstance(circuit_map, dict) else None
        if (
            not isinstance(circuits, dict)
            or set(circuits) != {"format_version", "grid_id", "circuits"}
            or type(circuits.get("format_version")) is not int
            or circuits.get("format_version") != 1
            or circuits.get("grid_id") != budget_id
            or not isinstance(circuit_map, dict)
            or set(circuit_map) != {circuit_key}
            or not isinstance(circuit, dict)
            or set(circuit) != {
                "budget_snapshot", "call_audit", "exception_type", "message",
                "opened_at", "phase",
            }
            or circuit.get("budget_snapshot") != budget
            or circuit.get("call_audit") != {}
            or circuit.get("exception_type") != "ExternalCallFailure"
            or circuit.get("message") != expected_message
            or circuit.get("phase") != "target_call"
            or re.fullmatch(
                r"20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\+00:00",
                str(circuit.get("opened_at", "")),
            ) is None
        ):
            raise Gate5Error(
                "defense-local: output-noncompletion circuit ledger changed"
            )

    expected_project = Path(EXPECTED_PROJECT_RECEIPT).resolve()
    expected_source = Path(EXPECTED_SOURCE_RECEIPT).resolve()
    expected_source_config = (project_root / "experiments/source-instances.json").resolve()
    if (
        resolved_artifacts["project_revision"] != expected_project
        or artifacts["project_revision"]["sha256"] != EXPECTED_PROJECT_RECEIPT_SHA256
        or resolved_artifacts["source_conformance"] != expected_source
        or artifacts["source_conformance"]["sha256"] != EXPECTED_SOURCE_RECEIPT_SHA256
        or resolved_artifacts["source_config"] != expected_source_config
    ):
        raise Gate5Error("defense-local: conditional N/A current source/project artifacts changed")

    config_path = resolved_artifacts["local_config"]
    config = read_strict_json(config_path)
    target_spec = "vllm:Qwen/Qwen3-VL-8B-Instruct"
    if set(config) != {target_spec} or not isinstance(config[target_spec], dict):
        raise Gate5Error("defense-local: conditional N/A local config changed")
    target_revision = config[target_spec].get("revision")
    if not isinstance(target_revision, str) or re.fullmatch(r"[0-9a-f]{40}", target_revision) is None:
        raise Gate5Error("defense-local: conditional N/A target revision is mutable")
    selected_configs = conditions.get("selected_config_identities")
    if (
        not isinstance(selected_configs, dict)
        or set(selected_configs) != {
            "source_config", "source_conformance", "attacker_config",
            "engine_runtime_config", "api_config", "local_config",
        }
        or not isinstance(selected_configs.get("source_config"), dict)
        or set(selected_configs["source_config"]) != {"normalized_selected_sha256"}
        or HEX64_RE.fullmatch(
            str(selected_configs["source_config"].get("normalized_selected_sha256", ""))
        ) is None
        or selected_configs.get("source_conformance") != {
            "sha256": artifacts["source_conformance"]["sha256"],
            "bytes": artifacts["source_conformance"]["bytes"],
        }
        or selected_configs.get("attacker_config") is not None
        or selected_configs.get("engine_runtime_config") is not None
        or selected_configs.get("api_config") is not None
        or not isinstance(selected_configs.get("local_config"), dict)
        or set(selected_configs["local_config"]) != {"normalized_selected_sha256"}
        or HEX64_RE.fullmatch(
            str(selected_configs["local_config"].get("normalized_selected_sha256", ""))
        ) is None
    ):
        raise Gate5Error("defense-local: conditional N/A selected config identities changed")
    retained_live_name = (
        "retained_live_attestation" if is_output_noncompletion else "live_attestation"
    )
    retained_live_descriptor = artifacts[retained_live_name]
    retained_live_path = resolved_artifacts[retained_live_name]
    live_artifacts = validate_defense_na_live_binding_shape(
        conditions.get("live_attestation"),
        attestation=retained_live_descriptor,
        filename=retained_live_path.name,
    )
    try:
        attestation_manifest, attestation_observed = load_live_attestation_file(
            resolved_artifacts["live_attestation"],
            artifacts["live_attestation"]["sha256"],
        )
    except (OSError, TypeError, ValueError) as exc:
        raise Gate5Error(
            "defense-local: conditional N/A live-attestation artifact is invalid"
        ) from exc
    if (
        is_output_noncompletion
        and (
            retained_live_path.name
            != f"live-attestation-{artifacts['live_attestation']['sha256'][:24]}.json"
            or retained_live_descriptor["sha256"]
            != artifacts["live_attestation"]["sha256"]
            or retained_live_descriptor["bytes"]
            != artifacts["live_attestation"]["bytes"]
        )
    ):
        raise Gate5Error(
            "defense-local: retained live-attestation copy differs from its source"
        )
    if (
        attestation_observed != {
            "file": resolved_artifacts["live_attestation"].name,
            "sha256": artifacts["live_attestation"]["sha256"],
            "bytes": artifacts["live_attestation"]["bytes"],
        }
        or attestation_manifest.get("attestation_id")
        != live_artifacts[0].get("attestation_id")
    ):
        raise Gate5Error("defense-local: conditional N/A live-attestation ID changed")

    bindings = value.get("bindings")
    expected_bindings = {
        "expected_commit": EXPECTED_COMMIT,
        "framework_lock_id": EXPECTED_FRAMEWORK_LOCK,
        "project_revision_sha256": EXPECTED_PROJECT_RECEIPT_SHA256,
        "source_conformance_sha256": EXPECTED_SOURCE_RECEIPT_SHA256,
        "source_config_sha256": artifacts["source_config"]["sha256"],
        "cuda_visible_devices": "0,1",
        "target": {
            "spec": target_spec,
            "revision": target_revision,
            "config_sha256": artifacts["local_config"]["sha256"],
        },
        "scoring_guard": {
            "model": EXPECTED_SCORE_GUARD,
            "revision": EXPECTED_SCORE_GUARD_REVISION,
            "device": "cuda:1",
        },
        "defense_guard": {
            "model": EXPECTED_DEFENSE_GUARD,
            "revision": EXPECTED_DEFENSE_GUARD_REVISION,
            "device": "cuda:1",
        },
    }
    if bindings != expected_bindings:
        raise Gate5Error("defense-local: conditional N/A immutable bindings changed")

    plan_path = resolved_artifacts["acquisition_plan"]
    receipt_path = resolved_artifacts["acquisition_receipt"]
    plan = load_plan(plan_path, expected_sha256=artifacts["acquisition_plan"]["sha256"])
    receipt = load_receipt(
        receipt_path,
        expected_sha256=artifacts["acquisition_receipt"]["sha256"],
        plan=plan,
    )
    acquisition_rows = [
        row for row in json_objects_from_log(resolved_artifacts["acquisition_result_log"])
        if set(row) == {"receipt_id", "receipt_sha256", "downloaded_bytes"}
    ]
    validate_zero_download_result_rows(
        acquisition_rows,
        receipt_id=receipt["receipt_id"],
        receipt_sha256=artifacts["acquisition_receipt"]["sha256"],
    )
    expected_roles = {
        ("Qwen/Qwen3-VL-8B-Instruct", target_revision, "vllm_target"),
        (EXPECTED_SCORE_GUARD, EXPECTED_SCORE_GUARD_REVISION, "guardrail_judge"),
        (EXPECTED_DEFENSE_GUARD, EXPECTED_DEFENSE_GUARD_REVISION, "defense_guardrail"),
    }
    resources = receipt.get("resources")
    if not isinstance(resources, list) or len(resources) != 3:
        raise Gate5Error("defense-local: conditional N/A acquisition resource count changed")
    observed_roles: set[tuple[object, object, object]] = set()
    expected_identities: list[dict[str, Any]] = []
    for resource in resources:
        if (
            not isinstance(resource, dict)
            or not isinstance(resource.get("roles"), list)
            or len(resource["roles"]) != 1
        ):
            raise Gate5Error("defense-local: conditional N/A acquisition resource is malformed")
        observed_roles.add((resource.get("repo_id"), resource.get("revision"), resource["roles"][0]))
        expected_identities.append({
            "resource_id": resource.get("resource_id"),
            "repo_id": resource.get("repo_id"),
            "revision": resource.get("revision"),
            "roles": resource.get("roles"),
        })
    expected_identities.sort(key=lambda item: (str(item["repo_id"]), str(item["revision"])))
    if observed_roles != expected_roles or value.get("resource_identities") != expected_identities:
        raise Gate5Error("defense-local: conditional N/A model-role identities changed")

    return {
        "value": value,
        "descriptor": descriptor(artifact_path, max_bytes=MAX_JSON_BYTES),
        "diagnostic_projection": projection,
    }


def defense_conditional_na_manifest_row(
    *, artifact: Mapping[str, Any]
) -> dict[str, Any]:
    value = artifact["value"]
    variant = defense_na_variant_from_value(value)
    return {
        "lane_id": "defense-local",
        "family": "core",
        "disposition": DEFENSE_NA_DISPOSITION,
        "reason_code": variant["reason_code"],
        "reason": variant["reason"],
        "projection": dict(DEFENSE_NA_TYPED_VALUE),
        "canary": {
            **DEFENSE_NA_TYPED_VALUE,
            "conditional_na_artifact": dict(artifact["descriptor"]),
            "call_accounting": dict(variant["call_accounting"]),
        },
        "final_preflight": dict(DEFENSE_NA_TYPED_VALUE),
        "approved_caps": dict(DEFENSE_NA_TYPED_VALUE),
    }


def validate_rr_target_runtime_terminal(
    path_value: str | Path,
    *,
    canary_control: Path,
    project_root: Path,
    work: Path,
) -> dict[str, Any]:
    artifact_path = checked_file(path_value, max_bytes=MAX_JSON_BYTES)
    if (
        artifact_path.parent != canary_control
        or artifact_path.name != "llava-rr.target-runtime-terminal.json"
    ):
        raise Gate5Error("RR target-runtime terminal is not the canonical canary artifact")
    value = read_strict_json(artifact_path)
    if set(value) != {
        "schema", "status", "disposition", "reason_code", "reason",
        "classified_at_utc", "target", "bindings", "observations",
        "call_accounting", "applies_to_lanes", "evidence_eligible",
    }:
        raise Gate5Error("RR target-runtime terminal field inventory changed")
    if (
        value.get("schema") != RR_TERMINAL_SCHEMA
        or value.get("status") != "unavailable"
        or value.get("disposition") != "unavailable"
        or value.get("reason_code") != RR_TERMINAL_REASON_CODE
        or value.get("reason") != RR_TERMINAL_REASON
        or value.get("applies_to_lanes") != list(RR_TERMINAL_LANES)
        or value.get("evidence_eligible") is not False
    ):
        raise Gate5Error("RR target-runtime terminal classification changed")
    try:
        classified = datetime.strptime(
            value.get("classified_at_utc", ""), "%Y-%m-%dT%H:%M:%SZ"
        ).replace(tzinfo=timezone.utc)
    except (TypeError, ValueError) as exc:
        raise Gate5Error("RR target-runtime terminal timestamp changed") from exc
    if classified > datetime.now(timezone.utc):
        raise Gate5Error("RR target-runtime terminal timestamp is in the future")

    target = value.get("target")
    if not isinstance(target, dict) or set(target) != {
        "spec", "model", "revision", "resource_id", "runtime",
        "runtime_version", "modalities", "configured_max_tokens", "local_config",
    }:
        raise Gate5Error("RR target-runtime terminal target fields changed")
    if (
        target.get("spec") != RR_TARGET_SPEC
        or target.get("model") != RR_TARGET_MODEL
        or target.get("revision") != RR_TARGET_REVISION
        or target.get("resource_id") != RR_TARGET_RESOURCE
        or target.get("runtime") != "vllm"
        or target.get("runtime_version") != "0.27.1"
        or target.get("modalities") != ["text", "image"]
        or type(target.get("configured_max_tokens")) is not int
        or target.get("configured_max_tokens") != 4096
    ):
        raise Gate5Error("RR target-runtime terminal target identity changed")
    local_config_path = exact_descriptor(target.get("local_config"), label="RR local config")
    if local_config_path != (project_root / "experiments" / "local-llava-rr.json").resolve():
        raise Gate5Error("RR terminal local config path changed")
    if target.get("local_config") != {
        "path": str(local_config_path),
        "sha256": RR_LOCAL_CONFIG_SHA256,
        "bytes": RR_LOCAL_CONFIG_BYTES,
    }:
        raise Gate5Error("RR terminal local config content identity changed")
    local_config = read_strict_json(local_config_path)
    local_identity = local_config.get(RR_TARGET_SPEC)
    if (
        set(local_config) != {RR_TARGET_SPEC}
        or local_identity != RR_SOURCE_LOCAL_CONFIG
        or type(local_identity.get("max_tokens")) is not int
        or type(local_identity.get("tensor_parallel_size")) is not int
        or type(local_identity.get("gpu_memory_utilization")) is not float
    ):
        raise Gate5Error("RR terminal local config bytes changed semantically")

    bindings = value.get("bindings")
    if not isinstance(bindings, dict) or set(bindings) != {
        "classification_project_commit", "framework_lock_sha256",
        "project_revision", "semantic_source_continuity", "evidence_roots",
    }:
        raise Gate5Error("RR target-runtime terminal binding fields changed")
    project_revision_path = exact_descriptor(
        bindings.get("project_revision"), label="RR current project revision"
    )
    expected_project_path = checked_file(EXPECTED_PROJECT_RECEIPT, max_bytes=MAX_JSON_BYTES)
    if (
        bindings.get("classification_project_commit") != EXPECTED_COMMIT
        or bindings.get("framework_lock_sha256") != EXPECTED_FRAMEWORK_LOCK
        or project_revision_path != expected_project_path
        or bindings["project_revision"].get("sha256") != EXPECTED_PROJECT_RECEIPT_SHA256
    ):
        raise Gate5Error("RR target-runtime terminal current bindings changed")
    continuity = bindings.get("semantic_source_continuity")
    if not isinstance(continuity, dict) or set(continuity) != {
        "observed_project_commit", "unchanged_paths", "git_diff_empty",
    }:
        raise Gate5Error("RR semantic-source continuity fields changed")
    observed_commit = continuity.get("observed_project_commit")
    continuity_paths = ["src/ura/targets/local.py", "experiments/run_matrix.py"]
    if (
        observed_commit != RR_OBSERVED_PROJECT_COMMIT
        or continuity.get("unchanged_paths") != continuity_paths
        or continuity.get("git_diff_empty") is not True
        or subprocess.run(
            ["git", "diff", "--quiet", observed_commit, EXPECTED_COMMIT, "--", *continuity_paths],
            cwd=project_root,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        ).returncode != 0
    ):
        raise Gate5Error("RR semantic-source continuity no longer holds")
    roots = bindings.get("evidence_roots")
    if not isinstance(roots, dict) or set(roots) != set(EXPECTED_RR_EVIDENCE_ROOTS):
        raise Gate5Error("RR evidence-root inventory changed")
    for key in EXPECTED_RR_EVIDENCE_ROOTS:
        validate_rr_tree_descriptor(roots[key], key=key, work=work)

    observations = value.get("observations")
    if not isinstance(observations, dict) or set(observations) != set(EXPECTED_RR_EVIDENCE_ROOTS):
        raise Gate5Error("RR observation inventory changed")
    text_observation = observations["text_vllm_4096"]
    if not isinstance(text_observation, dict) or set(text_observation) != {
        "modality", "corpus", "sample_seeds", "max_tokens", "finish_reasons",
        "stop_reasons", "successful_responses", "error_artifacts",
    }:
        raise Gate5Error("RR text observation fields changed")
    if (
        {key: text_observation.get(key) for key in (
            "modality", "corpus", "sample_seeds", "max_tokens", "finish_reasons",
            "stop_reasons", "successful_responses",
        )}
        != {
            "modality": "text", "corpus": "strongreject_official",
            "sample_seeds": [0, 1, 8], "max_tokens": 4096,
            "finish_reasons": ["length", "length", "length"],
            "stop_reasons": [None, None, None], "successful_responses": 0,
        }
        or type(text_observation.get("max_tokens")) is not int
        or type(text_observation.get("successful_responses")) is not int
        or not isinstance(text_observation.get("error_artifacts"), list)
        or len(text_observation["error_artifacts"]) != 3
    ):
        raise Gate5Error("RR text observation changed")
    image_observation = observations["image_vllm_4096"]
    if not isinstance(image_observation, dict) or set(image_observation) != {
        "modality", "corpus", "sample_seed", "max_tokens", "finish_reason",
        "stop_reason", "successful_responses", "error_artifact",
    }:
        raise Gate5Error("RR image observation fields changed")
    if (
        {key: image_observation.get(key) for key in (
            "modality", "corpus", "sample_seed", "max_tokens", "finish_reason",
            "stop_reason", "successful_responses",
        )}
        != {
            "modality": "image", "corpus": "harmbench_multimodal",
            "sample_seed": 1, "max_tokens": 4096, "finish_reason": "length",
            "stop_reason": None, "successful_responses": 0,
        }
        or any(type(image_observation.get(field)) is not int for field in (
            "sample_seed", "max_tokens", "successful_responses",
        ))
    ):
        raise Gate5Error("RR image observation changed")
    expected_error_message = (
        "target_call failed (LocalTargetOutputError): vLLM completion is "
        "truncated or incomplete: 'length'"
    )
    error_paths = [
        exact_descriptor(item, label=f"RR text error {index}")
        for index, item in enumerate(text_observation["error_artifacts"])
    ] + [exact_descriptor(image_observation["error_artifact"], label="RR image error")]
    for index, error_path in enumerate(error_paths):
        error = read_strict_json(error_path)
        expected_corpus = "strongreject_official" if index < 3 else "harmbench_multimodal"
        budget = error.get("call_budget_snapshot")
        if (
            error.get("status") != "error"
            or error.get("exception_type") != "ExternalCallFailure"
            or error.get("message") != expected_error_message
            or error.get("corpus") != expected_corpus
            or error.get("model_spec") != f"{RR_TARGET_SPEC}@{RR_TARGET_REVISION}"
            or error.get("target") != f"{RR_TARGET_SPEC}@{RR_TARGET_REVISION}"
            or error.get("completed_attempts") != 0
            or type(error.get("completed_attempts")) is not int
            or not isinstance(budget, dict)
            or budget.get("accounting_semantics")
            != "durable_pre_call_logical_reservation_v1"
            or budget.get("target_calls") != 1
            or budget.get("judge_calls") != 0
            or budget.get("http_attempts") != 0
            or any(type(budget.get(field)) is not int for field in (
                "target_calls", "judge_calls", "http_attempts",
            ))
        ):
            raise Gate5Error(f"RR error artifact classification changed: {error_path}")

    tail = observations["vllm_token_tail_512"]
    expected_tail_fields = {
        "probe_schema", "max_tokens", "prompt_tokens", "completion_tokens",
        "finish_reason", "stop_reason", "unique_completion_tokens",
        "most_common_token_counts", "special_token_ids", "special_token_counts",
        "text_sha256", "probe_log",
    }
    if not isinstance(tail, dict) or set(tail) != expected_tail_fields:
        raise Gate5Error("RR vLLM tail observation fields changed")
    tail_expected = {
        "probe_schema": "ura-engineering-token-tail-probe/1",
        "max_tokens": 512,
        "prompt_tokens": 21,
        "completion_tokens": 512,
        "finish_reason": "length",
        "stop_reason": None,
        "unique_completion_tokens": 2,
        "most_common_token_counts": [[644, 501], [22627, 11]],
        "special_token_ids": {"bos": 1, "eos": 2, "pad": 32001, "unk": 0},
        "special_token_counts": {"bos": 0, "eos": 0, "pad": 0, "unk": 0},
        "text_sha256": "277aada87524bc3de88d8b7286ea6653a7b36a94ba08d2ab7211411f9cb6ebdb",
    }
    if {key: tail.get(key) for key in tail_expected} != tail_expected:
        raise Gate5Error("RR vLLM tail observation changed")
    tail_log = exact_descriptor(tail.get("probe_log"), label="RR vLLM tail probe")
    tail_raw = engineering_probe_record(tail_log, tail_expected["probe_schema"])
    if (
        tail_raw.get("resource_id") != RR_TARGET_RESOURCE
        or tail_raw.get("prompt_tokens") != 21
        or tail_raw.get("completion_tokens") != 512
        or tail_raw.get("finish_reason") != "length"
        or tail_raw.get("stop_reason") is not None
        or tail_raw.get("unique_completion_tokens") != 2
        or tail_raw.get("most_common_token_counts") != [[644, 501], [22627, 11]]
        or tail_raw.get("tail_token_ids") != [644] * 64
        or tail_raw.get("special_token_ids") != tail_expected["special_token_ids"]
        or tail_raw.get("special_token_counts") != tail_expected["special_token_counts"]
        or tail_raw.get("text_sha256") != tail_expected["text_sha256"]
    ):
        raise Gate5Error("RR vLLM tail raw probe changed")

    reference = observations["transformers_reference_512"]
    if not isinstance(reference, dict) or set(reference) != {
        "probe_schema", "generation", "base", "rr", "probe_log",
    }:
        raise Gate5Error("RR Transformers reference fields changed")
    expected_generation = {
        "backend": "transformers", "do_sample": False, "max_new_tokens": 512, "seed": 0,
    }
    expected_base = {
        "label": "base", "resource_id": RR_BASE_RESOURCE, "prompt_tokens": 20,
        "completion_tokens": 226, "last_token_is_eos": True, "eos_token_id": 2,
        "eos_token_count": 1,
        "text_sha256": "7d966860772f8185567a9c1742536f823a49facfadaae6847a97069ddc011499",
    }
    expected_rr = {
        "label": "rr", "resource_id": RR_TARGET_RESOURCE, "prompt_tokens": 20,
        "completion_tokens": 512, "last_token_is_eos": False, "eos_token_id": 2,
        "eos_token_count": 0, "unique_completion_tokens": 2,
        "most_common_token_counts": [[644, 503], [22627, 9]],
        "text_sha256": "1f8e655ab40cbcd5a5ef23839d6845bd7aaa24ce7d693cfb29b077af590d1bbf",
    }
    if (
        reference.get("probe_schema")
        != "ura-engineering-transformers-termination-probe/1"
        or reference.get("generation") != expected_generation
        or reference.get("base") != expected_base
        or reference.get("rr") != expected_rr
    ):
        raise Gate5Error("RR Transformers reference observation changed")
    reference_log = exact_descriptor(
        reference.get("probe_log"), label="RR Transformers probe"
    )
    reference_raw = engineering_probe_record(reference_log, reference["probe_schema"])
    if (
        reference_raw.get("generation") != expected_generation
        or not isinstance(reference_raw.get("models"), list)
        or {item.get("label") for item in reference_raw["models"] if isinstance(item, dict)}
        != {"base", "rr"}
    ):
        raise Gate5Error("RR Transformers raw probe changed")

    expected_accounting = {
        "accounting_semantics": "durable_pre_call_logical_reservation_v1",
        "runner_target_call_reservations": 4,
        "vllm_diagnostic_generations": 1,
        "transformers_reference_generations": 2,
        "successful_rr_responses": 0,
        "hosted_target_calls": 0,
        "model_judge_calls": 0,
        "local_guardrail_evaluations": 0,
        "hosted_judge_calls": 0,
        "http_attempts": 0,
    }
    if (
        value.get("call_accounting") != expected_accounting
        or any(
            type(value["call_accounting"].get(field)) is not int
            for field in expected_accounting
            if field != "accounting_semantics"
        )
    ):
        raise Gate5Error("RR target-runtime terminal call accounting changed")
    return {
        "value": value,
        "descriptor": descriptor(artifact_path, max_bytes=MAX_JSON_BYTES),
    }


def rr_projection_value(prelim: Mapping[str, Any]) -> dict[str, Any]:
    projection = prelim["projection"]
    calls = projection["call_projection"]
    return {
        "projection_id": projection["projection_id"],
        "projection_artifact": prelim["projection_descriptor"],
        "eligibility_plan_id": prelim["eligibility"]["plan_id"],
        "eligibility_artifact": prelim["eligibility_descriptor"],
        "request_envelope_id": prelim["envelope"]["envelope_id"],
        "request_envelope_artifact": prelim["envelope_descriptor"],
        "selection": projection["selection"],
        "projected_calls": {
            "trajectories": calls["trajectories"],
            "target_calls": calls["target_calls"],
            "model_judge_calls": calls["judge_calls"],
            "local_guardrail_evaluations": calls["local_guardrail_evaluations"],
            "http_attempts": calls["http_attempts"],
        },
    }


def validate_rr_projection_lane(lane: str, prelim: Mapping[str, Any]) -> None:
    """Bind one completed no-call projection to its exact reviewed RR lane."""

    contract = RR_PROJECTION_CONTRACT.get(lane)
    if contract is None:
        raise Gate5Error(f"unexpected RR projection lane: {lane}")
    request = prelim["envelope"]["request"]
    requested_arms = request.get("logical_source_arms")
    selected_arms = prelim["projection"].get("selection", {}).get("arms")
    calls = prelim["projection"].get("call_projection")
    expected_call_counts = (
        {
            field: calls.get(field)
            for field in (
                "trajectories", "target_calls", "judge_calls",
                "local_guardrail_evaluations", "http_attempts",
            )
        }
        if isinstance(calls, dict)
        else None
    )
    if (
        request.get("requested_target_keys") != [RR_TARGET_SPEC]
        or not isinstance(requested_arms, list)
        or len(requested_arms) != len(contract["arms"])
        or set(requested_arms) != contract["arms"]
        or request.get("selected_attackers") != ["replay"]
        or request.get("judges") != contract["judges"]
        or request.get("defense") != "none"
        or request.get("approximate_common_metrics")
        is not contract["approximate_common_metrics"]
        or request.get("limit") != 0
        or request.get("sample_seed") != 0
        or request.get("seeds") != [0]
        or request.get("max_queries") != 1
        or request.get("max_turns") != 1
        or request.get("call_caps") != {
            "target": 400_000,
            "judge": None,
            "http_attempts": None,
            "deadline_seconds": 86_400,
        }
        or not isinstance(selected_arms, list)
        or len(selected_arms) != len(contract["arms"])
        or {
            item.get("logical_source_arm")
            for item in selected_arms
            if isinstance(item, dict)
        }
        != contract["arms"]
        or not isinstance(calls, dict)
        or calls.get("by_attacker") != {"replay": expected_call_counts}
        or calls.get("judge_calls") != 0
        or calls.get("http_attempts") != 0
        or (
            calls.get("local_guardrail_evaluations", 0) > 0
        ) != ("guardrail" in contract["judges"])
    ):
        raise Gate5Error(f"{lane}: completed RR no-call projection contract changed")


def rr_terminal_manifest_row(
    *, lane: str, prelim: Mapping[str, Any], artifact: Mapping[str, Any]
) -> dict[str, Any]:
    if lane not in RR_TERMINAL_LANES:
        raise Gate5Error(f"unexpected RR terminal lane: {lane}")
    return {
        "lane_id": lane,
        "family": "core",
        "disposition": "unavailable",
        "reason_code": RR_TERMINAL_REASON_CODE,
        "reason": RR_TERMINAL_REASON,
        "projection": {"status": "passed", "value": rr_projection_value(prelim)},
        "canary": {
            **RR_UNAVAILABLE_VALUE,
            "target_runtime_terminal_artifact": dict(artifact["descriptor"]),
        },
        "final_preflight": dict(RR_UNAVAILABLE_VALUE),
        "approved_caps": dict(RR_UNAVAILABLE_VALUE),
    }


def root_runnable_rows(
    *,
    family: str,
    projection_info: Mapping[str, Any],
    canary_info: Mapping[str, Any],
    project_root: Path,
    work: Path,
) -> list[dict[str, Any]]:
    projection_control = Path(projection_info["root"])
    canary_control = Path(canary_info["root"])
    projection_rows = indexed_status(
        read_tsv(Path(projection_info["status_path"])), "projection_id"
    )
    canary_rows = indexed_status(
        read_tsv(Path(canary_info["status_path"])), "canary_id"
    )
    if set(projection_rows) != set(canary_rows):
        raise Gate5Error(
            f"{family}: projection/canary lane inventories differ: "
            f"projection-only={sorted(set(projection_rows)-set(canary_rows))}, "
            f"canary-only={sorted(set(canary_rows)-set(projection_rows))}"
        )
    if family == "core" and set(projection_rows) != EXPECTED_CORE_LANES:
        raise Gate5Error("core controller does not contain the exact 14-lane inventory")
    if family == "bridge" and set(projection_rows) != EXPECTED_BRIDGE_LANES:
        raise Gate5Error("bridge controller does not contain the exact six runnable lanes")
    if family == "ollama" and set(projection_rows) != EXPECTED_OLLAMA_LANES:
        raise Gate5Error("Ollama controller does not contain the exact six-lane inventory")
    if family == "ollama":
        dispositions_path = projection_control / "dispositions.tsv"
        disposition_rows = read_tsv(dispositions_path)
        if any(row.get("disposition") != "completed" for row in disposition_rows):
            raise Gate5Error("Ollama controller contains a failed or blocked disposition")

    output: list[dict[str, Any]] = []
    ollama_judge_counts = {"rules_guardrail": 0, "rules": 0}
    rr_terminal_descriptors: set[tuple[str, str, int]] = set()
    rr_projection_identities: set[tuple[str, int]] = set()
    for lane in sorted(projection_rows):
        p_row = projection_rows[lane]
        c_row = canary_rows[lane]
        projection_path = find_artifact_from_control(
            control=projection_control,
            row=p_row,
            lane=lane,
            identity=p_row["projection_id"],
            kind="projection",
            work=work,
        )
        prelim = load_projection_bundle(projection_path)
        if prelim["projection"]["projection_id"] != p_row["projection_id"]:
            raise Gate5Error(f"{lane}: status/projection identity mismatch")
        calls = prelim["projection"]["call_projection"]
        supplied_prior_final: dict[str, Any] | None = None
        prior_final_id = p_row.get("final_projection_id", "").strip()
        prior_final_root = p_row.get("final_root", "").strip()
        if prior_final_id or prior_final_root:
            if PROJECTION_ID_RE.fullmatch(prior_final_id) is None or not prior_final_root:
                raise Gate5Error(f"{lane}: supplied prior-final projection fields are incomplete")
            prior_final_path = checked_file(
                Path(prior_final_root).expanduser() /
                f"{prior_final_id}.lane-projection.json",
                max_bytes=MAX_JSON_BYTES,
            )
            prior_final = load_projection_bundle(prior_final_path)
            if (
                prior_final["projection"]["selection"] != prelim["projection"]["selection"]
                or prior_final["projection"]["call_projection"] != calls
            ):
                raise Gate5Error(f"{lane}: supplied prior exact-cap final changed selection/calls")
            if prior_final["envelope"]["request"]["call_caps"] != {
                "target": calls["target_calls"],
                "judge": None,
                "http_attempts": None,
                "deadline_seconds": CALL_START_DEADLINE_SECONDS,
            }:
                raise Gate5Error(f"{lane}: supplied prior final lacks exact cap binding")
            supplied_prior_final = {
                "projection_id": prior_final_id,
                "projection_artifact": prior_final["projection_descriptor"],
                "selection_and_call_projection_parity": True,
                "exact_cap_binding": True,
                "used_as_new_finalization_receipt": False,
            }
        status_aliases = {
            "target_calls": ("target_calls", "target_cap"),
            "judge_calls": ("judge_calls", "judge_cap"),
            "local_guardrail_evaluations": ("local_guardrail_evaluations",),
            "http_attempts": ("http_attempts", "http_cap"),
        }
        for field, aliases in status_aliases.items():
            status_field = next((name for name in aliases if p_row.get(name, "") != ""), None)
            if status_field and status_int(p_row, status_field, lane=lane) != calls[field]:
                raise Gate5Error(f"{lane}: status/projection {field} mismatch")
        if lane in RR_TERMINAL_LANES:
            if family != "core":
                raise Gate5Error(f"{lane}: RR terminal escaped the core family")
            terminal_path = c_row.get("target_runtime_terminal_artifact", "").strip()
            if (
                c_row.get("disposition", "").strip() != "unavailable"
                or c_row.get("canary_id", "").strip()
                or c_row.get("conditional_na_artifact", "").strip()
                or any(c_row.get(field, "").strip() for field in (
                    "rehearsal_projection_id", "target_cap",
                    "local_guardrail_evaluations",
                    "all_configured_stages_represented", "target_status",
                    "attacker_status", "source_evaluator_status",
                ))
                or not terminal_path
            ):
                raise Gate5Error(f"{lane}: RR terminal canary status row is not exact")
            terminal = validate_rr_target_runtime_terminal(
                terminal_path,
                canary_control=canary_control,
                project_root=project_root,
                work=work,
            )
            terminal_descriptor = terminal["descriptor"]
            validate_rr_projection_lane(lane, prelim)
            projection_descriptor = prelim["projection_descriptor"]
            rr_projection_identities.add((
                projection_descriptor["sha256"], projection_descriptor["bytes"],
            ))
            rr_terminal_descriptors.add((
                terminal_descriptor["path"], terminal_descriptor["sha256"],
                terminal_descriptor["bytes"],
            ))
            output.append(rr_terminal_manifest_row(
                lane=lane, prelim=prelim, artifact=terminal,
            ))
            continue
        if c_row.get("disposition", "").strip() == DEFENSE_NA_DISPOSITION:
            if family != "core" or lane != "defense-local":
                raise Gate5Error("conditional N/A is allowed only for the core defense-local lane")
            if (
                c_row.get("canary_id", "").strip()
                or c_row.get("all_configured_stages_represented", "").strip()
                or c_row.get("target_status", "").strip()
                or c_row.get("attacker_status", "").strip()
                or c_row.get("source_evaluator_status", "").strip()
                or PROJECTION_ID_RE.fullmatch(
                    c_row.get("rehearsal_projection_id", "").strip()
                ) is None
                or status_int(c_row, "target_cap", lane=lane) != 1
                or status_int(c_row, "local_guardrail_evaluations", lane=lane) != 3
            ):
                raise Gate5Error("defense-local: conditional N/A status row is not exact")
            conditional = validate_defense_conditional_na_artifact(
                c_row["conditional_na_artifact"],
                canary_control=canary_control,
                prelim=prelim,
                project_root=project_root,
                work=work,
            )
            output.append(defense_conditional_na_manifest_row(artifact=conditional))
            continue
        canary_path = find_artifact_from_control(
            control=canary_control,
            row=c_row,
            lane=lane,
            identity=c_row["canary_id"],
            kind="canary",
            work=work,
        )
        canary = validate_canary_bundle(canary_path, expected_id=c_row["canary_id"])
        canary_roles = canary["canary"]["role_reachability"]
        canary_execution = canary_roles["execution_roles"]
        expected_status_fields = {
            "target_status": canary_execution["target"]["status"],
            "attacker_status": canary_execution["attacker"]["status"],
            "source_evaluator_status": canary_execution["source_evaluator"]["status"],
            "all_configured_stages_represented": str(
                canary_roles["all_configured_stages_represented"]
            ).lower(),
        }
        for field, expected in expected_status_fields.items():
            if c_row.get(field, "").lower() != str(expected).lower():
                raise Gate5Error(f"{lane}: canary status TSV field {field} mismatches summary")
        validate_lane_relationship(lane, prelim, canary, project_root=project_root)
        base_argv, acquisition_mode = derive_base_argv(
            lane=lane,
            family=family,
            prelim=prelim,
            canary=canary,
            project_root=project_root,
            projection_control=projection_control,
            canary_control=canary_control,
            work=work,
        )
        validate_base_argv_evidence_parity(
            base_argv, lane=lane, prelim=prelim, canary=canary,
            project_root=project_root,
        )
        request = prelim["envelope"]["request"]
        if family == "ollama":
            if request["judges"] == ["rules", "guardrail"]:
                ollama_judge_counts["rules_guardrail"] += 1
            elif request["judges"] == ["rules"]:
                ollama_judge_counts["rules"] += 1
            else:
                raise Gate5Error(f"{lane}: unsupported Ollama judge inventory")
        output.append(runnable_manifest_row(
            lane=lane,
            family=family,
            prelim=prelim,
            canary=canary,
            base_argv=base_argv,
            acquisition_mode=acquisition_mode,
            cuda_visible_devices="0,1",
            input_controller_evidence={
                "projection_root": str(projection_control),
                "projection_status_row": p_row,
                "canary_root": str(canary_control),
                "canary_status_row": c_row,
                "supplied_prior_exact_final": supplied_prior_final,
            },
        ))
    if family == "ollama" and ollama_judge_counts != {"rules_guardrail": 3, "rules": 3}:
        raise Gate5Error(
            "Ollama inventory must contain three static rules/guardrail lanes and three R-Judge rules lanes"
        )
    if family == "core" and (
        len(rr_terminal_descriptors) != 1
        or len(rr_projection_identities) != len(RR_TERMINAL_LANES)
        or {row["lane_id"] for row in output if row["lane_id"] in RR_TERMINAL_LANES}
        != set(RR_TERMINAL_LANES)
    ):
        raise Gate5Error(
            "RR terminal lanes do not preserve four distinct projections and one "
            "shared exact validated artifact"
        )
    return output


def runnable_manifest_row(
    *,
    lane: str,
    family: str,
    prelim: Mapping[str, Any],
    canary: Mapping[str, Any],
    base_argv: Sequence[str],
    acquisition_mode: str,
    cuda_visible_devices: str,
    input_controller_evidence: Mapping[str, Any],
) -> dict[str, Any]:
    if acquisition_mode not in {
        "required_zero_download", "not_applicable_no_managed_hub_resource"
    }:
        raise Gate5Error(f"{lane}: invalid acquisition_mode {acquisition_mode!r}")
    if not cuda_visible_devices or any(ord(ch) < 32 for ch in cuda_visible_devices):
        raise Gate5Error(f"{lane}: invalid CUDA_VISIBLE_DEVICES value")
    projection = prelim["projection"]
    calls = projection["call_projection"]
    canary_value = canary["canary"]
    return {
        "lane_id": lane,
        "family": family,
        "disposition": "runnable",
        "reason_code": None,
        "reason": None,
        "base_argv": list(base_argv),
        "acquisition_mode": acquisition_mode,
        "cuda_visible_devices": cuda_visible_devices,
        "preliminary": {
            "projection_id": projection["projection_id"],
            "projection_artifact": prelim["projection_descriptor"],
            "eligibility_plan_id": prelim["eligibility"]["plan_id"],
            "eligibility_artifact": prelim["eligibility_descriptor"],
            "request_envelope_id": prelim["envelope"]["envelope_id"],
            "request_envelope_artifact": prelim["envelope_descriptor"],
            "selection": projection["selection"],
            "projected_calls": {
                "trajectories": calls["trajectories"],
                "target_calls": calls["target_calls"],
                "model_judge_calls": calls["judge_calls"],
                "local_guardrail_evaluations": calls["local_guardrail_evaluations"],
                "http_attempts": calls["http_attempts"],
            },
        },
        "canary": {
            "canary_id": canary_value["canary_id"],
            "artifact": canary["canary_descriptor"],
            "results_root": str(canary["results_root"]),
            "eligibility_artifact": descriptor(canary["eligibility_path"], max_bytes=MAX_JSON_BYTES),
            "grid_artifact": descriptor(canary["grid_path"], max_bytes=MAX_JSON_BYTES),
            "live_attestation": canary["live_attestation"],
            "stage_acceptance_policy": canary["acceptance_policy"],
            "approximate_proxy": canary.get("approximate_proxy", {
                "status": "N/A",
                "value": None,
                "reason": "lane has no admitted common-metric-ineligible proxy stratum",
            }),
            "defense_judge_audit": canary.get("defense_judge_audit", {
                "status": "N/A",
                "value": None,
                "reason": "lane does not use the model-backed local defense",
            }),
            "evidence_class": "live_diagnostic",
            "campaign_authorized": False,
            "empirical_benchmark_evidence": False,
            "workload": canary_value["workload"],
            "artifact_storage": canary_value["artifact_storage"],
            "latency_observations": canary_value["latency_observations"],
            "call_accounting": canary_value["call_accounting"],
            "decision_support": canary_value["decision_support"],
            "benign_decision_coverage": {
                "status": "CANNOT-VERIFY",
                "value": None,
                "reason": "ura-lane-canary/1 decision support is not stratified by benignness",
            },
            "role_reachability": canary_value["role_reachability"],
            "limitations": canary_value["limitations"],
        },
        "approved_caps": {
            "status": "approved",
            "target_calls": calls["target_calls"],
            "model_judge_calls": 0,
            "http_attempts": 0,
            "local_guardrail_evaluations": {
                "status": "projected_workload_not_a_runner_call_cap",
                "value": calls["local_guardrail_evaluations"],
            },
            "call_start_deadline_seconds": CALL_START_DEADLINE_SECONDS,
            "measured_lane_wall_time_seconds": MEASURED_LANE_WALL_TIME_SECONDS,
            "retained_output_policy_bytes": EXTERNAL_RETAINED_OUTPUT_POLICY_BYTES,
            "retained_output_policy_semantics": "external_operator_policy_only_not_runner_enforced",
        },
        "input_controller_evidence": dict(input_controller_evidence),
        "final_preflight": {"status": "pending_execution", "value": None},
    }


def explicit_manifest_rows(
    *, manifest_path: Path, project_root: Path
) -> tuple[list[dict[str, Any]], dict[str, Any]]:
    value = read_strict_json(manifest_path)
    if value.get("schema") != INPUT_MANIFEST_SCHEMA:
        raise Gate5Error(f"explicit manifest schema must be {INPUT_MANIFEST_SCHEMA}")
    if value.get("inventory_complete") is not True:
        raise Gate5Error("explicit manifest must assert inventory_complete=true")
    raw_lanes = value.get("lanes")
    if not isinstance(raw_lanes, list) or not raw_lanes:
        raise Gate5Error("explicit manifest requires a non-empty lanes array")
    rows: list[dict[str, Any]] = []
    for raw in raw_lanes:
        if not isinstance(raw, dict):
            raise Gate5Error("explicit manifest lane must be an object")
        disposition = str(raw.get("disposition", "")).strip().lower().replace("-", "_")
        if disposition != "runnable":
            lane = str(raw.get("lane_id") or raw.get("lane") or "").strip()
            if lane in RR_TERMINAL_LANES:
                validate_rr_terminal_manifest_row(raw, validate_files=True)
                rows.append(dict(raw))
                continue
            rows.append(terminal_row(raw))
            continue
        lane = str(raw.get("lane_id") or "").strip()
        if LANE_RE.fullmatch(lane) is None:
            raise Gate5Error(f"invalid explicit runnable lane id: {lane!r}")
        projection_path = checked_file(raw.get("projection_artifact", ""), max_bytes=MAX_JSON_BYTES)
        canary_path = checked_file(raw.get("canary_artifact", ""), max_bytes=MAX_JSON_BYTES)
        prelim = load_projection_bundle(projection_path)
        canary_id = str(raw.get("canary_id") or read_strict_json(canary_path).get("canary_id") or "")
        if CANARY_ID_RE.fullmatch(canary_id) is None:
            raise Gate5Error(f"{lane}: explicit manifest has invalid canary_id")
        canary = validate_canary_bundle(canary_path, expected_id=canary_id)
        validate_lane_relationship(lane, prelim, canary, project_root=project_root)
        base_argv = validate_base_argv(raw.get("base_argv"), lane=lane)
        acquisition_mode = str(raw.get("acquisition_mode", ""))
        validate_base_argv_evidence_parity(
            base_argv, lane=lane, prelim=prelim, canary=canary,
            project_root=project_root,
        )
        explicit_request = prelim["envelope"]["request"]
        explicit_target = explicit_request["requested_target_keys"][0]
        expected_acquisition_mode = (
            "not_applicable_no_managed_hub_resource"
            if explicit_target.startswith("ollama:")
            and "guardrail" not in explicit_request["judges"]
            and not (
                explicit_request["defense"] != "none"
                and explicit_request["defense_guard"] == "guardrail"
            )
            else "required_zero_download"
        )
        if acquisition_mode != expected_acquisition_mode:
            raise Gate5Error(f"{lane}: explicit acquisition mode differs from selected model roles")
        rows.append(runnable_manifest_row(
            lane=lane,
            family=str(raw.get("family") or "operator_manifest"),
            prelim=prelim,
            canary=canary,
            base_argv=base_argv,
            acquisition_mode=acquisition_mode,
            cuda_visible_devices=str(raw.get("cuda_visible_devices") or "0,1"),
            input_controller_evidence={
                "explicit_manifest": descriptor(manifest_path, max_bytes=MAX_JSON_BYTES),
            },
        ))
    return rows, {
        "mode": "explicit_lane_manifest",
        "manifest": descriptor(manifest_path, max_bytes=MAX_JSON_BYTES),
    }


def merge_builtin_terminal_rows(rows: list[dict[str, Any]]) -> list[dict[str, Any]]:
    output = {row["lane_id"]: row for row in rows}
    if len(output) != len(rows):
        raise Gate5Error("lane inventory contains duplicate identifiers")
    for raw in (
        *EXPECTED_OLLAMA_TRANSPORT_TERMINAL_ROWS,
        *BUILTIN_TERMINAL_ROWS,
        *NATIVE_ENGINE_ROWS,
    ):
        row = terminal_row(raw)
        existing = output.get(row["lane_id"])
        if existing is not None and existing != row:
            raise Gate5Error(f"built-in terminal lane conflicts with supplied row: {row['lane_id']}")
        output[row["lane_id"]] = row
    if not any(row["disposition"] == "runnable" for row in output.values()):
        raise Gate5Error("complete Gate-5 inventory has no runnable lanes")
    if any(row["disposition"] not in ALLOWED_DISPOSITIONS for row in output.values()):
        raise Gate5Error("lane inventory contains a non-terminal disposition")
    return [output[key] for key in sorted(output)]


def expected_terminal_inventory() -> dict[str, dict[str, Any]]:
    expected: dict[str, dict[str, Any]] = {}
    for raw in (
        *EXPECTED_BRIDGE_TERMINAL_ROWS,
        *EXPECTED_OLLAMA_TRANSPORT_TERMINAL_ROWS,
        *BUILTIN_TERMINAL_ROWS,
        *NATIVE_ENGINE_ROWS,
    ):
        row = terminal_row(raw)
        if row["lane_id"] in expected:
            raise Gate5Error(f"internal terminal contract duplicates {row['lane_id']!r}")
        expected[row["lane_id"]] = row
    return expected


def validate_rr_terminal_manifest_row(
    raw: Mapping[str, Any], *, validate_files: bool
) -> tuple[tuple[str, str, int], tuple[str, int]]:
    if set(raw) != {
        "lane_id", "family", "disposition", "reason_code", "reason",
        "projection", "canary", "final_preflight", "approved_caps",
    }:
        raise Gate5Error("RR terminal manifest row fields changed")
    lane = raw.get("lane_id")
    if (
        lane not in RR_TERMINAL_LANES
        or raw.get("family") != "core"
        or raw.get("disposition") != "unavailable"
        or raw.get("reason_code") != RR_TERMINAL_REASON_CODE
        or raw.get("reason") != RR_TERMINAL_REASON
        or raw.get("final_preflight") != RR_UNAVAILABLE_VALUE
        or raw.get("approved_caps") != RR_UNAVAILABLE_VALUE
    ):
        raise Gate5Error(f"{lane}: RR terminal manifest classification changed")
    projection = raw.get("projection")
    if (
        not isinstance(projection, dict)
        or set(projection) != {"status", "value"}
        or projection.get("status") != "passed"
        or not isinstance(projection.get("value"), dict)
    ):
        raise Gate5Error(f"{lane}: RR passed projection is absent")
    projection_value = projection["value"]
    if set(projection_value) != {
        "projection_id", "projection_artifact", "eligibility_plan_id",
        "eligibility_artifact", "request_envelope_id",
        "request_envelope_artifact", "selection", "projected_calls",
    }:
        raise Gate5Error(f"{lane}: RR passed projection fields changed")
    if (
        not isinstance(projection_value.get("projection_id"), str)
        or PROJECTION_ID_RE.fullmatch(projection_value["projection_id"]) is None
        or not isinstance(projection_value.get("eligibility_plan_id"), str)
        or re.fullmatch(r"eligibility-[0-9a-f]{24}", projection_value["eligibility_plan_id"])
        is None
        or not isinstance(projection_value.get("request_envelope_id"), str)
        or re.fullmatch(
            r"request-envelope-[0-9a-f]{24}", projection_value["request_envelope_id"]
        ) is None
        or not isinstance(projection_value.get("selection"), dict)
    ):
        raise Gate5Error(f"{lane}: RR passed projection identities changed")
    calls = projection_value.get("projected_calls")
    if (
        not isinstance(calls, dict)
        or set(calls) != {
            "trajectories", "target_calls", "model_judge_calls",
            "local_guardrail_evaluations", "http_attempts",
        }
        or any(isinstance(calls.get(field), bool) or not isinstance(calls.get(field), int)
               for field in calls)
        or calls["trajectories"] <= 0
        or calls["target_calls"] <= 0
        or calls["model_judge_calls"] != 0
        or calls["http_attempts"] != 0
        or calls["local_guardrail_evaluations"] < 0
    ):
        raise Gate5Error(f"{lane}: RR passed projection call accounting changed")
    canary = raw.get("canary")
    if (
        not isinstance(canary, dict)
        or set(canary) != {"status", "value", "target_runtime_terminal_artifact"}
        or {"status": canary.get("status"), "value": canary.get("value")}
        != RR_UNAVAILABLE_VALUE
    ):
        raise Gate5Error(f"{lane}: RR unavailable canary fields changed")
    artifact = canary.get("target_runtime_terminal_artifact")
    if not isinstance(artifact, dict) or set(artifact) != {"path", "sha256", "bytes"}:
        raise Gate5Error(f"{lane}: RR terminal artifact descriptor changed")
    if (
        not isinstance(artifact.get("path"), str)
        or not Path(artifact["path"]).is_absolute()
        or not isinstance(artifact.get("sha256"), str)
        or HEX64_RE.fullmatch(artifact["sha256"]) is None
        or isinstance(artifact.get("bytes"), bool)
        or not isinstance(artifact.get("bytes"), int)
        or artifact["bytes"] <= 0
    ):
        raise Gate5Error(f"{lane}: RR terminal artifact descriptor values changed")
    if validate_files:
        artifact_path = exact_descriptor(artifact, label=f"{lane} RR terminal")
        artifact_value = read_strict_json(artifact_path)
        if (
            artifact_value.get("schema") != RR_TERMINAL_SCHEMA
            or artifact_value.get("reason_code") != RR_TERMINAL_REASON_CODE
            or artifact_value.get("reason") != RR_TERMINAL_REASON
            or artifact_value.get("applies_to_lanes") != list(RR_TERMINAL_LANES)
            or artifact_value.get("evidence_eligible") is not False
        ):
            raise Gate5Error(f"{lane}: RR terminal descriptor points to wrong evidence")
    projection_artifact = projection_value.get("projection_artifact")
    eligibility_artifact = projection_value.get("eligibility_artifact")
    request_envelope_artifact = projection_value.get("request_envelope_artifact")
    if (
        not isinstance(projection_artifact, dict)
        or set(projection_artifact) != {"path", "file", "sha256", "bytes"}
        or projection_artifact.get("file")
        != f"{projection_value['projection_id']}.lane-projection.json"
        or Path(str(projection_artifact.get("path", ""))).name
        != projection_artifact.get("file")
        or not isinstance(eligibility_artifact, dict)
        or set(eligibility_artifact) != {"path", "sha256", "bytes"}
        or not isinstance(request_envelope_artifact, dict)
        or set(request_envelope_artifact)
        != {"path", "envelope_id", "file", "sha256", "bytes"}
        or request_envelope_artifact.get("envelope_id")
        != projection_value["request_envelope_id"]
        or request_envelope_artifact.get("file")
        != f"{projection_value['request_envelope_id']}.request-envelope.json"
        or Path(str(request_envelope_artifact.get("path", ""))).name
        != request_envelope_artifact.get("file")
    ):
        raise Gate5Error(f"{lane}: RR projection support descriptor fields changed")
    for key, item in (
        ("projection_artifact", projection_artifact),
        ("eligibility_artifact", eligibility_artifact),
        ("request_envelope_artifact", request_envelope_artifact),
    ):
        if (
            not isinstance(item.get("path"), str)
            or not Path(item["path"]).is_absolute()
            or not isinstance(item.get("sha256"), str)
            or HEX64_RE.fullmatch(item["sha256"]) is None
            or type(item.get("bytes")) is not int
            or item["bytes"] <= 0
        ):
            raise Gate5Error(f"{lane}: RR {key} descriptor values changed")
    if validate_files:
        exact_descriptor(
            eligibility_artifact, label=f"{lane} RR eligibility_artifact"
        )
        projection_path = checked_file(
            projection_artifact["path"], max_bytes=MAX_JSON_BYTES
        )
        prelim = load_projection_bundle(projection_path)
        validate_rr_projection_lane(str(lane), prelim)
        if rr_projection_value(prelim) != projection_value:
            raise Gate5Error(f"{lane}: RR passed projection differs from retained bytes")
    terminal_identity = (artifact["path"], artifact["sha256"], artifact["bytes"])
    projection_identity = (
        projection_artifact["sha256"], projection_artifact["bytes"]
    )
    return terminal_identity, projection_identity


def validate_exact_inventory(
    rows: Sequence[Mapping[str, Any]], *, validate_files: bool = True
) -> None:
    """Require the reviewed 46-row Gate-5 inventory in every input mode."""

    by_id: dict[str, Mapping[str, Any]] = {}
    for raw in rows:
        if not isinstance(raw, Mapping):
            raise Gate5Error("Gate-5 inventory row is not an object")
        lane = raw.get("lane_id")
        if not isinstance(lane, str) or LANE_RE.fullmatch(lane) is None:
            raise Gate5Error(f"Gate-5 inventory has an invalid lane id: {lane!r}")
        if lane in by_id:
            raise Gate5Error(f"Gate-5 inventory duplicates lane id {lane!r}")
        by_id[lane] = raw

    terminal = expected_terminal_inventory()
    expected_ids = set(EXPECTED_RUNNABLE_FAMILIES) | set(terminal) | set(RR_TERMINAL_LANES)
    observed_ids = set(by_id)
    if observed_ids != expected_ids or len(rows) != 46:
        raise Gate5Error(
            "Gate-5 inventory is not the exact reviewed 46 rows: "
            f"missing={sorted(expected_ids-observed_ids)}, "
            f"extra={sorted(observed_ids-expected_ids)}, rows={len(rows)}"
        )

    for lane, family in EXPECTED_RUNNABLE_FAMILIES.items():
        row = by_id[lane]
        if lane == "defense-local" and row.get("disposition") == DEFENSE_NA_DISPOSITION:
            validate_defense_conditional_na_manifest_row(row)
            continue
        if row.get("family") != family or row.get("disposition") != "runnable":
            raise Gate5Error(
                f"{lane}: runnable family/disposition differs from the reviewed contract"
            )
        if row.get("reason_code") is not None or row.get("reason") is not None:
            raise Gate5Error(f"{lane}: runnable row unexpectedly carries a terminal reason")

    for lane, expected in terminal.items():
        if dict(by_id[lane]) != expected:
            raise Gate5Error(
                f"{lane}: terminal disposition, reason code, reason, or typed N/A fields "
                "differ from the reviewed contract"
            )

    rr_descriptors: set[tuple[str, str, int]] = set()
    rr_projection_identities: set[tuple[str, int]] = set()
    for lane in RR_TERMINAL_LANES:
        terminal_identity, projection_identity = validate_rr_terminal_manifest_row(
            by_id[lane], validate_files=validate_files
        )
        rr_descriptors.add(terminal_identity)
        rr_projection_identities.add(projection_identity)
    if len(rr_descriptors) != 1:
        raise Gate5Error("RR terminal manifest rows do not share one evidence artifact")
    if len(rr_projection_identities) != len(RR_TERMINAL_LANES):
        raise Gate5Error("RR manifest does not preserve four distinct passed projections")

    family_counts = {
        "runnable": sum(row.get("disposition") == "runnable" for row in rows),
        "conditional_na": sum(
            row.get("disposition") == DEFENSE_NA_DISPOSITION for row in rows
        ),
        "bridge_terminal": sum(lane in EXPECTED_BRIDGE_TERMINALS for lane in by_id),
        "ollama_transport_terminal": sum(
            lane in EXPECTED_OLLAMA_TRANSPORT_TERMINALS for lane in by_id
        ),
        "target_runtime_terminal": sum(lane in RR_TERMINAL_LANES for lane in by_id),
        "portfolio_terminal": sum(lane in {r["lane_id"] for r in BUILTIN_TERMINAL_ROWS} for lane in by_id),
        "native_terminal": sum(lane in {r["lane_id"] for r in NATIVE_ENGINE_ROWS} for lane in by_id),
    }
    allowed_counts = (
        {
            "runnable": 22, "conditional_na": 0, "bridge_terminal": 3,
            "ollama_transport_terminal": 3, "target_runtime_terminal": 4,
            "portfolio_terminal": 5, "native_terminal": 9,
        },
        {
            "runnable": 21, "conditional_na": 1, "bridge_terminal": 3,
            "ollama_transport_terminal": 3, "target_runtime_terminal": 4,
            "portfolio_terminal": 5, "native_terminal": 9,
        },
    )
    if family_counts not in allowed_counts:
        raise Gate5Error(f"Gate-5 inventory category counts changed: {family_counts}")


def failed_attestation_tsv_contract_self_test() -> dict[str, Any]:
    """Prove a canonical empty retry ledger is valid but header drift is not."""

    with tempfile.TemporaryDirectory(prefix="ura-gate5-empty-attestation-tsv-") as raw_tmp:
        path = Path(raw_tmp).resolve() / "attestation-failures.tsv"
        header = "\t".join(FAILED_ATTESTATION_TSV_FIELDS)
        canonical = (header + "\n").encode("ascii")
        path.write_bytes(canonical)
        if read_failed_attestation_tsv(path) != []:
            raise Gate5Error("canonical empty failed-attestation ledger was not empty")

        mutations = {
            "reordered_empty_ledger_header": (
                "modality\ttarget\tarm\tsample_seed\trun_root\texit_code\n"
            ).encode("ascii"),
            "crlf_empty_ledger_header": (header + "\r\n").encode("ascii"),
            "blank_row_after_empty_ledger_header": (header + "\n\n").encode("ascii"),
        }
        rejected: list[str] = []
        for name, payload in mutations.items():
            path.write_bytes(payload)
            try:
                read_failed_attestation_tsv(path)
            except Gate5Error:
                rejected.append(name)
            else:
                raise Gate5Error(
                    f"empty failed-attestation TSV mutation did not fail closed: {name}"
                )
        path.write_bytes(canonical)
        if read_failed_attestation_tsv(path) != []:
            raise Gate5Error("restored empty failed-attestation ledger was not empty")
        return {
            "schema": "ura-phase5-empty-failed-attestation-tsv-self-test/1",
            "status": "passed",
            "canonical_empty_rows": 0,
            "rejected_mutations": rejected,
        }


def failed_attestation_contract_self_test() -> dict[str, Any]:
    """Prove failed paid-response evidence cannot be deleted or rolled back."""

    with tempfile.TemporaryDirectory(prefix="ura-gate5-failed-attestation-") as raw_tmp:
        work = Path(raw_tmp).resolve() / "work"
        attestation_root = work / "runs" / "thesis" / "attestation"
        run_root = (
            attestation_root
            / "llava-base-text-seed0-20260823T001917Z"
            / "run"
        )
        run_root.mkdir(parents=True)
        grid_id = "grid-" + "a" * 24
        run_id = "run-" + "b" * 24
        model = (
            "vllm:llava-hf/llava-v1.6-mistral-7b-hf@"
            + "c" * 40
        )
        budget = {
            "budget_id": grid_id,
            "max_target_calls": 1,
            "max_judge_calls": None,
            "max_http_attempts": None,
            "deadline_epoch": 1_900_000_000.0,
            "target_calls": 1,
            "judge_calls": 0,
            "http_attempts": 0,
            "accounting_semantics": "durable_pre_call_logical_reservation_v1",
        }
        budget_path = run_root / f"{grid_id}.budget.json"
        budget_path.write_bytes(canonical_bytes(budget))
        response_checkpoint_path = run_root / "cell.responses.checkpoint.jsonl"
        response_checkpoint = {
            "schema_version": SCHEMA_VERSION,
            "run_id": run_id,
            "attempt": {
                "id": "attempt-1",
                "datapoint_id": "probe-1",
                "attacker": "replay",
                "strategy": "replay",
                "target": model,
                "turn_index": 0,
                "rendered_input": [{"role": "user", "content": "probe"}],
                "seed": 0,
                "params": {},
                "run_id": run_id,
            },
            "response": {
                "attempt_id": "attempt-1",
                "target": model,
                "output_turns": [{"role": "assistant", "content": "answer"}],
                "tool_trace": [],
                "latency_ms": 1.0,
                "tokens": {"completion": 1},
                "raw": {},
                "run_id": run_id,
            },
            "budget_after_target": budget,
        }
        response_checkpoint_path.write_bytes(canonical_bytes(response_checkpoint))
        error_path = run_root / "cell.error.json"
        error = {
            "status": "error",
            "grid_id": grid_id,
            "run_id": run_id,
            "phase": "cell_execution_or_validation",
            "corpus": "strongreject_official",
            "model_spec": model,
            "target": model,
            "attacker": "replay",
            "exception_type": "ExternalCallFailure",
            "message": "judge cascade produced no authoritative verdict",
            "completed_attempts": 0,
            "call_budget_snapshot": budget,
            "call_audit": {},
            "execution_started": True,
        }
        error_path.write_bytes(canonical_bytes(error))
        error_desc = descriptor(error_path)
        circuit_path = run_root / f"{grid_id}.circuits.json"
        circuit_path.write_bytes(canonical_bytes({
            "format_version": 1,
            "grid_id": grid_id,
            "circuits": {"judge": {
                "opened_at": "2026-08-23T00:00:00+00:00",
                "phase": "judge_call",
                "exception_type": "ExternalCallFailure",
                "message": "judge cascade produced no authoritative verdict",
                "call_audit": {},
                "budget_snapshot": budget,
            }},
        }))
        request = {
            "execution_purpose": "attestation_probe",
            "attestation_probe": True,
            "dry_run": False,
            "attackers": ["replay"],
            "corpora": ["strongreject_official"],
            "judges": ["rules"],
            "limit": 1,
            "sample_seed": 0,
            "seeds": [0],
            "max_queries": 1,
            "max_turns": 1,
            "models": [model],
            "project_revision": {
                "expected_commit": EXPECTED_COMMIT,
                "observed_commit": EXPECTED_COMMIT,
            },
            "global_call_budget": {
                "accounting_semantics": "durable_pre_call_logical_reservation_v1",
                "call_start_deadline_seconds_from_first_invocation": 3600,
                "max_http_attempts": None,
                "max_judge_calls": None,
                "max_target_calls": 1,
            },
            "call_projection": {
                "semantics": "conservative_complete_grid_upper_bound_v1",
                "trajectories": 1,
                "target_calls": 1,
                "judge_calls": 0,
                "local_guardrail_evaluations": 0,
                "http_attempts": 0,
            },
        }
        grid_path = run_root / f"{grid_id}.grid.json"
        grid_path.write_bytes(canonical_bytes({
            "status": "partial",
            "grid_id": grid_id,
            "started_at": "2026-08-23T00:00:00+00:00",
            "finished_at": "2026-08-23T00:00:01+00:00",
            "request": request,
            "requested_cells": 1,
            "accounted_cells": 1,
            "n_new_complete": 0,
            "n_existing_complete": 0,
            "n_errors": 2,
            "call_budget_snapshot": budget,
            "modality_coverage_plan": {},
            "modality_coverage_result": {},
            "engine_runtime_close": {},
            "cells": [{
                "corpus": "strongreject_official",
                "model_spec": model,
                "target": model,
                "attacker": "replay",
                "run_id": run_id,
                "status": "error",
                "phase": "cell_execution_or_validation",
                "execution_started": True,
                "error_artifact": {
                    "file": error_path.name,
                    "sha256": error_desc["sha256"],
                    "bytes": error_desc["bytes"],
                },
            }],
        }))
        row = {
            "target": "llava-base",
            "modality": "text",
            "arm": "strongreject_official",
            "sample_seed": "0",
            "run_root": str(run_root),
            "exit_code": "1",
        }
        baseline = validate_failed_attestation_candidate(row, work=work)
        retained = {
            path.name: path.read_bytes()
            for path in run_root.iterdir()
            if path.is_file()
        }

        def restore() -> None:
            for path in run_root.iterdir():
                if path.is_file() and path.name not in retained:
                    path.unlink()
            for name, payload in retained.items():
                (run_root / name).write_bytes(payload)

        restore()
        response_checkpoint_path.unlink()
        target_circuit = strict_json_loads(circuit_path.read_bytes())
        if not isinstance(target_circuit, dict):
            raise Gate5Error("self-test target-stage circuit is not an object")
        target_circuit["circuits"] = {
            f"target:{model}": {
                "opened_at": "2026-08-23T00:00:00+00:00",
                "phase": "target_call",
                "exception_type": "ExternalCallFailure",
                "message": "target call failed after durable reservation",
                "call_audit": {},
                "budget_snapshot": budget,
            }
        }
        circuit_path.write_bytes(canonical_bytes(target_circuit))
        target_stage = validate_failed_attestation_candidate(row, work=work)
        if (
            target_stage["runner_failure_stage"]
            != "target_call_after_durable_reservation"
            or target_stage["call_accounting"]["target_calls"] != 1
            or target_stage["call_accounting"][
                "checkpointed_target_responses"
            ]
            != 0
        ):
            raise Gate5Error("legitimate target-stage reservation failure was not retained")
        restore()

        def mutate_json(path: Path, field: str) -> None:
            value = strict_json_loads(path.read_bytes())
            if not isinstance(value, dict):
                raise Gate5Error("self-test mutation input is not an object")
            if field == "budget_target_calls":
                value["target_calls"] = 0
            elif field == "checkpoint_target_calls":
                value["budget_after_target"]["target_calls"] = 0
            elif field == "grid_target_calls":
                value["call_budget_snapshot"]["target_calls"] = 0
            elif field == "circuit_target_calls":
                value["circuits"]["judge"]["budget_snapshot"]["target_calls"] = 0
            else:
                raise Gate5Error(f"unknown self-test mutation {field}")
            path.write_bytes(canonical_bytes(value))

        mutations = {
            "deleted_budget_ledger": lambda: budget_path.unlink(),
            "rolled_back_budget_target_calls": lambda: mutate_json(
                budget_path, "budget_target_calls"
            ),
            "deleted_paid_response_checkpoint": lambda: response_checkpoint_path.unlink(),
            "rolled_back_checkpoint_target_calls": lambda: mutate_json(
                response_checkpoint_path, "checkpoint_target_calls"
            ),
            "rolled_back_grid_target_calls": lambda: mutate_json(
                grid_path, "grid_target_calls"
            ),
            "deleted_circuit_ledger": lambda: circuit_path.unlink(),
            "rolled_back_circuit_target_calls": lambda: mutate_json(
                circuit_path, "circuit_target_calls"
            ),
            "deleted_circuit_and_paid_response": lambda: (
                circuit_path.unlink(), response_checkpoint_path.unlink()
            ),
        }
        rejected: list[str] = []
        for name, mutate in mutations.items():
            restore()
            mutate()
            try:
                validate_failed_attestation_candidate(row, work=work)
            except Gate5Error:
                rejected.append(name)
            else:
                raise Gate5Error(
                    f"failed live-attestation mutation did not fail closed: {name}"
                )
        restore()
        validate_failed_attestation_candidate(row, work=work)
        return {
            "schema": "ura-phase5-failed-live-attestation-contract-self-test/1",
            "status": "passed",
            "call_accounting": baseline["call_accounting"],
            "target_stage_call_accounting": target_stage["call_accounting"],
            "rejected_mutations": rejected,
        }


def inventory_contract_self_test() -> dict[str, Any]:
    """Mutation checks proving every reviewed inventory dimension fails closed."""

    import copy

    shared_rr_artifact = {
        "path": str(Path.cwd().resolve() / "llava-rr.target-runtime-terminal.json"),
        "sha256": "9" * 64,
        "bytes": 1,
    }
    rr_rows = []
    for index, lane in enumerate(RR_TERMINAL_LANES, start=1):
        token = format(index, "x") * 24
        descriptor_fixture = {
            "path": str(
                Path.cwd().resolve()
                / f"lane-projection-{token}.lane-projection.json"
            ),
            "file": f"lane-projection-{token}.lane-projection.json",
            "sha256": format(index + 9, "x") * 64,
            "bytes": 1,
        }
        envelope_descriptor_fixture = {
            "path": str(
                Path.cwd().resolve()
                / f"request-envelope-{token}.request-envelope.json"
            ),
            "envelope_id": f"request-envelope-{token}",
            "file": f"request-envelope-{token}.request-envelope.json",
            "sha256": format(index + 4, "x") * 64,
            "bytes": 1,
        }
        rr_rows.append({
            "lane_id": lane,
            "family": "core",
            "disposition": "unavailable",
            "reason_code": RR_TERMINAL_REASON_CODE,
            "reason": RR_TERMINAL_REASON,
            "projection": {
                "status": "passed",
                "value": {
                    "projection_id": f"lane-projection-{token}",
                    "projection_artifact": dict(descriptor_fixture),
                    "eligibility_plan_id": f"eligibility-{token}",
                    "eligibility_artifact": {
                        "path": str(
                            Path.cwd().resolve() / f"{lane}.eligibility.json"
                        ),
                        "sha256": format(index + 5, "x") * 64,
                        "bytes": 1,
                    },
                    "request_envelope_id": f"request-envelope-{token}",
                    "request_envelope_artifact": envelope_descriptor_fixture,
                    "selection": {"self_test": lane},
                    "projected_calls": {
                        "trajectories": 1,
                        "target_calls": 1,
                        "model_judge_calls": 0,
                        "local_guardrail_evaluations": 0,
                        "http_attempts": 0,
                    },
                },
            },
            "canary": {
                **RR_UNAVAILABLE_VALUE,
                "target_runtime_terminal_artifact": dict(shared_rr_artifact),
            },
            "final_preflight": dict(RR_UNAVAILABLE_VALUE),
            "approved_caps": dict(RR_UNAVAILABLE_VALUE),
        })
    correct = [
        {
            "lane_id": lane,
            "family": family,
            "disposition": "runnable",
            "reason_code": None,
            "reason": None,
        }
        for lane, family in sorted(EXPECTED_RUNNABLE_FAMILIES.items())
    ] + rr_rows + [dict(row) for _, row in sorted(expected_terminal_inventory().items())]
    validate_exact_inventory(correct, validate_files=False)
    conditional = copy.deepcopy(correct)
    defense_index = next(
        index for index, row in enumerate(conditional)
        if row["lane_id"] == "defense-local"
    )
    conditional[defense_index] = {
        "lane_id": "defense-local",
        "family": "core",
        "disposition": DEFENSE_NA_DISPOSITION,
        "reason_code": DEFENSE_NA_REASON_CODE,
        "reason": DEFENSE_NA_REASON,
        "projection": dict(DEFENSE_NA_TYPED_VALUE),
        "canary": {
            **DEFENSE_NA_TYPED_VALUE,
            "conditional_na_artifact": {
                "path": str(Path.cwd().resolve() / "defense-local.conditional-na.json"),
                "sha256": "0" * 64,
                "bytes": 1,
            },
            "call_accounting": dict(DEFENSE_NA_CALL_ACCOUNTING),
        },
        "final_preflight": dict(DEFENSE_NA_TYPED_VALUE),
        "approved_caps": dict(DEFENSE_NA_TYPED_VALUE),
    }
    validate_exact_inventory(conditional, validate_files=False)
    conditional_v2 = copy.deepcopy(conditional)
    conditional_v2_row = conditional_v2[defense_index]
    conditional_v2_row["reason_code"] = DEFENSE_NA_V2_REASON_CODE
    conditional_v2_row["reason"] = DEFENSE_NA_V2_REASON
    conditional_v2_row["canary"]["call_accounting"] = copy.deepcopy(
        DEFENSE_NA_V2_CALL_ACCOUNTING
    )
    validate_exact_inventory(conditional_v2, validate_files=False)
    mutations: list[tuple[str, Any]] = []

    missing = copy.deepcopy(correct)
    missing.pop()
    mutations.append(("missing", missing))
    extra = copy.deepcopy(correct)
    extra.append({
        "lane_id": "forged-extra", "family": "core", "disposition": "runnable",
        "reason_code": None, "reason": None,
    })
    mutations.append(("extra", extra))
    duplicate = copy.deepcopy(correct)
    duplicate.append(copy.deepcopy(duplicate[0]))
    mutations.append(("duplicate", duplicate))
    runnable_index = next(
        index for index, row in enumerate(correct)
        if row["lane_id"] == "local-qwen3-vl-text-primary-100"
    )
    wrong_family = copy.deepcopy(correct)
    wrong_family[runnable_index]["family"] = "bridge"
    mutations.append(("runnable_family", wrong_family))
    wrong_disposition = copy.deepcopy(correct)
    wrong_disposition[runnable_index]["disposition"] = "unavailable"
    mutations.append(("runnable_disposition", wrong_disposition))
    terminal_index = next(
        index for index, row in enumerate(correct)
        if row["lane_id"] == "bridge-nanogcg"
    )
    wrong_reason = copy.deepcopy(correct)
    wrong_reason[terminal_index]["reason"] += " forged"
    mutations.append(("terminal_reason", wrong_reason))
    wrong_reason_code = copy.deepcopy(correct)
    wrong_reason_code[terminal_index]["reason_code"] = "forged"
    mutations.append(("terminal_reason_code", wrong_reason_code))
    wrong_na = copy.deepcopy(correct)
    wrong_na[terminal_index]["canary"] = {"status": "AVAILABLE", "value": None}
    mutations.append(("terminal_typed_na", wrong_na))
    rr_index = next(
        index for index, row in enumerate(correct)
        if row["lane_id"] == RR_TERMINAL_LANES[0]
    )
    rr_projection_unavailable = copy.deepcopy(correct)
    rr_projection_unavailable[rr_index]["projection"] = dict(RR_UNAVAILABLE_VALUE)
    mutations.append(("rr_projection_unavailable", rr_projection_unavailable))
    rr_missing_projection_descriptor = copy.deepcopy(correct)
    rr_missing_projection_descriptor[rr_index]["projection"]["value"].pop(
        "projection_artifact"
    )
    mutations.append(("rr_missing_projection_descriptor", rr_missing_projection_descriptor))
    rr_split_terminal_evidence = copy.deepcopy(correct)
    rr_split_terminal_evidence[rr_index]["canary"][
        "target_runtime_terminal_artifact"
    ]["sha256"] = "8" * 64
    mutations.append(("rr_split_terminal_evidence", rr_split_terminal_evidence))
    rr_duplicate_projection = copy.deepcopy(correct)
    first_rr = next(
        row for row in rr_duplicate_projection
        if row["lane_id"] == RR_TERMINAL_LANES[0]
    )
    second_rr = next(
        row for row in rr_duplicate_projection
        if row["lane_id"] == RR_TERMINAL_LANES[1]
    )
    second_rr["projection"]["value"]["projection_artifact"] = copy.deepcopy(
        first_rr["projection"]["value"]["projection_artifact"]
    )
    mutations.append(("rr_duplicate_projection", rr_duplicate_projection))
    for name, mutate in (
        (
            "conditional_reason",
            lambda row: row.__setitem__("reason", DEFENSE_NA_REASON + " forged"),
        ),
        (
            "conditional_reason_code",
            lambda row: row.__setitem__("reason_code", "forged"),
        ),
        (
            "conditional_projection",
            lambda row: row.__setitem__("projection", {"status": "N/A", "value": 0}),
        ),
        (
            "conditional_call_accounting",
            lambda row: row["canary"]["call_accounting"].__setitem__("target_calls", 1),
        ),
        (
            "conditional_boolean_call_accounting",
            lambda row: row["canary"]["call_accounting"].__setitem__(
                "target_calls", False
            ),
        ),
        (
            "conditional_artifact_digest",
            lambda row: row["canary"]["conditional_na_artifact"].__setitem__(
                "sha256", "x" * 64
            ),
        ),
    ):
        mutation = copy.deepcopy(conditional)
        row = next(item for item in mutation if item["lane_id"] == "defense-local")
        mutate(row)
        mutations.append((name, mutation))
    conditional_v2_cross_mix = copy.deepcopy(conditional_v2)
    conditional_v2_cross_mix[defense_index]["reason"] = DEFENSE_NA_REASON
    mutations.append(("conditional_v2_cross_mix", conditional_v2_cross_mix))
    pseudo_conditional = copy.deepcopy(correct)
    pseudo_index = next(
        index for index, row in enumerate(pseudo_conditional)
        if row["lane_id"] == "local-qwen3-vl-text-primary-100"
    )
    pseudo_conditional[pseudo_index] = copy.deepcopy(conditional[defense_index])
    pseudo_conditional[pseudo_index]["lane_id"] = "local-qwen3-vl-text-primary-100"
    mutations.append(("conditional_wrong_lane", pseudo_conditional))

    accepted: list[str] = []
    for name, mutation in mutations:
        try:
            validate_exact_inventory(mutation, validate_files=False)
        except Gate5Error:
            accepted.append(name)
        else:
            raise Gate5Error(f"inventory mutation self-test did not fail closed: {name}")

    def rr_projection_fixture(lane: str) -> dict[str, Any]:
        contract = RR_PROJECTION_CONTRACT[lane]
        counts = {
            "trajectories": 1,
            "target_calls": 1,
            "judge_calls": 0,
            "local_guardrail_evaluations": (
                1 if "guardrail" in contract["judges"] else 0
            ),
            "http_attempts": 0,
        }
        return {
            "envelope": {"request": {
                "requested_target_keys": [RR_TARGET_SPEC],
                "logical_source_arms": sorted(contract["arms"]),
                "selected_attackers": ["replay"],
                "judges": list(contract["judges"]),
                "defense": "none",
                "approximate_common_metrics": contract[
                    "approximate_common_metrics"
                ],
                "limit": 0,
                "sample_seed": 0,
                "seeds": [0],
                "max_queries": 1,
                "max_turns": 1,
                "call_caps": {
                    "target": 400_000,
                    "judge": None,
                    "http_attempts": None,
                    "deadline_seconds": 86_400,
                },
            }},
            "projection": {
                "selection": {"arms": [
                    {"logical_source_arm": arm}
                    for arm in sorted(contract["arms"])
                ]},
                "call_projection": {
                    **counts,
                    "semantics": "conservative_complete_grid_upper_bound_v1",
                    "by_attacker": {"replay": dict(counts)},
                },
            },
        }

    rr_projection_fixtures = {
        lane: rr_projection_fixture(lane) for lane in RR_TERMINAL_LANES
    }
    for lane, fixture in rr_projection_fixtures.items():
        validate_rr_projection_lane(lane, fixture)
    for lane in RR_TERMINAL_LANES:
        for swapped_lane in RR_TERMINAL_LANES:
            if lane == swapped_lane:
                continue
            try:
                validate_rr_projection_lane(lane, rr_projection_fixtures[swapped_lane])
            except Gate5Error:
                pass
            else:
                raise Gate5Error(
                    "RR projection lane-swap mutation self-test did not fail closed: "
                    f"{lane} accepted {swapped_lane}"
                )
    accepted.append("rr_swapped_projection_lane")
    receipt_id = "acquisition-receipt-" + "a" * 32
    receipt_sha = "b" * 64
    correct_acquisition = [{
        "receipt_id": receipt_id,
        "receipt_sha256": receipt_sha,
        "downloaded_bytes": 0,
    }]
    validate_zero_download_result_rows(
        correct_acquisition, receipt_id=receipt_id, receipt_sha256=receipt_sha
    )
    acquisition_mutations: list[tuple[str, list[dict[str, Any]]]] = [
        ("missing", []),
        ("duplicate", copy.deepcopy(correct_acquisition) * 2),
        ("wrong_receipt_id", [{**correct_acquisition[0], "receipt_id": "forged"}]),
        ("wrong_receipt_sha", [{**correct_acquisition[0], "receipt_sha256": "c" * 64}]),
        ("bool_download_zero", [{**correct_acquisition[0], "downloaded_bytes": False}]),
        ("nonzero_download", [{**correct_acquisition[0], "downloaded_bytes": 1}]),
        ("extra_field", [{**correct_acquisition[0], "status": "complete"}]),
    ]
    rejected_acquisition: list[str] = []
    for name, mutation in acquisition_mutations:
        try:
            validate_zero_download_result_rows(
                mutation, receipt_id=receipt_id, receipt_sha256=receipt_sha
            )
        except Gate5Error:
            rejected_acquisition.append(name)
        else:
            raise Gate5Error(
                f"acquisition-result mutation self-test did not fail closed: {name}"
            )
    descriptor_fixture = {
        name: {
            "path": str(Path.cwd().resolve() / f"{name}.fixture"),
            "sha256": "d" * 64,
            "bytes": 1,
        }
        for name in DEFENSE_NA_ARTIFACT_KEYS
    }
    validate_defense_na_artifact_inventory_shape(descriptor_fixture)
    descriptor_mutations = []
    missing_acquisition_log = copy.deepcopy(descriptor_fixture)
    missing_acquisition_log.pop("acquisition_result_log")
    descriptor_mutations.append(("missing_acquisition_result_log", missing_acquisition_log))
    extra_descriptor = copy.deepcopy(descriptor_fixture)
    extra_descriptor["forged"] = copy.deepcopy(next(iter(extra_descriptor.values())))
    descriptor_mutations.append(("extra_descriptor", extra_descriptor))
    bool_bytes = copy.deepcopy(descriptor_fixture)
    bool_bytes["acquisition_result_log"]["bytes"] = True
    descriptor_mutations.append(("acquisition_result_bool_bytes", bool_bytes))
    rejected_descriptors: list[str] = []
    for name, mutation in descriptor_mutations:
        try:
            validate_defense_na_artifact_inventory_shape(mutation)
        except Gate5Error:
            rejected_descriptors.append(name)
        else:
            raise Gate5Error(
                f"conditional artifact descriptor mutation did not fail closed: {name}"
            )
    live_descriptor = {"sha256": "e" * 64, "bytes": 123}
    live_fixture = {
        "mode": "measured",
        "execution_scope_id": "phase5-self-test",
        "max_age_hours": 24.0,
        "artifacts": [{
            "file": "live-attestation.fixture.json",
            "sha256": live_descriptor["sha256"],
            "bytes": live_descriptor["bytes"],
            "attestation_id": "live-attestation-" + "f" * 24,
        }],
    }
    validate_defense_na_live_binding_shape(
        live_fixture,
        attestation=live_descriptor,
        filename="live-attestation.fixture.json",
    )
    live_mutations: list[tuple[str, dict[str, Any]]] = []
    integer_age = copy.deepcopy(live_fixture)
    integer_age["max_age_hours"] = 24
    live_mutations.append(("integer_age", integer_age))
    wrong_id = copy.deepcopy(live_fixture)
    wrong_id["artifacts"][0]["attestation_id"] = "live-attestation-forged"
    live_mutations.append(("invalid_attestation_id", wrong_id))
    wrong_bytes = copy.deepcopy(live_fixture)
    wrong_bytes["artifacts"][0]["bytes"] = 124
    live_mutations.append(("descriptor_bytes", wrong_bytes))
    rejected_live: list[str] = []
    for name, mutation in live_mutations:
        try:
            validate_defense_na_live_binding_shape(
                mutation,
                attestation=live_descriptor,
                filename="live-attestation.fixture.json",
            )
        except Gate5Error:
            rejected_live.append(name)
        else:
            raise Gate5Error(
                f"conditional live-attestation mutation did not fail closed: {name}"
            )
    numeric_contract_mutations = {
        "boolean_returncode": {**DEFENSE_NA_CLASSIFICATION, "returncode": True},
        "boolean_runner_output": {**DEFENSE_NA_RUNNER_OUTPUTS, "grid_artifacts": False},
    }
    rejected_numeric: list[str] = []
    for name, mutation in numeric_contract_mutations.items():
        if name == "boolean_returncode":
            accepted_numeric = exact_typed_int_contract(
                mutation, DEFENSE_NA_CLASSIFICATION, ("returncode",)
            )
        else:
            accepted_numeric = exact_typed_int_contract(
                mutation,
                DEFENSE_NA_RUNNER_OUTPUTS,
                ("grid_artifacts", "response_streams", "completion_artifacts", "error_artifacts"),
            )
        if accepted_numeric:
            raise Gate5Error(
                f"conditional numeric-type mutation did not fail closed: {name}"
            )
        rejected_numeric.append(name)
    variant_fixtures: dict[str, dict[str, Any]] = {}
    for schema, variant in DEFENSE_NA_VARIANTS.items():
        fixture = {
            "schema": schema,
            "status": "N/A",
            "lane_id": "defense-local",
            "disposition": DEFENSE_NA_DISPOSITION,
            "reason_code": variant["reason_code"],
            "reason": variant["reason"],
            "classified_at_utc": "2026-08-22T00:00:00Z",
            "classification": copy.deepcopy(variant["classification"]),
            "bindings": {},
            "call_accounting": copy.deepcopy(variant["call_accounting"]),
            "runner_outputs": copy.deepcopy(variant["runner_outputs"]),
            "artifacts": {},
            "resource_identities": [],
        }
        if variant["evidence_limits"] is not None:
            fixture["evidence_limits"] = copy.deepcopy(variant["evidence_limits"])
        defense_na_variant_from_value(fixture)
        variant_fixtures[schema] = fixture
    rejected_variants: list[str] = []
    for name, mutation in {
        "v2_reason_from_v1": {
            **variant_fixtures[DEFENSE_NA_V2_SCHEMA],
            "reason": DEFENSE_NA_REASON,
        },
        "v2_accounting_from_v1": {
            **variant_fixtures[DEFENSE_NA_V2_SCHEMA],
            "call_accounting": copy.deepcopy(DEFENSE_NA_CALL_ACCOUNTING),
        },
        "v1_with_evidence_limits": {
            **variant_fixtures[DEFENSE_NA_SCHEMA],
            "evidence_limits": copy.deepcopy(DEFENSE_NA_V2_EVIDENCE_LIMITS),
        },
        "v2_boolean_stream_count": {
            **variant_fixtures[DEFENSE_NA_V2_SCHEMA],
            "runner_outputs": {
                **DEFENSE_NA_V2_RUNNER_OUTPUTS,
                "grid_artifacts": True,
            },
        },
    }.items():
        try:
            defense_na_variant_from_value(mutation)
        except Gate5Error:
            rejected_variants.append(name)
        else:
            raise Gate5Error(
                f"conditional variant mutation did not fail closed: {name}"
            )
    return {
        "status": "passed",
        "schema": "ura-gate5-inventory-contract-self-test/1",
        "expected_rows": 46,
        "expected_runnable": [21, 22],
        "expected_conditional_na_lanes": [[], ["defense-local"]],
        "expected_bridge_terminal": 3,
        "expected_ollama_transport_terminal": 3,
        "expected_target_runtime_terminal": 4,
        "expected_portfolio_terminal": 5,
        "expected_native_terminal": 9,
        "rejected_mutations": accepted,
        "rejected_acquisition_result_mutations": rejected_acquisition,
        "rejected_conditional_artifact_descriptor_mutations": rejected_descriptors,
        "rejected_conditional_live_attestation_mutations": rejected_live,
        "rejected_conditional_numeric_type_mutations": rejected_numeric,
        "rejected_conditional_variant_mutations": rejected_variants,
        "rejected_canary_stage_mutations": canary_stage_contract_self_test(),
        "retained_binding_self_test": retained_binding_contract_self_test(),
        "empty_failed_live_attestation_tsv_self_test": (
            failed_attestation_tsv_contract_self_test()
        ),
        "failed_live_attestation_self_test": (
            failed_attestation_contract_self_test()
        ),
    }


def validate_inventory_current_bindings(
    rows: Sequence[Mapping[str, Any]],
    *,
    project_receipt: Mapping[str, Any],
    source_receipt: Mapping[str, Any],
) -> None:
    current_source = source_receipt["artifact"]
    expected_source_identity = {
        "bytes": current_source["bytes"],
        "sha256": current_source["sha256"],
    }
    for row in rows:
        if row["disposition"] != "runnable":
            continue
        lane = row["lane_id"]
        envelope = read_strict_json(row["preliminary"]["request_envelope_artifact"]["path"])
        if envelope["bindings"]["project_revision"] != project_receipt["binding"]:
            raise Gate5Error(f"{lane}: preliminary projection is not bound to the current project receipt")
        eligibility, _eligibility_descriptor = load_eligibility_artifact(
            row["preliminary"]["eligibility_artifact"]["path"]
        )
        selected = eligibility["bindings"]["experiment_conditions"]["values"][
            "selected_config_identities"
        ]
        if selected.get("source_conformance") != expected_source_identity:
            raise Gate5Error(f"{lane}: preliminary projection is not bound to the current source receipt")
        argv = row["base_argv"]
        if option(argv, "--project-revision-sha256") != project_receipt["artifact"]["sha256"]:
            raise Gate5Error(f"{lane}: base argv project-revision SHA is stale")
        if option(argv, "--source-conformance-sha256") != current_source["sha256"]:
            raise Gate5Error(f"{lane}: base argv source-conformance SHA is stale")


def build_covered_manifest(
    args: argparse.Namespace,
    project_root: Path,
    *,
    project_receipt: Mapping[str, Any],
    source_receipt: Mapping[str, Any],
) -> tuple[dict[str, Any], dict[str, Any]]:
    work = checked_dir(required_env("URA_WORK"), label="URA_WORK")
    if args.lane_manifest:
        rows, inputs = explicit_manifest_rows(
            manifest_path=checked_file(args.lane_manifest, max_bytes=MAX_JSON_BYTES),
            project_root=project_root,
        )
    else:
        root_values = {
            "core_projection": args.core_projections_root,
            "core_canary": args.core_canaries_root,
            "bridge_projection": args.bridge_projections_root,
            "bridge_canary": args.bridge_canaries_root,
            "ollama_projection": args.ollama_projections_root,
            "ollama_canary": args.ollama_canaries_root,
        }
        missing = sorted(key for key, value in root_values.items() if not value)
        if missing:
            raise Gate5Error(
                "root mode requires all six explicit roots; missing: " + ", ".join(missing)
            )
        controls = {
            key: validate_control_root(
                value,
                kind=("projection" if "projection" in key else "canary"),
                work=work,
            )
            for key, value in root_values.items()
        }
        rows = []
        for family in ("core", "bridge", "ollama"):
            rows.extend(root_runnable_rows(
                family=family,
                projection_info=controls[f"{family}_projection"],
                canary_info=controls[f"{family}_canary"],
                project_root=project_root,
                work=work,
            ))
        rows.extend(parse_bridge_dispositions(Path(controls["bridge_projection"]["root"])))
        bridge_canary_terminals = parse_bridge_dispositions(
            Path(controls["bridge_canary"]["root"])
        )
        if {
            row["lane_id"]: row["disposition"] for row in bridge_canary_terminals
        } != EXPECTED_BRIDGE_TERMINALS:
            raise Gate5Error("bridge canary terminal inventory differs from projection inventory")
        inputs = {"mode": "explicit_control_roots", "controls": controls}
    failed_attempts = failed_attempt_ledger(args, work=work)
    inputs = {**inputs, "failed_attempts": failed_attempts}
    rows = merge_builtin_terminal_rows(rows)
    validate_exact_inventory(rows)
    validate_inventory_current_bindings(
        rows,
        project_receipt=project_receipt,
        source_receipt=source_receipt,
    )
    input_payload = canonical_bytes(inputs)
    manifest = {
        "schema": MANIFEST_SCHEMA,
        "inventory_scope": "all_local_phase5_runner_gate5_plus_typed_portfolio_boundaries",
        "inventory_complete": True,
        "code_identity": {
            "expected_commit": EXPECTED_COMMIT,
            "framework_lock_id": EXPECTED_FRAMEWORK_LOCK,
        },
        "input_evidence_binding": {
            "sha256": sha256_bytes(input_payload),
            "bytes": len(input_payload),
        },
        "failed_attempts": failed_attempts,
        "policy": {
            "population_tiers": {
                "primary_core": {
                    "cluster_limit_per_selected_arm": PRIMARY_CORE_LIMIT,
                    "sample_seed": 0,
                    "selection_method": BOUNDED_SELECTION_METHOD,
                    "purpose": "primary_cluster_level_estimation",
                },
                "extended_exploratory": {
                    "cluster_limit_per_selected_arm": EXPLORATORY_EXTENDED_LIMIT,
                    "sample_seed": 0,
                    "selection_method": BOUNDED_SELECTION_METHOD,
                    "purpose": "descriptive_precision_limited_framework_and_ollama_evidence",
                },
                "full_corpus_mode": {
                    "cluster_limit_per_selected_arm": 0,
                    "status": "supported_not_selected_for_this_measured_cohort",
                },
            },
            "target_and_transport_caps": "exact_preliminary_call_projection_totals",
            "model_judge_calls_required": 0,
            "http_attempts_required": 0,
            "downloads_required_bytes": 0,
            "call_start_deadline_seconds": CALL_START_DEADLINE_SECONDS,
            "call_start_deadline_semantics": "admission_window_from_first_invocation_not_completion_timeout",
            "measured_lane_wall_time_seconds": MEASURED_LANE_WALL_TIME_SECONDS,
            "measured_lane_wall_time_semantics": "controller_completion_ceiling_distinct_from_call_start_admission_window",
            "free_space_floor_bytes": FREE_SPACE_FLOOR_BYTES,
            "retained_output_policy_bytes": EXTERNAL_RETAINED_OUTPUT_POLICY_BYTES,
            "retained_output_policy_semantics": "external_operator_policy_only_not_runner_enforced",
            "provider_quota": {"status": "N/A", "reason": "all_routes_are_local"},
            "expected_full_lane_storage": {"status": "CANNOT-VERIFY", "value": None},
            "tokens_cost_and_throughput": {"status": "CANNOT-VERIFY", "value": None},
        },
        "lanes": rows,
    }
    return manifest, inputs


def nearest_existing(path: Path) -> Path:
    candidate = path.expanduser()
    while not candidate.exists():
        if candidate.parent == candidate:
            raise Gate5Error(f"no existing ancestor for storage path: {path}")
        candidate = candidate.parent
    return checked_dir(candidate, label=f"storage ancestor for {path}")


def mount_metadata(path: Path) -> dict[str, Any]:
    best: tuple[int, dict[str, str]] | None = None
    mountinfo = Path("/proc/self/mountinfo")
    if mountinfo.is_file():
        for line in mountinfo.read_text(encoding="utf-8").splitlines():
            left, separator, right = line.partition(" - ")
            if not separator:
                continue
            left_fields = left.split()
            right_fields = right.split()
            if len(left_fields) < 5 or len(right_fields) < 2:
                continue
            mount_point = left_fields[4].replace("\\040", " ")
            try:
                candidate = Path(mount_point).resolve(strict=True)
                path.relative_to(candidate)
            except (OSError, ValueError):
                continue
            row = {
                "mount_point": str(candidate),
                "filesystem_type": right_fields[0],
                "source": right_fields[1],
            }
            score = len(str(candidate))
            if best is None or score > best[0]:
                best = (score, row)
    if best is None:
        return {
            "mount_point": "CANNOT-VERIFY",
            "filesystem_type": "CANNOT-VERIFY",
            "source": "CANNOT-VERIFY",
        }
    return best[1]


def storage_observations(output_root: Path, runnote_path: Path) -> dict[str, Any]:
    requested = {
        "work": Path(required_env("URA_WORK")),
        "model_store": Path(required_env("URA_MODEL_STORE")),
        "output_root_parent": output_root.parent,
        "runnote_candidate_parent": runnote_path.parent,
    }
    rows: list[dict[str, Any]] = []
    device_free: dict[int, int] = {}
    for label, requested_path in requested.items():
        resolved = nearest_existing(requested_path)
        info = resolved.stat()
        usage = shutil.disk_usage(resolved)
        device_free.setdefault(info.st_dev, usage.free)
        if device_free[info.st_dev] != usage.free:
            # The same device can change by a few bytes while observing it. Retain
            # each timestamped value and enforce the conservative minimum below.
            device_free[info.st_dev] = min(device_free[info.st_dev], usage.free)
        rows.append({
            "observed_at_utc": utc_now(),
            "label": label,
            "requested_path": str(requested_path.expanduser()),
            "resolved_existing_path": str(resolved),
            "st_dev": info.st_dev,
            "total_bytes": usage.total,
            "used_bytes": usage.used,
            "free_bytes": usage.free,
            **mount_metadata(resolved),
        })
    short = {device: free for device, free in device_free.items() if free < FREE_SPACE_FLOOR_BYTES}
    if short:
        raise Gate5Error(
            "resolved storage device free-space floor is below 1 TiB: "
            + ", ".join(f"device={device} free={free}" for device, free in sorted(short.items()))
        )
    return {
        "schema": "ura-gate5-storage-observation/1",
        "required_free_floor_bytes": FREE_SPACE_FLOOR_BYTES,
        "admission_passed": True,
        "observations": rows,
    }


def parse_controller_result(log_path: Path, required_fields: set[str], *, label: str) -> dict[str, Any]:
    matches = [
        row for row in json_objects_from_log(log_path)
        if required_fields <= set(row)
    ]
    if len(matches) != 1:
        raise Gate5Error(f"{label}: expected one controller result JSON, found {len(matches)}")
    return matches[0]


class ExecutionController:
    def __init__(self, *, output_root: Path, project_root: Path) -> None:
        self.output_root = output_root
        self.project_root = project_root
        self.events_path = output_root / "controller-events.jsonl"
        self._events_handle = self.events_path.open("xb")
        self._closed = False
        self.commands: list[dict[str, Any]] = []

    def close(self) -> None:
        if self._closed:
            return
        self._events_handle.flush()
        os.fsync(self._events_handle.fileno())
        self._events_handle.close()
        self._closed = True

    def event(self, event: str, **values: Any) -> None:
        if self._closed:
            raise Gate5Error("cannot append a controller event after the event stream closed")
        payload = {"observed_at_utc": utc_now(), "event": event, **values}
        self._events_handle.write(canonical_bytes(payload))
        self._events_handle.flush()

    def run(self, *, lane: str, stage: str, argv: Sequence[str], log_path: Path, env: Mapping[str, str]) -> dict[str, Any]:
        started = utc_now()
        monotonic = time.monotonic()
        self.event("command_started", lane=lane, stage=stage, argv=list(argv), log_path=str(log_path))
        with log_path.open("xb") as handle:
            try:
                result = subprocess.run(
                    list(argv),
                    cwd=self.project_root,
                    env=dict(env),
                    stdin=subprocess.DEVNULL,
                    stdout=handle,
                    stderr=subprocess.STDOUT,
                    check=False,
                )
            except OSError as exc:
                raise Gate5Error(f"{lane}/{stage}: controller could not start: {exc}") from exc
            handle.flush()
            os.fsync(handle.fileno())
        finished = utc_now()
        command = {
            "lane_id": lane,
            "stage": stage,
            "argv": list(argv),
            "started_at_utc": started,
            "finished_at_utc": finished,
            "controller_elapsed_seconds": time.monotonic() - monotonic,
            "returncode": result.returncode,
            "log": descriptor(log_path, max_bytes=MAX_LOG_BYTES),
        }
        self.commands.append(command)
        self.event("command_finished", **command)
        if result.returncode != 0:
            raise Gate5Error(f"{lane}/{stage}: command failed with exit {result.returncode}; see {log_path}")
        return command


def command_env(cuda_visible_devices: str) -> dict[str, str]:
    env = dict(os.environ)
    env["CUDA_VISIBLE_DEVICES"] = cuda_visible_devices
    provider_names = (
        "OPENAI", "ANTHROPIC", "AZURE_OPENAI", "GOOGLE", "GEMINI", "MISTRAL",
        "COHERE", "TOGETHER", "GROQ", "FIREWORKS", "BEDROCK", "REPLICATE",
        "DEEPSEEK", "OPENROUTER",
    )
    for name in list(env):
        upper = name.upper()
        if (
            "TOKEN" in upper
            or upper.endswith("_API_KEY")
            or upper.endswith("_ACCESS_KEY")
            or upper.endswith("_SECRET_KEY")
            or upper in {"HF_TOKEN", "HUGGING_FACE_HUB_TOKEN"}
            or any(upper.startswith(prefix + "_") and (
                "KEY" in upper or "SECRET" in upper or "TOKEN" in upper
            ) for prefix in provider_names)
        ):
            env.pop(name, None)
    for name in (
        "URA_MODEL_ACQUISITION_PLAN_DIR",
        "URA_MODEL_ACQUISITION_PLAN",
        "URA_MODEL_ACQUISITION_PLAN_SHA256",
        "URA_MODEL_ACQUISITION_RECEIPT",
        "URA_MODEL_ACQUISITION_RECEIPT_SHA256",
        "URA_MODEL_ACQUISITION_STORE",
    ):
        env.pop(name, None)
    env["PYTHONDONTWRITEBYTECODE"] = "1"
    env.update({
        "HF_HUB_OFFLINE": "1",
        "HF_HUB_DISABLE_XET": "1",
        "HF_DATASETS_OFFLINE": "1",
        "TRANSFORMERS_OFFLINE": "1",
        "HF_HUB_DISABLE_TELEMETRY": "1",
        "DISABLE_TELEMETRY": "1",
        "DO_NOT_TRACK": "1",
        "WANDB_MODE": "offline",
        "WANDB_DISABLED": "true",
    })
    return env


def argv_artifact(
    *, lane_root: Path, base: Sequence[str], plan: Sequence[str] | None,
    acquire: Sequence[str] | None, preflight: Sequence[str]
) -> dict[str, Any]:
    value = {
        "schema": "ura-gate5-exact-argv/1",
        "base_argv": list(base),
        "plan_argv": list(plan) if plan is not None else {"status": "N/A", "value": None},
        "acquire_argv": list(acquire) if acquire is not None else {"status": "N/A", "value": None},
        "preflight_argv": list(preflight),
    }
    return write_create_only(lane_root / "exact-argv.json", canonical_bytes(value))


def final_artifacts(run_root: Path) -> dict[str, Path]:
    if not run_root.is_dir() or run_root.is_symlink():
        raise Gate5Error(f"final preflight output root is absent or unsafe: {run_root}")
    return {
        "projection": find_single(run_root, "lane-projection-*.lane-projection.json", label=str(run_root)),
        "eligibility": find_single(run_root, "eligibility-*.eligibility.json", label=str(run_root)),
        "envelope": find_single(run_root, "request-envelope-*.request-envelope.json", label=str(run_root)),
        "deadline": find_single(run_root, "request-envelope-*.deadline.json", label=str(run_root)),
    }


def validate_final_preflight(
    *,
    lane: Mapping[str, Any],
    run_root: Path,
    acquisition: Mapping[str, Any],
) -> dict[str, Any]:
    paths = final_artifacts(run_root)
    final = load_projection_bundle(paths["projection"])
    preliminary = lane["preliminary"]
    if final["projection"]["selection"] != preliminary["selection"]:
        raise Gate5Error(f"{lane['lane_id']}: final/preliminary selection parity failed")
    expected_calls = {
        "trajectories": preliminary["projected_calls"]["trajectories"],
        "target_calls": preliminary["projected_calls"]["target_calls"],
        "judge_calls": preliminary["projected_calls"]["model_judge_calls"],
        "local_guardrail_evaluations": preliminary["projected_calls"]["local_guardrail_evaluations"],
        "http_attempts": preliminary["projected_calls"]["http_attempts"],
    }
    observed_calls = final["projection"]["call_projection"]
    for field, expected in expected_calls.items():
        if observed_calls[field] != expected:
            raise Gate5Error(f"{lane['lane_id']}: final/preliminary call projection parity failed for {field}")
    # Preserve the complete by-attacker accounting as well, not only totals.
    prelim_projection = read_strict_json(preliminary["projection_artifact"]["path"])
    if observed_calls != prelim_projection["call_projection"]:
        raise Gate5Error(f"{lane['lane_id']}: complete call projection parity failed")

    final_request = final["envelope"]["request"]
    prelim_request = read_strict_json(preliminary["request_envelope_artifact"]["path"])["request"]
    expected_caps = {
        "target": expected_calls["target_calls"],
        "judge": None,
        "http_attempts": None,
        "deadline_seconds": CALL_START_DEADLINE_SECONDS,
    }
    if final_request["call_caps"] != expected_caps:
        raise Gate5Error(f"{lane['lane_id']}: final request envelope does not contain exact approved caps")
    final_semantics = {key: value for key, value in final_request.items() if key != "call_caps"}
    prelim_semantics = {key: value for key, value in prelim_request.items() if key != "call_caps"}
    if final_semantics != prelim_semantics:
        raise Gate5Error(f"{lane['lane_id']}: final request semantic envelope differs from preliminary")
    if final["envelope"]["bindings"] != read_strict_json(
        preliminary["request_envelope_artifact"]["path"]
    )["bindings"]:
        raise Gate5Error(f"{lane['lane_id']}: final request code/project bindings differ")

    deadline = read_strict_json(paths["deadline"], max_bytes=1024 * 1024)
    if (
        deadline.get("schema") != "ura-invocation-deadline/1"
        or deadline.get("request_envelope_id") != final["envelope"]["envelope_id"]
        or deadline.get("deadline_seconds") != CALL_START_DEADLINE_SECONDS
        or isinstance(deadline.get("deadline_epoch"), bool)
        or not isinstance(deadline.get("deadline_epoch"), (int, float))
        or not math.isfinite(float(deadline["deadline_epoch"]))
    ):
        raise Gate5Error(f"{lane['lane_id']}: invocation deadline artifact is invalid")
    if acquisition.get("status") == "complete":
        plan = acquisition["plan_value"]
        if plan["bindings"].get("request_envelope_sha256") != final["envelope_descriptor"]["sha256"]:
            raise Gate5Error(f"{lane['lane_id']}: acquisition plan is not bound to final envelope")
    return {
        "status": "complete",
        "projection_id": final["projection"]["projection_id"],
        "projection_artifact": final["projection_descriptor"],
        "eligibility_plan_id": final["eligibility"]["plan_id"],
        "eligibility_artifact": final["eligibility_descriptor"],
        "request_envelope_id": final["envelope"]["envelope_id"],
        "request_envelope_artifact": final["envelope_descriptor"],
        "deadline_artifact": descriptor(paths["deadline"], max_bytes=1024 * 1024),
        "selection_parity": True,
        "complete_call_projection_parity": True,
        "exact_cap_binding": True,
        "call_start_deadline_semantics": "admission_window_from_first_invocation_not_completion_timeout",
    }


def execute_lane(
    *,
    lane: dict[str, Any],
    controller: ExecutionController,
    python: Path,
    model_store: Path,
    receipts_root: Path,
) -> dict[str, Any]:
    lane_id = lane["lane_id"]
    lane_root = mkdir_create_only(controller.output_root / "lanes" / lane_id)
    plan_root = lane_root / "plan"
    run_root = lane_root / "preflight"
    os.mkdir(plan_root, 0o700)
    base = list(lane["base_argv"])
    caps = lane["approved_caps"]
    final_args = [
        *base,
        "--max-total-target-calls", str(caps["target_calls"]),
        "--max-total-judge-calls", "0",
        "--max-total-http-attempts", "0",
        "--deadline-seconds", str(CALL_START_DEADLINE_SECONDS),
        "--out", str(run_root),
        "--preflight-only",
    ]
    env = command_env(lane["cuda_visible_devices"])
    executable = [str(python), "-m", "experiments.run_matrix"]
    acquisition: dict[str, Any]
    plan_argv: list[str] | None = None
    acquire_argv: list[str] | None = None
    if lane["acquisition_mode"] == "required_zero_download":
        plan_argv = [
            *executable,
            *final_args,
            "--model-acquisition-plan-only",
            "--model-acquisition-plan-dir", str(plan_root),
        ]
        plan_log = lane_root / "plan.controller.log"
        controller.run(
            lane=lane_id, stage="exact_cap_plan", argv=plan_argv, log_path=plan_log, env=env
        )
        plan_result = parse_controller_result(
            plan_log, {"plan_id", "plan_sha256"}, label=f"{lane_id} plan"
        )
        plan_sha = str(plan_result["plan_sha256"])
        if HEX64_RE.fullmatch(plan_sha) is None:
            raise Gate5Error(f"{lane_id}: controller returned invalid plan SHA")
        plan_path = checked_file(plan_root / f"{plan_result['plan_id']}.plan.json", max_bytes=MAX_JSON_BYTES)
        plan_value = load_plan(plan_path, expected_sha256=plan_sha)
        acquire_argv = [
            str(python), "-m", "experiments.model_acquire",
            "--plan", str(plan_path),
            "--plan-sha256", plan_sha,
            "--store", str(model_store),
            "--receipts-dir", str(receipts_root),
            "--transport-cache", str(model_store / ".transport-cache"),
            "--max-download-bytes", "0",
            "--min-free-bytes", str(FREE_SPACE_FLOOR_BYTES),
            "--deadline-seconds", str(ACQUISITION_DEADLINE_SECONDS),
        ]
        acquire_log = lane_root / "acquire.controller.log"
        controller.run(
            lane=lane_id, stage="zero_download_acquire", argv=acquire_argv,
            log_path=acquire_log, env=env
        )
        receipt_result = parse_controller_result(
            acquire_log,
            {"receipt_id", "receipt_sha256", "downloaded_bytes"},
            label=f"{lane_id} acquisition",
        )
        if receipt_result["downloaded_bytes"] != 0:
            raise Gate5Error(f"{lane_id}: acquisition downloaded nonzero bytes")
        receipt_sha = str(receipt_result["receipt_sha256"])
        if HEX64_RE.fullmatch(receipt_sha) is None:
            raise Gate5Error(f"{lane_id}: controller returned invalid receipt SHA")
        receipt_path = checked_file(
            receipts_root / f"{receipt_result['receipt_id']}.receipt.json",
            max_bytes=MAX_JSON_BYTES,
        )
        receipt_value = load_receipt(
            receipt_path, expected_sha256=receipt_sha, plan=plan_value
        )
        acquisition = {
            "status": "complete",
            "downloaded_bytes": 0,
            "maximum_download_bytes": 0,
            "plan_id": plan_value["plan_id"],
            "plan": descriptor(plan_path, max_bytes=MAX_JSON_BYTES),
            "receipt_id": receipt_value["receipt_id"],
            "receipt": descriptor(receipt_path, max_bytes=MAX_JSON_BYTES),
            "plan_controller_log": descriptor(plan_log, max_bytes=MAX_LOG_BYTES),
            "acquisition_controller_log": descriptor(acquire_log, max_bytes=MAX_LOG_BYTES),
            "plan_value": plan_value,
        }
        preflight_argv = [
            *executable,
            *final_args,
            "--model-acquisition-plan", str(plan_path),
            "--model-acquisition-plan-sha256", plan_sha,
            "--model-acquisition-receipt", str(receipt_path),
            "--model-acquisition-receipt-sha256", receipt_sha,
            "--model-acquisition-store", str(model_store),
        ]
    else:
        acquisition = {
            "status": "N/A",
            "value": None,
            "reason": "selected Ollama target/rules lane has no managed Hugging Face resource",
            "downloaded_bytes": {"status": "N/A", "value": None},
            "maximum_download_bytes": 0,
        }
        preflight_argv = [*executable, *final_args]

    argv_desc = argv_artifact(
        lane_root=lane_root,
        base=base,
        plan=plan_argv,
        acquire=acquire_argv,
        preflight=preflight_argv,
    )
    preflight_log = lane_root / "preflight.controller.log"
    controller.run(
        lane=lane_id, stage="exact_cap_preflight", argv=preflight_argv,
        log_path=preflight_log, env=env
    )
    final = validate_final_preflight(
        lane=lane, run_root=run_root, acquisition=acquisition
    )
    acquisition_public = {key: value for key, value in acquisition.items() if key != "plan_value"}
    return {
        "lane_id": lane_id,
        "argv_artifact": argv_desc,
        "acquisition": acquisition_public,
        "preflight_controller_log": descriptor(preflight_log, max_bytes=MAX_LOG_BYTES),
        "final_preflight": final,
    }


def diagnostic_command(
    controller: ExecutionController,
    *,
    name: str,
    argv: Sequence[str],
    env: Mapping[str, str],
) -> dict[str, Any]:
    log_path = controller.output_root / f"environment-{name}.log"
    try:
        return controller.run(
            lane="_environment", stage=name, argv=argv, log_path=log_path, env=env
        )
    except Gate5Error as exc:
        controller.event("environment_diagnostic_unavailable", stage=name, error=str(exc))
        return {
            "lane_id": "_environment",
            "stage": name,
            "status": "CANNOT-VERIFY",
            "error": str(exc),
            "log": descriptor(log_path, max_bytes=MAX_LOG_BYTES) if log_path.exists() else None,
        }


def machine_inventory(controller: ExecutionController, python: Path) -> dict[str, Any]:
    env = command_env("0,1")
    rows = {
        "uname": diagnostic_command(
            controller, name="uname", argv=["uname", "-a"], env=env
        ),
        "gpu": diagnostic_command(
            controller,
            name="gpu",
            argv=[
                "nvidia-smi",
                "--query-gpu=index,name,uuid,memory.total,driver_version",
                "--format=csv,noheader,nounits",
            ],
            env=env,
        ),
        "packages": diagnostic_command(
            controller,
            name="packages",
            argv=[str(python), "-m", "pip", "freeze", "--all"],
            env=env,
        ),
    }
    return {
        "platform": platform.platform(),
        "python": sys.version,
        "diagnostics": rows,
    }


def runnote_markdown(note: Mapping[str, Any]) -> bytes:
    lines = [
        "# URA thesis run note - Gate 5 candidate",
        "",
        "> Create-only candidate. This file does not replace or amend `runs/thesis/RUNNOTE.md`.",
        "> Diagnostic canaries remain non-empirical and do not authorize a measured campaign.",
        "",
        f"- Schema: `{note['schema']}`",
        f"- Created (UTC): `{note['created_at_utc']}`",
        f"- Covered manifest SHA-256: `{note['approval']['covered_manifest_sha256']}`",
        f"- Approval provenance: `{note['approval']['kind']}` / `{note['approval']['approver']}` / `{note['approval']['authentication']}`",
        f"- Call-start window: `{note['policy']['call_start_deadline_seconds']}` seconds (not a completion timeout)",
        f"- Per-lane measured wall ceiling: `{note['policy']['measured_lane_wall_time_seconds']}` seconds (controller-enforced, distinct from the call-start window)",
        f"- External retained-output policy: `{note['policy']['retained_output_policy_bytes']}` bytes (not Runner-enforced)",
        f"- Resolved-device free-space floor: `{note['policy']['free_space_floor_bytes']}` bytes",
        "",
        "## Prior failed attempts (excluded from Gate 5 evidence)",
        "",
    ]
    for attempt in note["failed_attempts"]:
        lines.append(
            "- `{root}` - `{status}`; primary: {primary}; secondary: {secondary}; "
            "controller exit: `{exit_code}`; accepted evidence: `false`.".format(
                root=attempt["root"],
                status=attempt["status"],
                primary=attempt["primary_failure"],
                secondary=attempt["secondary_failure"],
                exit_code=(
                    attempt["controller_exit_code"]
                    if attempt["controller_exit_code"] is not None
                    else "CANNOT-VERIFY"
                ),
            )
        )
    lines.extend([
        "",
        "## Lane inventory",
        "",
        "| Lane | Disposition | Target calls | Model-judge calls | Local guard evals | HTTP | Canary | Final projection |",
        "|---|---:|---:|---:|---:|---:|---|---|",
    ])
    for lane in note["lanes"]:
        if lane["disposition"] == "runnable":
            calls = lane["preliminary"]["projected_calls"]
            result = lane["execution"]
            lines.append(
                "| {lane} | runnable | {target} | {judge} | {guard} | {http} | {canary} | {final} |".format(
                    lane=lane["lane_id"],
                    target=calls["target_calls"],
                    judge=calls["model_judge_calls"],
                    guard=calls["local_guardrail_evaluations"],
                    http=calls["http_attempts"],
                    canary=lane["canary"]["canary_id"],
                    final=result["final_preflight"]["projection_id"],
                )
            )
        else:
            lines.append(
                f"| {lane['lane_id']} | {lane['disposition']} | {lane['projection']['status']} | "
                f"{lane['projection']['status']} | {lane['projection']['status']} | "
                f"{lane['projection']['status']} | {lane['canary']['status']} | {lane['final_preflight']['status']} |"
            )
    lines.extend([
        "",
        "## Truth boundary",
        "",
        "Per-lane artifact bytes, target/model-judge timing observations, transport accounting, decision coverage, and role reachability are copied from strictly revalidated `ura-lane-canary/1` artifacts below. They describe only one-cluster live diagnostics. Full-lane tokens, price/cost, runtime/throughput, and expected output storage remain `CANNOT-VERIFY`. Provider quota is `N/A` because every admitted route is local. A future measured run requires a distinct measured-purpose plan and receipt; no artifact in this candidate is that authorization.",
        "",
        "## Machine-readable record",
        "",
        "```json",
        json.dumps(note, ensure_ascii=False, indent=2, sort_keys=True, allow_nan=False),
        "```",
        "",
    ])
    return "\n".join(lines).encode("utf-8")


def artifact_index(root: Path, *, excluded: set[Path]) -> list[dict[str, Any]]:
    rows: list[dict[str, Any]] = []
    for path in sorted(root.rglob("*")):
        if path in excluded:
            continue
        if path.is_symlink():
            raise Gate5Error(f"output tree contains a non-regular artifact: {path}")
        if path.is_dir():
            continue
        if not path.is_file():
            raise Gate5Error(f"output tree contains a non-regular artifact: {path}")
        observed = descriptor(path)
        rows.append({
            "file": str(path.relative_to(root)),
            "sha256": observed["sha256"],
            "bytes": observed["bytes"],
        })
    return rows


def parser() -> argparse.ArgumentParser:
    ap = argparse.ArgumentParser(
        description=(
            "Validate and, only after digest-scoped operator assertion, finalize exact-cap Gate-5 preflights."
        )
    )
    ap.add_argument("--lane-manifest", help=f"explicit exhaustive {INPUT_MANIFEST_SCHEMA} JSON")
    ap.add_argument("--core-projections-root")
    ap.add_argument("--core-canaries-root")
    ap.add_argument("--bridge-projections-root")
    ap.add_argument("--bridge-canaries-root")
    ap.add_argument("--ollama-projections-root")
    ap.add_argument("--ollama-canaries-root")
    ap.add_argument(
        "--failed-attempt-root",
        action="append",
        default=[],
        help=(
            "repeatable failed controller root to hash into the audit ledger; an "
            "incomplete zero marker is accepted only for an exact recognized signal "
            "anomaly, and no such root is projection or canary evidence"
        ),
    )
    ap.add_argument("--launch", action="store_true", help="execute after full revalidation")
    ap.add_argument(
        "--authorize-manifest-sha256",
        default="",
        help="exact digest printed by a prior validation-only invocation",
    )
    ap.add_argument("--output-root", help="create-only finalization control root")
    ap.add_argument("--runnote-candidate", help="create-only Markdown candidate under runs/thesis")
    ap.add_argument("--control-root", help="create-only tmux launcher control root")
    ap.add_argument("--inventory-contract-self-test", action="store_true", help=argparse.SUPPRESS)
    ap.add_argument("--_payload-execute", action="store_true", help=argparse.SUPPRESS)
    ap.add_argument("--payload-control-root", help=argparse.SUPPRESS)
    return ap


def payload_evidence_arguments(args: argparse.Namespace) -> list[str]:
    if args.lane_manifest:
        values = [
            "--lane-manifest",
            str(checked_file(args.lane_manifest, max_bytes=MAX_JSON_BYTES)),
        ]
    else:
        values = [
            "--core-projections-root", str(checked_dir(args.core_projections_root, label="core projection control root")),
            "--core-canaries-root", str(checked_dir(args.core_canaries_root, label="core canary control root")),
            "--bridge-projections-root", str(checked_dir(args.bridge_projections_root, label="bridge projection control root")),
            "--bridge-canaries-root", str(checked_dir(args.bridge_canaries_root, label="bridge canary control root")),
            "--ollama-projections-root", str(checked_dir(args.ollama_projections_root, label="Ollama projection control root")),
            "--ollama-canaries-root", str(checked_dir(args.ollama_canaries_root, label="Ollama canary control root")),
        ]
    for root in args.failed_attempt_root:
        values.extend([
            "--failed-attempt-root",
            str(checked_dir(root, label="failed-attempt control root")),
        ])
    return values


def launch_payload(
    *,
    args: argparse.Namespace,
    manifest_sha: str,
    work: Path,
) -> dict[str, Any]:
    tag = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    control_root = Path(args.control_root).expanduser() if args.control_root else (
        work / "runs" / "engineering" / f"phase5-gate5-launch-{tag}"
    )
    checked_dir(control_root.parent, label="launcher control-root parent")
    control_root = mkdir_create_only(control_root)
    output_root = Path(args.output_root).expanduser() if args.output_root else (
        control_root / "finalization"
    )
    runnote_path = Path(args.runnote_candidate).expanduser() if args.runnote_candidate else (
        work / "runs" / "thesis" / f"RUNNOTE.gate5-{tag}.candidate.md"
    )
    if output_root.exists() or output_root.is_symlink():
        raise Gate5Error(f"finalization output root already exists: {output_root}")
    if runnote_path.exists() or runnote_path.is_symlink():
        raise Gate5Error(f"RUNNOTE candidate already exists: {runnote_path}")
    if runnote_path.name == "RUNNOTE.md":
        raise Gate5Error("the launcher never writes the canonical RUNNOTE.md directly")
    checked_dir(output_root.parent, label="finalization output-root parent")
    checked_dir(runnote_path.parent, label="RUNNOTE-candidate parent")

    # This is an independent filesystem admission check, not model_acquire's
    # conditional download-space check. It happens before tmux is started.
    try:
        prelaunch_storage = storage_observations(output_root, runnote_path)
    except Gate5Error as exc:
        write_create_only(control_root / "admission-failure.json", canonical_bytes({
            "schema": "ura-gate5-launch-admission-failure/1",
            "status": "not_launched",
            "failed_at_utc": utc_now(),
            "covered_manifest_sha256": manifest_sha,
            "error": str(exc),
        }))
        write_create_only(control_root / ".exit", b"2\n")
        raise
    prelaunch_storage_desc = write_create_only(
        control_root / "prelaunch-storage-observations.json",
        canonical_bytes(prelaunch_storage),
    )

    finalizer = checked_file(required_env("URA_GATE5_FINALIZER_SCRIPT"), max_bytes=4 * 1024 * 1024)
    payload_path = control_root / "execute-gate5-finalization.sh"
    child_argv = [
        "bash",
        str(finalizer),
        *payload_evidence_arguments(args),
        "--_payload-execute",
        "--payload-control-root", str(control_root),
        "--authorize-manifest-sha256", manifest_sha,
        "--output-root", str(output_root),
        "--runnote-candidate", str(runnote_path),
    ]
    quoted_child = " ".join(shlex.quote(item) for item in child_argv)
    quoted_control = shlex.quote(str(control_root))
    quoted_work = shlex.quote(str(work))
    quoted_python = shlex.quote(sys.executable)
    session = f"ura-gate5-{tag}"
    socket = f"ura-gate5-{tag}"
    payload_text = "\n".join((
        "#!/usr/bin/env bash",
        "set -Eeuo pipefail",
        "umask 077",
        f"CONTROL_ROOT={quoted_control}",
        f"URA_WORK={quoted_work}",
        f"PY={quoted_python}",
        "LOG=\"$CONTROL_ROOT/finalizer.log\"",
        "LOG_SHA_TMP=\"$CONTROL_ROOT/.finalizer.log.sha256.tmp\"",
        "LOG_SHA=\"$CONTROL_ROOT/finalizer.log.sha256\"",
        "EXIT_TMP=\"$CONTROL_ROOT/.exit.tmp\"",
        "EXIT_MARKER=\"$CONTROL_ROOT/.exit\"",
        "CONSOLE_CAMPAIGN_STARTED=0",
        "exec 3>&1 4>&2",
        "exec > >(tee -- \"$LOG\") 2>&1",
        "finish() {",
        "  rc=$?",
        "  trap - EXIT",
        "  printf 'GATE5_FINALIZER_CHILD_RETURN=%s\\n' \"$rc\"",
        "  exec 1>&3 2>&4",
        "  wait || true",
        "  sha256sum -- \"$LOG\" > \"$LOG_SHA_TMP\"",
        "  test ! -e \"$LOG_SHA\"",
        "  mv -- \"$LOG_SHA_TMP\" \"$LOG_SHA\"",
        "  printf '%s\\n' \"$rc\" > \"$EXIT_TMP\"",
        "  test ! -e \"$EXIT_MARKER\"",
        "  mv -- \"$EXIT_TMP\" \"$EXIT_MARKER\"",
        "  if [ \"$CONSOLE_CAMPAIGN_STARTED\" = '1' ]; then",
        "    PYTHONDONTWRITEBYTECODE=1 \"$PY\" -m experiments.local_campaign.console_events child-finish --work-root \"$URA_WORK\" --control-root \"$CONTROL_ROOT\" --exit-code \"$rc\" || printf 'console child terminal failed\\n' >&2",
        "  fi",
        "  printf 'GATE5_FINALIZER_EXIT=%s\\n' \"$rc\"",
        "  exit \"$rc\"",
        "}",
        "trap finish EXIT",
        "trap 'exit 130' INT",
        "trap 'exit 143' TERM",
        "trap 'exit 129' HUP",
        "CONSOLE_CAMPAIGN_STARTED=1",
        "PYTHONDONTWRITEBYTECODE=1 \"$PY\" -m experiments.local_campaign.console_events child-start --work-root \"$URA_WORK\" --control-root \"$CONTROL_ROOT\" --campaign-id \"${CONTROL_ROOT##*/}\" --release-commit '@@EXPECTED_COMMIT@@' --evidence-class local_campaign_control --hard-stop-hours 24 "
        f"--tmux-socket {shlex.quote(socket)} --tmux-session {shlex.quote(session)}",
        "export URA_GATE5_PAYLOAD_EXECUTION=1",
        f"export URA_GATE5_PAYLOAD_PATH={shlex.quote(str(payload_path))}",
        "export URA_GATE5_PAYLOAD_SHA256=__PAYLOAD_SHA256__",
        quoted_child,
        "",
    ))
    # Bind the child to the exact create-only payload without a self-hash cycle:
    # hash a template with one fixed placeholder, then persist that digest in it.
    template_digest = sha256_bytes(payload_text.encode("utf-8"))
    payload_text = payload_text.replace("__PAYLOAD_SHA256__", template_digest)
    payload_desc = write_create_only(payload_path, payload_text.encode("utf-8"), mode=0o700)
    if stat.S_IMODE(payload_path.lstat().st_mode) != 0o700:
        raise Gate5Error("retained launcher payload is not mode 0700")
    launch_record = {
        "schema": "ura-gate5-tmux-launch/1",
        "status": "prepared",
        "prepared_at_utc": utc_now(),
        "covered_manifest_sha256": manifest_sha,
        "payload_template_sha256": template_digest,
        "payload": payload_desc,
        "prelaunch_storage_observations": prelaunch_storage_desc,
        "child_argv": child_argv,
        "output_root": str(output_root),
        "runnote_candidate": str(runnote_path),
    }
    launch_desc = write_create_only(
        control_root / "launch.json", canonical_bytes(launch_record)
    )
    tmux_argv = [
        "tmux", "-L", socket, "new-session", "-d", "-s", session,
        shlex.quote(str(payload_path)),
    ]
    try:
        result = subprocess.run(
            tmux_argv,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            check=False,
        )
    except OSError as exc:
        result = None
        error = str(exc)
    else:
        error = result.stderr.strip() or result.stdout.strip()
    if result is None or result.returncode != 0:
        write_create_only(control_root / "launch-failure.json", canonical_bytes({
            "schema": "ura-gate5-tmux-launch-failure/1",
            "status": "failed",
            "failed_at_utc": utc_now(),
            "tmux_argv": tmux_argv,
            "error": error[:2000],
        }))
        write_create_only(control_root / ".exit", b"1\n")
        raise Gate5Error(f"tmux launch failed: {error}")
    return {
        "status": "launched_in_tmux",
        "covered_manifest_sha256": manifest_sha,
        "session": session,
        "socket": socket,
        "attach": f"tmux -L {socket} attach -t {session}",
        "control_root": str(control_root),
        "payload": payload_desc,
        "launch_record": launch_desc,
        "log": str(control_root / "finalizer.log"),
        "exit_marker": str(control_root / ".exit"),
        "finalization_output_root": str(output_root),
        "runnote_candidate": str(runnote_path),
    }


def validate_payload_invocation(args: argparse.Namespace) -> None:
    if os.environ.get("URA_GATE5_PAYLOAD_EXECUTION") != "1":
        raise Gate5Error("internal payload execution lacks its launcher environment")
    if not args.payload_control_root:
        raise Gate5Error("internal payload execution lacks its control root")
    control_root = checked_dir(args.payload_control_root, label="payload control root")
    payload_path = checked_file(required_env("URA_GATE5_PAYLOAD_PATH"), max_bytes=4 * 1024 * 1024)
    try:
        payload_path.relative_to(control_root)
    except ValueError as exc:
        raise Gate5Error("payload path is outside its launcher control root") from exc
    launch = read_strict_json(control_root / "launch.json")
    if launch.get("schema") != "ura-gate5-tmux-launch/1":
        raise Gate5Error("payload launcher record has the wrong schema")
    template_digest = required_env("URA_GATE5_PAYLOAD_SHA256")
    if launch.get("payload_template_sha256") != template_digest:
        raise Gate5Error("payload template digest does not match launcher record")
    if launch.get("payload", {}).get("sha256") != sha256_file(payload_path):
        raise Gate5Error("payload bytes do not match launcher record")


def main(argv: Sequence[str]) -> int:
    args = parser().parse_args(list(argv))
    inventory_test = inventory_contract_self_test()
    if args.inventory_contract_self_test:
        print(json.dumps(inventory_test, sort_keys=True, separators=(",", ":")))
        return 0
    roots_supplied = any((
        args.core_projections_root,
        args.core_canaries_root,
        args.bridge_projections_root,
        args.bridge_canaries_root,
        args.ollama_projections_root,
        args.ollama_canaries_root,
    ))
    if args.lane_manifest and roots_supplied:
        raise Gate5Error("choose either --lane-manifest or the six control roots, not both")
    if not args.lane_manifest and not roots_supplied:
        raise Gate5Error("supply an explicit lane manifest or all six evidence control roots")
    if args.launch and args._payload_execute:
        raise Gate5Error("external --launch and internal payload execution are mutually exclusive")
    if args.payload_control_root and not args._payload_execute:
        raise Gate5Error("--payload-control-root is internal to the retained launcher payload")
    if args.authorize_manifest_sha256 and not (args.launch or args._payload_execute):
        raise Gate5Error("--authorize-manifest-sha256 is meaningful only with --launch")

    project_root = Path.cwd().resolve(strict=True)
    checkout = validate_checkout(project_root)
    project_receipt = validate_project_receipt(project_root)
    source_receipt = validate_source_receipt()
    manifest, input_evidence = build_covered_manifest(
        args,
        project_root,
        project_receipt=project_receipt,
        source_receipt=source_receipt,
    )
    manifest_payload = canonical_bytes(manifest)
    manifest_sha = sha256_bytes(manifest_payload)
    approval = {
        "kind": "operator_assertion",
        "approver": "project operator",
        "authentication": "operator_asserted",
        "covered_manifest_sha256": manifest_sha,
        "scope": (
            "exact frozen Gate-5 lane inventory, caps, call-start and "
            "measured-lane wall-time semantics, and external storage policy"
        ),
    }
    runnable_count = sum(row["disposition"] == "runnable" for row in manifest["lanes"])
    terminal_count = len(manifest["lanes"]) - runnable_count
    conditional_na_lanes = sorted(
        row["lane_id"] for row in manifest["lanes"]
        if row["disposition"] == DEFENSE_NA_DISPOSITION
    )
    target_runtime_terminal_count = sum(
        row["lane_id"] in RR_TERMINAL_LANES for row in manifest["lanes"]
    )
    if (runnable_count, terminal_count, tuple(conditional_na_lanes)) not in {
        (22, 24, ()),
        (21, 25, ("defense-local",)),
    }:
        raise Gate5Error("Gate-5 runnable/terminal/conditional N/A profile changed")
    if not args.launch and not args._payload_execute:
        print(json.dumps({
            "status": "validated_not_launched",
            "schema": MANIFEST_SCHEMA,
            "covered_manifest_sha256": manifest_sha,
            "runnable_lanes": runnable_count,
            "typed_terminal_lanes": terminal_count,
            "target_runtime_terminal": target_runtime_terminal_count,
            "conditional_na_lanes": conditional_na_lanes,
            "next_step": (
                "repeat the identical evidence arguments with --launch "
                f"--authorize-manifest-sha256 {manifest_sha}"
            ),
        }, sort_keys=True, separators=(",", ":")))
        return 0

    authorized = args.authorize_manifest_sha256.lower()
    if HEX64_RE.fullmatch(authorized) is None or authorized != manifest_sha:
        raise Gate5Error(
            "launch authorization does not cover the revalidated manifest digest; "
            f"observed digest is {manifest_sha}"
        )

    work = checked_dir(required_env("URA_WORK"), label="URA_WORK")
    if args.launch:
        launched = launch_payload(
            args=args,
            manifest_sha=manifest_sha,
            work=work,
        )
        print(json.dumps(launched, sort_keys=True, separators=(",", ":")))
        return 0

    validate_payload_invocation(args)

    started_tag = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    output_root = Path(args.output_root).expanduser() if args.output_root else (
        work / "runs" / "engineering" / f"phase5-gate5-final-{started_tag}"
    )
    runnote_path = Path(args.runnote_candidate).expanduser() if args.runnote_candidate else (
        work / "runs" / "thesis" / f"RUNNOTE.gate5-{started_tag}.candidate.md"
    )
    if output_root.exists() or output_root.is_symlink():
        raise Gate5Error(f"output root already exists: {output_root}")
    if runnote_path.exists() or runnote_path.is_symlink():
        raise Gate5Error(f"RUNNOTE candidate already exists: {runnote_path}")
    if runnote_path.name == "RUNNOTE.md":
        raise Gate5Error("the finalizer never writes the canonical RUNNOTE.md directly")
    checked_dir(output_root.parent, label="output-root parent")
    checked_dir(runnote_path.parent, label="RUNNOTE-candidate parent")
    storage = storage_observations(output_root, runnote_path)

    output_root = mkdir_create_only(output_root)
    lanes_root = output_root / "lanes"
    receipts_root = output_root / "receipts"
    os.mkdir(lanes_root, 0o700)
    os.mkdir(receipts_root, 0o700)
    manifest_desc = write_create_only(output_root / "covered-manifest.json", manifest_payload)
    approval_record = {**approval, "asserted_at_utc": utc_now()}
    approval_desc = write_create_only(
        output_root / "operator-approval.json", canonical_bytes(approval_record)
    )
    storage_desc = write_create_only(
        output_root / "storage-observations.json", canonical_bytes(storage)
    )
    input_desc = write_create_only(
        output_root / "input-evidence.json", canonical_bytes(input_evidence)
    )
    controller = ExecutionController(output_root=output_root, project_root=project_root)
    receipt_desc: dict[str, Any] | None = None
    runnote_desc: dict[str, Any] | None = None
    try:
        controller.event(
            "gate5_execution_started",
            covered_manifest_sha256=manifest_sha,
            approval=approval_record,
        )
        python = checked_project_python(project_root)
        model_store = checked_dir(required_env("URA_MODEL_STORE"), label="URA_MODEL_STORE")
        machine = machine_inventory(controller, python)
        executions: dict[str, dict[str, Any]] = {}
        for row in manifest["lanes"]:
            if row["disposition"] != "runnable":
                continue
            executions[row["lane_id"]] = execute_lane(
                lane=row,
                controller=controller,
                python=python,
                model_store=model_store,
                receipts_root=receipts_root,
            )
        completed_lanes: list[dict[str, Any]] = []
        for raw in manifest["lanes"]:
            row = dict(raw)
            if row["disposition"] == "runnable":
                row["execution"] = executions[row["lane_id"]]
                row["final_preflight"] = executions[row["lane_id"]]["final_preflight"]
            completed_lanes.append(row)
        note = {
            "schema": RUNNOTE_SCHEMA,
            "status": "candidate_complete",
            "created_at_utc": utc_now(),
            "candidate_only": True,
            "canonical_runnote_untouched": str(work / "runs" / "thesis" / "RUNNOTE.md"),
            "approval": approval_record,
            "covered_manifest": manifest_desc,
            "input_evidence": input_desc,
            "failed_attempts": manifest["failed_attempts"],
            "policy": manifest["policy"],
            "storage_observations": storage_desc,
            "checkout": checkout,
            "project_revision": project_receipt,
            "source_conformance": source_receipt,
            "system": machine,
            "routes": {
                "target": "local_only",
                "judges": ["rules", "local_guardrail_where_selected"],
                "hosted_target_calls": 0,
                "hosted_judge_calls": 0,
                "http_attempts": 0,
                "provider_quota": {"status": "N/A", "reason": "all_routes_are_local"},
                "monetary_cost": {"status": "CANNOT-VERIFY", "value": None},
            },
            "execution_accounting": {
                "finalizer_automatic_retries": 0,
                "interruptions": [],
                "upstream_attestation_candidate_failures_and_retries": [
                    {
                        "controller": label,
                        "root": control["root"],
                        "failed_candidates": control[
                            "upstream_attestation_candidate_failures"
                        ],
                        "retry_semantics": (
                            "upstream controller retained failed candidates and used unique "
                            "create-only retry roots; no failed candidate is Gate-5 evidence"
                        ),
                    }
                    for label, control in sorted(
                        input_evidence.get("controls", {}).items()
                    )
                    if control.get("upstream_attestation_candidate_failures")
                ],
                "prior_failed_attempts_excluded_from_gate5_evidence": [
                    {
                        "root": attempt["root"],
                        "status": attempt["status"],
                        "primary_failure": attempt["primary_failure"],
                        "secondary_failure": attempt["secondary_failure"],
                        "controller_exit_code": attempt["controller_exit_code"],
                        "evidence_accepted": False,
                    }
                    for attempt in manifest["failed_attempts"]
                ],
                "measured_rows_excluded": {"status": "N/A", "reason": "no measured run launched"},
                "typed_unavailable_or_not_applicable_lanes": [
                    {
                        "lane_id": row["lane_id"],
                        "disposition": row["disposition"],
                        "reason_code": row["reason_code"],
                        "reason": row["reason"],
                    }
                    for row in completed_lanes
                    if row["disposition"] != "runnable"
                ],
            },
            "future_measured_run": {
                "authorized": False,
                "requires_distinct_measured_purpose_plan_and_receipt": True,
                "diagnostic_canaries_are_empirical_benchmark_evidence": False,
            },
            "lanes": completed_lanes,
        }
        runnote_payload = runnote_markdown(note)
        runnote_desc = write_create_only(runnote_path, runnote_payload)
        controller.event("runnote_candidate_written", artifact=runnote_desc)
        controller.close()
        excluded = {output_root / "finalization-receipt.json", output_root / ".exit"}
        index = artifact_index(output_root, excluded=excluded)
        final_receipt = {
            "schema": CONTROLLER_SCHEMA,
            "status": "complete",
            "completed_at_utc": utc_now(),
            "covered_manifest_sha256": manifest_sha,
            "approval": approval_record,
            "manifest": manifest_desc,
            "approval_artifact": approval_desc,
            "storage_observations": storage_desc,
            "runnote_candidate": runnote_desc,
            "runnable_lanes": runnable_count,
            "typed_terminal_lanes": terminal_count,
            "target_runtime_terminal": target_runtime_terminal_count,
            "conditional_na_lanes": conditional_na_lanes,
            "downloads_observed_bytes": 0,
            "commands": controller.commands,
            "artifact_index_excludes_this_receipt_and_exit_marker": index,
        }
        receipt_desc = write_create_only(
            output_root / "finalization-receipt.json", canonical_bytes(final_receipt)
        )
        write_create_only(output_root / ".exit", b"0\n")
    except BaseException as exc:
        failure_payload = canonical_bytes({
            "schema": "ura-gate5-finalization-failure/1",
            "status": "failed",
            "failed_at_utc": utc_now(),
            "covered_manifest_sha256": manifest_sha,
            "error_type": type(exc).__name__,
            "error": str(exc)[:4000],
            "event_stream_was_closed": controller._closed,
        })
        # Failure evidence is independent of the event-stream state. In
        # particular, artifact indexing or receipt/exit publication can fail
        # after the event stream was durably closed.
        try:
            write_create_only(output_root / "failure.json", failure_payload)
        except BaseException:
            pass
        try:
            if not controller._closed:
                controller.event(
                    "gate5_execution_failed", error_type=type(exc).__name__, error=str(exc)
                )
            controller.close()
        except BaseException:
            pass
        try:
            if not (output_root / ".exit").exists():
                failure_exit = 130 if isinstance(exc, KeyboardInterrupt) else 1
                write_create_only(output_root / ".exit", f"{failure_exit}\n".encode("ascii"))
        except BaseException:
            pass
        raise
    print(json.dumps({
        "status": "complete",
        "covered_manifest_sha256": manifest_sha,
        "output_root": str(output_root),
        "finalization_receipt": receipt_desc,
        "runnote_candidate": runnote_desc,
        "canonical_runnote_modified": False,
        "measured_run_launched": False,
    }, sort_keys=True, separators=(",", ":")))
    return 0


try:
    raise SystemExit(main(sys.argv[1:]))
except Gate5Error as exc:
    print(f"Gate-5 finalization refused: {exc}", file=sys.stderr)
    raise SystemExit(2)
PY
