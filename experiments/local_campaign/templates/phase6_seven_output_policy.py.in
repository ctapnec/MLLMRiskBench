def _verified_file_descriptor(
    raw: object,
    *,
    label: str,
    parent: Path | None = None,
) -> Path:
    if not isinstance(raw, dict) or set(raw) != {"path", "sha256", "bytes"}:
        raise ValueError(f"{label} is not one exact file descriptor")
    raw_path = raw.get("path")
    raw_sha = raw.get("sha256")
    raw_bytes = raw.get("bytes")
    if not isinstance(raw_path, str) or not raw_path.startswith("/"):
        raise ValueError(f"{label}.path is not one absolute POSIX path")
    if (
        not isinstance(raw_sha, str)
        or len(raw_sha) != 64
        or any(character not in "0123456789abcdef" for character in raw_sha)
    ):
        raise ValueError(f"{label}.sha256 is not one lowercase SHA-256")
    if isinstance(raw_bytes, bool) or not isinstance(raw_bytes, int) or raw_bytes < 0:
        raise ValueError(f"{label}.bytes is not one nonnegative integer")
    candidate = Path(raw_path)
    if candidate.as_posix() != raw_path:
        raise ValueError(f"{label}.path is not canonical")
    resolved = candidate.resolve(strict=True)
    if candidate.is_symlink() or resolved != candidate or not candidate.is_file():
        raise ValueError(f"{label}.path is not one resolved regular file")
    if parent is not None:
        try:
            candidate.relative_to(parent)
        except ValueError as exc:
            raise ValueError(f"{label}.path escapes its bound directory") from exc
    payload = candidate.read_bytes()
    if len(payload) != raw_bytes or hashlib.sha256(payload).hexdigest() != raw_sha:
        raise ValueError(f"{label} content identity changed")
    return candidate


def _validated_input_value(
    value: object,
    *,
    schema: str,
    file_fields: frozenset[str],
    directory_artifacts: Mapping[str, frozenset[str]],
) -> tuple[dict[str, Path], dict[str, dict[str, Path]]]:
    expected_fields = {"schema", *file_fields, *directory_artifacts}
    if (
        not isinstance(value, dict)
        or set(value) != expected_fields
        or value.get("schema") != schema
    ):
        raise ValueError("bound recovery input manifest field set changed")
    paths = {
        key: _verified_file_descriptor(value[key], label=key)
        for key in sorted(file_fields)
    }
    artifacts: dict[str, dict[str, Path]] = {}
    for key, expected_roles in sorted(directory_artifacts.items()):
        raw = value.get(key)
        if not isinstance(raw, dict) or set(raw) != {"path", "artifacts"}:
            raise ValueError(f"{key} is not one exact directory dependency")
        raw_path = raw.get("path")
        raw_artifacts = raw.get("artifacts")
        if not isinstance(raw_path, str) or not raw_path.startswith("/"):
            raise ValueError(f"{key}.path is not one absolute POSIX path")
        root = Path(raw_path)
        if root.as_posix() != raw_path:
            raise ValueError(f"{key}.path is not canonical")
        resolved = root.resolve(strict=True)
        if root.is_symlink() or resolved != root or not root.is_dir():
            raise ValueError(f"{key}.path is not one resolved directory")
        if not isinstance(raw_artifacts, dict) or set(raw_artifacts) != expected_roles:
            raise ValueError(f"{key}.artifacts required role set changed")
        bound = {
            role: _verified_file_descriptor(
                raw_artifacts[role], label=f"{key}.artifacts.{role}", parent=root
            )
            for role in sorted(expected_roles)
        }
        if len(set(bound.values())) != len(bound):
            raise ValueError(f"{key}.artifacts aliases two required roles")
        paths[key] = root
        artifacts[key] = bound
    return paths, artifacts

def _bound_inputs(
    *,
    source: Path,
    expected_sha256: str,
    expected_bytes: int,
    schema: str,
    file_fields: frozenset[str],
    directory_artifacts: Mapping[str, frozenset[str]],
) -> tuple[dict[str, Path], dict[str, dict[str, Path]], dict[str, object]]:
    resolved_source = source.resolve(strict=True)
    if source.is_symlink() or resolved_source != source or not source.is_file():
        raise ValueError("bound recovery input manifest is not one resolved regular file")
    payload = source.read_bytes()
    if len(payload) != expected_bytes or hashlib.sha256(payload).hexdigest() != expected_sha256:
        raise ValueError("bound recovery input manifest identity changed")
    value = json.loads(payload.decode("utf-8"))
    paths, artifacts = _validated_input_value(
        value,
        schema=schema,
        file_fields=file_fields,
        directory_artifacts=directory_artifacts,
    )
    return paths, artifacts, value

