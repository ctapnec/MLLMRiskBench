H4RM3L_RUNTIME_CONFIG="$LAST_RUNTIME_CONFIG"
H4RM3L_RUNTIME_SHA="$LAST_RUNTIME_SHA"
make_runtime_config spikee
SPIKEE_RUNTIME_CONFIG="$LAST_RUNTIME_CONFIG"
SPIKEE_RUNTIME_SHA="$LAST_RUNTIME_SHA"

prepare_harmbench_canary
probe_qwen_text

run_isolated bridge-pyrit run_canary bridge-pyrit pyrit strongreject_official 1 1 \
  "$QWEN_TEXT_ATTEST" "$QWEN_TEXT_ATTEST_SHA" \
  --attacker-config "$PRIVATE_ROOT/attacker-pyrit.json" \
  --attacker-config-sha256 "$(sha256sum -- "$PRIVATE_ROOT/attacker-pyrit.json" | awk '{print $1}')" \
  --engine-runtime-config "$PYRIT_RUNTIME_CONFIG" \
  --engine-runtime-config-sha256 "$PYRIT_RUNTIME_SHA"

run_isolated bridge-deepteam run_canary bridge-deepteam deepteam strongreject_official 1 1 \
  "$QWEN_TEXT_ATTEST" "$QWEN_TEXT_ATTEST_SHA" \
  --attacker-config "$PRIVATE_ROOT/attacker-deepteam.json" \
  --attacker-config-sha256 "$(sha256sum -- "$PRIVATE_ROOT/attacker-deepteam.json" | awk '{print $1}')" \
  --engine-runtime-config "$DEEPTEAM_RUNTIME_CONFIG" \
  --engine-runtime-config-sha256 "$DEEPTEAM_RUNTIME_SHA"

run_isolated bridge-h4rm3l run_canary bridge-h4rm3l h4rm3l strongreject_official 4 4 \
  "$QWEN_TEXT_ATTEST" "$QWEN_TEXT_ATTEST_SHA" \
  --attacker-config "$PRIVATE_ROOT/attacker-h4rm3l.json" \
  --attacker-config-sha256 "$(sha256sum -- "$PRIVATE_ROOT/attacker-h4rm3l.json" | awk '{print $1}')" \
  --engine-runtime-config "$H4RM3L_RUNTIME_CONFIG" \
  --engine-runtime-config-sha256 "$H4RM3L_RUNTIME_SHA"

run_isolated bridge-spikee run_canary bridge-spikee spikee strongreject_official 4 4 \
  "$QWEN_TEXT_ATTEST" "$QWEN_TEXT_ATTEST_SHA" \
  --attacker-config "$PRIVATE_ROOT/attacker-spikee.json" \
  --attacker-config-sha256 "$(sha256sum -- "$PRIVATE_ROOT/attacker-spikee.json" | awk '{print $1}')" \
  --engine-runtime-config "$SPIKEE_RUNTIME_CONFIG" \
  --engine-runtime-config-sha256 "$SPIKEE_RUNTIME_SHA"

run_isolated bridge-purplellama run_canary bridge-purplellama purplellama cyberseceval_prompt_injection 1 1 \
  "$QWEN_TEXT_ATTEST" "$QWEN_TEXT_ATTEST_SHA"

run_isolated harmbench-replay run_canary harmbench-replay harmbench harmbench_text 1 1 \
  "$QWEN_TEXT_ATTEST" "$QWEN_TEXT_ATTEST_SHA" \
  --attacker-config "$HB_CANARY_CONFIG" \
  --attacker-config-sha256 "$(sha256sum -- "$HB_CANARY_CONFIG" | awk '{print $1}')"

printf 'bridge-nanogcg\tunavailable\tthe attributable NanoGCG suffix is assigned to a separate follow-on cohort and is not bound to this core cohort\n' >> "$DISPOSITIONS"
printf 'bridge-ideator\tunavailable\tthe source-mapped IDEATOR seed pairs are assigned to a separate follow-on cohort and are not bound to this core cohort\n' >> "$DISPOSITIONS"
printf 't3mp3st\tunavailable\tthe pinned T3MP3ST capture and replay are assigned to a separate follow-on cohort and are not bound to this core cohort\n' >> "$DISPOSITIONS"

IFS=$'\t' read -r TARGET_ATTEMPTS SUCCESSFUL_TARGET_GENERATIONS < <(
"$PY" - "$STATUS" "$ATTEST_STATUS" "$DISPOSITIONS" <<'PY'
import csv
import sys

from experiments.local_campaign.target_execution import aggregate_target_execution

with open(sys.argv[1], encoding="utf-8", newline="") as handle:
    rows = list(csv.DictReader(handle, delimiter="\t"))
if len(rows) != 6:
    raise SystemExit(f"expected six runnable bridge canaries, found {len(rows)}")
expected = {
    "bridge-pyrit", "bridge-deepteam", "bridge-h4rm3l", "bridge-spikee",
    "bridge-purplellama", "harmbench-replay",
}
if {row["lane"] for row in rows} != expected:
    raise SystemExit("completed bridge canary lane inventory drift")
for row in rows:
    if row["all_configured_stages_represented"] != "true":
        raise SystemExit(f"{row['lane']}: incomplete scoring-stage reachability")
    if row["target_status"] != "exercised" or row["attacker_status"] != "exercised":
        raise SystemExit(f"{row['lane']}: target or attacker was not exercised")
    expected_source = (
        "not_exercised" if row["lane"] == "bridge-purplellama" else "not_applicable"
    )
    if row["source_evaluator_status"] != expected_source:
        raise SystemExit(f"{row['lane']}: source-evaluator status is not exact")

with open(sys.argv[2], encoding="utf-8", newline="") as handle:
    attestations = list(csv.DictReader(handle, delimiter="\t"))
if len(attestations) != 1:
    raise SystemExit("expected one bridge target attestation")
attestation = attestations[0]
if (attestation["target"], attestation["modality"]) != ("qwen3-vl", "text"):
    raise SystemExit("bridge target attestation inventory drift")

with open(sys.argv[3], encoding="utf-8", newline="") as handle:
    dispositions = list(csv.DictReader(handle, delimiter="\t"))
expected_dispositions = {
    "bridge-nanogcg": "unavailable",
    "bridge-ideator": "unavailable",
    "t3mp3st": "unavailable",
}
if {row["lane"]: row["disposition"] for row in dispositions} != expected_dispositions:
    raise SystemExit("typed unavailable-lane disposition inventory drift")
print(*aggregate_target_execution([*rows, attestation]), sep="\t")
PY
)
PYTHONDONTWRITEBYTECODE=1 "$PY" -m experiments.local_campaign.console_events \
  target-execution --work-root "$URA_WORK" --control-root "$CONTROL_ROOT" \
  --target-attempts "$TARGET_ATTEMPTS" \
  --successful-target-generations "$SUCCESSFUL_TARGET_GENERATIONS"

printf 'PHASE5_BRIDGE_CANARIES_COMPLETE=%s\n' "$(date -Is)"
INNER
)"

PAYLOAD_PATH="$CONTROL_ROOT/payload.sh"
test ! -e "$PAYLOAD_PATH"
(
  set -o noclobber
  umask 077
  printf '%s\n' "$PAYLOAD" > "$PAYLOAD_PATH"
)
chmod 700 "$PAYLOAD_PATH"
test -f "$PAYLOAD_PATH" && test ! -L "$PAYLOAD_PATH"
tmux -L "$SOCKET" new-session -d -s "$SESSION" \
  "exec bash $(printf '%q' "$PAYLOAD_PATH")"

printf 'SESSION=%s\n' "$SESSION"
printf 'SOCKET=%s\n' "$SOCKET"
printf 'ATTACH=tmux -L %s attach -t %s\n' "$SOCKET" "$SESSION"
printf 'CONTROL_ROOT=%s\n' "$CONTROL_ROOT"
printf 'LOG=%s/phase5-bridge-canaries.log\n' "$CONTROL_ROOT"
printf 'EXIT_MARKER=%s/.exit\n' "$CONTROL_ROOT"
