#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

source ~/.ura_campaign_env

pin_controller_generation() {
  local script_fd="/proc/$$/fd/255" script_path root generations marker archive_sha
  test -e "$script_fd" || { printf 'controller script descriptor is unavailable\n' >&2; return 1; }
  script_path="$(readlink -f -- "$script_fd")"
  test -f "$script_path" && test ! -L "$script_path"
  root="${script_path%/*}"
  generations="${root%/*}"
  test "${generations##*/}" = '.ura-controller-generations'
  test -d "$root" && test ! -L "$root"
  marker="$root/.ura-controller-generation.tsv"
  test -f "$marker" && test ! -L "$marker"
  test "$(grep -Fxc -- $'schema\tura-controller-generation/1' "$marker")" = '1'
  test "$(grep -Fxc -- $'expected_commit\t@@EXPECTED_COMMIT@@' "$marker")" = '1'
  archive_sha="${root##*-}"
  [[ "$archive_sha" =~ ^[0-9a-f]{64}$ ]]
  test "${root##*/}" = "@@COMMIT_SHORT@@-$archive_sha"
  test "$(grep -Fxc -- $'archive_sha256\t'"$archive_sha" "$marker")" = '1'
  if [[ -n "${URA_CONTROLLER_GENERATION_ROOT-}" ]]; then
    test "$URA_CONTROLLER_GENERATION_ROOT" = "$root"
  fi
  URA_CONTROLLER_GENERATION_ROOT="$root"
  export URA_CONTROLLER_GENERATION_ROOT
}
pin_controller_generation
readonly URA_CONTROLLER_GENERATION_ROOT

cd ~/MLLMRiskBench

EXPECTED_COMMIT='@@EXPECTED_COMMIT@@'
EXPECTED_PROJECT_RECEIPT='@@PROJECT_RECEIPT_PATH@@'
EXPECTED_PROJECT_RECEIPT_SHA256='@@PROJECT_RECEIPT_SHA256@@'
EXPECTED_SOURCE_RECEIPT='@@SOURCE_RECEIPT_PATH@@'
EXPECTED_SOURCE_RECEIPT_SHA256='@@SOURCE_RECEIPT_SHA256@@'
PHASE5_SEQUENCE_SESSION='ura-phase5-sequence-@@COMMIT_SHORT@@'
PHASE5_SEQUENCE_SOCKET='ura-phase5-sequence-@@COMMIT_SHORT@@'
PHASE5_SEQUENCE_ROOT='@@WORK_ROOT@@/runs/engineering/phase5-sequence-@@PHASE5_SEQUENCE_TAG@@'
FINALIZER="$URA_CONTROLLER_GENERATION_ROOT/phase5_finalize_gate5.sh"
FINALIZER_SHA256='@@SHA:phase5_finalize_gate5.sh@@'
PROMOTER="$URA_CONTROLLER_GENERATION_ROOT/phase5_promote_gate5.sh"
PROMOTER_SHA256='@@SHA:phase5_promote_gate5.sh@@'
TAG="${GATE5_SEQUENCE_TAG:-$(date -u +%Y%m%dT%H%M%SZ)}"
case "$TAG" in
  20[0-9][0-9][01][0-9][0-3][0-9]T[0-2][0-9][0-5][0-9][0-5][0-9]Z) ;;
  *) printf 'invalid Gate 5 sequence tag\n' >&2; exit 1 ;;
esac
CONTROL_ROOT="$URA_WORK/runs/engineering/gate5-after-phase5-$TAG"
LOG="$CONTROL_ROOT/controller.log"
EXIT_TMP="$CONTROL_ROOT/.exit.tmp"
EXIT_MARKER="$CONTROL_ROOT/.exit"
COMPLETION="$CONTROL_ROOT/completion.json"
PY="$PWD/.venv/bin/python"
CONTROL_HARD_STOP_HOURS=24
test "$CONTROL_HARD_STOP_HOURS" = '24'

test "$(git rev-parse HEAD)" = "$EXPECTED_COMMIT"
test -z "$(git status --porcelain)"
test "$URA_PROJECT_REVISION_MANIFEST" = "$EXPECTED_PROJECT_RECEIPT"
test "$URA_PROJECT_REVISION_SHA256" = "$EXPECTED_PROJECT_RECEIPT_SHA256"
test "$URA_SOURCE_CONFORMANCE_MANIFEST" = "$EXPECTED_SOURCE_RECEIPT"
test "$URA_SOURCE_CONFORMANCE_SHA256" = "$EXPECTED_SOURCE_RECEIPT_SHA256"
test -f "$FINALIZER" && test ! -L "$FINALIZER"
test -f "$PROMOTER" && test ! -L "$PROMOTER"
test "$(sha256sum -- "$FINALIZER" | awk '{print $1}')" = "$FINALIZER_SHA256"
test "$(sha256sum -- "$PROMOTER" | awk '{print $1}')" = "$PROMOTER_SHA256"
bash -n "$FINALIZER"
bash -n "$PROMOTER"
test -x "$PY"

export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HF_DATASETS_OFFLINE=1
unset HF_TOKEN HUGGING_FACE_HUB_TOKEN OPENAI_API_KEY ANTHROPIC_API_KEY \
  GOOGLE_API_KEY GEMINI_API_KEY MISTRAL_API_KEY TOGETHER_API_KEY \
  DEEPSEEK_API_KEY XAI_API_KEY

test ! -e "$CONTROL_ROOT"
mkdir -m 700 "$CONTROL_ROOT"
exec > >(tee "$LOG") 2>&1

CONTROL_TASKS=(
  await-phase5
  validate-evidence
  finalize-gate5
  prepare-promotion
  promote-runnote
  sequence-completion
)
CONTROL_TASK_INDEX=0
CONTROL_ACTIVE_TASK=''
CONTROL_FAILURE_DETAIL=''
CONSOLE_CAMPAIGN_STARTED=0

console_event() {
  PYTHONDONTWRITEBYTECODE=1 "$PY" -m experiments.local_campaign.console_events event \
    --work-root "$URA_WORK" --control-root "$CONTROL_ROOT" \
    --event "$1" --task "$2" --status "$3" --detail "$4"
}

controller_task_start() {
  local task="$1"
  test -z "$CONTROL_ACTIVE_TASK"
  test "${CONTROL_TASKS[$CONTROL_TASK_INDEX]}" = "$task"
  CONTROL_ACTIVE_TASK="$task"
  console_event task_start "$task" running "${task}_started"
}

controller_task_pass() {
  local task="$1"
  test "$CONTROL_ACTIVE_TASK" = "$task"
  console_event task_end "$task" passed "${task}_complete"
  CONTROL_ACTIVE_TASK=''
  CONTROL_TASK_INDEX=$((CONTROL_TASK_INDEX + 1))
}

controller_finish() {
  local rc="$1" task status=failed failure_detail
  failure_detail="controller_exit_$rc"
  if [ -n "$CONTROL_FAILURE_DETAIL" ]; then
    failure_detail="$CONTROL_FAILURE_DETAIL"
  fi
  test "$CONSOLE_CAMPAIGN_STARTED" = '1' || return 0
  if [ -n "$CONTROL_ACTIVE_TASK" ]; then
    task="$CONTROL_ACTIVE_TASK"
    console_event task_end "$task" failed "$failure_detail" || \
      printf 'console event failed: task_end %s\n' "$task" >&2
    CONTROL_ACTIVE_TASK=''
    CONTROL_TASK_INDEX=$((CONTROL_TASK_INDEX + 1))
  fi
  while [ "$CONTROL_TASK_INDEX" -lt "${#CONTROL_TASKS[@]}" ]; do
    task="${CONTROL_TASKS[$CONTROL_TASK_INDEX]}"
    console_event task_skip "$task" skipped "not_reached_after_${failure_detail}" || \
      printf 'console event failed: task_skip %s\n' "$task" >&2
    CONTROL_TASK_INDEX=$((CONTROL_TASK_INDEX + 1))
  done
  test "$rc" -ne 0 || status=passed
  console_event campaign_end bootstrap "$status" "local_campaign_${failure_detail}" || \
    printf 'console event failed: campaign_end\n' >&2
  return 0
}

finish() {
  rc=$?
  trap - EXIT
  printf '%s\n' "$rc" > "$EXIT_TMP"
  test ! -e "$EXIT_MARKER"
  mv -- "$EXIT_TMP" "$EXIT_MARKER"
  controller_finish "$rc"
  printf 'GATE5_SEQUENCE_EXIT=%s\n' "$rc"
  exit "$rc"
}
trap finish EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

CONTROL_HARD_STOP_DEADLINE=$((SECONDS + CONTROL_HARD_STOP_HOURS * 3600))

controller_hard_stop_check() {
  local wait_label="$1" owned_socket="${2:-}" owned_session="${3:-}"
  if (( SECONDS >= CONTROL_HARD_STOP_DEADLINE )); then
    CONTROL_FAILURE_DETAIL="controller_hard_stop_exceeded_wait_${wait_label}_hours_${CONTROL_HARD_STOP_HOURS}"
    printf 'CONTROLLER_HARD_STOP_EXCEEDED=1 WAIT=%s HOURS=%s\n' \
      "$wait_label" "$CONTROL_HARD_STOP_HOURS" >&2
    if [ -n "$owned_socket" ] || [ -n "$owned_session" ]; then
      if [ -z "$owned_socket" ] || [ -z "$owned_session" ]; then
        printf 'CONTROLLER_HARD_STOP_INVALID_OWNED_SESSION=1 WAIT=%s\n' \
          "$wait_label" >&2
        exit 124
      fi
      if tmux -L "$owned_socket" has-session -t "$owned_session" 2>/dev/null; then
        tmux -L "$owned_socket" kill-session -t "$owned_session" 2>/dev/null || true
      fi
      if tmux -L "$owned_socket" has-session -t "$owned_session" 2>/dev/null; then
        printf 'CONTROLLER_HARD_STOP_OWNED_SESSION_STILL_LIVE=1 WAIT=%s SOCKET=%s SESSION=%s\n' \
          "$wait_label" "$owned_socket" "$owned_session" >&2
        exit 124
      fi
    fi
    exit 124
  fi
}

CONSOLE_START_ARGS=(
  --work-root "$URA_WORK"
  --control-root "$CONTROL_ROOT"
  --campaign-id "${CONTROL_ROOT##*/}"
  --release-commit "$EXPECTED_COMMIT"
  --evidence-class local_campaign_control
  --hard-stop-hours "$CONTROL_HARD_STOP_HOURS"
  --tmux-socket ura-gate5-after-phase5-@@COMMIT_SHORT@@
  --tmux-session ura-gate5-after-phase5-@@COMMIT_SHORT@@
)
for task in "${CONTROL_TASKS[@]}"; do
  CONSOLE_START_ARGS+=(--planned-task "$task")
done
PYTHONDONTWRITEBYTECODE=1 "$PY" -m experiments.local_campaign.console_events start \
  "${CONSOLE_START_ARGS[@]}"
CONSOLE_CAMPAIGN_STARTED=1

controller_task_start await-phase5

controller_hard_stop_check await-phase5
while tmux -L "$PHASE5_SEQUENCE_SOCKET" has-session -t "$PHASE5_SEQUENCE_SESSION" 2>/dev/null; do
  controller_hard_stop_check await-phase5
  sleep 30
done
controller_hard_stop_check await-phase5
test -f "$PHASE5_SEQUENCE_ROOT/.exit" && test ! -L "$PHASE5_SEQUENCE_ROOT/.exit"
test "$(tr -d '\r\n' < "$PHASE5_SEQUENCE_ROOT/.exit")" = '0'

step_root() {
  local step="$1"
  "$PWD/.venv/bin/python" - "$PHASE5_SEQUENCE_ROOT/steps.tsv" "$step" <<'PY'
import csv
from pathlib import Path
import sys

path, step = Path(sys.argv[1]), sys.argv[2]
with path.open(encoding="utf-8", newline="") as handle:
    rows = [
        row for row in csv.DictReader(handle, delimiter="\t")
        if row.get("step") == step and row.get("status") == "complete"
    ]
if len(rows) != 1:
    raise SystemExit(f"{step}: expected one completed sequence row, found {len(rows)}")
root = Path(rows[0]["control_root"])
if not root.is_absolute() or root.is_symlink() or not root.is_dir():
    raise SystemExit(f"{step}: unsafe controller root")
print(root)
PY
}

CORE_PROJECTIONS_ROOT="$(step_root core-projections)"
CORE_CANARIES_ROOT="$(step_root core-canaries)"
BRIDGE_PROJECTIONS_ROOT="$(step_root bridge-projections)"
BRIDGE_CANARIES_ROOT="$(step_root bridge-canaries)"
OLLAMA_ROOT="$(step_root ollama)"

for root in \
  "$CORE_PROJECTIONS_ROOT" "$CORE_CANARIES_ROOT" "$BRIDGE_PROJECTIONS_ROOT" \
  "$BRIDGE_CANARIES_ROOT" "$OLLAMA_ROOT"; do
  test -d "$root" && test ! -L "$root"
  test -f "$root/.exit" && test ! -L "$root/.exit"
  test "$(tr -d '\r\n' < "$root/.exit")" = '0'
done

FAILED_ONE="$URA_WORK/runs/engineering/phase5-core-canaries-@@FAILED_CANARY_ONE_TAG@@"
FAILED_TWO="$URA_WORK/runs/engineering/phase5-core-canaries-@@FAILED_CANARY_TWO_TAG@@"
FAILED_THREE="$URA_WORK/runs/engineering/phase5-core-canaries-@@FAILED_CANARY_THREE_TAG@@"
for root in "$FAILED_ONE" "$FAILED_TWO" "$FAILED_THREE"; do
  test -d "$root" && test ! -L "$root"
done
controller_task_pass await-phase5

controller_task_start validate-evidence
EVIDENCE_ARGS=(
  --core-projections-root "$CORE_PROJECTIONS_ROOT"
  --core-canaries-root "$CORE_CANARIES_ROOT"
  --bridge-projections-root "$BRIDGE_PROJECTIONS_ROOT"
  --bridge-canaries-root "$BRIDGE_CANARIES_ROOT"
  --ollama-projections-root "$OLLAMA_ROOT"
  --ollama-canaries-root "$OLLAMA_ROOT"
  --failed-attempt-root "$FAILED_ONE"
  --failed-attempt-root "$FAILED_TWO"
  --failed-attempt-root "$FAILED_THREE"
)

VALIDATION="$CONTROL_ROOT/finalizer-validation.json"
test ! -e "$VALIDATION"
bash "$FINALIZER" "${EVIDENCE_ARGS[@]}" > "$VALIDATION"
mapfile -d '' -t VALIDATION_VALUES < <(
"$PWD/.venv/bin/python" - "$VALIDATION" <<'PY'
import json
from pathlib import Path
import re
import sys
from experiments.local_campaign.ollama_static_terminal import (
    OLLAMA_STATIC_TERMINAL_LANES,
    historical_inventory_counts as inventory_counts,
)
from ura.strict_json import strict_json_loads

def exact_profile(runnable, terminal, target_runtime_terminal, conditional):
    ollama_terminal = target_runtime_terminal - 4
    if not 0 <= ollama_terminal <= len(OLLAMA_STATIC_TERMINAL_LANES):
        return False
    try:
        profile = inventory_counts(
            OLLAMA_STATIC_TERMINAL_LANES[:ollama_terminal], conditional
        )
    except (TypeError, ValueError):
        return False
    return (
        runnable == profile["runnable"]
        and terminal == profile["typed_terminal"]
        and target_runtime_terminal == profile["target_runtime_terminal"]
    )

if (
    not exact_profile(22, 24, 4, [])
    or not exact_profile(21, 25, 4, ["defense-local"])
    or not exact_profile(21, 25, 5, [])
    or not exact_profile(20, 26, 5, ["defense-local"])
    or not exact_profile(20, 26, 6, [])
    or not exact_profile(19, 27, 6, ["defense-local"])
    or not exact_profile(19, 27, 7, [])
    or not exact_profile(18, 28, 7, ["defense-local"])
    or any(exact_profile(*row) for row in (
        (22, 24, 4, ["defense-local"]),
        (21, 25, 4, []),
        (21, 25, 4, ["forged"]),
        (21, 25, 3, ["defense-local"]),
        (20, 26, 4, ["defense-local"]),
        (20, 26, 5, []),
        (19, 27, 7, ["defense-local"]),
        (18, 28, 4, ["defense-local"]),
    ))
):
    raise SystemExit("Gate 5 profile mutation self-test failed")

value = strict_json_loads(Path(sys.argv[1]).read_bytes())
if (
    not isinstance(value, dict)
    or value.get("status") != "validated_not_launched"
    or value.get("schema") != "ura-gate5-covered-manifest/1"
    or not exact_profile(
        value.get("runnable_lanes"), value.get("typed_terminal_lanes"),
        value.get("target_runtime_terminal"),
        value.get("conditional_na_lanes"),
    )
    or re.fullmatch(r"[0-9a-f]{64}", str(value.get("covered_manifest_sha256"))) is None
):
    raise SystemExit("Gate 5 validation-only result changed")
print(value["covered_manifest_sha256"], end="\0")
print(value["runnable_lanes"], end="\0")
print(value["typed_terminal_lanes"], end="\0")
print(value["target_runtime_terminal"], end="\0")
print(json.dumps(value["conditional_na_lanes"], separators=(",", ":")), end="\0")
PY
)
test "${#VALIDATION_VALUES[@]}" -eq 5
MANIFEST_SHA="${VALIDATION_VALUES[0]}"
RUNNABLE_LANES="${VALIDATION_VALUES[1]}"
TYPED_TERMINAL_LANES="${VALIDATION_VALUES[2]}"
TARGET_RUNTIME_TERMINAL="${VALIDATION_VALUES[3]}"
CONDITIONAL_NA_LANES_JSON="${VALIDATION_VALUES[4]}"
controller_task_pass validate-evidence

controller_task_start finalize-gate5
LAUNCH_RESULT="$CONTROL_ROOT/finalizer-launch.json"
test ! -e "$LAUNCH_RESULT"
bash "$FINALIZER" "${EVIDENCE_ARGS[@]}" --launch \
  --authorize-manifest-sha256 "$MANIFEST_SHA" > "$LAUNCH_RESULT"
mapfile -d '' -t FINALIZER_VALUES < <(
  "$PWD/.venv/bin/python" - "$LAUNCH_RESULT" "$MANIFEST_SHA" <<'PY'
from pathlib import Path
import sys
from experiments.local_campaign.ollama_static_terminal import (
    OLLAMA_STATIC_TERMINAL_LANES,
    historical_inventory_counts as inventory_counts,
)
from ura.strict_json import strict_json_loads

value = strict_json_loads(Path(sys.argv[1]).read_bytes())
if (
    not isinstance(value, dict)
    or value.get("status") != "launched_in_tmux"
    or value.get("covered_manifest_sha256") != sys.argv[2]
):
    raise SystemExit("Gate 5 finalizer launch record changed")
for key in (
    "session", "socket", "control_root", "exit_marker",
    "finalization_output_root", "runnote_candidate",
):
    item = value.get(key)
    if not isinstance(item, str) or not item:
        raise SystemExit(f"Gate 5 launch omitted {key}")
    print(item, end="\0")
PY
)
test "${#FINALIZER_VALUES[@]}" -eq 6
FINALIZER_SESSION="${FINALIZER_VALUES[0]}"
FINALIZER_SOCKET="${FINALIZER_VALUES[1]}"
FINALIZER_CONTROL="${FINALIZER_VALUES[2]}"
FINALIZER_EXIT="${FINALIZER_VALUES[3]}"
FINALIZATION_ROOT="${FINALIZER_VALUES[4]}"
RUNNOTE_CANDIDATE="${FINALIZER_VALUES[5]}"

controller_hard_stop_check finalize-gate5 "$FINALIZER_SOCKET" "$FINALIZER_SESSION"
while tmux -L "$FINALIZER_SOCKET" has-session -t "$FINALIZER_SESSION" 2>/dev/null; do
  controller_hard_stop_check finalize-gate5 "$FINALIZER_SOCKET" "$FINALIZER_SESSION"
  sleep 30
done
controller_hard_stop_check finalize-gate5 "$FINALIZER_SOCKET" "$FINALIZER_SESSION"
test -f "$FINALIZER_EXIT" && test ! -L "$FINALIZER_EXIT"
test "$(tr -d '\r\n' < "$FINALIZER_EXIT")" = '0'
test -f "$FINALIZATION_ROOT/.exit" && test ! -L "$FINALIZATION_ROOT/.exit"
test "$(tr -d '\r\n' < "$FINALIZATION_ROOT/.exit")" = '0'
controller_task_pass finalize-gate5

controller_task_start prepare-promotion
COVERED_MANIFEST="$FINALIZATION_ROOT/covered-manifest.json"
FINALIZATION_RECEIPT="$FINALIZATION_ROOT/finalization-receipt.json"
PROMOTION_PROPOSAL="$CONTROL_ROOT/promotion-proposal.json"
test -f "$COVERED_MANIFEST" && test ! -L "$COVERED_MANIFEST"
test -f "$RUNNOTE_CANDIDATE" && test ! -L "$RUNNOTE_CANDIDATE"
test -f "$FINALIZATION_RECEIPT" && test ! -L "$FINALIZATION_RECEIPT"
test ! -e "$PROMOTION_PROPOSAL"
bash "$PROMOTER" \
  --covered-manifest "$COVERED_MANIFEST" \
  --runnote-candidate "$RUNNOTE_CANDIDATE" \
  --finalization-receipt "$FINALIZATION_RECEIPT" > "$PROMOTION_PROPOSAL"

mapfile -d '' -t PROMOTION_VALUES < <(
  "$PWD/.venv/bin/python" - "$PROMOTION_PROPOSAL" <<'PY'
from pathlib import Path
import re
import sys
from ura.strict_json import strict_json_loads

value = strict_json_loads(Path(sys.argv[1]).read_bytes())
plan = value.get("promotion_plan") if isinstance(value, dict) else None
if (
    value.get("schema") != "ura-gate5-runnote-promotion-plan/1"
    or value.get("status") != "validated_candidate_only"
    or value.get("canonical_runnote_modified") is not False
    or not isinstance(plan, dict)
    or set(plan) != {"path", "sha256", "bytes"}
    or value.get("promotion_plan_sha256") != plan.get("sha256")
    or re.fullmatch(r"[0-9a-f]{64}", str(plan.get("sha256"))) is None
):
    raise SystemExit("Gate 5 promotion proposal changed")
print(plan["path"], end="\0")
print(plan["sha256"], end="\0")
PY
)
test "${#PROMOTION_VALUES[@]}" -eq 2
PROMOTION_PLAN="${PROMOTION_VALUES[0]}"
PROMOTION_SHA="${PROMOTION_VALUES[1]}"
controller_task_pass prepare-promotion

controller_task_start promote-runnote
PROMOTION_RESULT="$CONTROL_ROOT/promotion-result.json"
test ! -e "$PROMOTION_RESULT"
bash "$PROMOTER" --promotion-plan "$PROMOTION_PLAN" \
  --authorize-plan-sha256 "$PROMOTION_SHA" > "$PROMOTION_RESULT"
controller_task_pass promote-runnote

controller_task_start sequence-completion
"$PWD/.venv/bin/python" - "$COMPLETION" "$VALIDATION" "$LAUNCH_RESULT" \
  "$FINALIZER_CONTROL" "$FINALIZATION_ROOT" "$RUNNOTE_CANDIDATE" \
  "$PROMOTION_PROPOSAL" "$PROMOTION_RESULT" "$PROMOTION_PLAN" \
  "$MANIFEST_SHA" "$PROMOTION_SHA" "$RUNNABLE_LANES" \
  "$TYPED_TERMINAL_LANES" "$TARGET_RUNTIME_TERMINAL" \
  "$CONDITIONAL_NA_LANES_JSON" <<'PY'
from datetime import datetime, timezone
import hashlib
import json
import os
from pathlib import Path
import sys
from experiments.local_campaign.ollama_static_terminal import (
    OLLAMA_STATIC_TERMINAL_LANES,
    historical_inventory_counts as inventory_counts,
)
from ura.strict_json import strict_json_loads

(
    out_value, validation_value, launch_value, finalizer_control_value,
    finalization_value, candidate_value, proposal_value, result_value,
    plan_value, manifest_sha, promotion_sha, runnable_text, terminal_text,
    target_runtime_terminal_text, conditional_json,
) = sys.argv[1:]
runnable = int(runnable_text)
typed_terminal = int(terminal_text)
target_runtime_terminal = int(target_runtime_terminal_text)
conditional_na_lanes = strict_json_loads(conditional_json)
def exact_profile(runnable_value, terminal_value, target_value, conditional_value):
    ollama_terminal = target_value - 4
    if not 0 <= ollama_terminal <= len(OLLAMA_STATIC_TERMINAL_LANES):
        return False
    try:
        profile = inventory_counts(
            OLLAMA_STATIC_TERMINAL_LANES[:ollama_terminal], conditional_value
        )
    except (TypeError, ValueError):
        return False
    return (
        runnable_value == profile["runnable"]
        and terminal_value == profile["typed_terminal"]
        and target_value == profile["target_runtime_terminal"]
    )

if (
    not exact_profile(22, 24, 4, [])
    or not exact_profile(21, 25, 4, ["defense-local"])
    or not exact_profile(21, 25, 5, [])
    or not exact_profile(20, 26, 5, ["defense-local"])
    or not exact_profile(20, 26, 6, [])
    or not exact_profile(19, 27, 6, ["defense-local"])
    or not exact_profile(19, 27, 7, [])
    or not exact_profile(18, 28, 7, ["defense-local"])
    or any(exact_profile(*row) for row in (
        (22, 24, 4, ["defense-local"]),
        (21, 25, 4, []),
        (21, 25, 4, ["forged"]),
        (21, 25, 3, ["defense-local"]),
        (20, 26, 4, ["defense-local"]),
        (20, 26, 5, []),
        (19, 27, 7, ["defense-local"]),
        (18, 28, 4, ["defense-local"]),
    ))
):
    raise SystemExit("Gate 5 completion profile mutation self-test failed")
if not exact_profile(
    runnable, typed_terminal, target_runtime_terminal, conditional_na_lanes
):
    raise SystemExit("Gate 5 completion inventory profile changed")

def descriptor(path: Path) -> dict[str, object]:
    if path.is_symlink() or not path.is_file():
        raise SystemExit(f"unsafe Gate 5 sequence artifact: {path}")
    payload = path.read_bytes()
    return {"path": str(path.resolve(strict=True)), "sha256": hashlib.sha256(payload).hexdigest(), "bytes": len(payload)}

result_path = Path(result_value)
result = strict_json_loads(result_path.read_bytes())
if (
    not isinstance(result, dict)
    or result.get("schema") != "ura-gate5-runnote-promotion/1"
    or result.get("status") != "complete"
    or result.get("promotion_plan_sha256") != promotion_sha
    or result.get("canonical_runnote_mode") != "0600"
    or result.get("canonical_runnote_link_count") != 1
    or result.get("model_or_job_launched") is not False
):
    raise SystemExit("Gate 5 promotion result changed")
canonical = result.get("canonical_runnote")
receipt = result.get("promotion_receipt")
for label, value in (("canonical", canonical), ("receipt", receipt)):
    if not isinstance(value, dict) or set(value) != {"path", "sha256", "bytes"}:
        raise SystemExit(f"Gate 5 {label} descriptor changed")
    if descriptor(Path(value["path"])) != value:
        raise SystemExit(f"Gate 5 {label} bytes changed")

finalization = Path(finalization_value)
finalizer_control = Path(finalizer_control_value)
validation = strict_json_loads(Path(validation_value).read_bytes())
finalization_receipt = strict_json_loads(
    (finalization / "finalization-receipt.json").read_bytes()
)
promotion_plan = strict_json_loads(Path(plan_value).read_bytes())
promotion_receipt = strict_json_loads(Path(receipt["path"]).read_bytes())
expected_counts = {
    "total": 46,
    "runnable": runnable,
    "typed_terminal": typed_terminal,
    "conditional_na_lanes": conditional_na_lanes,
    "bridge_terminal": 3,
    "ollama_transport_terminal": 3,
    "target_runtime_terminal": target_runtime_terminal,
    "portfolio_terminal": 5,
    "native_terminal": 9,
}
if (
    validation.get("runnable_lanes") != runnable
    or validation.get("typed_terminal_lanes") != typed_terminal
    or validation.get("target_runtime_terminal") != target_runtime_terminal
    or validation.get("conditional_na_lanes") != conditional_na_lanes
    or finalization_receipt.get("runnable_lanes") != runnable
    or finalization_receipt.get("typed_terminal_lanes") != typed_terminal
    or finalization_receipt.get("target_runtime_terminal")
    != target_runtime_terminal
    or finalization_receipt.get("conditional_na_lanes") != conditional_na_lanes
    or promotion_plan.get("inventory_counts") != expected_counts
    or promotion_receipt.get("inventory_counts") != expected_counts
):
    raise SystemExit("Gate 5 validation/finalization/promotion inventory profiles differ")
value = {
    "schema": "ura-phase5-gate5-sequence-completion/1",
    "status": "complete",
    "completed_at_utc": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
    "covered_manifest_sha256": manifest_sha,
    "authorized_promotion_plan_sha256": promotion_sha,
    "validation_result": descriptor(Path(validation_value)),
    "launch_result": descriptor(Path(launch_value)),
    "finalizer_launch": descriptor(finalizer_control / "launch.json"),
    "finalizer_exit": descriptor(finalizer_control / ".exit"),
    "covered_manifest": descriptor(finalization / "covered-manifest.json"),
    "finalization_receipt": descriptor(finalization / "finalization-receipt.json"),
    "finalization_exit": descriptor(finalization / ".exit"),
    "runnote_candidate": descriptor(Path(candidate_value)),
    "promotion_proposal": descriptor(Path(proposal_value)),
    "promotion_plan": descriptor(Path(plan_value)),
    "promotion_result": descriptor(result_path),
    "canonical_runnote": canonical,
    "promotion_receipt": receipt,
    "runnable_lanes": runnable,
    "typed_terminal_lanes": typed_terminal,
    "target_runtime_terminal": target_runtime_terminal,
    "conditional_na_lanes": conditional_na_lanes,
    "downloads_observed_bytes": 0,
    "measured_run_launched": False,
}
payload = (json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=True, allow_nan=False) + "\n").encode("ascii")
out = Path(out_value)
if out.exists() or out.is_symlink():
    raise SystemExit("Gate 5 sequence completion is not create-only")
fd = os.open(out, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
with os.fdopen(fd, "wb") as handle:
    handle.write(payload)
    handle.flush()
    os.fsync(handle.fileno())
print(json.dumps({"status": "complete", "sha256": hashlib.sha256(payload).hexdigest()}, sort_keys=True))
PY
controller_task_pass sequence-completion

printf 'GATE5_SEQUENCE_COMPLETE=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
