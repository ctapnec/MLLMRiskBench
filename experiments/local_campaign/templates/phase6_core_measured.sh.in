except ValueError as exc:
    raise SystemExit("Phase 6 core controller exit code is invalid") from exc
if controller_exit_code not in {0, 1} or str(controller_exit_code) != controller_exit_value:
    raise SystemExit("Phase 6 core controller exit code must be exact 0 or 1")
completion_path = Path(completion_value)
