def digest(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()

def stable_regular_bytes(path: Path, label: str) -> tuple[Path, bytes]:
    try:
        unresolved_entry = path.lstat()
        resolved = path.resolve(strict=True)
        before = resolved.lstat()
    except OSError as exc:
        raise ValueError(f"{label} artifact is absent or unsafe") from exc
    if (
        not path.is_absolute()
        or path != resolved
        or stat.S_ISLNK(unresolved_entry.st_mode)
        or not stat.S_ISREG(before.st_mode)
        or (unresolved_entry.st_dev, unresolved_entry.st_ino)
        != (before.st_dev, before.st_ino)
    ):
        raise ValueError(f"{label} artifact is absent or unsafe")

    def identity(entry: os.stat_result) -> tuple[int, int, int, int, int]:
        return (
            entry.st_mode,
            entry.st_dev,
            entry.st_ino,
            entry.st_size,
            entry.st_mtime_ns,
        )

    try:
        fd = os.open(
            resolved,
            os.O_RDONLY
            | getattr(os, "O_BINARY", 0)
            | getattr(os, "O_NOFOLLOW", 0),
        )
    except OSError as exc:
        raise ValueError(f"{label} artifact changed while reading") from exc
    try:
        opened = os.fstat(fd)
        chunks: list[bytes] = []
        while True:
            chunk = os.read(fd, 1024 * 1024)
            if not chunk:
                break
            chunks.append(chunk)
        payload = b"".join(chunks)
        opened_after = os.fstat(fd)
    except OSError as exc:
        raise ValueError(f"{label} artifact changed while reading") from exc
    finally:
        os.close(fd)
    try:
        after = resolved.lstat()
    except OSError as exc:
        raise ValueError(f"{label} artifact changed while reading") from exc
    if (
        not stat.S_ISREG(opened.st_mode)
        or not stat.S_ISREG(opened_after.st_mode)
        or not stat.S_ISREG(after.st_mode)
        or len(payload) != before.st_size
        or not (
            identity(before)
            == identity(opened)
            == identity(opened_after)
            == identity(after)
        )
    ):
        raise ValueError(f"{label} artifact changed while reading")
    return resolved, payload


def descriptor_bytes(
    value: Any, label: str, *, allow_empty: bool = False
) -> tuple[Path, bytes]:
    if not isinstance(value, dict):
        raise ValueError(f"{label} descriptor is invalid")
    if (
        not isinstance(value.get("path"), str)
        or not isinstance(value.get("sha256"), str)
        or re.fullmatch(r"[0-9a-f]{64}", value["sha256"]) is None
        or type(value.get("bytes")) is not int
        or value["bytes"] < (0 if allow_empty else 1)
    ):
        raise ValueError(f"{label} descriptor fields are invalid")
    path = Path(value["path"])
    resolved, payload = stable_regular_bytes(path, label)
    if len(payload) != value.get("bytes") or hashlib.sha256(payload).hexdigest() != value.get("sha256"):
        raise ValueError(f"{label} artifact descriptor mismatch")
    return resolved, payload


def descriptor_file(value: Any, label: str) -> Path:
    path, _ = descriptor_bytes(value, label)
    return path

def option(argv: list[str], flag: str) -> str | None:
    values = []
    index = 0
    while index < len(argv):
        token = argv[index]
        if token == flag:
            if index + 1 >= len(argv):
                raise ValueError(f"{flag} lacks a value")
            values.append(argv[index + 1])
            index += 2
            continue
        if token.startswith(flag + "="):
            values.append(token.split("=", 1)[1])
        index += 1
    if len(values) > 1:
        raise ValueError(f"{flag} is repeated")
    return values[0] if values else None

def strict_json_file(path: Path) -> dict[str, Any]:
    _, payload = stable_regular_bytes(path, str(path))
    value = strict_json_loads(payload)
    if not isinstance(value, dict):
        raise ValueError(f"expected one JSON object: {path}")
    return value

def exact_descriptor_bytes(
    value: Any, label: str, *, allow_empty: bool = False
) -> tuple[Path, bytes]:
    if not isinstance(value, dict) or set(value) != {"path", "sha256", "bytes"}:
        raise ValueError(f"{label} descriptor fields changed")
    return descriptor_bytes(value, label, allow_empty=allow_empty)


def exact_descriptor(
    value: Any, label: str, *, allow_empty: bool = False
) -> Path:
    path, _ = exact_descriptor_bytes(value, label, allow_empty=allow_empty)
    return path


def exact_observed_descriptor(
    value: Any, path: Path, payload: bytes, label: str,
) -> Path:
    observed = {
        "path": str(path),
        "sha256": hashlib.sha256(payload).hexdigest(),
        "bytes": len(payload),
    }
    if not isinstance(value, dict) or value != observed:
        raise ValueError(f"{label} descriptor differs from observed bytes")
    return path


def strict_object_bytes(payload: bytes, label: str) -> dict[str, Any]:
    value = strict_json_loads(payload)
    if not isinstance(value, dict):
        raise ValueError(f"{label} JSON root is not an object")
    return value


def projection_from_bytes(
    path: Path, payload: bytes, expected_sha256: str, label: str,
) -> tuple[dict[str, Any], dict[str, object]]:
    if (
        not payload
        or len(payload) > 4 * 1024 * 1024
        or hashlib.sha256(payload).hexdigest() != expected_sha256
    ):
        raise ValueError(f"{label} byte identity changed")
    projection = validate_lane_projection(strict_object_bytes(payload, label))
    if (
        payload != lane_projection_bytes(projection)
        or path.name != f"{projection['projection_id']}.lane-projection.json"
    ):
        raise ValueError(f"{label} canonical content identity changed")
    return projection, {
        "file": path.name,
        "sha256": expected_sha256,
        "bytes": len(payload),
    }


def envelope_from_bytes(
    path: Path, payload: bytes, label: str,
) -> tuple[dict[str, Any], dict[str, object]]:
    envelope = validate_request_envelope(strict_object_bytes(payload, label))
    if (
        payload != request_envelope_bytes(envelope)
        or path.name != f"{envelope['envelope_id']}.request-envelope.json"
    ):
        raise ValueError(f"{label} canonical content identity changed")
    return envelope, {
        "envelope_id": envelope["envelope_id"],
        "file": path.name,
        "sha256": hashlib.sha256(payload).hexdigest(),
        "bytes": len(payload),
    }

def type_strict_equal(left: Any, right: Any) -> bool:
    if type(left) is not type(right):
        return False
    if isinstance(left, dict):
        return set(left) == set(right) and all(
            type_strict_equal(left[key], right[key]) for key in left
        )
    if isinstance(left, list):
        return len(left) == len(right) and all(
            type_strict_equal(a, b) for a, b in zip(left, right)
        )
    return left == right


def rr_tree_descriptor(value: Any, label: str) -> dict[str, Any]:
    if not isinstance(value, dict) or set(value) != {
        "path", "sha256", "bytes", "files",
    }:
        raise ValueError(f"{label}: RR evidence-tree descriptor changed")
    path = Path(str(value.get("path", "")))
    try:
        entry = path.lstat()
        root = path.resolve(strict=True)
    except OSError as exc:
        raise ValueError(f"{label}: RR evidence root cannot be resolved") from exc
    root_before = root.lstat()
    if (
        stat.S_ISLNK(entry.st_mode)
        or not stat.S_ISDIR(entry.st_mode)
        or not stat.S_ISDIR(root_before.st_mode)
        or (entry.st_dev, entry.st_ino) != (root_before.st_dev, root_before.st_ino)
    ):
        raise ValueError(f"{label}: RR evidence root is not one directory")

    def identity(entry_value: os.stat_result) -> tuple[int, int, int, int, int]:
        return (
            entry_value.st_mode,
            entry_value.st_dev,
            entry_value.st_ino,
            entry_value.st_size,
            entry_value.st_mtime_ns,
        )

    def inventory() -> tuple[
        dict[str, tuple[int, int, int, int, int]], list[tuple[str, Path]]
    ]:
        members: dict[str, tuple[int, int, int, int, int]] = {}
        regular_files: list[tuple[str, Path]] = []
        for member in root.rglob("*"):
            member_entry = member.lstat()
            relative = member.relative_to(root).as_posix()
            if stat.S_ISLNK(member_entry.st_mode):
                raise ValueError(f"{label}: RR evidence root contains a symlink")
            if not (
                stat.S_ISDIR(member_entry.st_mode)
                or stat.S_ISREG(member_entry.st_mode)
            ):
                raise ValueError(f"{label}: RR evidence root contains a non-file")
            members[relative] = identity(member_entry)
            if stat.S_ISREG(member_entry.st_mode):
                regular_files.append((relative, member))
        regular_files.sort(key=lambda item: item[0])
        return members, regular_files

    members_before, files = inventory()
    if not files:
        raise ValueError(f"{label}: RR evidence root is empty")
    digest_value = hashlib.sha256()
    total_bytes = 0
    for relative, member in files:
        before = member.lstat()
        try:
            fd = os.open(
                member,
                os.O_RDONLY
                | getattr(os, "O_BINARY", 0)
                | getattr(os, "O_NOFOLLOW", 0),
            )
        except OSError as exc:
            raise ValueError(
                f"{label}: RR evidence member changed while reading"
            ) from exc
        try:
            opened = os.fstat(fd)
            chunks: list[bytes] = []
            while True:
                chunk = os.read(fd, 1024 * 1024)
                if not chunk:
                    break
                chunks.append(chunk)
            payload = b"".join(chunks)
            opened_after = os.fstat(fd)
        except OSError as exc:
            raise ValueError(
                f"{label}: RR evidence member changed while reading"
            ) from exc
        finally:
            os.close(fd)
        after = member.lstat()
        if (
            not stat.S_ISREG(before.st_mode)
            or not stat.S_ISREG(opened.st_mode)
            or not stat.S_ISREG(opened_after.st_mode)
            or not stat.S_ISREG(after.st_mode)
            or len(payload) != before.st_size
            or not (
                identity(before)
                == identity(opened)
                == identity(opened_after)
                == identity(after)
            )
        ):
            raise ValueError(f"{label}: RR evidence member changed while reading")
        member_sha = hashlib.sha256(payload).hexdigest()
        total_bytes += len(payload)
        digest_value.update(relative.encode("utf-8"))
        digest_value.update(b"\0")
        digest_value.update(str(len(payload)).encode("ascii"))
        digest_value.update(b"\0")
        digest_value.update(member_sha.encode("ascii"))
        digest_value.update(b"\n")
    members_after, _ = inventory()
    root_after = root.lstat()
    if members_after != members_before or identity(root_after) != identity(root_before):
        raise ValueError(f"{label}: RR evidence root changed while reading")
    observed = {
        "path": str(root),
        "sha256": digest_value.hexdigest(),
        "bytes": total_bytes,
        "files": len(files),
    }
    if not type_strict_equal(value, observed):
        raise ValueError(f"{label}: RR evidence-tree bytes changed")
    return observed


def validate_rr_runtime_terminal_artifact(
    descriptor_value: Any, label: str
) -> None:
    _, terminal_payload = exact_descriptor_bytes(
        descriptor_value, f"{label} RR terminal artifact"
    )
    value = strict_json_loads(terminal_payload)
    if not isinstance(value, dict):
        raise ValueError(f"{label}: RR terminal artifact is not one object")
    top_fields = {
        "schema", "status", "disposition", "reason_code", "reason",
        "classified_at_utc", "target", "bindings", "observations",
        "call_accounting", "applies_to_lanes", "evidence_eligible",
    }
    if (
        set(value) != top_fields
        or value.get("schema") != "ura-phase5-target-runtime-terminal/1"
        or value.get("status") != "unavailable"
        or value.get("disposition") != "unavailable"
        or value.get("reason_code") != RR_TERMINAL_REASON_CODE
        or value.get("reason") != RR_TERMINAL_REASON
        or value.get("applies_to_lanes") != list(RR_TERMINAL_LANES)
        or value.get("evidence_eligible") is not False
    ):
        raise ValueError(f"{label}: RR terminal artifact envelope changed")
    try:
        classified_at = datetime.fromisoformat(
            str(value.get("classified_at_utc", "")).replace("Z", "+00:00")
        )
    except ValueError as exc:
        raise ValueError(f"{label}: RR classification timestamp is invalid") from exc
    if (
        classified_at.tzinfo is None
        or classified_at.utcoffset() != timezone.utc.utcoffset(classified_at)
    ):
        raise ValueError(f"{label}: RR classification timestamp is not UTC")
    target = value.get("target")
    if (
        not isinstance(target, dict)
        or set(target) != {
            "spec", "model", "revision", "resource_id", "runtime",
            "runtime_version", "modalities", "configured_max_tokens",
            "local_config",
        }
        or target.get("spec")
        != "vllm:GraySwanAI/llava-v1.6-mistral-7b-hf-RR"
        or target.get("model") != "GraySwanAI/llava-v1.6-mistral-7b-hf-RR"
        or target.get("revision")
        != "d11b3d7ae2fb21e984f197a83c15bbb0deb66b7e"
        or target.get("resource_id") != "hf-400da4b35ea290e28fcce5f33f8d4090"
        or target.get("runtime") != "vllm"
        or target.get("runtime_version") != "0.27.1"
        or target.get("modalities") != ["text", "image"]
        or type(target.get("configured_max_tokens")) is not int
        or target.get("configured_max_tokens") != 4096
    ):
        raise ValueError(f"{label}: RR terminal target identity changed")
    local_config_path, local_config_payload = exact_descriptor_bytes(
        target.get("local_config"), f"{label} RR local config"
    )
    expected_local_config_path = (
        Path.cwd().resolve(strict=True) / "experiments" / "local-llava-rr.json"
    )
    if (
        local_config_path != expected_local_config_path
        or target["local_config"].get("sha256")
        != "3a53ab82405636116e9c95850dae1e0c1e394021317707c978bc35b4178ca334"
        or type(target["local_config"].get("bytes")) is not int
        or target["local_config"].get("bytes") != 246
    ):
        raise ValueError(f"{label}: RR local config path changed")
    local_config = strict_json_loads(local_config_payload)
    if not type_strict_equal(local_config, {target["spec"]: {
        "revision": target["revision"], "modalities": ["text", "image"],
        "tensor_parallel_size": 1, "gpu_memory_utilization": 0.85,
        "max_tokens": 4096,
    }}):
        raise ValueError(f"{label}: RR local config content changed")
    bindings = value.get("bindings")
    if (
        not isinstance(bindings, dict)
        or set(bindings) != {
            "classification_project_commit", "framework_lock_sha256",
            "project_revision", "semantic_source_continuity", "evidence_roots",
        }
        or bindings.get("classification_project_commit") != expected_commit
        or bindings.get("framework_lock_sha256") != expected_lock
    ):
        raise ValueError(f"{label}: RR terminal bindings changed")
    exact_descriptor(
        bindings.get("project_revision"), f"{label} RR project revision"
    )
    continuity = bindings.get("semantic_source_continuity")
    if (
        not isinstance(continuity, dict)
        or set(continuity) != {
            "observed_project_commit", "unchanged_paths", "git_diff_empty",
        }
        or continuity.get("observed_project_commit")
        != "21b27d56da0d081125f4cf4117884a8262386e5d"
        or continuity.get("unchanged_paths")
        != ["src/ura/targets/local.py", "experiments/run_matrix.py"]
        or continuity.get("git_diff_empty") is not True
    ):
        raise ValueError(f"{label}: RR semantic-continuity binding changed")
    evidence_roots = bindings.get("evidence_roots")
    evidence_names = {
        "text_vllm_4096", "image_vllm_4096", "vllm_token_tail_512",
        "transformers_reference_512",
    }
    if not isinstance(evidence_roots, dict) or set(evidence_roots) != evidence_names:
        raise ValueError(f"{label}: RR evidence-root inventory changed")
    for name in sorted(evidence_names):
        rr_tree_descriptor(evidence_roots[name], f"{label} {name}")
    observations = value.get("observations")
    if not isinstance(observations, dict) or set(observations) != evidence_names:
        raise ValueError(f"{label}: RR observation inventory changed")
    text_observation = observations["text_vllm_4096"]
    text_errors = (
        text_observation.get("error_artifacts")
        if isinstance(text_observation, dict)
        else None
    )
    if not isinstance(text_errors, list) or len(text_errors) != 3:
        raise ValueError(f"{label}: RR text error inventory changed")
    for index, item in enumerate(text_errors):
        exact_descriptor(item, f"{label} RR text error {index}")
    if not type_strict_equal(text_observation, {
        "modality": "text", "corpus": "strongreject_official",
        "sample_seeds": [0, 1, 8], "max_tokens": 4096,
        "finish_reasons": ["length", "length", "length"],
        "stop_reasons": [None, None, None], "successful_responses": 0,
        "error_artifacts": text_errors,
    }):
        raise ValueError(f"{label}: RR text observation changed")
    image_observation = observations["image_vllm_4096"]
    image_error = (
        image_observation.get("error_artifact")
        if isinstance(image_observation, dict)
        else None
    )
    exact_descriptor(image_error, f"{label} RR image error")
    if not type_strict_equal(image_observation, {
        "modality": "image", "corpus": "harmbench_multimodal",
        "sample_seed": 1, "max_tokens": 4096, "finish_reason": "length",
        "stop_reason": None, "successful_responses": 0,
        "error_artifact": image_error,
    }):
        raise ValueError(f"{label}: RR image observation changed")
    tail = observations["vllm_token_tail_512"]
    tail_log = tail.get("probe_log") if isinstance(tail, dict) else None
    exact_descriptor(tail_log, f"{label} RR vLLM tail log")
    if not type_strict_equal(tail, {
        "probe_schema": "ura-engineering-token-tail-probe/1",
        "max_tokens": 512, "prompt_tokens": 21, "completion_tokens": 512,
        "finish_reason": "length", "stop_reason": None,
        "unique_completion_tokens": 2,
        "most_common_token_counts": [[644, 501], [22627, 11]],
        "special_token_ids": {"bos": 1, "eos": 2, "pad": 32001, "unk": 0},
        "special_token_counts": {"bos": 0, "eos": 0, "pad": 0, "unk": 0},
        "text_sha256": "277aada87524bc3de88d8b7286ea6653a7b36a94ba08d2ab7211411f9cb6ebdb",
        "probe_log": tail_log,
    }):
        raise ValueError(f"{label}: RR vLLM tail observation changed")
    transformers = observations["transformers_reference_512"]
    transformers_log = (
        transformers.get("probe_log") if isinstance(transformers, dict) else None
    )
    exact_descriptor(transformers_log, f"{label} RR Transformers log")
    if not type_strict_equal(transformers, {
        "probe_schema": "ura-engineering-transformers-termination-probe/1",
        "generation": {
            "backend": "transformers", "do_sample": False,
            "max_new_tokens": 512, "seed": 0,
        },
        "base": {
            "label": "base", "resource_id": "hf-d9e60d9f6c16de2e8fb9d9e08389c44a",
            "prompt_tokens": 20, "completion_tokens": 226,
            "last_token_is_eos": True, "eos_token_id": 2, "eos_token_count": 1,
            "text_sha256": "7d966860772f8185567a9c1742536f823a49facfadaae6847a97069ddc011499",
        },
        "rr": {
            "label": "rr", "resource_id": "hf-400da4b35ea290e28fcce5f33f8d4090",
            "prompt_tokens": 20, "completion_tokens": 512,
            "last_token_is_eos": False, "eos_token_id": 2, "eos_token_count": 0,
            "unique_completion_tokens": 2,
            "most_common_token_counts": [[644, 503], [22627, 9]],
            "text_sha256": "1f8e655ab40cbcd5a5ef23839d6845bd7aaa24ce7d693cfb29b077af590d1bbf",
        },
        "probe_log": transformers_log,
    }):
        raise ValueError(f"{label}: RR Transformers observation changed")
    if not type_strict_equal(value.get("call_accounting"), {
        "accounting_semantics": "durable_pre_call_logical_reservation_v1",
        "runner_target_call_reservations": 4,
        "vllm_diagnostic_generations": 1,
        "transformers_reference_generations": 2,
        "successful_rr_responses": 0,
        "hosted_target_calls": 0,
        "model_judge_calls": 0,
        "local_guardrail_evaluations": 0,
        "hosted_judge_calls": 0,
        "http_attempts": 0,
    }):
        raise ValueError(f"{label}: RR diagnostic accounting changed")

def descriptor_shape(value: Any) -> bool:
    return (
        isinstance(value, dict)
        and set(value) == {"path", "sha256", "bytes"}
        and isinstance(value.get("path"), str)
        and Path(value["path"]).is_absolute()
        and isinstance(value.get("sha256"), str)
        and re.fullmatch(r"[0-9a-f]{64}", value["sha256"]) is not None
        and type(value.get("bytes")) is int
        and value["bytes"] > 0
    )

def validate_acquisition_result_rows(
    rows: Any, *, receipt_id: Any, receipt_sha256: str, label: str
) -> None:
    if (
        not isinstance(rows, list)
        or len(rows) != 1
        or not isinstance(rows[0], dict)
        or set(rows[0]) != {"downloaded_bytes", "receipt_id", "receipt_sha256"}
        or rows[0].get("receipt_id") != receipt_id
        or rows[0].get("receipt_sha256") != receipt_sha256
        or type(rows[0].get("downloaded_bytes")) is not int
        or rows[0].get("downloaded_bytes") != 0
    ):
        raise ValueError(f"{label}: defense-local acquisition result changed")

def acquisition_result_contract_self_test() -> None:
    receipt_id = "receipt-fixture"
    receipt_sha256 = "b" * 64
    row = {
        "downloaded_bytes": 0,
        "receipt_id": receipt_id,
        "receipt_sha256": receipt_sha256,
    }
    validate_acquisition_result_rows(
        [row],
        receipt_id=receipt_id,
        receipt_sha256=receipt_sha256,
        label="self-test",
    )
    mutations = (
        [],
        [row, copy.deepcopy(row)],
        [{**row, "receipt_id": "wrong"}],
        [{**row, "receipt_sha256": "c" * 64}],
        [{**row, "downloaded_bytes": False}],
        [{**row, "unexpected": None}],
    )
    for index, mutation in enumerate(mutations, 1):
        try:
            validate_acquisition_result_rows(
                mutation,
                receipt_id=receipt_id,
                receipt_sha256=receipt_sha256,
                label=f"mutation-{index}",
            )
        except ValueError:
            continue
        raise ValueError(
            f"defense-local acquisition-result mutation {index} was accepted"
        )


def validate_defense_live_binding(
    value: Any,
    *,
    artifact_descriptor: dict[str, Any],
    artifact_filename: str,
    attestation_id: Any,
    label: str,
) -> dict[str, Any]:
    rows = value.get("artifacts") if isinstance(value, dict) else None
    if (
        not isinstance(value, dict)
        or set(value) != {
            "mode", "execution_scope_id", "max_age_hours", "artifacts",
        }
        or value.get("mode") != "measured"
        or not isinstance(value.get("execution_scope_id"), str)
        or not value["execution_scope_id"].strip()
        or type(value.get("max_age_hours")) is not float
        or value.get("max_age_hours") != 24.0
        or not isinstance(rows, list)
        or len(rows) != 1
        or not isinstance(rows[0], dict)
        or set(rows[0]) != {"file", "sha256", "bytes", "attestation_id"}
        or rows[0].get("file") != artifact_filename
        or rows[0].get("sha256") != artifact_descriptor.get("sha256")
        or rows[0].get("bytes") != artifact_descriptor.get("bytes")
        or re.fullmatch(
            r"live-attestation-[0-9a-f]{24}",
            str(rows[0].get("attestation_id", "")),
        ) is None
        or rows[0].get("attestation_id") != attestation_id
    ):
        raise ValueError(f"{label}: defense-local live-attestation binding changed")
    return rows[0]


def live_binding_contract_self_test() -> None:
    attestation_id = "live-attestation-" + "d" * 24
    descriptor_value = {
        "path": "/fixture/live.json", "sha256": "c" * 64, "bytes": 1,
    }
    value = {
        "mode": "measured",
        "execution_scope_id": "scope-fixture",
        "max_age_hours": 24.0,
        "artifacts": [{
            "file": "live.json", "sha256": "c" * 64, "bytes": 1,
            "attestation_id": attestation_id,
        }],
    }
    validate_defense_live_binding(
        value,
        artifact_descriptor=descriptor_value,
        artifact_filename="live.json",
        attestation_id=attestation_id,
        label="self-test",
    )
    mutations = []
    wrong_age_type = copy.deepcopy(value)
    wrong_age_type["max_age_hours"] = 24
    mutations.append(wrong_age_type)
    wrong_scope = copy.deepcopy(value)
    wrong_scope["execution_scope_id"] = ""
    mutations.append(wrong_scope)
    wrong_id = copy.deepcopy(value)
    wrong_id["artifacts"][0]["attestation_id"] = "live-attestation-" + "e" * 24
    mutations.append(wrong_id)
    for index, mutation in enumerate(mutations, 1):
        try:
            validate_defense_live_binding(
                mutation,
                artifact_descriptor=descriptor_value,
                artifact_filename="live.json",
                attestation_id=attestation_id,
                label=f"mutation-{index}",
            )
        except ValueError:
            continue
        raise ValueError(
            f"defense-local live-attestation mutation {index} was accepted"
        )


def defense_conditional_variant_for_row(
    row: Mapping[str, Any], label: str
) -> Mapping[str, Any]:
    canary = row.get("canary")
    matches = [
        variant for variant in DEFENSE_CONDITIONAL_VARIANTS.values()
        if row.get("reason_code") == variant["reason_code"]
        and row.get("reason") == variant["reason"]
        and isinstance(canary, Mapping)
        and type_strict_equal(canary.get("call_accounting"), variant["accounting"])
    ]
    if len(matches) != 1:
        raise ValueError(f"{label}: defense-local conditional variants are cross-mixed")
    return matches[0]


def validate_defense_conditional_shape(row: Any, label: str) -> None:
    typed_na = {"status": "N/A", "value": None}
    expected_fields = {
        "lane_id", "family", "disposition", "reason_code", "reason",
        "projection", "canary", "final_preflight", "approved_caps",
    }
    if (
        not isinstance(row, dict)
        or set(row) != expected_fields
        or row.get("lane_id") != DEFENSE_LOCAL
        or row.get("family") != "core"
        or row.get("disposition") != "conditional_na"
        or row.get("projection") != typed_na
        or row.get("final_preflight") != typed_na
        or row.get("approved_caps") != typed_na
    ):
        raise ValueError(f"{label}: defense-local conditional N/A row changed")
    canary = row.get("canary")
    variant = defense_conditional_variant_for_row(row, label)
    if (
        not isinstance(canary, dict)
        or set(canary) != {
            "status", "value", "conditional_na_artifact", "call_accounting",
        }
        or canary.get("status") != "N/A"
        or canary.get("value") is not None
        or not descriptor_shape(canary.get("conditional_na_artifact"))
        or not type_strict_equal(canary.get("call_accounting"), variant["accounting"])
    ):
        raise ValueError(f"{label}: defense-local conditional canary field changed")

def validate_defense_conditional_artifact(row: dict[str, Any], label: str) -> None:
    validate_defense_conditional_shape(row, label)
    canary = row["canary"]
    artifact_path = exact_descriptor(
        canary["conditional_na_artifact"],
        f"{label} defense-local conditional N/A artifact",
    )
    value = strict_json_file(artifact_path)
    variant = DEFENSE_CONDITIONAL_VARIANTS.get(value.get("schema"))
    if variant is None or defense_conditional_variant_for_row(row, label) is not variant:
        raise ValueError(f"{label}: defense-local artifact variant is cross-mixed")
    expected_fields = {
        "schema", "status", "lane_id", "disposition", "reason_code", "reason",
        "classified_at_utc", "classification", "bindings", "call_accounting",
        "runner_outputs", "artifacts", "resource_identities",
    }
    if variant["evidence_limits"] is not None:
        expected_fields.add("evidence_limits")
    if (
        set(value) != expected_fields
        or value.get("status") != "N/A"
        or value.get("lane_id") != DEFENSE_LOCAL
        or value.get("disposition") != "conditional_na"
        or value.get("reason_code") != row["reason_code"]
        or value.get("reason") != row["reason"]
        or value.get("reason_code") != variant["reason_code"]
        or value.get("reason") != variant["reason"]
        or not type_strict_equal(value.get("call_accounting"), variant["accounting"])
        or not type_strict_equal(
            value.get("call_accounting"), canary["call_accounting"]
        )
        or not type_strict_equal(value.get("runner_outputs"), variant["runner_outputs"])
        or not type_strict_equal(value.get("classification"), variant["classification"])
        or not type_strict_equal(value.get("evidence_limits"), variant["evidence_limits"])
    ):
        raise ValueError(f"{label}: defense-local conditional artifact changed")
    try:
        classified_at = datetime.fromisoformat(
            str(value.get("classified_at_utc", "")).replace("Z", "+00:00")
        )
    except ValueError as exc:
        raise ValueError(f"{label}: defense-local classification timestamp is invalid") from exc
    if (
        classified_at.tzinfo is None
        or classified_at.utcoffset() != timezone.utc.utcoffset(classified_at)
    ):
        raise ValueError(f"{label}: defense-local classification timestamp is not UTC")

    artifacts = value.get("artifacts")
    artifact_names = variant["artifact_names"]
    if not isinstance(artifacts, dict) or set(artifacts) != artifact_names:
        raise ValueError(f"{label}: defense-local conditional artifact inventory changed")
    artifact_paths = {}
    empty_names = {
        "empty_attempts", "empty_responses", "empty_judge_trails", "empty_results"
    }
    for name, descriptor_value in artifacts.items():
        artifact_paths[name] = exact_descriptor(
            descriptor_value, f"{label} defense {name}", allow_empty=name in empty_names
        )
    if len(set(artifact_paths.values())) != len(artifact_paths):
        raise ValueError(f"{label}: defense-local conditional artifacts overlap")

    current_project = Path(os.environ["URA_PROJECT_REVISION_MANIFEST"]).resolve(strict=True)
    current_source = Path(os.environ["URA_SOURCE_CONFORMANCE_MANIFEST"]).resolve(strict=True)
    current_source_config = (Path.cwd() / "experiments/source-instances.json").resolve(strict=True)
    current_local_config = (Path.cwd() / "experiments/local-qwen3-vl.json").resolve(strict=True)
    if (
        artifact_paths["project_revision"] != current_project
        or artifacts["project_revision"]["sha256"]
        != os.environ["URA_PROJECT_REVISION_SHA256"]
        or artifact_paths["source_conformance"] != current_source
        or artifacts["source_conformance"]["sha256"]
        != os.environ["URA_SOURCE_CONFORMANCE_SHA256"]
        or artifact_paths["source_config"] != current_source_config
        or artifact_paths["local_config"] != current_local_config
    ):
        raise ValueError(f"{label}: defense-local conditional current bindings changed")

    bindings = value.get("bindings")
    expected_binding_fields = {
        "expected_commit", "framework_lock_id", "project_revision_sha256",
        "source_conformance_sha256", "source_config_sha256",
        "cuda_visible_devices", "target", "scoring_guard", "defense_guard",
    }
    expected_target = {
        "spec": "vllm:Qwen/Qwen3-VL-8B-Instruct",
        "revision": "60595ebc30ec8e3b1d3b9e65d4943ca011c0006a",
        "config_sha256": artifacts["local_config"]["sha256"],
    }
    if (
        not isinstance(bindings, dict)
        or set(bindings) != expected_binding_fields
        or bindings.get("expected_commit") != expected_commit
        or bindings.get("framework_lock_id") != expected_lock
        or bindings.get("project_revision_sha256")
        != os.environ["URA_PROJECT_REVISION_SHA256"]
        or bindings.get("source_conformance_sha256")
        != os.environ["URA_SOURCE_CONFORMANCE_SHA256"]
        or bindings.get("source_config_sha256")
        != artifacts["source_config"]["sha256"]
        or bindings.get("cuda_visible_devices") != "0,1"
        or bindings.get("target") != expected_target
        or bindings.get("scoring_guard") != {
            "model": GUARD, "revision": GUARD_REV, "device": "cuda:1",
        }
        or bindings.get("defense_guard") != {
            "model": DEFENSE_GUARD,
            "revision": DEFENSE_GUARD_REV,
            "device": "cuda:1",
        }
    ):
        raise ValueError(f"{label}: defense-local conditional binding changed")

    runner_log = artifact_paths["runner_log"].read_text(
        encoding="utf-8", errors="replace"
    )
    if (
        artifact_paths["acquisition_result_log"].name
        != "defense-local-canary.acquire.log"
        or artifact_paths["acquisition_result_log"].parent
        != artifact_paths["runner_log"].parent
    ):
        raise ValueError(f"{label}: defense-local acquisition log location changed")
    is_output_noncompletion = value.get("schema") == DEFENSE_CONDITIONAL_V2_SCHEMA
    if is_output_noncompletion:
        failure_lines = re.findall(
            r"^  ! cell failed \[[^\r\n]+\]: ExternalCallFailure: target_call failed "
            r"\(LocalTargetOutputError\): vLLM completion is truncated or incomplete: "
            r"'length'$",
            runner_log,
            flags=re.MULTILINE,
        )
        if (
            len(failure_lines) != 1
            or runner_log.count("done: 0 cells written, 0 already complete, 2 failed") != 1
            or "CUDA out of memory" in runner_log
        ):
            raise ValueError(f"{label}: defense-local target noncompletion changed")
    else:
        oom_lines = re.findall(
            r"^cannot initialize matrix lifecycle: [^\r\n]*CUDA out of memory[^\r\n]*$",
            runner_log,
            flags=re.IGNORECASE | re.MULTILINE,
        )
        if len(oom_lines) != 1:
            raise ValueError(f"{label}: defense-local OOM is not positively reclassified")

    budget_path = artifact_paths["budget_ledger"]
    budget = strict_json_file(budget_path)
    if (
        set(budget) != {
            "budget_id", "max_target_calls", "max_judge_calls",
            "max_http_attempts", "deadline_epoch", "target_calls", "judge_calls",
            "http_attempts", "accounting_semantics",
        }
        or budget.get("budget_id")
        != budget_path.name.removesuffix(".budget.json")
        or re.fullmatch(r"grid-[0-9a-f]{24}", str(budget.get("budget_id"))) is None
        or type(budget.get("target_calls")) is not int
        or budget.get("target_calls") != (1 if is_output_noncompletion else 0)
        or type(budget.get("judge_calls")) is not int
        or budget.get("judge_calls") != 0
        or type(budget.get("http_attempts")) is not int
        or budget.get("http_attempts") != 0
        or budget.get("accounting_semantics")
        != variant["accounting"]["accounting_semantics"]
    ):
        raise ValueError(f"{label}: defense-local durable call ledger changed")
    runner_root = budget_path.parent
    if is_output_noncompletion:
        if any(artifact_paths[name].parent != runner_root for name in {
            "partial_grid", "circuit_ledger", "target_error", "failed_cell_manifest",
            "empty_attempts", "empty_responses", "empty_judge_trails", "empty_results",
            "parquet_placeholder", "retained_live_attestation",
        }):
            raise ValueError(f"{label}: defense-local failed-cell artifacts span roots")
        if list(runner_root.rglob("*.complete.json")) or any(
            artifact_paths[name].stat().st_size != 0
            for name in {
                "empty_attempts", "empty_responses", "empty_judge_trails", "empty_results"
            }
        ):
            raise ValueError(f"{label}: defense-local failed cell has success evidence")
        error = strict_json_file(artifact_paths["target_error"])
        expected_runtime_target = (
            "vllm:Qwen/Qwen3-VL-8B-Instruct@"
            "60595ebc30ec8e3b1d3b9e65d4943ca011c0006a+guard"
        )
        if (
            error.get("message")
            != "target_call failed (LocalTargetOutputError): vLLM completion is "
            "truncated or incomplete: 'length'"
            or error.get("exception_type") != "ExternalCallFailure"
            or error.get("phase") != "cell_execution_or_validation"
            or error.get("execution_started") is not True
            or error.get("completed_attempts") != 0
            or error.get("call_budget_snapshot") != budget
            or error.get("model_spec") != expected_runtime_target
            or error.get("target") != expected_runtime_target
        ):
            raise ValueError(f"{label}: defense-local target error changed")
        grid = strict_json_file(artifact_paths["partial_grid"])
        if (
            grid.get("status") != "partial"
            or grid.get("requested_cells") != 1
            or grid.get("accounted_cells") != 1
            or grid.get("n_errors") != 2
            or grid.get("n_new_complete") != 0
            or grid.get("n_existing_complete") != 0
            or grid.get("call_budget_snapshot") != budget
            or grid.get("request", {}).get("models") != [expected_runtime_target]
            or grid.get("request", {}).get("approximate_common_metrics") is not True
        ):
            raise ValueError(f"{label}: defense-local partial grid changed")
    elif any(
        list(runner_root.rglob(pattern))
        for pattern in (
            "grid-*.grid.json", "*.responses.jsonl", "*.complete.json", "*.error.json"
        )
    ):
        raise ValueError(f"{label}: defense-local conditional root has post-preload output")

    envelope, _ = load_request_envelope_file(artifact_paths["request_envelope"])
    request = envelope.get("request", {})
    if (
        request.get("execution_purpose") != "diagnostic_canary"
        or request.get("requested_target_keys") != [expected_target["spec"]]
        or request.get("logical_source_arms") != ["jailbreakbench_benign"]
        or request.get("selected_attackers") != ["replay"]
        or request.get("judges") != ["rules", "guardrail"]
        or request.get("defense") != "both"
        or request.get("defense_guard") != "guardrail"
        or request.get("limit") != 1
        or request.get("seeds") != [0]
        or request.get("sample_seed") != 0
        or request.get("dry_run") is not False
    ):
        raise ValueError(f"{label}: defense-local conditional request changed")
    eligibility = validate_eligibility_plan(
        strict_json_file(artifact_paths["eligibility_plan"])
    )
    conditions = eligibility.get("bindings", {}).get(
        "experiment_conditions", {}
    ).get("values", {})
    selected = conditions.get("selected_config_identities", {})
    if (
        selected.get("source_conformance", {}).get("sha256")
        != os.environ["URA_SOURCE_CONFORMANCE_SHA256"]
        or selected.get("source_config", {}).get("sha256")
        != artifacts["source_config"]["sha256"]
        or selected.get("local_config", {}).get("sha256")
        != artifacts["local_config"]["sha256"]
    ):
        raise ValueError(f"{label}: defense-local conditional selection binding changed")
    live_binding = conditions.get("live_attestation")
    live_name = (
        "retained_live_attestation"
        if value.get("schema") == DEFENSE_CONDITIONAL_V2_SCHEMA
        else "live_attestation"
    )
    live_path = artifact_paths[live_name]
    live_descriptor = artifacts[live_name]
    if value.get("schema") == DEFENSE_CONDITIONAL_V2_SCHEMA and (
        live_descriptor["sha256"] != artifacts["live_attestation"]["sha256"]
        or live_descriptor["bytes"] != artifacts["live_attestation"]["bytes"]
        or live_path.name
        != f"live-attestation-{artifacts['live_attestation']['sha256'][:24]}.json"
    ):
        raise ValueError(f"{label}: retained live attestation differs from source")
    live_manifest, live_observed = load_live_attestation_file(
        live_path, live_descriptor["sha256"]
    )
    if (
        live_observed != {
            "file": live_path.name,
            "sha256": live_descriptor["sha256"],
            "bytes": live_descriptor["bytes"],
        }
    ):
        raise ValueError(f"{label}: defense-local live-attestation identity changed")
    validate_defense_live_binding(
        live_binding,
        artifact_descriptor=live_descriptor,
        artifact_filename=live_path.name,
        attestation_id=live_manifest.get("attestation_id"),
        label=label,
    )

    plan = load_plan(
        artifact_paths["acquisition_plan"],
        expected_sha256=artifacts["acquisition_plan"]["sha256"],
    )
    receipt = load_receipt(
        artifact_paths["acquisition_receipt"],
        expected_sha256=artifacts["acquisition_receipt"]["sha256"],
        plan=plan,
    )
    acquisition_log = artifact_paths["acquisition_result_log"]
    if acquisition_log.name != "defense-local-canary.acquire.log":
        raise ValueError(f"{label}: defense-local acquisition log name changed")
    acquisition_rows = []
    for raw_line in acquisition_log.read_text(
        encoding="utf-8", errors="strict"
    ).splitlines():
        try:
            item = strict_json_loads(raw_line)
        except (TypeError, ValueError):
            continue
        if isinstance(item, dict) and set(item) == {
            "downloaded_bytes", "receipt_id", "receipt_sha256",
        }:
            acquisition_rows.append(item)
    validate_acquisition_result_rows(
        acquisition_rows,
        receipt_id=receipt.get("receipt_id"),
        receipt_sha256=artifacts["acquisition_receipt"]["sha256"],
        label=label,
    )
    expected_resources = sorted(
        (
            {
                "resource_id": resource.get("resource_id"),
                "repo_id": resource.get("repo_id"),
                "revision": resource.get("revision"),
                "roles": resource.get("roles"),
            }
            for resource in receipt.get("resources", [])
        ),
        key=lambda item: (str(item["repo_id"]), str(item["revision"])),
    )
    role_inventory = {
        (item.get("repo_id"), item.get("revision"), tuple(item.get("roles", [])))
        for item in expected_resources
    }
    if (
        type(receipt.get("downloaded_bytes")) is not int
        or receipt.get("downloaded_bytes") != 0
        or value.get("resource_identities") != expected_resources
        or role_inventory != {
            (
                "Qwen/Qwen3-VL-8B-Instruct",
                "60595ebc30ec8e3b1d3b9e65d4943ca011c0006a",
                ("vllm_target",),
            ),
            (GUARD, GUARD_REV, ("guardrail_judge",)),
            (DEFENSE_GUARD, DEFENSE_GUARD_REV, ("defense_guardrail",)),
        }
    ):
        raise ValueError(f"{label}: defense-local conditional resource identity changed")


def validate_rr_projection_field(
    value: Any, label: str, *, verify_artifact: bool
) -> None:
    projection_value = value.get("value") if isinstance(value, dict) else None
    expected_value_fields = {
        "projection_id", "projection_artifact", "eligibility_plan_id",
        "eligibility_artifact", "request_envelope_id",
        "request_envelope_artifact", "selection", "projected_calls",
    }
    if (
        not isinstance(value, dict)
        or set(value) != {"status", "value"}
        or value.get("status") != "passed"
        or not isinstance(projection_value, dict)
        or set(projection_value) != expected_value_fields
        or any(
            not isinstance(projection_value.get(field), str)
            or not projection_value[field]
            for field in (
                "projection_id", "eligibility_plan_id", "request_envelope_id",
            )
        )
        or not isinstance(projection_value.get("selection"), dict)
    ):
        raise ValueError(f"{label}: RR successful projection field changed")
    projection_descriptor = projection_value["projection_artifact"]
    eligibility_descriptor = projection_value["eligibility_artifact"]
    envelope_descriptor = projection_value["request_envelope_artifact"]
    if (
        not isinstance(projection_descriptor, dict)
        or set(projection_descriptor) != {"path", "file", "sha256", "bytes"}
        or not descriptor_shape({
            key: projection_descriptor.get(key)
            for key in ("path", "sha256", "bytes")
        })
        or projection_descriptor.get("file")
        != Path(projection_descriptor["path"]).name
        or not descriptor_shape(eligibility_descriptor)
        or not isinstance(envelope_descriptor, dict)
        or set(envelope_descriptor)
        != {"path", "envelope_id", "file", "sha256", "bytes"}
        or not descriptor_shape({
            key: envelope_descriptor.get(key)
            for key in ("path", "sha256", "bytes")
        })
        or envelope_descriptor.get("file")
        != Path(envelope_descriptor["path"]).name
        or envelope_descriptor.get("envelope_id")
        != projection_value["request_envelope_id"]
    ):
        raise ValueError(f"{label}: RR projection artifact descriptor changed")
    projected_calls = projection_value.get("projected_calls")
    call_fields = {
        "trajectories", "target_calls", "model_judge_calls",
        "local_guardrail_evaluations", "http_attempts",
    }
    if (
        not isinstance(projected_calls, dict)
        or set(projected_calls) != call_fields
        or any(
            type(projected_calls.get(field)) is not int
            or projected_calls[field] < 0
            for field in call_fields
        )
        or projected_calls["target_calls"] <= 0
    ):
        raise ValueError(f"{label}: RR projected-call contract changed")
    if not verify_artifact:
        return
    projection_path, projection_payload = descriptor_bytes(
        {
            "path": projection_descriptor["path"],
            "sha256": projection_descriptor["sha256"],
            "bytes": projection_descriptor["bytes"],
        },
        f"{label} RR projection",
    )
    projection, observed_projection = projection_from_bytes(
        projection_path, projection_payload, projection_descriptor["sha256"],
        f"{label} RR projection",
    )
    if (
        projection_descriptor
        != {"path": str(projection_path), **observed_projection}
        or projection.get("projection_id") != projection_value["projection_id"]
        or projection.get("selection") != projection_value["selection"]
    ):
        raise ValueError(f"{label}: RR projection content identity changed")
    eligibility_path, eligibility_payload = exact_descriptor_bytes(
        eligibility_descriptor, f"{label} RR projection eligibility"
    )
    eligibility = validate_eligibility_plan(strict_json_loads(eligibility_payload))
    eligibility_records = sum(
        1
        for line in eligibility_payload.decode("utf-8").splitlines()
        if line.strip()
    )
    validate_lane_projection_binding(
        projection,
        eligibility_plan=eligibility,
        eligibility_artifact={
            "file": eligibility_path.name,
            "sha256": eligibility_descriptor["sha256"],
            "bytes": eligibility_descriptor["bytes"],
            "records": eligibility_records,
        },
    )
    if eligibility.get("plan_id") != projection_value["eligibility_plan_id"]:
        raise ValueError(f"{label}: RR eligibility identity changed")
    envelope_path, envelope_payload = descriptor_bytes(
        {
            "path": envelope_descriptor["path"],
            "sha256": envelope_descriptor["sha256"],
            "bytes": envelope_descriptor["bytes"],
        },
        f"{label} RR request envelope",
    )
    envelope, observed_envelope = envelope_from_bytes(
        envelope_path, envelope_payload, f"{label} RR request envelope"
    )
    if (
        envelope_descriptor != {"path": str(envelope_path), **observed_envelope}
        or envelope.get("envelope_id") != projection_value["request_envelope_id"]
        or eligibility.get("bindings", {}).get("request_envelope_sha256")
        != envelope_descriptor["sha256"]
    ):
        raise ValueError(f"{label}: RR request-envelope identity changed")
    calls = projection.get("call_projection", {})
    if projected_calls != {
        "trajectories": calls.get("trajectories"),
        "target_calls": calls.get("target_calls"),
        "model_judge_calls": calls.get("judge_calls"),
        "local_guardrail_evaluations": calls.get("local_guardrail_evaluations"),
        "http_attempts": calls.get("http_attempts"),
    }:
        raise ValueError(f"{label}: RR projected-call artifact binding changed")


def validate_rr_runtime_terminal_rows(
    lanes: dict[str, dict[str, Any]],
    label: str,
    *,
    verify_artifact: bool,
) -> dict[str, Any]:
    unavailable = {"status": "UNAVAILABLE", "value": None}
    expected_fields = {
        "lane_id", "family", "disposition", "reason_code", "reason",
        "projection", "canary", "final_preflight", "approved_caps",
    }
    shared_descriptor: dict[str, Any] | None = None
    for lane_id in RR_TERMINAL_LANES:
        row = lanes[lane_id]
        canary = row.get("canary")
        if (
            set(row) != expected_fields
            or row.get("family") != "core"
            or row.get("disposition") != "unavailable"
            or row.get("reason_code") != RR_TERMINAL_REASON_CODE
            or row.get("reason") != RR_TERMINAL_REASON
            or row.get("final_preflight") != unavailable
            or row.get("approved_caps") != unavailable
            or not isinstance(canary, dict)
            or set(canary) != {
                "status", "value", "target_runtime_terminal_artifact",
            }
            or canary.get("status") != "UNAVAILABLE"
            or canary.get("value") is not None
            or not descriptor_shape(
                canary.get("target_runtime_terminal_artifact")
            )
        ):
            raise ValueError(
                f"{label}: {lane_id} target-runtime terminal row changed"
            )
        validate_rr_projection_field(
            row.get("projection"),
            f"{label} {lane_id}",
            verify_artifact=verify_artifact,
        )
        descriptor_value = canary["target_runtime_terminal_artifact"]
        if shared_descriptor is None:
            shared_descriptor = descriptor_value
        elif not type_strict_equal(descriptor_value, shared_descriptor):
            raise ValueError(
                f"{label}: RR terminal rows do not share one evidence artifact"
            )
    if shared_descriptor is None:
        raise ValueError(f"{label}: RR terminal evidence is absent")
    if verify_artifact:
        validate_rr_runtime_terminal_artifact(
            shared_descriptor, f"{label} shared"
        )
    return shared_descriptor

def selected_inventory_counts(lanes: dict[str, dict[str, Any]]) -> dict[str, Any]:
    defense = lanes[DEFENSE_LOCAL]
    return dict(
        CONDITIONAL_INVENTORY_COUNTS
        if defense.get("disposition") == "conditional_na"
        else SUCCESS_INVENTORY_COUNTS
    )

def validate_inventory_identity(
    rows: Any, label: str, *, verify_conditional_artifact: bool = True
) -> dict[str, dict[str, Any]]:
    if (
        not isinstance(rows, list)
        or any(
            not isinstance(row, dict)
            or not isinstance(row.get("lane_id"), str)
            or not row["lane_id"]
            for row in rows
        )
    ):
        raise ValueError(f"{label} lane inventory is invalid")
    lanes = {row["lane_id"]: row for row in rows}
    if len(lanes) != len(rows):
        raise ValueError(f"{label} lane inventory contains duplicate identifiers")
    expected_lane_ids = set(EXPECTED_RUNNABLE_FAMILIES) | set(EXPECTED_TERMINALS)
    if len(rows) != 46 or set(lanes) != expected_lane_ids:
        raise ValueError(
            f"{label} does not contain the exact reviewed 46-lane inventory: "
            f"missing={sorted(expected_lane_ids-set(lanes))}, "
            f"extra={sorted(set(lanes)-expected_lane_ids)}, rows={len(rows)}"
        )
    validate_rr_runtime_terminal_rows(
        lanes, label, verify_artifact=verify_conditional_artifact
    )
    for lane_id, family in EXPECTED_RUNNABLE_FAMILIES.items():
        if lane_id == DEFENSE_LOCAL:
            continue
        row = lanes[lane_id]
        if (
            row.get("family") != family
            or row.get("disposition") != "runnable"
            or row.get("reason_code") is not None
            or row.get("reason") is not None
        ):
            raise ValueError(f"{lane_id}: reviewed runnable Gate 5 disposition changed")
    defense = lanes[DEFENSE_LOCAL]
    if defense.get("disposition") == "runnable":
        if (
            defense.get("family") != "core"
            or defense.get("reason_code") is not None
            or defense.get("reason") is not None
        ):
            raise ValueError("defense-local: reviewed runnable Gate 5 identity changed")
    elif defense.get("disposition") == "conditional_na":
        validate_defense_conditional_shape(defense, label)
        if verify_conditional_artifact:
            validate_defense_conditional_artifact(defense, label)
    else:
        raise ValueError("defense-local: only runnable or exact conditional N/A is admitted")
    for lane_id, (family, disposition) in EXPECTED_TERMINALS.items():
        row = lanes[lane_id]
        if lane_id in RR_TERMINAL_LANE_SET:
            continue
        if (
            row.get("family") != family
            or row.get("disposition") != disposition
            or not isinstance(row.get("reason_code"), str)
            or not row["reason_code"]
            or not isinstance(row.get("reason"), str)
            or not row["reason"]
        ):
            raise ValueError(f"{lane_id}: reviewed terminal Gate 5 disposition changed")
        if lane_id in GPTGEOCHAT_OLLAMA_TERMINALS and any(
            row.get(field) != expected
            for field, expected in GPTGEOCHAT_OLLAMA_TERMINALS[lane_id].items()
        ):
            raise ValueError(f"{lane_id}: exact transport terminal reason changed")
    counts = selected_inventory_counts(lanes)
    if (
        sum(row.get("disposition") == "runnable" for row in lanes.values())
        != counts["runnable"]
        or sum(row.get("disposition") != "runnable" for row in lanes.values())
        != counts["typed_terminal"]
    ):
        raise ValueError(f"{label}: Gate 5 inventory profile counts changed")
    return lanes

def inventory_contract_self_test() -> None:
    acquisition_result_contract_self_test()
    live_binding_contract_self_test()
    rr_descriptor = {
        "path": str((Path.cwd() / "fixture-rr-runtime-terminal.json").resolve()),
        "sha256": "d" * 64,
        "bytes": 1,
    }

    def terminal_fixture(
        lane: str, family: str, disposition: str
    ) -> dict[str, Any]:
        if lane in RR_TERMINAL_LANE_SET:
            marker = {"status": "UNAVAILABLE", "value": None}
            fixture_root = Path.cwd().resolve()
            projection_id = f"lane-projection-{hashlib.sha256(lane.encode()).hexdigest()[:24]}"
            envelope_id = f"request-envelope-{lane}"
            return {
                "lane_id": lane,
                "family": "core",
                "disposition": "unavailable",
                "reason_code": RR_TERMINAL_REASON_CODE,
                "reason": RR_TERMINAL_REASON,
                "projection": {
                    "status": "passed",
                    "value": {
                        "projection_id": projection_id,
                        "projection_artifact": {
                            "path": str(
                                fixture_root / f"{projection_id}.lane-projection.json"
                            ),
                            "file": f"{projection_id}.lane-projection.json",
                            "sha256": "1" * 64,
                            "bytes": 1,
                        },
                        "eligibility_plan_id": f"eligibility-{lane}",
                        "eligibility_artifact": {
                            "path": str(
                                fixture_root / f"eligibility-{lane}.eligibility.json"
                            ),
                            "sha256": "2" * 64,
                            "bytes": 1,
                        },
                        "request_envelope_id": envelope_id,
                        "request_envelope_artifact": {
                            "path": str(
                                fixture_root / f"{envelope_id}.request-envelope.json"
                            ),
                            "envelope_id": envelope_id,
                            "file": f"{envelope_id}.request-envelope.json",
                            "sha256": "3" * 64,
                            "bytes": 1,
                        },
                        "selection": {"lane_id": lane},
                        "projected_calls": {
                            "trajectories": 1,
                            "target_calls": 1,
                            "model_judge_calls": 0,
                            "local_guardrail_evaluations": 0,
                            "http_attempts": 0,
                        },
                    },
                },
                "canary": {
                    **marker,
                    "target_runtime_terminal_artifact": dict(rr_descriptor),
                },
                "final_preflight": marker,
                "approved_caps": marker,
            }
        return {
            "lane_id": lane, "family": family, "disposition": disposition,
            "reason_code": GPTGEOCHAT_OLLAMA_TERMINALS.get(lane, {}).get(
                "reason_code", "reviewed_terminal"
            ),
            "reason": GPTGEOCHAT_OLLAMA_TERMINALS.get(lane, {}).get(
                "reason", "reviewed terminal"
            ),
        }

    success = [
        {
            "lane_id": lane, "family": family, "disposition": "runnable",
            "reason_code": None, "reason": None,
        }
        for lane, family in EXPECTED_RUNNABLE_FAMILIES.items()
    ] + [
        terminal_fixture(lane, family, disposition)
        for lane, (family, disposition) in EXPECTED_TERMINALS.items()
    ]
    validate_inventory_identity(
        success, "self-test-success", verify_conditional_artifact=False
    )
    conditional = copy.deepcopy(success)
    defense_index = next(
        index for index, row in enumerate(conditional)
        if row["lane_id"] == DEFENSE_LOCAL
    )
    conditional[defense_index] = {
        "lane_id": DEFENSE_LOCAL,
        "family": "core",
        "disposition": "conditional_na",
        "reason_code": DEFENSE_CONDITIONAL_REASON_CODE,
        "reason": DEFENSE_CONDITIONAL_REASON,
        "projection": {"status": "N/A", "value": None},
        "canary": {
            "status": "N/A",
            "value": None,
            "conditional_na_artifact": {
                "path": str((Path.cwd() / "fixture-defense-na.json").resolve()),
                "sha256": "a" * 64,
                "bytes": 1,
            },
            "call_accounting": dict(DEFENSE_CONDITIONAL_ACCOUNTING),
        },
        "final_preflight": {"status": "N/A", "value": None},
        "approved_caps": {"status": "N/A", "value": None},
    }
    validate_inventory_identity(
        conditional, "self-test-conditional", verify_conditional_artifact=False
    )
    conditional_v2 = copy.deepcopy(conditional)
    conditional_v2[defense_index]["reason_code"] = DEFENSE_CONDITIONAL_V2_REASON_CODE
    conditional_v2[defense_index]["reason"] = DEFENSE_CONDITIONAL_V2_REASON
    conditional_v2[defense_index]["canary"]["call_accounting"] = copy.deepcopy(
        DEFENSE_CONDITIONAL_V2_ACCOUNTING
    )
    validate_inventory_identity(
        conditional_v2, "self-test-conditional-v2", verify_conditional_artifact=False
    )
    conditional_v2_cross_mix = copy.deepcopy(conditional_v2)
    conditional_v2_cross_mix[defense_index]["reason"] = DEFENSE_CONDITIONAL_REASON
    mutations = []
    mutations.append(conditional_v2_cross_mix)
    missing = copy.deepcopy(success)
    missing.pop()
    mutations.append(missing)
    duplicate = copy.deepcopy(success)
    duplicate[-1] = copy.deepcopy(duplicate[0])
    mutations.append(duplicate)
    wrong_family = copy.deepcopy(success)
    wrong_family[0]["family"] = "bridge"
    mutations.append(wrong_family)
    wrong_disposition = copy.deepcopy(success)
    wrong_disposition[0]["disposition"] = "unavailable"
    mutations.append(wrong_disposition)
    missing_reason = copy.deepcopy(success)
    missing_reason[-1]["reason"] = ""
    mutations.append(missing_reason)
    wrong_transport_reason = copy.deepcopy(success)
    next(
        row for row in wrong_transport_reason
        if row["lane_id"] == "gptgeochat-ollama-rwkv-g1d-0p4b"
    )["reason_code"] = "generic_unavailable"
    mutations.append(wrong_transport_reason)
    wrong_rr_reason_code = copy.deepcopy(success)
    next(
        row for row in wrong_rr_reason_code
        if row["lane_id"] == RR_TERMINAL_LANES[0]
    )["reason_code"] = "generic_unavailable"
    mutations.append(wrong_rr_reason_code)
    divergent_rr_descriptor = copy.deepcopy(success)
    next(
        row for row in divergent_rr_descriptor
        if row["lane_id"] == RR_TERMINAL_LANES[-1]
    )["canary"]["target_runtime_terminal_artifact"]["sha256"] = "e" * 64
    mutations.append(divergent_rr_descriptor)
    runnable_rr = copy.deepcopy(success)
    next(
        row for row in runnable_rr
        if row["lane_id"] == RR_TERMINAL_LANES[0]
    )["disposition"] = "runnable"
    mutations.append(runnable_rr)
    lost_rr_projection = copy.deepcopy(success)
    next(
        row for row in lost_rr_projection
        if row["lane_id"] == RR_TERMINAL_LANES[0]
    )["projection"] = {"status": "UNAVAILABLE", "value": None}
    mutations.append(lost_rr_projection)
    wrong_rr_projection_file = copy.deepcopy(success)
    next(
        row for row in wrong_rr_projection_file
        if row["lane_id"] == RR_TERMINAL_LANES[0]
    )["projection"]["value"]["projection_artifact"]["file"] = (
        "forged.lane-projection.json"
    )
    mutations.append(wrong_rr_projection_file)
    wrong_rr_envelope_id = copy.deepcopy(success)
    next(
        row for row in wrong_rr_envelope_id
        if row["lane_id"] == RR_TERMINAL_LANES[-1]
    )["projection"]["value"]["request_envelope_artifact"]["envelope_id"] = (
        "request-envelope-forged"
    )
    mutations.append(wrong_rr_envelope_id)
    rich_rr_eligibility = copy.deepcopy(success)
    next(
        row for row in rich_rr_eligibility
        if row["lane_id"] == RR_TERMINAL_LANES[0]
    )["projection"]["value"]["eligibility_artifact"]["file"] = (
        "forged.eligibility.json"
    )
    mutations.append(rich_rr_eligibility)
    wrong_reason_code = copy.deepcopy(conditional)
    wrong_reason_code[defense_index]["reason_code"] = "cuda_oom"
    mutations.append(wrong_reason_code)
    wrong_reason = copy.deepcopy(conditional)
    wrong_reason[defense_index]["reason"] += " forged"
    mutations.append(wrong_reason)
    nonzero_call = copy.deepcopy(conditional)
    nonzero_call[defense_index]["canary"]["call_accounting"]["target_calls"] = 1
    mutations.append(nonzero_call)
    bool_call = copy.deepcopy(conditional)
    bool_call[defense_index]["canary"]["call_accounting"]["target_calls"] = False
    mutations.append(bool_call)
    wrong_na = copy.deepcopy(conditional)
    wrong_na[defense_index]["canary"]["status"] = "UNAVAILABLE"
    mutations.append(wrong_na)
    missing_artifact = copy.deepcopy(conditional)
    missing_artifact[defense_index]["canary"].pop("conditional_na_artifact")
    mutations.append(missing_artifact)
    pseudo_na = copy.deepcopy(success)
    pseudo_na[0] = copy.deepcopy(conditional[defense_index])
    pseudo_na[0]["lane_id"] = success[0]["lane_id"]
    mutations.append(pseudo_na)
    for index, mutation in enumerate(mutations, 1):
        try:
            validate_inventory_identity(
                mutation, f"mutation-{index}", verify_conditional_artifact=False
            )
        except ValueError:
            continue
        raise RuntimeError(f"inventory contract mutation {index} was accepted")

def validate_promotion_header(value: Any) -> None:
    expected_fields = {
        "schema", "status", "completed_at_utc", "promotion_plan", "authorization",
        "inputs", "canonical_runnote", "prior_canonical", "inventory_counts",
        "local_only", "downloads_observed_bytes", "measured_run_launched",
    }
    if (
        not isinstance(value, dict)
        or set(value) != expected_fields
        or value.get("schema") != "ura-gate5-runnote-promotion/1"
        or value.get("status") != "complete"
        or not any(
            type_strict_equal(value.get("inventory_counts"), expected)
            for expected in ALLOWED_INVENTORY_COUNTS
        )
        or not type_strict_equal(value.get("local_only"), LOCAL_ONLY_PROMOTION)
        or type(value.get("downloads_observed_bytes")) is not int
        or value.get("downloads_observed_bytes") != 0
        or value.get("measured_run_launched") is not False
    ):
        raise ValueError("Gate 5 promotion receipt contract changed")
    try:
        completed_at = datetime.fromisoformat(
            str(value.get("completed_at_utc", "")).replace("Z", "+00:00")
        )
    except ValueError as exc:
        raise ValueError("Gate 5 promotion receipt timestamp is invalid") from exc
    if completed_at.tzinfo is None or completed_at.utcoffset() != timezone.utc.utcoffset(completed_at):
        raise ValueError("Gate 5 promotion receipt timestamp is not UTC")

def validate_promotion_plan_header(
    value: Any,
    promotion: dict[str, Any],
    commit: str,
    lock: str,
) -> None:
    expected_fields = {
        "schema", "status", "code_identity", "inputs", "inventory_counts",
        "local_only", "canonical_runnote", "prior_canonical",
        "placeholder_archive_destination", "promotion_receipt_destination",
        "authorization",
    }
    if (
        not isinstance(value, dict)
        or set(value) != expected_fields
        or value.get("schema") != "ura-gate5-runnote-promotion-plan/1"
        or value.get("status") != "candidate_only"
        or value.get("code_identity") != {
            "expected_commit": commit, "framework_lock_id": lock,
        }
        or not type_strict_equal(value.get("inventory_counts"), promotion["inventory_counts"])
        or not type_strict_equal(value.get("local_only"), promotion["local_only"])
        or value.get("authorization") != {
            "kind": "exact_promotion_plan_sha256",
            "required": True,
            "launches_models_or_jobs": False,
        }
    ):
        raise ValueError("Gate 5 promotion plan contract changed")

def promotion_contract_self_test(commit: str, lock: str) -> None:
    promotion = {
        "schema": "ura-gate5-runnote-promotion/1", "status": "complete",
        "completed_at_utc": "2026-08-22T00:00:00Z", "promotion_plan": {},
        "authorization": {}, "inputs": {}, "canonical_runnote": {},
        "prior_canonical": {}, "inventory_counts": dict(SUCCESS_INVENTORY_COUNTS),
        "local_only": dict(LOCAL_ONLY_PROMOTION), "downloads_observed_bytes": 0,
        "measured_run_launched": False,
    }
    plan = {
        "schema": "ura-gate5-runnote-promotion-plan/1", "status": "candidate_only",
        "code_identity": {"expected_commit": commit, "framework_lock_id": lock},
        "inputs": {}, "inventory_counts": dict(SUCCESS_INVENTORY_COUNTS),
        "local_only": dict(LOCAL_ONLY_PROMOTION), "canonical_runnote": {},
        "prior_canonical": {}, "placeholder_archive_destination": "/archive",
        "promotion_receipt_destination": "/receipt",
        "authorization": {
            "kind": "exact_promotion_plan_sha256", "required": True,
            "launches_models_or_jobs": False,
        },
    }
    validate_promotion_header(promotion)
    validate_promotion_plan_header(plan, promotion, commit, lock)
    conditional_promotion = copy.deepcopy(promotion)
    conditional_promotion["inventory_counts"] = dict(CONDITIONAL_INVENTORY_COUNTS)
    conditional_plan = copy.deepcopy(plan)
    conditional_plan["inventory_counts"] = dict(CONDITIONAL_INVENTORY_COUNTS)
    validate_promotion_header(conditional_promotion)
    validate_promotion_plan_header(
        conditional_plan, conditional_promotion, commit, lock
    )
    mutations: list[tuple[str, dict[str, Any], str]] = []
    wrong_count = copy.deepcopy(promotion)
    wrong_count["inventory_counts"]["total"] = 42
    mutations.append(("receipt-count", wrong_count, "receipt"))
    wrong_profile = copy.deepcopy(conditional_promotion)
    wrong_profile["inventory_counts"]["conditional_na_lanes"] = []
    mutations.append(("receipt-profile", wrong_profile, "receipt"))
    wrong_local = copy.deepcopy(promotion)
    wrong_local["local_only"]["model_downloads"] = 1
    mutations.append(("receipt-local-only", wrong_local, "receipt"))
    wrong_launch = copy.deepcopy(promotion)
    wrong_launch["measured_run_launched"] = True
    mutations.append(("receipt-launch", wrong_launch, "receipt"))
    bool_zero = copy.deepcopy(promotion)
    bool_zero["downloads_observed_bytes"] = False
    mutations.append(("receipt-bool-zero", bool_zero, "receipt"))
    local_time = copy.deepcopy(promotion)
    local_time["completed_at_utc"] = "2026-08-22T00:00:00"
    mutations.append(("receipt-local-time", local_time, "receipt"))
    extra = copy.deepcopy(promotion)
    extra["unexpected"] = None
    mutations.append(("receipt-fields", extra, "receipt"))
    wrong_code = copy.deepcopy(plan)
    wrong_code["code_identity"]["expected_commit"] = "0" * 40
    mutations.append(("plan-code", wrong_code, "plan"))
    wrong_auth = copy.deepcopy(plan)
    wrong_auth["authorization"]["required"] = False
    mutations.append(("plan-authorization", wrong_auth, "plan"))
    wrong_plan_local = copy.deepcopy(plan)
    wrong_plan_local["local_only"]["http_attempts"] = 1
    mutations.append(("plan-local-only", wrong_plan_local, "plan"))
    mismatched_plan_profile = copy.deepcopy(conditional_plan)
    mismatched_plan_profile["inventory_counts"] = dict(SUCCESS_INVENTORY_COUNTS)
    mutations.append(("plan-profile", mismatched_plan_profile, "conditional-plan"))
    for label, mutation, kind in mutations:
        try:
            if kind == "receipt":
                validate_promotion_header(mutation)
            elif kind == "plan":
                validate_promotion_plan_header(mutation, promotion, commit, lock)
            else:
                validate_promotion_plan_header(
                    mutation, conditional_promotion, commit, lock
                )
        except ValueError:
            continue
        raise RuntimeError(f"promotion contract mutation was accepted: {label}")

def validate_canonical_approval(value: Any, manifest_sha256: str) -> None:
    if (
        not isinstance(value, dict)
        or set(value) != {
            "kind", "approver", "authentication", "covered_manifest_sha256",
            "scope", "asserted_at_utc",
        }
        or value.get("kind") != "operator_assertion"
        or value.get("approver") != "project operator"
        or value.get("authentication") != "operator_asserted"
        or value.get("covered_manifest_sha256") != manifest_sha256
        or value.get("scope")
        != (
            "exact frozen Gate-5 lane inventory, caps, call-start and "
            "measured-lane wall-time semantics, and external storage policy"
        )
    ):
        raise ValueError("RUNNOTE approval does not bind the covered manifest")
    try:
        asserted_at = datetime.fromisoformat(
            str(value.get("asserted_at_utc", "")).replace("Z", "+00:00")
        )
    except ValueError as exc:
        raise ValueError("RUNNOTE approval timestamp is invalid") from exc
    if asserted_at.tzinfo is None or asserted_at.utcoffset() != timezone.utc.utcoffset(asserted_at):
        raise ValueError("RUNNOTE approval timestamp is not UTC")

def canonical_approval_self_test() -> None:
    digest = "a" * 64
    approval = {
        "kind": "operator_assertion", "approver": "project operator",
        "authentication": "operator_asserted", "covered_manifest_sha256": digest,
        "scope": (
            "exact frozen Gate-5 lane inventory, caps, call-start and "
            "measured-lane wall-time semantics, and external storage policy"
        ),
        "asserted_at_utc": "2026-08-22T00:00:00Z",
    }
    validate_canonical_approval(approval, digest)
    mutations = []
    missing_scope = copy.deepcopy(approval)
    missing_scope.pop("scope")
    mutations.append(missing_scope)
    wrong_scope = copy.deepcopy(approval)
    wrong_scope["scope"] = "partial"
    mutations.append(wrong_scope)
    wrong_digest = copy.deepcopy(approval)
    wrong_digest["covered_manifest_sha256"] = "b" * 64
    mutations.append(wrong_digest)
    local_time = copy.deepcopy(approval)
    local_time["asserted_at_utc"] = "2026-08-22T00:00:00"
    mutations.append(local_time)
    for index, mutation in enumerate(mutations, 1):
        try:
            validate_canonical_approval(mutation, digest)
        except ValueError:
            continue
        raise RuntimeError(f"canonical approval mutation {index} was accepted")

def lane_contract(lane: str) -> dict[str, Any]:
    if lane == "defense-local":
        return {
            "target_key": "qwen3-vl", "corpora": TEXT_ARMS,
            "attacker": "replay", "judges": "rules,guardrail",
            "approximate": True, "max_queries": 1, "max_turns": 1,
            "modality": "text", "defense": "both",
            "defense_guard": "guardrail",
        }
    if "qwen3-vl" in lane:
        target_key = "qwen3-vl"
    elif "llava-base" in lane:
        target_key = "llava-base"
    elif "llava-rr" in lane:
        target_key = "llava-rr"
    else:
        raise ValueError(f"cannot map target for {lane}")
    if lane.startswith("local-"):
        modality = "image" if "-image-" in lane else "text"
        return {
            "target_key": target_key,
            "corpora": IMAGE_ARMS if modality == "image" else TEXT_ARMS,
            "attacker": "replay", "judges": "rules,guardrail",
            "approximate": True, "max_queries": 1, "max_turns": 1,
            "modality": modality, "defense": "none", "defense_guard": "rules",
        }
    if lane.startswith("rjudge-"):
        return {
            "target_key": target_key, "corpora": "rjudge_release",
            "attacker": "replay", "judges": "rules", "approximate": False,
            "max_queries": 1, "max_turns": 1, "modality": "text",
            "defense": "none", "defense_guard": "rules",
        }
    if lane.startswith("gptgeochat-"):
        return {
            "target_key": target_key, "corpora": "gptgeochat_release",
            "attacker": "replay", "judges": "rules", "approximate": False,
            "max_queries": 1, "max_turns": 1, "modality": "image",
            "defense": "none", "defense_guard": "rules",
        }
    if lane == "crescendo-qwen3-vl":
        return {
            "target_key": target_key, "corpora": ADAPTIVE_ARMS,
            "attacker": "crescendo", "judges": "rules,guardrail",
            "approximate": True, "max_queries": 4, "max_turns": 4,
            "modality": "text", "defense": "none", "defense_guard": "rules",
        }
    raise ValueError(f"unsupported core lane {lane}")

manifest_path, manifest_raw = stable_regular_bytes(manifest_path, "Gate 5 covered manifest")
runnote_path, runnote_raw = stable_regular_bytes(runnote_path, "canonical Gate 5 RUNNOTE")
promotion_path, promotion_raw = stable_regular_bytes(
    promotion_path, "Gate 5 promotion receipt"
)
launch_path, launch_raw = stable_regular_bytes(launch_path, "Phase 6 core launch")
manifest_sha = hashlib.sha256(manifest_raw).hexdigest()
manifest = strict_json_loads(manifest_raw)
launch = strict_object_bytes(launch_raw, "Phase 6 core launch")
expected_launch_fields = {
    "schema", "expected_commit", "framework_lock_id", "manifest_sha256",
    "authorized_manifest_sha256", "manifest", "runnote", "promotion_receipt",
    "control_root", "payload",
}
if set(launch) != expected_launch_fields or launch.get("schema") != "ura-phase6-core-controller-launch/1":
    raise ValueError("Phase 6 core launch metadata contract changed")
for key, expected_path, observed_payload in (
    ("manifest", manifest_path, manifest_raw),
    ("runnote", runnote_path, runnote_raw),
    ("promotion_receipt", promotion_path, promotion_raw),
):
    if exact_observed_descriptor(
        launch.get(key), expected_path, observed_payload, f"launch {key}"
    ) != expected_path:
        raise ValueError(f"Phase 6 core launch {key} locator changed")
payload_path = exact_descriptor(launch.get("payload"), "launch payload")
if payload_path != launch_path.parent / "payload.sh" or launch.get("control_root") != str(launch_path.parent):
    raise ValueError("Phase 6 core launch control-root or payload locator changed")
if launch.get("expected_commit") != expected_commit or launch.get("framework_lock_id") != expected_lock:
    raise ValueError("Phase 6 core launch code identity changed")
if launch.get("manifest_sha256") != manifest_sha or launch.get("authorized_manifest_sha256") != manifest_sha:
    raise ValueError("launch authorization does not cover the supplied manifest bytes")
if not isinstance(manifest, dict) or manifest.get("schema") != "ura-gate5-covered-manifest/1" or manifest.get("inventory_complete") is not True:
    raise ValueError("Gate 5 covered manifest is incomplete or unsupported")
if manifest.get("code_identity") != {"expected_commit": expected_commit, "framework_lock_id": expected_lock}:
    raise ValueError("Gate 5 code identity differs from the measured controller")
policy = manifest.get("policy")
if not isinstance(policy, dict):
    raise ValueError("Gate 5 policy is absent")
expected_population_tiers = {
    "primary_core": {
        "cluster_limit_per_selected_arm": 100,
        "sample_seed": 0,
        "selection_method": "seeded_nested_source_cluster_prefix_v1",
        "purpose": "primary_cluster_level_estimation",
    },
    "extended_exploratory": {
        "cluster_limit_per_selected_arm": 50,
        "sample_seed": 0,
        "selection_method": "seeded_nested_source_cluster_prefix_v1",
        "purpose": "descriptive_precision_limited_framework_and_ollama_evidence",
    },
    "full_corpus_mode": {
        "cluster_limit_per_selected_arm": 0,
        "status": "supported_not_selected_for_this_measured_cohort",
    },
}
if (
    policy.get("population_tiers") != expected_population_tiers
    or policy.get("target_and_transport_caps") != "exact_preliminary_call_projection_totals"
    or any(
        type(policy.get(key)) is not int or policy.get(key) != 0
        for key in (
            "model_judge_calls_required", "http_attempts_required",
            "downloads_required_bytes",
        )
    )
    or policy.get("call_start_deadline_semantics") != "admission_window_from_first_invocation_not_completion_timeout"
    or policy.get("measured_lane_wall_time_semantics")
    != "controller_completion_ceiling_distinct_from_call_start_admission_window"
):
    raise ValueError("Gate 5 policy does not authorize the local exact-cap contract")
deadline = policy.get("call_start_deadline_seconds")
lane_wall_time = policy.get("measured_lane_wall_time_seconds")
free_floor = policy.get("free_space_floor_bytes")
storage_limit = policy.get("retained_output_policy_bytes")
if any(
    isinstance(value, bool) or not isinstance(value, int) or value <= 0
    for value in (deadline, lane_wall_time, free_floor, storage_limit)
):
    raise ValueError("Gate 5 deadline/storage policy is invalid")
if lane_wall_time != 86_400:
    raise ValueError("Gate 5 measured-lane wall-time ceiling changed")
if deadline != 86_400:
    raise ValueError("Gate 5 call-start deadline changed")

markdown = runnote_raw.decode("utf-8", errors="strict")
matches = re.findall(r"(?ms)^```json\s*$\n(.*?)^```\s*$", markdown)
if len(matches) != 1:
    raise ValueError("canonical Gate 5 RUNNOTE must contain one machine-readable JSON block")
note = strict_json_loads(matches[0])
expected_note_fields = {
    "schema", "status", "created_at_utc", "candidate_only",
    "canonical_runnote", "promotion_basis", "approval", "covered_manifest",
    "input_evidence", "failed_attempts", "policy", "storage_observations",
    "checkout", "project_revision", "source_conformance", "system", "routes",
    "execution_accounting", "future_measured_run", "lanes",
}
if (
    not isinstance(note, dict)
    or set(note) != expected_note_fields
    or note.get("schema") != "ura-gate5-runnote/1"
    or note.get("status") != "complete"
    or note.get("candidate_only") is not False
):
    raise ValueError("canonical Gate 5 RUNNOTE is incomplete or unsupported")
try:
    runnote_created_at = datetime.fromisoformat(
        str(note.get("created_at_utc", "")).replace("Z", "+00:00")
    )
except ValueError as exc:
    raise ValueError("canonical Gate 5 RUNNOTE creation timestamp is invalid") from exc
if runnote_created_at.tzinfo is None or runnote_created_at.utcoffset() != timezone.utc.utcoffset(runnote_created_at):
    raise ValueError("canonical Gate 5 RUNNOTE creation timestamp is not UTC")
expected_canonical = Path(os.environ["URA_WORK"]).resolve(strict=True) / "runs" / "thesis" / "RUNNOTE.md"
if note.get("canonical_runnote") != str(expected_canonical):
    raise ValueError("canonical Gate 5 RUNNOTE locator changed")

promotion = strict_object_bytes(promotion_raw, "Gate 5 promotion receipt")
promotion_contract_self_test(expected_commit, expected_lock)
validate_promotion_header(promotion)
plan_path, plan_raw = exact_descriptor_bytes(
    promotion.get("promotion_plan"), "promotion plan"
)
authorization = promotion.get("authorization")
if authorization != {
    "kind": "exact_promotion_plan_sha256",
    "authorized_plan_sha256": promotion["promotion_plan"]["sha256"],
}:
    raise ValueError("Gate 5 promotion authorization changed")
canonical_path, canonical_raw = exact_descriptor_bytes(
    promotion.get("canonical_runnote"), "promoted canonical RUNNOTE"
)
if canonical_path != expected_canonical or canonical_raw != runnote_raw:
    raise ValueError("promoted canonical RUNNOTE bytes differ from the sealed controller input")
plan = strict_object_bytes(plan_raw, "promotion plan")
validate_promotion_plan_header(plan, promotion, expected_commit, expected_lock)
plan_canonical = plan.get("canonical_runnote")
if plan_canonical != {
    "destination": str(expected_canonical),
    "proposed_sha256": promotion["canonical_runnote"]["sha256"],
    "proposed_bytes": promotion["canonical_runnote"]["bytes"],
    "schema": "ura-gate5-runnote/1",
    "candidate_only": False,
}:
    raise ValueError("Gate 5 promotion plan does not bind the canonical RUNNOTE bytes")
expected_receipt_destination = expected_canonical.parent / (
    "RUNNOTE.gate5-promotion-"
    + promotion["canonical_runnote"]["sha256"][:16]
    + ".receipt.json"
)
if Path(str(plan.get("promotion_receipt_destination", ""))) != expected_receipt_destination:
    raise ValueError("Gate 5 promotion plan receipt destination changed")
receipt_destination, receipt_destination_raw = stable_regular_bytes(
    expected_receipt_destination, "canonical Gate 5 promotion receipt"
)
if receipt_destination != expected_receipt_destination or receipt_destination_raw != promotion_raw:
    raise ValueError("sealed Gate 5 promotion receipt differs from its canonical artifact")
if plan_path.parent != expected_canonical.parent:
    raise ValueError("Gate 5 promotion plan is outside the canonical thesis-runs root")
expected_archive_destination = expected_canonical.parent / (
    "RUNNOTE.pre-gate5-placeholder-7ec84df8ea241fd0.md"
)
if Path(str(plan.get("placeholder_archive_destination", ""))) != expected_archive_destination:
    raise ValueError("Gate 5 promotion plan placeholder-archive destination changed")
promotion_inputs = promotion.get("inputs")
if not isinstance(promotion_inputs, dict) or set(promotion_inputs) != {
    "covered_manifest", "runnote_candidate", "finalization_receipt",
    "finalizer_exit", "project_revision", "source_conformance",
}:
    raise ValueError("Gate 5 promotion input inventory changed")
promotion_input_observations = {
    key: exact_descriptor_bytes(value, f"promotion input {key}")
    for key, value in promotion_inputs.items()
}
if plan.get("inputs") != promotion_inputs:
    raise ValueError("Gate 5 promotion plan and receipt bind different inputs")
if promotion_inputs["covered_manifest"]["sha256"] != manifest_sha or promotion_inputs["covered_manifest"]["bytes"] != len(manifest_raw):
    raise ValueError("promotion receipt does not bind the exact covered manifest")
if promotion_input_observations["covered_manifest"][1] != manifest_raw:
    raise ValueError("promotion covered-manifest bytes differ from the sealed controller input")
for key, path_env, sha_env in (
    ("project_revision", "URA_PROJECT_REVISION_MANIFEST", "URA_PROJECT_REVISION_SHA256"),
    ("source_conformance", "URA_SOURCE_CONFORMANCE_MANIFEST", "URA_SOURCE_CONFORMANCE_SHA256"),
):
    current_path = Path(os.environ[path_env]).resolve(strict=True)
    if (
        promotion_input_observations[key][0] != current_path
        or promotion_inputs[key]["sha256"] != os.environ[sha_env]
    ):
        raise ValueError(f"Gate 5 promotion {key} is not the current rig receipt")
promotion_basis = note.get("promotion_basis")
if not isinstance(promotion_basis, dict) or set(promotion_basis) != {
    "covered_manifest", "runnote_candidate", "finalization_receipt", "finalizer_exit",
    "current_project_revision", "current_source_conformance",
    "all_final_preflights_revalidated", "local_only_zero_download_revalidated",
    "measured_run_launched",
}:
    raise ValueError("canonical Gate 5 promotion-basis inventory changed")
if (
    promotion_basis["covered_manifest"] != promotion_inputs["covered_manifest"]
    or promotion_basis["runnote_candidate"] != promotion_inputs["runnote_candidate"]
    or promotion_basis["finalization_receipt"] != promotion_inputs["finalization_receipt"]
    or promotion_basis["finalizer_exit"] != promotion_inputs["finalizer_exit"]
    or promotion_basis["current_project_revision"] != promotion_inputs["project_revision"]
    or promotion_basis["current_source_conformance"] != promotion_inputs["source_conformance"]
    or promotion_basis["all_final_preflights_revalidated"] is not True
    or promotion_basis["local_only_zero_download_revalidated"] is not True
    or promotion_basis["measured_run_launched"] is not False
):
    raise ValueError("canonical Gate 5 promotion basis differs from the receipt")
prior = promotion.get("prior_canonical")
if not isinstance(prior, dict) or set(prior) != {"state", "artifact", "archive"} or prior.get("state") not in {"placeholder_archived_and_replaced", "already_identical"}:
    raise ValueError("Gate 5 prior-canonical record changed")
artifact = prior.get("artifact")
if not isinstance(artifact, dict) or set(artifact) != {"path", "sha256", "bytes"}:
    raise ValueError("Gate 5 prior-canonical artifact descriptor changed")
archive = prior.get("archive")
if prior["state"] == "placeholder_archived_and_replaced":
    if artifact != {
        "path": str(expected_canonical),
        "sha256": "7ec84df8ea241fd09e6403de30a06fc18c10c8ff449b99834821b567dace17cf",
        "bytes": 22,
    }:
        raise ValueError("Gate 5 prior placeholder identity changed")
    archived_path = exact_descriptor(archive, "archived pre-Gate-5 RUNNOTE")
    if archive["sha256"] != artifact["sha256"] or archive["bytes"] != artifact["bytes"]:
        raise ValueError("archived pre-Gate-5 RUNNOTE differs from the displaced placeholder")
    del archived_path
else:
    if artifact != promotion["canonical_runnote"]:
        raise ValueError("already-identical prior canonical identity changed")
    if archive != {"status": "N/A", "value": None}:
        archived_path = exact_descriptor(archive, "pre-existing archived RUNNOTE")
        if (
            archive["sha256"] != "7ec84df8ea241fd09e6403de30a06fc18c10c8ff449b99834821b567dace17cf"
            or archive["bytes"] != 22
        ):
            raise ValueError("pre-existing archived RUNNOTE is not the exact placeholder")
        del archived_path
plan_prior = plan.get("prior_canonical")
if not isinstance(plan_prior, dict) or set(plan_prior) != {"state", "artifact"}:
    raise ValueError("Gate 5 promotion plan prior-canonical record changed")
expected_plan_prior_state = (
    "exact_placeholder"
    if prior["state"] == "placeholder_archived_and_replaced"
    else "identical_canonical"
)
if plan_prior != {"state": expected_plan_prior_state, "artifact": artifact}:
    raise ValueError("Gate 5 promotion plan and receipt disagree about prior canonical state")
approval = note.get("approval")
canonical_approval_self_test()
validate_canonical_approval(approval, manifest_sha)
covered = note.get("covered_manifest")
if not isinstance(covered, dict) or covered.get("sha256") != manifest_sha or covered.get("bytes") != len(manifest_raw):
    raise ValueError("RUNNOTE covered-manifest descriptor mismatch")
covered_path, covered_raw = exact_descriptor_bytes(covered, "RUNNOTE covered manifest")
if not covered_path.is_absolute() or covered_raw != manifest_raw:
    raise ValueError("RUNNOTE covered-manifest descriptor is not the exact absolute Gate 5 artifact")
if note.get("policy") != policy:
    raise ValueError("RUNNOTE and manifest policies differ")
routes = note.get("routes")
if (
    not isinstance(routes, dict)
    or routes.get("target") != "local_only"
    or any(
        type(routes.get(key)) is not int or routes.get(key) != 0
        for key in ("hosted_target_calls", "hosted_judge_calls", "http_attempts")
    )
):
    raise ValueError("RUNNOTE is not an all-local zero-hosted-route record")

manifest_rows = manifest.get("lanes")
note_rows = note.get("lanes")
inventory_contract_self_test()
manifest_lanes = validate_inventory_identity(manifest_rows, "Gate 5 covered manifest")
note_lanes = validate_inventory_identity(note_rows, "canonical RUNNOTE")
manifest_counts = selected_inventory_counts(manifest_lanes)
note_counts = selected_inventory_counts(note_lanes)
if (
    not type_strict_equal(manifest_counts, note_counts)
    or not type_strict_equal(promotion.get("inventory_counts"), manifest_counts)
    or not type_strict_equal(plan.get("inventory_counts"), manifest_counts)
):
    raise ValueError("Gate 5 manifest/RUNNOTE/promotion inventory profiles differ")
finalization_path, finalization_raw = exact_descriptor_bytes(
    promotion_inputs["finalization_receipt"], "Gate 5 finalization receipt"
)
finalization = strict_object_bytes(finalization_raw, "Gate 5 finalization receipt")
if (
    finalization.get("schema") != "ura-gate5-finalization-receipt/1"
    or finalization.get("status") != "complete"
    or type(finalization.get("runnable_lanes")) is not int
    or finalization.get("runnable_lanes") != manifest_counts["runnable"]
    or type(finalization.get("typed_terminal_lanes")) is not int
    or finalization.get("typed_terminal_lanes") != manifest_counts["typed_terminal"]
    or type(finalization.get("target_runtime_terminal")) is not int
    or finalization.get("target_runtime_terminal")
    != manifest_counts["target_runtime_terminal"]
    or finalization.get("conditional_na_lanes")
    != manifest_counts["conditional_na_lanes"]
):
    raise ValueError("Gate 5 finalization receipt inventory profile changed")
for lane_id, raw_lane in manifest_lanes.items():
    completed_lane = note_lanes[lane_id]
    if raw_lane.get("disposition") == "runnable":
        lane_execution = completed_lane.get("execution")
        lane_final = completed_lane.get("final_preflight")
        if (
            not isinstance(lane_execution, dict)
            or lane_execution.get("final_preflight") != lane_final
            or completed_lane
            != {**raw_lane, "execution": lane_execution, "final_preflight": lane_final}
        ):
            raise ValueError(f"{lane_id}: RUNNOTE runnable row is not an exact finalization")
        acquisition = lane_execution.get("acquisition")
        if (
            not isinstance(lane_final, dict)
            or lane_final.get("status") != "complete"
            or any(
                lane_final.get(key) is not True
                for key in (
                    "selection_parity", "complete_call_projection_parity",
                    "exact_cap_binding",
                )
            )
            or not isinstance(acquisition, dict)
            or acquisition.get("status") != "complete"
            or type(acquisition.get("downloaded_bytes")) is not int
            or acquisition.get("downloaded_bytes") != 0
            or type(acquisition.get("maximum_download_bytes")) is not int
            or acquisition.get("maximum_download_bytes") != 0
        ):
            raise ValueError(f"{lane_id}: canonical RUNNOTE lacks complete zero-download finalization")
    elif completed_lane != raw_lane:
        raise ValueError(f"{lane_id}: RUNNOTE terminal row differs from the covered manifest")
conditional_na_lanes = manifest_counts["conditional_na_lanes"]
CORE_ORDER = [
    lane
    for lane in CORE_CANDIDATE_ORDER
    if lane not in RR_TERMINAL_LANE_SET and lane not in conditional_na_lanes
]
core_manifest = {
    key for key, row in manifest_lanes.items()
    if row.get("family") == "core" and row.get("disposition") == "runnable"
}
if core_manifest != set(CORE_ORDER) or len(CORE_ORDER) not in {9, 10}:
    raise ValueError(
        "Gate 5 does not contain the exact scheduled core inventory: "
        f"{sorted(core_manifest)}"
    )
if not set(CORE_CANDIDATE_ORDER) <= set(note_lanes):
    raise ValueError("RUNNOTE omits one or more core lanes")

spec_payloads: list[tuple[Path, bytes]] = []
for index, lane in enumerate(CORE_ORDER, 1):
    raw = manifest_lanes[lane]
    completed = note_lanes[lane]
    for field in ("family", "disposition", "base_argv", "acquisition_mode", "cuda_visible_devices", "preliminary", "canary", "approved_caps"):
        if completed.get(field) != raw.get(field):
            raise ValueError(f"{lane}: RUNNOTE/manifest {field} differs")
    if raw.get("acquisition_mode") != "required_zero_download" or raw.get("cuda_visible_devices") != "0,1":
        raise ValueError(f"{lane}: core vLLM lane lacks sealed zero-download GPU0/GPU1 execution")
    if raw.get("final_preflight") != {"status": "pending_execution", "value": None}:
        raise ValueError(f"{lane}: covered manifest no longer retains pending final-preflight state")
    final = completed.get("final_preflight")
    if not isinstance(final, dict) or any(final.get(key) is not True for key in ("selection_parity", "complete_call_projection_parity", "exact_cap_binding")) or final.get("status") != "complete":
        raise ValueError(f"{lane}: Gate 5 final preflight is not strictly complete")
    execution = completed.get("execution")
    if (
        not isinstance(execution, dict)
        or execution.get("final_preflight") != final
        or not isinstance(execution.get("acquisition"), dict)
        or execution["acquisition"].get("status") != "complete"
        or type(execution["acquisition"].get("downloaded_bytes")) is not int
        or execution["acquisition"].get("downloaded_bytes") != 0
        or type(execution["acquisition"].get("maximum_download_bytes")) is not int
        or execution["acquisition"].get("maximum_download_bytes") != 0
    ):
        raise ValueError(f"{lane}: Gate 5 execution lacks exact zero-download finalization")
    expected_completed = {**raw, "execution": execution, "final_preflight": final}
    if completed != expected_completed:
        raise ValueError(f"{lane}: RUNNOTE row is not the exact finalized covered-manifest row")

    contract = lane_contract(lane)
    spec, repo_id, revision = TARGETS[contract["target_key"]]
    argv = raw.get("base_argv")
    if not isinstance(argv, list) or not argv or any(not isinstance(item, str) or not item for item in argv):
        raise ValueError(f"{lane}: base argv is invalid")
    if any(token.split("=", 1)[0] in OWNED for token in argv):
        raise ValueError(f"{lane}: base argv contains a controller-owned flag")
    parser = build_parser()
    try:
        parsed = parser.parse_args([
            *argv,
            "--max-total-target-calls", "1",
            "--max-total-judge-calls", "0",
            "--max-total-http-attempts", "0",
            "--deadline-seconds", str(deadline),
            "--out", "/phase6/parser-only",
            "--preflight-only",
        ])
    except SystemExit as exc:
        raise ValueError(f"{lane}: base argv is rejected by the deployed parser") from exc
    if parsed.api or parsed.api_config or parsed.ack_hosted_judge_data_transfer:
        raise ValueError(f"{lane}: hosted route flags are forbidden")
    expected_values = {
        "local": spec,
        "attackers": contract["attacker"],
        "judges": contract["judges"],
        "corpora": contract["corpora"],
        "limit": 100,
        "sample_seed": 0,
        "seeds": "0",
        "max_queries": contract["max_queries"],
        "max_turns": contract["max_turns"],
        "group": GROUP,
        "approximate_common_metrics": contract["approximate"],
        "defense": contract["defense"],
        "defense_guard": contract["defense_guard"],
        "quantization": "",
        "dtype": "auto",
        "dry_run": False,
        "judge_model": "mock",
    }
    for field, expected in expected_values.items():
        if getattr(parsed, field) != expected:
            raise ValueError(f"{lane}: {field} differs from the Phase 6 contract")
    if parsed.project_revision_sha256 != os.environ["URA_PROJECT_REVISION_SHA256"] or Path(parsed.project_revision).resolve(strict=True) != Path(os.environ["URA_PROJECT_REVISION_MANIFEST"]).resolve(strict=True):
        raise ValueError(f"{lane}: project-revision binding differs from the current rig receipt")
    if parsed.source_conformance_sha256 != os.environ["URA_SOURCE_CONFORMANCE_SHA256"] or Path(parsed.source_conformance).resolve(strict=True) != Path(os.environ["URA_SOURCE_CONFORMANCE_MANIFEST"]).resolve(strict=True):
        raise ValueError(f"{lane}: source-conformance binding differs from the current rig receipt")
    source_config = Path(parsed.source_config).resolve(strict=True)
    if source_config != (Path.cwd() / "experiments/source-instances.json").resolve(strict=True) or digest(source_config) != parsed.source_config_sha256:
        raise ValueError(f"{lane}: source-config binding is stale")
    local_config = Path(parsed.local_config).resolve(strict=True)
    if local_config.is_symlink() or digest(local_config) != parsed.local_config_sha256:
        raise ValueError(f"{lane}: local-config binding is stale")
    local_value = strict_json_file(local_config)
    if set(local_value) != {spec} or not isinstance(local_value[spec], dict):
        raise ValueError(f"{lane}: local config does not select exactly one target")
    identity = local_value[spec]
    if not type_strict_equal(identity, TARGET_CONFIGS[contract["target_key"]]):
        raise ValueError(f"{lane}: local target immutable identity/configuration differs")
    if contract["judges"] == "rules,guardrail":
        if parsed.guardrail_model != GUARD or parsed.guardrail_revision != GUARD_REV or parsed.guardrail_device != "cuda:1":
            raise ValueError(f"{lane}: selected scoring guard is not exact Llama Guard on GPU1")
    elif (
        parsed.guardrail_model != GUARD
        or parsed.guardrail_revision
        or parsed.guardrail_device
    ):
        raise ValueError(f"{lane}: classification lane unexpectedly configures a guard")
    if contract["defense"] == "both":
        if (
            parsed.defense_guardrail_model != DEFENSE_GUARD
            or parsed.defense_guardrail_revision != DEFENSE_GUARD_REV
            or parsed.defense_guardrail_device != "cuda:1"
        ):
            raise ValueError(f"{lane}: selected defense Guard is not exact 1B on GPU1")
    elif any((
        parsed.defense_guardrail_model,
        parsed.defense_guardrail_revision,
        parsed.defense_guardrail_device,
    )):
        raise ValueError(f"{lane}: non-defense lane configures a defense Guard")

    prelim_desc = raw["preliminary"]["projection_artifact"]
    prelim_path, prelim_payload = descriptor_bytes(
        prelim_desc, f"{lane} preliminary projection"
    )
    prelim_projection, prelim_loaded_desc = projection_from_bytes(
        prelim_path, prelim_payload, prelim_desc["sha256"],
        f"{lane} preliminary projection",
    )
    if prelim_loaded_desc["bytes"] != prelim_desc["bytes"]:
        raise ValueError(f"{lane}: preliminary projection size differs")
    calls = prelim_projection["call_projection"]
    caps = raw.get("approved_caps")
    if (
        not isinstance(caps, dict) or caps.get("status") != "approved"
        or caps.get("target_calls") != calls["target_calls"]
        or caps.get("model_judge_calls") != calls["judge_calls"]
        or calls["judge_calls"] != 0
        or caps.get("http_attempts") != calls["http_attempts"]
        or calls["http_attempts"] != 0
        or caps.get("call_start_deadline_seconds") != deadline
        or caps.get("measured_lane_wall_time_seconds") != lane_wall_time
        or caps.get("retained_output_policy_bytes") != storage_limit
    ):
        raise ValueError(f"{lane}: approved caps are not the exact Gate 5 projection")
    if isinstance(calls["target_calls"], bool) or not isinstance(calls["target_calls"], int) or calls["target_calls"] <= 0:
        raise ValueError(f"{lane}: target call cap is not positive")

    final_projection_path, final_projection_raw = descriptor_bytes(
        final["projection_artifact"], f"{lane} final projection"
    )
    final_projection, _ = projection_from_bytes(
        final_projection_path, final_projection_raw,
        final["projection_artifact"]["sha256"], f"{lane} final projection",
    )
    final_eligibility_path, final_eligibility_raw = descriptor_bytes(
        final["eligibility_artifact"], f"{lane} final eligibility"
    )
    eligibility = validate_eligibility_plan(strict_json_loads(final_eligibility_raw))
    eligibility_descriptor = {
        "file": final_eligibility_path.name,
        "sha256": hashlib.sha256(final_eligibility_raw).hexdigest(),
        "bytes": len(final_eligibility_raw),
        "records": sum(
            1
            for line in final_eligibility_raw.decode("utf-8").splitlines()
            if line.strip()
        ),
    }
    validate_lane_projection_binding(final_projection, eligibility_plan=eligibility, eligibility_artifact=eligibility_descriptor)
    if eligibility["execution"]["request_status"] != "whole_request_compatible" or eligibility["execution"]["units_blocked"] != 0:
        raise ValueError(f"{lane}: final eligibility is not wholly executable")
    if final_projection["selection"] != prelim_projection["selection"] or final_projection["call_projection"] != prelim_projection["call_projection"]:
        raise ValueError(f"{lane}: final/preliminary projection content differs")
    final_envelope_path, final_envelope_raw = descriptor_bytes(
        final["request_envelope_artifact"], f"{lane} final request envelope"
    )
    final_envelope, final_envelope_desc = envelope_from_bytes(
        final_envelope_path, final_envelope_raw, f"{lane} final request envelope"
    )
    if (
        final_envelope_desc["sha256"]
        != final["request_envelope_artifact"]["sha256"]
        or eligibility.get("bindings", {}).get("request_envelope_sha256")
        != final_envelope_desc["sha256"]
    ):
        raise ValueError(f"{lane}: final request-envelope digest differs")
    request = final_envelope["request"]
    if request["execution_purpose"] != "preflight_only" or request["dry_run"] is not False:
        raise ValueError(f"{lane}: final Gate 5 envelope is not preflight purpose")
    if request["call_caps"] != {"target": calls["target_calls"], "judge": None, "http_attempts": None, "deadline_seconds": deadline}:
        raise ValueError(f"{lane}: final Gate 5 envelope has non-exact caps")

    payload = {
        "schema": "ura-phase6-core-lane-spec/1",
        "order": index,
        "lane_id": lane,
        "base_argv": argv,
        "target": {"spec": spec, "repo_id": repo_id, "revision": revision},
        "local_config": identity,
        "modality": contract["modality"],
        "classification": contract["judges"] == "rules",
        "defense": contract["defense"],
        "defense_guard": contract["defense_guard"],
        "approximate_common_metrics": contract["approximate"],
        "expected_judges": contract["judges"].split(","),
        "expected_attacker": contract["attacker"],
        "expected_corpora": contract["corpora"].split(","),
        "approved_caps": {
            "target_calls": calls["target_calls"],
            "model_judge_calls": caps["model_judge_calls"],
            "http_attempts": caps["http_attempts"],
            "deadline_seconds": deadline,
            "wall_time_seconds": lane_wall_time,
        },
        "storage": {
            "free_space_floor_bytes": free_floor,
            "retained_output_policy_bytes": storage_limit,
        },
        "gate5": {
            "manifest_sha256": manifest_sha,
            "preliminary_projection": prelim_desc,
            "final_projection": final["projection_artifact"],
            "final_eligibility": final["eligibility_artifact"],
            "final_request_envelope": final["request_envelope_artifact"],
        },
    }
    material = (json.dumps(payload, sort_keys=True, separators=(",", ":"), ensure_ascii=False, allow_nan=False) + "\n").encode()
    spec_payloads.append((spec_root / f"{index:02d}-{lane}.json", material))

if not spec_root.exists():
    os.mkdir(spec_root, 0o700)
elif spec_root.is_symlink() or not spec_root.is_dir():
    raise ValueError("lane-spec root is unsafe")
for path, material in spec_payloads:
    if path.exists():
        if path.is_symlink() or not path.is_file() or path.read_bytes() != material:
            raise ValueError(f"sealed lane spec changed: {path}")
    else:
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(fd, "wb") as handle:
            handle.write(material)
            handle.flush()
            os.fsync(handle.fileno())
expected_spec_paths = {path.resolve() for path, _ in spec_payloads}
observed_spec_paths = {
    path.resolve()
    for path in spec_root.glob("*.json")
    if path.is_file() and not path.is_symlink()
}
if (
    observed_spec_paths != expected_spec_paths
    or any(path.is_symlink() for path in spec_root.glob("*.json"))
):
    raise ValueError("sealed lane-spec directory differs from the Gate 5 schedule")
print(json.dumps({
    "status": "complete",
    "core_lanes": len(spec_payloads),
    "conditional_na_lanes": conditional_na_lanes,
    "manifest_sha256": manifest_sha,
}, sort_keys=True))
PY
sealed_core_count="$(find "$LANE_SPECS" -maxdepth 1 -type f -name '*.json' -print | wc -l)"
event controller gate5-revalidation complete \
  "$sealed_core_count exact Gate-5-scheduled core lanes sealed"

json_fields() {
  "$PY" - "$1" "$2" <<'PY'
import json
import sys

path, kind = sys.argv[1:]
for line in reversed(open(path, encoding="utf-8").read().splitlines()):
    try:
        row = json.loads(line)
    except json.JSONDecodeError:
        continue
    if kind == "plan" and {"plan_id", "plan_sha256"} <= row.keys():
        print(row["plan_id"], row["plan_sha256"])
        raise SystemExit(0)
    if kind == "receipt" and {"receipt_id", "receipt_sha256", "downloaded_bytes"} <= row.keys():
        print(row["receipt_id"], row["receipt_sha256"], row["downloaded_bytes"])
        raise SystemExit(0)
raise SystemExit(f"no {kind} result JSON in {path}")
PY
}

spec_values() {
  "$PY" - "$1" <<'PY'
import json
import sys
value = json.load(open(sys.argv[1], encoding="utf-8"))
for item in (
    value["lane_id"], value["target"]["spec"], value["target"]["repo_id"],
    value["target"]["revision"], value["modality"],
    value["defense"],
    str(value["approved_caps"]["target_calls"]),
    str(value["approved_caps"]["model_judge_calls"]),
    str(value["approved_caps"]["http_attempts"]),
    str(value["approved_caps"]["deadline_seconds"]),
    str(value["approved_caps"]["wall_time_seconds"]),
    str(value["storage"]["free_space_floor_bytes"]),
    str(value["storage"]["retained_output_policy_bytes"]),
):
    print(item, end="\0")
PY
}

spec_base_argv() {
  "$PY" - "$1" <<'PY'
import json
import sys
for item in json.load(open(sys.argv[1], encoding="utf-8"))["base_argv"]:
    print(item, end="\0")
PY
}

arg_value() {
  local wanted="$1"
  shift
  "$PY" - "$wanted" "$@" <<'PY'
import sys
wanted = sys.argv[1]
argv = sys.argv[2:]
values = []
index = 0
while index < len(argv):
    token = argv[index]
    if token == wanted:
        if index + 1 >= len(argv):
            raise SystemExit(f"{wanted} lacks a value")
        values.append(argv[index + 1])
        index += 2
        continue
    if token.startswith(wanted + "="):
        values.append(token.split("=", 1)[1])
    index += 1
if len(values) != 1:
    raise SystemExit(f"expected one {wanted}, found {len(values)}")
print(values[0])
PY
}

plan_acquire() {
  local label="$1" plan_root="$2" receipts_root="$3"
  shift 3
  local plan_log="$1" acquire_log="$2"
  shift 2
  local plan_id plan_sha receipt_id receipt_sha downloaded
  test ! -e "$plan_root"
  mkdir -m 700 "$plan_root"
  mkdir -p "$receipts_root" "$URA_MODEL_STORE/.transport-cache"
  chmod 700 "$receipts_root"
  run_owned "$PY" -m experiments.run_matrix "$@" \
    --model-acquisition-plan-only --model-acquisition-plan-dir "$plan_root" \
    > "$plan_log" 2>&1
  read -r plan_id plan_sha < <(json_fields "$plan_log" plan)
  PLAN_PATH="$plan_root/${plan_id}.plan.json"
  PLAN_SHA="$plan_sha"
  test -f "$PLAN_PATH" && test ! -L "$PLAN_PATH"
  test "$(sha256sum -- "$PLAN_PATH" | awk '{print $1}')" = "$PLAN_SHA"
  run_owned "$PY" -m experiments.model_acquire \
    --plan "$PLAN_PATH" --plan-sha256 "$PLAN_SHA" \
    --store "$URA_MODEL_STORE" --receipts-dir "$receipts_root" \
    --transport-cache "$URA_MODEL_STORE/.transport-cache" \
    --max-download-bytes 0 --min-free-bytes "$FREE_FLOOR" \
    --deadline-seconds 86400 > "$acquire_log" 2>&1
  read -r receipt_id receipt_sha downloaded < <(json_fields "$acquire_log" receipt)
  test "$downloaded" = '0'
  RECEIPT_PATH="$receipts_root/${receipt_id}.receipt.json"
  RECEIPT_SHA="$receipt_sha"
  test -f "$RECEIPT_PATH" && test ! -L "$RECEIPT_PATH"
  test "$(sha256sum -- "$RECEIPT_PATH" | awk '{print $1}')" = "$RECEIPT_SHA"
}

validate_acquisition() {
  local plan="$1" plan_sha="$2" receipt="$3" receipt_sha="$4" role_mode="$5"
  "$PY" - "$plan" "$plan_sha" "$receipt" "$receipt_sha" \
    "$TARGET_REPO" "$TARGET_REV" "$role_mode" <<'PY'
import sys
from ura.model_acquisition import load_plan, load_receipt

plan = load_plan(sys.argv[1], expected_sha256=sys.argv[2])
receipt = load_receipt(sys.argv[3], expected_sha256=sys.argv[4], plan=plan)
target_repo, target_rev, role_mode = sys.argv[5:]
expected = {(target_repo, target_rev): ["vllm_target"]}
if role_mode == "target_and_guard":
    expected[("meta-llama/Llama-Guard-3-8B", "7327bd9f6efbbe6101dc6cc4736302b3cbb6e425")] = ["guardrail_judge"]
elif role_mode == "target_score_and_defense":
    expected[("meta-llama/Llama-Guard-3-8B", "7327bd9f6efbbe6101dc6cc4736302b3cbb6e425")] = ["guardrail_judge"]
    expected[("meta-llama/Llama-Guard-3-1B", "acf7aafa60f0410f8f42b1fa35e077d705892029")] = ["defense_guardrail"]
observed = {(row["repo_id"], row["revision"]): row["roles"] for row in plan["resources"]}
if observed != expected:
    raise SystemExit(f"acquisition resources differ: {observed!r}")
if receipt["plan_id"] != plan["plan_id"]:
    raise SystemExit("acquisition receipt does not bind the exact plan")
PY
}

write_exact_state() {
  local path="$1" spec_path="$2" result_root="$3" probe_root="$4" attestation="$5" attestation_sha="$6"
  local probe_plan="$7" probe_plan_sha="$8" probe_receipt="$9" probe_receipt_sha="${10}" probe_log="${11}"
  local measured_plan="${12}" measured_plan_sha="${13}" measured_receipt="${14}" measured_receipt_sha="${15}" measured_log="${16}"
  shift 16
  "$PY" - "$path" "$spec_path" "$result_root" "$probe_root" \
    "$attestation" "$attestation_sha" \
    "$probe_plan" "$probe_plan_sha" "$probe_receipt" "$probe_receipt_sha" "$probe_log" \
    "$measured_plan" "$measured_plan_sha" "$measured_receipt" "$measured_receipt_sha" "$measured_log" \
    "$@" <<'PY'
import hashlib
import json
import os
from pathlib import Path
import re
import sys

out = Path(sys.argv[1])
spec_path = Path(sys.argv[2])

def artifact(path_value: str) -> dict[str, object]:
    path = Path(path_value)
    payload = path.read_bytes()
    return {"path": str(path), "sha256": hashlib.sha256(payload).hexdigest(), "bytes": len(payload)}

state = {
    "schema": "ura-phase6-core-measured-argv/1",
    "lane_spec": {"path": str(spec_path), "sha256": hashlib.sha256(spec_path.read_bytes()).hexdigest(), "bytes": spec_path.stat().st_size},
    "result_root": sys.argv[3],
    "probe_root": sys.argv[4],
    "live_attestation": {"path": sys.argv[5], "sha256": sys.argv[6]},
    "attestation_acquisition": {
        "plan": {"path": sys.argv[7], "sha256": sys.argv[8]},
        "receipt": {"path": sys.argv[9], "sha256": sys.argv[10]},
        "controller_log": artifact(sys.argv[11]),
        "store": os.environ["URA_MODEL_STORE"],
        "downloaded_bytes": 0,
    },
    "model_acquisition": {
        "plan": {"path": sys.argv[12], "sha256": sys.argv[13]},
        "receipt": {"path": sys.argv[14], "sha256": sys.argv[15]},
        "controller_log": artifact(sys.argv[16]),
        "store": os.environ["URA_MODEL_STORE"],
        "downloaded_bytes": 0,
    },
    "runner_argv": sys.argv[17:],
    "resume_semantics": "invoke_exact_runner_argv_or_accept_strictly_revalidated_complete_runner_grid",
}
material = (json.dumps(state, sort_keys=True, separators=(",", ":"), allow_nan=False) + "\n").encode()
temporary = out.with_name(f".{out.name}.tmp-{os.getpid()}")
fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
try:
    with os.fdopen(fd, "wb", closefd=True) as handle:
        fd = -1
        handle.write(material)
        handle.flush()
        os.fsync(handle.fileno())
    os.link(temporary, out)
    os.unlink(temporary)
    directory_fd = os.open(out.parent, os.O_RDONLY)
    try:
        os.fsync(directory_fd)
    finally:
        os.close(directory_fd)
finally:
    if fd >= 0:
        os.close(fd)
    temporary.unlink(missing_ok=True)
PY
}

load_exact_state() {
  local path="$1" spec_path="$2"
  "$PY" - "$path" "$spec_path" <<'PY'
import hashlib
import os
from pathlib import Path
import stat
import sys
from ura.model_acquisition import load_plan, load_receipt
from ura.live_attestation import load_live_attestation_file
from ura.request_envelope import load_request_envelope_file
from ura.strict_json import strict_json_loads

state_path, spec_path = map(Path, sys.argv[1:])
if state_path.is_symlink() or not state_path.is_file():
    raise SystemExit("exact measured state is absent or unsafe")
state_stat = state_path.stat()
if stat.S_IMODE(state_stat.st_mode) != 0o600 or state_stat.st_nlink != 1:
    raise SystemExit("exact measured state permissions/link count changed")
state = strict_json_loads(state_path.read_bytes())
spec = strict_json_loads(spec_path.read_bytes())
if not isinstance(state, dict) or state.get("schema") != "ura-phase6-core-measured-argv/1":
    raise SystemExit("exact measured state schema is invalid")
if set(state) != {
    "schema", "lane_spec", "result_root", "probe_root", "live_attestation",
    "attestation_acquisition", "model_acquisition", "runner_argv", "resume_semantics",
}:
    raise SystemExit("exact measured state fields changed")
descriptor = state.get("lane_spec")
if descriptor != {"path": str(spec_path), "sha256": hashlib.sha256(spec_path.read_bytes()).hexdigest(), "bytes": spec_path.stat().st_size}:
    raise SystemExit("exact measured state binds a different lane spec")
att = state["live_attestation"]
if not isinstance(att, dict) or set(att) != {"path", "sha256"}:
    raise SystemExit("stored live-attestation descriptor is invalid")
attestation_manifest, _ = load_live_attestation_file(att["path"], att["sha256"])
measured_resources = {
    (spec["target"]["repo_id"], spec["target"]["revision"]): ["vllm_target"]
}
if not spec["classification"]:
    measured_resources[(
        "meta-llama/Llama-Guard-3-8B",
        "7327bd9f6efbbe6101dc6cc4736302b3cbb6e425",
    )] = ["guardrail_judge"]
if spec.get("defense") == "both":
    measured_resources[(
        "meta-llama/Llama-Guard-3-1B",
        "acf7aafa60f0410f8f42b1fa35e077d705892029",
    )] = ["defense_guardrail"]

def validate_stored_acquisition(value, *, label, expected_resources):
    preparation_root = (state_path.parent / "preparations").resolve(strict=True)
    if (
        not isinstance(value, dict)
        or set(value) != {
            "plan", "receipt", "controller_log", "store", "downloaded_bytes",
        }
        or value.get("store") != os.environ["URA_MODEL_STORE"]
        or type(value.get("downloaded_bytes")) is not int
        or value.get("downloaded_bytes") != 0
    ):
        raise SystemExit(f"stored {label} acquisition descriptor is invalid")
    for artifact_label in ("plan", "receipt"):
        artifact_value = value.get(artifact_label)
        if not isinstance(artifact_value, dict) or set(artifact_value) != {"path", "sha256"}:
            raise SystemExit(f"stored {label} acquisition {artifact_label} descriptor is invalid")
        artifact_path = Path(artifact_value["path"])
        if (
            artifact_path.is_symlink()
            or not artifact_path.is_file()
            or artifact_path.resolve(strict=True) != artifact_path
            or not artifact_path.is_relative_to(preparation_root)
        ):
            raise SystemExit(f"stored {label} acquisition {artifact_label} is not canonical")
    log_value = value.get("controller_log")
    if not isinstance(log_value, dict) or set(log_value) != {"path", "sha256", "bytes"}:
        raise SystemExit(f"stored {label} acquisition log descriptor is invalid")
    log_path = Path(str(log_value.get("path", "")))
    if (
        log_path.is_symlink()
        or not log_path.is_file()
        or log_path.resolve(strict=True) != log_path
        or not log_path.is_relative_to(preparation_root)
    ):
        raise SystemExit(f"stored {label} acquisition log is not canonical")
    log_payload = log_path.read_bytes()
    if (
        len(log_payload) != log_value.get("bytes")
        or hashlib.sha256(log_payload).hexdigest() != log_value.get("sha256")
    ):
        raise SystemExit(f"stored {label} acquisition log bytes changed")
    plan_value = load_plan(value["plan"]["path"], expected_sha256=value["plan"]["sha256"])
    receipt_value = load_receipt(
        value["receipt"]["path"], expected_sha256=value["receipt"]["sha256"], plan=plan_value
    )
    observed_resources = {
        (row["repo_id"], row["revision"]): row["roles"]
        for row in plan_value["resources"]
    }
    if observed_resources != expected_resources or receipt_value["plan_id"] != plan_value["plan_id"]:
        raise SystemExit(f"stored {label} acquisition resources differ from the lane identity")
    result_rows = []
    for raw_line in log_payload.splitlines():
        try:
            row = strict_json_loads(raw_line)
        except (TypeError, ValueError):
            continue
        if isinstance(row, dict) and set(row) == {
            "downloaded_bytes", "receipt_id", "receipt_sha256",
        }:
            result_rows.append(row)
    if (
        len(result_rows) != 1
        or type(result_rows[0].get("downloaded_bytes")) is not int
        or result_rows[0].get("downloaded_bytes") != 0
        or result_rows[0].get("receipt_id") != receipt_value["receipt_id"]
        or result_rows[0].get("receipt_sha256") != value["receipt"]["sha256"]
    ):
        raise SystemExit(f"stored {label} acquisition log does not prove exact zero download")
    return plan_value, receipt_value

probe_plan, probe_receipt = validate_stored_acquisition(
    state["attestation_acquisition"],
    label="attestation",
    expected_resources={
        (spec["target"]["repo_id"], spec["target"]["revision"]): ["vllm_target"]
    },
)
acq = state["model_acquisition"]
plan, receipt = validate_stored_acquisition(
    acq, label="measured", expected_resources=measured_resources
)
probe_log_parent = Path(state["attestation_acquisition"]["controller_log"]["path"]).parent
measured_log_parent = Path(state["model_acquisition"]["controller_log"]["path"]).parent
expected_probe_root = (
    Path(os.environ["URA_WORK"]) / "runs" / "thesis" / "attestation"
    / f"phase6-core-{probe_log_parent.name}" / spec["lane_id"] / "probe"
)
if (
    probe_log_parent != measured_log_parent
    or state.get("probe_root") != str(expected_probe_root)
    or expected_probe_root.is_symlink()
    or not expected_probe_root.is_dir()
    or expected_probe_root.resolve(strict=True) != expected_probe_root
):
    raise SystemExit("stored preparation acquisition/probe lineage changed")
probe_envelopes = sorted(expected_probe_root.glob("request-envelope-*.request-envelope.json"))
if len(probe_envelopes) != 1 or probe_envelopes[0].is_symlink():
    raise SystemExit("stored attestation probe lacks one safe request envelope")
probe_envelope, probe_envelope_descriptor = load_request_envelope_file(probe_envelopes[0])
probe_request = probe_envelope["request"]
expected_probe_limit = 2 if spec["modality"] == "image" else 1
if (
    probe_plan.get("bindings", {}).get("request_envelope_sha256")
    != probe_envelope_descriptor["sha256"]
    or probe_request.get("execution_purpose") != "attestation_probe"
    or probe_request.get("requested_target_keys") != [spec["target"]["spec"]]
    or probe_request.get("logical_source_arms") != ["synth"]
    or probe_request.get("selected_attackers") != ["replay"]
    or probe_request.get("judges") != ["rules"]
    or probe_request.get("limit") != expected_probe_limit
    or probe_request.get("seeds") != [0]
    or probe_request.get("sample_seed") != 0
    or probe_request.get("max_queries") != 1
    or probe_request.get("max_turns") != 1
    or probe_request.get("defense") != "none"
    or probe_request.get("defense_guard") != "rules"
    or probe_request.get("group_keys")
    != "model,source,risk,effective_modality,expected_behavior,attacker,source_policy_id,source_policy_version"
    or probe_request.get("quantization") != ""
    or probe_request.get("dtype") != "auto"
    or probe_request.get("dry_run") is not False
    or probe_request.get("approximate_common_metrics") is not False
    or probe_request.get("call_caps") != {
        "target": expected_probe_limit,
        "judge": None,
        "http_attempts": None,
        "deadline_seconds": spec["approved_caps"]["deadline_seconds"],
    }
):
    raise SystemExit("stored attestation acquisition is not bound to the exact probe request")
del probe_receipt
expected_result_root = str(
    Path(os.environ["URA_WORK"]) / "runs" / "thesis" / "runner" / spec["lane_id"]
)
if state.get("result_root") != expected_result_root:
    raise SystemExit("stored Runner output/store locator differs from the campaign binding")
result_root = Path(expected_result_root)
if result_root.is_symlink() or not result_root.is_dir() or result_root.resolve(strict=True) != result_root:
    raise SystemExit("stored Runner result root is not one canonical directory")
envelope_paths = sorted(result_root.glob("request-envelope-*.request-envelope.json"))
if len(envelope_paths) != 1 or envelope_paths[0].is_symlink():
    raise SystemExit("stored measured plan lacks one safe measured request envelope")
measured_envelope, measured_envelope_desc = load_request_envelope_file(envelope_paths[0])
if plan.get("bindings", {}).get("request_envelope_sha256") != measured_envelope_desc["sha256"]:
    raise SystemExit("stored acquisition plan is not bound to the measured request envelope")
gate5_desc = spec["gate5"]["final_request_envelope"]
gate5_envelope, loaded_gate5_desc = load_request_envelope_file(gate5_desc["path"])
if (
    loaded_gate5_desc["sha256"] != gate5_desc["sha256"]
    or loaded_gate5_desc["bytes"] != gate5_desc["bytes"]
):
    raise SystemExit("stored Gate 5 request-envelope descriptor changed")
measured_request = measured_envelope["request"]
gate5_request = gate5_envelope["request"]
if (
    measured_request.get("execution_purpose") != "measured_run"
    or measured_request.get("dry_run") is not False
    or {key: value for key, value in measured_request.items() if key != "execution_purpose"}
    != {key: value for key, value in gate5_request.items() if key != "execution_purpose"}
    or measured_envelope.get("bindings") != gate5_envelope.get("bindings")
):
    raise SystemExit("stored measured request is not the exact Gate 5 semantic envelope")
attestation_path = Path(att["path"])
expected_attestation_parent = Path(os.environ["URA_WORK"]) / "runs" / "thesis" / "attestation"
if (
    attestation_path.is_symlink()
    or not attestation_path.is_file()
    or attestation_path.resolve(strict=True) != attestation_path
    or not attestation_path.resolve(strict=True).is_relative_to(expected_attestation_parent.resolve(strict=True))
    or attestation_path != expected_probe_root.parent / f"{spec['lane_id']}.live-attestation.json"
):
    raise SystemExit("stored live attestation is outside the thesis attestation tree")
argv = state.get("runner_argv")
if not isinstance(argv, list) or not argv or any(not isinstance(item, str) or not item for item in argv):
    raise SystemExit("stored Runner argv is invalid")
base = spec["base_argv"]
if argv[:len(base)] != base:
    raise SystemExit("stored Runner argv does not retain the exact Gate 5 base argv")
scope = os.environ.get("URA_EXECUTION_SCOPE_ID", "")
attestation_records = [
    row for row in attestation_manifest["records"]
    if row["requested_target_spec"] == spec["target"]["spec"]
    and row["execution_scope_id"] == scope
]
expected_modalities = (
    {("text",)}
    if spec["modality"] == "text"
    else {("text",), ("text", "image")}
)
if {
    tuple(row["exact_input_modalities"]) for row in attestation_records
} != expected_modalities:
    raise SystemExit("stored live attestation lacks the exact target/modality records")
for row in attestation_records:
    identity = row["realized_target_identity"]
    if (
        row["route_kind"] != "local_runtime"
        or identity.get("provider") != "vllm"
        or identity.get("model_revision") != spec["target"]["revision"]
    ):
        raise SystemExit("stored live attestation has a different realized target identity")
expected_tail = [
    "--execution-scope-id", scope,
    "--live-attestation-max-age-hours", "24",
    "--live-attestation", att["path"],
    "--live-attestation-sha256", att["sha256"],
    "--max-total-target-calls", str(spec["approved_caps"]["target_calls"]),
    "--max-total-judge-calls", str(spec["approved_caps"]["model_judge_calls"]),
    "--max-total-http-attempts", str(spec["approved_caps"]["http_attempts"]),
    "--deadline-seconds", str(spec["approved_caps"]["deadline_seconds"]),
    "--out", state["result_root"],
    "--model-acquisition-plan", acq["plan"]["path"],
    "--model-acquisition-plan-sha256", acq["plan"]["sha256"],
    "--model-acquisition-receipt", acq["receipt"]["path"],
    "--model-acquisition-receipt-sha256", acq["receipt"]["sha256"],
    "--model-acquisition-store", acq["store"],
]
if not scope or argv[len(base):] != expected_tail:
    raise SystemExit("stored Runner argv tail differs from the exact measured contract")
for forbidden in ("--preflight-only", "--diagnostic-canary", "--attestation-probe", "--dry-run", "--model-acquisition-plan-only"):
    if forbidden in argv:
        raise SystemExit(f"stored measured argv contains {forbidden}")
for item in argv:
    print(item, end="\0")
PY
}

validate_completed_lane() {
  local spec_path="$1" state_path="$2" validation_prefix="$3"
  set -Eeuo pipefail
  active_child_pid=''
  trap 'abort_signal 130' INT
  trap 'abort_signal 143' TERM
  trap 'abort_signal 129' HUP
  local -a state_argv=()
  while IFS= read -r -d '' item; do state_argv+=("$item"); done < <(load_exact_state "$state_path" "$spec_path")
  local result_root attestation attestation_sha eligibility
  result_root="$(arg_value --out "${state_argv[@]}")"
  attestation="$(arg_value --live-attestation "${state_argv[@]}")"
  attestation_sha="$(arg_value --live-attestation-sha256 "${state_argv[@]}")"
  mapfile -t eligibility_files < <(find "$result_root" -maxdepth 1 -type f -name 'eligibility-*.eligibility.json' -print | sort)
  test "${#eligibility_files[@]}" -eq 1
  eligibility="${eligibility_files[0]}"
  test ! -e "${validation_prefix}.level1.json" && test ! -L "${validation_prefix}.level1.json"
  test ! -e "${validation_prefix}.level1.csv" && test ! -L "${validation_prefix}.level1.csv"
  run_owned "$PY" -m experiments.level1_evidence \
    --eligibility "$eligibility" --results "$result_root" \
    --live-attestation "$attestation" --live-attestation-sha256 "$attestation_sha" \
    --out-json "${validation_prefix}.level1.json" \
    --out-csv "${validation_prefix}.level1.csv" \
    > "${validation_prefix}.level1.log" 2>&1
  "$PY" - "$spec_path" "$state_path" "${validation_prefix}.level1.json" <<'PY'
from __future__ import annotations

import hashlib
import json
from pathlib import Path
import shutil
import sys

from ura.eligibility import validate_eligibility_plan
from ura.lane_projection import load_lane_projection_file, validate_lane_projection_binding
from ura.request_envelope import load_request_envelope_file
from ura.runner import GlobalCallBudget
from ura.strict_json import strict_json_loads

spec_path, state_path, level1_path = map(Path, sys.argv[1:])
spec = strict_json_loads(spec_path.read_bytes())
state = strict_json_loads(state_path.read_bytes())
result_root = Path(state["result_root"])

def one(pattern: str) -> Path:
    paths = sorted(result_root.glob(pattern))
    if len(paths) != 1 or paths[0].is_symlink() or not paths[0].is_file():
        raise SystemExit(f"expected one safe {pattern}, found {len(paths)}")
    return paths[0]

eligibility_path = one("eligibility-*.eligibility.json")
projection_path = one("lane-projection-*.lane-projection.json")
envelope_path = one("request-envelope-*.request-envelope.json")
grid_path = one("*.grid.json")
budget_path = one("*.budget.json")
if list(result_root.glob("*.grid.lock")) or list(result_root.glob("*.cell.lock")):
    raise SystemExit("Runner lane remains locked")
if (
    list(result_root.glob("*.error.json"))
    or list(result_root.glob("request-error-*.request-error.json"))
    or list(result_root.glob("*.lock.error.json"))
    or list(result_root.glob("*.checkpoint.jsonl"))
    or list(result_root.glob("*.responses.checkpoint.jsonl"))
):
    raise SystemExit("complete Runner lane retains error artifacts")

eligibility_raw = eligibility_path.read_bytes()
eligibility = validate_eligibility_plan(strict_json_loads(eligibility_raw))
if eligibility["execution"]["request_status"] != "whole_request_compatible" or eligibility["execution"]["units_blocked"] != 0 or eligibility["execution"]["whole_request_preflight_complete"] is not True:
    raise SystemExit("measured eligibility is not wholly executable")
projection, _ = load_lane_projection_file(projection_path, hashlib.sha256(projection_path.read_bytes()).hexdigest())
validate_lane_projection_binding(
    projection,
    eligibility_plan=eligibility,
    eligibility_artifact={
        "file": eligibility_path.name,
        "sha256": hashlib.sha256(eligibility_raw).hexdigest(),
        "bytes": len(eligibility_raw),
        "records": sum(
            1
            for line in eligibility_raw.decode("utf-8").splitlines()
            if line.strip()
        ),
    },
)

gate5_projection_desc = spec["gate5"]["preliminary_projection"]
gate5_projection, _ = load_lane_projection_file(gate5_projection_desc["path"], gate5_projection_desc["sha256"])
if projection["selection"] != gate5_projection["selection"] or projection["call_projection"] != gate5_projection["call_projection"]:
    raise SystemExit("measured projection differs from Gate 5")

envelope, _ = load_request_envelope_file(envelope_path)
gate5_envelope_desc = spec["gate5"]["final_request_envelope"]
gate5_envelope, _ = load_request_envelope_file(gate5_envelope_desc["path"])
request = envelope["request"]
gate5_request = gate5_envelope["request"]
if request["execution_purpose"] != "measured_run" or request["dry_run"] is not False:
    raise SystemExit("Runner envelope is not measured purpose")
if {key: value for key, value in request.items() if key != "execution_purpose"} != {key: value for key, value in gate5_request.items() if key != "execution_purpose"}:
    raise SystemExit("measured request semantics differ from exact Gate 5 preflight")
caps = spec["approved_caps"]
if request["call_caps"] != {
    "target": caps["target_calls"],
    "judge": caps["model_judge_calls"] or None,
    "http_attempts": caps["http_attempts"] or None,
    "deadline_seconds": caps["deadline_seconds"],
}:
    raise SystemExit("measured request does not retain exact approved caps")
if request["approximate_common_metrics"] is not spec["approximate_common_metrics"]:
    raise SystemExit("measured approximate-metrics selection differs")

grid = strict_json_loads(grid_path.read_bytes())
if not isinstance(grid, dict) or grid.get("status") != "complete" or grid.get("n_errors") != 0:
    raise SystemExit("Runner grid is not complete")
cells = grid.get("cells")
if (
    isinstance(grid.get("requested_cells"), bool)
    or not isinstance(grid.get("requested_cells"), int)
    or grid["requested_cells"] <= 0
    or grid.get("accounted_cells") != grid["requested_cells"]
    or grid.get("n_new_complete", 0) + grid.get("n_existing_complete", 0)
    != grid["requested_cells"]
    or not isinstance(cells, list)
    or len(cells) != grid["requested_cells"]
    or any(not isinstance(row, dict) or row.get("status") not in {"complete", "complete_existing"} for row in cells)
):
    raise SystemExit("Runner grid cell accounting is incomplete")
grid_request = grid.get("request")
if not isinstance(grid_request, dict) or grid_request.get("execution_purpose") != "measured_run":
    raise SystemExit("grid request is not measured")
expected_runtime = f"{spec['target']['spec']}@{spec['target']['revision']}"
if spec["defense"] != "none":
    expected_runtime += "+guard"
if grid_request.get("models") != [expected_runtime]:
    raise SystemExit("grid does not contain the exact requested target")
if grid_request.get("corpora") != spec["expected_corpora"] or grid_request.get("attackers") != [spec["expected_attacker"]] or grid_request.get("judges") != spec["expected_judges"]:
    raise SystemExit("grid axes differ from the lane spec")
expected_grid_values = {
    "seeds": [0], "sample_seed": 0, "limit": 100,
    "max_queries": request["max_queries"], "max_turns": request["max_turns"],
    "group_keys": request["group_keys"], "defense": spec["defense"],
    "defense_guard": spec["defense_guard"], "quantization": "", "dtype": "auto",
    "dry_run": False, "attestation_probe": False, "judge_model": None,
}
for field, expected in expected_grid_values.items():
    observed = grid_request.get(field)
    if type(observed) is not type(expected) or observed != expected:
        raise SystemExit(f"grid request {field} differs from the sealed request")
local_configs = grid_request.get("local_configs")
if (
    not isinstance(local_configs, dict)
    or set(local_configs) != {expected_runtime}
    or not isinstance(local_configs[expected_runtime], dict)
):
    raise SystemExit("grid local-target configuration inventory changed")
observed_local = local_configs[expected_runtime]
for field, expected in spec["local_config"].items():
    observed = observed_local.get(field)
    if type(observed) is not type(expected) or observed != expected:
        raise SystemExit(f"grid local-target configuration {field} changed")
if set(observed_local) != set(spec["local_config"]) | {
    "parameter_count_b", "multi_gpu_compatible", "multi_gpu_support_basis",
    "quantization",
}:
    raise SystemExit("grid local-target configuration enrichment changed")
if grid_request.get("call_projection") != projection["call_projection"]:
    raise SystemExit("grid/projection call accounting differs")
if grid_request.get("approximate_common_metrics") is not spec["approximate_common_metrics"]:
    raise SystemExit("grid approximate-metrics state differs")
if spec["classification"]:
    if grid_request.get("judges") != ["rules"] or grid_request.get("guardrail_model") is not None:
        raise SystemExit("classification lane did not retain rules-only source-parser semantics")
    compatible_items = [
        row for row in eligibility["items"]
        if row["status"] == "compatible_if_isolated"
    ]
    if not compatible_items or any(
        row.get("metric_mode") != "source_specific_evaluator"
        or row.get("source_evaluator_implemented") is not True
        for row in compatible_items
    ):
        raise SystemExit("classification eligibility does not bind an implemented source evaluator")
else:
    if (
        grid_request.get("guardrail_model") != "meta-llama/Llama-Guard-3-8B"
        or grid_request.get("guardrail_revision") != "7327bd9f6efbbe6101dc6cc4736302b3cbb6e425"
        or grid_request.get("guardrail_device") != "cuda:1"
    ):
        raise SystemExit("common/adaptive lane did not retain the exact GPU1 scoring guard")
if spec["defense"] == "both":
    if (
        grid_request.get("defense_guard") != "guardrail"
        or grid_request.get("defense_guardrail_model")
        != "meta-llama/Llama-Guard-3-1B"
        or grid_request.get("defense_guardrail_revision")
        != "acf7aafa60f0410f8f42b1fa35e077d705892029"
        or grid_request.get("defense_guardrail_device") != "cuda:1"
    ):
        raise SystemExit("defense lane did not retain the exact GPU1 1B defense Guard")
elif any(
    grid_request.get(field) is not None
    for field in (
        "defense_guardrail_model",
        "defense_guardrail_revision",
        "defense_guardrail_device",
    )
):
    raise SystemExit("non-defense lane unexpectedly retained a defense Guard")

trail_rows = []
for trail_path in sorted(result_root.glob("*.trails.jsonl")):
    for line in trail_path.read_bytes().splitlines():
        if line.strip():
            row = strict_json_loads(line)
            if not isinstance(row, dict):
                raise SystemExit("judgment trail contains a non-object row")
            trail_rows.append(row)
if not trail_rows:
    raise SystemExit("complete measured lane has no retained judgment trail")
if spec["classification"]:
    if any(
        row.get("stage") != 0
        or row.get("judge") != "rules"
        or row.get("cascade_role") != "authoritative"
        or row.get("cascade_policy")
        != "first_confident_with_full_shadow_trail"
        or row.get("stage_queried") is not False
        or row.get("policy_evaluation_status") != "source_metric_only"
        or not isinstance(row.get("required_metric"), str)
        or not row["required_metric"]
        for row in trail_rows
    ):
        raise SystemExit("classification trail queried a common judge or lost source-parser authority")
else:
    groups = {}
    for row in trail_rows:
        key = (row.get("run_id"), row.get("attempt_id"))
        if not all(isinstance(item, str) and item for item in key):
            raise SystemExit("common/adaptive judgment trail lacks exact run/attempt identity")
        groups.setdefault(key, []).append(row)
    queried_groups = 0
    for key, rows in groups.items():
        ordered = sorted(rows, key=lambda row: row.get("stage", -1))
        if (
            len(ordered) != 2
            or [(row.get("stage"), row.get("judge")) for row in ordered]
            != [(0, "rules"), (1, "guardrail")]
            or any(
                row.get("cascade_policy")
                != "first_confident_with_full_shadow_trail"
                for row in ordered
            )
            or sorted(row.get("cascade_role") for row in ordered)
            != ["authoritative", "shadow"]
        ):
            raise SystemExit(f"common/adaptive cascade shape changed for {key!r}")
        queried = {row.get("stage_queried") for row in ordered}
        if queried == {False}:
            if any(
                row.get("policy_evaluation_status") != "not_evaluable"
                or row.get("label") != "not_applicable"
                for row in ordered
            ):
                raise SystemExit(f"unqueried setup trail changed for {key!r}")
            continue
        if queried != {True}:
            raise SystemExit(f"partially queried judge cascade for {key!r}")
        for row in ordered:
            status = row.get("policy_evaluation_status")
            if status not in {"evaluated", "approximate_common_security_proxy"}:
                raise SystemExit(f"queried common-security policy status changed for {key!r}")
            if status == "approximate_common_security_proxy" and (
                row.get("metric_authority") != "supplementary_non_authoritative"
                or not isinstance(row.get("required_metric"), str)
                or not row["required_metric"]
            ):
                raise SystemExit(f"approximate common-security provenance changed for {key!r}")
        queried_groups += 1
        guard = ordered[1]
        if (
            guard.get("guardrail_queried") is not True
            or guard.get("judge_model") != "meta-llama/Llama-Guard-3-8B"
            or guard.get("judge_model_revision")
            != "7327bd9f6efbbe6101dc6cc4736302b3cbb6e425"
            or guard.get("judge_model_identity")
            != "meta-llama/Llama-Guard-3-8B@7327bd9f6efbbe6101dc6cc4736302b3cbb6e425"
        ):
            raise SystemExit("selected scoring guard was not queried under its exact identity")
    if queried_groups <= 0:
        raise SystemExit("common/adaptive lane contains no queried scoring cascade")

if spec["defense"] == "both":
    response_paths = sorted(result_root.glob("*.responses.jsonl"))
    if not response_paths:
        raise SystemExit("defense measured lane retained no response streams")
    response_count = 0
    two_stage_count = 0
    exact_audit_fields = {
        "schema", "stage", "judge", "label", "model", "model_revision",
        "model_identity", "device", "guardrail_queried", "parsed",
    }
    for response_path in response_paths:
        for line in response_path.read_bytes().splitlines():
            if not line.strip():
                continue
            response = strict_json_loads(line)
            raw = response.get("raw") if isinstance(response, dict) else None
            audit = raw.get("defense_judge_audit") if isinstance(raw, dict) else None
            if not isinstance(audit, list) or len(audit) not in {1, 2}:
                raise SystemExit("defense response lacks one or two exact audit stages")
            expected_stages = ["input"] if len(audit) == 1 else ["input", "output"]
            if [item.get("stage") for item in audit if isinstance(item, dict)] != expected_stages:
                raise SystemExit("defense response audit stage order changed")
            for item in audit:
                if (
                    not isinstance(item, dict)
                    or set(item) != exact_audit_fields
                    or item.get("schema") != "ura-defense-judge-audit/1"
                    or item.get("judge") != "guardrail"
                    or item.get("label") not in {"safe", "violation"}
                    or item.get("model") != "meta-llama/Llama-Guard-3-1B"
                    or item.get("model_revision")
                    != "acf7aafa60f0410f8f42b1fa35e077d705892029"
                    or item.get("model_identity")
                    != "meta-llama/Llama-Guard-3-1B@acf7aafa60f0410f8f42b1fa35e077d705892029"
                    or item.get("device") != "cuda:1"
                    or item.get("guardrail_queried") is not True
                    or item.get("parsed") is not True
                ):
                    raise SystemExit("defense response exact 1B identity/query facts changed")
            if len(audit) == 1:
                if (
                    audit[0].get("label") != "violation"
                    or raw.get("defense") != "blocked"
                    or raw.get("stage") != "input"
                    or raw.get("base_target_queried") is not False
                    or raw.get("defense_stages_evaluated") != ["input"]
                ):
                    raise SystemExit("single-stage defense response is not an exact input block")
            else:
                if (
                    audit[0].get("label") != "safe"
                    or raw.get("base_target_queried") is not True
                    or raw.get("defense_stages_evaluated") != ["input", "output"]
                ):
                    raise SystemExit("two-stage defense response execution facts changed")
                two_stage_count += 1
            response_count += 1
    if response_count <= 0 or two_stage_count <= 0:
        raise SystemExit("defense measured lane lacks a queried target/output-defense observation")

ledger = strict_json_loads(budget_path.read_bytes())
if not isinstance(ledger, dict) or ledger.get("budget_id") != grid.get("grid_id"):
    raise SystemExit("durable call ledger does not bind the grid")
budget = GlobalCallBudget(
    max_target_calls=caps["target_calls"],
    max_judge_calls=caps["model_judge_calls"] or None,
    max_http_attempts=caps["http_attempts"] or None,
    deadline_epoch=ledger.get("deadline_epoch"),
    state_path=budget_path,
    budget_id=grid["grid_id"],
)
snapshot = budget.snapshot()
if snapshot != ledger or grid.get("call_budget_snapshot") != snapshot:
    raise SystemExit("grid/final durable call ledger snapshot mismatch")
if (
    snapshot["target_calls"] <= 0
    or snapshot["target_calls"] > caps["target_calls"]
    or (
        spec["expected_attacker"] == "replay"
        and snapshot["target_calls"] != caps["target_calls"]
    )
    or snapshot["judge_calls"] != caps["model_judge_calls"]
    or snapshot["http_attempts"] != caps["http_attempts"]
):
    raise SystemExit("observed call ledger differs from the bounded local call contract")
if (
    projection["call_projection"]["target_calls"] != caps["target_calls"]
    or projection["call_projection"]["judge_calls"] != caps["model_judge_calls"]
    or projection["call_projection"]["http_attempts"] != caps["http_attempts"]
):
    raise SystemExit("projection/cap accounting differs")

markers = {row.get("completion_marker") for row in cells}
if None in markers or len(markers) != grid["requested_cells"]:
    raise SystemExit("grid completion-marker inventory is incomplete")
for name in markers:
    marker_name = Path(str(name))
    marker = result_root / marker_name
    if (
        marker_name.is_absolute()
        or marker_name.name != str(name)
        or marker.is_symlink()
        or not marker.is_file()
        or marker.resolve(strict=True).parent != result_root.resolve(strict=True)
    ):
        raise SystemExit("grid references an absent or unsafe completion marker")

level1 = strict_json_loads(level1_path.read_bytes())
if (
    not isinstance(level1, dict)
    or level1.get("schema_version") != "ura-level1-evidence/3"
    or level1.get("status") != "validated_unit_qualified_lifecycle_inventory"
    or level1.get("scope", {}).get("evidence_kind") != "measured_run"
    or level1.get("scope", {}).get("contains_diagnostic_dry_run") is not False
    or level1.get("availability", {}).get("live_attestation", {}).get("status") != "validated"
):
    raise SystemExit("Level 1 did not retain measured, live-attested evidence")
planning_counts = level1.get("counts", {}).get("planning_strata", {})
execution_counts = level1.get("counts", {}).get("execution_units", {})
if (
    planning_counts.get("requested") != planning_counts.get("completed")
    or planning_counts.get("missing") != 0
    or execution_counts.get("requested") != execution_counts.get("completed")
    or execution_counts.get("missing") != 0
    or execution_counts.get("error") != 0
):
    raise SystemExit("Level 1 measured completion accounting is incomplete")

retained = sum(path.stat().st_size for path in result_root.rglob("*") if path.is_file() and not path.is_symlink())
if retained > spec["storage"]["retained_output_policy_bytes"]:
    raise SystemExit("retained lane output exceeds the Gate 5 external storage policy")
if shutil.disk_usage(result_root).free < spec["storage"]["free_space_floor_bytes"]:
    raise SystemExit("resolved Runner filesystem is below the Gate 5 free-space floor")

print(json.dumps({
    "status": "complete",
    "lane_id": spec["lane_id"],
    "grid_id": grid["grid_id"],
    "projection_id": projection["projection_id"],
    "eligibility_plan_id": eligibility["plan_id"],
    "target_calls_reserved": snapshot["target_calls"],
    "target_call_cap": caps["target_calls"],
    "retained_bytes": retained,
}, sort_keys=True, separators=(",", ":")))
PY
}

runner_declares_complete() {
  local state_path="$1"
  "$PY" - "$state_path" <<'PY'
from pathlib import Path
import sys
from ura.strict_json import strict_json_loads

state_path = Path(sys.argv[1])
if state_path.is_symlink() or not state_path.is_file():
    raise SystemExit(1)
state = strict_json_loads(state_path.read_bytes())
if not isinstance(state, dict):
    raise SystemExit(1)
root = Path(state.get("result_root", ""))
if root.is_symlink() or not root.is_dir():
    raise SystemExit(1)
grids = sorted(root.glob("*.grid.json"))
if len(grids) != 1 or grids[0].is_symlink() or list(root.glob("*.grid.lock")) or list(root.glob("*.cell.lock")):
    raise SystemExit(1)
grid = strict_json_loads(grids[0].read_bytes())
if not isinstance(grid, dict) or grid.get("status") != "complete" or grid.get("n_errors") != 0:
    raise SystemExit(1)
PY
}

assert_no_runner_execution() {
  local root="$1"
  "$PY" - "$root" <<'PY'
from pathlib import Path
import sys

root = Path(sys.argv[1])
if root.is_symlink():
    raise SystemExit("unsealed result root is unsafe")
if not root.exists():
    raise SystemExit(0)
if not root.is_dir():
    raise SystemExit("unsealed result root is unsafe")
executed_patterns = (
    "*.grid.json", "*.budget.json", "*.circuits.json", "*.grid.lock",
    "*.cell.lock", "*.complete.json", "*.checkpoint.jsonl",
    "*.responses.checkpoint.jsonl", "*.attempts.jsonl", "*.responses.jsonl",
    "*.trails.jsonl", "*.results.jsonl", "*.manifest.json", "*.error.json",
    "request-error-*.request-error.json",
)
for pattern in executed_patterns:
    if list(root.glob(pattern)):
        raise SystemExit(
            "result root has Runner lifecycle artifacts but no sealed exact argv"
        )
PY
}

mapfile -t SPEC_FILES < <(find "$LANE_SPECS" -maxdepth 1 -type f -name '*.json' -print | sort)
test "${#SPEC_FILES[@]}" -eq 9 || test "${#SPEC_FILES[@]}" -eq 10

run_lane_body() {
  local spec_path="$1"
  set -Eeuo pipefail
  active_child_pid=''
  trap 'abort_signal 130' INT
  trap 'abort_signal 143' TERM
  trap 'abort_signal 129' HUP
  mapfile -d '' -t values < <(spec_values "$spec_path")
  test "${#values[@]}" -eq 13
  LANE="${values[0]}"
  TARGET_SPEC="${values[1]}"
  TARGET_REPO="${values[2]}"
  TARGET_REV="${values[3]}"
  MODALITY="${values[4]}"
  DEFENSE_MODE="${values[5]}"
  TARGET_CAP="${values[6]}"
  JUDGE_CAP="${values[7]}"
  HTTP_CAP="${values[8]}"
  DEADLINE="${values[9]}"
  WALL_TIME="${values[10]}"
  FREE_FLOOR="${values[11]}"
  STORAGE_LIMIT="${values[12]}"
  current_lane="$LANE"
  current_stage='environment-recheck'
  assert_environment
  if (( $(df --output=avail -B1 "$URA_WORK" | tail -n 1) < FREE_FLOOR )); then
    printf '%s\n' "$LANE: resolved filesystem is below the Gate 5 free-space floor" >&2
    exit 1
  fi

  lane_control="$CONTROL_ROOT/lanes/$LANE"
  state_path="$lane_control/exact-measured-argv.json"
  result_root="$URA_WORK/runs/thesis/runner/$LANE"
  validation_prefix="$ATTEMPT_ROOT/$LANE"
  if [[ -e "$lane_control" || -L "$lane_control" ]]; then
    test -d "$lane_control" && test ! -L "$lane_control"
    test "$(readlink -e -- "$lane_control")" = "$lane_control"
  else
    mkdir "$lane_control"
  fi
  chmod 700 "$lane_control"

  if [[ -e "$state_path" || -L "$state_path" ]]; then
    current_stage='resume-state-revalidation'
    event "$LANE" resume-state start
    if runner_declares_complete "$state_path"; then
      set +e
      run_owned validate_completed_lane "$spec_path" "$state_path" \
        "${validation_prefix}.adoption-check"
      adoption_rc=$?
      set -e
      if (( adoption_rc == 0 )); then
        event "$LANE" measured complete-existing \
          'strict Runner artifacts accepted; no invocation made'
        return 0
      fi
      event "$LANE" resume-state retry \
        'complete-looking Runner state failed strict adoption; exact sealed argv will be retried'
    fi
    mapfile -d '' -t measured_argv < <(load_exact_state "$state_path" "$spec_path")
    test "${#measured_argv[@]}" -gt 0
    current_stage='runner-resume'
    event "$LANE" runner-resume start 'same sealed argv; Runner checkpoints only'
    external_measured_run "$LANE" runner-resume "$result_root" \
      "$ATTEMPT_ROOT/$LANE.runner-resume.log" "${measured_argv[@]}"
  else
    assert_no_runner_execution "$result_root"
    mapfile -d '' -t base_argv < <(spec_base_argv "$spec_path")
    test "${#base_argv[@]}" -gt 0
    SCOPE="$URA_EXECUTION_SCOPE_ID"
    MAX_AGE='24'
    prep_parent="$lane_control/preparations"
    if [[ -e "$prep_parent" || -L "$prep_parent" ]]; then
      test -d "$prep_parent" && test ! -L "$prep_parent"
      test "$(readlink -e -- "$prep_parent")" = "$prep_parent"
    else
      mkdir "$prep_parent"
    fi
    chmod 700 "$prep_parent"
    prep_control="$prep_parent/$ATTEMPT_TAG"
    test ! -e "$prep_control" && test ! -L "$prep_control"
    mkdir "$prep_control"
    chmod 700 "$prep_control"
    receipts_root="$prep_control/receipts"
    current_stage='fresh-live-attestation'
    probe_root="$URA_WORK/runs/thesis/attestation/phase6-core-$ATTEMPT_TAG/$LANE/probe"
    attestation_path="$URA_WORK/runs/thesis/attestation/phase6-core-$ATTEMPT_TAG/$LANE/$LANE.live-attestation.json"
    test ! -e "${probe_root%/probe}" && test ! -L "${probe_root%/probe}"
    mkdir -p "${probe_root%/probe}"
    test -d "${probe_root%/probe}" && test ! -L "${probe_root%/probe}"
    test "$(readlink -e -- "${probe_root%/probe}")" = "${probe_root%/probe}"
    chmod 700 "${probe_root%/probe}"
    local_config="$(arg_value --local-config "${base_argv[@]}")"
    local_config_sha="$(arg_value --local-config-sha256 "${base_argv[@]}")"
    project_receipt="$(arg_value --project-revision "${base_argv[@]}")"
    project_sha="$(arg_value --project-revision-sha256 "${base_argv[@]}")"
    if [[ "$MODALITY" == 'image' ]]; then probe_limit='2'; else probe_limit='1'; fi
    probe_args=(
      --attestation-probe
      --execution-scope-id "$SCOPE"
      --project-revision "$project_receipt"
      --project-revision-sha256 "$project_sha"
      --local "$TARGET_SPEC"
      --local-config "$local_config"
      --local-config-sha256 "$local_config_sha"
      --attackers replay
      --judges rules
      --corpora synth
      --limit "$probe_limit"
      --sample-seed 0
      --seeds 0
      --max-queries 1
      --max-turns 1
      --group 'model,source,risk,effective_modality,expected_behavior,attacker,source_policy_id,source_policy_version'
      --max-total-target-calls "$probe_limit"
      --max-total-judge-calls 0
      --max-total-http-attempts 0
      --deadline-seconds "$DEADLINE"
      --out "$probe_root"
    )
    probe_plan_root="$prep_control/probe-plan"
    plan_acquire "$LANE-probe" "$probe_plan_root" "$receipts_root" \
      "$prep_control/probe.plan.log" "$prep_control/probe.acquire.log" \
      "${probe_args[@]}"
    PROBE_PLAN_PATH="$PLAN_PATH"; PROBE_PLAN_SHA="$PLAN_SHA"
    PROBE_RECEIPT_PATH="$RECEIPT_PATH"; PROBE_RECEIPT_SHA="$RECEIPT_SHA"
    validate_acquisition "$PROBE_PLAN_PATH" "$PROBE_PLAN_SHA" \
      "$PROBE_RECEIPT_PATH" "$PROBE_RECEIPT_SHA" target_only
    probe_acq=(
      --model-acquisition-plan "$PROBE_PLAN_PATH"
      --model-acquisition-plan-sha256 "$PROBE_PLAN_SHA"
      --model-acquisition-receipt "$PROBE_RECEIPT_PATH"
      --model-acquisition-receipt-sha256 "$PROBE_RECEIPT_SHA"
      --model-acquisition-store "$URA_MODEL_STORE"
    )
    event "$LANE" attestation-probe start "$MODALITY"
    run_owned env CUDA_VISIBLE_DEVICES=0,1 "$PY" -m experiments.run_matrix \
      "${probe_args[@]}" "${probe_acq[@]}" > "$prep_control/probe.run.log" 2>&1
    test ! -e "$attestation_path" && test ! -L "$attestation_path"
    run_owned "$PY" -m experiments.live_attestation \
      --probe-root "$probe_root" --execution-scope-id "$SCOPE" \
      --out "$attestation_path" > "$prep_control/probe.attestation.log" 2>&1
    attestation_sha="$(sha256sum -- "$attestation_path" | awk '{print $1}')"
    run_owned "$PY" -m experiments.live_attestation --validate "$attestation_path" \
      --sha256 "$attestation_sha" >> "$prep_control/probe.attestation.log" 2>&1
    "$PY" - "$attestation_path" "$attestation_sha" "$TARGET_SPEC" \
      "$TARGET_REV" "$SCOPE" "$MODALITY" <<'PY'
import sys
from ura.live_attestation import load_live_attestation_file

manifest, _ = load_live_attestation_file(sys.argv[1], sys.argv[2])
target, revision, scope, modality = sys.argv[3:]
records = [row for row in manifest["records"] if row["requested_target_spec"] == target and row["execution_scope_id"] == scope]
expected = {("text",)} if modality == "text" else {("text",), ("text", "image")}
observed = {tuple(row["exact_input_modalities"]) for row in records}
if observed != expected:
    raise SystemExit(f"fresh attestation modality inventory differs: {observed!r}")
for row in records:
    identity = row["realized_target_identity"]
    if row["route_kind"] != "local_runtime" or identity.get("provider") != "vllm" or identity.get("model_revision") != revision:
        raise SystemExit("fresh attestation realized target identity differs")
PY
    event "$LANE" attestation-probe complete "$attestation_sha"

    measured_common=(
      "${base_argv[@]}"
      --execution-scope-id "$SCOPE"
      --live-attestation-max-age-hours "$MAX_AGE"
      --live-attestation "$attestation_path"
      --live-attestation-sha256 "$attestation_sha"
      --max-total-target-calls "$TARGET_CAP"
      --max-total-judge-calls "$JUDGE_CAP"
      --max-total-http-attempts "$HTTP_CAP"
      --deadline-seconds "$DEADLINE"
      --out "$result_root"
    )
    current_stage='measured-plan-acquire'
    event "$LANE" measured-plan start 'exact fresh attestation is already bound'
    measured_plan_root="$prep_control/measured-plan"
    plan_acquire "$LANE-measured" "$measured_plan_root" "$receipts_root" \
      "$prep_control/measured.plan.log" "$prep_control/measured.acquire.log" \
      "${measured_common[@]}"
    MEASURED_PLAN_PATH="$PLAN_PATH"; MEASURED_PLAN_SHA="$PLAN_SHA"
    MEASURED_RECEIPT_PATH="$RECEIPT_PATH"; MEASURED_RECEIPT_SHA="$RECEIPT_SHA"
    if [[ "$DEFENSE_MODE" == 'both' ]]; then
      acquisition_roles='target_score_and_defense'
    elif [[ "$(arg_value --judges "${base_argv[@]}")" == 'rules,guardrail' ]]; then
      acquisition_roles='target_and_guard'
    else
      acquisition_roles='target_only'
    fi
    validate_acquisition "$MEASURED_PLAN_PATH" "$MEASURED_PLAN_SHA" \
      "$MEASURED_RECEIPT_PATH" "$MEASURED_RECEIPT_SHA" "$acquisition_roles"
    event "$LANE" measured-plan complete 'zero downloaded bytes; exact measured purpose'

    measured_argv=(
      "${measured_common[@]}"
      --model-acquisition-plan "$MEASURED_PLAN_PATH"
      --model-acquisition-plan-sha256 "$MEASURED_PLAN_SHA"
      --model-acquisition-receipt "$MEASURED_RECEIPT_PATH"
      --model-acquisition-receipt-sha256 "$MEASURED_RECEIPT_SHA"
      --model-acquisition-store "$URA_MODEL_STORE"
    )
    write_exact_state "$state_path" "$spec_path" "$result_root" "$probe_root" \
      "$attestation_path" "$attestation_sha" \
      "$PROBE_PLAN_PATH" "$PROBE_PLAN_SHA" \
      "$PROBE_RECEIPT_PATH" "$PROBE_RECEIPT_SHA" "$prep_control/probe.acquire.log" \
      "$MEASURED_PLAN_PATH" "$MEASURED_PLAN_SHA" \
      "$MEASURED_RECEIPT_PATH" "$MEASURED_RECEIPT_SHA" "$prep_control/measured.acquire.log" \
      "${measured_argv[@]}"
    load_exact_state "$state_path" "$spec_path" > /dev/null
    current_stage='measured-run'
    event "$LANE" measured start "$TARGET_CAP target-call cap"
    external_measured_run "$LANE" measured-run "$result_root" \
      "$prep_control/measured.run.log" "${measured_argv[@]}"
  fi

  current_stage='measured-revalidation'
  validate_completed_lane "$spec_path" "$state_path" "$validation_prefix"
  event "$LANE" measured complete 'grid, projection, eligibility, ledger, completion, and identities revalidated'
}

write_lane_failure() {
  local lane="$1" spec_path="$2" state_path="$3" result_root="$4" rc="$5" stage="$6"
  local failure_path="$ATTEMPT_ROOT/$lane.failure.json"
  test ! -e "$failure_path" && test ! -L "$failure_path"
  "$PY" - "$failure_path" "$lane" "$ATTEMPT_TAG" "$spec_path" \
    "$state_path" "$result_root" "$rc" "$stage" \
    "$EXPECTED_COMMIT" "$EXPECTED_FRAMEWORK_LOCK" <<'PY'
from __future__ import annotations

from datetime import datetime, timezone
import hashlib
import json
import os
from pathlib import Path
import sys

(
    out_value, lane, attempt, spec_value, state_value, result_value, rc_value,
    stage, expected_commit, expected_lock,
) = sys.argv[1:11]
out = Path(out_value)

def descriptor(path: Path) -> dict[str, object]:
    if path.is_symlink() or not path.is_file() or path.resolve(strict=True) != path:
        raise SystemExit(f"unsafe Phase 6 core failure input: {path}")
    payload = path.read_bytes()
    if not payload:
        raise SystemExit(f"empty Phase 6 core failure input: {path}")
    return {
        "path": str(path),
        "sha256": hashlib.sha256(payload).hexdigest(),
        "bytes": len(payload),
    }

spec = Path(spec_value)
state = Path(state_value)
result_root = Path(result_value)
if not result_root.is_absolute() or result_root.name != lane:
    raise SystemExit("Phase 6 core failure result root differs")
if result_root.is_symlink():
    raise SystemExit("Phase 6 core failure result root is a symlink")
runner_parent = (
    Path(os.environ["URA_WORK"]).resolve(strict=True)
    / "runs" / "thesis" / "runner"
)
if runner_parent.is_symlink() or not runner_parent.is_dir():
    raise SystemExit("Phase 6 core Runner parent is unsafe")
expected_result_root = runner_parent / lane
if result_root != expected_result_root:
    raise SystemExit("Phase 6 core failure result root escaped the Runner inventory")
if not result_root.exists():
    os.mkdir(result_root, 0o700)
if result_root.is_symlink() or not result_root.is_dir():
    raise SystemExit("Phase 6 core failure result root is unsafe")
canonical_result_root = result_root.resolve(strict=True)
if canonical_result_root != expected_result_root:
    raise SystemExit("Phase 6 core failure result root escaped the Runner inventory")
returncode = int(rc_value)
if returncode <= 0 or returncode > 255:
    raise SystemExit("Phase 6 core lane failure return code differs")
state_descriptor = None
if state.exists() or state.is_symlink():
    state_descriptor = descriptor(state)
spec_descriptor = descriptor(spec)
spec_value = json.loads(spec.read_text(encoding="utf-8"))
wall_time = spec_value.get("approved_caps", {}).get("wall_time_seconds")
gate5_sha = spec_value.get("gate5", {}).get("manifest_sha256")
if (
    isinstance(wall_time, bool)
    or not isinstance(wall_time, int)
    or wall_time != 86_400
    or not isinstance(gate5_sha, str)
    or len(gate5_sha) != 64
):
    raise SystemExit("Phase 6 core failure spec lacks the approved wall-time binding")
timed_out = stage == "approved-wall-time-ceiling"
reason_code = (
    "approved_wall_time_exceeded"
    if timed_out
    else "lane_controller_nonzero_exit"
)
error_type = "lane_wall_time_exceeded" if timed_out else "lane_controller_nonzero_exit"
error = (
    f"lane exceeded approved {wall_time}-second wall-time ceiling; "
    "no measured evidence admitted"
    if timed_out
    else f"lane controller exited {returncode}; no measured evidence admitted"
)
critical_patterns = (
    "*.grid.json", "*.request-envelope.json", "*.eligibility.json", "*.error.json",
)
critical_artifacts = sorted({
    path.resolve(strict=True)
    for pattern in critical_patterns
    for path in result_root.rglob(pattern)
    if path.is_file() and not path.is_symlink()
})
pre_runner_descriptor = None
failed_at = datetime.now(timezone.utc).isoformat().replace("+00:00", "Z")
if not critical_artifacts:
    marker = result_root / f".ura-phase6-pre-runner-failure-{attempt}.json"
    marker_value = {
        "schema": "ura-phase6-pre-runner-failure/1",
        "status": "failed",
        "artifact_role": "controller_pre_runner_failure_not_runner_artifact",
        "lane_id": lane,
        "attempt": attempt,
        "failed_at_utc": failed_at,
        "stage": stage,
        "reason_code": reason_code,
        "error_type": error_type,
        "error": error,
        "expected_commit": expected_commit,
        "framework_lock_id": expected_lock,
        "gate5_manifest_sha256": gate5_sha,
        "lane_spec": spec_descriptor,
        "exact_measured_argv": state_descriptor,
        "result_root": str(canonical_result_root),
        "approved_wall_time_seconds": wall_time,
        "runner_lifecycle_artifact_count": 0,
        "runner_artifact": False,
        "evidence_eligible": False,
    }
    marker_payload = (
        json.dumps(
            marker_value,
            sort_keys=True,
            separators=(",", ":"),
            allow_nan=False,
        )
        + "\n"
    ).encode("ascii")
    marker_fd = os.open(marker, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(marker_fd, "wb") as handle:
        handle.write(marker_payload)
        handle.flush()
        os.fsync(handle.fileno())
    directory_fd = os.open(result_root, os.O_RDONLY)
    try:
        os.fsync(directory_fd)
    finally:
        os.close(directory_fd)
    pre_runner_descriptor = descriptor(marker)
value = {
    "schema": "ura-phase6-core-lane-failure/1",
    "status": "failed",
    "lane_id": lane,
    "attempt": attempt,
    "failed_at_utc": failed_at,
    "returncode": returncode,
    "stage": stage,
    "reason_code": reason_code,
    "error_type": error_type,
    "error": error,
    "terminal_event": {
        "status": "failed",
        "detail": error,
    },
    "lane_spec": spec_descriptor,
    "exact_measured_argv": state_descriptor,
    "pre_runner_failure": pre_runner_descriptor,
    "result_root": str(canonical_result_root),
    "approved_wall_time_seconds": wall_time,
    "evidence_eligible": False,
    "retry_semantics": "next controller attempt revalidates complete Runner state or retries the exact sealed argv",
    "hosted_target_calls": 0,
    "hosted_judge_calls": 0,
    "provider_http_attempts": 0,
    "downloads_observed_bytes": 0,
}
payload = (
    json.dumps(value, sort_keys=True, separators=(",", ":"), allow_nan=False)
    + "\n"
).encode("ascii")
temporary = out.with_name(f".{out.name}.tmp-{os.getpid()}")
fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
try:
    with os.fdopen(fd, "wb", closefd=True) as handle:
        fd = -1
        handle.write(payload)
        handle.flush()
        os.fsync(handle.fileno())
    os.link(temporary, out)
    os.unlink(temporary)
    directory_fd = os.open(out.parent, os.O_RDONLY)
    try:
        os.fsync(directory_fd)
    finally:
        os.close(directory_fd)
finally:
    if fd >= 0:
        os.close(fd)
    temporary.unlink(missing_ok=True)
PY
}

lane_attempt_finish() {
  local lane_rc="$1" lane="$2" spec_path="$3" state_path="$4" result_root="$5"
  local failure_stage="$current_stage" failure_write_rc event_rc detail timeout_trigger timeout_value
  local -a failure_values=()
  trap - EXIT
  timeout_trigger="$ATTEMPT_ROOT/$lane.wall-time-exceeded"
  if [[ -f "$timeout_trigger" && ! -L "$timeout_trigger" ]]; then
    mapfile -d '' -t failure_values < <(spec_values "$spec_path")
    if [[ "${#failure_values[@]}" -eq 13 ]] \
      && IFS= read -r timeout_value < "$timeout_trigger" \
      && [[ "$timeout_value" == "${failure_values[10]}" ]]; then
      lane_rc=124
      failure_stage='approved-wall-time-ceiling'
    fi
  fi
  if (( lane_rc == 0 )); then
    exit 0
  fi
  set +e
  current_lane="$lane"
  current_stage='typed-lane-failure'
  write_lane_failure "$lane" "$spec_path" "$state_path" "$result_root" \
    "$lane_rc" "$failure_stage"
  failure_write_rc=$?
  if (( failure_write_rc == 0 )); then
    if [[ "$failure_stage" == 'approved-wall-time-ceiling' ]]; then
      detail="lane exceeded approved ${failure_values[10]}-second wall-time ceiling; no measured evidence admitted"
    else
      detail="lane controller exited $lane_rc; no measured evidence admitted"
    fi
    event "$lane" measured failed "$detail"
    event_rc=$?
    if (( event_rc != 0 )); then
      printf '%s\n' "$lane: typed failure was sealed but its terminal event failed" >&2
    fi
  else
    printf '%s\n' "$lane: could not atomically seal its typed failure" >&2
  fi
  exit "$lane_rc"
}

lane_attempt_worker() {
  local spec_path="$1" lane state_path result_root lane_exit_trap
  trap - EXIT
  set -Eeuo pipefail
  active_child_pid=''
  active_child_pgid=''
  trap 'abort_signal 130' INT
  trap 'abort_signal 143' TERM
  trap 'abort_signal 129' HUP
  mapfile -d '' -t attempt_values < <(spec_values "$spec_path")
  test "${#attempt_values[@]}" -eq 13
  lane="${attempt_values[0]}"
  state_path="$CONTROL_ROOT/lanes/$lane/exact-measured-argv.json"
  result_root="$URA_WORK/runs/thesis/runner/$lane"
  current_lane="$lane"
  current_stage='lane-attempt'
  printf -v lane_exit_trap \
    'lane_attempt_finish "$?" %q %q %q %q' \
    "$lane" "$spec_path" "$state_path" "$result_root"
  trap "$lane_exit_trap" EXIT
  event "$lane" lane-attempt start 'independent exact lane attempt started'
  run_lane_body "$spec_path"
}

aggregate_lane_rc=0
for spec_path in "${SPEC_FILES[@]}"; do
  mapfile -d '' -t controller_values < <(spec_values "$spec_path")
  test "${#controller_values[@]}" -eq 13
  controller_lane="${controller_values[0]}"
  controller_wall_time="${controller_values[10]}"
  # Launch outside a conditional context. Bash otherwise suppresses errexit
  # throughout a called function, even if that function runs `set -e` itself.
  # Job control gives the attempt a distinct process group so the approved
  # wall ceiling terminates and reaps the whole local subprocess tree.
  set -m
  lane_attempt_worker "$spec_path" &
  active_child_pid="$!"
  active_child_pgid="$active_child_pid"
  set +m
  set +e
  wait_lane_with_ceiling "$active_child_pid" "$controller_lane" \
    "$controller_wall_time"
  lane_rc=$?
  set -e
  active_child_pid=''
  active_child_pgid=''
  if (( lane_rc != 0 )); then
    aggregate_lane_rc=1
    controller_failure="$ATTEMPT_ROOT/$controller_lane.failure.json"
    if [[ ! -e "$controller_failure" && ! -L "$controller_failure" ]]; then
      controller_state="$CONTROL_ROOT/lanes/$controller_lane/exact-measured-argv.json"
      controller_result_root="$URA_WORK/runs/thesis/runner/$controller_lane"
      controller_failure_stage='lane-worker-exit-without-typed-failure'
      controller_failure_detail="lane controller exited $lane_rc; no measured evidence admitted"
      if (( lane_rc == 124 )) \
        && [[ -f "$ATTEMPT_ROOT/$controller_lane.wall-time-exceeded" ]] \
        && [[ ! -L "$ATTEMPT_ROOT/$controller_lane.wall-time-exceeded" ]]; then
        controller_failure_stage='approved-wall-time-ceiling'
        controller_failure_detail="lane exceeded approved ${controller_wall_time}-second wall-time ceiling; no measured evidence admitted"
      fi
      set +e
      write_lane_failure "$controller_lane" "$spec_path" "$controller_state" \
        "$controller_result_root" "$lane_rc" "$controller_failure_stage"
      controller_failure_rc=$?
      if (( controller_failure_rc == 0 )); then
        event "$controller_lane" measured failed "$controller_failure_detail"
      else
        printf '%s\n' \
          "$controller_lane: parent could not atomically seal its typed failure" >&2
      fi
      set -e
    fi
  fi
done

current_lane='controller'
current_stage='final-state-revalidation'
for spec_path in "${SPEC_FILES[@]}"; do
  mapfile -d '' -t final_values < <(spec_values "$spec_path")
  test "${#final_values[@]}" -eq 13
  final_lane="${final_values[0]}"
  final_state="$CONTROL_ROOT/lanes/$final_lane/exact-measured-argv.json"
  final_failure="$ATTEMPT_ROOT/$final_lane.failure.json"
  if [[ -e "$final_failure" || -L "$final_failure" ]]; then
    test -f "$final_failure" && test ! -L "$final_failure"
    test "$(readlink -e -- "$final_failure")" = "$final_failure"
    continue
  fi
  load_exact_state "$final_state" "$spec_path" > /dev/null
  runner_declares_complete "$final_state"
done
event controller final-state-revalidation complete \
  'all successes revalidated; typed failures retained as non-evidence'
current_stage='final-inventory'
"$PY" - "$EVENTS" "$LANE_SPECS" "$ATTEMPT_TAG" \
  "$ATTEMPT_ROOT/contract-self-test.json" <<'PY'
from __future__ import annotations

import csv
import json
import os
import pathlib
import sys

events = pathlib.Path(sys.argv[1])
spec_root = pathlib.Path(sys.argv[2])
attempt_tag = sys.argv[3]
test_path = pathlib.Path(sys.argv[4])
expected = {path.name.split("-", 1)[1].removesuffix(".json") for path in spec_root.glob("*.json")}
with events.open(encoding="utf-8", newline="") as handle:
    rows = list(csv.DictReader(handle, delimiter="\t"))

def reduce_attempt(
    source: list[dict[str, str]],
    lanes: set[str],
    *,
    expected_status: str | None = None,
) -> dict[str, str]:
    starts = [
        (index, row)
        for index, row in enumerate(source)
        if row.get("stage") == "lane-attempt" and row.get("status") == "start"
    ]
    terminals = [
        (index, row)
        for index, row in enumerate(source)
        if row.get("stage") == "measured"
        and row.get("status") in {"complete", "complete-existing", "failed"}
    ]
    if len(starts) != len(lanes) or {row.get("lane") for _, row in starts} != lanes:
        raise ValueError("missing or duplicate independent lane-attempt event")
    if len(terminals) != len(lanes) or {row.get("lane") for _, row in terminals} != lanes:
        raise ValueError("missing or duplicate terminal lane event")
    start_index = {row["lane"]: index for index, row in starts}
    terminal_index = {row["lane"]: index for index, row in terminals}
    if any(start_index[lane] >= terminal_index[lane] for lane in lanes):
        raise ValueError("terminal event precedes its independent lane attempt")
    states = {
        row["lane"]: "failed" if row["status"] == "failed" else "measured_complete"
        for _, row in terminals
    }
    if set(states.values()) - {"measured_complete", "failed"}:
        raise ValueError("mis-typed terminal state")
    aggregate = "complete_with_failures" if "failed" in states.values() else "complete"
    if expected_status is not None and aggregate != expected_status:
        raise ValueError("aggregate status differs from lane terminals")
    return states

attempt_rows = [row for row in rows if row.get("attempt") == attempt_tag]
states = reduce_attempt(attempt_rows, expected)
failed = {lane for lane, state in states.items() if state == "failed"}
failure_files = {
    path.name.removesuffix(".failure.json")
    for path in pathlib.Path(test_path).parent.glob("*.failure.json")
    if path.is_file() and not path.is_symlink()
}
if failed != failure_files:
    raise SystemExit(
        "Phase 6 core typed-failure inventory differs: "
        f"events={sorted(failed)}, files={sorted(failure_files)}"
    )

synthetic = [
    {"lane": "early", "stage": "lane-attempt", "status": "start"},
    {"lane": "early", "stage": "measured", "status": "failed"},
    {"lane": "later", "stage": "lane-attempt", "status": "start"},
    {"lane": "later", "stage": "measured", "status": "complete"},
]
if reduce_attempt(synthetic, {"early", "later"}, expected_status="complete_with_failures") != {
    "early": "failed",
    "later": "measured_complete",
}:
    raise SystemExit("early failure did not preserve the later independent attempt")
mutations = {
    "missing-terminal": synthetic[:-1],
    "duplicate-terminal": synthetic + [dict(synthetic[-1])],
    "mis-typed-state": [*synthetic[:-1], {**synthetic[-1], "status": "partial"}],
    "missing-attempt": synthetic[1:],
    "terminal-before-attempt": [synthetic[1], synthetic[0], *synthetic[2:]],
}
rejected = []
for label, mutation in mutations.items():
    try:
        reduce_attempt(mutation, {"early", "later"})
    except ValueError:
        rejected.append(label)
    else:
        raise SystemExit(f"Phase 6 core event mutation was accepted: {label}")
try:
    reduce_attempt(synthetic, {"early", "later"}, expected_status="complete")
except ValueError:
    rejected.append("status-mismatch")
else:
    raise SystemExit("Phase 6 core aggregate-status mutation was accepted")
record = {
    "schema": "ura-phase6-core-attempt-contract-self-test/1",
    "status": "passed",
    "mutations_rejected": rejected,
    "early_failure_followed_by_later_attempt": True,
    "actual_lane_terminal_states": states,
}
payload = (
    json.dumps(record, sort_keys=True, separators=(",", ":"), allow_nan=False)
    + "\n"
).encode("ascii")
fd = os.open(test_path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
with os.fdopen(fd, "wb") as handle:
    handle.write(payload)
    handle.flush()
    os.fsync(handle.fileno())
PY
event controller final-inventory complete \
  "${#SPEC_FILES[@]} scheduled core lanes terminal as strict results or typed non-evidence failures"
current_stage='completion-receipt'
run_owned "$PY" - "$COMPLETION" "$EVENTS" "$LANE_SPECS" "$CONTROL_ROOT" \
  "$ATTEMPT_ROOT" "$MANIFEST" "$RUNNOTE" "$PROMOTION" "$LAUNCH_META" \
  "$EXPECTED_COMMIT" "$EXPECTED_FRAMEWORK_LOCK" "$aggregate_lane_rc" <<'PY'
from __future__ import annotations

