#!/usr/bin/env bash
set -Eeuo pipefail

# Phase 6 controller for the runnable subset of 14 candidate core Gate 5 rows.
#
# Initial launch:
#   bash phase6_core_measured.sh \
#     --gate5-manifest /absolute/covered-manifest.json \
#     --gate5-runnote /absolute/RUNNOTE.md \
#     --gate5-promotion-receipt /absolute/RUNNOTE.gate5-promotion-....receipt.json \
#     --authorize-manifest-sha256 <64-lowercase-hex>
#
# Resume after a controller/process interruption:
#   bash phase6_core_measured.sh \
#     --resume-control-root /absolute/phase6-core-measured-...
#
# A resume never derives a replacement acquisition plan, changes a cap, or
# replaces an attestation for a lane that reached measured-argv sealing. It
# either accepts a strictly revalidated complete Runner grid, or invokes the
# same sealed Runner argv so Runner alone validates/restores its checkpoints.
# Every invocation validates all 14 core Gate 5 rows, preserves the four RR
# target-runtime terminals without target calls, and attempts exactly 10 lanes
# when defense-local is runnable or 9 when Gate 5 carries its admitted
# conditional N/A. Each scheduled lane is sealed as a strict measured result or
# an explicit non-evidence failure. Partial terminal inventory exits 1 while
# retaining a complete_with_failures receipt.

usage() {
  printf '%s\n' \
    'usage:' \
    '  phase6_core_measured.sh --gate5-manifest PATH --gate5-runnote PATH --gate5-promotion-receipt PATH --authorize-manifest-sha256 HEX' \
    '  phase6_core_measured.sh --resume-control-root PATH' >&2
  exit 2
}

GATE5_MANIFEST=''
GATE5_RUNNOTE=''
GATE5_PROMOTION=''
AUTHORIZED_SHA=''
RESUME_ROOT=''
while (( "$#" )); do
  case "$1" in
    --gate5-manifest)
      (( "$#" >= 2 )) || usage
      GATE5_MANIFEST="$2"
      shift 2
      ;;
    --gate5-runnote)
      (( "$#" >= 2 )) || usage
      GATE5_RUNNOTE="$2"
      shift 2
      ;;
    --gate5-promotion-receipt)
      (( "$#" >= 2 )) || usage
      GATE5_PROMOTION="$2"
      shift 2
      ;;
    --authorize-manifest-sha256)
      (( "$#" >= 2 )) || usage
      AUTHORIZED_SHA="$2"
      shift 2
      ;;
    --resume-control-root)
      (( "$#" >= 2 )) || usage
      RESUME_ROOT="$2"
      shift 2
      ;;
    *) usage ;;
  esac
done

if [[ -n "$RESUME_ROOT" ]]; then
  [[ -z "$GATE5_MANIFEST" && -z "$GATE5_RUNNOTE" && -z "$GATE5_PROMOTION" && -z "$AUTHORIZED_SHA" ]] || usage
else
  [[ -n "$GATE5_MANIFEST" && -n "$GATE5_RUNNOTE" && -n "$GATE5_PROMOTION" && "$AUTHORIZED_SHA" =~ ^[0-9a-f]{64}$ ]] || usage
fi

source ~/.ura_campaign_env
cd ~/MLLMRiskBench
umask 077

EXPECTED_COMMIT='@@EXPECTED_COMMIT@@'
EXPECTED_FRAMEWORK_LOCK='@@FRAMEWORK_LOCK_SHA256@@'
EXPECTED_PROJECT_REVISION_MANIFEST='@@PROJECT_RECEIPT_PATH@@'
EXPECTED_PROJECT_REVISION_SHA256='@@PROJECT_RECEIPT_SHA256@@'
EXPECTED_SOURCE_CONFORMANCE_MANIFEST='@@SOURCE_RECEIPT_PATH@@'
EXPECTED_SOURCE_CONFORMANCE_SHA256='@@SOURCE_RECEIPT_SHA256@@'
PY="$PWD/.venv/bin/python"

test "$(git rev-parse HEAD)" = "$EXPECTED_COMMIT"
test -z "$(git status --porcelain)"
test "$URA_FRAMEWORK_LOCK_ID" = "$EXPECTED_FRAMEWORK_LOCK"
test "$URA_FRAMEWORK_STATE" = "$URA_WORK/runs/engineering/framework-runtime-${EXPECTED_FRAMEWORK_LOCK:0:12}"
test -x "$PY"
test "$URA_PROJECT_REVISION_MANIFEST" = "$EXPECTED_PROJECT_REVISION_MANIFEST"
test "$URA_PROJECT_REVISION_SHA256" = "$EXPECTED_PROJECT_REVISION_SHA256"
test "$URA_SOURCE_CONFORMANCE_MANIFEST" = "$EXPECTED_SOURCE_CONFORMANCE_MANIFEST"
test "$URA_SOURCE_CONFORMANCE_SHA256" = "$EXPECTED_SOURCE_CONFORMANCE_SHA256"
test "$(sha256sum -- "$URA_PROJECT_REVISION_MANIFEST" | awk '{print $1}')" = "$EXPECTED_PROJECT_REVISION_SHA256"
test "$(sha256sum -- "$URA_SOURCE_CONFORMANCE_MANIFEST" | awk '{print $1}')" = "$EXPECTED_SOURCE_CONFORMANCE_SHA256"

"$PY" - "$URA_SOURCE_CONFORMANCE_MANIFEST" <<'PY'
from pathlib import Path
import sys

from ura.source_conformance import validate_source_conformance_manifest
from ura.strict_json import strict_json_loads

receipt = validate_source_conformance_manifest(
    strict_json_loads(Path(sys.argv[1]).read_bytes())
)
registry = strict_json_loads(
    (Path.cwd() / "experiments" / "source-instances.json").read_bytes()
)
rows = receipt.get("arms")
if not isinstance(rows, list):
    raise SystemExit("source receipt arm inventory is invalid")
by_arm = {row.get("arm_id"): row for row in rows if isinstance(row, dict)}
admitted = [row for row in rows if row.get("disposition") == "admitted"]
blocked = [row for row in rows if row.get("disposition") == "blocked"]
if (
    not isinstance(registry, dict)
    or len(rows) != 45
    or len(by_arm) != 45
    or set(by_arm) != set(registry)
    or len(admitted) != 44
    or len(blocked) != 1
    or blocked[0].get("arm_id") != "bipia_test_qa"
):
    raise SystemExit(
        "source receipt is not the exact 45-row portfolio: "
        "44 admitted plus blocked bipia_test_qa"
    )
PY

checked_regular() {
  local unresolved="$1" resolved
  test -n "$unresolved"
  test ! -L "$unresolved"
  resolved="$(readlink -e -- "$unresolved")"
  test -f "$resolved" && test ! -L "$resolved"
  printf '%s\n' "$resolved"
}

initial_launch='yes'
if [[ -n "$RESUME_ROOT" ]]; then
  [[ -z "$GATE5_MANIFEST" && -z "$GATE5_RUNNOTE" && -z "$GATE5_PROMOTION" && -z "$AUTHORIZED_SHA" ]] || usage
  initial_launch='no'
  CONTROL_ROOT="$(readlink -e -- "$RESUME_ROOT")"
  test -d "$CONTROL_ROOT" && test ! -L "$CONTROL_ROOT"
  case "$CONTROL_ROOT" in
    "$URA_WORK"/runs/engineering/phase6-core-measured-*) ;;
    *) printf 'unsafe Phase 6 control root: %s\n' "$CONTROL_ROOT" >&2; exit 1 ;;
  esac
  PAYLOAD_PATH="$(checked_regular "$CONTROL_ROOT/payload.sh")"
  test "$(stat -c '%a' -- "$PAYLOAD_PATH")" = '700'
  test "$(stat -c '%h' -- "$PAYLOAD_PATH")" = '1'
  CONTROLLER_LOCK="$(checked_regular "$CONTROL_ROOT/controller.lock")"
  test "$(stat -c '%a' -- "$CONTROLLER_LOCK")" = '600'
  test "$(stat -c '%h' -- "$CONTROLLER_LOCK")" = '1'
  LAUNCH_META="$(checked_regular "$CONTROL_ROOT/launch.json")"
  mapfile -d '' -t resume_values < <(
    "$PY" - "$LAUNCH_META" "$EXPECTED_COMMIT" "$EXPECTED_FRAMEWORK_LOCK" <<'PY'
import hashlib
import json
import pathlib
import sys

path, commit, lock = pathlib.Path(sys.argv[1]), sys.argv[2], sys.argv[3]

def _strict(pairs):
    out = {}
    for key, item in pairs:
        if key in out:
            raise SystemExit(f"duplicate JSON key in launch metadata: {key}")
        out[key] = item
    return out

raw = path.read_bytes()
value = json.loads(raw, object_pairs_hook=_strict)

required = {
    "schema", "expected_commit", "framework_lock_id", "manifest_sha256",
    "authorized_manifest_sha256", "manifest", "runnote", "promotion_receipt",
    "control_root", "payload",
}
if not isinstance(value, dict) or set(value) != required:
    raise SystemExit("invalid Phase 6 launch metadata")
if value["schema"] != "ura-phase6-core-controller-launch/1":
    raise SystemExit("unsupported Phase 6 launch metadata")
if value["expected_commit"] != commit or value["framework_lock_id"] != lock:
    raise SystemExit("Phase 6 launch code identity changed")
if value["manifest_sha256"] != value["authorized_manifest_sha256"]:
    raise SystemExit("Phase 6 launch authorization no longer matches its manifest")
if value["control_root"] != str(path.parent):
    raise SystemExit("Phase 6 launch metadata moved to a different control root")
for key in ("manifest", "runnote", "promotion_receipt", "payload"):
    descriptor = value[key]
    candidate = pathlib.Path(descriptor["path"])
    if candidate.is_symlink() or not candidate.is_file():
        raise SystemExit(f"stored {key} input is absent or unsafe")
    material = candidate.read_bytes()
    if len(material) != descriptor["bytes"] or hashlib.sha256(material).hexdigest() != descriptor["sha256"]:
        raise SystemExit(f"stored {key} input bytes changed")
    if key == "payload":
        if candidate != path.parent / "payload.sh":
            raise SystemExit("stored payload locator differs from the control root")
    else:
        print(str(candidate), end="\0")
print(value["manifest_sha256"], end="\0")
PY
  )
  test "${#resume_values[@]}" -eq 4
  GATE5_MANIFEST="${resume_values[0]}"
  GATE5_RUNNOTE="${resume_values[1]}"
  GATE5_PROMOTION="${resume_values[2]}"
  AUTHORIZED_SHA="${resume_values[3]}"
else
  [[ -n "$GATE5_MANIFEST" && -n "$GATE5_RUNNOTE" && -n "$GATE5_PROMOTION" && -n "$AUTHORIZED_SHA" ]] || usage
  [[ "$AUTHORIZED_SHA" =~ ^[0-9a-f]{64}$ ]] || usage
  GATE5_MANIFEST="$(checked_regular "$GATE5_MANIFEST")"
  GATE5_RUNNOTE="$(checked_regular "$GATE5_RUNNOTE")"
  GATE5_PROMOTION="$(checked_regular "$GATE5_PROMOTION")"
  observed_manifest_sha="$(sha256sum -- "$GATE5_MANIFEST" | awk '{print $1}')"
  test "$observed_manifest_sha" = "$AUTHORIZED_SHA"

  TAG="$(date -u +%Y%m%dT%H%M%SZ)"
  CONTROL_ROOT="$URA_WORK/runs/engineering/phase6-core-measured-${TAG}"
  test ! -e "$CONTROL_ROOT"
  mkdir -m 700 "$CONTROL_ROOT"
  mkdir -m 700 "$CONTROL_ROOT/inputs" "$CONTROL_ROOT/attempts" "$CONTROL_ROOT/lanes"

  "$PY" - "$CONTROL_ROOT/controller.lock" <<'PY'
import os
from pathlib import Path
import sys

path = Path(sys.argv[1])
fd = os.open(path, os.O_RDWR | os.O_CREAT | os.O_EXCL, 0o600)
os.close(fd)
PY
  CONTROLLER_LOCK="$CONTROL_ROOT/controller.lock"

  "$PY" - "$GATE5_MANIFEST" "$CONTROL_ROOT/inputs/covered-manifest.json" \
    "$GATE5_RUNNOTE" "$CONTROL_ROOT/inputs/RUNNOTE.md" \
    "$GATE5_PROMOTION" "$CONTROL_ROOT/inputs/RUNNOTE.gate5-promotion.receipt.json" <<'PY'
import os
import pathlib
import sys

for source_value, target_value in (
    (sys.argv[1], sys.argv[2]),
    (sys.argv[3], sys.argv[4]),
    (sys.argv[5], sys.argv[6]),
):
    source = pathlib.Path(source_value)
    target = pathlib.Path(target_value)
    payload = source.read_bytes()
    descriptor = os.open(target, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        with os.fdopen(descriptor, "wb", closefd=True) as handle:
            descriptor = -1
            handle.write(payload)
            handle.flush()
            os.fsync(handle.fileno())
    finally:
        if descriptor >= 0:
            os.close(descriptor)
PY
  GATE5_MANIFEST="$CONTROL_ROOT/inputs/covered-manifest.json"
  GATE5_RUNNOTE="$CONTROL_ROOT/inputs/RUNNOTE.md"
  GATE5_PROMOTION="$CONTROL_ROOT/inputs/RUNNOTE.gate5-promotion.receipt.json"
  PAYLOAD_PATH="$CONTROL_ROOT/payload.sh"
fi

if [[ "$initial_launch" == 'yes' ]]; then
  PAYLOAD="$(cat <<'PHASE6_PAYLOAD'
#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

source ~/.ura_campaign_env
cd ~/MLLMRiskBench

EXPECTED_COMMIT='@@EXPECTED_COMMIT@@'
EXPECTED_FRAMEWORK_LOCK='@@FRAMEWORK_LOCK_SHA256@@'
PY="$PWD/.venv/bin/python"
MANIFEST="$CONTROL_ROOT/inputs/covered-manifest.json"
RUNNOTE="$CONTROL_ROOT/inputs/RUNNOTE.md"
PROMOTION="$CONTROL_ROOT/inputs/RUNNOTE.gate5-promotion.receipt.json"
LAUNCH_META="$CONTROL_ROOT/launch.json"
CONTROLLER_LOCK="$CONTROL_ROOT/controller.lock"
ATTEMPT_ROOT="$CONTROL_ROOT/attempts/$ATTEMPT_TAG"
LOG="$ATTEMPT_ROOT/controller.log"
EVENTS="$CONTROL_ROOT/status.tsv"
EXIT_MARKER="$ATTEMPT_ROOT/.exit"
FAILURE_MARKER="$ATTEMPT_ROOT/failure.json"
COMPLETION="$ATTEMPT_ROOT/completion.json"

test ! -e "$ATTEMPT_ROOT"
mkdir -m 700 "$ATTEMPT_ROOT"

exec > >(tee "$LOG") 2>&1

current_lane='controller'
current_stage='startup'
active_child_pid=''
active_child_pgid=''
active_external_job_id=''
active_external_terminal_log=''
active_external_tmux_socket=''
active_external_tmux_session=''
terminal_completion_written='no'
terminal_exit_code=''
finish() {
  rc=$?
  trap - EXIT
  expected_terminal='no'
  if [[ "$terminal_completion_written" == 'yes' && "$terminal_exit_code" =~ ^[01]$ ]] \
    && (( rc == terminal_exit_code )); then
    expected_terminal='yes'
  fi
  if (( rc != 0 )) && [[ "$expected_terminal" != 'yes' ]] \
    && [[ -f "$COMPLETION" && ! -L "$COMPLETION" ]]; then
    invalidated_completion="$ATTEMPT_ROOT/completion.invalidated.json"
    if [[ ! -e "$invalidated_completion" && ! -L "$invalidated_completion" ]]; then
      mv -- "$COMPLETION" "$invalidated_completion"
    fi
  fi
  if (( rc != 0 )) && [[ "$expected_terminal" != 'yes' ]] \
    && [[ ! -e "$FAILURE_MARKER" ]]; then
    "$PY" - "$FAILURE_MARKER" "$current_lane" "$current_stage" "$rc" <<'PY' || true
import datetime
import json
import os
import pathlib
import sys

path = pathlib.Path(sys.argv[1])
value = {
    "schema": "ura-phase6-core-controller-failure/1",
    "status": "failed",
    "failed_at_utc": datetime.datetime.now(datetime.timezone.utc).isoformat().replace("+00:00", "Z"),
    "lane_id": sys.argv[2],
    "stage": sys.argv[3],
    "returncode": int(sys.argv[4]),
}
try:
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
except FileExistsError:
    pass
else:
    with os.fdopen(fd, "w", encoding="utf-8") as handle:
        json.dump(value, handle, sort_keys=True, separators=(",", ":"), allow_nan=False)
        handle.write("\n")
PY
  fi
  printf '%s\n' "$rc" > "$ATTEMPT_ROOT/.exit.tmp"
  mv -- "$ATTEMPT_ROOT/.exit.tmp" "$EXIT_MARKER"
  printf 'PHASE6_CORE_EXIT=%s\n' "$rc"
  exit "$rc"
}
abort_signal() {
  local code="$1"
  local child="$active_child_pid"
  local child_pgid="$active_child_pgid"
  local external_rc="$code"
  trap - INT TERM HUP
  if [[ "$child" =~ ^[0-9]+$ ]]; then
    if [[ "$child_pgid" =~ ^[0-9]+$ ]]; then
      kill -TERM -- "-$child_pgid" 2> /dev/null || true
    else
      kill -TERM "$child" 2> /dev/null || true
    fi
    for _ in {1..30}; do
      kill -0 "$child" 2> /dev/null || break
      sleep 1
    done
    if kill -0 "$child" 2> /dev/null; then
      if [[ "$child_pgid" =~ ^[0-9]+$ ]]; then
        kill -KILL -- "-$child_pgid" 2> /dev/null || true
      else
        kill -KILL "$child" 2> /dev/null || true
      fi
    fi
    wait "$child" 2> /dev/null || true
    active_child_pid=''
    active_child_pgid=''
  fi
  if [[ -n "$active_external_tmux_socket" && -n "$active_external_tmux_session" ]]; then
    timeout --signal=TERM --kill-after=5s 5s \
      tmux -L "$active_external_tmux_socket" kill-session \
      -t "$active_external_tmux_session" 2> /dev/null || true
    timeout --signal=TERM --kill-after=5s 5s \
      tmux -L "$active_external_tmux_socket" kill-server \
      2> /dev/null || true
    active_external_tmux_socket=''
    active_external_tmux_session=''
  fi
  if [[ -n "$active_external_job_id" ]]; then
    if [[ "$current_lane" != 'controller' ]] \
      && [[ -f "$ATTEMPT_ROOT/$current_lane.wall-time-exceeded" ]] \
      && [[ ! -L "$ATTEMPT_ROOT/$current_lane.wall-time-exceeded" ]]; then
      external_rc=124
    fi
    external_measured_terminal "$active_external_job_id" "$external_rc" \
      "$active_external_terminal_log" || true
    active_external_job_id=''
    active_external_terminal_log=''
  fi
  exit "$code"
}
run_owned() {
  local rc
  "$@" &
  active_child_pid="$!"
  if wait "$active_child_pid"; then
    rc=0
  else
    rc=$?
  fi
  active_child_pid=''
  active_child_pgid=''
  return "$rc"
}

external_measured_terminal() {
  local job_id="$1" exit_code="$2" terminal_log="$3"
  local rc
  if run_owned timeout --signal=TERM --kill-after=30s 30s \
    "$PY" -m experiments.rig_web_app.external_measured terminal \
    --results-root "$URA_WORK/runs" \
    --job-id "$job_id" \
    --exit-code "$exit_code" \
    > "$terminal_log" 2>&1; then
    rc=0
  else
    rc=$?
  fi
  return "$rc"
}

external_measured_run() {
  local lane="$1" invocation="$2" result_root="$3" runner_log="$4"
  shift 4
  local job_id session socket gate5_sha runner_rc terminal_rc invocation_token
  local registration_rc launch_rc runner_launch runner_launch_tmp runner_exit
  local runner_exit_tmp runner_exit_value tmux_command probe_rc
  invocation_token="$(date -u +%s%N)-$$"
  job_id="external-p6c-${ATTEMPT_TAG}-${invocation}-${invocation_token}-${lane}"
  [[ "$job_id" =~ ^external-[A-Za-z0-9][A-Za-z0-9._-]{0,118}$ ]]
  session="ura-p6c-job-${ATTEMPT_TAG}-${invocation_token}"
  socket="$session"
  [[ "$session" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$ ]]
  gate5_sha="$(sha256sum -- "$MANIFEST" | awk '{print $1}')"
  [[ "$gate5_sha" =~ ^[0-9a-f]{64}$ ]]
  if [[ ! -e "$result_root" && ! -L "$result_root" ]]; then
    mkdir -m 700 "$result_root"
  fi
  test -d "$result_root" && test ! -L "$result_root"
  test "$(readlink -e -- "$result_root")" = "$result_root"
  runner_launch="$ATTEMPT_ROOT/$lane.$invocation.$invocation_token.runner-launch.sh"
  runner_launch_tmp="${runner_launch}.tmp"
  runner_exit="$ATTEMPT_ROOT/$lane.$invocation.$invocation_token.runner-exit"
  runner_exit_tmp="${runner_exit}.tmp"
  test ! -e "$runner_launch" && test ! -L "$runner_launch"
  test ! -e "$runner_launch_tmp" && test ! -L "$runner_launch_tmp"
  test ! -e "$runner_exit" && test ! -L "$runner_exit"
  test ! -e "$runner_exit_tmp" && test ! -L "$runner_exit_tmp"
  {
    printf '#!/usr/bin/env bash\nset +e\n'
    printf '%q ' env CUDA_VISIBLE_DEVICES=0,1 "$PY" \
      -m experiments.run_matrix "$@"
    printf '> %q 2>&1\n' "$runner_log"
    printf 'rc=$?\nprintf '\''%%s\\n'\'' "$rc" > %q\nmv -- %q %q\nexit "$rc"\n' \
      "$runner_exit_tmp" "$runner_exit_tmp" "$runner_exit"
  } > "$runner_launch_tmp"
  chmod 700 "$runner_launch_tmp"
  mv -- "$runner_launch_tmp" "$runner_launch"
  printf -v tmux_command 'exec bash %q' "$runner_launch"

  # Establish the complete cleanup identity before start publication.  A
  # signal or publication-side failure can then terminalise any created row.
  active_external_job_id="$job_id"
  active_external_terminal_log="${runner_log}.external-terminal.log"
  active_external_tmux_socket="$socket"
  active_external_tmux_session="$session"
  if run_owned "$PY" -m experiments.rig_web_app.external_measured start \
    --results-root "$URA_WORK/runs" \
    --job-id "$job_id" \
    --out-dir "$result_root" \
    --expected-commit "$EXPECTED_COMMIT" \
    --framework-lock-id "$EXPECTED_FRAMEWORK_LOCK" \
    --admission-sha256 "$gate5_sha" \
    --tmux-socket "$socket" \
    --tmux-session "$session" \
    --argv "$@" \
    > "${runner_log}.external-start.log" 2>&1; then
    registration_rc=0
  else
    registration_rc=$?
  fi
  runner_rc="$registration_rc"
  if (( registration_rc == 0 )); then
    if run_owned tmux -L "$socket" new-session -d -s "$session" \
      "$tmux_command" > "${runner_log}.external-launch.log" 2>&1; then
      launch_rc=0
    else
      launch_rc=$?
    fi
    runner_rc="$launch_rc"
    if (( launch_rc == 0 )); then
      while true; do
        if timeout --signal=TERM --kill-after=5s 5s \
          tmux -L "$socket" has-session -t "$session" 2> /dev/null; then
          sleep 1
          continue
        else
          probe_rc=$?
        fi
        if (( probe_rc == 1 )); then
          break
        fi
        runner_rc=125
        timeout --signal=TERM --kill-after=5s 5s \
          tmux -L "$socket" kill-session -t "$session" \
          2> /dev/null || true
        timeout --signal=TERM --kill-after=5s 5s \
          tmux -L "$socket" kill-server 2> /dev/null || true
        break
      done
      if (( runner_rc == 0 )); then
        if [[ -f "$runner_exit" && ! -L "$runner_exit" ]] \
          && [[ "$(stat -c '%h' -- "$runner_exit")" = '1' ]]; then
          runner_exit_value="$(cat -- "$runner_exit")"
        else
          runner_exit_value=''
        fi
        if [[ "$runner_exit_value" =~ ^([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])$ ]]; then
          runner_rc="$runner_exit_value"
        else
          runner_rc=125
        fi
      fi
    fi
  fi
  active_external_tmux_socket=''
  active_external_tmux_session=''
  if external_measured_terminal "$job_id" "$runner_rc" \
    "$active_external_terminal_log"; then
    terminal_rc=0
  else
    terminal_rc=$?
  fi
  active_external_job_id=''
  active_external_terminal_log=''
  if (( runner_rc != 0 )); then
    return "$runner_rc"
  fi
  if (( terminal_rc != 0 )); then
    return "$terminal_rc"
  fi
  return 0
}

wait_lane_with_ceiling() {
  local child="$1" lane="$2" ceiling="$3"
  local deadline=$((SECONDS + ceiling)) grace rc timeout_trigger
  timeout_trigger="$ATTEMPT_ROOT/$lane.wall-time-exceeded"
  while kill -0 "$child" 2> /dev/null; do
    if (( SECONDS >= deadline )); then
      if [[ ! -e "$timeout_trigger" && ! -L "$timeout_trigger" ]]; then
        ( set -o noclobber; printf '%s\n' "$ceiling" > "$timeout_trigger" )
        chmod 600 "$timeout_trigger"
      fi
      kill -TERM -- "-$child" 2> /dev/null || true
      grace=$((SECONDS + 30))
      while kill -0 "$child" 2> /dev/null && (( SECONDS < grace )); do
        sleep 1
      done
      if kill -0 "$child" 2> /dev/null; then
        kill -KILL -- "-$child" 2> /dev/null || true
      fi
      wait "$child" 2> /dev/null || true
      active_child_pid=''
      active_child_pgid=''
      return 124
    fi
    sleep 1
  done
  if wait "$child"; then
    rc=0
  else
    rc=$?
  fi
  active_child_pid=''
  active_child_pgid=''
  return "$rc"
}
trap 'abort_signal 130' INT
trap 'abort_signal 143' TERM
trap 'abort_signal 129' HUP
trap finish EXIT

current_stage='controller-lock'
command -v flock > /dev/null
command -v timeout > /dev/null
test -f "$CONTROLLER_LOCK" && test ! -L "$CONTROLLER_LOCK"
test "$(stat -c '%a' -- "$CONTROLLER_LOCK")" = '600'
test "$(stat -c '%h' -- "$CONTROLLER_LOCK")" = '1'
exec 9<> "$CONTROLLER_LOCK"
if ! flock -n 9; then
  printf '%s\n' 'another Phase 6 core controller attempt holds the control-root lock' >&2
  exit 1
fi

event() {
  local lane="$1" stage="$2" status="$3" detail="${4:-}"
  if [[ ! -e "$EVENTS" && ! -L "$EVENTS" ]]; then
    ( set -o noclobber; printf 'attempt\ttime_utc\tlane\tstage\tstatus\tdetail\n' > "$EVENTS" )
    chmod 600 "$EVENTS"
  fi
  test -f "$EVENTS" && test ! -L "$EVENTS"
  test "$(stat -c '%a' -- "$EVENTS")" = '600'
  test "$(stat -c '%h' -- "$EVENTS")" = '1'
  detail="${detail//$'\t'/ }"
  detail="${detail//$'\n'/ }"
  printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$ATTEMPT_TAG" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$lane" "$stage" "$status" "$detail" \
    >> "$EVENTS"
}

assert_environment() {
  test "$(git rev-parse HEAD)" = "$EXPECTED_COMMIT"
  test -z "$(git status --porcelain)"
  test "$URA_FRAMEWORK_LOCK_ID" = "$EXPECTED_FRAMEWORK_LOCK"
  test "$URA_FRAMEWORK_STATE" = "$URA_WORK/runs/engineering/framework-runtime-${EXPECTED_FRAMEWORK_LOCK:0:12}"
  test -x "$PY"
  test -f "$URA_PROJECT_REVISION_MANIFEST" && test ! -L "$URA_PROJECT_REVISION_MANIFEST"
  test -f "$URA_SOURCE_CONFORMANCE_MANIFEST" && test ! -L "$URA_SOURCE_CONFORMANCE_MANIFEST"
  test "$(sha256sum -- "$URA_PROJECT_REVISION_MANIFEST" | awk '{print $1}')" = "$URA_PROJECT_REVISION_SHA256"
  test "$(sha256sum -- "$URA_SOURCE_CONFORMANCE_MANIFEST" | awk '{print $1}')" = "$URA_SOURCE_CONFORMANCE_SHA256"
  test -d "$URA_MODEL_STORE" && test ! -L "$URA_MODEL_STORE"
}

assert_environment
export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HF_DATASETS_OFFLINE=1
unset HF_TOKEN HUGGING_FACE_HUB_TOKEN OPENAI_API_KEY ANTHROPIC_API_KEY \
  GOOGLE_API_KEY GEMINI_API_KEY MISTRAL_API_KEY TOGETHER_API_KEY \
  DEEPSEEK_API_KEY XAI_API_KEY
unset URA_MODEL_ACQUISITION_PLAN_DIR URA_MODEL_ACQUISITION_PLAN \
  URA_MODEL_ACQUISITION_PLAN_SHA256 URA_MODEL_ACQUISITION_RECEIPT \
  URA_MODEL_ACQUISITION_RECEIPT_SHA256 URA_MODEL_ACQUISITION_STORE

current_stage='gate5-revalidation'
LANE_SPECS="$CONTROL_ROOT/lane-specs"
"$PY" - "$MANIFEST" "$RUNNOTE" "$PROMOTION" "$LAUNCH_META" "$LANE_SPECS" \
  "$EXPECTED_COMMIT" "$EXPECTED_FRAMEWORK_LOCK" <<'PY'
