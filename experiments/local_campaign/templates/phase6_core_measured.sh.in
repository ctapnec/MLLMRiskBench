def canonical(value: object) -> bytes:
    return (
        json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=True, allow_nan=False)
        + "\n"
    ).encode("ascii")

def stable_regular_bytes(path: Path, label: str) -> tuple[Path, bytes]:
    try:
        unresolved_entry = path.lstat()
        resolved = path.resolve(strict=True)
        before = resolved.lstat()
    except OSError as exc:
        raise SystemExit(f"{label} is absent or unsafe") from exc
    if (
        stat.S_ISLNK(unresolved_entry.st_mode)
        or not stat.S_ISREG(before.st_mode)
        or (unresolved_entry.st_dev, unresolved_entry.st_ino)
        != (before.st_dev, before.st_ino)
    ):
        raise SystemExit(f"{label} is absent or unsafe")

    def identity(entry: os.stat_result) -> tuple[int, int, int, int, int]:
        return (
            entry.st_mode,
            entry.st_dev,
            entry.st_ino,
            entry.st_size,
            entry.st_mtime_ns,
        )

    try:
        fd = os.open(
            resolved,
            os.O_RDONLY
            | getattr(os, "O_BINARY", 0)
            | getattr(os, "O_NOFOLLOW", 0),
        )
    except OSError as exc:
        raise SystemExit(f"{label} changed while reading") from exc
    try:
        opened = os.fstat(fd)
        chunks: list[bytes] = []
        while True:
            chunk = os.read(fd, 1024 * 1024)
            if not chunk:
                break
            chunks.append(chunk)
        payload = b"".join(chunks)
        opened_after = os.fstat(fd)
    except OSError as exc:
        raise SystemExit(f"{label} changed while reading") from exc
    finally:
        os.close(fd)
    try:
        after = resolved.lstat()
    except OSError as exc:
        raise SystemExit(f"{label} changed while reading") from exc
    if (
        not stat.S_ISREG(opened.st_mode)
        or not stat.S_ISREG(opened_after.st_mode)
        or not stat.S_ISREG(after.st_mode)
        or len(payload) != before.st_size
        or not (
            identity(before)
            == identity(opened)
            == identity(opened_after)
            == identity(after)
        )
    ):
        raise SystemExit(f"{label} changed while reading")
    return resolved, payload


def descriptor(path: Path) -> dict[str, object]:
    resolved, payload = stable_regular_bytes(path, f"completion input {path}")
    return {
        "path": str(resolved),
        "sha256": hashlib.sha256(payload).hexdigest(),
        "bytes": len(payload),
    }

def strict_object(path: Path) -> dict[str, object]:
    _, payload = stable_regular_bytes(path, f"JSON object {path}")
    value = strict_json_loads(payload)
    if not isinstance(value, dict):
        raise SystemExit(f"expected one JSON object: {path}")
    return value

def type_strict_equal(left: object, right: object) -> bool:
    if type(left) is not type(right):
        return False
    if isinstance(left, dict):
        return set(left) == set(right) and all(
            type_strict_equal(left[key], right[key]) for key in left
        )
    if isinstance(left, list):
        return len(left) == len(right) and all(
            type_strict_equal(a, b) for a, b in zip(left, right)
        )
    return left == right

def exact_descriptor_bytes(value: object, label: str) -> tuple[Path, bytes]:
    if not isinstance(value, dict) or set(value) != {"path", "sha256", "bytes"}:
        raise SystemExit(f"{label} descriptor shape changed")
    path = Path(str(value.get("path", "")))
    resolved, payload = stable_regular_bytes(path, label)
    observed = {
        "path": str(resolved),
        "sha256": hashlib.sha256(payload).hexdigest(),
        "bytes": len(payload),
    }
    if observed != value:
        raise SystemExit(f"{label} descriptor content changed")
    return resolved, payload


def exact_descriptor(value: object, label: str) -> Path:
    path, _ = exact_descriptor_bytes(value, label)
    return path


def projection_from_bytes(
    path: Path, payload: bytes, expected_sha256: str, label: str,
) -> tuple[dict[str, object], dict[str, object]]:
    if (
        not payload
        or len(payload) > 4 * 1024 * 1024
        or hashlib.sha256(payload).hexdigest() != expected_sha256
    ):
        raise SystemExit(f"{label} byte identity changed")
    value = strict_json_loads(payload)
    projection = validate_lane_projection(value)
    if (
        payload != lane_projection_bytes(projection)
        or path.name != f"{projection['projection_id']}.lane-projection.json"
    ):
        raise SystemExit(f"{label} canonical content identity changed")
    return projection, {
        "file": path.name, "sha256": expected_sha256, "bytes": len(payload),
    }


def envelope_from_bytes(
    path: Path, payload: bytes, label: str,
) -> tuple[dict[str, object], dict[str, object]]:
    if not payload or len(payload) > 4 * 1024 * 1024:
        raise SystemExit(f"{label} is empty or exceeds its size limit")
    envelope = validate_request_envelope(strict_json_loads(payload))
    if (
        payload != request_envelope_bytes(envelope)
        or path.name != f"{envelope['envelope_id']}.request-envelope.json"
    ):
        raise SystemExit(f"{label} canonical content identity changed")
    return envelope, {
        "envelope_id": envelope["envelope_id"],
        "file": path.name,
        "sha256": hashlib.sha256(payload).hexdigest(),
        "bytes": len(payload),
    }


def rr_tree_descriptor(value: object, label: str) -> dict[str, object]:
    if not isinstance(value, dict) or set(value) != {
        "path", "sha256", "bytes", "files",
    }:
        raise SystemExit(f"{label}: RR evidence-tree descriptor changed")
    path = Path(str(value.get("path", "")))
    try:
        entry = path.lstat()
        root = path.resolve(strict=True)
    except OSError as exc:
        raise SystemExit(f"{label}: RR evidence root cannot be resolved") from exc
    root_before = root.lstat()
    if (
        stat.S_ISLNK(entry.st_mode)
        or not stat.S_ISDIR(entry.st_mode)
        or not stat.S_ISDIR(root_before.st_mode)
        or (entry.st_dev, entry.st_ino) != (root_before.st_dev, root_before.st_ino)
    ):
        raise SystemExit(f"{label}: RR evidence root is not one directory")

    def identity(entry_value: os.stat_result) -> tuple[int, int, int, int, int]:
        return (
            entry_value.st_mode,
            entry_value.st_dev,
            entry_value.st_ino,
            entry_value.st_size,
            entry_value.st_mtime_ns,
        )

    def inventory() -> tuple[
        dict[str, tuple[int, int, int, int, int]], list[tuple[str, Path]]
    ]:
        members: dict[str, tuple[int, int, int, int, int]] = {}
        regular_files: list[tuple[str, Path]] = []
        for member in root.rglob("*"):
            member_entry = member.lstat()
            relative = member.relative_to(root).as_posix()
            if stat.S_ISLNK(member_entry.st_mode):
                raise SystemExit(f"{label}: RR evidence root contains a symlink")
            if not (
                stat.S_ISDIR(member_entry.st_mode)
                or stat.S_ISREG(member_entry.st_mode)
            ):
                raise SystemExit(f"{label}: RR evidence root contains a non-file")
            members[relative] = identity(member_entry)
            if stat.S_ISREG(member_entry.st_mode):
                regular_files.append((relative, member))
        regular_files.sort(key=lambda item: item[0])
        return members, regular_files

    members_before, files = inventory()
    if not files:
        raise SystemExit(f"{label}: RR evidence root is empty")
    tree_hash = hashlib.sha256()
    total_bytes = 0
    for relative, member in files:
        before = member.lstat()
        try:
            fd = os.open(
                member,
                os.O_RDONLY
                | getattr(os, "O_BINARY", 0)
                | getattr(os, "O_NOFOLLOW", 0),
            )
        except OSError as exc:
            raise SystemExit(
                f"{label}: RR evidence member changed while reading"
            ) from exc
        try:
            opened = os.fstat(fd)
            chunks: list[bytes] = []
            while True:
                chunk = os.read(fd, 1024 * 1024)
                if not chunk:
                    break
                chunks.append(chunk)
            payload = b"".join(chunks)
            opened_after = os.fstat(fd)
        except OSError as exc:
            raise SystemExit(
                f"{label}: RR evidence member changed while reading"
            ) from exc
        finally:
            os.close(fd)
        after = member.lstat()
        if (
            not stat.S_ISREG(before.st_mode)
            or not stat.S_ISREG(opened.st_mode)
            or not stat.S_ISREG(opened_after.st_mode)
            or not stat.S_ISREG(after.st_mode)
            or len(payload) != before.st_size
            or not (
                identity(before)
                == identity(opened)
                == identity(opened_after)
                == identity(after)
            )
        ):
            raise SystemExit(f"{label}: RR evidence member changed while reading")
        member_sha = hashlib.sha256(payload).hexdigest()
        total_bytes += len(payload)
        tree_hash.update(relative.encode("utf-8"))
        tree_hash.update(b"\0")
        tree_hash.update(str(len(payload)).encode("ascii"))
        tree_hash.update(b"\0")
        tree_hash.update(member_sha.encode("ascii"))
        tree_hash.update(b"\n")
    members_after, _ = inventory()
    root_after = root.lstat()
    if members_after != members_before or identity(root_after) != identity(root_before):
        raise SystemExit(f"{label}: RR evidence root changed while reading")
    observed = {
        "path": str(root), "sha256": tree_hash.hexdigest(),
        "bytes": total_bytes, "files": len(files),
    }
    if not type_strict_equal(value, observed):
        raise SystemExit(f"{label}: RR evidence-tree bytes changed")
    return observed


def revalidate_rr_runtime_terminal_artifact(
    descriptor_value: object, label: str
) -> None:
    _, terminal_payload = exact_descriptor_bytes(
        descriptor_value, f"{label} RR terminal artifact"
    )
    value = strict_json_loads(terminal_payload)
    if not isinstance(value, dict):
        raise SystemExit(f"{label}: RR terminal artifact is not one object")
    if (
        set(value) != {
            "schema", "status", "disposition", "reason_code", "reason",
            "classified_at_utc", "target", "bindings", "observations",
            "call_accounting", "applies_to_lanes", "evidence_eligible",
        }
        or value.get("schema") != "ura-phase5-target-runtime-terminal/1"
        or value.get("status") != "unavailable"
        or value.get("disposition") != "unavailable"
        or value.get("reason_code") != RR_TERMINAL_REASON_CODE
        or value.get("reason") != RR_TERMINAL_REASON
        or value.get("applies_to_lanes") != list(RR_TERMINAL_LANES)
        or value.get("evidence_eligible") is not False
    ):
        raise SystemExit(f"{label}: RR terminal artifact envelope changed")
    target = value.get("target")
    if (
        not isinstance(target, dict)
        or set(target) != {
            "spec", "model", "revision", "resource_id", "runtime",
            "runtime_version", "modalities", "configured_max_tokens", "local_config",
        }
        or target.get("spec") != "vllm:GraySwanAI/llava-v1.6-mistral-7b-hf-RR"
        or target.get("model") != "GraySwanAI/llava-v1.6-mistral-7b-hf-RR"
        or target.get("revision") != "d11b3d7ae2fb21e984f197a83c15bbb0deb66b7e"
        or target.get("resource_id") != "hf-400da4b35ea290e28fcce5f33f8d4090"
        or target.get("runtime") != "vllm"
        or target.get("runtime_version") != "0.27.1"
        or target.get("modalities") != ["text", "image"]
        or type(target.get("configured_max_tokens")) is not int
        or target.get("configured_max_tokens") != 4096
    ):
        raise SystemExit(f"{label}: RR target identity changed")
    local_config_path, local_config_payload = exact_descriptor_bytes(
        target.get("local_config"), f"{label} RR local config"
    )
    expected_local_config_path = (
        Path.cwd().resolve(strict=True) / "experiments" / "local-llava-rr.json"
    )
    if (
        local_config_path != expected_local_config_path
        or target["local_config"].get("sha256")
        != "3a53ab82405636116e9c95850dae1e0c1e394021317707c978bc35b4178ca334"
        or type(target["local_config"].get("bytes")) is not int
        or target["local_config"].get("bytes") != 246
    ):
        raise SystemExit(f"{label}: RR local config path changed")
    local_config = strict_json_loads(local_config_payload)
    if not type_strict_equal(local_config, {target["spec"]: {
        "revision": target["revision"], "modalities": ["text", "image"],
        "tensor_parallel_size": 1, "gpu_memory_utilization": 0.85,
        "max_tokens": 4096,
    }}):
        raise SystemExit(f"{label}: RR local config changed")
    bindings = value.get("bindings")
    if (
        not isinstance(bindings, dict)
        or set(bindings) != {
            "classification_project_commit", "framework_lock_sha256",
            "project_revision", "semantic_source_continuity", "evidence_roots",
        }
        or bindings.get("classification_project_commit") != expected_commit
        or bindings.get("framework_lock_sha256") != expected_lock
    ):
        raise SystemExit(f"{label}: RR terminal bindings changed")
    exact_descriptor(
        bindings.get("project_revision"), f"{label} RR project revision"
    )
    continuity = bindings.get("semantic_source_continuity")
    if (
        not isinstance(continuity, dict)
        or set(continuity) != {
            "observed_project_commit", "unchanged_paths", "git_diff_empty",
        }
        or continuity.get("observed_project_commit")
        != "21b27d56da0d081125f4cf4117884a8262386e5d"
        or continuity.get("unchanged_paths")
        != ["src/ura/targets/local.py", "experiments/run_matrix.py"]
        or continuity.get("git_diff_empty") is not True
    ):
        raise SystemExit(f"{label}: RR semantic-continuity binding changed")
    evidence_roots = bindings.get("evidence_roots")
    evidence_names = {
        "text_vllm_4096", "image_vllm_4096", "vllm_token_tail_512",
        "transformers_reference_512",
    }
    if not isinstance(evidence_roots, dict) or set(evidence_roots) != evidence_names:
        raise SystemExit(f"{label}: RR evidence-root inventory changed")
    for name in sorted(evidence_names):
        rr_tree_descriptor(evidence_roots[name], f"{label} {name}")


def validate_defense_conditional_terminal(row: object) -> None:
    typed_na = {"status": "N/A", "value": None}
    expected_row_fields = {
        "lane_id", "family", "disposition", "reason_code", "reason",
        "projection", "canary", "final_preflight", "approved_caps",
    }
    if (
        not isinstance(row, dict)
        or set(row) != expected_row_fields
        or row.get("lane_id") != DEFENSE_LOCAL
        or row.get("family") != "core"
        or row.get("disposition") != "conditional_na"
        or row.get("projection") != typed_na
        or row.get("final_preflight") != typed_na
        or row.get("approved_caps") != typed_na
    ):
        raise SystemExit("Phase 6 core copied defense-local terminal changed")
    canary = row.get("canary")
    row_variants = [
        variant for variant in DEFENSE_CONDITIONAL_VARIANTS.values()
        if row.get("reason_code") == variant["reason_code"]
        and row.get("reason") == variant["reason"]
        and isinstance(canary, dict)
        and type_strict_equal(canary.get("call_accounting"), variant["accounting"])
    ]
    if len(row_variants) != 1:
        raise SystemExit("Phase 6 core copied defense-local variants are cross-mixed")
    row_variant = row_variants[0]
    if (
        not isinstance(canary, dict)
        or set(canary) != {
            "status", "value", "conditional_na_artifact", "call_accounting",
        }
        or canary.get("status") != "N/A"
        or canary.get("value") is not None
        or not type_strict_equal(canary.get("call_accounting"), row_variant["accounting"])
    ):
        raise SystemExit("Phase 6 core copied defense-local canary changed")
    artifact_path = exact_descriptor(
        canary.get("conditional_na_artifact"),
        "Phase 6 core copied defense-local conditional N/A",
    )
    artifact = strict_object(artifact_path)
    variant = DEFENSE_CONDITIONAL_VARIANTS.get(artifact.get("schema"))
    expected_artifact_fields = {
        "schema", "status", "lane_id", "disposition", "reason_code", "reason",
        "classified_at_utc", "classification", "bindings", "call_accounting",
        "runner_outputs", "artifacts", "resource_identities",
    }
    if variant is not None and variant["evidence_limits"] is not None:
        expected_artifact_fields.add("evidence_limits")
    if (
        variant is None
        or variant is not row_variant
        or set(artifact) != expected_artifact_fields
        or artifact.get("status") != "N/A"
        or artifact.get("lane_id") != DEFENSE_LOCAL
        or artifact.get("disposition") != "conditional_na"
        or artifact.get("reason_code") != variant["reason_code"]
        or artifact.get("reason") != variant["reason"]
        or not type_strict_equal(artifact.get("classification"), variant["classification"])
        or not type_strict_equal(artifact.get("call_accounting"), variant["accounting"])
        or not type_strict_equal(
            artifact.get("call_accounting"), canary.get("call_accounting")
        )
        or not type_strict_equal(artifact.get("runner_outputs"), variant["runner_outputs"])
        or not type_strict_equal(artifact.get("evidence_limits"), variant["evidence_limits"])
    ):
        raise SystemExit("Phase 6 core copied defense-local artifact changed")
    try:
        classified_at = datetime.fromisoformat(
            str(artifact.get("classified_at_utc", "")).replace("Z", "+00:00")
        )
    except ValueError as exc:
        raise SystemExit(
            "Phase 6 core copied defense-local classification timestamp is invalid"
        ) from exc
    if (
        classified_at.tzinfo is None
        or classified_at.utcoffset() != timezone.utc.utcoffset(classified_at)
    ):
        raise SystemExit(
            "Phase 6 core copied defense-local classification timestamp is not UTC"
        )
    bindings = artifact.get("bindings")
    if (
        not isinstance(bindings, dict)
        or set(bindings) != {
            "expected_commit", "framework_lock_id", "project_revision_sha256",
            "source_conformance_sha256", "source_config_sha256",
            "cuda_visible_devices", "target", "scoring_guard", "defense_guard",
        }
        or bindings.get("expected_commit") != expected_commit
        or bindings.get("framework_lock_id") != expected_lock
        or bindings.get("cuda_visible_devices") != "0,1"
        or bindings.get("target") != {
            "spec": "vllm:Qwen/Qwen3-VL-8B-Instruct",
            "revision": "60595ebc30ec8e3b1d3b9e65d4943ca011c0006a",
            "config_sha256": bindings.get("target", {}).get("config_sha256")
            if isinstance(bindings.get("target"), dict) else None,
        }
        or bindings.get("scoring_guard") != {
            "model": "meta-llama/Llama-Guard-3-8B",
            "revision": "7327bd9f6efbbe6101dc6cc4736302b3cbb6e425",
            "device": "cuda:1",
        }
        or bindings.get("defense_guard") != {
            "model": "meta-llama/Llama-Guard-3-1B",
            "revision": "acf7aafa60f0410f8f42b1fa35e077d705892029",
            "device": "cuda:1",
        }
        or re.fullmatch(
            r"[0-9a-f]{64}", str(bindings.get("project_revision_sha256", ""))
        ) is None
        or re.fullmatch(
            r"[0-9a-f]{64}", str(bindings.get("source_conformance_sha256", ""))
        ) is None
        or re.fullmatch(
            r"[0-9a-f]{64}", str(bindings.get("source_config_sha256", ""))
        ) is None
    ):
        raise SystemExit("Phase 6 core copied defense-local bindings changed")
    target = bindings["target"]
    if re.fullmatch(r"[0-9a-f]{64}", str(target.get("config_sha256", ""))) is None:
        raise SystemExit("Phase 6 core copied defense-local target config changed")
    artifacts = artifact.get("artifacts")
    expected_artifact_names = variant["artifact_names"]
    if not isinstance(artifacts, dict) or set(artifacts) != expected_artifact_names:
        raise SystemExit("Phase 6 core copied defense-local artifact inventory changed")
    artifact_paths = {
        name: exact_descriptor(value, f"Phase 6 core copied defense-local {name}")
        for name, value in artifacts.items()
    }
    if len(set(artifact_paths.values())) != len(artifact_paths):
        raise SystemExit("Phase 6 core copied defense-local artifacts overlap")
    if (
        artifacts["local_config"]["sha256"] != target["config_sha256"]
        or artifacts["project_revision"]["sha256"]
        != bindings["project_revision_sha256"]
        or artifacts["source_conformance"]["sha256"]
        != bindings["source_conformance_sha256"]
        or artifacts["source_config"]["sha256"]
        != bindings["source_config_sha256"]
    ):
        raise SystemExit("Phase 6 core copied defense-local descriptor bindings changed")
    eligibility = strict_object(artifact_paths["eligibility_plan"])
    conditions = eligibility.get("bindings", {}).get(
        "experiment_conditions", {}
    ).get("values", {})
    live_binding = conditions.get("live_attestation")
    live_rows = live_binding.get("artifacts") if isinstance(live_binding, dict) else None
    live_name = (
        "retained_live_attestation"
        if artifact.get("schema") == DEFENSE_CONDITIONAL_V2_SCHEMA
        else "live_attestation"
    )
    live_path = artifact_paths[live_name]
    live_descriptor = artifacts[live_name]
    if artifact.get("schema") == DEFENSE_CONDITIONAL_V2_SCHEMA and (
        live_descriptor["sha256"] != artifacts["live_attestation"]["sha256"]
        or live_descriptor["bytes"] != artifacts["live_attestation"]["bytes"]
        or live_path.name
        != f"live-attestation-{artifacts['live_attestation']['sha256'][:24]}.json"
    ):
        raise SystemExit(
            "Phase 6 core copied retained live attestation differs from source"
        )
    if (
        not isinstance(live_binding, dict)
        or set(live_binding) != {
            "mode", "execution_scope_id", "max_age_hours", "artifacts",
        }
        or live_binding.get("mode") != "measured"
        or not isinstance(live_binding.get("execution_scope_id"), str)
        or not live_binding["execution_scope_id"].strip()
        or type(live_binding.get("max_age_hours")) is not float
        or live_binding.get("max_age_hours") != 24.0
        or not isinstance(live_rows, list)
        or len(live_rows) != 1
        or not isinstance(live_rows[0], dict)
        or set(live_rows[0]) != {"file", "sha256", "bytes", "attestation_id"}
        or live_rows[0].get("file") != live_path.name
        or live_rows[0].get("sha256") != live_descriptor["sha256"]
        or live_rows[0].get("bytes") != live_descriptor["bytes"]
        or re.fullmatch(
            r"live-attestation-[0-9a-f]{24}",
            str(live_rows[0].get("attestation_id", "")),
        ) is None
    ):
        raise SystemExit("Phase 6 core copied defense-local live-attestation binding changed")
    live_manifest, live_observed = load_live_attestation_file(
        live_path, live_descriptor["sha256"]
    )
    if (
        live_observed != {
            "file": live_path.name,
            "sha256": live_descriptor["sha256"],
            "bytes": live_descriptor["bytes"],
        }
        or live_manifest.get("attestation_id") != live_rows[0]["attestation_id"]
    ):
        raise SystemExit("Phase 6 core copied defense-local live-attestation identity changed")
    acquisition_log = artifact_paths["acquisition_result_log"]
    if (
        acquisition_log.name != "defense-local-canary.acquire.log"
        or acquisition_log.parent != artifact_paths["runner_log"].parent
    ):
        raise SystemExit("Phase 6 core copied defense-local acquisition log changed")
    receipt = strict_object(artifact_paths["acquisition_receipt"])
    receipt_id = receipt.get("receipt_id")
    if not isinstance(receipt_id, str) or not receipt_id:
        raise SystemExit("Phase 6 core copied defense-local receipt id changed")
    acquisition_rows = []
    for raw_line in acquisition_log.read_text(
        encoding="utf-8", errors="strict"
    ).splitlines():
        try:
            item = strict_json_loads(raw_line)
        except (TypeError, ValueError):
            continue
        if isinstance(item, dict) and set(item) == {
            "downloaded_bytes", "receipt_id", "receipt_sha256",
        }:
            acquisition_rows.append(item)
    if (
        len(acquisition_rows) != 1
        or acquisition_rows[0].get("receipt_id") != receipt_id
        or acquisition_rows[0].get("receipt_sha256")
        != artifacts["acquisition_receipt"]["sha256"]
        or type(acquisition_rows[0].get("downloaded_bytes")) is not int
        or acquisition_rows[0].get("downloaded_bytes") != 0
    ):
        raise SystemExit(
            "Phase 6 core copied defense-local acquisition result changed"
        )
    runner_log = artifact_paths["runner_log"].read_text(
        encoding="utf-8", errors="replace"
    )
    is_output_noncompletion = artifact.get("schema") == DEFENSE_CONDITIONAL_V2_SCHEMA
    if is_output_noncompletion:
        if (
            len(re.findall(
                r"^  ! cell failed \[[^\r\n]+\]: ExternalCallFailure: target_call failed "
                r"\(LocalTargetOutputError\): vLLM completion is truncated or incomplete: "
                r"'length'$",
                runner_log,
                flags=re.MULTILINE,
            )) != 1
            or runner_log.count("done: 0 cells written, 0 already complete, 2 failed") != 1
            or "CUDA out of memory" in runner_log
        ):
            raise SystemExit(
                "Phase 6 core copied defense-local target noncompletion changed"
            )
    elif len(re.findall(
        r"^cannot initialize matrix lifecycle: [^\r\n]*CUDA out of memory[^\r\n]*$",
        runner_log,
        flags=re.IGNORECASE | re.MULTILINE,
    )) != 1:
        raise SystemExit("Phase 6 core copied defense-local OOM evidence changed")
    budget = strict_object(artifact_paths["budget_ledger"])
    if (
        set(budget) != {
            "budget_id", "max_target_calls", "max_judge_calls",
            "max_http_attempts", "deadline_epoch", "target_calls", "judge_calls",
            "http_attempts", "accounting_semantics",
        }
        or re.fullmatch(r"grid-[0-9a-f]{24}", str(budget.get("budget_id", ""))) is None
        or artifact_paths["budget_ledger"].name
        != f"{budget.get('budget_id')}.budget.json"
        or type(budget.get("target_calls")) is not int
        or budget.get("target_calls") != (1 if is_output_noncompletion else 0)
        or type(budget.get("judge_calls")) is not int
        or budget.get("judge_calls") != 0
        or type(budget.get("http_attempts")) is not int
        or budget.get("http_attempts") != 0
        or budget.get("accounting_semantics")
        != variant["accounting"]["accounting_semantics"]
    ):
        raise SystemExit("Phase 6 core copied defense-local call ledger changed")
    runner_root = artifact_paths["budget_ledger"].parent
    if is_output_noncompletion:
        if any(artifact_paths[name].parent != runner_root for name in {
            "partial_grid", "circuit_ledger", "target_error", "failed_cell_manifest",
            "empty_attempts", "empty_responses", "empty_judge_trails", "empty_results",
            "parquet_placeholder", "retained_live_attestation",
        }):
            raise SystemExit(
                "Phase 6 core copied defense-local failed artifacts span roots"
            )
        if list(runner_root.rglob("*.complete.json")) or any(
            artifact_paths[name].stat().st_size != 0
            for name in {
                "empty_attempts", "empty_responses", "empty_judge_trails", "empty_results"
            }
        ):
            raise SystemExit(
                "Phase 6 core copied defense-local failed cell has success evidence"
            )
    elif any(
        list(runner_root.rglob(pattern))
        for pattern in (
            "grid-*.grid.json", "*.responses.jsonl", "*.complete.json", "*.error.json",
        )
    ):
        raise SystemExit("Phase 6 core copied defense-local has post-preload output")
    identities = artifact.get("resource_identities")
    if (
        not isinstance(identities, list)
        or len(identities) != 3
        or any(
            not isinstance(item, dict)
            or set(item) != {"resource_id", "repo_id", "revision", "roles"}
            or not isinstance(item.get("resource_id"), str)
            or not item["resource_id"]
            for item in identities
        )
        or {
            (item["repo_id"], item["revision"], tuple(item["roles"]))
            for item in identities
        } != {
            (
                "Qwen/Qwen3-VL-8B-Instruct",
                "60595ebc30ec8e3b1d3b9e65d4943ca011c0006a",
                ("vllm_target",),
            ),
            (
                "meta-llama/Llama-Guard-3-8B",
                "7327bd9f6efbbe6101dc6cc4736302b3cbb6e425",
                ("guardrail_judge",),
            ),
            (
                "meta-llama/Llama-Guard-3-1B",
                "acf7aafa60f0410f8f42b1fa35e077d705892029",
                ("defense_guardrail",),
            ),
        }
    ):
        raise SystemExit("Phase 6 core copied defense-local resources changed")


def validate_rr_runtime_terminals(
    by_lane: dict[object, dict[str, object]],
) -> dict[str, object]:
    unavailable = {"status": "UNAVAILABLE", "value": None}
    expected_fields = {
        "lane_id", "family", "disposition", "reason_code", "reason",
        "projection", "canary", "final_preflight", "approved_caps",
    }
    shared_descriptor: dict[str, object] | None = None
    for lane in RR_TERMINAL_LANES:
        row = by_lane.get(lane)
        canary = row.get("canary") if isinstance(row, dict) else None
        if (
            not isinstance(row, dict)
            or set(row) != expected_fields
            or row.get("family") != "core"
            or row.get("disposition") != "unavailable"
            or row.get("reason_code") != RR_TERMINAL_REASON_CODE
            or row.get("reason") != RR_TERMINAL_REASON
            or row.get("final_preflight") != unavailable
            or row.get("approved_caps") != unavailable
            or not isinstance(canary, dict)
            or set(canary) != {
                "status", "value", "target_runtime_terminal_artifact",
            }
            or canary.get("status") != "UNAVAILABLE"
            or canary.get("value") is not None
        ):
            raise SystemExit(
                f"Phase 6 core copied RR terminal changed: {lane}"
            )
        projection_field = row.get("projection")
        projection_value = (
            projection_field.get("value")
            if isinstance(projection_field, dict)
            else None
        )
        projection_fields = {
            "projection_id", "projection_artifact", "eligibility_plan_id",
            "eligibility_artifact", "request_envelope_id",
            "request_envelope_artifact", "selection", "projected_calls",
        }
        if (
            not isinstance(projection_field, dict)
            or set(projection_field) != {"status", "value"}
            or projection_field.get("status") != "passed"
            or not isinstance(projection_value, dict)
            or set(projection_value) != projection_fields
            or not isinstance(projection_value.get("selection"), dict)
        ):
            raise SystemExit(
                f"Phase 6 core copied RR successful projection changed: {lane}"
            )
        projection_descriptor = projection_value["projection_artifact"]
        envelope_descriptor = projection_value["request_envelope_artifact"]
        if (
            not isinstance(projection_descriptor, dict)
            or set(projection_descriptor) != {"path", "file", "sha256", "bytes"}
            or projection_descriptor.get("file")
            != Path(str(projection_descriptor.get("path", ""))).name
            or not isinstance(envelope_descriptor, dict)
            or set(envelope_descriptor)
            != {"path", "envelope_id", "file", "sha256", "bytes"}
            or envelope_descriptor.get("envelope_id")
            != projection_value.get("request_envelope_id")
            or envelope_descriptor.get("file")
            != Path(str(envelope_descriptor.get("path", ""))).name
        ):
            raise SystemExit(
                f"Phase 6 core copied RR projection descriptor changed: {lane}"
            )
        projection_path, projection_payload = exact_descriptor_bytes(
            {
                "path": projection_descriptor.get("path"),
                "sha256": projection_descriptor.get("sha256"),
                "bytes": projection_descriptor.get("bytes"),
            },
            f"Phase 6 core copied RR projection {lane}",
        )
        eligibility_path, eligibility_payload = exact_descriptor_bytes(
            projection_value.get("eligibility_artifact"),
            f"Phase 6 core copied RR eligibility {lane}",
        )
        envelope_path, envelope_payload = exact_descriptor_bytes(
            {
                "path": envelope_descriptor.get("path"),
                "sha256": envelope_descriptor.get("sha256"),
                "bytes": envelope_descriptor.get("bytes"),
            },
            f"Phase 6 core copied RR envelope {lane}",
        )
        projection_content, observed_projection = projection_from_bytes(
            projection_path, projection_payload, projection_descriptor["sha256"],
            f"Phase 6 core copied RR projection {lane}",
        )
        eligibility_content = validate_eligibility_plan(
            strict_json_loads(eligibility_payload)
        )
        eligibility_records = sum(
            1
            for line in eligibility_payload.decode("utf-8").splitlines()
            if line.strip()
        )
        validate_lane_projection_binding(
            projection_content,
            eligibility_plan=eligibility_content,
            eligibility_artifact={
                "file": eligibility_path.name,
                "sha256": projection_value["eligibility_artifact"]["sha256"],
                "bytes": projection_value["eligibility_artifact"]["bytes"],
                "records": eligibility_records,
            },
        )
        envelope_content, observed_envelope = envelope_from_bytes(
            envelope_path, envelope_payload,
            f"Phase 6 core copied RR envelope {lane}",
        )
        calls = projection_content.get("call_projection", {})
        projected_calls = projection_value.get("projected_calls")
        if (
            projection_descriptor
            != {"path": str(projection_path), **observed_projection}
            or projection_value["eligibility_artifact"]["path"]
            != str(eligibility_path)
            or envelope_descriptor
            != {"path": str(envelope_path), **observed_envelope}
            or projection_content.get("projection_id")
            != projection_value.get("projection_id")
            or eligibility_content.get("plan_id")
            != projection_value.get("eligibility_plan_id")
            or envelope_content.get("envelope_id")
            != projection_value.get("request_envelope_id")
            or eligibility_content.get("bindings", {}).get(
                "request_envelope_sha256"
            )
            != envelope_descriptor["sha256"]
            or projection_content.get("selection")
            != projection_value.get("selection")
            or projected_calls != {
                "trajectories": calls.get("trajectories"),
                "target_calls": calls.get("target_calls"),
                "model_judge_calls": calls.get("judge_calls"),
                "local_guardrail_evaluations": calls.get(
                    "local_guardrail_evaluations"
                ),
                "http_attempts": calls.get("http_attempts"),
            }
            or type(projected_calls.get("target_calls")) is not int
            or projected_calls["target_calls"] <= 0
        ):
            raise SystemExit(
                f"Phase 6 core copied RR projection content changed: {lane}"
            )
        evidence = canary.get("target_runtime_terminal_artifact")
        exact_descriptor(
            evidence,
            f"Phase 6 core copied RR target-runtime terminal {lane}",
        )
        if shared_descriptor is None:
            shared_descriptor = evidence
        elif not type_strict_equal(evidence, shared_descriptor):
            raise SystemExit(
                "Phase 6 core copied RR terminals do not share one artifact"
            )
    if shared_descriptor is None:
        raise SystemExit("Phase 6 core copied RR terminal evidence is absent")
    revalidate_rr_runtime_terminal_artifact(
        shared_descriptor, "Phase 6 core copied Gate 5"
    )
    return shared_descriptor

gate5_manifest = strict_object(Path(manifest_value))
if (
    gate5_manifest.get("schema") != "ura-gate5-covered-manifest/1"
    or gate5_manifest.get("inventory_complete") is not True
    or gate5_manifest.get("code_identity") != {
        "expected_commit": expected_commit,
        "framework_lock_id": expected_lock,
    }
):
    raise SystemExit("Phase 6 core copied Gate 5 manifest identity changed")
gate5_rows = gate5_manifest.get("lanes")
if (
    not isinstance(gate5_rows, list)
    or len(gate5_rows) != 46
    or any(not isinstance(row, dict) for row in gate5_rows)
):
    raise SystemExit("Phase 6 core copied Gate 5 lane inventory changed")
gate5_by_lane = {row.get("lane_id"): row for row in gate5_rows}
if (
    len(gate5_by_lane) != 46
    or not set(CORE_CANDIDATE_ORDER) <= set(gate5_by_lane)
):
    raise SystemExit("Phase 6 core copied Gate 5 lane identifiers changed")
validate_rr_runtime_terminals(gate5_by_lane)
defense_gate5 = gate5_by_lane[DEFENSE_LOCAL]
if (
    defense_gate5.get("disposition") == "runnable"
    and defense_gate5.get("family") == "core"
    and defense_gate5.get("reason_code") is None
    and defense_gate5.get("reason") is None
):
    conditional_na_lanes = []
elif defense_gate5.get("disposition") == "conditional_na":
    validate_defense_conditional_terminal(defense_gate5)
    conditional_na_lanes = [DEFENSE_LOCAL]
else:
    raise SystemExit("Phase 6 core copied defense-local disposition changed")
CORE_ORDER = [
    lane
    for lane in CORE_CANDIDATE_ORDER
    if lane not in RR_TERMINAL_LANE_SET and lane not in conditional_na_lanes
]
if len(CORE_ORDER) not in {9, 10}:
    raise SystemExit("Phase 6 core scheduled lane cardinality changed")
for execution_root in (spec_root, control_root / "lanes", attempt_root):
    if execution_root.exists() and any(
        rr_lane in entry.name
        for entry in execution_root.rglob("*")
        for rr_lane in RR_TERMINAL_LANES
    ):
        raise SystemExit(
            "Phase 6 core contains an RR spec, argv, result, root, or reservation"
        )

def write_new(path: Path, payload: bytes) -> None:
    if path.exists() or path.is_symlink():
        raise SystemExit(f"Phase 6 core output is not create-only: {path}")
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, "wb") as handle:
        handle.write(payload)
        handle.flush()
        os.fsync(handle.fileno())

def state_artifact(value: object, label: str) -> dict[str, object]:
    if not isinstance(value, dict) or set(value) != {"path", "sha256"}:
        raise SystemExit(f"{label} state descriptor changed")
    path = Path(str(value.get("path", "")))
    if not path.is_absolute() or path.resolve(strict=True) != path:
        raise SystemExit(f"{label} state locator is not canonical")
    result = descriptor(path)
    if result["sha256"] != value.get("sha256"):
        raise SystemExit(f"{label} state digest changed")
    return result

def state_full_artifact(value: object, label: str) -> dict[str, object]:
    if not isinstance(value, dict) or set(value) != {"path", "sha256", "bytes"}:
        raise SystemExit(f"{label} state descriptor changed")
    result = descriptor(Path(str(value.get("path", ""))))
    if result != value:
        raise SystemExit(f"{label} state descriptor bytes changed")
    return result

with events_path.open(encoding="utf-8", newline="") as handle:
    event_reader = csv.DictReader(handle, delimiter="\t")
    if event_reader.fieldnames != ["attempt", "time_utc", "lane", "stage", "status", "detail"]:
        raise SystemExit("Phase 6 core event-log header changed")
    event_rows = list(event_reader)
if any(None in row or set(row) != set(event_reader.fieldnames) for row in event_rows):
    raise SystemExit("Phase 6 core event-log row shape changed")
attempt_events = [row for row in event_rows if row.get("attempt") == attempt_root.name]
if not attempt_events:
    raise SystemExit("Phase 6 core attempt has no retained controller events")
terminal_events = [
    row for row in attempt_events
    if row.get("stage") == "measured"
    and row.get("status") in {"complete", "complete-existing", "failed"}
]
if len(terminal_events) != len(CORE_ORDER):
    raise SystemExit("Phase 6 core terminal-event cardinality changed")
events_by_lane = {row.get("lane"): row for row in terminal_events}
if len(events_by_lane) != len(terminal_events) or set(events_by_lane) != set(CORE_ORDER):
    raise SystemExit("Phase 6 core terminal-event inventory changed")
start_events = [
    (index, row)
    for index, row in enumerate(attempt_events)
    if row.get("stage") == "lane-attempt" and row.get("status") == "start"
]
if len(start_events) != len(CORE_ORDER) or {row.get("lane") for _, row in start_events} != set(CORE_ORDER):
    raise SystemExit("Phase 6 core independent-attempt inventory changed")
start_index = {row["lane"]: index for index, row in start_events}
terminal_index = {
    row["lane"]: index
    for index, row in enumerate(attempt_events)
    if row.get("stage") == "measured"
    and row.get("status") in {"complete", "complete-existing", "failed"}
}
if any(start_index[lane] >= terminal_index[lane] for lane in CORE_ORDER):
    raise SystemExit("Phase 6 core terminal event precedes its lane attempt")
lane_terminal_states = {
    lane: "failed" if events_by_lane[lane]["status"] == "failed" else "measured_complete"
    for lane in CORE_ORDER
}

spec_paths = sorted(spec_root.glob("*.json"))
if len(spec_paths) != len(CORE_ORDER) or any(path.is_symlink() or not path.is_file() for path in spec_paths):
    raise SystemExit("Phase 6 core lane-spec inventory changed")
specs: dict[str, tuple[Path, dict[str, object]]] = {}
for path in spec_paths:
    spec = strict_object(path)
    lane = spec.get("lane_id")
    if not isinstance(lane, str) or lane in specs:
        raise SystemExit("Phase 6 core lane spec has an invalid or duplicate lane id")
    specs[lane] = (path, spec)
if set(specs) != set(CORE_ORDER):
    raise SystemExit("Phase 6 core lane-spec identifiers changed")

lane_results: dict[str, dict[str, object]] = {}
lane_failures: dict[str, dict[str, object]] = {}
for lane in CORE_ORDER:
    spec_path, spec = specs[lane]
    state_path = control_root / "lanes" / lane / "exact-measured-argv.json"
    spec_descriptor = descriptor(spec_path)
    expected_result_root = (
        Path(os.environ["URA_WORK"]) / "runs" / "thesis" / "runner" / lane
    ).resolve()
    failure_path = attempt_root / f"{lane}.failure.json"
    result_path = attempt_root / f"{lane}.result.json"
    terminal_event = {
        "status": events_by_lane[lane]["status"],
        "detail": events_by_lane[lane]["detail"],
    }
    if lane_terminal_states[lane] == "failed":
        if result_path.exists() or result_path.is_symlink():
            raise SystemExit(f"{lane}: failed lane has a measured result receipt")
        failure = strict_object(failure_path)
        expected_failure_fields = {
            "schema", "status", "lane_id", "attempt", "failed_at_utc",
            "returncode", "stage", "reason_code", "error_type", "error",
            "terminal_event", "lane_spec", "exact_measured_argv",
            "pre_runner_failure", "result_root", "approved_wall_time_seconds",
            "evidence_eligible", "retry_semantics",
            "hosted_target_calls", "hosted_judge_calls",
            "provider_http_attempts", "downloads_observed_bytes",
        }
        wall_time = spec.get("approved_caps", {}).get("wall_time_seconds")
        if wall_time != 86_400:
            raise SystemExit(f"{lane}: approved lane wall-time binding changed")
        timed_out = failure.get("stage") == "approved-wall-time-ceiling"
        expected_reason = (
            "approved_wall_time_exceeded"
            if timed_out
            else "lane_controller_nonzero_exit"
        )
        expected_error_type = (
            "lane_wall_time_exceeded"
            if timed_out
            else "lane_controller_nonzero_exit"
        )
        expected_error = (
            f"lane exceeded approved {wall_time}-second wall-time ceiling; "
            "no measured evidence admitted"
            if timed_out
            else f"lane controller exited {failure.get('returncode')}; "
            "no measured evidence admitted"
        )
        try:
            failed_at = datetime.fromisoformat(
                str(failure.get("failed_at_utc", "")).replace("Z", "+00:00")
            )
        except ValueError as exc:
            raise SystemExit(f"{lane}: failure timestamp is invalid") from exc
        if (
            set(failure) != expected_failure_fields
            or failure.get("schema") != "ura-phase6-core-lane-failure/1"
            or failure.get("status") != "failed"
            or failure.get("lane_id") != lane
            or failure.get("attempt") != attempt_root.name
            or failed_at.tzinfo is None
            or failed_at.utcoffset() != timezone.utc.utcoffset(failed_at)
            or type(failure.get("returncode")) is not int
            or not 1 <= failure["returncode"] <= 255
            or not isinstance(failure.get("stage"), str)
            or not failure["stage"]
            or (timed_out and failure.get("returncode") != 124)
            or failure.get("reason_code") != expected_reason
            or failure.get("error_type") != expected_error_type
            or failure.get("error") != expected_error
            or failure.get("terminal_event") != terminal_event
            or failure.get("terminal_event", {}).get("detail") != failure.get("error")
            or failure.get("lane_spec") != spec_descriptor
            or failure.get("result_root") != str(expected_result_root)
            or failure.get("approved_wall_time_seconds") != wall_time
            or failure.get("evidence_eligible") is not False
            or failure.get("retry_semantics")
            != "next controller attempt revalidates complete Runner state or retries the exact sealed argv"
            or any(
                type(failure.get(field)) is not int or failure.get(field) != 0
                for field in (
                    "hosted_target_calls", "hosted_judge_calls",
                    "provider_http_attempts", "downloads_observed_bytes",
                )
            )
        ):
            raise SystemExit(f"{lane}: typed failure contract changed")
        state_descriptor = failure.get("exact_measured_argv")
        if state_descriptor is None:
            if state_path.exists() or state_path.is_symlink():
                raise SystemExit(f"{lane}: failure omitted its existing sealed argv")
        elif state_full_artifact(state_descriptor, f"{lane} failed exact argv") != descriptor(state_path):
            raise SystemExit(f"{lane}: failed exact argv descriptor changed")
        declared_result_root = Path(str(failure.get("result_root", "")))
        if (
            declared_result_root != expected_result_root
            or declared_result_root.is_symlink()
            or not declared_result_root.is_dir()
            or declared_result_root.resolve(strict=True) != expected_result_root
        ):
            raise SystemExit(f"{lane}: failed lane Runner root is absent or unsafe")
        critical_patterns = (
            "*.grid.json", "*.request-envelope.json", "*.eligibility.json",
            "*.error.json",
        )
        critical_candidates = [
            path
            for pattern in critical_patterns
            for path in declared_result_root.rglob(pattern)
        ]
        if any(path.is_symlink() or not path.is_file() for path in critical_candidates):
            raise SystemExit(f"{lane}: failed lane has an unsafe Runner artifact")
        marker_candidates = sorted(
            declared_result_root.glob(
                ".ura-phase6-pre-runner-failure-*.json"
            )
        )
        if any(path.is_symlink() or not path.is_file() for path in marker_candidates):
            raise SystemExit(f"{lane}: pre-Runner failure marker is unsafe")
        pre_runner_descriptor = failure.get("pre_runner_failure")
        expected_marker = declared_result_root / (
            f".ura-phase6-pre-runner-failure-{attempt_root.name}.json"
        )
        if critical_candidates:
            if pre_runner_descriptor is not None or expected_marker in marker_candidates:
                raise SystemExit(
                    f"{lane}: current pre-Runner marker coexists with Runner lifecycle artifacts"
                )
        else:
            if expected_marker not in marker_candidates:
                raise SystemExit(
                    f"{lane}: exact pre-Runner failure marker is absent"
                )
            observed_marker_descriptor = descriptor(expected_marker)
            if pre_runner_descriptor != observed_marker_descriptor:
                raise SystemExit(
                    f"{lane}: pre-Runner failure descriptor changed"
                )
            marker = strict_object(expected_marker)
            marker_fields = {
                "schema", "status", "artifact_role", "lane_id", "attempt",
                "failed_at_utc", "stage", "reason_code", "error_type", "error",
                "expected_commit", "framework_lock_id", "gate5_manifest_sha256",
                "lane_spec", "exact_measured_argv", "result_root",
                "approved_wall_time_seconds", "runner_lifecycle_artifact_count",
                "runner_artifact", "evidence_eligible",
            }
            if (
                set(marker) != marker_fields
                or marker.get("schema") != "ura-phase6-pre-runner-failure/1"
                or marker.get("status") != "failed"
                or marker.get("artifact_role")
                != "controller_pre_runner_failure_not_runner_artifact"
                or marker.get("lane_id") != lane
                or marker.get("attempt") != attempt_root.name
                or marker.get("failed_at_utc") != failure.get("failed_at_utc")
                or marker.get("stage") != failure.get("stage")
                or marker.get("reason_code") != failure.get("reason_code")
                or marker.get("error_type") != failure.get("error_type")
                or marker.get("error") != failure.get("error")
                or marker.get("expected_commit") != expected_commit
                or marker.get("framework_lock_id") != expected_lock
                or marker.get("gate5_manifest_sha256")
                != spec.get("gate5", {}).get("manifest_sha256")
                or marker.get("lane_spec") != spec_descriptor
                or marker.get("exact_measured_argv") != state_descriptor
                or marker.get("result_root") != str(expected_result_root)
                or marker.get("approved_wall_time_seconds") != wall_time
                or marker.get("runner_lifecycle_artifact_count") != 0
                or marker.get("runner_artifact") is not False
                or marker.get("evidence_eligible") is not False
            ):
                raise SystemExit(f"{lane}: pre-Runner failure marker changed")
        lane_failures[lane] = descriptor(failure_path)
        continue
    if failure_path.exists() or failure_path.is_symlink():
        raise SystemExit(f"{lane}: successful lane has a typed failure artifact")
    state = strict_object(state_path)
    if (
        set(state) != {
            "schema", "lane_spec", "result_root", "probe_root", "live_attestation",
            "attestation_acquisition", "model_acquisition", "runner_argv",
            "resume_semantics",
        }
        or state.get("schema") != "ura-phase6-core-measured-argv/1"
        or state.get("lane_spec") != spec_descriptor
        or state.get("resume_semantics")
        != "invoke_exact_runner_argv_or_accept_strictly_revalidated_complete_runner_grid"
        or not isinstance(state.get("runner_argv"), list)
        or not state["runner_argv"]
    ):
        raise SystemExit(f"{lane}: sealed measured argv changed")
    attestation_descriptor = state_artifact(state.get("live_attestation"), f"{lane} live attestation")

    def completion_acquisition(value: object, label: str) -> tuple[dict, dict, dict]:
        if (
            not isinstance(value, dict)
            or set(value) != {
                "plan", "receipt", "controller_log", "store", "downloaded_bytes",
            }
            or value.get("store") != os.environ["URA_MODEL_STORE"]
            or type(value.get("downloaded_bytes")) is not int
            or value.get("downloaded_bytes") != 0
        ):
            raise SystemExit(f"{lane}: {label} acquisition state changed")
        return (
            state_artifact(value.get("plan"), f"{lane} {label} acquisition plan"),
            state_artifact(value.get("receipt"), f"{lane} {label} acquisition receipt"),
            state_full_artifact(value.get("controller_log"), f"{lane} {label} acquisition log"),
        )

    probe_plan_descriptor, probe_receipt_descriptor, probe_log_descriptor = completion_acquisition(
        state.get("attestation_acquisition"), "attestation"
    )
    acquisition_plan_descriptor, acquisition_receipt_descriptor, acquisition_log_descriptor = completion_acquisition(
        state.get("model_acquisition"), "measured"
    )
    level1_candidates = [
        path
        for path in (
            (
                attempt_root / f"{lane}.adoption-check.level1.json"
                if events_by_lane[lane]["status"] == "complete-existing"
                else attempt_root / f"{lane}.level1.json"
            ),
        )
        if path.exists() or path.is_symlink()
    ]
    if len(level1_candidates) != 1:
        raise SystemExit(f"{lane}: exact validation artifact cardinality changed")
    level1_path = level1_candidates[0]
    level1 = strict_object(level1_path)
    if (
        level1.get("schema_version") != "ura-level1-evidence/3"
        or level1.get("status") != "validated_unit_qualified_lifecycle_inventory"
        or level1.get("scope", {}).get("evidence_kind") != "measured_run"
    ):
        raise SystemExit(f"{lane}: Level 1 validation changed")
    declared_result_root = Path(str(state.get("result_root", "")))
    result_root = declared_result_root.resolve(strict=True)
    expected_result_root = expected_result_root.resolve(strict=True)
    if (
        declared_result_root.is_symlink()
        or declared_result_root != result_root
        or result_root != expected_result_root
        or not result_root.is_dir()
    ):
        raise SystemExit(f"{lane}: result root is unsafe")

    def one(pattern: str) -> Path:
        matches = sorted(result_root.glob(pattern))
        if len(matches) != 1 or matches[0].is_symlink() or not matches[0].is_file():
            raise SystemExit(f"{lane}: expected one safe {pattern}")
        return matches[0]

    grid_path = one("*.grid.json")
    grid = strict_object(grid_path)
    if grid.get("status") != "complete" or grid.get("n_errors") != 0:
        raise SystemExit(f"{lane}: completion grid changed")
    lane_result = {
        "schema": "ura-phase6-core-lane-result/1",
        "status": "complete",
        "lane_id": lane,
        "attempt": attempt_root.name,
        "terminal_event": terminal_event,
        "lane_spec": descriptor(spec_path),
        "exact_measured_argv": descriptor(state_path),
        "live_attestation": attestation_descriptor,
        "attestation_acquisition_plan": probe_plan_descriptor,
        "attestation_acquisition_receipt": probe_receipt_descriptor,
        "attestation_acquisition_log": probe_log_descriptor,
        "model_acquisition_plan": acquisition_plan_descriptor,
        "model_acquisition_receipt": acquisition_receipt_descriptor,
        "model_acquisition_log": acquisition_log_descriptor,
        "level1_evidence": descriptor(level1_path),
        "result_root": str(result_root),
        "grid": descriptor(grid_path),
        "projection": descriptor(one("lane-projection-*.lane-projection.json")),
        "eligibility": descriptor(one("eligibility-*.eligibility.json")),
        "request_envelope": descriptor(one("request-envelope-*.request-envelope.json")),
        "call_budget": descriptor(one("*.budget.json")),
    }
    write_new(result_path, canonical(lane_result))
    lane_results[lane] = descriptor(result_path)

if set(lane_results) & set(lane_failures) or set(lane_results) | set(lane_failures) != set(CORE_ORDER):
    raise SystemExit("Phase 6 core result/failure partition changed")
if {
    lane for lane, state in lane_terminal_states.items() if state == "measured_complete"
} != set(lane_results) or {
    lane for lane, state in lane_terminal_states.items() if state == "failed"
} != set(lane_failures):
    raise SystemExit("Phase 6 core terminal states disagree with artifacts")

snapshot_stream = io.StringIO(newline="")
snapshot_writer = csv.DictWriter(
    snapshot_stream,
    fieldnames=["attempt", "time_utc", "lane", "stage", "status", "detail"],
    delimiter="\t",
    lineterminator="\n",
    extrasaction="raise",
)
snapshot_writer.writeheader()
snapshot_writer.writerows(attempt_events)
snapshot_payload = snapshot_stream.getvalue().encode("utf-8")
if events_snapshot_path.exists() or events_snapshot_path.is_symlink():
    raise SystemExit("Phase 6 core event snapshot is not create-only")
snapshot_fd = os.open(
    events_snapshot_path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600
)
with os.fdopen(snapshot_fd, "wb") as handle:
    handle.write(snapshot_payload)
    handle.flush()
    os.fsync(handle.fileno())

TOP_LEVEL_FIELDS = {
    "schema", "status", "completed_at_utc", "expected_commit",
    "framework_lock_id", "control_root", "attempt_root", "gate5_manifest",
    "gate5_runnote", "gate5_promotion_receipt", "payload", "launch", "events",
    "summary", "contract_self_test", "inventory_complete",
    "all_independent_lanes_attempted", "lane_order", "lane_terminal_states",
    "lane_results", "lane_failures", "conditional_na_lanes", "controller_exit_code",
    "hosted_target_calls", "hosted_judge_calls", "provider_http_attempts",
    "downloads_observed_bytes",
}
DESCRIPTOR_FIELDS = {"path", "sha256", "bytes"}
TOP_DESCRIPTORS = {
    "gate5_manifest", "gate5_runnote", "gate5_promotion_receipt", "payload",
    "launch", "events", "summary", "contract_self_test",
}

def descriptor_shape(value: object) -> bool:
    return (
        isinstance(value, dict)
        and set(value) == DESCRIPTOR_FIELDS
        and isinstance(value.get("path"), str)
        and Path(value["path"]).is_absolute()
        and isinstance(value.get("sha256"), str)
        and len(value["sha256"]) == 64
        and all(char in "0123456789abcdef" for char in value["sha256"])
        and not isinstance(value.get("bytes"), bool)
        and isinstance(value.get("bytes"), int)
        and value["bytes"] > 0
    )

def validate_completion_shape(record: object) -> None:
    if (
        not isinstance(record, dict)
        or set(record) != TOP_LEVEL_FIELDS
        or record.get("schema") != "ura-phase6-core-controller-completion/1"
        or record.get("status") not in {"complete", "complete_with_failures"}
        or record.get("expected_commit") != expected_commit
        or record.get("framework_lock_id") != expected_lock
        or record.get("control_root") != str(control_root)
        or record.get("attempt_root") != str(attempt_root)
        or record.get("inventory_complete") is not True
        or record.get("all_independent_lanes_attempted") is not True
        or record.get("lane_order") != CORE_ORDER
        or record.get("conditional_na_lanes") != conditional_na_lanes
        or not isinstance(record.get("lane_terminal_states"), dict)
        or set(record["lane_terminal_states"]) != set(CORE_ORDER)
        or set(record["lane_terminal_states"].values()) - {"measured_complete", "failed"}
        or not isinstance(record.get("lane_results"), dict)
        or not isinstance(record.get("lane_failures"), dict)
        or any(
            type(record.get(key)) is not int or record.get(key) != 0
            for key in (
                "hosted_target_calls", "hosted_judge_calls",
                "provider_http_attempts", "downloads_observed_bytes",
            )
        )
        or any(not descriptor_shape(record.get(key)) for key in TOP_DESCRIPTORS)
    ):
        raise SystemExit("Phase 6 core completion top-level contract changed")
    try:
        completed_at = datetime.fromisoformat(
            str(record.get("completed_at_utc", "")).replace("Z", "+00:00")
        )
    except ValueError as exc:
        raise SystemExit("Phase 6 core completion timestamp is invalid") from exc
    if completed_at.tzinfo is None or completed_at.utcoffset() != timezone.utc.utcoffset(completed_at):
        raise SystemExit("Phase 6 core completion timestamp is not UTC")
    states = record["lane_terminal_states"]
    results = record["lane_results"]
    failures = record["lane_failures"]
    completed = {lane for lane, state in states.items() if state == "measured_complete"}
    failed = {lane for lane, state in states.items() if state == "failed"}
    expected_status = "complete_with_failures" if failed else "complete"
    expected_exit = 1 if failed else 0
    if (
        set(results) != completed
        or set(failures) != failed
        or set(results) & set(failures)
        or completed | failed != set(CORE_ORDER)
        or record.get("status") != expected_status
        or type(record.get("controller_exit_code")) is not int
        or record.get("controller_exit_code") != expected_exit
        or any(not descriptor_shape(row) for row in results.values())
        or any(not descriptor_shape(row) for row in failures.values())
    ):
        raise SystemExit("Phase 6 core terminal-state/result/failure contract changed")

SUMMARY_FIELDS = {
    "schema", "status", "completed_at_utc", "attempt", "expected_commit",
    "framework_lock_id", "lane_order", "lane_terminal_states",
    "completed_lanes", "failed_lanes", "lane_results", "lane_failures",
    "conditional_na_lanes",
    "contract_self_test", "inventory_complete",
    "all_independent_lanes_attempted", "controller_exit_code",
    "hosted_target_calls", "hosted_judge_calls", "provider_http_attempts",
    "downloads_observed_bytes",
}

def validate_summary_shape(record: object) -> None:
    if (
        not isinstance(record, dict)
        or set(record) != SUMMARY_FIELDS
        or record.get("schema") != "ura-phase6-core-controller-summary/1"
        or record.get("status") not in {"complete", "complete_with_failures"}
        or record.get("attempt") != attempt_root.name
        or record.get("expected_commit") != expected_commit
        or record.get("framework_lock_id") != expected_lock
        or record.get("inventory_complete") is not True
        or record.get("all_independent_lanes_attempted") is not True
        or record.get("lane_order") != CORE_ORDER
        or record.get("conditional_na_lanes") != conditional_na_lanes
        or not isinstance(record.get("lane_terminal_states"), dict)
        or set(record["lane_terminal_states"]) != set(CORE_ORDER)
        or set(record["lane_terminal_states"].values()) - {"measured_complete", "failed"}
        or not isinstance(record.get("lane_results"), dict)
        or not isinstance(record.get("lane_failures"), dict)
        or not isinstance(record.get("completed_lanes"), list)
        or not isinstance(record.get("failed_lanes"), list)
        or not descriptor_shape(record.get("contract_self_test"))
        or any(
            type(record.get(key)) is not int or record.get(key) != 0
            for key in (
                "hosted_target_calls", "hosted_judge_calls",
                "provider_http_attempts", "downloads_observed_bytes",
            )
        )
    ):
        raise SystemExit("Phase 6 core summary top-level contract changed")
    states = record["lane_terminal_states"]
    completed = [lane for lane in CORE_ORDER if states[lane] == "measured_complete"]
    failed = [lane for lane in CORE_ORDER if states[lane] == "failed"]
    expected_status = "complete_with_failures" if failed else "complete"
    expected_exit = 1 if failed else 0
    try:
        summary_time = datetime.fromisoformat(
            str(record.get("completed_at_utc", "")).replace("Z", "+00:00")
        )
    except ValueError as exc:
        raise SystemExit("Phase 6 core summary timestamp is invalid") from exc
    if (
        summary_time.tzinfo is None
        or summary_time.utcoffset() != timezone.utc.utcoffset(summary_time)
        or record.get("completed_lanes") != completed
        or record.get("failed_lanes") != failed
        or set(record["lane_results"]) != set(completed)
        or set(record["lane_failures"]) != set(failed)
        or set(record["lane_results"]) & set(record["lane_failures"])
        or any(not descriptor_shape(row) for row in record["lane_results"].values())
        or any(not descriptor_shape(row) for row in record["lane_failures"].values())
        or record.get("status") != expected_status
        or type(record.get("controller_exit_code")) is not int
        or record.get("controller_exit_code") != expected_exit
    ):
        raise SystemExit("Phase 6 core summary terminal-state parity changed")

def completion_contract_self_test(record: dict[str, object]) -> None:
    validate_completion_shape(record)
    mutations: list[tuple[str, dict[str, object]]] = []
    missing_promotion = copy.deepcopy(record)
    missing_promotion.pop("gate5_promotion_receipt")
    mutations.append(("missing-promotion", missing_promotion))
    missing_lane = copy.deepcopy(record)
    missing_lane["lane_terminal_states"].pop(CORE_ORDER[-1])
    mutations.append(("missing-lane-state", missing_lane))
    wrong_order = copy.deepcopy(record)
    wrong_order["lane_order"][0:2] = reversed(wrong_order["lane_order"][0:2])
    mutations.append(("wrong-lane-order", wrong_order))
    first_result = next(iter(record["lane_results"]), None)
    first_failure = next(iter(record["lane_failures"]), None)
    selected_lane = first_result or first_failure
    selected_inventory = "lane_results" if first_result else "lane_failures"
    wrong_descriptor = copy.deepcopy(record)
    wrong_descriptor[selected_inventory][selected_lane]["sha256"] = "z" * 64
    mutations.append(("bad-descriptor", wrong_descriptor))
    mistyped = copy.deepcopy(record)
    mistyped["lane_terminal_states"][CORE_ORDER[0]] = "partial"
    mutations.append(("mis-typed-state", mistyped))
    overlap = copy.deepcopy(record)
    if first_result:
        overlap["lane_failures"][first_result] = copy.deepcopy(overlap["lane_results"][first_result])
    else:
        overlap["lane_results"][first_failure] = copy.deepcopy(overlap["lane_failures"][first_failure])
    mutations.append(("overlapping-result-failure", overlap))
    status_mismatch = copy.deepcopy(record)
    status_mismatch["status"] = (
        "complete" if record["status"] == "complete_with_failures" else "complete_with_failures"
    )
    mutations.append(("status-mismatch", status_mismatch))
    exit_mismatch = copy.deepcopy(record)
    exit_mismatch["controller_exit_code"] = 1 - record["controller_exit_code"]
    mutations.append(("exit-mismatch", exit_mismatch))
    downloads = copy.deepcopy(record)
    downloads["downloads_observed_bytes"] = 1
    mutations.append(("downloads", downloads))
    bool_zero = copy.deepcopy(record)
    bool_zero["downloads_observed_bytes"] = False
    mutations.append(("bool-zero", bool_zero))
    extra = copy.deepcopy(record)
    extra["unexpected"] = None
    mutations.append(("extra-field", extra))
    wrong_conditional = copy.deepcopy(record)
    wrong_conditional["conditional_na_lanes"] = (
        [] if conditional_na_lanes else [DEFENSE_LOCAL]
    )
    mutations.append(("wrong-conditional-na-lanes", wrong_conditional))
    for label, mutation in mutations:
        try:
            validate_completion_shape(mutation)
        except SystemExit:
            continue
        raise SystemExit(f"Phase 6 core completion mutation was accepted: {label}")

contract_test_path = attempt_root / "contract-self-test.json"
contract_test = strict_object(contract_test_path)
if (
    set(contract_test) != {
        "schema", "status", "mutations_rejected",
        "early_failure_followed_by_later_attempt", "actual_lane_terminal_states",
    }
    or contract_test.get("schema") != "ura-phase6-core-attempt-contract-self-test/1"
    or contract_test.get("status") != "passed"
    or contract_test.get("mutations_rejected") != [
        "missing-terminal", "duplicate-terminal", "mis-typed-state",
        "missing-attempt", "terminal-before-attempt", "status-mismatch",
    ]
    or contract_test.get("early_failure_followed_by_later_attempt") is not True
    or contract_test.get("actual_lane_terminal_states") != lane_terminal_states
):
    raise SystemExit("Phase 6 core attempt contract self-test changed")

completed_lanes = [
    lane for lane in CORE_ORDER
    if lane_terminal_states[lane] == "measured_complete"
]
failed_lanes = [lane for lane in CORE_ORDER if lane_terminal_states[lane] == "failed"]
status = "complete_with_failures" if failed_lanes else "complete"
expected_exit = 1 if failed_lanes else 0
if controller_exit_code != expected_exit:
    raise SystemExit(
        "Phase 6 core aggregate controller exit disagrees with lane terminal states"
    )
completed_at = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
summary_path = attempt_root / "summary.json"
summary = {
    "schema": "ura-phase6-core-controller-summary/1",
    "status": status,
    "completed_at_utc": completed_at,
    "attempt": attempt_root.name,
    "expected_commit": expected_commit,
    "framework_lock_id": expected_lock,
    "lane_order": CORE_ORDER,
    "lane_terminal_states": lane_terminal_states,
    "completed_lanes": completed_lanes,
    "failed_lanes": failed_lanes,
    "lane_results": lane_results,
    "lane_failures": lane_failures,
    "conditional_na_lanes": conditional_na_lanes,
    "contract_self_test": descriptor(contract_test_path),
    "inventory_complete": True,
    "all_independent_lanes_attempted": True,
    "controller_exit_code": controller_exit_code,
    "hosted_target_calls": 0,
    "hosted_judge_calls": 0,
    "provider_http_attempts": 0,
    "downloads_observed_bytes": 0,
}
validate_summary_shape(summary)
summary_mutations = []
summary_status_mismatch = copy.deepcopy(summary)
summary_status_mismatch["status"] = (
    "complete" if status == "complete_with_failures" else "complete_with_failures"
)
summary_mutations.append(("summary-status-mismatch", summary_status_mismatch))
summary_exit_mismatch = copy.deepcopy(summary)
summary_exit_mismatch["controller_exit_code"] = 1 - controller_exit_code
summary_mutations.append(("summary-exit-mismatch", summary_exit_mismatch))
summary_missing_lane = copy.deepcopy(summary)
summary_missing_lane["lane_terminal_states"].pop(CORE_ORDER[-1])
summary_mutations.append(("summary-missing-lane", summary_missing_lane))
summary_wrong_conditional = copy.deepcopy(summary)
summary_wrong_conditional["conditional_na_lanes"] = (
    [] if conditional_na_lanes else [DEFENSE_LOCAL]
)
summary_mutations.append(("summary-wrong-conditional-na-lanes", summary_wrong_conditional))
for label, mutation in summary_mutations:
    try:
        validate_summary_shape(mutation)
    except SystemExit:
        continue
    raise SystemExit(f"Phase 6 core summary mutation was accepted: {label}")
write_new(summary_path, canonical(summary))

value = {
    "schema": "ura-phase6-core-controller-completion/1",
    "status": status,
    "completed_at_utc": completed_at,
    "expected_commit": expected_commit,
    "framework_lock_id": expected_lock,
    "control_root": str(control_root),
    "attempt_root": str(attempt_root),
    "gate5_manifest": descriptor(Path(manifest_value)),
    "gate5_runnote": descriptor(Path(runnote_value)),
    "gate5_promotion_receipt": descriptor(Path(promotion_value)),
    "payload": descriptor(control_root / "payload.sh"),
    "launch": descriptor(Path(launch_value)),
    "events": descriptor(events_snapshot_path),
    "summary": descriptor(summary_path),
    "contract_self_test": descriptor(contract_test_path),
    "inventory_complete": True,
    "all_independent_lanes_attempted": True,
    "lane_order": CORE_ORDER,
    "lane_terminal_states": lane_terminal_states,
    "lane_results": lane_results,
    "lane_failures": lane_failures,
    "conditional_na_lanes": conditional_na_lanes,
    "controller_exit_code": controller_exit_code,
    "hosted_target_calls": 0,
    "hosted_judge_calls": 0,
    "provider_http_attempts": 0,
    "downloads_observed_bytes": 0,
}
completion_contract_self_test(value)
if Path(value["events"]["path"]) != events_snapshot_path.resolve(strict=True):
    raise SystemExit("Phase 6 core completion does not bind its sealed event snapshot")
payload = canonical(value)
if completion_path.exists() or completion_path.is_symlink():
    raise SystemExit("Phase 6 core completion output is not create-only")
fd = os.open(completion_path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
with os.fdopen(fd, "wb") as handle:
    handle.write(payload)
    handle.flush()
    os.fsync(handle.fileno())
directory_fd = os.open(completion_path.parent, os.O_RDONLY)
try:
    os.fsync(directory_fd)
finally:
    os.close(directory_fd)
print(json.dumps({
    "status": status, "schema": value["schema"],
    "completed_lanes": len(completed_lanes), "failed_lanes": len(failed_lanes),
    "controller_exit_code": controller_exit_code,
    "sha256": hashlib.sha256(payload).hexdigest(),
}, sort_keys=True))
PY
if (( aggregate_lane_rc == 0 )); then
  event controller completion-receipt complete \
    "sealed exact ${#SPEC_FILES[@]}-lane Phase 6 core completion receipt"
  printf 'PHASE6_CORE_COMPLETE=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
else
  event controller completion-receipt complete-with-failures \
    "sealed all ${#SPEC_FILES[@]} scheduled independent lanes; failed lanes are typed non-evidence"
  printf 'PHASE6_CORE_COMPLETE_WITH_FAILURES=%s\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
fi
terminal_exit_code="$aggregate_lane_rc"
terminal_completion_written='yes'
exit "$aggregate_lane_rc"
PHASE6_PAYLOAD
  )"
  umask 077
  test ! -e "$PAYLOAD_PATH"
  "$PY" -c '
import os
from pathlib import Path
import sys

path = Path(sys.argv[1])
payload = sys.stdin.buffer.read()
fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o700)
with os.fdopen(fd, "wb") as handle:
    handle.write(payload)
    handle.flush()
    os.fsync(handle.fileno())
' "$PAYLOAD_PATH" <<< "$PAYLOAD"
  test -f "$PAYLOAD_PATH" && test ! -L "$PAYLOAD_PATH"
  test "$(stat -c '%a' -- "$PAYLOAD_PATH")" = '700'
  test "$(stat -c '%h' -- "$PAYLOAD_PATH")" = '1'

  "$PY" - "$CONTROL_ROOT/launch.json" "$EXPECTED_COMMIT" \
    "$EXPECTED_FRAMEWORK_LOCK" "$AUTHORIZED_SHA" "$GATE5_MANIFEST" \
    "$GATE5_RUNNOTE" "$GATE5_PROMOTION" "$CONTROL_ROOT" <<'PY'
import hashlib
import json
import os
from pathlib import Path
import sys

out = Path(sys.argv[1])
manifest = Path(sys.argv[5])
runnote = Path(sys.argv[6])
promotion = Path(sys.argv[7])

def desc(path):
    payload = path.read_bytes()
    return {"path": str(path), "sha256": hashlib.sha256(payload).hexdigest(), "bytes": len(payload)}

value = {
    "schema": "ura-phase6-core-controller-launch/1",
    "expected_commit": sys.argv[2],
    "framework_lock_id": sys.argv[3],
    "manifest_sha256": hashlib.sha256(manifest.read_bytes()).hexdigest(),
    "authorized_manifest_sha256": sys.argv[4],
    "manifest": desc(manifest),
    "runnote": desc(runnote),
    "promotion_receipt": desc(promotion),
    "payload": desc(Path(sys.argv[8]) / "payload.sh"),
    "control_root": sys.argv[8],
}
fd = os.open(out, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
with os.fdopen(fd, "w", encoding="utf-8") as handle:
    json.dump(value, handle, sort_keys=True, separators=(",", ":"), allow_nan=False)
    handle.write("\n")
PY
  LAUNCH_META="$CONTROL_ROOT/launch.json"
fi

ATTEMPT_TAG="$(date -u +%Y%m%dT%H%M%SZ)-$$"
SESSION="ura-phase6-core-${ATTEMPT_TAG}"
SOCKET="ura-phase6-core-${ATTEMPT_TAG}"
test ! -e "$CONTROL_ROOT/attempts/$ATTEMPT_TAG"

tmux -L "$SOCKET" new-session -d -s "$SESSION" \
  "exec env CONTROL_ROOT=$(printf '%q' "$CONTROL_ROOT") ATTEMPT_TAG=$(printf '%q' "$ATTEMPT_TAG") bash $(printf '%q' "$PAYLOAD_PATH")"

printf 'SESSION=%s\n' "$SESSION"
printf 'SOCKET=%s\n' "$SOCKET"
printf 'ATTACH=tmux -L %s attach -t %s\n' "$SOCKET" "$SESSION"
printf 'CONTROL_ROOT=%s\n' "$CONTROL_ROOT"
printf 'ATTEMPT_ROOT=%s/attempts/%s\n' "$CONTROL_ROOT" "$ATTEMPT_TAG"
printf 'LOG=%s/attempts/%s/controller.log\n' "$CONTROL_ROOT" "$ATTEMPT_TAG"
printf 'COMPLETION=%s/attempts/%s/completion.json\n' "$CONTROL_ROOT" "$ATTEMPT_TAG"
printf 'EXIT_MARKER=%s/attempts/%s/.exit\n' "$CONTROL_ROOT" "$ATTEMPT_TAG"
