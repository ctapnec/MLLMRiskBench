#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

usage() {
  echo 'usage: phase5_followon_prepared.sh --inputs JSON --out JSON' >&2
  exit 2
}

INPUTS=''
OUT=''
while (( "$#" )); do
  case "$1" in
    --inputs) INPUTS="$2"; shift 2 ;;
    --out) OUT="$2"; shift 2 ;;
    *) usage ;;
  esac
done
[[ -n "$INPUTS" && -n "$OUT" ]] || usage
source ~/.ura_campaign_env
cd '@@PROJECT_ROOT@@'
test "$(git rev-parse HEAD)" = '@@EXPECTED_COMMIT@@'
test -z "$(git status --porcelain)"

"$PWD/.venv/bin/python" - "$INPUTS" "$OUT" '@@EXPECTED_COMMIT@@' '@@FRAMEWORK_LOCK_SHA256@@' <<'PY'
from __future__ import annotations

