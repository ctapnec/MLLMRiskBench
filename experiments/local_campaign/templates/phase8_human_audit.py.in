                    "eligibility_plan_id": f"eligibility-{index}-{lane}",
                    "eligibility_artifact": artifact("eligibility"),
                    "request_envelope_id": f"request-{index}-{lane}",
                    "request_envelope_artifact": artifact("request"),
                    "selection": {"lane_id": lane},
                    "projected_calls": {
