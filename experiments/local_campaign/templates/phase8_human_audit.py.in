class Phase8Error(RuntimeError):
    """Fail-closed Phase 8 controller error."""


class Interrupted(Phase8Error):
    def __init__(self, exit_code: int) -> None:
        super().__init__(f"Phase 8 interrupted with exit code {exit_code}")
        self.exit_code = exit_code


def utc_now() -> str:
    return dt.datetime.now(dt.timezone.utc).isoformat().replace("+00:00", "Z")


def activate_source_only_imports() -> None:
    """Route all later imports away from ignored source-tree bytecode caches."""

    global _SOURCE_ONLY_CACHE
    if _SOURCE_ONLY_CACHE is None:
        _SOURCE_ONLY_CACHE = tempfile.TemporaryDirectory(
            prefix="ura-phase8-source-only-cache-"
        )
    cache_root = str(Path(_SOURCE_ONLY_CACHE.name).resolve(strict=True))
    sys.pycache_prefix = cache_root
    sys.dont_write_bytecode = True
    os.environ["PYTHONPYCACHEPREFIX"] = cache_root
    os.environ["PYTHONDONTWRITEBYTECODE"] = "1"


def canonical(value: object) -> bytes:
    return (
        json.dumps(
            value,
            sort_keys=True,
            separators=(",", ":"),
            ensure_ascii=True,
            allow_nan=False,
        )
        + "\n"
    ).encode("ascii")


def sha256_bytes(value: bytes) -> str:
    return hashlib.sha256(value).hexdigest()


def sha256_file(path: Path) -> str:
    _, payload = _stable_regular_bytes(
        path, label=f"SHA-256 input {path}", max_bytes=MAX_TEXT_BYTES
    )
    return hashlib.sha256(payload).hexdigest()


def strict_loads(raw: bytes, *, label: str) -> Any:
    def pairs(items: list[tuple[str, Any]]) -> dict[str, Any]:
        result: dict[str, Any] = {}
        for key, value in items:
            if key in result:
                raise Phase8Error(f"{label} contains duplicate JSON key {key!r}")
            result[key] = value
        return result

    def reject_nonfinite(value: str) -> None:
        raise ValueError(f"non-finite JSON number {value}")

    try:
        return json.loads(
            raw.decode("utf-8"),
            object_pairs_hook=pairs,
            parse_constant=reject_nonfinite,
        )
    except (UnicodeDecodeError, json.JSONDecodeError, ValueError) as exc:
        raise Phase8Error(f"{label} is not strict UTF-8 JSON") from exc


def _stable_regular_bytes(
    raw: str | Path, *, label: str, max_bytes: int
) -> tuple[Path, bytes]:
    unresolved = Path(raw).expanduser()
    if not unresolved.is_absolute():
        raise Phase8Error(f"{label} must be one absolute regular file")
    try:
        unresolved_entry = unresolved.lstat()
        if stat.S_ISLNK(unresolved_entry.st_mode):
            raise Phase8Error(f"{label} must not be a symlink")
        path = unresolved.resolve(strict=True)
        before = path.lstat()
        flags = os.O_RDONLY | getattr(os, "O_BINARY", 0)
        flags |= getattr(os, "O_NOFOLLOW", 0)
        fd = os.open(path, flags)
    except Phase8Error:
        raise
    except OSError as exc:
        raise Phase8Error(f"{label} cannot be opened safely") from exc
    try:
        opened = os.fstat(fd)
        if (
            not stat.S_ISREG(unresolved_entry.st_mode)
            or (unresolved_entry.st_dev, unresolved_entry.st_ino)
            != (before.st_dev, before.st_ino)
            or unresolved_entry.st_size != before.st_size
            or unresolved_entry.st_mtime_ns != before.st_mtime_ns
            or not stat.S_ISREG(before.st_mode)
            or not stat.S_ISREG(opened.st_mode)
            or before.st_size < 0
            or before.st_size > max_bytes
            or (before.st_dev, before.st_ino)
            != (opened.st_dev, opened.st_ino)
        ):
            raise Phase8Error(f"{label} is not one bounded regular file")
        chunks: list[bytes] = []
        remaining = before.st_size
        while remaining:
            chunk = os.read(fd, min(1024 * 1024, remaining))
            if not chunk:
                break
            chunks.append(chunk)
            remaining -= len(chunk)
        payload = b"".join(chunks)
        after_fd = os.fstat(fd)
    except Phase8Error:
        raise
    except OSError as exc:
        raise Phase8Error(f"{label} changed while being read") from exc
    finally:
        os.close(fd)
    try:
        after_path = path.lstat()
    except OSError as exc:
        raise Phase8Error(f"{label} changed while being read") from exc
    identity = lambda item: (  # noqa: E731 - compact stat identity projection
        item.st_mode,
        item.st_dev,
        item.st_ino,
        item.st_size,
        item.st_mtime_ns,
    )
    if (
        len(payload) != before.st_size
        or not stat.S_ISREG(after_fd.st_mode)
        or not stat.S_ISREG(after_path.st_mode)
        or identity(before) != identity(opened)
        or identity(opened) != identity(after_fd)
        or identity(after_fd) != identity(after_path)
    ):
        raise Phase8Error(f"{label} changed while being read")
    return path, payload


def strict_object(
    path: Path, *, label: str, max_bytes: int = MAX_JSON_BYTES
) -> dict[str, Any]:
    _path, payload = _stable_regular_bytes(
        path, label=label, max_bytes=max_bytes
    )
    value = strict_loads(payload, label=label)
    if not isinstance(value, dict):
        raise Phase8Error(f"{label} must contain one JSON object")
    return value


def checked_file(
    raw: str | Path,
    *,
    label: str,
    max_bytes: int = MAX_TEXT_BYTES,
) -> Path:
    path = Path(raw).expanduser()
    if not path.is_absolute():
        raise Phase8Error(f"{label} must be an absolute path")
    if path.is_symlink() or not path.is_file():
        raise Phase8Error(f"{label} must be one regular non-symlink file")
    resolved = path.resolve(strict=True)
    info = resolved.stat()
    if not stat.S_ISREG(info.st_mode) or info.st_size > max_bytes:
        raise Phase8Error(f"{label} is not a bounded regular file")
    return resolved


def checked_dir(raw: str | Path, *, label: str) -> Path:
    path = Path(raw).expanduser()
    if not path.is_absolute():
        raise Phase8Error(f"{label} must be absolute")
    if path.is_symlink() or not path.is_dir():
        raise Phase8Error(f"{label} must be one non-symlink directory")
    return path.resolve(strict=True)


def is_beneath(path: Path, root: Path) -> bool:
    try:
        path.relative_to(root)
    except ValueError:
        return False
    return path != root


def descriptor(path: Path) -> dict[str, Any]:
    path, payload = _stable_regular_bytes(
        path, label="descriptor input", max_bytes=MAX_TEXT_BYTES
    )
    return {
        "path": str(path),
        "sha256": hashlib.sha256(payload).hexdigest(),
        "bytes": len(payload),
    }


def descriptor_from_bytes(path: Path, payload: bytes) -> dict[str, Any]:
    return {"path": str(path), "sha256": sha256_bytes(payload), "bytes": len(payload)}


def exact_int(
    value: object,
    *,
    label: str,
    minimum: int = 0,
    maximum: int | None = None,
) -> int:
    if type(value) is not int or value < minimum:
        raise Phase8Error(f"{label} is not an exact integer at or above {minimum}")
    if maximum is not None and value > maximum:
        raise Phase8Error(f"{label} exceeds {maximum}")
    return value


def exact_zero_fields(
    value: Mapping[str, Any], fields: Iterable[str], *, label: str
) -> None:
    for field in fields:
        if type(value.get(field)) is not int or value.get(field) != 0:
            raise Phase8Error(f"{label} reports nonzero or non-integer {field}")


def require_descriptor_identity(
    value: object, *, expected: Mapping[str, Any], label: str
) -> None:
    if not isinstance(value, dict):
        raise Phase8Error(f"{label} descriptor is absent")
    if (
        value.get("sha256") != expected.get("sha256")
        or type(value.get("bytes")) is not int
        or value.get("bytes") != expected.get("bytes")
    ):
        raise Phase8Error(f"{label} is not the frozen executed payload")


def phase6_payload_identity(
    controller: str, *, expected_commit: str, label: str
) -> Mapping[str, Any]:
    if expected_commit == EXPECTED_COMMIT:
        return FROZEN_PHASE6_PAYLOADS[controller]
    retained = RETAINED_PHASE6_PAYLOADS_BY_COMMIT.get(expected_commit, {}).get(
        controller
    )
    if retained is None:
        raise Phase8Error(
            f"{label} has no retained payload identity for {expected_commit}"
        )
    return retained


def descriptor_file(raw: object, *, label: str) -> Path:
    return descriptor_bytes(raw, label=label)[0]


def descriptor_bytes(
    raw: object,
    *,
    label: str,
    max_bytes: int = MAX_TEXT_BYTES,
) -> tuple[Path, bytes]:
    if not isinstance(raw, dict) or set(raw) != {"path", "sha256", "bytes"}:
        raise Phase8Error(f"{label} descriptor fields differ")
    size = raw.get("bytes")
    digest = raw.get("sha256")
    path, payload = _stable_regular_bytes(
        str(raw.get("path", "")), label=label, max_bytes=max_bytes
    )
    if (
        isinstance(size, bool)
        or not isinstance(size, int)
        or size < 0
        or HEX64.fullmatch(str(digest)) is None
        or len(payload) != size
        or hashlib.sha256(payload).hexdigest() != digest
    ):
        raise Phase8Error(f"{label} descriptor does not match exact bytes")
    return path, payload


def descriptor_object(
    raw: object, *, label: str, max_bytes: int = MAX_JSON_BYTES
) -> tuple[Path, dict[str, Any]]:
    path, payload = descriptor_bytes(raw, label=label)
    if len(payload) > max_bytes:
        raise Phase8Error(f"{label} exceeds {max_bytes} bytes")
    value = strict_loads(payload, label=label)
    if not isinstance(value, dict):
        raise Phase8Error(f"{label} must contain one JSON object")
    return path, value


def short_descriptor_file(raw: object, *, label: str) -> Path:
    return short_descriptor_bytes(raw, label=label)[0]


def short_descriptor_bytes(raw: object, *, label: str) -> tuple[Path, bytes]:
    if not isinstance(raw, dict) or set(raw) != {"path", "sha256"}:
        raise Phase8Error(f"{label} short descriptor fields differ")
    path, payload = _stable_regular_bytes(
        str(raw.get("path", "")), label=label, max_bytes=MAX_TEXT_BYTES
    )
    if hashlib.sha256(payload).hexdigest() != raw.get("sha256"):
        raise Phase8Error(f"{label} short descriptor digest differs")
    return path, payload


def short_descriptor_object(
    raw: object, *, label: str, max_bytes: int = MAX_JSON_BYTES
) -> tuple[Path, dict[str, Any]]:
    path, payload = short_descriptor_bytes(raw, label=label)
    if len(payload) > max_bytes:
        raise Phase8Error(f"{label} exceeds {max_bytes} bytes")
    value = strict_loads(payload, label=label)
    if not isinstance(value, dict):
        raise Phase8Error(f"{label} must contain one JSON object")
    return path, value


def extended_descriptor_file(raw: object, *, label: str) -> Path:
    """Validate the Phase 6 extended controller's four-field descriptor."""

    return extended_descriptor_bytes(raw, label=label)[0]


def extended_descriptor_bytes(raw: object, *, label: str) -> tuple[Path, bytes]:
    """Validate and return one Phase 6 extended descriptor observation."""

    if not isinstance(raw, dict) or set(raw) != {"path", "file", "sha256", "bytes"}:
        raise Phase8Error(f"{label} extended descriptor fields differ")
    path, payload = _stable_regular_bytes(
        str(raw.get("path", "")), label=label, max_bytes=MAX_TEXT_BYTES
    )
    size = raw.get("bytes")
    digest = raw.get("sha256")
    if (
        raw.get("file") != path.name
        or isinstance(size, bool)
        or not isinstance(size, int)
        or size < 0
        or HEX64.fullmatch(str(digest)) is None
        or len(payload) != size
        or hashlib.sha256(payload).hexdigest() != digest
    ):
        raise Phase8Error(f"{label} extended descriptor does not match exact bytes")
    return path, payload


def extended_descriptor_object(
    raw: object, *, label: str, max_bytes: int = MAX_JSON_BYTES
) -> tuple[Path, dict[str, Any]]:
    path, payload = extended_descriptor_bytes(raw, label=label)
    if len(payload) > max_bytes:
        raise Phase8Error(f"{label} exceeds {max_bytes} bytes")
    value = strict_loads(payload, label=label)
    if not isinstance(value, dict):
        raise Phase8Error(f"{label} must contain one JSON object")
    return path, value


def write_new(path: Path, payload: bytes, mode: int = 0o600) -> None:
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
    fd = os.open(path, flags, mode)
    try:
        with os.fdopen(fd, "wb") as handle:
            handle.write(payload)
            handle.flush()
            os.fsync(handle.fileno())
    except BaseException:
        try:
            path.unlink()
        except FileNotFoundError:
            pass
        raise


def create_or_match_sensitive_file(
    path: Path, payload: bytes, *, label: str, mode: int = 0o600
) -> bool:
    """Create one sealed file or accept only an identical single-link resume."""

    created = False
    if path.exists() or path.is_symlink():
        existing = checked_file(path, label=f"existing {label}")
        if existing.stat().st_nlink != 1:
            raise Phase8Error(f"{label} has multiple links: {path}")
        if existing.read_bytes() != payload:
            raise Phase8Error(f"{label} differs on resume: {path}")
    else:
        write_new(path, payload, mode=mode)
        created = True
    os.chmod(path, mode)
    if path.stat().st_nlink != 1:
        raise Phase8Error(f"{label} has multiple links: {path}")
    return created


def promote_or_match(source: Path, destination: Path) -> None:
    payload = source.read_bytes()
    create_or_match_sensitive_file(
        destination,
        payload,
        label=f"sensitive Phase 8 artifact {destination.name}",
    )


def git_output(project: Path, *args: str) -> str:
    completed = subprocess.run(
        ["git", "-C", str(project), *args],
        check=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        encoding="utf-8",
    )
    return completed.stdout.strip()


def collect_descriptors(value: object) -> list[dict[str, Any]]:
    found: dict[str, dict[str, Any]] = {}

    def visit(item: object) -> None:
        if isinstance(item, dict):
            if set(item) == {"path", "sha256", "bytes"}:
                normalized = {
                    "path": item["path"],
                    "sha256": item["sha256"],
                    "bytes": item["bytes"],
                }
                path = str(item["path"])
                previous = found.get(path)
                if previous is not None and previous != normalized:
                    raise Phase8Error(f"conflicting descriptors for {path}")
                found[path] = normalized
                return
            for child in item.values():
                visit(child)
        elif isinstance(item, list):
            for child in item:
                visit(child)

    visit(value)
    return [found[key] for key in sorted(found)]


def descriptor_digests(value: object) -> set[str]:
    return {str(row["sha256"]) for row in collect_descriptors(value)}


def read_markdown_json_bytes(payload: bytes, *, label: str) -> dict[str, Any]:
    try:
        text = payload.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise Phase8Error(f"{label} is not UTF-8 text") from exc
    matches = re.findall(r"```json\s*\n(.*?)\n```", text, flags=re.DOTALL)
    if len(matches) != 1:
        raise Phase8Error(f"{label} must contain exactly one JSON block")
    value = strict_loads(matches[0].encode("utf-8"), label=f"{label} JSON block")
    if not isinstance(value, dict):
        raise Phase8Error(f"{label} JSON block must be one object")
    return value


def read_markdown_json(path: Path, *, label: str) -> dict[str, Any]:
    _path, payload = _stable_regular_bytes(
        path, label=label, max_bytes=MAX_TEXT_BYTES
    )
    return read_markdown_json_bytes(payload, label=label)


def _runtime_terminal_descriptor_shape(value: object, *, label: str) -> None:
    if (
        not isinstance(value, dict)
        or set(value) != {"path", "sha256", "bytes"}
        or not isinstance(value.get("path"), str)
        or not Path(value["path"]).is_absolute()
        or HEX64.fullmatch(str(value.get("sha256", ""))) is None
        or type(value.get("bytes")) is not int
        or value["bytes"] <= 0
    ):
        raise Phase8Error(f"{label} descriptor changed")


def _rr_projection_artifact_shapes(
    projection_value: Mapping[str, Any], *, label: str
) -> tuple[dict[str, Any], dict[str, Any], dict[str, Any]]:
    projection = projection_value.get("projection_artifact")
    eligibility = projection_value.get("eligibility_artifact")
    envelope = projection_value.get("request_envelope_artifact")
    if (
        not isinstance(projection, dict)
        or set(projection) != {"path", "file", "sha256", "bytes"}
        or not isinstance(projection.get("file"), str)
        or projection.get("file") != Path(str(projection.get("path", ""))).name
        or not isinstance(eligibility, dict)
        or set(eligibility) != {"path", "sha256", "bytes"}
        or not isinstance(envelope, dict)
        or set(envelope)
        != {"path", "envelope_id", "file", "sha256", "bytes"}
        or not isinstance(envelope.get("file"), str)
        or envelope.get("file") != Path(str(envelope.get("path", ""))).name
        or envelope.get("envelope_id")
        != projection_value.get("request_envelope_id")
    ):
        raise Phase8Error(f"{label} RR projection artifact descriptor changed")
    _runtime_terminal_descriptor_shape(
        {key: projection[key] for key in ("path", "sha256", "bytes")},
        label=f"{label} RR projection artifact",
    )
    _runtime_terminal_descriptor_shape(
        eligibility, label=f"{label} RR eligibility artifact"
    )
    _runtime_terminal_descriptor_shape(
        {key: envelope[key] for key in ("path", "sha256", "bytes")},
        label=f"{label} RR request-envelope artifact",
    )
    return projection, eligibility, envelope


def _lane_projection_from_bytes(
    path: Path, payload: bytes, *, expected_sha256: str, label: str
) -> tuple[dict[str, Any], dict[str, object]]:
    try:
        from ura.lane_projection import lane_projection_bytes, validate_lane_projection
    except Exception as exc:  # noqa: BLE001 - deployed projection boundary
        raise Phase8Error("cannot import lane-projection validators") from exc
    if (
        not payload
        or len(payload) > 4 * 1024 * 1024
        or hashlib.sha256(payload).hexdigest() != expected_sha256
    ):
        raise Phase8Error(f"{label} byte identity changed")
    projection = validate_lane_projection(strict_loads(payload, label=label))
    if (
        payload != lane_projection_bytes(projection)
        or path.name != f"{projection['projection_id']}.lane-projection.json"
    ):
        raise Phase8Error(f"{label} canonical content identity changed")
    return projection, {
        "file": path.name,
        "sha256": expected_sha256,
        "bytes": len(payload),
    }


def _request_envelope_from_bytes(
    path: Path, payload: bytes, *, label: str
) -> tuple[dict[str, Any], dict[str, object]]:
    try:
        from ura.request_envelope import request_envelope_bytes, validate_request_envelope
    except Exception as exc:  # noqa: BLE001 - deployed request-envelope boundary
        raise Phase8Error("cannot import request-envelope validators") from exc
    if not payload or len(payload) > 4 * 1024 * 1024:
        raise Phase8Error(f"{label} is empty or exceeds its size limit")
    envelope = validate_request_envelope(strict_loads(payload, label=label))
    if (
        payload != request_envelope_bytes(envelope)
        or path.name != f"{envelope['envelope_id']}.request-envelope.json"
    ):
        raise Phase8Error(f"{label} canonical content identity changed")
    return envelope, {
        "envelope_id": envelope["envelope_id"],
        "file": path.name,
        "sha256": hashlib.sha256(payload).hexdigest(),
        "bytes": len(payload),
    }


def _validate_rr_projection_artifact_binding(
    projection_value: Mapping[str, Any], *, label: str
) -> None:
    projection_descriptor, eligibility_descriptor, envelope_descriptor = (
        _rr_projection_artifact_shapes(projection_value, label=label)
    )
    try:
        from ura.eligibility import validate_eligibility_plan
        from ura.lane_projection import validate_lane_projection_binding

        projection_path, projection_payload = descriptor_bytes(
            {
                key: projection_descriptor[key]
                for key in ("path", "sha256", "bytes")
            },
            label=f"{label} RR projection artifact",
        )
        projection, observed_projection = _lane_projection_from_bytes(
            projection_path,
            projection_payload,
            expected_sha256=projection_descriptor["sha256"],
            label=f"{label} RR projection artifact",
        )
        if (
            projection_descriptor
            != {"path": str(projection_path), **observed_projection}
            or projection.get("projection_id")
            != projection_value.get("projection_id")
            or projection.get("selection") != projection_value.get("selection")
        ):
            raise Phase8Error(f"{label} RR projection content identity changed")

        eligibility_path, eligibility_payload = descriptor_bytes(
            eligibility_descriptor, label=f"{label} RR eligibility artifact"
        )
        if eligibility_descriptor["path"] != str(eligibility_path):
            raise Phase8Error(f"{label} RR eligibility path is not canonical")
        eligibility_value = strict_loads(
            eligibility_payload, label=f"{label} RR eligibility artifact"
        )
        if not isinstance(eligibility_value, dict):
            raise Phase8Error(f"{label} RR eligibility is not one object")
        eligibility = validate_eligibility_plan(eligibility_value)
        eligibility_records = sum(
            1
            for line in eligibility_payload.decode("utf-8").splitlines()
            if line.strip()
        )
        validate_lane_projection_binding(
            projection,
            eligibility_plan=eligibility,
            eligibility_artifact={
                "file": eligibility_path.name,
                "sha256": eligibility_descriptor["sha256"],
                "bytes": eligibility_descriptor["bytes"],
                "records": eligibility_records,
            },
        )
        if eligibility.get("plan_id") != projection_value.get("eligibility_plan_id"):
            raise Phase8Error(f"{label} RR eligibility identity changed")

        envelope_path, envelope_payload = descriptor_bytes(
            {
                key: envelope_descriptor[key]
                for key in ("path", "sha256", "bytes")
            },
            label=f"{label} RR request-envelope artifact",
        )
        envelope, observed_envelope = _request_envelope_from_bytes(
            envelope_path,
            envelope_payload,
            label=f"{label} RR request-envelope artifact",
        )
        if (
            envelope_descriptor != {"path": str(envelope_path), **observed_envelope}
            or envelope.get("envelope_id")
            != projection_value.get("request_envelope_id")
            or eligibility.get("bindings", {}).get("request_envelope")
            != observed_envelope
        ):
            raise Phase8Error(f"{label} RR request-envelope identity changed")

        calls = projection.get("call_projection", {})
        if projection_value.get("projected_calls") != {
            "trajectories": calls.get("trajectories"),
            "target_calls": calls.get("target_calls"),
            "model_judge_calls": calls.get("judge_calls"),
            "local_guardrail_evaluations": calls.get(
                "local_guardrail_evaluations"
            ),
            "http_attempts": calls.get("http_attempts"),
        }:
            raise Phase8Error(f"{label} RR projected-call artifact binding changed")
    except Phase8Error:
        raise
    except Exception as exc:  # noqa: BLE001 - normalize strict artifact failures
        raise Phase8Error(f"{label} RR projection artifact validation failed") from exc


def _validate_rr_runtime_project_continuity(
    terminal_descriptor: Mapping[str, Any] | None,
    *,
    project_root: Path,
    covered_commit: str,
    label: str,
) -> None:
    if terminal_descriptor is None:
        return
    _artifact_path, artifact_payload = descriptor_bytes(
        terminal_descriptor,
        label=f"{label} shared RR runtime terminal artifact",
    )
    artifact = strict_loads(
        artifact_payload, label=f"{label} shared RR runtime terminal artifact"
    )
    if not isinstance(artifact, dict):
        raise Phase8Error(f"{label} shared RR runtime terminal is not one object")
    target = artifact.get("target")
    local_config = target.get("local_config") if isinstance(target, dict) else None
    _runtime_terminal_descriptor_shape(
        local_config, label=f"{label} RR local config"
    )
    local_config_path, local_config_payload = descriptor_bytes(
        local_config, label=f"{label} RR local config"
    )
    expected_config_path = (
        project_root / "experiments" / "local-llava-rr.json"
    ).resolve(strict=True)
    if (
        local_config_path != expected_config_path
        or local_config.get("sha256") != RR_LOCAL_CONFIG_SHA256
        or local_config.get("bytes") != RR_LOCAL_CONFIG_BYTES
    ):
        raise Phase8Error(f"{label} RR local config identity changed")
    document = strict_loads(
        local_config_payload, label=f"{label} RR local config"
    )
    if not isinstance(document, dict):
        raise Phase8Error(f"{label} RR local config is not one object")
    source = document.get(RR_TARGET_SPEC)
    expected_source = {
        "revision": "d11b3d7ae2fb21e984f197a83c15bbb0deb66b7e",
        "modalities": ["text", "image"],
        "max_tokens": 4096,
        "gpu_memory_utilization": 0.85,
        "tensor_parallel_size": 1,
    }
    if (
        set(document) != {RR_TARGET_SPEC}
        or source != expected_source
        or not isinstance(source, dict)
        or type(source.get("max_tokens")) is not int
        or type(source.get("gpu_memory_utilization")) is not float
        or type(source.get("tensor_parallel_size")) is not int
    ):
        raise Phase8Error(f"{label} RR local config content changed")
    continuity = artifact.get("bindings", {}).get("semantic_source_continuity")
    if (
        not isinstance(continuity, dict)
        or continuity.get("observed_project_commit")
        != RR_OBSERVED_PROJECT_COMMIT
        or git_output(
            project_root,
            "diff",
            "--name-only",
            RR_OBSERVED_PROJECT_COMMIT,
            covered_commit,
            "--",
            "src/ura/targets/local.py",
            "experiments/run_matrix.py",
        )
    ):
        raise Phase8Error(f"{label} RR semantic-source continuity is stale")


def _validate_rr_runtime_terminal_tree(value: object, *, label: str) -> Path:
    if (
        not isinstance(value, dict)
        or set(value) != {"path", "sha256", "bytes", "files"}
        or not isinstance(value.get("path"), str)
        or not Path(value["path"]).is_absolute()
        or HEX64.fullmatch(str(value.get("sha256", ""))) is None
        or type(value.get("bytes")) is not int
        or value["bytes"] < 0
        or type(value.get("files")) is not int
        or value["files"] <= 0
    ):
        raise Phase8Error(f"{label} evidence-root descriptor changed")
    root = checked_dir(value["path"], label=label)
    if root != Path(value["path"]):
        raise Phase8Error(f"{label} evidence-root path is not canonical")
    root_before = root.lstat()
    files: list[tuple[str, Path]] = []
    members_before: dict[str, tuple[int, int, int, int, int]] = {}
    for candidate in root.rglob("*"):
        try:
            entry = candidate.lstat()
        except OSError as exc:
            raise Phase8Error(f"{label} evidence member cannot be inspected") from exc
        if stat.S_ISLNK(entry.st_mode):
            raise Phase8Error(f"{label} evidence root contains a symlink")
        if candidate.resolve(strict=True) != candidate:
            raise Phase8Error(f"{label} evidence member is not canonical")
        relative = candidate.relative_to(root).as_posix()
        members_before[relative] = (
            entry.st_mode,
            entry.st_dev,
            entry.st_ino,
            entry.st_size,
            entry.st_mtime_ns,
        )
        if stat.S_ISDIR(entry.st_mode):
            continue
        if not stat.S_ISREG(entry.st_mode):
            raise Phase8Error(f"{label} evidence root contains a non-file")
        files.append((relative, candidate))
    files.sort(key=lambda item: item[0])
    digest = hashlib.sha256()
    total = 0
    for relative, path in files:
        observed_path, payload = _stable_regular_bytes(
            path,
            label=f"{label} evidence member {relative}",
            max_bytes=max(value["bytes"], 1),
        )
        if observed_path != path:
            raise Phase8Error(f"{label} evidence member changed while reading")
        size = len(payload)
        digest.update(relative.encode("utf-8"))
        digest.update(b"\0")
        digest.update(str(size).encode("ascii"))
        digest.update(b"\0")
        digest.update(hashlib.sha256(payload).hexdigest().encode("ascii"))
        digest.update(b"\n")
        total += size
    members_after: dict[str, tuple[int, int, int, int, int]] = {}
    for candidate in root.rglob("*"):
        try:
            entry = candidate.lstat()
        except OSError as exc:
            raise Phase8Error(f"{label} evidence member cannot be reinspected") from exc
        if stat.S_ISLNK(entry.st_mode):
            raise Phase8Error(f"{label} evidence root contains a symlink")
        if (
            not stat.S_ISDIR(entry.st_mode)
            and not stat.S_ISREG(entry.st_mode)
        ):
            raise Phase8Error(f"{label} evidence root contains a non-file")
        if candidate.resolve(strict=True) != candidate:
            raise Phase8Error(f"{label} evidence member is not canonical")
        members_after[candidate.relative_to(root).as_posix()] = (
            entry.st_mode,
            entry.st_dev,
            entry.st_ino,
            entry.st_size,
            entry.st_mtime_ns,
        )
    root_after = root.lstat()
    if (
        members_after != members_before
        or not stat.S_ISDIR(root_after.st_mode)
        or (root_before.st_dev, root_before.st_ino, root_before.st_mtime_ns)
        != (root_after.st_dev, root_after.st_ino, root_after.st_mtime_ns)
    ):
        raise Phase8Error(f"{label} evidence root changed while reading")
    if (
        value["files"] != len(files)
        or value["bytes"] != total
        or value["sha256"] != digest.hexdigest()
    ):
        raise Phase8Error(f"{label} evidence-root tree identity changed")
    return root


def _validate_rr_runtime_terminal_rows(
    rows: Mapping[str, Mapping[str, Any]],
    *,
    label: str,
    validate_artifact: bool,
    expected_code_identity: Mapping[str, Any] | None = None,
) -> dict[str, Any] | None:
    if not RR_RUNTIME_TERMINAL_LANES:
        if set(HISTORICAL_RR_RUNTIME_TERMINAL_LANES) & set(rows):
            raise Phase8Error(
                f"{label} contains obsolete GraySwan runtime-terminal evidence"
            )
        return None
    unavailable = {"status": "UNAVAILABLE", "value": None}
    expected_row_fields = {
        "lane_id", "family", "disposition", "reason_code", "reason",
        "projection", "canary", "final_preflight", "approved_caps",
    }
    shared: dict[str, Any] | None = None
    projections: list[dict[str, Any]] = []
    for lane in RR_RUNTIME_TERMINAL_LANES:
        row = rows.get(lane)
        canary = row.get("canary") if isinstance(row, Mapping) else None
        projection = row.get("projection") if isinstance(row, Mapping) else None
        projection_value = (
            projection.get("value") if isinstance(projection, Mapping) else None
        )
        if (
            not isinstance(row, dict)
            or set(row) != expected_row_fields
            or row.get("lane_id") != lane
            or row.get("family") != "core"
            or row.get("disposition") != "unavailable"
            or row.get("reason_code") != RR_RUNTIME_TERMINAL_REASON_CODE
            or row.get("reason") != RR_RUNTIME_TERMINAL_REASON
            or not isinstance(projection, dict)
            or set(projection) != {"status", "value"}
            or projection.get("status") != "passed"
            or not isinstance(projection_value, dict)
            or set(projection_value)
            != {
                "projection_id", "projection_artifact", "eligibility_plan_id",
                "eligibility_artifact", "request_envelope_id",
                "request_envelope_artifact", "selection", "projected_calls",
            }
            or row.get("final_preflight") != unavailable
            or row.get("approved_caps") != unavailable
            or not isinstance(canary, dict)
            or set(canary)
            != {"status", "value", "target_runtime_terminal_artifact"}
            or canary.get("status") != "UNAVAILABLE"
            or canary.get("value") is not None
        ):
            raise Phase8Error(f"{label} RR runtime terminal row changed: {lane}")
        for identity in (
            "projection_id", "eligibility_plan_id", "request_envelope_id"
        ):
            if (
                not isinstance(projection_value.get(identity), str)
                or not projection_value[identity].strip()
            ):
                raise Phase8Error(f"{label} RR projection identity changed: {lane}")
        _rr_projection_artifact_shapes(
            projection_value, label=f"{label} RR projection {lane}"
        )
        calls = projection_value.get("projected_calls")
        if (
            not isinstance(projection_value.get("selection"), dict)
            or not projection_value["selection"]
            or not isinstance(calls, dict)
            or set(calls)
            != {
                "trajectories", "target_calls", "model_judge_calls",
                "local_guardrail_evaluations", "http_attempts",
            }
            or any(
                type(calls.get(field)) is not int or calls[field] < 0
                for field in calls
            )
            or calls["trajectories"] <= 0
            or calls["target_calls"] <= 0
            or calls["model_judge_calls"] != 0
            or calls["http_attempts"] != 0
        ):
            raise Phase8Error(f"{label} RR projection accounting changed: {lane}")
        if validate_artifact:
            _validate_rr_projection_artifact_binding(
                projection_value, label=f"{label} RR projection {lane}"
            )
        projections.append(dict(projection_value))
        terminal_descriptor = canary.get("target_runtime_terminal_artifact")
        _runtime_terminal_descriptor_shape(
            terminal_descriptor, label=f"{label} RR terminal {lane}"
        )
        if shared is None:
            shared = dict(terminal_descriptor)
        elif terminal_descriptor != shared:
            raise Phase8Error(f"{label} RR terminal evidence descriptors differ")
    if shared is None:
        raise Phase8Error(f"{label} RR terminal evidence is absent")
    if any(
        projections[left] == projections[right]
        for left in range(len(projections))
        for right in range(left + 1, len(projections))
    ):
        raise Phase8Error(f"{label} RR projections are not lane-specific")
    if not validate_artifact:
        return shared

    _artifact_path, artifact_payload = descriptor_bytes(
        shared, label=f"{label} RR runtime terminal artifact"
    )
    artifact = strict_loads(
        artifact_payload, label=f"{label} RR runtime terminal artifact"
    )
    if not isinstance(artifact, dict):
        raise Phase8Error(f"{label} RR runtime terminal is not one object")
    if set(artifact) != {
        "schema", "status", "disposition", "reason_code", "reason",
        "classified_at_utc", "target", "bindings", "observations",
        "call_accounting", "applies_to_lanes", "evidence_eligible",
    }:
        raise Phase8Error(f"{label} RR runtime terminal artifact fields changed")
    target = artifact.get("target")
    bindings = artifact.get("bindings")
    observations = artifact.get("observations")
    accounting = artifact.get("call_accounting")
    evidence_keys = {
        "text_vllm_4096", "image_vllm_4096", "vllm_token_tail_512",
        "transformers_reference_512",
    }
    if (
        artifact.get("schema") != RR_RUNTIME_TERMINAL_SCHEMA
        or artifact.get("status") != "unavailable"
        or artifact.get("disposition") != "unavailable"
        or artifact.get("reason_code") != RR_RUNTIME_TERMINAL_REASON_CODE
        or artifact.get("reason") != RR_RUNTIME_TERMINAL_REASON
        or UTC_RE.fullmatch(str(artifact.get("classified_at_utc", ""))) is None
        or artifact.get("applies_to_lanes")
        != list(HISTORICAL_RR_RUNTIME_TERMINAL_ARTIFACT_LANES)
        or artifact.get("evidence_eligible") is not False
        or not isinstance(target, dict)
        or set(target)
        != {
            "spec", "model", "revision", "resource_id", "runtime",
            "runtime_version", "modalities", "configured_max_tokens",
            "local_config",
        }
        or target.get("spec") != RR_TARGET_SPEC
        or target.get("model") != RR_TARGET_MODEL
        or target.get("revision") != "d11b3d7ae2fb21e984f197a83c15bbb0deb66b7e"
        or target.get("resource_id") != "hf-400da4b35ea290e28fcce5f33f8d4090"
        or target.get("runtime") != "vllm"
        or target.get("runtime_version") != "0.27.1"
        or target.get("modalities") != ["text", "image"]
        or type(target.get("configured_max_tokens")) is not int
        or target.get("configured_max_tokens") != 4096
        or not isinstance(bindings, dict)
        or set(bindings)
        != {
            "classification_project_commit", "framework_lock_sha256",
            "project_revision", "semantic_source_continuity", "evidence_roots",
        }
        or re.fullmatch(
            r"[0-9a-f]{40}",
            str(bindings.get("classification_project_commit", "")),
        )
        is None
        or HEX64.fullmatch(str(bindings.get("framework_lock_sha256", "")))
        is None
        or not isinstance(observations, dict)
        or set(observations) != evidence_keys
    ):
        raise Phase8Error(f"{label} RR runtime terminal artifact changed")
    artifact_code_identity = {
        "expected_commit": bindings["classification_project_commit"],
        "framework_lock_id": bindings["framework_lock_sha256"],
    }
    if expected_code_identity is not None and artifact_code_identity != (
        _require_code_identity(expected_code_identity, label=label)
    ):
        raise Phase8Error(f"{label} RR runtime terminal code identity differs")
    for raw in (target.get("local_config"), bindings.get("project_revision")):
        _runtime_terminal_descriptor_shape(raw, label=f"{label} RR binding")
        descriptor_file(raw, label=f"{label} RR binding")
    _project_path, project_payload = descriptor_bytes(
        bindings["project_revision"], label=f"{label} RR project revision"
    )
    project_receipt = strict_loads(
        project_payload, label=f"{label} RR project revision"
    )
    project_repository = (
        project_receipt.get("repository")
        if isinstance(project_receipt, dict)
        else None
    )
    if (
        not isinstance(project_repository, dict)
        or project_repository.get("expected_commit")
        != artifact_code_identity["expected_commit"]
        or project_repository.get("observed_commit")
        != artifact_code_identity["expected_commit"]
        or project_repository.get("clean") is not True
    ):
        raise Phase8Error(f"{label} RR project-revision binding changed")
    continuity = bindings.get("semantic_source_continuity")
    roots = bindings.get("evidence_roots")
    if (
        continuity
        != {
            "observed_project_commit": RR_OBSERVED_PROJECT_COMMIT,
            "unchanged_paths": [
                "src/ura/targets/local.py", "experiments/run_matrix.py"
            ],
            "git_diff_empty": True,
        }
        or not isinstance(roots, dict)
        or set(roots) != evidence_keys
    ):
        raise Phase8Error(f"{label} RR evidence bindings changed")
    resolved_roots = {
        name: _validate_rr_runtime_terminal_tree(
            roots[name], label=f"{label} RR {name}"
        )
        for name in sorted(evidence_keys)
    }
    text = observations["text_vllm_4096"]
    image = observations["image_vllm_4096"]
    tail = observations["vllm_token_tail_512"]
    reference = observations["transformers_reference_512"]
    if (
        not isinstance(text, dict)
        or set(text)
        != {
            "modality", "corpus", "sample_seeds", "max_tokens",
            "finish_reasons", "stop_reasons", "successful_responses",
            "error_artifacts",
        }
        or text.get("modality") != "text"
        or text.get("corpus") != "strongreject_official"
        or text.get("sample_seeds") != [0, 1, 8]
        or text.get("max_tokens") != 4096
        or text.get("finish_reasons") != ["length", "length", "length"]
        or text.get("stop_reasons") != [None, None, None]
        or text.get("successful_responses") != 0
        or not isinstance(text.get("error_artifacts"), list)
        or len(text["error_artifacts"]) != 3
        or not isinstance(image, dict)
        or set(image)
        != {
            "modality", "corpus", "sample_seed", "max_tokens",
            "finish_reason", "stop_reason", "successful_responses",
            "error_artifact",
        }
        or image.get("modality") != "image"
        or image.get("corpus") != "harmbench_multimodal"
        or image.get("sample_seed") != 1
        or image.get("max_tokens") != 4096
        or image.get("finish_reason") != "length"
        or image.get("stop_reason") is not None
        or image.get("successful_responses") != 0
    ):
        raise Phase8Error(f"{label} RR vLLM observations changed")
    for raw in text["error_artifacts"]:
        _runtime_terminal_descriptor_shape(raw, label=f"{label} RR error evidence")
        error_path = descriptor_file(raw, label=f"{label} RR error evidence")
        if not is_beneath(error_path, resolved_roots["text_vllm_4096"]):
            raise Phase8Error(f"{label} RR text error escaped its evidence root")
    image_error = image.get("error_artifact")
    _runtime_terminal_descriptor_shape(
        image_error, label=f"{label} RR image error evidence"
    )
    image_error_path = descriptor_file(
        image_error, label=f"{label} RR image error evidence"
    )
    if not is_beneath(image_error_path, resolved_roots["image_vllm_4096"]):
        raise Phase8Error(f"{label} RR image error escaped its evidence root")
    if (
        not isinstance(tail, dict)
        or set(tail)
        != {
            "probe_schema", "max_tokens", "prompt_tokens", "completion_tokens",
            "finish_reason", "stop_reason", "unique_completion_tokens",
            "most_common_token_counts", "special_token_ids",
            "special_token_counts", "text_sha256", "probe_log",
        }
        or tail.get("probe_schema") != "ura-engineering-token-tail-probe/1"
        or tail.get("max_tokens") != 512
        or tail.get("prompt_tokens") != 21
        or tail.get("completion_tokens") != 512
        or tail.get("finish_reason") != "length"
        or tail.get("stop_reason") is not None
        or tail.get("unique_completion_tokens") != 2
        or tail.get("most_common_token_counts") != [[644, 501], [22627, 11]]
        or tail.get("special_token_ids")
        != {"bos": 1, "eos": 2, "pad": 32001, "unk": 0}
        or tail.get("special_token_counts")
        != {"bos": 0, "eos": 0, "pad": 0, "unk": 0}
        or tail.get("text_sha256")
        != "277aada87524bc3de88d8b7286ea6653a7b36a94ba08d2ab7211411f9cb6ebdb"
        or not isinstance(reference, dict)
        or set(reference)
        != {"probe_schema", "generation", "base", "rr", "probe_log"}
        or reference.get("probe_schema")
        != "ura-engineering-transformers-termination-probe/1"
        or reference.get("generation")
        != {"backend": "transformers", "do_sample": False, "max_new_tokens": 512, "seed": 0}
        or reference.get("base")
        != {
            "label": "base",
            "resource_id": "hf-d9e60d9f6c16de2e8fb9d9e08389c44a",
            "prompt_tokens": 20,
            "completion_tokens": 226,
            "last_token_is_eos": True,
            "eos_token_id": 2,
            "eos_token_count": 1,
            "text_sha256": "7d966860772f8185567a9c1742536f823a49facfadaae6847a97069ddc011499",
        }
        or reference.get("rr")
        != {
            "label": "rr",
            "resource_id": "hf-400da4b35ea290e28fcce5f33f8d4090",
            "prompt_tokens": 20,
            "completion_tokens": 512,
            "last_token_is_eos": False,
            "eos_token_id": 2,
            "eos_token_count": 0,
            "unique_completion_tokens": 2,
            "most_common_token_counts": [[644, 503], [22627, 9]],
            "text_sha256": "1f8e655ab40cbcd5a5ef23839d6845bd7aaa24ce7d693cfb29b077af590d1bbf",
        }
    ):
        raise Phase8Error(f"{label} RR diagnostic control changed")
    for root_name, raw in (
        ("vllm_token_tail_512", tail.get("probe_log")),
        ("transformers_reference_512", reference.get("probe_log")),
    ):
        _runtime_terminal_descriptor_shape(raw, label=f"{label} RR probe log")
        probe_path = descriptor_file(raw, label=f"{label} RR probe log")
        if (
            probe_path.name != "probe.log"
            or probe_path.parent != resolved_roots[root_name]
        ):
            raise Phase8Error(f"{label} RR probe-log location changed")
    if (
        not isinstance(accounting, dict)
        or set(accounting)
        != {
            "accounting_semantics", "runner_target_call_reservations",
            "vllm_diagnostic_generations", "transformers_reference_generations",
            "successful_rr_responses", "hosted_target_calls",
            "model_judge_calls", "local_guardrail_evaluations",
            "hosted_judge_calls", "http_attempts",
        }
        or accounting
        != {
            "accounting_semantics": "durable_pre_call_logical_reservation_v1",
            "runner_target_call_reservations": 4,
            "vllm_diagnostic_generations": 1,
            "transformers_reference_generations": 2,
            "successful_rr_responses": 0,
            "hosted_target_calls": 0,
            "model_judge_calls": 0,
            "local_guardrail_evaluations": 0,
            "hosted_judge_calls": 0,
            "http_attempts": 0,
        }
    ):
        raise Phase8Error(f"{label} RR terminal accounting changed")
    return shared


def exact_json_contract(left: object, right: object) -> bool:
    if type(left) is not type(right):
        return False
    if isinstance(right, dict):
        return set(left) == set(right) and all(
            exact_json_contract(left[key], right[key]) for key in right
        )
    if isinstance(right, list):
        return len(left) == len(right) and all(
            exact_json_contract(a, b) for a, b in zip(left, right)
        )
    return left == right


def _require_code_identity(value: object, *, label: str) -> dict[str, str]:
    if (
        not isinstance(value, dict)
        or set(value) != {"expected_commit", "framework_lock_id"}
        or re.fullmatch(r"[0-9a-f]{40}", str(value.get("expected_commit", "")))
        is None
        or HEX64.fullmatch(str(value.get("framework_lock_id", ""))) is None
    ):
        raise Phase8Error(f"{label} code identity is invalid")
    return {
        "expected_commit": value["expected_commit"],
        "framework_lock_id": value["framework_lock_id"],
    }


def _validate_conditional_defense_row(
    row: object,
    *,
    label: str,
    validate_artifact: bool = True,
    expected_code_identity: Mapping[str, Any] | None = None,
) -> None:
    typed_na = {"status": "N/A", "value": None}
    if not isinstance(row, dict) or set(row) != {
        "lane_id",
        "family",
        "disposition",
        "reason_code",
        "reason",
        "projection",
        "canary",
        "final_preflight",
        "approved_caps",
    }:
        raise Phase8Error(f"{label} conditional defense row fields changed")
    canary = row.get("canary")
    if (
        row.get("lane_id") != DEFENSE_LOCAL_LANE
        or row.get("family") != "core"
        or row.get("disposition") != "conditional_na"
        or row.get("projection") != typed_na
        or row.get("final_preflight") != typed_na
        or row.get("approved_caps") != typed_na
        or not isinstance(canary, dict)
        or set(canary)
        != {"status", "value", "conditional_na_artifact", "call_accounting"}
        or canary.get("status") != "N/A"
        or canary.get("value") is not None
    ):
        raise Phase8Error(f"{label} conditional defense row changed")
    row_variants = [
        variant for variant in DEFENSE_LOCAL_CONDITIONAL_VARIANTS.values()
        if row.get("reason_code") == variant["reason_code"]
        and row.get("reason") == variant["reason"]
        and exact_json_contract(canary.get("call_accounting"), variant["accounting"])
    ]
    if len(row_variants) != 1:
        raise Phase8Error(f"{label} conditional defense variants are cross-mixed")
    row_variant = row_variants[0]
    raw_descriptor = canary.get("conditional_na_artifact")
    if not isinstance(raw_descriptor, dict) or set(raw_descriptor) != {
        "path",
        "sha256",
        "bytes",
    }:
        raise Phase8Error(f"{label} conditional defense descriptor changed")
    if not validate_artifact:
        return
    artifact_path, artifact = descriptor_object(
        raw_descriptor, label=f"{label} conditional defense artifact"
    )
    variant = DEFENSE_LOCAL_CONDITIONAL_VARIANTS.get(artifact.get("schema"))
    expected_fields = {
        "schema",
        "status",
        "lane_id",
        "disposition",
        "reason_code",
        "reason",
        "classified_at_utc",
        "classification",
        "bindings",
        "call_accounting",
        "runner_outputs",
        "artifacts",
        "resource_identities",
    }
    if variant is not None and variant["evidence_limits"] is not None:
        expected_fields.add("evidence_limits")
    if variant is None or variant is not row_variant or set(artifact) != expected_fields:
        raise Phase8Error(f"{label} conditional defense artifact fields changed")
    if (
        artifact.get("status") != "N/A"
        or artifact.get("lane_id") != DEFENSE_LOCAL_LANE
        or artifact.get("disposition") != "conditional_na"
        or artifact.get("reason_code") != variant["reason_code"]
        or artifact.get("reason") != variant["reason"]
        or UTC_RE.fullmatch(str(artifact.get("classified_at_utc", ""))) is None
        or not exact_json_contract(artifact.get("classification"), variant["classification"])
        or not exact_json_contract(artifact.get("call_accounting"), variant["accounting"])
        or not exact_json_contract(artifact.get("runner_outputs"), variant["runner_outputs"])
        or not exact_json_contract(artifact.get("evidence_limits"), variant["evidence_limits"])
    ):
        raise Phase8Error(f"{label} conditional defense artifact changed")
    classification = artifact["classification"]
    if type(classification["returncode"]) is not int:
        raise Phase8Error(
            f"{label} conditional defense classifier return code changed"
        )
    bindings = artifact.get("bindings")
    if not isinstance(bindings, dict) or set(bindings) != {
        "expected_commit",
        "framework_lock_id",
        "project_revision_sha256",
        "source_conformance_sha256",
        "source_config_sha256",
        "cuda_visible_devices",
        "target",
        "scoring_guard",
        "defense_guard",
    }:
        raise Phase8Error(f"{label} conditional defense bindings changed")
    target = bindings.get("target")
    artifact_code_identity = {
        "expected_commit": bindings.get("expected_commit"),
        "framework_lock_id": bindings.get("framework_lock_id"),
    }
    if (
        re.fullmatch(
            r"[0-9a-f]{40}", str(bindings.get("expected_commit", ""))
        )
        is None
        or HEX64.fullmatch(str(bindings.get("framework_lock_id", ""))) is None
        or HEX64.fullmatch(
            str(bindings.get("project_revision_sha256", ""))
        )
        is None
        or HEX64.fullmatch(
            str(bindings.get("source_conformance_sha256", ""))
        )
        is None
        or HEX64.fullmatch(str(bindings.get("source_config_sha256"))) is None
        or bindings.get("cuda_visible_devices") != "0,1"
        or not isinstance(target, dict)
        or set(target) != {"spec", "revision", "config_sha256"}
        or target.get("spec") != "vllm:Qwen/Qwen3-VL-8B-Instruct"
        or re.fullmatch(r"[0-9a-f]{40}", str(target.get("revision"))) is None
        or HEX64.fullmatch(str(target.get("config_sha256"))) is None
        or bindings.get("scoring_guard") != EXPECTED_GUARDRAIL
        or bindings.get("defense_guard") != EXPECTED_DEFENSE_GUARDRAIL
    ):
        raise Phase8Error(f"{label} conditional defense binding values changed")
    if expected_code_identity is not None and artifact_code_identity != (
        _require_code_identity(expected_code_identity, label=label)
    ):
        raise Phase8Error(f"{label} conditional defense code identity differs")
    artifacts = artifact.get("artifacts")
    expected_artifacts = variant["artifacts"]
    if not isinstance(artifacts, dict) or set(artifacts) != expected_artifacts:
        raise Phase8Error(f"{label} conditional defense artifact inventory changed")
    artifact_observations = {
        name: descriptor_bytes(
            raw, label=f"{label} conditional defense {name}"
        )
        for name, raw in artifacts.items()
    }
    project_receipt = strict_loads(
        artifact_observations["project_revision"][1],
        label=f"{label} conditional defense project revision",
    )
    project_repository = (
        project_receipt.get("repository")
        if isinstance(project_receipt, dict)
        else None
    )
    if (
        not isinstance(project_repository, dict)
        or project_repository.get("expected_commit")
        != artifact_code_identity["expected_commit"]
        or project_repository.get("observed_commit")
        != artifact_code_identity["expected_commit"]
        or project_repository.get("clean") is not True
        or artifacts["project_revision"]["sha256"]
        != bindings["project_revision_sha256"]
        or artifacts["source_conformance"]["sha256"]
        != bindings["source_conformance_sha256"]
        or artifacts["source_config"]["sha256"] != bindings["source_config_sha256"]
        or artifacts["local_config"]["sha256"] != target["config_sha256"]
    ):
        raise Phase8Error(f"{label} conditional defense artifact bindings differ")
    eligibility = strict_loads(
        artifact_observations["eligibility_plan"][1],
        label=f"{label} conditional defense eligibility plan",
    )
    if not isinstance(eligibility, dict):
        raise Phase8Error(
            f"{label} conditional defense eligibility plan must be one object"
        )
    eligibility_bindings = eligibility.get("bindings")
    experiment_conditions = (
        eligibility_bindings.get("experiment_conditions")
        if isinstance(eligibility_bindings, dict)
        else None
    )
    condition_values = (
        experiment_conditions.get("values")
        if isinstance(experiment_conditions, dict)
        else None
    )
    retained_attestation = (
        condition_values.get("live_attestation")
        if isinstance(condition_values, dict)
        else None
    )
    retained_artifacts = (
        retained_attestation.get("artifacts")
        if isinstance(retained_attestation, dict)
        else None
    )
    live_name = (
        "retained_live_attestation"
        if artifact.get("schema") == DEFENSE_LOCAL_CONDITIONAL_V2_SCHEMA
        else "live_attestation"
    )
    live_descriptor = artifacts[live_name]
    if artifact.get("schema") == DEFENSE_LOCAL_CONDITIONAL_V2_SCHEMA and (
        live_descriptor["sha256"] != artifacts["live_attestation"]["sha256"]
        or live_descriptor["bytes"] != artifacts["live_attestation"]["bytes"]
        or Path(live_descriptor["path"]).name
        != f"live-attestation-{artifacts['live_attestation']['sha256'][:24]}.json"
    ):
        raise Phase8Error(
            f"{label} retained live attestation differs from source"
        )
    expected_live_artifact = {
        "file": Path(live_descriptor["path"]).name,
        "sha256": live_descriptor["sha256"],
        "bytes": live_descriptor["bytes"],
    }
    live_attestation = strict_loads(
        artifact_observations[live_name][1],
        label=f"{label} conditional defense live attestation",
    )
    if not isinstance(live_attestation, dict):
        raise Phase8Error(
            f"{label} conditional defense live attestation must be one object"
        )
    if (
        not isinstance(retained_attestation, dict)
        or set(retained_attestation)
        != {"mode", "execution_scope_id", "max_age_hours", "artifacts"}
        or retained_attestation.get("mode") != "measured"
        or not isinstance(retained_attestation.get("execution_scope_id"), str)
        or not retained_attestation["execution_scope_id"].strip()
        or type(retained_attestation.get("max_age_hours")) is not float
        or retained_attestation["max_age_hours"] != 24.0
        or not isinstance(retained_artifacts, list)
        or len(retained_artifacts) != 1
        or not isinstance(retained_artifacts[0], dict)
        or set(retained_artifacts[0])
        != {"file", "sha256", "bytes", "attestation_id"}
        or {
            key: retained_artifacts[0].get(key)
            for key in ("file", "sha256", "bytes")
        }
        != expected_live_artifact
        or re.fullmatch(
            r"live-attestation-[0-9a-f]{24}",
            str(retained_artifacts[0].get("attestation_id", "")),
        )
        is None
        or live_attestation.get("attestation_id")
        != retained_artifacts[0].get("attestation_id")
    ):
        raise Phase8Error(
            f"{label} conditional defense measured live-attestation eligibility changed"
        )
    acquisition_receipt = strict_loads(
        artifact_observations["acquisition_receipt"][1],
        label=f"{label} conditional defense acquisition receipt",
    )
    if not isinstance(acquisition_receipt, dict):
        raise Phase8Error(
            f"{label} conditional defense acquisition receipt must be one object"
        )
    receipt_id = acquisition_receipt.get("receipt_id")
    if not isinstance(receipt_id, str) or not receipt_id:
        raise Phase8Error(f"{label} conditional defense receipt id changed")
    activity_rows = [
        strict_loads(line, label=f"{label} acquisition activity row")
        for line in artifact_observations["acquisition_result_log"][1].splitlines()
        if line.strip()
    ]
    acquisition_results = [
        item
        for item in activity_rows
        if isinstance(item, dict)
        and set(item) == {"downloaded_bytes", "receipt_id", "receipt_sha256"}
    ]
    if acquisition_results and type(acquisition_results[0]["downloaded_bytes"]) is not int:
        raise Phase8Error(
            f"{label} conditional defense acquisition result downloaded bytes changed"
        )
    if acquisition_results != [
        {
            "downloaded_bytes": 0,
            "receipt_id": receipt_id,
            "receipt_sha256": artifacts["acquisition_receipt"]["sha256"],
        }
    ]:
        raise Phase8Error(
            f"{label} conditional defense acquisition result is not exact zero-download evidence"
        )
    receipt_resources = acquisition_receipt.get("resources")
    if not isinstance(receipt_resources, list) or len(receipt_resources) != 3:
        raise Phase8Error(
            f"{label} conditional defense acquisition resources changed"
        )
    expected_identities: list[dict[str, Any]] = []
    for resource in receipt_resources:
        if (
            not isinstance(resource, dict)
            or not isinstance(resource.get("resource_id"), str)
            or not resource["resource_id"]
            or not isinstance(resource.get("repo_id"), str)
            or not resource["repo_id"]
            or not isinstance(resource.get("revision"), str)
            or not resource["revision"]
            or not isinstance(resource.get("roles"), list)
            or len(resource["roles"]) != 1
            or not isinstance(resource["roles"][0], str)
            or not resource["roles"][0]
        ):
            raise Phase8Error(
                f"{label} conditional defense acquisition resource changed"
            )
        expected_identities.append(
            {
                "resource_id": resource["resource_id"],
                "repo_id": resource["repo_id"],
                "revision": resource["revision"],
                "roles": resource["roles"],
            }
        )
    expected_identities.sort(key=lambda item: (item["repo_id"], item["revision"]))
    expected_resources = {
        "Qwen/Qwen3-VL-8B-Instruct": (target["revision"], ["vllm_target"]),
        EXPECTED_GUARDRAIL["model"]: (
            EXPECTED_GUARDRAIL["revision"],
            ["guardrail_judge"],
        ),
        EXPECTED_DEFENSE_GUARDRAIL["model"]: (
            EXPECTED_DEFENSE_GUARDRAIL["revision"],
            ["defense_guardrail"],
        ),
    }
    identities = artifact.get("resource_identities")
    if (
        not isinstance(identities, list)
        or len(identities) != 3
        or identities != expected_identities
    ):
        raise Phase8Error(f"{label} conditional defense resources changed")
    by_repo: dict[str, dict[str, Any]] = {}
    for identity in identities:
        if (
            not isinstance(identity, dict)
            or set(identity) != {"resource_id", "repo_id", "revision", "roles"}
            or not isinstance(identity.get("repo_id"), str)
            or identity["repo_id"] in by_repo
            or not isinstance(identity.get("resource_id"), str)
            or not identity["resource_id"]
        ):
            raise Phase8Error(f"{label} conditional defense resource row changed")
        by_repo[identity["repo_id"]] = identity
    if set(by_repo) != set(expected_resources) or any(
        by_repo[repo].get("revision") != revision
        or by_repo[repo].get("roles") != roles
        for repo, (revision, roles) in expected_resources.items()
    ):
        raise Phase8Error(f"{label} conditional defense identities changed")


def _exact_inventory(
    rows: object,
    *,
    validate_artifact: bool = True,
    code_identity: Mapping[str, Any] | None = None,
) -> tuple[dict[str, dict[str, Any]], dict[str, dict[str, Any]]]:
    if not isinstance(rows, list) or len(rows) != 46:
        raise Phase8Error("Gate 5 must contain exactly 46 lane rows")
    by_id: dict[str, dict[str, Any]] = {}
    for raw in rows:
        if not isinstance(raw, dict):
            raise Phase8Error("Gate 5 lane row is not an object")
        lane_id = raw.get("lane_id")
        if not isinstance(lane_id, str) or not lane_id or lane_id in by_id:
            raise Phase8Error("Gate 5 lane identifiers are invalid or duplicated")
        by_id[lane_id] = raw
    runnable = {
        lane: row for lane, row in by_id.items() if row.get("disposition") == "runnable"
    }
    terminal = {lane: row for lane, row in by_id.items() if lane not in runnable}
    ollama_static_terminals = validate_gate5_terminal_rows(
        [by_id[lane] for lane in OLLAMA_STATIC_TERMINAL_LANES],
        label="Gate 5",
        validate_artifact=validate_artifact,
        error_type=Phase8Error,
    )
    defense = by_id.get(DEFENSE_LOCAL_LANE)
    conditional = (
        isinstance(defense, dict)
        and defense.get("disposition") == "conditional_na"
    )
    dynamic_counts = {
        "runnable": 22 - len(ollama_static_terminals) - int(conditional),
        "typed_terminal": 24 + len(ollama_static_terminals) + int(conditional),
        "target_runtime_terminal": len(RR_RUNTIME_TERMINAL_LANES)
        + len(ollama_static_terminals),
    }
    expected_runnable = (
        set(RUNNABLE_LANES)
        - RR_RUNTIME_TERMINAL_LANE_SET
        - set(ollama_static_terminals)
        - ({DEFENSE_LOCAL_LANE} if conditional else set())
    )
    expected_terminal = set(TERMINAL_LANES) | (
        {DEFENSE_LOCAL_LANE} if conditional else set()
    ) | set(ollama_static_terminals)
    if (
        set(runnable) != expected_runnable
        or len(runnable) != dynamic_counts["runnable"]
    ):
        raise Phase8Error("Gate 5 runnable inventory is not an accepted exact set")
    if (
        set(terminal) != expected_terminal
        or len(terminal) != dynamic_counts["typed_terminal"]
    ):
        raise Phase8Error("Gate 5 terminal inventory is not an accepted exact set")
    for lane, family in RUNNABLE_FAMILIES.items():
        if (conditional and lane == DEFENSE_LOCAL_LANE) or (
            lane in ollama_static_terminals
        ):
            continue
        row = runnable[lane]
        if (
            row.get("family") != family
            or row.get("disposition") != "runnable"
            or row.get("reason") is not None
            or row.get("reason_code") is not None
        ):
            raise Phase8Error(f"{lane}: Gate 5 runnable contract changed")
    for lane, expected in EXPECTED_TERMINAL_ROWS.items():
        if terminal[lane] != expected:
            raise Phase8Error(f"{lane}: Gate 5 typed terminal row changed")
    _validate_rr_runtime_terminal_rows(
        terminal,
        label="Gate 5",
        validate_artifact=validate_artifact,
        expected_code_identity=code_identity,
    )
    if conditional:
        _validate_conditional_defense_row(
            terminal[DEFENSE_LOCAL_LANE],
            label="Gate 5",
            validate_artifact=validate_artifact,
            expected_code_identity=code_identity,
        )
    return runnable, terminal


def _gate5_profile(
    runnable: Mapping[str, Any], terminal: Mapping[str, Any]
) -> dict[str, Any]:
    conditional = DEFENSE_LOCAL_LANE in terminal
    ollama_static_terminals = tuple(
        lane for lane in OLLAMA_STATIC_TERMINAL_LANES if lane in terminal
    )
    target_runtime_terminals = len(RR_RUNTIME_TERMINAL_LANES) + len(
        ollama_static_terminals
    )
    if (
        not conditional
        or ollama_static_terminals != tuple(OLLAMA_STATIC_TERMINAL_LANES)
        or len(runnable) != HISTORICAL_GATE5_RUNNABLE
        or len(terminal) != HISTORICAL_GATE5_TYPED_TERMINAL
        or target_runtime_terminals != HISTORICAL_GATE5_TARGET_RUNTIME_TERMINAL
    ):
        raise Phase8Error("Gate 5 is not the retained historical c926 profile")
    return {
        "conditional_na_lanes": [DEFENSE_LOCAL_LANE] if conditional else [],
        "ollama_static_terminal_lanes": ollama_static_terminals,
        "scheduled_core_lanes": [
            lane for lane in CORE_LANES if lane in runnable
        ],
        "scheduled_runner_lanes": [
            lane
            for lane in RUNNABLE_LANES
            if lane in runnable
        ],
        "scheduled_extended_lanes": [
            lane for lane in EXTENDED_LANES if lane in runnable
        ],
        "runnable_lane_count": len(runnable),
        "terminal_lane_count": len(terminal),
        "target_runtime_terminal": target_runtime_terminals,
        "target_runtime_terminal_artifact": _validate_rr_runtime_terminal_rows(
            terminal, label="Gate 5", validate_artifact=False
        ),
    }


def _count_inventory(value: object, *, profile: Mapping[str, Any]) -> None:
    dynamic_counts = {
        "target_runtime_terminal": len(RR_RUNTIME_TERMINAL_LANES)
        + len(profile["ollama_static_terminal_lanes"]),
    }
    expected = {
        "total": 46,
        "runnable": profile["runnable_lane_count"],
        "typed_terminal": profile["terminal_lane_count"],
        "conditional_na_lanes": profile["conditional_na_lanes"],
        "bridge_terminal": 3,
        "ollama_transport_terminal": 3,
        "portfolio_terminal": 5,
        "native_terminal": 9,
        "target_runtime_terminal": dynamic_counts["target_runtime_terminal"],
    }
    if (
        not isinstance(value, dict)
        or set(value) != set(expected)
        or any(
            type(value.get(field)) is not int
            for field in expected
            if field != "conditional_na_lanes"
        )
        or value != expected
    ):
        raise Phase8Error("Gate 5 promotion counts do not bind an accepted profile")


def validate_gate5(
    manifest_path: Path,
    runnote_path: Path,
    promotion_path: Path,
    *,
    thesis_root: Path,
    project_root: Path,
    manifest_payload: bytes | None = None,
    runnote_payload: bytes | None = None,
    promotion_payload: bytes | None = None,
) -> dict[str, Any]:
    manifest_path = checked_file(manifest_path, label="Gate 5 covered manifest")
    if manifest_payload is None:
        _manifest_path, manifest_payload = _stable_regular_bytes(
            manifest_path,
            label="Gate 5 covered manifest",
            max_bytes=MAX_JSON_BYTES,
        )
    manifest = strict_loads(manifest_payload, label="Gate 5 covered manifest")
    if not isinstance(manifest, dict):
        raise Phase8Error("Gate 5 covered manifest must contain one JSON object")
    code_identity = _require_code_identity(
        manifest.get("code_identity"), label="Gate 5 manifest"
    )
    if (
        manifest.get("schema") != "ura-gate5-covered-manifest/1"
        or manifest.get("inventory_complete") is not True
    ):
        raise Phase8Error("Gate 5 manifest identity or completeness differs")
    runnable, terminal = _exact_inventory(
        manifest.get("lanes"), code_identity=code_identity
    )
    _validate_rr_runtime_project_continuity(
        _validate_rr_runtime_terminal_rows(
            terminal,
            label="Gate 5",
            validate_artifact=False,
        ),
        project_root=project_root,
        covered_commit=code_identity["expected_commit"],
        label="Gate 5",
    )
    profile = _gate5_profile(runnable, terminal)
    manifest_policy = manifest.get("policy")
    if not isinstance(manifest_policy, dict):
        raise Phase8Error("Gate 5 covered-manifest policy is absent")
    exact_zero_fields(
        manifest_policy,
        (
            "model_judge_calls_required",
            "http_attempts_required",
            "downloads_required_bytes",
        ),
        label="Gate 5 covered-manifest policy",
    )

    runnote_path = checked_file(runnote_path, label="canonical Gate 5 RUNNOTE")
    if runnote_path != (thesis_root / "RUNNOTE.md").resolve(strict=True):
        raise Phase8Error("Gate 5 RUNNOTE is not the canonical runs/thesis/RUNNOTE.md")
    if runnote_payload is None:
        _runnote_path, runnote_payload = _stable_regular_bytes(
            runnote_path,
            label="canonical Gate 5 RUNNOTE",
            max_bytes=MAX_TEXT_BYTES,
        )
    note = read_markdown_json_bytes(
        runnote_payload, label="canonical Gate 5 RUNNOTE"
    )
    manifest_desc = descriptor_from_bytes(manifest_path, manifest_payload)
    expected_note_fields = {
        "schema",
        "status",
        "created_at_utc",
        "candidate_only",
        "canonical_runnote",
        "promotion_basis",
        "approval",
        "covered_manifest",
        "input_evidence",
        "failed_attempts",
        "policy",
        "storage_observations",
        "checkout",
        "project_revision",
        "source_conformance",
        "system",
        "routes",
        "execution_accounting",
        "future_measured_run",
        "lanes",
    }
    if (
        set(note) != expected_note_fields
        or note.get("schema") != "ura-gate5-runnote/1"
        or note.get("status") != "complete"
        or note.get("candidate_only") is not False
        or note.get("canonical_runnote") != str(runnote_path)
        or not UTC_RE.fullmatch(str(note.get("created_at_utc", "")))
    ):
        raise Phase8Error("canonical Gate 5 RUNNOTE contract differs")
    note_runnable, note_terminal = _exact_inventory(
        note.get("lanes"), code_identity=code_identity
    )
    if (
        set(note_runnable) != set(runnable)
        or set(note_terminal) != set(terminal)
        or _gate5_profile(note_runnable, note_terminal) != profile
    ):
        raise Phase8Error("canonical RUNNOTE lane inventory differs from Gate 5")
    routes = note.get("routes")
    future = note.get("future_measured_run")
    if (
        note.get("policy") != manifest_policy
        or not isinstance(routes, dict)
        or set(routes)
        != {
            "target",
            "judges",
            "hosted_target_calls",
            "hosted_judge_calls",
            "http_attempts",
            "provider_quota",
            "monetary_cost",
        }
        or routes.get("target") != "local_only"
        or routes.get("judges") != ["rules", "local_guardrail_where_selected"]
        or future
        != {
            "authorized": False,
            "requires_distinct_measured_purpose_plan_and_receipt": True,
            "diagnostic_canaries_are_empirical_benchmark_evidence": False,
        }
    ):
        raise Phase8Error("canonical RUNNOTE local-only route contract differs")
    exact_zero_fields(
        routes,
        ("hosted_target_calls", "hosted_judge_calls", "http_attempts"),
        label="canonical Gate 5 RUNNOTE routes",
    )
    covered = note.get("covered_manifest")
    if covered != manifest_desc:
        raise Phase8Error("canonical RUNNOTE covered-manifest descriptor differs")
    approval = note.get("approval")
    if (
        not isinstance(approval, dict)
        or approval.get("covered_manifest_sha256") != manifest_desc["sha256"]
    ):
        raise Phase8Error("canonical RUNNOTE approval does not bind Gate 5")
    promotion_basis = note.get("promotion_basis")
    expected_basis_fields = {
        "covered_manifest",
        "runnote_candidate",
        "finalization_receipt",
        "finalizer_exit",
        "current_project_revision",
        "current_source_conformance",
        "all_final_preflights_revalidated",
        "local_only_zero_download_revalidated",
        "measured_run_launched",
    }
    if (
        not isinstance(promotion_basis, dict)
        or set(promotion_basis) != expected_basis_fields
        or promotion_basis.get("covered_manifest") != manifest_desc
        or promotion_basis.get("all_final_preflights_revalidated") is not True
        or promotion_basis.get("local_only_zero_download_revalidated") is not True
        or promotion_basis.get("measured_run_launched") is not False
    ):
        raise Phase8Error("canonical RUNNOTE promotion basis differs")
    for field in (
        "covered_manifest",
        "runnote_candidate",
        "finalization_receipt",
        "finalizer_exit",
        "current_project_revision",
        "current_source_conformance",
    ):
        descriptor_file(
            promotion_basis[field], label=f"canonical promotion basis {field}"
        )

    promotion_path = checked_file(promotion_path, label="Gate 5 promotion receipt")
    if promotion_payload is None:
        _promotion_path, promotion_payload = _stable_regular_bytes(
            promotion_path,
            label="Gate 5 promotion receipt",
            max_bytes=MAX_JSON_BYTES,
        )
    promotion = strict_loads(promotion_payload, label="Gate 5 promotion receipt")
    if not isinstance(promotion, dict):
        raise Phase8Error("Gate 5 promotion receipt must contain one JSON object")
    required = {
        "schema",
        "status",
        "completed_at_utc",
        "promotion_plan",
        "authorization",
        "inputs",
        "canonical_runnote",
        "prior_canonical",
        "inventory_counts",
        "local_only",
        "downloads_observed_bytes",
        "measured_run_launched",
    }
    if set(promotion) != required:
        raise Phase8Error("Gate 5 promotion receipt field inventory changed")
    if (
        promotion.get("schema") != PROMOTION_SCHEMA
        or promotion.get("status") != "complete"
        or not UTC_RE.fullmatch(str(promotion.get("completed_at_utc", "")))
        or type(promotion.get("downloads_observed_bytes")) is not int
        or promotion.get("downloads_observed_bytes") != 0
        or promotion.get("measured_run_launched") is not False
    ):
        raise Phase8Error("Gate 5 promotion receipt is not a complete local promotion")
    promoted_note_descriptor = promotion.get("canonical_runnote")
    expected_runnote_descriptor = descriptor_from_bytes(
        runnote_path, runnote_payload
    )
    if (
        promoted_note_descriptor != expected_runnote_descriptor
    ):
        raise Phase8Error(
            "promotion receipt does not bind exact canonical RUNNOTE bytes"
        )
    plan_path, plan_payload = descriptor_bytes(
        promotion.get("promotion_plan"), label="Gate 5 promotion plan"
    )
    plan = strict_loads(plan_payload, label="Gate 5 promotion plan")
    if not isinstance(plan, dict):
        raise Phase8Error("Gate 5 promotion plan must contain one JSON object")
    expected_plan_fields = {
        "schema",
        "status",
        "code_identity",
        "inputs",
        "inventory_counts",
        "local_only",
        "canonical_runnote",
        "prior_canonical",
        "placeholder_archive_destination",
        "promotion_receipt_destination",
        "authorization",
    }
    if (
        set(plan) != expected_plan_fields
        or plan.get("schema") != "ura-gate5-runnote-promotion-plan/1"
        or plan.get("status") != "candidate_only"
        or plan.get("code_identity") != code_identity
    ):
        raise Phase8Error("Gate 5 promotion plan identity differs")
    prior = promotion.get("prior_canonical")
    if (
        not isinstance(prior, dict)
        or set(prior) != {"state", "artifact", "archive"}
        or prior.get("state")
        not in {"placeholder_archived_and_replaced", "already_identical"}
    ):
        raise Phase8Error("Gate 5 prior-canonical receipt differs")
    prior_artifact = prior.get("artifact")
    plan_prior = plan.get("prior_canonical")
    if not isinstance(prior_artifact, dict) or set(prior_artifact) != {
        "path",
        "sha256",
        "bytes",
    } or not isinstance(plan_prior, dict) or set(plan_prior) != {
        "state",
        "artifact",
    }:
        raise Phase8Error("prior canonical artifact descriptor fields differ")
    archive = prior.get("archive")
    if prior["state"] == "placeholder_archived_and_replaced":
        archive_path, archive_payload = descriptor_bytes(
            archive, label="archived prior canonical RUNNOTE"
        )
        placeholder_identity = {
            "sha256": "7ec84df8ea241fd09e6403de30a06fc18c10c8ff449b99834821b567dace17cf",
            "bytes": 22,
        }
        if (
            plan_prior
            != {
                "state": "exact_placeholder",
                "artifact": {"path": str(runnote_path), **placeholder_identity},
            }
            or prior_artifact
            != {"path": str(archive_path), **placeholder_identity}
            or archive != prior_artifact
            or sha256_bytes(archive_payload) != prior_artifact["sha256"]
            or len(archive_payload) != prior_artifact["bytes"]
            or plan.get("placeholder_archive_destination") != str(archive_path)
        ):
            raise Phase8Error(
                "archived prior canonical does not prove the exact placeholder"
            )
    else:
        current_descriptor = descriptor_from_bytes(runnote_path, runnote_payload)
        if (
            plan_prior
            != {"state": "identical_canonical", "artifact": current_descriptor}
            or prior_artifact != current_descriptor
        ):
            raise Phase8Error(
                "already-identical prior canonical differs from current bytes"
            )
        if archive != {"status": "N/A", "value": None}:
            archived, archived_payload = descriptor_bytes(
                archive, label="retained prior placeholder archive"
            )
            if (
                sha256_bytes(archived_payload)
                != "7ec84df8ea241fd09e6403de30a06fc18c10c8ff449b99834821b567dace17cf"
                or len(archived_payload) != 22
            ):
                raise Phase8Error("retained placeholder archive identity differs")
    _count_inventory(promotion.get("inventory_counts"), profile=profile)
    inputs = promotion.get("inputs")
    expected_input_fields = {
        "covered_manifest",
        "runnote_candidate",
        "finalization_receipt",
        "finalizer_exit",
        "project_revision",
        "source_conformance",
    }
    if not isinstance(inputs, dict) or set(inputs) != expected_input_fields:
        raise Phase8Error("Gate 5 promotion input inventory differs")
    if inputs.get("covered_manifest") != manifest_desc:
        raise Phase8Error("Gate 5 promotion inputs omit the exact covered manifest")
    input_observations = {
        field: descriptor_bytes(
            inputs[field], label=f"Gate 5 promotion input {field}"
        )
        for field in expected_input_fields
    }
    finalization = strict_loads(
        input_observations["finalization_receipt"][1],
        label="Gate 5 finalization receipt",
    )
    if not isinstance(finalization, dict):
        raise Phase8Error("Gate 5 finalization receipt must be one JSON object")
    if (
        set(finalization)
        != {
            "schema",
            "status",
            "completed_at_utc",
            "covered_manifest_sha256",
            "approval",
            "manifest",
            "approval_artifact",
            "storage_observations",
            "runnote_candidate",
            "runnable_lanes",
            "typed_terminal_lanes",
            "target_runtime_terminal",
            "conditional_na_lanes",
            "downloads_observed_bytes",
            "commands",
            "artifact_index_excludes_this_receipt_and_exit_marker",
        }
        or finalization.get("schema") != "ura-gate5-finalization-receipt/1"
        or finalization.get("status") != "complete"
        or finalization.get("manifest") != manifest_desc
        or finalization.get("covered_manifest_sha256") != manifest_desc["sha256"]
        or finalization.get("runnable_lanes") != profile["runnable_lane_count"]
        or finalization.get("typed_terminal_lanes") != profile["terminal_lane_count"]
        or finalization.get("target_runtime_terminal")
        != profile["target_runtime_terminal"]
        or finalization.get("conditional_na_lanes")
        != profile["conditional_na_lanes"]
        or type(finalization.get("runnable_lanes")) is not int
        or type(finalization.get("typed_terminal_lanes")) is not int
        or type(finalization.get("target_runtime_terminal")) is not int
        or finalization.get("downloads_observed_bytes") != 0
        or not UTC_RE.fullmatch(str(finalization.get("completed_at_utc", "")))
    ):
        raise Phase8Error("Gate 5 finalization receipt inventory differs")
    authorization = promotion.get("authorization")
    if authorization != {
        "kind": "exact_promotion_plan_sha256",
        "authorized_plan_sha256": sha256_bytes(plan_payload),
    }:
        raise Phase8Error("Gate 5 promotion authorization differs")
    local_only = promotion.get("local_only")
    expected_local = {
        "hosted_provider_calls": 0,
        "hosted_judge_calls": 0,
        "http_attempts": 0,
        "paid_provider_calls": 0,
        "model_downloads": 0,
        "offline_environment": True,
        "final_preflights_revalidated": True,
    }
    if local_only != expected_local:
        raise Phase8Error("Gate 5 promotion is not the exact local-only record")
    exact_zero_fields(
        local_only,
        (
            "hosted_provider_calls",
            "hosted_judge_calls",
            "http_attempts",
            "paid_provider_calls",
            "model_downloads",
        ),
        label="Gate 5 local-only promotion",
    )
    plan_local_only = plan.get("local_only")
    if not isinstance(plan_local_only, dict):
        raise Phase8Error("Gate 5 promotion plan local-only record differs")
    exact_zero_fields(
        plan_local_only,
        (
            "hosted_provider_calls",
            "hosted_judge_calls",
            "http_attempts",
            "paid_provider_calls",
            "model_downloads",
        ),
        label="Gate 5 local-only promotion plan",
    )
    planned_canonical = plan.get("canonical_runnote")
    if (
        plan.get("inputs") != inputs
        or plan.get("inventory_counts") != promotion["inventory_counts"]
        or plan.get("local_only") != expected_local
        or plan.get("authorization")
        != {
            "kind": "exact_promotion_plan_sha256",
            "required": True,
            "launches_models_or_jobs": False,
        }
        or planned_canonical
        != {
            "destination": str(runnote_path),
            "proposed_sha256": sha256_bytes(runnote_payload),
            "proposed_bytes": len(runnote_payload),
            "schema": "ura-gate5-runnote/1",
            "candidate_only": False,
        }
        or Path(str(plan.get("promotion_receipt_destination", ""))) != promotion_path
    ):
        raise Phase8Error("Gate 5 promotion receipt differs from its authorized plan")
    return {
        "manifest": manifest,
        "note": note,
        "promotion": promotion,
        "runnable": runnable,
        "terminal": terminal,
        "profile": profile,
        "code_identity": code_identity,
    }


def validate_ethics(
    path: Path,
    authorized_sha: str,
    *,
    runner_root: Path,
    payload: bytes | None = None,
) -> dict[str, Any]:
    path = checked_file(path, label="ethics/consent determination")
    if payload is None:
        _path, payload = _stable_regular_bytes(
            path,
            label="ethics/consent determination",
            max_bytes=MAX_JSON_BYTES,
        )
    observed_sha = sha256_bytes(payload)
    if HEX64.fullmatch(authorized_sha) is None or observed_sha != authorized_sha:
        raise Phase8Error(
            "ethics determination authorization does not match exact bytes"
        )
    value = strict_loads(payload, label="ethics/consent determination")
    if not isinstance(value, dict):
        raise Phase8Error("ethics/consent determination must be one JSON object")
    required = {
        "schema",
        "status",
        "determination_id",
        "decided_at_utc",
        "responsible_party",
        "scope",
        "sensitive_content_acknowledged",
        "preparation_authorized",
        "human_labeling_authorized",
        "consent_controls",
        "compensation_controls",
        "withdrawal_controls",
        "harmful_content_welfare_controls",
        "escalation_controls",
    }
    if set(value) != required:
        raise Phase8Error(
            "ethics determination fields differ from the required template"
        )
    consent = value.get("consent_controls")
    compensation = value.get("compensation_controls")
    withdrawal = value.get("withdrawal_controls")
    welfare = value.get("harmful_content_welfare_controls")
    escalation = value.get("escalation_controls")
    if (
        value.get("schema") != ETHICS_SCHEMA
        or value.get("status")
        not in {"approved", "exempt", "not_human_subjects", "authorized"}
        or not isinstance(value.get("determination_id"), str)
        or not value["determination_id"].strip()
        or not UTC_RE.fullmatch(str(value.get("decided_at_utc", "")))
        or not isinstance(value.get("responsible_party"), str)
        or not value["responsible_party"].strip()
        or value.get("sensitive_content_acknowledged") is not True
        or value.get("preparation_authorized") is not True
        or not isinstance(value.get("human_labeling_authorized"), bool)
    ):
        raise Phase8Error(
            "ethics determination does not authorize sensitive preparation"
        )
    if (
        not isinstance(consent, dict)
        or set(consent)
        != {
            "document_version",
            "informed_consent_before_exposure",
            "minors_excluded",
        }
        or not isinstance(consent.get("document_version"), str)
        or not consent["document_version"].strip()
        or consent.get("informed_consent_before_exposure") is not True
        or consent.get("minors_excluded") is not True
        or not isinstance(compensation, dict)
        or set(compensation) != {"basis", "agreement_contingent"}
        or not isinstance(compensation.get("basis"), str)
        or not compensation["basis"].strip()
        or compensation.get("agreement_contingent") is not False
        or not isinstance(withdrawal, dict)
        or set(withdrawal) != {"process", "without_penalty"}
        or not isinstance(withdrawal.get("process"), str)
        or not withdrawal["process"].strip()
        or withdrawal.get("without_penalty") is not True
        or not isinstance(welfare, dict)
        or set(welfare)
        != {
            "advance_category_warnings",
            "category_opt_out_without_penalty",
            "continuous_exposure_limit",
            "scheduled_breaks",
        }
        or welfare.get("advance_category_warnings") is not True
        or welfare.get("category_opt_out_without_penalty") is not True
        or not isinstance(welfare.get("continuous_exposure_limit"), str)
        or not welfare["continuous_exposure_limit"].strip()
        or welfare.get("scheduled_breaks") is not True
        or not isinstance(escalation, dict)
        or set(escalation) != {"stop_contact", "adverse_event_process"}
        or not isinstance(escalation.get("stop_contact"), str)
        or not escalation["stop_contact"].strip()
        or not isinstance(escalation.get("adverse_event_process"), str)
        or not escalation["adverse_event_process"].strip()
    ):
        raise Phase8Error(
            "ethics determination rater-protection controls differ"
        )
    if value.get("scope") != {
        "expected_commit": EXPECTED_COMMIT,
        "framework_lock_id": EXPECTED_FRAMEWORK_LOCK,
        "runner_root": str(runner_root),
        "common_frame": True,
        "source_task_frame": True,
    }:
        raise Phase8Error("ethics determination scope differs from this exact campaign")
    return value


def _validate_zero_local_fields(value: Mapping[str, Any], *, label: str) -> None:
    exact_zero_fields(
        value,
        (
            "hosted_target_calls",
            "hosted_judge_calls",
            "provider_http_attempts",
            "downloads_observed_bytes",
        ),
        label=label,
    )


def _validate_native_call_summary(
    path: Path,
    *,
    engine: str,
    attempt: Path,
    call_cap: int,
    observed_calls: int,
    require_success: bool,
    expected_model_tags: Sequence[str] | None = None,
    payload: bytes | None = None,
) -> None:
    if payload is None:
        _path, payload = _stable_regular_bytes(
            path,
            label=f"{engine} native local-call summary",
            max_bytes=MAX_JSON_BYTES,
        )
    value = strict_loads(payload, label=f"{engine} native local-call summary")
    if not isinstance(value, dict):
        raise Phase8Error(f"{engine}: native local-call summary is not one object")
    fields = {
        "schema",
        "status",
        "completed_at_utc",
        "upstream",
        "allowed_models",
        "target_call_cap",
        "model_calls",
        "denied_requests",
        "model_counts",
        "path_counts",
        "ledger",
        "hosted_calls",
        "downloads",
    }
    model_tags = sorted(
        expected_model_tags
        if expected_model_tags is not None
        else (model["tag"] for model in NATIVE_OLLAMA_MODELS.values())
    )
    if (
        not model_tags
        or len(set(model_tags)) != len(model_tags)
        or any(not isinstance(tag, str) or not tag for tag in model_tags)
    ):
        raise Phase8Error(f"{engine}: native model allow-list differs")
    generation_paths = {
        "/api/chat",
        "/api/generate",
        "/api/embeddings",
        "/v1/chat/completions",
        "/v1/completions",
        "/v1/embeddings",
    }
    if (
        set(value) != fields
        or value.get("schema") != "ura-native-local-call-gate-summary/1"
        or value.get("status") != "complete"
        or not UTC_RE.fullmatch(str(value.get("completed_at_utc", "")))
        or value.get("upstream") != "http://127.0.0.1:11434"
        or value.get("allowed_models") != model_tags
        or type(value.get("target_call_cap")) is not int
        or value.get("target_call_cap") != call_cap
        or type(value.get("model_calls")) is not int
        or value.get("model_calls") != observed_calls
        or type(value.get("denied_requests")) is not int
        or value.get("denied_requests", -1) < 0
    ):
        raise Phase8Error(f"{engine}: native local-call summary differs")
    exact_zero_fields(
        value, ("hosted_calls", "downloads"), label=f"{engine} native call summary"
    )
    if require_success and (observed_calls < 1 or value.get("denied_requests") != 0):
        raise Phase8Error(f"{engine}: successful native run lacks clean local calls")
    for field, allowed in (
        ("model_counts", set(model_tags)),
        ("path_counts", generation_paths),
    ):
        counter = value.get(field)
        if (
            not isinstance(counter, dict)
            or not set(counter).issubset(allowed)
            or any(type(count) is not int or count < 1 for count in counter.values())
            or sum(counter.values()) != observed_calls
        ):
            raise Phase8Error(f"{engine}: native {field} differs")
    ledger, ledger_payload = descriptor_bytes(
        value.get("ledger"), label=f"{engine} native call ledger"
    )
    if not is_beneath(ledger, attempt):
        raise Phase8Error(f"{engine}: native call ledger escaped its attempt")
    events = [
        strict_loads(line, label=f"{engine} native call ledger row")
        for line in ledger_payload.splitlines()
        if line.strip()
    ]
    if any(not isinstance(event, dict) for event in events):
        raise Phase8Error(f"{engine}: native call ledger row differs")
    requests = [event for event in events if event.get("event") == "model_request"]
    responses = [
        event
        for event in events
        if event.get("event") in {"model_response", "model_response_error"}
    ]
    if (
        len(requests) != observed_calls
        or [event.get("sequence") for event in requests]
        != list(range(1, observed_calls + 1))
        or any(event.get("model") not in model_tags for event in requests)
        or any(event.get("path") not in generation_paths for event in requests)
        or len(responses) > len(requests)
        or (require_success and len(responses) != len(requests))
    ):
        raise Phase8Error(f"{engine}: native call ledger disagrees with its summary")


def _native_model_identity(tag: str, digest: str) -> str:
    return f"ollama:{tag}@sha256:{digest}"


def _validate_native_import_config(
    path: Path,
    *,
    engine: str,
    row: Mapping[str, Any],
    plan: Mapping[str, Any],
    attempt: Path,
    payload: bytes | None = None,
) -> dict[str, Any]:
    if payload is None:
        _path, payload = _stable_regular_bytes(
            path,
            label=f"{engine} native import config",
            max_bytes=MAX_JSON_BYTES,
        )
    config = strict_loads(payload, label=f"{engine} native import config")
    if not isinstance(config, dict):
        raise Phase8Error(f"{engine}: native import config is not one object")
    if (
        set(config) != {"schema_version", "engine", "adapter", "import"}
        or config.get("schema_version") != "ura-native-import-config/1"
        or config.get("engine") != engine
        or not isinstance(config.get("adapter"), dict)
        or not isinstance(config.get("import"), dict)
    ):
        raise Phase8Error(f"{engine}: native import config contract differs")
    adapter = config["adapter"]
    source = config["import"]
    runtime_row = row.get("runtime")
    if not isinstance(runtime_row, dict):
        raise Phase8Error(f"{engine}: native runtime row is absent")
    runtime = Path(str(runtime_row["managed_store"]))
    models = plan.get("ollama_models")
    if not isinstance(models, dict):
        raise Phase8Error(f"{engine}: native model plan is absent")
    primary = models["primary"]
    judge = models["judge"]
    auditor = models["auditor"]
    primary_tag = primary["tag"]
    primary_identity = _native_model_identity(primary_tag, primary["digest"])
    judge_tag = judge["tag"]
    judge_identity = _native_model_identity(judge_tag, judge["digest"])
    auditor_tag = auditor["tag"]

    if engine == "fuzzyai":
        if (
            adapter
            != {
                "attacks": ["def"],
                "model": f"ollama/{primary_tag}",
                "cli": str(runtime / "bin" / "fuzzyai"),
            }
            or source.get("upstream_revision") != runtime_row["upstream_revision"]
        ):
            raise Phase8Error("fuzzyai: native import identity differs")
        result_path = Path(str(source.get("results_dir", "")))
    elif engine == "garak":
        if (
            adapter
            != {
                "target_type": "openai.OpenAICompatible",
                "target_name": primary_tag,
                "probe_spec": "test.Blank",
                "detector_spec": "auto",
                "generations": 1,
                "seed": 0,
                "eval_threshold": 0.5,
                "python": str(runtime / "bin" / "python"),
                "upstream_version": "0.15.1",
            }
            or source.get("upstream_revision") != runtime_row["upstream_revision"]
        ):
            raise Phase8Error("garak: native import identity differs")
        result_path = Path(str(source.get("report_path", "")))
    elif engine == "promptfoo":
        provider = f"ollama:chat:{primary_tag}"
        if (
            adapter
            != {
                "target_providers": [provider],
                "plugins": ["harmful:hate"],
                "strategies": ["basic"],
                "include_basic": True,
                "inject_var": "prompt",
                "generation_provider": provider,
                "grader_provider": provider,
                "cli": str(
                    runtime
                    / "node_modules"
                    / "promptfoo"
                    / "dist"
                    / "src"
                    / "entrypoint.js"
                ),
                "upstream_version": "0.121.15",
            }
            or source.get("upstream_revision") != runtime_row["upstream_revision"]
        ):
            raise Phase8Error("promptfoo: native import identity differs")
        result_path = Path(str(source.get("results_json", "")))
        generated_config = Path(str(source.get("generated_config", "")))
        if not generated_config.is_absolute() or not is_beneath(
            generated_config.resolve(strict=True), attempt
        ):
            raise Phase8Error("promptfoo: generated native config escaped its attempt")
    elif engine == "petri":
        if (
            adapter
            != {
                "auditor_model": f"openai/{auditor_tag}",
                "target_model": f"openai/{primary_tag}",
                "judge_model": f"openai/{judge_tag}",
                "cli": str(runtime / "bin" / "inspect"),
            }
            or source.get("expected_upstream_version")
            != str(runtime_row["version"]).split("+", 1)[0]
        ):
            raise Phase8Error("petri: native import identity differs")
        result_path = Path(str(source.get("log_path", "")))
    elif engine == "easyjailbreak":
        if (
            adapter
            != {
                "recipe": "DeepInception",
                "target_model": primary_identity,
                "attack_model": None,
                "eval_model": judge_identity,
                "upstream_version": "0.1.3",
            }
            or source.get("upstream_revision") != runtime_row["upstream_revision"]
        ):
            raise Phase8Error("easyjailbreak: native import identity differs")
        result_path = Path(str(source.get("result_jsonl", "")))
    elif engine == "giskard":
        if adapter != {"target_model": primary_identity}:
            raise Phase8Error("giskard: native import identity differs")
        result_path = Path(str(source.get("results_dir", "")))
    else:
        raise Phase8Error(f"{engine}: unsupported native import config")
    if not result_path.is_absolute() or not is_beneath(
        result_path.resolve(strict=True), attempt
    ):
        raise Phase8Error(f"{engine}: native import input escaped its attempt")
    for key, item in source.items():
        if key.endswith("sha256") and (
            not isinstance(item, str) or HEX64.fullmatch(item) is None
        ):
            raise Phase8Error(f"{engine}: native import digest differs")
    return config


def _validate_native_run_receipts(
    *,
    engine: str,
    row: Mapping[str, Any],
    plan: Mapping[str, Any],
    attempt: Path,
    evidence: Mapping[str, Any],
    observations: Mapping[str, tuple[Path, bytes]] | None = None,
) -> None:
    required_fields = (
        "engine_result",
        "canonical_native_envelope",
        "import_config",
        "local_call_summary",
    )
    evidence_observations = (
        {
            field: descriptor_bytes(
                evidence[field], label=f"{engine} Phase 6 native {field}"
            )
            for field in required_fields
        }
        if observations is None
        else {field: observations[field] for field in required_fields}
    )
    evidence_paths = {
        field: observation[0]
        for field, observation in evidence_observations.items()
    }
    if any(not is_beneath(path, attempt) for path in evidence_paths.values()):
        raise Phase8Error(f"{engine}: native run receipt escaped its attempt")
    envelope = strict_loads(
        evidence_observations["canonical_native_envelope"][1],
        label=f"{engine} canonical native envelope",
    )
    if not isinstance(envelope, dict):
        raise Phase8Error(f"{engine}: canonical native envelope is not one object")
    native_run = envelope.get("run")
    config_reference = envelope.get("import_config")
    if (
        set(envelope) != {"schema_version", "import_config", "run"}
        or envelope.get("schema_version") != "ura-native-import-envelope/2"
        or not isinstance(native_run, dict)
        or native_run.get("engine") != engine
        or native_run.get("common_metric_eligible") is not False
        or native_run.get("runner_replay_eligible") is not False
        or not isinstance(native_run.get("native_run_id"), str)
        or not native_run["native_run_id"]
        or not isinstance(native_run.get("cases"), list)
        or len(native_run["cases"]) != 1
        or not isinstance(config_reference, dict)
        or set(config_reference) != {"locator", "sha256", "bytes"}
        or config_reference.get("sha256") != evidence["import_config"]["sha256"]
        or type(config_reference.get("bytes")) is not int
        or config_reference.get("bytes") != evidence["import_config"]["bytes"]
        or not isinstance(config_reference.get("locator"), str)
        or not config_reference["locator"].strip()
        or Path(config_reference["locator"]).is_absolute()
        or (
            evidence_paths["canonical_native_envelope"].parent
            / config_reference["locator"]
        ).resolve(strict=True)
        != evidence_paths["import_config"]
    ):
        raise Phase8Error(f"{engine}: canonical native envelope differs")
    _validate_native_import_config(
        evidence_paths["import_config"],
        engine=engine,
        row=row,
        plan=plan,
        attempt=attempt,
        payload=evidence_observations["import_config"][1],
    )
    engine_result = strict_loads(
        evidence_observations["engine_result"][1],
        label=f"{engine} native engine result",
    )
    if not isinstance(engine_result, dict):
        raise Phase8Error(f"{engine}: native engine result is not one object")
    native_import = engine_result.get("native_import")
    if (
        set(engine_result)
        != {
            "schema",
            "engine",
            "status",
            "completed_at_utc",
            "runtime",
            "native_import",
            "local_call_summary",
            "hosted_calls",
            "downloads",
            "one_case",
        }
        or engine_result.get("schema") != "ura-phase6-native-engine-result/1"
        or engine_result.get("engine") != engine
        or engine_result.get("status") != "run"
        or not UTC_RE.fullmatch(str(engine_result.get("completed_at_utc", "")))
        or engine_result.get("runtime") != row.get("runtime")
        or engine_result.get("one_case") is not True
        or type(engine_result.get("hosted_calls")) is not int
        or engine_result.get("hosted_calls") != 0
        or type(engine_result.get("downloads")) is not int
        or engine_result.get("downloads") != 0
        or not isinstance(native_import, dict)
        or native_import.get("canonical") != evidence["canonical_native_envelope"]
        or native_import.get("config") != evidence["import_config"]
        or engine_result.get("local_call_summary") != evidence["local_call_summary"]
    ):
        raise Phase8Error(f"{engine}: native engine result differs")
    native_import_fields = {
        "config",
        "canonical",
        "native_engine",
        "native_run_id",
        "native_cases",
        "common_metric_eligible",
        "runner_replay_eligible",
    }
    if engine == "giskard":
        native_import_fields |= {
            "dataset_rows",
            "generated_requirements",
            "generated_samples_per_requirement",
        }
    if (
        set(native_import) != native_import_fields
        or native_import.get("native_engine") != engine
        or native_import.get("native_run_id") != native_run["native_run_id"]
        or type(native_import.get("native_cases")) is not int
        or native_import.get("native_cases") != 1
        or native_import.get("common_metric_eligible") is not False
        or native_import.get("runner_replay_eligible") is not False
        or (
            engine == "giskard"
            and any(
                type(native_import.get(field)) is not int
                or native_import.get(field) != 1
                for field in (
                    "dataset_rows",
                    "generated_requirements",
                    "generated_samples_per_requirement",
                )
            )
        )
    ):
        raise Phase8Error(f"{engine}: native import summary differs")


def _require_terminal_attempt(
    attempt: Path,
    *,
    expected_exit: int,
    failure_names: Sequence[str],
    label: str,
) -> None:
    _exit_path, exit_payload = _stable_regular_bytes(
        attempt / ".exit", label=f"{label} exit marker", max_bytes=32
    )
    if exit_payload != f"{expected_exit}\n".encode("ascii"):
        raise Phase8Error(f"{label} exit marker differs")
    for name in failure_names:
        candidate = attempt / name
        if candidate.exists() or candidate.is_symlink():
            raise Phase8Error(f"{label} retains {name}")


def _require_digest_bound(value: object, digest: str, *, label: str) -> None:
    if digest not in descriptor_digests(value):
        raise Phase8Error(f"{label} does not descriptor-bind {digest}")


def _lane_inventory(value: Mapping[str, Any]) -> set[str]:
    candidates: list[object] = [
        value.get("runnable_lanes"),
        value.get("completed_lanes"),
        value.get("lane_order"),
        value.get("lanes"),
    ]
    for raw in candidates:
        if isinstance(raw, list) and all(isinstance(item, str) for item in raw):
            return set(raw)
        if isinstance(raw, dict) and all(isinstance(item, str) for item in raw):
            return set(raw)
    return set()


def validate_core_completion(
    path: Path,
    *,
    code_identity: Mapping[str, Any],
    manifest_sha: str,
    runnote_sha: str,
    promotion_sha: str,
    runner_root: Path,
    work_root: Path,
    model_store: Path,
    gate5_profile: Mapping[str, Any],
    payload: bytes | None = None,
) -> dict[str, Any]:
    historical_identity = _require_code_identity(
        code_identity, label="Phase 6 core"
    )
    scheduled_lanes = list(gate5_profile["scheduled_core_lanes"])
    conditional_na_lanes = list(gate5_profile["conditional_na_lanes"])
    path = checked_file(path, label="Phase 6 core completion")
    if payload is None:
        _path, payload = _stable_regular_bytes(
            path, label="Phase 6 core completion", max_bytes=MAX_JSON_BYTES
        )
    value = strict_loads(payload, label="Phase 6 core completion")
    if not isinstance(value, dict):
        raise Phase8Error("Phase 6 core completion must contain one JSON object")
    expected_fields = {
        "schema",
        "status",
        "completed_at_utc",
        "expected_commit",
        "framework_lock_id",
        "control_root",
        "attempt_root",
        "gate5_manifest",
        "gate5_runnote",
        "gate5_promotion_receipt",
        "payload",
        "launch",
        "events",
        "summary",
        "contract_self_test",
        "inventory_complete",
        "all_independent_lanes_attempted",
        "lane_order",
        "lane_terminal_states",
        "lane_results",
        "lane_failures",
        "conditional_na_lanes",
        "controller_exit_code",
        "hosted_target_calls",
        "hosted_judge_calls",
        "provider_http_attempts",
        "downloads_observed_bytes",
    }
    if (
        set(value) != expected_fields
        or value.get("schema") != "ura-phase6-core-controller-completion/1"
        or value.get("status") not in {"complete", "complete_with_failures"}
        or not UTC_RE.fullmatch(str(value.get("completed_at_utc", "")))
        or value.get("expected_commit") != historical_identity["expected_commit"]
        or value.get("framework_lock_id")
        != historical_identity["framework_lock_id"]
        or value.get("inventory_complete") is not True
        or value.get("all_independent_lanes_attempted") is not True
        or value.get("lane_order") != scheduled_lanes
        or value.get("conditional_na_lanes") != conditional_na_lanes
    ):
        raise Phase8Error("Phase 6 core completion identity or inventory differs")
    _validate_zero_local_fields(value, label="Phase 6 core completion")

    control = checked_dir(
        str(value.get("control_root", "")), label="Phase 6 core control root"
    )
    runner_root = checked_dir(runner_root, label="Phase 6 canonical Runner root")
    attempt = checked_dir(
        str(value.get("attempt_root", "")), label="Phase 6 core attempt root"
    )
    if path != attempt / "completion.json" or attempt.parent != control / "attempts":
        raise Phase8Error("Phase 6 core completion moved outside its sealed attempt")
    engineering_root = checked_dir(
        work_root / "runs" / "engineering", label="canonical engineering root"
    )
    if control.parent != engineering_root or not control.name.startswith(
        "phase6-core-measured-"
    ):
        raise Phase8Error("Phase 6 core control root is not canonical")

    states = value.get("lane_terminal_states")
    results = value.get("lane_results")
    failures = value.get("lane_failures")
    if (
        not isinstance(states, dict)
        or set(states) != set(scheduled_lanes)
        or any(
            state not in {"measured_complete", "failed"} for state in states.values()
        )
        or not isinstance(results, dict)
        or not isinstance(failures, dict)
    ):
        raise Phase8Error("Phase 6 core lane terminal inventory differs")
    completed_lanes = [
        lane for lane in scheduled_lanes if states[lane] == "measured_complete"
    ]
    failed_lanes = [lane for lane in scheduled_lanes if states[lane] == "failed"]
    if (
        set(results) != set(completed_lanes)
        or set(failures) != set(failed_lanes)
        or set(results) & set(failures)
        or set(results) | set(failures) != set(scheduled_lanes)
    ):
        raise Phase8Error("Phase 6 core result/failure partition differs")
    expected_status = "complete_with_failures" if failed_lanes else "complete"
    expected_exit = 1 if failed_lanes else 0
    if (
        value.get("status") != expected_status
        or type(value.get("controller_exit_code")) is not int
        or value.get("controller_exit_code") != expected_exit
    ):
        raise Phase8Error("Phase 6 core status/exit differs from lane terminals")
    _require_terminal_attempt(
        attempt,
        expected_exit=expected_exit,
        failure_names=("failure.json", "completion.invalidated.json"),
        label="Phase 6 core attempt",
    )

    descriptor_observations = {
        "gate5_manifest": descriptor_bytes(
            value["gate5_manifest"], label="Phase 6 core Gate 5 manifest"
        ),
        "gate5_runnote": descriptor_bytes(
            value["gate5_runnote"], label="Phase 6 core canonical RUNNOTE"
        ),
        "gate5_promotion_receipt": descriptor_bytes(
            value["gate5_promotion_receipt"],
            label="Phase 6 core Gate 5 promotion receipt",
        ),
        "payload": descriptor_bytes(value["payload"], label="Phase 6 core payload"),
        "launch": descriptor_bytes(value["launch"], label="Phase 6 core launch"),
        "events": descriptor_bytes(value["events"], label="Phase 6 core events"),
        "summary": descriptor_bytes(value["summary"], label="Phase 6 core summary"),
        "contract_self_test": descriptor_bytes(
            value["contract_self_test"], label="Phase 6 core contract self-test"
        ),
    }
    descriptor_paths = {
        field: observation[0]
        for field, observation in descriptor_observations.items()
    }
    require_descriptor_identity(
        value["payload"],
        expected=phase6_payload_identity(
            "core",
            expected_commit=historical_identity["expected_commit"],
            label="Phase 6 core payload",
        ),
        label="Phase 6 core payload",
    )
    copied_gate5 = strict_loads(
        descriptor_observations["gate5_manifest"][1],
        label="Phase 6 core Gate 5 manifest",
    )
    copied_gate5_identity = (
        _require_code_identity(
            copied_gate5.get("code_identity"),
            label="Phase 6 core Gate 5 manifest",
        )
        if isinstance(copied_gate5, dict)
        else None
    )
    if (
        copied_gate5_identity != historical_identity
        or sha256_bytes(descriptor_observations["gate5_manifest"][1]) != manifest_sha
        or sha256_bytes(descriptor_observations["gate5_runnote"][1]) != runnote_sha
        or sha256_bytes(descriptor_observations["gate5_promotion_receipt"][1])
        != promotion_sha
        or descriptor_paths["gate5_manifest"]
        != control / "inputs" / "covered-manifest.json"
        or descriptor_paths["gate5_runnote"] != control / "inputs" / "RUNNOTE.md"
        or descriptor_paths["gate5_promotion_receipt"]
        != control / "inputs" / "RUNNOTE.gate5-promotion.receipt.json"
        or descriptor_paths["payload"] != control / "payload.sh"
        or descriptor_paths["launch"] != control / "launch.json"
        or descriptor_paths["events"] != attempt / "events.snapshot.tsv"
        or descriptor_paths["summary"] != attempt / "summary.json"
        or descriptor_paths["contract_self_test"] != attempt / "contract-self-test.json"
    ):
        raise Phase8Error("Phase 6 core controller artifact placement differs")

    launch = strict_loads(
        descriptor_observations["launch"][1], label="Phase 6 core launch"
    )
    if not isinstance(launch, dict):
        raise Phase8Error("Phase 6 core launch must contain one JSON object")
    launch_fields = {
        "schema",
        "expected_commit",
        "framework_lock_id",
        "manifest_sha256",
        "authorized_manifest_sha256",
        "manifest",
        "runnote",
        "promotion_receipt",
        "payload",
        "control_root",
    }
    if (
        set(launch) != launch_fields
        or launch.get("schema") != "ura-phase6-core-controller-launch/1"
        or launch.get("expected_commit") != historical_identity["expected_commit"]
        or launch.get("framework_lock_id")
        != historical_identity["framework_lock_id"]
        or launch.get("manifest_sha256") != manifest_sha
        or launch.get("authorized_manifest_sha256") != manifest_sha
        or launch.get("control_root") != str(control)
    ):
        raise Phase8Error("Phase 6 core launch identity differs")
    for field, expected_sha in (
        ("manifest", manifest_sha),
        ("runnote", runnote_sha),
        ("promotion_receipt", promotion_sha),
        ("payload", str(value["payload"]["sha256"])),
    ):
        completion_field = {
            "manifest": "gate5_manifest",
            "runnote": "gate5_runnote",
            "promotion_receipt": "gate5_promotion_receipt",
            "payload": "payload",
        }[field]
        if (
            launch.get(field) != value[completion_field]
            or not isinstance(launch.get(field), dict)
            or launch[field].get("sha256") != expected_sha
        ):
            raise Phase8Error(f"Phase 6 core launch {field} digest differs")

    summary = strict_loads(
        descriptor_observations["summary"][1], label="Phase 6 core summary"
    )
    if not isinstance(summary, dict):
        raise Phase8Error("Phase 6 core summary must contain one JSON object")
    summary_fields = {
        "schema",
        "status",
        "completed_at_utc",
        "attempt",
        "expected_commit",
        "framework_lock_id",
        "lane_order",
        "lane_terminal_states",
        "completed_lanes",
        "failed_lanes",
        "lane_results",
        "lane_failures",
        "conditional_na_lanes",
        "contract_self_test",
        "inventory_complete",
        "all_independent_lanes_attempted",
        "controller_exit_code",
        "hosted_target_calls",
        "hosted_judge_calls",
        "provider_http_attempts",
        "downloads_observed_bytes",
    }
    if (
        set(summary) != summary_fields
        or summary.get("schema") != "ura-phase6-core-controller-summary/1"
        or summary.get("status") != expected_status
        or not UTC_RE.fullmatch(str(summary.get("completed_at_utc", "")))
        or summary.get("attempt") != attempt.name
        or summary.get("expected_commit") != historical_identity["expected_commit"]
        or summary.get("framework_lock_id")
        != historical_identity["framework_lock_id"]
        or summary.get("lane_order") != scheduled_lanes
        or summary.get("conditional_na_lanes") != conditional_na_lanes
        or summary.get("lane_terminal_states") != states
        or summary.get("completed_lanes") != completed_lanes
        or summary.get("failed_lanes") != failed_lanes
        or summary.get("lane_results") != results
        or summary.get("lane_failures") != failures
        or summary.get("contract_self_test") != value["contract_self_test"]
        or summary.get("inventory_complete") is not True
        or summary.get("all_independent_lanes_attempted") is not True
        or type(summary.get("controller_exit_code")) is not int
        or summary.get("controller_exit_code") != expected_exit
    ):
        raise Phase8Error("Phase 6 core completion/summary accounting differs")
    _validate_zero_local_fields(summary, label="Phase 6 core summary")

    contract_test = strict_loads(
        descriptor_observations["contract_self_test"][1],
        label="Phase 6 core contract self-test",
    )
    if not isinstance(contract_test, dict):
        raise Phase8Error("Phase 6 core contract self-test must be one object")
    if contract_test != {
        "schema": "ura-phase6-core-attempt-contract-self-test/1",
        "status": "passed",
        "mutations_rejected": [
            "missing-terminal",
            "duplicate-terminal",
            "mis-typed-state",
            "missing-attempt",
            "terminal-before-attempt",
            "status-mismatch",
        ],
        "early_failure_followed_by_later_attempt": True,
        "actual_lane_terminal_states": states,
    }:
        raise Phase8Error("Phase 6 core attempt contract self-test differs")

    try:
        event_lines = descriptor_observations["events"][1].decode("utf-8").splitlines()
    except UnicodeDecodeError as exc:
        raise Phase8Error("Phase 6 core event snapshot is not UTF-8") from exc
    event_reader = csv.DictReader(event_lines, delimiter="\t")
    event_rows = list(event_reader)
    if event_reader.fieldnames != [
        "attempt",
        "time_utc",
        "lane",
        "stage",
        "status",
        "detail",
    ] or any(None in row for row in event_rows):
        raise Phase8Error("Phase 6 core event snapshot shape differs")
    starts = [
        (index, row)
        for index, row in enumerate(event_rows)
        if row.get("stage") == "lane-attempt" and row.get("status") == "start"
    ]
    terminals = [
        (index, row)
        for index, row in enumerate(event_rows)
        if row.get("stage") == "measured"
        and row.get("status") in {"complete", "complete-existing", "failed"}
    ]
    if (
        any(row.get("attempt") != attempt.name for row in event_rows)
        or len(starts) != len(scheduled_lanes)
        or len(terminals) != len(scheduled_lanes)
        or {row.get("lane") for _, row in starts} != set(scheduled_lanes)
        or {row.get("lane") for _, row in terminals} != set(scheduled_lanes)
    ):
        raise Phase8Error("Phase 6 core independent-attempt event inventory differs")
    start_index = {str(row["lane"]): index for index, row in starts}
    terminal_index = {str(row["lane"]): index for index, row in terminals}
    if any(start_index[lane] >= terminal_index[lane] for lane in scheduled_lanes):
        raise Phase8Error("Phase 6 core terminal event precedes its lane attempt")
    terminal_by_lane = {str(row["lane"]): row for _, row in terminals}
    event_states = {
        lane: (
            "failed"
            if terminal_by_lane[lane]["status"] == "failed"
            else "measured_complete"
        )
        for lane in scheduled_lanes
    }
    if event_states != states:
        raise Phase8Error("Phase 6 core event terminals disagree with completion")

    result_fields = {
        "schema",
        "status",
        "lane_id",
        "attempt",
        "terminal_event",
        "lane_spec",
        "exact_measured_argv",
        "live_attestation",
        "attestation_acquisition_plan",
        "attestation_acquisition_receipt",
        "attestation_acquisition_log",
        "model_acquisition_plan",
        "model_acquisition_receipt",
        "model_acquisition_log",
        "level1_evidence",
        "result_root",
        "grid",
        "projection",
        "eligibility",
        "request_envelope",
        "call_budget",
    }
    result_descriptor_fields = result_fields - {
        "schema",
        "status",
        "lane_id",
        "attempt",
        "terminal_event",
        "result_root",
    }
    spec_by_lane: dict[str, Path] = {}
    observed_spec_lanes: set[str] = set()
    if conditional_na_lanes:
        forbidden_defense_paths = (
            control / "lane-specs" / "10-defense-local.json",
            control / "lanes" / DEFENSE_LOCAL_LANE,
            attempt / f"{DEFENSE_LOCAL_LANE}.result.json",
            attempt / f"{DEFENSE_LOCAL_LANE}.failure.json",
        )
        if any(path.exists() or path.is_symlink() for path in forbidden_defense_paths):
            raise Phase8Error(
                "conditional defense N/A retains Phase 6 spec, state, result, "
                "failure, grid, or evidence"
            )
    for index, lane in enumerate(scheduled_lanes, start=1):
        spec_path = checked_file(
            control / "lane-specs" / f"{index:02d}-{lane}.json",
            label=f"{lane} Phase 6 core lane spec",
        )
        spec = strict_object(spec_path, label=f"{lane} Phase 6 core lane spec")
        spec_lane = spec.get("lane_id")
        if (
            spec.get("schema") != "ura-phase6-core-lane-spec/1"
            or not isinstance(spec_lane, str)
            or spec_lane != lane
            or spec_lane in observed_spec_lanes
        ):
            raise Phase8Error(f"{lane}: Phase 6 core lane spec identity differs")
        observed_spec_lanes.add(spec_lane)
        spec_by_lane[lane] = spec_path
    if observed_spec_lanes != set(scheduled_lanes):
        raise Phase8Error("Phase 6 core lane-spec identifier inventory differs")
    expected_spec_paths = {
        control / "lane-specs" / f"{index:02d}-{lane}.json"
        for index, lane in enumerate(scheduled_lanes, start=1)
    }
    observed_spec_paths = {
        path.resolve()
        for path in (control / "lane-specs").glob("*.json")
        if path.is_file() and not path.is_symlink()
    }
    if observed_spec_paths != expected_spec_paths:
        raise Phase8Error("Phase 6 core lane-spec directory contains extras")
    for lane in completed_lanes:
        result_path, result = descriptor_object(
            results[lane], label=f"{lane} Phase 6 core result receipt"
        )
        if result_path != attempt / f"{lane}.result.json":
            raise Phase8Error(f"{lane}: Phase 6 core result receipt moved")
        expected_event = {
            "status": terminal_by_lane[lane]["status"],
            "detail": terminal_by_lane[lane]["detail"],
        }
        if (
            set(result) != result_fields
            or result.get("schema") != "ura-phase6-core-lane-result/1"
            or result.get("status") != "complete"
            or result.get("lane_id") != lane
            or result.get("attempt") != attempt.name
            or result.get("terminal_event") != expected_event
        ):
            raise Phase8Error(f"{lane}: Phase 6 core measured result differs")
        result_root = checked_dir(
            str(result.get("result_root", "")),
            label=f"{lane} Phase 6 core measured result root",
        )
        if result_root != runner_root / lane:
            raise Phase8Error(f"{lane}: Phase 6 core result root differs")
        artifact_observations = {
            field: descriptor_bytes(result[field], label=f"{lane} Phase 6 core {field}")
            for field in result_descriptor_fields
        }
        artifact_paths = {
            field: observation[0]
            for field, observation in artifact_observations.items()
        }
        if (
            artifact_paths["lane_spec"] != spec_by_lane[lane]
            or artifact_paths["exact_measured_argv"]
            != control / "lanes" / lane / "exact-measured-argv.json"
            or artifact_paths["level1_evidence"].parent != attempt
            or any(
                artifact_paths[field].parent != result_root
                for field in (
                    "grid",
                    "projection",
                    "eligibility",
                    "request_envelope",
                    "call_budget",
                )
            )
        ):
            raise Phase8Error(f"{lane}: Phase 6 core result artifact placement differs")
        state = strict_loads(
            artifact_observations["exact_measured_argv"][1],
            label=f"{lane} Phase 6 core measured argv",
        )
        if not isinstance(state, dict):
            raise Phase8Error(f"{lane}: sealed measured argv is not one object")
        state_fields = {
            "schema",
            "lane_spec",
            "result_root",
            "probe_root",
            "live_attestation",
            "attestation_acquisition",
            "model_acquisition",
            "runner_argv",
            "resume_semantics",
        }
        if (
            set(state) != state_fields
            or state.get("schema") != "ura-phase6-core-measured-argv/1"
            or state.get("lane_spec") != result["lane_spec"]
            or state.get("result_root") != str(result_root)
            or state.get("resume_semantics")
            != "invoke_exact_runner_argv_or_accept_strictly_revalidated_complete_runner_grid"
            or not isinstance(state.get("runner_argv"), list)
            or not state["runner_argv"]
            or any(
                not isinstance(token, str) or not token
                for token in state["runner_argv"]
            )
        ):
            raise Phase8Error(f"{lane}: sealed measured argv differs")
        probe_root = checked_dir(
            str(state.get("probe_root", "")),
            label=f"{lane} Phase 6 core probe root",
        )
        if not is_beneath(probe_root, work_root / "runs"):
            raise Phase8Error(f"{lane}: Phase 6 core probe root escaped")
        live_path, live_payload = short_descriptor_bytes(
            state.get("live_attestation"), label=f"{lane} live attestation state"
        )
        if descriptor_from_bytes(live_path, live_payload) != result["live_attestation"]:
            raise Phase8Error(f"{lane}: live attestation lineage differs")

        def validate_acquisition(
            raw: object,
            *,
            prefix: str,
            result_fields: tuple[str, str, str],
        ) -> None:
            if (
                not isinstance(raw, dict)
                or set(raw)
                != {"plan", "receipt", "controller_log", "store", "downloaded_bytes"}
                or raw.get("store") != str(model_store)
                or type(raw.get("downloaded_bytes")) is not int
                or raw.get("downloaded_bytes") != 0
            ):
                raise Phase8Error(f"{lane}: {prefix} acquisition state differs")
            plan_path, plan_payload = short_descriptor_bytes(
                raw["plan"], label=f"{lane} {prefix} acquisition plan"
            )
            receipt_path, receipt_payload = short_descriptor_bytes(
                raw["receipt"], label=f"{lane} {prefix} acquisition receipt"
            )
            log_path, log_payload = descriptor_bytes(
                raw["controller_log"], label=f"{lane} {prefix} acquisition log"
            )
            for artifact, artifact_payload, field in zip(
                (plan_path, receipt_path, log_path),
                (plan_payload, receipt_payload, log_payload),
                result_fields,
                strict=True,
            ):
                if descriptor_from_bytes(artifact, artifact_payload) != result[field]:
                    raise Phase8Error(f"{lane}: {prefix} acquisition lineage differs")

        validate_acquisition(
            state.get("attestation_acquisition"),
            prefix="attestation",
            result_fields=(
                "attestation_acquisition_plan",
                "attestation_acquisition_receipt",
                "attestation_acquisition_log",
            ),
        )
        validate_acquisition(
            state.get("model_acquisition"),
            prefix="measured",
            result_fields=(
                "model_acquisition_plan",
                "model_acquisition_receipt",
                "model_acquisition_log",
            ),
        )
        expected_level1 = attempt / (
            f"{lane}.adoption-check.level1.json"
            if terminal_by_lane[lane]["status"] == "complete-existing"
            else f"{lane}.level1.json"
        )
        level1 = strict_loads(
            artifact_observations["level1_evidence"][1],
            label=f"{lane} Phase 6 core Level 1 evidence",
        )
        if not isinstance(level1, dict):
            raise Phase8Error(f"{lane}: Phase 6 core Level 1 evidence is not one object")
        if (
            artifact_paths["level1_evidence"] != expected_level1
            or level1.get("schema_version") != "ura-level1-evidence/3"
            or level1.get("status") != "validated_unit_qualified_lifecycle_inventory"
            or not isinstance(level1.get("scope"), dict)
            or level1["scope"].get("evidence_kind") != "measured_run"
        ):
            raise Phase8Error(f"{lane}: Phase 6 core Level 1 evidence differs")
        patterns = {
            "grid": "*.grid.json",
            "projection": "lane-projection-*.lane-projection.json",
            "eligibility": "eligibility-*.eligibility.json",
            "request_envelope": "request-envelope-*.request-envelope.json",
            "call_budget": "*.budget.json",
        }
        for field, pattern in patterns.items():
            matches = sorted(result_root.glob(pattern))
            if len(matches) != 1 or matches[0] != artifact_paths[field]:
                raise Phase8Error(
                    f"{lane}: Phase 6 core {field} artifact cardinality differs"
                )
        grid = strict_loads(
            artifact_observations["grid"][1],
            label=f"{lane} Phase 6 core grid",
        )
        if not isinstance(grid, dict):
            raise Phase8Error(f"{lane}: Phase 6 core grid is not one object")
        if (
            grid.get("status") != "complete"
            or type(grid.get("n_errors")) is not int
            or grid.get("n_errors") != 0
        ):
            raise Phase8Error(f"{lane}: Phase 6 core grid is not complete")
        opposite = attempt / f"{lane}.failure.json"
        if opposite.exists() or opposite.is_symlink():
            raise Phase8Error(f"{lane}: successful core lane retains a failure")

    failure_fields = {
        "schema",
        "status",
        "lane_id",
        "attempt",
        "failed_at_utc",
        "returncode",
        "stage",
        "error_type",
        "error",
        "terminal_event",
        "lane_spec",
        "exact_measured_argv",
        "result_root",
        "evidence_eligible",
        "retry_semantics",
        "hosted_target_calls",
        "hosted_judge_calls",
        "provider_http_attempts",
        "downloads_observed_bytes",
    }
    for lane in failed_lanes:
        failure_path, failure = descriptor_object(
            failures[lane], label=f"{lane} Phase 6 core failure receipt"
        )
        if failure_path != attempt / f"{lane}.failure.json":
            raise Phase8Error(f"{lane}: Phase 6 core failure receipt moved")
        expected_event = {
            "status": "failed",
            "detail": terminal_by_lane[lane]["detail"],
        }
        result_root = Path(str(failure.get("result_root", "")))
        if (
            set(failure) != failure_fields
            or failure.get("schema") != "ura-phase6-core-lane-failure/1"
            or failure.get("status") != "failed"
            or failure.get("lane_id") != lane
            or failure.get("attempt") != attempt.name
            or not UTC_RE.fullmatch(str(failure.get("failed_at_utc", "")))
            or type(failure.get("returncode")) is not int
            or not 1 <= failure["returncode"] <= 255
            or not isinstance(failure.get("stage"), str)
            or not failure["stage"]
            or failure.get("error_type") != "lane_controller_nonzero_exit"
            or failure.get("error")
            != f"lane controller exited {failure.get('returncode')}; no measured evidence admitted"
            or failure.get("error") != expected_event["detail"]
            or failure.get("terminal_event") != expected_event
            or failure.get("evidence_eligible") is not False
            or failure.get("retry_semantics")
            != "next controller attempt revalidates complete Runner state or retries the exact sealed argv"
            or not result_root.is_absolute()
            or result_root.is_symlink()
            or result_root.resolve() != runner_root / lane
        ):
            raise Phase8Error(f"{lane}: Phase 6 core typed failure differs")
        if (
            descriptor_file(failure["lane_spec"], label=f"{lane} core failure spec")
            != spec_by_lane[lane]
        ):
            raise Phase8Error(f"{lane}: failed core lane spec differs")
        if failure.get("exact_measured_argv") is not None:
            failed_argv = descriptor_file(
                failure["exact_measured_argv"],
                label=f"{lane} failed core exact argv",
            )
            if failed_argv != control / "lanes" / lane / "exact-measured-argv.json":
                raise Phase8Error(f"{lane}: failed core exact argv moved")
        elif (control / "lanes" / lane / "exact-measured-argv.json").exists() or (
            control / "lanes" / lane / "exact-measured-argv.json"
        ).is_symlink():
            raise Phase8Error(f"{lane}: failed core lane omitted its sealed argv")
        _validate_zero_local_fields(failure, label=f"{lane} Phase 6 core failure")
        opposite = attempt / f"{lane}.result.json"
        if opposite.exists() or opposite.is_symlink():
            raise Phase8Error(f"{lane}: failed core lane retains measured evidence")

    for row in collect_descriptors(value):
        descriptor_file(row, label="Phase 6 core bound artifact")
    return value


def validate_extended_completion(
    path: Path,
    *,
    code_identity: Mapping[str, Any],
    manifest_sha: str,
    runnote_sha: str,
    promotion_sha: str,
    work_root: Path,
    validate_gate5_artifacts: bool = True,
    payload: bytes | None = None,
) -> dict[str, Any]:
    historical_identity = _require_code_identity(
        code_identity, label="Phase 6 extended"
    )
    path = checked_file(path, label="Phase 6 extended completion")
    if payload is None:
        _path, payload = _stable_regular_bytes(
            path, label="Phase 6 extended completion", max_bytes=MAX_JSON_BYTES
        )
    value = strict_loads(payload, label="Phase 6 extended completion")
    if not isinstance(value, dict):
        raise Phase8Error("Phase 6 extended completion must contain one JSON object")
    expected_fields = {
        "schema",
        "status",
        "controller_exit_code",
        "completed_at_utc",
        "attempt",
        "expected_commit",
        "framework_lock_id",
        "inventory_complete",
        "runnable_lanes",
        "lane_terminal_states",
        "typed_terminal_lanes",
        "conditional_na_lanes",
        "gate5_inputs",
        "launch",
        "payload",
        "summary",
        "typed_dispositions",
        "lane_results",
        "lane_failures",
        "terminal_results",
        "all_independent_lanes_attempted",
        "hosted_target_calls",
        "hosted_judge_calls",
        "http_attempts",
        "paid_provider_calls",
        "model_downloads",
        "downloads_observed_bytes",
    }
    attempt = value.get("attempt")
    if (
        set(value) != expected_fields
        or value.get("schema") != "ura-phase6-extended-controller-completion/1"
        or value.get("status") not in {"complete", "complete_with_failures"}
        or not UTC_RE.fullmatch(str(value.get("completed_at_utc", "")))
        or not isinstance(attempt, str)
        or not attempt
        or Path(attempt).name != attempt
        or value.get("expected_commit") != historical_identity["expected_commit"]
        or value.get("framework_lock_id")
        != historical_identity["framework_lock_id"]
        or value.get("inventory_complete") is not True
        or value.get("all_independent_lanes_attempted") is not True
        or value.get("conditional_na_lanes")
        not in ([], [DEFENSE_LOCAL_LANE])
    ):
        raise Phase8Error("Phase 6 extended completion identity or status differs")
    exact_zero_fields(
        value,
        (
            "hosted_target_calls",
            "hosted_judge_calls",
            "http_attempts",
            "paid_provider_calls",
            "model_downloads",
            "downloads_observed_bytes",
        ),
        label="Phase 6 extended completion",
    )
    runnable_lanes = value.get("runnable_lanes")
    if (
        not isinstance(runnable_lanes, list)
        or not runnable_lanes
        or len(runnable_lanes) != len(set(runnable_lanes))
        or any(lane not in EXTENDED_LANES for lane in runnable_lanes)
        or runnable_lanes
        != [lane for lane in EXTENDED_LANES if lane in set(runnable_lanes)]
    ):
        raise Phase8Error("Phase 6 extended runnable-lane inventory differs")
    scheduled_extended_lanes = tuple(runnable_lanes)

    states = value.get("lane_terminal_states")
    lane_results = value.get("lane_results")
    lane_failures = value.get("lane_failures")
    if (
        not isinstance(states, dict)
        or set(states) != set(scheduled_extended_lanes)
        or any(
            state not in {"measured_complete", "failed"} for state in states.values()
        )
        or not isinstance(lane_results, dict)
        or not isinstance(lane_failures, dict)
    ):
        raise Phase8Error("Phase 6 extended terminal-state inventory differs")
    completed_lanes = [
        lane
        for lane in scheduled_extended_lanes
        if states[lane] == "measured_complete"
    ]
    failed_lanes = [
        lane for lane in scheduled_extended_lanes if states[lane] == "failed"
    ]
    if (
        set(lane_results) != set(completed_lanes)
        or set(lane_failures) != set(failed_lanes)
        or set(lane_results) & set(lane_failures)
        or set(lane_results) | set(lane_failures)
        != set(scheduled_extended_lanes)
    ):
        raise Phase8Error("Phase 6 extended result/failure partition differs")
    expected_status = "complete_with_failures" if failed_lanes else "complete"
    expected_exit = 1 if failed_lanes else 0
    if (
        value.get("status") != expected_status
        or type(value.get("controller_exit_code")) is not int
        or value.get("controller_exit_code") != expected_exit
    ):
        raise Phase8Error("Phase 6 extended status/exit differs from lane terminals")

    inputs = value.get("gate5_inputs")
    if not isinstance(inputs, dict) or set(inputs) != {
        "manifest",
        "canonical_runnote",
        "promotion_receipt",
    }:
        raise Phase8Error("Phase 6 extended Gate 5 input fields differ")
    manifest_path, manifest_payload = extended_descriptor_bytes(
        inputs["manifest"], label="Phase 6 extended Gate 5 manifest"
    )
    runnote_path, runnote_payload = extended_descriptor_bytes(
        inputs["canonical_runnote"], label="Phase 6 extended canonical RUNNOTE"
    )
    promotion_path, promotion_payload = extended_descriptor_bytes(
        inputs["promotion_receipt"],
        label="Phase 6 extended Gate 5 promotion receipt",
    )
    if (
        sha256_bytes(manifest_payload) != manifest_sha
        or sha256_bytes(runnote_payload) != runnote_sha
        or sha256_bytes(promotion_payload) != promotion_sha
    ):
        raise Phase8Error("Phase 6 extended Gate 5 input digests differ")
    gate5 = strict_loads(manifest_payload, label="Phase 6 extended Gate 5 manifest")
    if not isinstance(gate5, dict):
        raise Phase8Error("Phase 6 extended Gate 5 manifest is not one object")
    copied_gate5_identity = _require_code_identity(
        gate5.get("code_identity"), label="Phase 6 extended Gate 5 manifest"
    )
    if copied_gate5_identity != historical_identity:
        raise Phase8Error("Phase 6 extended Gate 5 code identity differs")
    gate5_runnable, gate5_terminals = _exact_inventory(
        gate5.get("lanes"),
        validate_artifact=validate_gate5_artifacts,
        code_identity=copied_gate5_identity,
    )
    gate5_profile = _gate5_profile(gate5_runnable, gate5_terminals)
    conditional_na_lanes = list(gate5_profile["conditional_na_lanes"])
    expected_terminals = {
        **EXTENDED_BASE_TERMINALS,
        **{
            lane: OLLAMA_STATIC_TERMINAL_DISPOSITION
            for lane in gate5_profile["ollama_static_terminal_lanes"]
        },
    }
    if (
        list(scheduled_extended_lanes)
        != gate5_profile["scheduled_extended_lanes"]
        or value.get("typed_terminal_lanes") != expected_terminals
        or value.get("conditional_na_lanes") != conditional_na_lanes
    ):
        raise Phase8Error("Phase 6 extended conditional Gate 5 profile differs")

    launch_path, launch_payload = extended_descriptor_bytes(
        value.get("launch"), label="Phase 6 extended launch"
    )
    payload_path, _frozen_payload = extended_descriptor_bytes(
        value.get("payload"), label="Phase 6 extended payload"
    )
    require_descriptor_identity(
        value["payload"],
        expected=phase6_payload_identity(
            "extended",
            expected_commit=historical_identity["expected_commit"],
            label="Phase 6 extended payload",
        ),
        label="Phase 6 extended payload",
    )
    summary_path, summary_payload = extended_descriptor_bytes(
        value.get("summary"), label="Phase 6 extended summary"
    )
    dispositions_path, dispositions_payload = extended_descriptor_bytes(
        value.get("typed_dispositions"),
        label="Phase 6 extended typed dispositions",
    )
    control_root = path.parent.parent.parent
    if (
        path.parent.name != attempt
        or path.parent.parent.name != "attempts"
        or not control_root.is_dir()
    ):
        raise Phase8Error("Phase 6 extended completion moved outside its attempt")
    control_root = checked_dir(control_root, label="Phase 6 extended control root")
    engineering_root = checked_dir(
        work_root / "runs" / "engineering", label="canonical engineering root"
    )
    if (
        control_root.parent != engineering_root
        or not control_root.name.startswith("phase6-extended-measured-")
        or launch_path != control_root / "launch.json"
        or manifest_path != control_root / "inputs" / "covered-manifest.json"
        or runnote_path != control_root / "inputs" / "RUNNOTE.md"
        or promotion_path
        != control_root / "inputs" / "RUNNOTE.gate5-promotion.receipt.json"
        or summary_path != path.parent / "summary.json"
        or dispositions_path != control_root / "typed-dispositions.json"
        or payload_path != control_root / "payload.py"
    ):
        raise Phase8Error("Phase 6 extended controller artifact placement differs")
    _require_terminal_attempt(
        path.parent,
        expected_exit=expected_exit,
        failure_names=("controller-failure.json",),
        label="Phase 6 extended attempt",
    )

    launch = strict_loads(launch_payload, label="Phase 6 extended launch")
    if not isinstance(launch, dict):
        raise Phase8Error("Phase 6 extended launch must contain one JSON object")
    launch_fields = {
        "schema",
        "expected_commit",
        "framework_lock_id",
        "manifest_sha256",
        "authorized_manifest_sha256",
        "manifest",
        "runnote",
        "promotion_receipt",
        "payload",
        "control_root",
    }
    if (
        set(launch) != launch_fields
        or launch.get("schema") != "ura-phase6-extended-controller-launch/1"
        or launch.get("expected_commit") != historical_identity["expected_commit"]
        or launch.get("framework_lock_id")
        != historical_identity["framework_lock_id"]
        or launch.get("manifest_sha256") != manifest_sha
        or launch.get("authorized_manifest_sha256") != manifest_sha
        or launch.get("control_root") != str(control_root.resolve(strict=True))
    ):
        raise Phase8Error("Phase 6 extended launch identity differs")
    for field, expected_sha in (
        ("manifest", manifest_sha),
        ("runnote", runnote_sha),
        ("promotion_receipt", promotion_sha),
        ("payload", str(value["payload"]["sha256"])),
    ):
        completion_field = {
            "manifest": inputs["manifest"],
            "runnote": inputs["canonical_runnote"],
            "promotion_receipt": inputs["promotion_receipt"],
            "payload": value["payload"],
        }[field]
        normalized_completion = {
            key: completion_field[key] for key in ("path", "sha256", "bytes")
        }
        if (
            launch.get(field) != normalized_completion
            or not isinstance(launch.get(field), dict)
            or launch[field].get("sha256") != expected_sha
        ):
            raise Phase8Error(f"Phase 6 extended launch {field} digest differs")

    summary = strict_loads(summary_payload, label="Phase 6 extended summary")
    if not isinstance(summary, dict):
        raise Phase8Error("Phase 6 extended summary must contain one JSON object")
    summary_fields = {
        "schema",
        "status",
        "controller_exit_code",
        "completed_at_utc",
        "attempt",
        "runnable_inventory",
        "lane_terminal_states",
        "completed_lanes",
        "failed_lanes",
        "typed_terminal_inventory",
        "conditional_na_lanes",
        "failures",
        "all_independent_lanes_attempted",
        "hosted_target_calls",
        "hosted_judge_calls",
        "http_attempts",
        "paid_provider_calls",
        "model_downloads",
        "downloads_observed_bytes",
    }
    if (
        set(summary) != summary_fields
        or summary.get("schema") != "ura-phase6-extended-controller-summary/1"
        or summary.get("status") != expected_status
        or type(summary.get("controller_exit_code")) is not int
        or summary.get("controller_exit_code") != expected_exit
        or not UTC_RE.fullmatch(str(summary.get("completed_at_utc", "")))
        or summary.get("attempt") != attempt
        or summary.get("runnable_inventory") != list(scheduled_extended_lanes)
        or summary.get("lane_terminal_states") != states
        or summary.get("completed_lanes") != sorted(completed_lanes)
        or summary.get("failed_lanes") != sorted(failed_lanes)
        or summary.get("typed_terminal_inventory") != expected_terminals
        or summary.get("conditional_na_lanes") != conditional_na_lanes
        or not isinstance(summary.get("failures"), list)
        or summary.get("all_independent_lanes_attempted") is not True
    ):
        raise Phase8Error("Phase 6 extended summary differs")
    exact_zero_fields(
        summary,
        (
            "hosted_target_calls",
            "hosted_judge_calls",
            "http_attempts",
            "paid_provider_calls",
            "model_downloads",
            "downloads_observed_bytes",
        ),
        label="Phase 6 extended summary",
    )

    expected_terminal_rows = [gate5_terminals[lane] for lane in expected_terminals]
    dispositions = strict_loads(
        dispositions_payload, label="Phase 6 extended typed dispositions"
    )
    if not isinstance(dispositions, dict):
        raise Phase8Error("Phase 6 extended typed dispositions must be one object")
    if dispositions != {
        "schema": "ura-phase6-extended-dispositions/1",
        "status": "complete",
        "rows": expected_terminal_rows,
    }:
        raise Phase8Error("Phase 6 extended typed dispositions differ")

    result_fields = {
        "status",
        "lane_id",
        "grid_id",
        "projection_id",
        "eligibility_plan_id",
        "target_calls_reserved",
        "target_call_cap",
        "retained_bytes",
        "guard_queries_observed",
    }
    for lane in completed_lanes:
        lane_path, lane_value = extended_descriptor_object(
            lane_results[lane], label=f"{lane} Phase 6 extended result"
        )
        if lane_path != path.parent / f"{lane}.complete.json":
            raise Phase8Error(f"{lane}: Phase 6 extended result moved")
        if (
            set(lane_value) != result_fields
            or lane_value.get("status") != "complete"
            or lane_value.get("lane_id") != lane
            or any(
                not isinstance(lane_value.get(field), str) or not lane_value[field]
                for field in ("grid_id", "projection_id", "eligibility_plan_id")
            )
        ):
            raise Phase8Error(f"{lane}: Phase 6 extended result differs")
        reserved = exact_int(
            lane_value.get("target_calls_reserved"),
            label=f"{lane} target calls reserved",
            minimum=1,
        )
        cap = exact_int(
            lane_value.get("target_call_cap"),
            label=f"{lane} target call cap",
            minimum=1,
        )
        exact_int(
            lane_value.get("retained_bytes"),
            label=f"{lane} retained bytes",
            minimum=1,
        )
        if reserved > cap:
            raise Phase8Error(f"{lane}: measured target calls exceed the cap")
        guard_queries = lane_value.get("guard_queries_observed")
        if lane.startswith("rjudge-"):
            if guard_queries is not None:
                raise Phase8Error(f"{lane}: source evaluator recorded guard queries")
        else:
            exact_int(
                guard_queries,
                label=f"{lane} observed guard queries",
                minimum=1,
            )
        opposite = path.parent / f"{lane}.failure.json"
        if opposite.exists() or opposite.is_symlink():
            raise Phase8Error(f"{lane}: successful extended lane retains failure")

    failure_fields = {
        "schema",
        "status",
        "failed_at_utc",
        "attempt",
        "lane_id",
        "stage",
        "error_type",
        "error",
    }
    failure_values: dict[str, dict[str, Any]] = {}
    for lane in failed_lanes:
        failure_path, failure = extended_descriptor_object(
            lane_failures[lane], label=f"{lane} Phase 6 extended failure"
        )
        if failure_path != path.parent / f"{lane}.failure.json":
            raise Phase8Error(f"{lane}: Phase 6 extended failure moved")
        if (
            set(failure) != failure_fields
            or failure.get("schema") != "ura-phase6-extended-lane-failure/1"
            or failure.get("status") != "failed"
            or not UTC_RE.fullmatch(str(failure.get("failed_at_utc", "")))
            or failure.get("attempt") != attempt
            or failure.get("lane_id") != lane
            or failure.get("stage") != "lane"
            or not isinstance(failure.get("error_type"), str)
            or not failure["error_type"]
            or not isinstance(failure.get("error"), str)
            or not failure["error"]
        ):
            raise Phase8Error(f"{lane}: Phase 6 extended typed failure differs")
        opposite = path.parent / f"{lane}.complete.json"
        if opposite.exists() or opposite.is_symlink():
            raise Phase8Error(f"{lane}: failed extended lane retains evidence")
        failure_values[lane] = failure
    if summary.get("failures") != [
        failure_values[lane]
        for lane in scheduled_extended_lanes
        if lane in failure_values
    ]:
        raise Phase8Error("Phase 6 extended summary failure inventory differs")

    terminal_results = value.get("terminal_results")
    if not isinstance(terminal_results, dict) or set(terminal_results) != set(
        expected_terminals
    ):
        raise Phase8Error("Phase 6 extended terminal-result inventory differs")
    for lane in expected_terminals:
        terminal_path, terminal_value = extended_descriptor_object(
            terminal_results[lane], label=f"{lane} Phase 6 extended terminal result"
        )
        if terminal_path != path.parent / f"{lane}.terminal.json" or terminal_value != {
            "schema": "ura-phase6-extended-terminal-result/1",
            "status": "typed_terminal",
            "lane_id": lane,
            "gate5_row": gate5_terminals[lane],
        }:
            raise Phase8Error(f"{lane}: Phase 6 extended terminal result differs")
    return value


def validate_native_completion(
    path: Path,
    *,
    manifest_sha: str,
    runnote_sha: str,
    promotion_sha: str,
    work_root: Path,
    payload: bytes | None = None,
) -> dict[str, Any]:
    path = checked_file(path, label="Phase 6 native completion")
    if payload is None:
        _path, payload = _stable_regular_bytes(
            path, label="Phase 6 native completion", max_bytes=MAX_JSON_BYTES
        )
    value = strict_loads(payload, label="Phase 6 native completion")
    if not isinstance(value, dict):
        raise Phase8Error("Phase 6 native completion must contain one JSON object")
    expected_fields = {
        "schema",
        "status",
        "completed_at_utc",
        "attempt",
        "expected_commit",
        "framework_lock_id",
        "gate5_inputs",
        "authorized_plan_sha256",
        "plan",
        "payload",
        "launch",
        "inventory_complete",
        "conditional_na_lanes",
        "engine_order",
        "terminal_states",
        "terminal_artifacts",
        "engine_reservations",
        "canonical_native_envelopes",
        "summary",
        "hosted_target_calls",
        "hosted_judge_calls",
        "provider_http_attempts",
        "downloads_observed_bytes",
        "local_model_calls",
        "authorized_local_call_cap",
        "contract_self_test",
        "all_independent_engines_attempted",
    }
    attempt_name = value.get("attempt")
    native_commit = value.get("expected_commit")
    local_calls = value.get("local_model_calls")
    if (
        set(value) != expected_fields
        or value.get("schema") != "ura-phase6-native-controller-completion/1"
        or value.get("status") not in {"complete", "complete_with_failures"}
        or not UTC_RE.fullmatch(str(value.get("completed_at_utc", "")))
        or not isinstance(attempt_name, str)
        or not attempt_name
        or Path(attempt_name).name != attempt_name
        or re.fullmatch(r"[0-9a-f]{40}", str(native_commit)) is None
        or value.get("framework_lock_id") != EXPECTED_FRAMEWORK_LOCK
        or value.get("inventory_complete") is not True
        or value.get("conditional_na_lanes")
        not in ([], [DEFENSE_LOCAL_LANE])
        or value.get("all_independent_engines_attempted") is not True
        or value.get("engine_order") != list(NATIVE_ENGINES)
        or type(value.get("authorized_local_call_cap")) is not int
        or value.get("authorized_local_call_cap") != NATIVE_AUTHORIZED_LOCAL_CALL_CAP
        or isinstance(local_calls, bool)
        or not isinstance(local_calls, int)
        or not 0 <= local_calls <= NATIVE_AUTHORIZED_LOCAL_CALL_CAP
    ):
        raise Phase8Error("Phase 6 native completion identity or inventory differs")
    attempt = checked_dir(path.parent, label="Phase 6 native attempt root")
    if (
        attempt.name != attempt_name
        or attempt.parent.name != "attempts"
        or not attempt.parent.parent.is_dir()
    ):
        raise Phase8Error("Phase 6 native completion moved outside its attempt")
    control = checked_dir(attempt.parent.parent, label="Phase 6 native control root")
    engineering_root = checked_dir(
        work_root / "runs" / "engineering", label="canonical engineering root"
    )
    if control.parent != engineering_root or not control.name.startswith(
        "phase6-native-canaries-"
    ):
        raise Phase8Error("Phase 6 native control root is not canonical")
    _validate_zero_local_fields(value, label="Phase 6 native completion")

    gate5_inputs = value.get("gate5_inputs")
    expected_gate5 = {
        "manifest": manifest_sha,
        "canonical_runnote": runnote_sha,
        "promotion_receipt": promotion_sha,
    }
    if not isinstance(gate5_inputs, dict) or set(gate5_inputs) != set(expected_gate5):
        raise Phase8Error("Phase 6 native Gate 5 input inventory differs")
    copied_gate5_names = {
        "manifest": "gate5-covered-manifest.json",
        "canonical_runnote": "RUNNOTE.md",
        "promotion_receipt": "RUNNOTE.gate5-promotion.receipt.json",
    }
    bound_gate5_observations: dict[str, tuple[Path, bytes]] = {}
    for field, expected_sha in expected_gate5.items():
        bound, bound_payload = descriptor_bytes(
            gate5_inputs[field], label=f"Phase 6 native Gate 5 {field}"
        )
        if (
            sha256_bytes(bound_payload) != expected_sha
            or bound != control / "inputs" / copied_gate5_names[field]
        ):
            raise Phase8Error(f"Phase 6 native Gate 5 {field} digest differs")
        bound_gate5_observations[field] = (bound, bound_payload)
    gate5 = strict_loads(
        bound_gate5_observations["manifest"][1],
        label="Phase 6 native Gate 5 manifest",
    )
    if not isinstance(gate5, dict):
        raise Phase8Error("Phase 6 native Gate 5 manifest is not one object")
    native_gate5_identity = _require_code_identity(
        gate5.get("code_identity"), label="Phase 6 native Gate 5 manifest"
    )
    gate5_runnable, gate5_terminals = _exact_inventory(
        gate5.get("lanes"), code_identity=native_gate5_identity
    )
    gate5_profile = _gate5_profile(gate5_runnable, gate5_terminals)
    conditional_na_lanes = list(gate5_profile["conditional_na_lanes"])
    if value.get("conditional_na_lanes") != conditional_na_lanes:
        raise Phase8Error("Phase 6 native conditional Gate 5 profile differs")

    plan_path, plan_payload = descriptor_bytes(
        value.get("plan"), label="Phase 6 native plan"
    )
    plan_sha = value.get("authorized_plan_sha256")
    if HEX64.fullmatch(str(plan_sha)) is None or sha256_bytes(plan_payload) != plan_sha:
        raise Phase8Error("Phase 6 native plan authorization differs")
    payload_path, native_payload = descriptor_bytes(
        value.get("payload"), label="Phase 6 native payload"
    )
    require_descriptor_identity(
        value["payload"],
        expected=phase6_payload_identity(
            "native",
            expected_commit=str(native_commit),
            label="Phase 6 native payload",
        ),
        label="Phase 6 native payload",
    )
    launch_path, launch_payload = descriptor_bytes(
        value.get("launch"), label="Phase 6 native launch"
    )
    summary_path, summary_payload = descriptor_bytes(
        value.get("summary"), label="Phase 6 native summary"
    )
    contract_test_path, contract_test_payload = descriptor_bytes(
        value.get("contract_self_test"),
        label="Phase 6 native contract self-test",
    )
    if (
        plan_path != control / "inputs" / "native-plan.json"
        or payload_path != control / "payload.py"
        or launch_path != control / "launch.json"
        or summary_path != attempt / "summary.json"
        or contract_test_path != attempt / "contract-self-test.json"
    ):
        raise Phase8Error("Phase 6 native controller artifact placement differs")

    launch = strict_loads(launch_payload, label="Phase 6 native launch")
    if not isinstance(launch, dict):
        raise Phase8Error("Phase 6 native launch must contain one JSON object")
    launch_fields = {
        "schema",
        "control_root",
        "plan",
        "payload",
        "authorized_plan_sha256",
        "expected_commit",
        "framework_lock_id",
        "gate5_inputs",
    }
    if (
        set(launch) != launch_fields
        or launch.get("schema") != "ura-phase6-native-controller-launch/1"
        or launch.get("control_root") != str(control)
        or launch.get("plan") != value.get("plan")
        or launch.get("payload") != value.get("payload")
        or launch.get("authorized_plan_sha256") != plan_sha
        or launch.get("expected_commit") != native_commit
        or launch.get("framework_lock_id") != EXPECTED_FRAMEWORK_LOCK
        or launch.get("gate5_inputs") != gate5_inputs
    ):
        raise Phase8Error("Phase 6 native launch/completion binding differs")

    plan = strict_loads(plan_payload, label="Phase 6 native plan")
    if not isinstance(plan, dict):
        raise Phase8Error("Phase 6 native plan must contain one JSON object")
    plan_fields = {
        "schema",
        "created_at_utc",
        "code_identity",
        "execution",
        "ollama_models",
        "gate5_inputs",
        "engine_order",
        "engines",
        "terminal_states",
        "inventory_complete",
        "conditional_na_lanes",
    }
    plan_rows = plan.get("engines")
    plan_execution = plan.get("execution")
    plan_code = plan.get("code_identity")
    plan_models = plan.get("ollama_models")
    expected_native_models = (
        NATIVE_OLLAMA_MODELS
        if native_commit == EXPECTED_COMMIT
        else RETAINED_NATIVE_OLLAMA_MODELS_BY_COMMIT.get(str(native_commit), {})
    )
    execution_fields = {
        "work_root",
        "framework_env_root",
        "framework_state_root",
        "framework_python",
        "ollama_upstream",
        "one_case",
        "engineering_diagnostic_only",
        "thesis_empirical_evidence",
        "session_timeout_seconds",
        "no_downloads",
        "no_hosted_calls",
        "call_gate",
    }
    if (
        set(plan) != plan_fields
        or plan.get("schema") != "ura-phase6-native-canary-plan/1"
        or not UTC_RE.fullmatch(str(plan.get("created_at_utc", "")))
        or not isinstance(plan_code, dict)
        or set(plan_code)
        != {
            "expected_commit",
            "framework_lock_id",
            "framework_lock",
            "project_revision",
        }
        or plan_code.get("expected_commit") != native_commit
        or plan_code.get("framework_lock_id") != EXPECTED_FRAMEWORK_LOCK
        or plan.get("gate5_inputs") != gate5_inputs
        or plan.get("engine_order") != list(NATIVE_ENGINES)
        or plan.get("terminal_states")
        != ["run", "failed", "unavailable", "not-selected"]
        or plan.get("inventory_complete") is not True
        or plan.get("conditional_na_lanes") != conditional_na_lanes
        or not isinstance(plan_rows, list)
        or [row.get("engine") for row in plan_rows if isinstance(row, dict)]
        != list(NATIVE_ENGINES)
        or not isinstance(plan_execution, dict)
        or set(plan_execution) != execution_fields
        or not all(
            isinstance(plan_execution.get(field), str)
            and Path(plan_execution[field]).is_absolute()
            for field in (
                "work_root",
                "framework_env_root",
                "framework_state_root",
                "framework_python",
            )
        )
        or plan_execution.get("ollama_upstream") != "http://127.0.0.1:11434"
        or plan_execution.get("one_case") is not True
        or plan_execution.get("engineering_diagnostic_only") is not True
        or plan_execution.get("thesis_empirical_evidence") is not False
        or type(plan_execution.get("session_timeout_seconds")) is not int
        or plan_execution.get("session_timeout_seconds") != 3600
        or plan_execution.get("no_downloads") is not True
        or plan_execution.get("no_hosted_calls") is not True
        or plan_execution.get("call_gate")
        != "per-engine literal-loopback proxy under one production exclusive inference lease with protected pre/post exact-roster checks, exact model allow-list, and hard request cap"
        or not isinstance(plan_models, dict)
        or not expected_native_models
        or set(plan_models) != set(expected_native_models)
    ):
        raise Phase8Error("Phase 6 native authorized plan differs")
    framework_lock_path, framework_lock = descriptor_object(
        plan_code["framework_lock"], label="Phase 6 native framework lock"
    )
    deployed_project = Path.cwd().resolve(strict=True)
    deployed_lock = checked_file(
        required_env("URA_FRAMEWORK_LOCK"), label="deployed framework runtime lock"
    )
    if framework_lock_path != deployed_lock or framework_lock_path != (
        deployed_project / "experiments" / "framework_runtime_lock.json"
    ).resolve(strict=True):
        raise Phase8Error("Phase 6 native framework lock path differs")
    framework_rows = framework_lock.get("frameworks")
    if (
        framework_lock.get("schema") != "ura-framework-runtime-lock/1"
        or framework_lock.get("lock_id") != EXPECTED_FRAMEWORK_LOCK
        or not isinstance(framework_rows, list)
        or any(not isinstance(row, dict) for row in framework_rows)
    ):
        raise Phase8Error("deployed framework runtime lock differs")
    native_project_path = descriptor_file(
        plan_code["project_revision"],
        label="Phase 6 native project-revision receipt",
    )
    expected_project_root = Path(EXPECTED_PROJECT_REVISION_MANIFEST).parent.resolve(
        strict=True
    )
    if native_project_path.parent != expected_project_root:
        raise Phase8Error("Phase 6 native project-revision receipt moved")
    try:
        from ura.project_revision import load_project_revision_file

        native_project_receipt, _native_project_binding = load_project_revision_file(
            native_project_path,
            str(plan_code["project_revision"].get("sha256")),
            Path.cwd() / "experiments" / "run_matrix.py",
            recheck_checkout=False,
        )
    except Exception as exc:  # noqa: BLE001 - historical receipt boundary
        raise Phase8Error(
            "Phase 6 native project-revision receipt is invalid"
        ) from exc
    native_repository = native_project_receipt.get("repository")
    if (
        not isinstance(native_repository, dict)
        or native_repository.get("expected_commit") != native_commit
        or native_repository.get("observed_commit") != native_commit
        or native_repository.get("clean") is not True
    ):
        raise Phase8Error("Phase 6 native project-revision receipt differs")
    framework_by_name = {
        row.get("name"): row
        for row in framework_rows
        if isinstance(row.get("name"), str) and row["name"]
    }
    if len(framework_by_name) != len(framework_rows):
        raise Phase8Error("deployed framework runtime lock has duplicate names")
    expected_execution_paths = {
        "work_root": Path(required_env("URA_WORK")).expanduser().resolve(strict=True),
        "framework_env_root": Path(required_env("URA_FRAMEWORK_ENVS"))
        .expanduser()
        .resolve(strict=True),
        "framework_state_root": Path(required_env("URA_FRAMEWORK_STATE"))
        .expanduser()
        .resolve(strict=True),
        "framework_python": Path(required_env("URA_FRAMEWORK_PYTHON"))
        .expanduser()
        .resolve(strict=True),
    }
    for field, expected_path in expected_execution_paths.items():
        observed_path = Path(str(plan_execution[field])).expanduser()
        if (
            not observed_path.is_absolute()
            or observed_path.resolve(strict=True) != expected_path
        ):
            raise Phase8Error(f"Phase 6 native {field} differs from campaign state")
    for role, expected_model in expected_native_models.items():
        model = plan_models[role]
        capabilities = model.get("capabilities") if isinstance(model, dict) else None
        retained_capabilities = expected_model.get("capabilities")
        expected_quantization = expected_model.get("quantization")
        if (
            not isinstance(model, dict)
            or set(model) != {"tag", "digest", "capabilities", "size", "details"}
            or {field: model.get(field) for field in ("tag", "digest")} != {
                field: expected_model[field] for field in ("tag", "digest")
            }
            or not isinstance(capabilities, list)
            or capabilities != sorted(capabilities)
            or any(not isinstance(item, str) for item in capabilities)
            or "completion" not in capabilities
            or (
                retained_capabilities is not None
                and capabilities != retained_capabilities
            )
            or type(model.get("size")) is not int
            or model["size"] < 1
            or not isinstance(model.get("details"), dict)
            or (
                expected_quantization is not None
                and model["details"].get("quantization_level")
                != expected_quantization
            )
        ):
            raise Phase8Error(f"Phase 6 native exact Ollama model differs: {role}")
        if (
            native_commit == EXPECTED_COMMIT
            and role in {"primary", "secondary"}
            and "vision" not in capabilities
        ):
            raise Phase8Error(f"Phase 6 native Ollama model lost vision: {role}")
        if (
            native_commit == EXPECTED_COMMIT
            and role == "primary"
            and "tools" not in capabilities
        ):
            raise Phase8Error("Phase 6 native primary Ollama model lost tools")
    plan_row_fields = {
        "engine",
        "runtime",
        "planned_terminal",
        "target_call_cap",
        "one_case_contract",
        "hosted_calls_allowed",
        "network_provider_calls_allowed",
        "model_acquisition_mode",
        "native_import_required",
    }
    for engine, row in zip(NATIVE_ENGINES, plan_rows, strict=True):
        runtime = row.get("runtime") if isinstance(row, dict) else None
        runtime_name = NATIVE_RUNTIME_NAMES[engine]
        expected_slug = "giskard-v2" if runtime_name == "giskard" else runtime_name
        if (
            not isinstance(row, dict)
            or set(row) != plan_row_fields
            or row.get("engine") != engine
            or row.get("planned_terminal") != NATIVE_PLANNED_TERMINALS[engine]
            or type(row.get("target_call_cap")) is not int
            or row.get("target_call_cap") != NATIVE_TARGET_CALL_CAPS[engine]
            or not isinstance(row.get("one_case_contract"), str)
            or not row["one_case_contract"].strip()
            or row.get("hosted_calls_allowed") is not False
            or row.get("network_provider_calls_allowed") is not False
            or row.get("model_acquisition_mode") != "not_applicable_exact_digest_ollama"
            or row.get("native_import_required")
            is not (NATIVE_PLANNED_TERMINALS[engine] == "run")
            or not isinstance(runtime, dict)
            or set(runtime)
            != {
                "runtime_name",
                "env_slug",
                "runtime",
                "version",
                "upstream_repository",
                "upstream_revision",
                "alias",
                "managed_store",
                "receipt",
                "content_seal_sha256",
            }
            or any(
                not isinstance(runtime.get(field), str) or not runtime[field].strip()
                for field in (
                    "runtime_name",
                    "env_slug",
                    "runtime",
                    "version",
                    "upstream_repository",
                    "upstream_revision",
                    "alias",
                    "managed_store",
                    "content_seal_sha256",
                )
            )
            or HEX64.fullmatch(str(runtime.get("content_seal_sha256"))) is None
            or runtime.get("runtime_name") != runtime_name
            or runtime.get("env_slug") != expected_slug
            or runtime.get("upstream_revision")
            != NATIVE_RUNTIME_REVISIONS[runtime_name]
        ):
            raise Phase8Error(f"{engine}: Phase 6 native plan row differs")
        lock_row = framework_by_name.get(runtime_name)
        lock_source = lock_row.get("source") if isinstance(lock_row, dict) else None
        if (
            not isinstance(lock_row, dict)
            or not isinstance(lock_source, dict)
            or runtime.get("env_slug") != lock_row.get("env_slug")
            or runtime.get("runtime") != lock_row.get("runtime")
            or runtime.get("version") != lock_row.get("version")
            or runtime.get("upstream_repository") != lock_source.get("url")
            or runtime.get("upstream_revision") != lock_source.get("commit")
        ):
            raise Phase8Error(f"{engine}: Phase 6 native runtime escaped its lock row")
        alias = Path(runtime["alias"])
        managed = Path(runtime["managed_store"])
        framework_env_root = expected_execution_paths["framework_env_root"]
        if (
            not alias.is_absolute()
            or alias.parent != framework_env_root
            or alias.name != expected_slug
            or not alias.is_symlink()
        ):
            raise Phase8Error(f"{engine}: Phase 6 native runtime layout differs")
        raw_target = Path(os.readlink(alias))
        if (
            raw_target.is_absolute()
            or len(raw_target.parts) != 2
            or raw_target.parts[0] != ".store"
            or not re.fullmatch(
                rf"{re.escape(expected_slug)}-[0-9a-f]{{16}}",
                raw_target.parts[1],
            )
        ):
            raise Phase8Error(f"{engine}: Phase 6 native runtime layout differs")
        unresolved_store = framework_env_root / raw_target
        store_root = (framework_env_root / ".store").resolve(strict=True)
        if (
            unresolved_store.is_symlink()
            or not managed.is_absolute()
            or managed.is_symlink()
            or not managed.is_dir()
            or managed.parent != store_root
            or managed.name != raw_target.parts[1]
            or unresolved_store.resolve(strict=True) != managed
        ):
            raise Phase8Error(f"{engine}: Phase 6 native runtime layout differs")
        runtime_receipt_path, runtime_receipt = descriptor_object(
            runtime["receipt"], label=f"{engine} Phase 6 native runtime receipt"
        )
        if runtime_receipt_path != managed / ".ura-runtime-receipt.json":
            raise Phase8Error(f"{engine}: Phase 6 native runtime receipt moved")
        content_seal = runtime_receipt.get("content_seal")
        if (
            runtime_receipt.get("schema") != "ura-framework-runtime-receipt/1"
            or runtime_receipt.get("framework") != runtime["runtime_name"]
            or runtime_receipt.get("env_slug") != runtime["env_slug"]
            or runtime_receipt.get("version") != runtime["version"]
            or runtime_receipt.get("runtime") != runtime["runtime"]
            or runtime_receipt.get("lock_id") != EXPECTED_FRAMEWORK_LOCK
            or runtime_receipt.get("status") != "passed"
            or runtime_receipt.get("smoke") != "passed"
            or runtime_receipt.get("network_smoke") != "denied"
            or not isinstance(content_seal, dict)
            or content_seal.get("schema") != "ura-framework-runtime-content-seal/2"
            or content_seal.get("sha256") != runtime["content_seal_sha256"]
        ):
            raise Phase8Error(f"{engine}: Phase 6 native runtime receipt differs")
        exact_zero_fields(
            runtime_receipt,
            ("provider_calls", "model_calls"),
            label=f"{engine} Phase 6 native runtime receipt",
        )
    plan_by_engine = {row["engine"]: row for row in plan_rows}

    states = value.get("terminal_states")
    terminals = value.get("terminal_artifacts")
    reservations = value.get("engine_reservations")
    envelopes = value.get("canonical_native_envelopes")
    runnable_engines = {
        engine
        for engine, planned in NATIVE_PLANNED_TERMINALS.items()
        if planned == "run"
    }
    typed_states = {
        engine: planned
        for engine, planned in NATIVE_PLANNED_TERMINALS.items()
        if planned != "run"
    }
    if (
        not isinstance(states, dict)
        or set(states) != set(NATIVE_ENGINES)
        or not isinstance(terminals, dict)
        or set(terminals) != set(NATIVE_ENGINES)
        or not isinstance(reservations, dict)
        or set(reservations) != runnable_engines
        or not isinstance(envelopes, dict)
    ):
        raise Phase8Error("Phase 6 native terminal inventory differs")
    if any(states.get(engine) not in {"run", "failed"} for engine in runnable_engines):
        raise Phase8Error("Phase 6 native runnable terminal state differs")
    if any(states.get(engine) != state for engine, state in typed_states.items()):
        raise Phase8Error("Phase 6 native typed terminal state differs")
    failed = [engine for engine in NATIVE_ENGINES if states[engine] == "failed"]
    expected_status = "complete_with_failures" if failed else "complete"
    if value.get("status") != expected_status:
        raise Phase8Error("Phase 6 native completion status does not match terminals")
    _require_terminal_attempt(
        attempt,
        expected_exit=1 if failed else 0,
        failure_names=("controller-failure.json",),
        label="Phase 6 native attempt",
    )
    expected_envelope_engines = {
        engine for engine in runnable_engines if states[engine] == "run"
    }
    if set(envelopes) != expected_envelope_engines:
        raise Phase8Error("Phase 6 native envelope inventory differs")

    terminal_fields = {
        "schema",
        "engine",
        "terminal_state",
        "completed_at_utc",
        "planned_terminal",
        "reason",
        "attempt",
        "evidence",
        "hosted_target_calls",
        "hosted_judge_calls",
        "provider_http_attempts",
        "downloads_observed_bytes",
        "local_model_calls",
        "authorized_local_call_cap",
    }
    evidence_fields = {
        "runtime_receipt",
        "runtime_revision",
        "engine_result",
        "canonical_native_envelope",
        "import_config",
        "local_call_summary",
        "engine_failure",
        "exit_marker",
        "native_log",
    }
    observed_local_calls = 0
    terminal_values: dict[str, dict[str, Any]] = {}
    for engine in NATIVE_ENGINES:
        terminal_path, terminal = descriptor_object(
            terminals[engine], label=f"{engine} Phase 6 native terminal"
        )
        if terminal_path != control / "terminals" / f"{engine}.json":
            raise Phase8Error(f"{engine}: Phase 6 native terminal path differs")
        terminal_values[engine] = terminal
        evidence = terminal.get("evidence")
        terminal_calls = terminal.get("local_model_calls")
        runtime = plan_by_engine[engine]["runtime"]
        if (
            set(terminal) != terminal_fields
            or terminal.get("schema") != "ura-phase6-native-terminal/1"
            or terminal.get("engine") != engine
            or terminal.get("terminal_state") != states[engine]
            or terminal.get("planned_terminal") != NATIVE_PLANNED_TERMINALS[engine]
            or not UTC_RE.fullmatch(str(terminal.get("completed_at_utc", "")))
            or not isinstance(terminal.get("reason"), str)
            or not terminal["reason"].strip()
            or any(
                terminal.get(field) != 0
                for field in (
                    "hosted_target_calls",
                    "hosted_judge_calls",
                    "provider_http_attempts",
                    "downloads_observed_bytes",
                )
            )
            or terminal.get("authorized_local_call_cap")
            != NATIVE_TARGET_CALL_CAPS[engine]
            or type(terminal.get("authorized_local_call_cap")) is not int
            or isinstance(terminal_calls, bool)
            or not isinstance(terminal_calls, int)
            or not 0 <= terminal_calls <= NATIVE_TARGET_CALL_CAPS[engine]
            or not isinstance(evidence, dict)
            or set(evidence) != evidence_fields
            or evidence.get("runtime_receipt") != runtime.get("receipt")
            or evidence.get("runtime_revision") != runtime.get("upstream_revision")
        ):
            raise Phase8Error(f"{engine}: Phase 6 native terminal differs")
        _validate_zero_local_fields(terminal, label=f"{engine} Phase 6 native terminal")
        observed_local_calls += terminal_calls
        if (
            not isinstance(evidence.get("runtime_revision"), str)
            or not evidence["runtime_revision"].strip()
        ):
            raise Phase8Error(f"{engine}: Phase 6 native runtime revision differs")
        evidence_observations = {
            field: descriptor_bytes(
                raw, label=f"{engine} Phase 6 native {field}"
            )
            for field, raw in evidence.items()
            if isinstance(raw, dict)
        }
        if engine in typed_states:
            if (
                terminal.get("attempt") is not None
                or terminal_calls != 0
                or any(
                    evidence[field] is not None
                    for field in evidence_fields
                    - {"runtime_receipt", "runtime_revision"}
                )
            ):
                raise Phase8Error(
                    f"{engine}: Phase 6 native typed terminal has execution evidence"
                )
        elif states[engine] == "run":
            engine_attempt = (
                checked_dir(terminal["attempt"], label=f"{engine} native attempt")
                if isinstance(terminal.get("attempt"), str) and terminal["attempt"]
                else None
            )
            if (
                engine_attempt is None
                or engine_attempt.parent
                != Path(plan_execution["work_root"]) / "runs" / "engineering"
                or not engine_attempt.name.startswith(f"ura-native-{engine}-")
                or evidence.get("engine_failure") is not None
                or any(
                    evidence.get(field) is None
                    for field in (
                        "engine_result",
                        "canonical_native_envelope",
                        "import_config",
                        "local_call_summary",
                        "exit_marker",
                        "native_log",
                    )
                )
                or envelopes[engine] != evidence["canonical_native_envelope"]
            ):
                raise Phase8Error(f"{engine}: Phase 6 native run evidence differs")
            evidence_paths = {
                field: evidence_observations[field][0]
                for field in (
                    "engine_result",
                    "canonical_native_envelope",
                    "import_config",
                    "local_call_summary",
                    "exit_marker",
                    "native_log",
                )
            }
            if (
                any(
                    not is_beneath(artifact, engine_attempt)
                    for artifact in evidence_paths.values()
                )
                or evidence_observations["exit_marker"][1] != b"0\n"
            ):
                raise Phase8Error(f"{engine}: native run artifact placement differs")
            _validate_native_call_summary(
                evidence_paths["local_call_summary"],
                engine=engine,
                attempt=engine_attempt,
                call_cap=NATIVE_TARGET_CALL_CAPS[engine],
                observed_calls=terminal_calls,
                require_success=True,
                expected_model_tags=tuple(
                    model["tag"] for model in expected_native_models.values()
                ),
                payload=evidence_observations["local_call_summary"][1],
            )
            _validate_native_run_receipts(
                engine=engine,
                row=plan_by_engine[engine],
                plan=plan,
                attempt=engine_attempt,
                evidence=evidence,
                observations=evidence_observations,
            )
        else:
            if evidence.get("canonical_native_envelope") is not None or any(
                evidence.get(field) is not None
                for field in ("engine_result", "import_config")
            ):
                raise Phase8Error(
                    f"{engine}: Phase 6 native failure claims run evidence"
                )
            if terminal.get("attempt") is None:
                if terminal_calls != 0 or any(
                    evidence.get(field) is not None
                    for field in evidence_fields
                    - {"runtime_receipt", "runtime_revision"}
                ):
                    raise Phase8Error(
                        f"{engine}: synthetic Phase 6 native failure has execution evidence"
                    )
            elif (
                not isinstance(terminal.get("attempt"), str)
                or not terminal["attempt"]
                or evidence.get("engine_failure") is None
                or evidence.get("exit_marker") is None
                or evidence.get("native_log") is None
            ):
                raise Phase8Error(f"{engine}: Phase 6 native failure evidence differs")
            else:
                engine_attempt = checked_dir(
                    terminal["attempt"], label=f"{engine} failed native attempt"
                )
                if engine_attempt.parent != Path(
                    plan_execution["work_root"]
                ) / "runs" / "engineering" or not engine_attempt.name.startswith(
                    f"ura-native-{engine}-"
                ):
                    raise Phase8Error(f"{engine}: failed native attempt root differs")
                failure_path, failure_payload = evidence_observations["engine_failure"]
                exit_marker, exit_payload = evidence_observations["exit_marker"]
                native_log, _native_log_payload = evidence_observations["native_log"]
                if any(
                    not is_beneath(artifact, engine_attempt)
                    for artifact in (failure_path, exit_marker, native_log)
                ):
                    raise Phase8Error(f"{engine}: failed native evidence escaped")
                try:
                    exit_text = exit_payload.decode("ascii").strip()
                except UnicodeDecodeError as exc:
                    raise Phase8Error(
                        f"{engine}: failed native exit marker is not ASCII"
                    ) from exc
                if not exit_text.isdigit() or not 1 <= int(exit_text) <= 255:
                    raise Phase8Error(f"{engine}: failed native exit marker differs")
                failure_value = strict_loads(
                    failure_payload, label=f"{engine} native engine failure"
                )
                if not isinstance(failure_value, dict):
                    raise Phase8Error(
                        f"{engine}: native engine failure is not one object"
                    )
                if (
                    set(failure_value)
                    != {
                        "schema",
                        "engine",
                        "status",
                        "failed_at_utc",
                        "error_type",
                        "error",
                        "hosted_calls",
                        "downloads",
                    }
                    or failure_value.get("schema")
                    != "ura-phase6-native-engine-failure/1"
                    or failure_value.get("engine") != engine
                    or failure_value.get("status") != "failed"
                    or not UTC_RE.fullmatch(str(failure_value.get("failed_at_utc", "")))
                    or not isinstance(failure_value.get("error_type"), str)
                    or not failure_value["error_type"]
                    or not isinstance(failure_value.get("error"), str)
                    or not failure_value["error"]
                ):
                    raise Phase8Error(f"{engine}: native engine failure differs")
                exact_zero_fields(
                    failure_value,
                    ("hosted_calls", "downloads"),
                    label=f"{engine} native engine failure",
                )
                if evidence.get("local_call_summary") is None:
                    if terminal_calls != 0:
                        raise Phase8Error(
                            f"{engine}: failed native calls lack a ledger"
                        )
                else:
                    call_summary_path, call_summary_payload = evidence_observations[
                        "local_call_summary"
                    ]
                    if not is_beneath(call_summary_path, engine_attempt):
                        raise Phase8Error(
                            f"{engine}: failed native call summary escaped"
                        )
                    _validate_native_call_summary(
                        call_summary_path,
                        engine=engine,
                        attempt=engine_attempt,
                        call_cap=NATIVE_TARGET_CALL_CAPS[engine],
                        observed_calls=terminal_calls,
                        require_success=False,
                        expected_model_tags=tuple(
                            model["tag"] for model in expected_native_models.values()
                        ),
                        payload=call_summary_payload,
                    )
    if observed_local_calls != local_calls:
        raise Phase8Error("Phase 6 native aggregate local-call accounting differs")

    for engine in sorted(runnable_engines):
        reservation_path, reservation = descriptor_object(
            reservations[engine], label=f"{engine} Phase 6 native reservation"
        )
        if reservation_path != control / "engine-reservations" / f"{engine}.json":
            raise Phase8Error(f"{engine}: Phase 6 native reservation path differs")
        if (
            set(reservation)
            != {
                "schema",
                "engine",
                "created_at_utc",
                "attempt",
                "session",
                "socket",
                "deadline_epoch",
                "target_call_cap",
                "engineering_campaign",
            }
            or reservation.get("schema") != "ura-phase6-native-engine-reservation/1"
            or reservation.get("engine") != engine
            or not UTC_RE.fullmatch(str(reservation.get("created_at_utc", "")))
            or type(reservation.get("deadline_epoch")) is not int
            or reservation.get("deadline_epoch", 0) < 1
            or type(reservation.get("target_call_cap")) is not int
            or reservation.get("target_call_cap") != NATIVE_TARGET_CALL_CAPS[engine]
        ):
            raise Phase8Error(f"{engine}: Phase 6 native reservation differs")
        reserved_attempt = checked_dir(
            str(reservation.get("attempt", "")),
            label=f"{engine} Phase 6 reserved attempt",
        )
        if (
            reserved_attempt.parent
            != Path(plan_execution["work_root"]) / "runs" / "engineering"
            or not reserved_attempt.name.startswith(f"ura-native-{engine}-")
            or reservation.get("session") != reserved_attempt.name
            or reservation.get("socket") != reserved_attempt.name + "-socket"
        ):
            raise Phase8Error(f"{engine}: Phase 6 native reservation root differs")
        campaign_path, campaign = descriptor_object(
            reservation.get("engineering_campaign"),
            label=f"{engine} Phase 6 native engineering campaign",
        )
        if campaign_path != reserved_attempt / "ENGINEERING_ONLY.json":
            raise Phase8Error(f"{engine}: native engineering campaign moved")
        if campaign != {
            "campaign_id": reserved_attempt.name,
            "evidence_class": "native_upstream_execution",
            "hard_stop_hours": 1,
            "hosted_calls_allowed": False,
            "model_tasks": [f"native-{engine}"],
            "planned_tasks": [f"native-{engine}"],
            "schema": "ura-engineering-campaign/1",
            "started_at": reservation["created_at_utc"],
            "target_call_cap": NATIVE_TARGET_CALL_CAPS[engine],
            "thesis_empirical_evidence": False,
        }:
            raise Phase8Error(f"{engine}: native engineering campaign differs")
        terminal_attempt = terminal_values[engine].get("attempt")
        if terminal_attempt is not None and Path(terminal_attempt) != reserved_attempt:
            raise Phase8Error(f"{engine}: terminal/reservation attempt differs")

    summary = strict_loads(summary_payload, label="Phase 6 native summary")
    if not isinstance(summary, dict):
        raise Phase8Error("Phase 6 native summary must contain one JSON object")
    summary_fields = {
        "schema",
        "status",
        "completed_at_utc",
        "attempt",
        "expected_commit",
        "framework_lock_id",
        "gate5_inputs",
        "authorized_plan_sha256",
        "payload_sha256",
        "launch",
        "engine_order",
        "terminal_states",
        "terminal_artifacts",
        "engine_reservations",
        "canonical_native_envelopes",
        "run_engines",
        "failed_engines",
        "typed_terminals",
        "inventory_complete",
        "all_selected_engines_attempted",
        "all_independent_engines_attempted",
        "hosted_target_calls",
        "hosted_judge_calls",
        "provider_http_attempts",
        "downloads_observed_bytes",
        "local_model_calls",
        "authorized_local_call_cap",
        "framework_verification",
        "contract_self_test",
        "conditional_na_lanes",
    }
    if (
        set(summary) != summary_fields
        or summary.get("schema") != "ura-phase6-native-controller-summary/1"
        or summary.get("status") != expected_status
        or not UTC_RE.fullmatch(str(summary.get("completed_at_utc", "")))
        or summary.get("attempt") != attempt_name
        or summary.get("expected_commit") != native_commit
        or summary.get("framework_lock_id") != EXPECTED_FRAMEWORK_LOCK
        or summary.get("gate5_inputs") != gate5_inputs
        or summary.get("conditional_na_lanes") != conditional_na_lanes
        or summary.get("authorized_plan_sha256") != plan_sha
        or summary.get("payload_sha256") != sha256_bytes(native_payload)
        or summary.get("launch") != value["launch"]
        or summary.get("engine_order") != list(NATIVE_ENGINES)
        or summary.get("terminal_states") != states
        or summary.get("terminal_artifacts") != terminals
        or summary.get("engine_reservations") != reservations
        or summary.get("canonical_native_envelopes") != envelopes
        or summary.get("run_engines")
        != [engine for engine in NATIVE_ENGINES if states[engine] == "run"]
        or summary.get("failed_engines") != failed
        or summary.get("typed_terminals") != typed_states
        or summary.get("inventory_complete") is not True
        or summary.get("all_selected_engines_attempted") is not True
        or summary.get("all_independent_engines_attempted") is not True
        or type(summary.get("local_model_calls")) is not int
        or summary.get("local_model_calls") != local_calls
        or type(summary.get("authorized_local_call_cap")) is not int
        or summary.get("authorized_local_call_cap") != NATIVE_AUTHORIZED_LOCAL_CALL_CAP
        or summary.get("contract_self_test") != value["contract_self_test"]
    ):
        raise Phase8Error("Phase 6 native summary differs")
    _validate_zero_local_fields(summary, label="Phase 6 native summary")
    descriptor_file(
        summary.get("framework_verification"),
        label="Phase 6 native framework verification",
    )

    contract_test = strict_loads(
        contract_test_payload, label="Phase 6 native contract self-test"
    )
    if not isinstance(contract_test, dict):
        raise Phase8Error("Phase 6 native contract self-test must be one object")
    if (
        set(contract_test)
        != {
            "schema",
            "status",
            "mutations_rejected",
            "rejected_cases",
            "recovery_cases",
            "call_accounting_mutations_rejected",
            "canonical_round_trip",
        }
        or contract_test.get("schema") != "ura-phase6-native-contract-self-test/1"
        or contract_test.get("status") != "passed"
        or contract_test.get("mutations_rejected") != 13
        or not isinstance(contract_test.get("rejected_cases"), list)
        or contract_test.get("rejected_cases")
        != [
            "missing-lane",
            "duplicate-lane",
            "runnable-family",
            "rr-current-runnable",
            "native-terminal",
            "defense-na-v2-cross-mix",
            "defense-na-shape",
            "hosted-http-policy",
            "promotion-inventory",
            "promotion-download",
            "promotion-authorization",
            "promotion-basis-launched",
            "promotion-basis-manifest",
        ]
        or contract_test.get("recovery_cases")
        != {
            "completed-session-gone": "adopt",
            "completed-session-racing": "adopt",
            "active-session": "wait",
            "ambiguous-dead-session": "refuse",
        }
        or contract_test.get("call_accounting_mutations_rejected")
        != ["boolean", "negative", "over-cap"]
        or contract_test.get("canonical_round_trip")
        != "exact_key_set_preserved_after_sorted_serialization"
    ):
        raise Phase8Error("Phase 6 native contract self-test differs")
    for row in collect_descriptors(value):
        descriptor_file(row, label="Phase 6 native bound artifact")
    return value


def _find_boundary_artifact(
    completion: Mapping[str, Any],
) -> tuple[Path, dict[str, Any], dict[str, Any]]:
    inventory_path, inventory = descriptor_object(
        completion.get("artifact_inventory"), label="Phase 7 artifact inventory"
    )
    if (
        inventory.get("schema") != "ura-phase7-analysis-artifact-inventory/1"
        or inventory.get("status") != "complete"
        or type(inventory.get("target_calls")) is not int
        or inventory.get("target_calls") != 0
        or type(inventory.get("judge_calls")) is not int
        or inventory.get("judge_calls") != 0
        or type(inventory.get("provider_http_attempts")) is not int
        or inventory.get("provider_http_attempts") != 0
        or inventory.get("human_labels_consumed") is not False
    ):
        raise Phase8Error("Phase 7 artifact inventory differs")
    matches: list[tuple[Path, dict[str, Any], dict[str, Any]]] = []
    for row in inventory.get("artifacts", []):
        try:
            path, value = descriptor_object(row, label="Phase 7 analysis artifact")
        except Phase8Error:
            continue
        if value.get("schema") == "ura-phase7-analysis-boundaries/2":
            matches.append((path, value, row))
    if len(matches) != 1:
        raise Phase8Error(
            "Phase 7 inventory must contain one analysis-boundaries artifact"
        )
    return matches[0]


LIFECYCLE_ARTIFACT_GROUPS = (
    "runner_grid_artifacts",
    "runner_request_envelopes",
    "runner_eligibility_artifacts",
    "runner_error_artifacts",
)
LIFECYCLE_ARTIFACT_KINDS = frozenset({
    "complete_grid_request",
    "partial_grid_request",
    "running_grid_request",
    "measured_request_envelope",
    "eligibility_artifact",
    "error_artifact",
})


def lifecycle_artifact_kinds(
    *,
    grid_statuses: Sequence[str],
    artifact_groups: Mapping[str, Sequence[Mapping[str, Any]]],
) -> dict[str, int]:
    """Count only the exact retained groups whose semantics were validated."""

    if not isinstance(artifact_groups, dict) or set(artifact_groups) != set(
        LIFECYCLE_ARTIFACT_GROUPS
    ):
        raise Phase8Error("Runner lifecycle artifact groups are not exact")
    for field in LIFECYCLE_ARTIFACT_GROUPS:
        rows = artifact_groups[field]
        if not isinstance(rows, list) or any(
            not isinstance(row, dict)
            or set(row) != {"path", "sha256", "bytes"}
            or not isinstance(row.get("path"), str)
            or not row["path"]
            or HEX64.fullmatch(str(row.get("sha256"))) is None
            or type(row.get("bytes")) is not int
            or row["bytes"] < 0
            for row in rows
        ):
            raise Phase8Error(f"Runner lifecycle {field} descriptors are invalid")
    if any(status not in {"complete", "partial", "running"} for status in grid_statuses):
        raise Phase8Error("Runner lifecycle grid status is invalid")
    if len(grid_statuses) != len(artifact_groups["runner_grid_artifacts"]):
        raise Phase8Error("Runner lifecycle grid status/artifact inventory differs")
    if len(grid_statuses) > 1:
        raise Phase8Error("Runner lifecycle contains more than one grid request")
    envelopes = len(artifact_groups["runner_request_envelopes"])
    if envelopes > 1:
        raise Phase8Error("Runner lifecycle contains more than one request envelope")
    return {
        "complete_grid_request": sum(status == "complete" for status in grid_statuses),
        "partial_grid_request": sum(status == "partial" for status in grid_statuses),
        "running_grid_request": sum(status == "running" for status in grid_statuses),
        "measured_request_envelope": envelopes,
        "eligibility_artifact": len(
            artifact_groups["runner_eligibility_artifacts"]
        ),
        "error_artifact": len(artifact_groups["runner_error_artifacts"]),
    }


def lifecycle_authorization_status(
    *,
    terminal_state: str,
    lifecycle_state: str,
    artifact_kinds: Mapping[str, int],
) -> str:
    if not isinstance(artifact_kinds, dict) or set(artifact_kinds) != LIFECYCLE_ARTIFACT_KINDS:
        raise Phase8Error("Runner lifecycle artifact kinds are not exact")
    if any(
        type(value) is not int or value < 0
        for value in artifact_kinds.values()
    ):
        raise Phase8Error("Runner lifecycle artifact-kind count is invalid")
    complete_grids = artifact_kinds["complete_grid_request"]
    partial_grids = artifact_kinds["partial_grid_request"]
    running_grids = artifact_kinds["running_grid_request"]
    envelopes = artifact_kinds["measured_request_envelope"]
    eligibility = artifact_kinds["eligibility_artifact"]
    errors = artifact_kinds["error_artifact"]
    if complete_grids + partial_grids + running_grids > 1 or envelopes > 1:
        raise Phase8Error("Runner lifecycle request artifact cardinality is invalid")
    if terminal_state == "measured_complete":
        if (
            lifecycle_state != "complete"
            or complete_grids != 1
            or partial_grids != 0
            or running_grids != 0
            or envelopes != 1
            or eligibility < 1
            or errors != 0
        ):
            raise Phase8Error("complete Runner authorization lacks complete artifacts")
        return "complete_runner_grid"
    if terminal_state != "failed":
        raise Phase8Error("Runner lifecycle authorization has an invalid terminal state")
    if lifecycle_state == "partial":
        if (
            partial_grids != 1
            or complete_grids != 0
            or running_grids != 0
            or envelopes != 1
            or eligibility < 1
            or errors < 1
        ):
            raise Phase8Error("partial Runner authorization lacks exact artifact kinds")
        return "partial_runner_grid"
    if lifecycle_state != "failed":
        raise Phase8Error("failed Runner authorization has an invalid lifecycle state")
    if partial_grids:
        raise Phase8Error("failed Runner lifecycle contains a partial grid")
    request_bound = envelopes == 1 or complete_grids == 1 or running_grids == 1
    return (
        "failed_after_runner_request"
        if request_bound
        else "pre_runner_failure_no_request_artifact"
    )


def validate_analysis_boundaries(
    value: Mapping[str, Any],
    *,
    expected_runner_states: Mapping[str, str] | None = None,
    expected_llava_pair_states: Mapping[str, str] | None = None,
    expected_lifecycle_authorizations: Mapping[str, Any] | None = None,
    expected_native_states: Mapping[str, str] | None = None,
    expected_cascade_lanes: Sequence[str] | None = None,
    expected_proxy_conditions: Sequence[Mapping[str, Any]] | None = None,
    expected_rr_terminal_artifact: Mapping[str, Any] | None = None,
) -> None:
    approximate = value.get("approximate_common_metrics")
    classification = value.get("classification")
    modes = value.get("evaluator_compatibility_modes")
    expected_fields = {
        "schema",
        "status",
        "evaluator_compatibility_modes",
        "evaluator_modes_pooled",
        "cascade_expected_lanes",
        "classification",
        "approximate_common_metrics",
        "cluster_semantics",
        "paired_status",
        "transfer",
        "native_outcomes",
        "runner_outcomes",
        "conditional_na_lanes",
        "defense_local_evidence",
        "lifecycle_registry_states",
        "runner_lifecycle_authorizations",
        "failed_phase6_lanes_excluded_from_metric_and_level2_views",
        "native_scales_pooled",
        "suite_missingness",
        "human_labels_consumed",
        "human_validity_claimed",
    }
    if (
        set(value) != expected_fields
        or value.get("schema") != "ura-phase7-analysis-boundaries/2"
        or value.get("status") != "validated"
        or value.get("evaluator_modes_pooled") is not False
        or value.get("native_scales_pooled") is not False
        or value.get(
            "failed_phase6_lanes_excluded_from_metric_and_level2_views"
        ) is not True
        or not isinstance(value.get("lifecycle_registry_states"), dict)
        or not isinstance(value.get("runner_lifecycle_authorizations"), dict)
        or value.get("human_labels_consumed") is not False
        or value.get("human_validity_claimed") is not False
        or not isinstance(modes, dict)
        or not modes
        or any(type(count) is not int or count < 1 for count in modes.values())
    ):
        raise Phase8Error("Phase 7 evaluator compatibility boundary differs")
    cascade_lanes = value.get("cascade_expected_lanes")
    lifecycle_states = value.get("lifecycle_registry_states")
    if (
        not isinstance(cascade_lanes, list)
        or any(not isinstance(lane, str) or not lane for lane in cascade_lanes)
        or cascade_lanes != sorted(set(cascade_lanes))
        or not isinstance(value.get("runner_outcomes"), dict)
        or set(value.get("runner_lifecycle_authorizations", {}))
        != set(lifecycle_states)
        or any(
            value["runner_outcomes"].get(lane) != "measured_complete"
            for lane in cascade_lanes
        )
        or (
            expected_cascade_lanes is not None
            and cascade_lanes != list(expected_cascade_lanes)
        )
        or (
            expected_runner_states is not None
            and (
                set(lifecycle_states) != set(expected_runner_states)
                or any(
                    lifecycle_states[lane] != "complete"
                    for lane, state in expected_runner_states.items()
                    if state == "measured_complete"
                )
                or any(
                    lifecycle_states[lane] not in {"partial", "failed"}
                    for lane, state in expected_runner_states.items()
                    if state == "failed"
                )
            )
        )
        or (
            expected_lifecycle_authorizations is not None
            and value.get("runner_lifecycle_authorizations")
            != dict(expected_lifecycle_authorizations)
        )
    ):
        raise Phase8Error("Phase 7 expected judge-cascade lane boundary differs")
    if (
        not isinstance(classification, dict)
        or set(classification)
        != {"source_parser_only", "common_metric_rows", "estimate_rows"}
        or classification.get("source_parser_only") is not True
        or type(classification.get("common_metric_rows")) is not int
        or classification.get("common_metric_rows") != 0
        or type(classification.get("estimate_rows")) is not int
        or classification.get("estimate_rows", -1) < 0
    ):
        raise Phase8Error(
            "Phase 7 source-task classification leaked into common metrics"
        )
    if (
        not isinstance(approximate, dict)
        or set(approximate)
        != {
            "supplementary_non_authoritative",
            "expected_from_ineligible_opted_in_strata",
            "expected_conditions",
            "estimated_conditions",
            "all_abstained_conditions",
            "estimate_rows",
            "selected_judges",
            "judge_models",
            "selected_guardrail",
            "queried_rows_bind_selected_guardrail",
        }
        or approximate.get("supplementary_non_authoritative") is not True
        or not isinstance(
            approximate.get("expected_from_ineligible_opted_in_strata"), bool
        )
        or not isinstance(approximate.get("expected_conditions"), list)
        or not isinstance(approximate.get("estimated_conditions"), list)
        or not isinstance(approximate.get("all_abstained_conditions"), list)
        or type(approximate.get("estimate_rows")) is not int
        or approximate.get("estimate_rows", -1) < 0
        or not isinstance(approximate.get("selected_judges"), list)
        or any(
            not isinstance(judge, str)
            for judge in approximate.get("selected_judges", [])
        )
        or approximate.get("selected_judges")
        != sorted(set(approximate["selected_judges"]))
        or set(approximate["selected_judges"]) - {"guardrail", "rules"}
        or approximate.get("judge_models") not in ([], [EXPECTED_GUARDRAIL["model"]])
        or (
            approximate.get("judge_models") == [EXPECTED_GUARDRAIL["model"]]
            and "guardrail" not in approximate["selected_judges"]
        )
        or approximate.get("selected_guardrail") != EXPECTED_GUARDRAIL
        or approximate.get("queried_rows_bind_selected_guardrail") is not True
    ):
        raise Phase8Error(
            "approximate common metrics do not bind the selected judge model"
        )
    condition_fields = {
        "lane_id", "model_spec", "corpus_arm", "attacker", "required_metric"
    }
    condition_key_fields = (
        "model_spec", "corpus_arm", "attacker", "required_metric"
    )

    def condition_key(
        row: Mapping[str, Any], *, label: str
    ) -> tuple[str, str, str, str]:
        if (
            not isinstance(row, dict)
            or set(row) != condition_fields
            or any(
                not isinstance(row[field], str) or not row[field]
                for field in condition_fields
            )
        ):
            raise Phase8Error(f"Phase 7 {label} proxy condition is malformed")
        return tuple(row[field] for field in condition_key_fields)

    def condition_inventory(
        rows: Sequence[Mapping[str, Any]], *, label: str
    ) -> dict[tuple[str, str, str, str], dict[str, str]]:
        inventory: dict[tuple[str, str, str, str], dict[str, str]] = {}
        for row in rows:
            key = condition_key(row, label=label)
            if key in inventory:
                raise Phase8Error(f"Phase 7 {label} proxy condition is duplicated")
            inventory[key] = dict(row)
        if list(rows) != [inventory[key] for key in sorted(inventory)]:
            raise Phase8Error(f"Phase 7 {label} proxy conditions are not canonical")
        return inventory

    def realization_inventory(
        rows: Sequence[Mapping[str, Any]],
        *,
        label: str,
        estimated: bool,
    ) -> dict[tuple[str, str, str, str], dict[str, Any]]:
        inventory: dict[tuple[str, str, str, str], dict[str, Any]] = {}
        for row in rows:
            if not isinstance(row, dict) or set(row) != {
                "condition",
                "estimate_rows",
                "completed_records",
                "typed_abstentions",
            }:
                raise Phase8Error(
                    f"Phase 7 {label} proxy realization is malformed"
                )
            key = condition_key(row.get("condition"), label=label)
            estimate_count = row.get("estimate_rows")
            completed = row.get("completed_records")
            typed_abstentions = row.get("typed_abstentions")
            if (
                key in inventory
                or type(estimate_count) is not int
                or estimate_count < 0
                or type(completed) is not int
                or completed <= 0
                or type(typed_abstentions) is not int
                or not 0 <= typed_abstentions <= completed
                or (estimated and estimate_count <= 0)
                or (estimated and typed_abstentions >= completed)
                or (not estimated and estimate_count != 0)
                or (not estimated and typed_abstentions != completed)
            ):
                raise Phase8Error(
                    f"Phase 7 {label} proxy realization disposition differs"
                )
            inventory[key] = dict(row)
        if list(rows) != [inventory[key] for key in sorted(inventory)]:
            raise Phase8Error(
                f"Phase 7 {label} proxy realizations are not canonical"
            )
        return inventory

    expected_condition_rows = approximate["expected_conditions"]
    estimated_condition_rows = approximate["estimated_conditions"]
    all_abstained_condition_rows = approximate["all_abstained_conditions"]
    expected_condition_inventory = condition_inventory(
        expected_condition_rows, label="expected"
    )
    estimated_condition_inventory = realization_inventory(
        estimated_condition_rows, label="estimated", estimated=True
    )
    all_abstained_condition_inventory = realization_inventory(
        all_abstained_condition_rows, label="all-abstained", estimated=False
    )
    expected_condition_keys = set(expected_condition_inventory)
    estimated_condition_keys = set(estimated_condition_inventory)
    all_abstained_condition_keys = set(all_abstained_condition_inventory)
    if (
        estimated_condition_keys & all_abstained_condition_keys
        or estimated_condition_keys | all_abstained_condition_keys
        != expected_condition_keys
        or any(
            row["condition"] != expected_condition_inventory[key]
            for inventory in (
                estimated_condition_inventory,
                all_abstained_condition_inventory,
            )
            for key, row in inventory.items()
        )
    ):
        raise Phase8Error(
            "Phase 7 estimated/all-abstained proxy condition partition differs"
        )
    expected_approximate = bool(expected_condition_rows)
    estimate_rows = approximate["estimate_rows"]
    selected_judges = approximate["selected_judges"]
    judge_models = approximate["judge_models"]
    if (
        approximate["expected_from_ineligible_opted_in_strata"]
        is not expected_approximate
        or (not expected_approximate and estimate_rows != 0)
        or bool(estimate_rows) is not bool(estimated_condition_rows)
        or estimate_rows
        != sum(row["estimate_rows"] for row in estimated_condition_rows)
        or (estimate_rows == 0 and (selected_judges or judge_models))
        or (estimate_rows > 0 and not selected_judges)
    ):
        raise Phase8Error(
            "Phase 7 approximate proxy realization differs from its conditions"
        )
    if (
        expected_proxy_conditions is not None
        and expected_condition_rows != list(expected_proxy_conditions)
    ):
        raise Phase8Error("Phase 7 approximate proxy-condition boundary differs")
    paired_status = value.get("paired_status")
    if not isinstance(paired_status, dict) or set(paired_status) != {
        "llava_base_vs_rr",
        "qwen_replay_vs_crescendo",
    }:
        raise Phase8Error("Phase 7 paired-status inventory changed")
    llava_status = paired_status.get("llava_base_vs_rr")
    if not isinstance(llava_status, dict) or set(llava_status) != set(IMAGE_ARMS):
        raise Phase8Error("Phase 7 missing planned LLaVA contrast facets")
    for corpus in IMAGE_ARMS:
        row = llava_status[corpus]
        if (
            not isinstance(row, dict)
            or set(row)
            != {
                "status",
                "analysis_ready_real_run",
                "estimate_available",
                "planned_contrast_missing",
                "reason_code",
                "missing_roles",
                "prerequisite_roles",
                "modality",
                "facet",
                "paired_compare_invoked",
            }
            or row.get("modality") != "image"
            or row.get("facet") != corpus
            or type(row.get("analysis_ready_real_run")) is not bool
            or type(row.get("estimate_available")) is not bool
            or type(row.get("planned_contrast_missing")) is not bool
            or type(row.get("paired_compare_invoked")) is not bool
        ):
            raise Phase8Error(f"Phase 7 LLaVA contrast boundary changed: {corpus}")
        if row["paired_compare_invoked"]:
            if row["reason_code"] in {
                "paired_compare_validation_failed",
                "paired_compare_readiness_failed",
            }:
                if (
                    row["status"] != "unavailable"
                    or row["analysis_ready_real_run"] is not False
                    or row["estimate_available"] is not False
                    or row["planned_contrast_missing"] is not True
                    or row["missing_roles"] != []
                    or not isinstance(row["prerequisite_roles"], dict)
                    or set(row["prerequisite_roles"])
                    != {"left_base", "right_rr"}
                ):
                    raise Phase8Error(
                        f"Phase 7 completed non-estimable LLaVA boundary changed: {corpus}"
                    )
            elif (
                row["status"] != "complete"
                or row["analysis_ready_real_run"] is not True
                or row["estimate_available"] is not True
                or row["planned_contrast_missing"] is not False
                or row["reason_code"] is not None
                or row["missing_roles"] != []
                or row["prerequisite_roles"] != {}
            ):
                raise Phase8Error(
                    f"Phase 7 measured LLaVA contrast boundary changed: {corpus}"
                )
        elif (
            row["status"] != "unavailable"
            or row["analysis_ready_real_run"] is not False
            or row["estimate_available"] is not False
            or row["planned_contrast_missing"] is not True
            or row["reason_code"]
            not in {
                "left_base_lane_failed",
                "right_rr_lane_failed",
                "left_base_and_right_rr_lanes_failed",
            }
            or not isinstance(row["missing_roles"], list)
            or not row["missing_roles"]
            or not isinstance(row["prerequisite_roles"], dict)
            or set(row["prerequisite_roles"]) != {"left_base", "right_rr"}
            or not set(row["missing_roles"]) <= set(row["prerequisite_roles"])
        ):
            raise Phase8Error(
                f"Phase 7 non-estimable LLaVA contrast boundary changed: {corpus}"
            )
        expected_state_missing = (
            [
                role
                for role, lane in (
                    ("left_base", "local-llava-base-image-primary-100"),
                    ("right_rr", "local-llava-rr-image-primary-100"),
                )
                if expected_llava_pair_states.get(lane) != "measured_complete"
            ]
            if expected_llava_pair_states is not None
            else None
        )
        if (
            expected_state_missing is not None
            and row["paired_compare_invoked"] is bool(expected_state_missing)
        ):
            raise Phase8Error(
                f"Phase 7 LLaVA pair availability differs from Runner state: {corpus}"
            )
        if (
            expected_state_missing is not None
            and not row["paired_compare_invoked"]
            and row["missing_roles"] != expected_state_missing
        ):
            raise Phase8Error(
                f"Phase 7 LLaVA prerequisite availability changed: {corpus}"
            )
    if expected_rr_terminal_artifact is not None:
        raise Phase8Error("current Phase 7 cannot bind historical RR terminal evidence")
    adaptivity_status = paired_status.get("qwen_replay_vs_crescendo")
    if (
        not isinstance(adaptivity_status, dict)
        or set(adaptivity_status) != set(ADAPTIVE_ARMS)
        or any(
            not isinstance(row, dict)
            or set(row) != {"analysis_ready_real_run", "inference_cluster"}
            for row in adaptivity_status.values()
        )
    ):
        raise Phase8Error("Phase 7 adaptivity paired-status inventory changed")
    conditional_na_lanes = value.get("conditional_na_lanes")
    defense_evidence = value.get("defense_local_evidence")
    if conditional_na_lanes not in ([], [DEFENSE_LOCAL_LANE]):
        raise Phase8Error("Phase 7 boundary conditional N/A inventory differs")
    expected_defense_evidence = (
        {
            "status": "N/A",
            "value": None,
            "disposition": "conditional_na",
            "reason_code": DEFENSE_LOCAL_CONDITIONAL_REASON_CODE,
            "reason": DEFENSE_LOCAL_CONDITIONAL_REASON,
            "measured_evidence_admitted": False,
        }
        if conditional_na_lanes
        else {
            "status": "measured_runner_lane",
            "value": DEFENSE_LOCAL_LANE,
            "disposition": "runnable",
            "reason_code": None,
            "reason": None,
            "measured_evidence_admitted": (
                isinstance(value.get("runner_outcomes"), dict)
                and value["runner_outcomes"].get(DEFENSE_LOCAL_LANE)
                == "measured_complete"
            ),
        }
    )
    if defense_evidence != expected_defense_evidence:
        raise Phase8Error("Phase 7 defense evidence/N/A boundary differs")
    if expected_runner_states is not None:
        expected_lanes = (
            set(RUNNABLE_LANES)
            - RR_RUNTIME_TERMINAL_LANE_SET
            - set(OLLAMA_STATIC_TERMINAL_LANES)
            - set(conditional_na_lanes)
        )
        if (
            set(expected_runner_states) != expected_lanes
            or value.get("runner_outcomes") != dict(expected_runner_states)
        ):
            raise Phase8Error("Phase 7 boundary Runner outcomes differ")
        measured = {
            lane
            for lane, state in expected_runner_states.items()
            if state == "measured_complete"
        }
        expected_classification = any(
            lane.startswith("rjudge-") or lane.startswith("gptgeochat-")
            for lane in measured
        )
        if (
            (classification["estimate_rows"] > 0) is not expected_classification
            or (
                expected_proxy_conditions is not None
                and bool(expected_proxy_conditions) is not expected_approximate
            )
            or (expected_classification and "rules" not in modes)
            or (cascade_lanes and "rules,guardrail" not in modes)
        ):
            raise Phase8Error("Phase 7 boundary rows differ from measured lanes")
    if expected_native_states is not None and value.get("native_outcomes") != dict(
        expected_native_states
    ):
        raise Phase8Error("Phase 7 boundary native outcomes differ")


def validate_frozen_phase7_oracle_api(oracle: Any) -> None:
    positional = inspect.Parameter.POSITIONAL_OR_KEYWORD
    keyword_only = inspect.Parameter.KEYWORD_ONLY
    expected_api = {
        "gate5_inventory_profile": (
            ("rows", positional),
            ("label", keyword_only),
            ("validate_artifact", keyword_only),
        ),
        "validate_gate5": (
            ("manifest_path", positional),
            ("runnote_path", positional),
            ("promotion_path", positional),
            ("project", positional),
            ("work", positional),
            ("manifest_payload", keyword_only),
            ("runnote_payload", keyword_only),
            ("promotion_payload", keyword_only),
        ),
        "validate_project_and_source": (
            ("project", keyword_only),
            ("note", keyword_only),
            ("promotion", keyword_only),
            ("code_identity", keyword_only),
        ),
        "validate_core_controller": (
            ("completion_path", keyword_only),
            ("gate5_manifest", keyword_only),
            ("gate5_runnote", keyword_only),
            ("gate5_promotion", keyword_only),
            ("code_identity", keyword_only),
            ("runner_root", keyword_only),
            ("gate5_profile", keyword_only),
        ),
        "validate_extended_controller": (
            ("completion_path", keyword_only),
            ("gate5_manifest", keyword_only),
            ("gate5_runnote", keyword_only),
            ("gate5_promotion", keyword_only),
            ("code_identity", keyword_only),
            ("runner_root", keyword_only),
        ),
        "validate_native_controller": (
            ("completion_path", keyword_only),
            ("gate5_manifest", keyword_only),
            ("gate5_runnote", keyword_only),
            ("gate5_promotion", keyword_only),
            ("code_identity", keyword_only),
        ),
        "validate_runner_inventory": (
            ("runner_root", keyword_only),
            ("core", keyword_only),
            ("extended", keyword_only),
            ("code_identity", keyword_only),
            ("project_and_source", keyword_only),
            ("gate5_profile", keyword_only),
        ),
        "validate_followon_inventory": (
            ("amendment_path", keyword_only),
            ("completion_path", keyword_only),
            ("gate5_promotion", keyword_only),
            ("code_identity", keyword_only),
        ),
        "validate_seven_output_policy_inventory": (
            ("amendment_path", keyword_only),
            ("completion_path", keyword_only),
            ("gate5_manifest", keyword_only),
            ("gate5_runnote", keyword_only),
            ("gate5_promotion", keyword_only),
            ("project_and_source", keyword_only),
        ),
        "validate_phase6_recovery_completions": (
            ("paths", positional),
            ("gate5_manifest", keyword_only),
            ("gate5_runnote", keyword_only),
            ("gate5_promotion", keyword_only),
            ("project_and_source", keyword_only),
        ),
        "validate_current_ollama_completion": (
            ("gate5_path", keyword_only),
            ("completion_path", keyword_only),
            ("runner_root", keyword_only),
        ),
        "validate_vllm_stability_completion": (
            ("completion_path", positional),
            ("runner_root", keyword_only),
        ),
        "validate_phase6_campaign_terminal_inventory": (
            ("value", positional),
        ),
        "build_phase6_campaign_terminal_inventory": (
            ("gate5_rows", keyword_only),
            ("gate5_manifest", keyword_only),
            ("project_and_source", keyword_only),
            ("runner", keyword_only),
            ("native", keyword_only),
            ("recoveries", keyword_only),
            ("seven", keyword_only),
            ("followon", keyword_only),
            ("current_ollama", keyword_only),
            ("vllm_stability", keyword_only),
        ),
    }
    for name, expected_parameters in expected_api.items():
        candidate = getattr(oracle, name, None)
        if not callable(candidate):
            raise Phase8Error(f"frozen Phase 7 oracle API is absent: {name}")
        observed_parameters = tuple(
            (parameter.name, parameter.kind)
            for parameter in inspect.signature(candidate).parameters.values()
        )
        if observed_parameters != expected_parameters:
            raise Phase8Error(f"frozen Phase 7 oracle API signature differs: {name}")


def load_frozen_phase7_oracle(project_root: Path) -> types.ModuleType:
    project_candidate = project_root / ".campaign" / "phase7_analysis.py"
    if project_candidate.exists() or project_candidate.is_symlink():
        oracle_candidate = project_candidate
    else:
        oracle_candidate = Path(__file__).resolve(strict=True).with_name(
            "phase7_analysis.py"
        )
    oracle_path, oracle_source = _stable_regular_bytes(
        oracle_candidate,
        label="frozen Phase 7 semantic oracle",
        max_bytes=FROZEN_PHASE7_PAYLOAD["bytes"],
    )
    if {
        "sha256": sha256_bytes(oracle_source),
        "bytes": len(oracle_source),
    } != FROZEN_PHASE7_PAYLOAD:
        raise Phase8Error("frozen Phase 7 semantic oracle identity differs")
    oracle = types.ModuleType("_ura_phase8_frozen_phase7_oracle")
    oracle.__file__ = str(oracle_path)
    oracle.__package__ = None
    try:
        oracle_code = compile(
            oracle_source, str(oracle_path), "exec", dont_inherit=True
        )
        exec(oracle_code, oracle.__dict__)  # noqa: S102 - exact hashed source oracle
    except Exception as exc:  # noqa: BLE001 - pinned upstream validator boundary
        raise Phase8Error(f"frozen Phase 7 semantic oracle load failed: {exc}") from exc

    validate_frozen_phase7_oracle_api(oracle)
    return oracle


def replay_frozen_phase7_oracle(
    oracle: Any,
    *,
    gate5: Mapping[str, Any],
    inputs: Mapping[str, Any],
    project_and_source: Mapping[str, Any],
    core: Mapping[str, Any],
    extended: Mapping[str, Any],
    native: Mapping[str, Any],
    runner: Mapping[str, Any],
    project_root: Path,
    work_root: Path,
    runner_root: Path,
) -> None:
    try:
        gate5_manifest_path, gate5_manifest_payload = descriptor_bytes(
            gate5["manifest"], label="Phase 7 oracle Gate 5 manifest"
        )
        gate5_runnote_path, gate5_runnote_payload = descriptor_bytes(
            gate5["canonical_runnote"], label="Phase 7 oracle Gate 5 RUNNOTE"
        )
        gate5_promotion_path, gate5_promotion_payload = descriptor_bytes(
            gate5["promotion_receipt"],
            label="Phase 7 oracle Gate 5 promotion receipt",
        )
        (
            oracle_manifest,
            oracle_note,
            oracle_promotion,
            oracle_code_identity,
        ) = oracle.validate_gate5(
            gate5_manifest_path,
            gate5_runnote_path,
            gate5_promotion_path,
            project_root,
            work_root,
            manifest_payload=gate5_manifest_payload,
            runnote_payload=gate5_runnote_payload,
            promotion_payload=gate5_promotion_payload,
        )
        if oracle_code_identity != gate5.get("code_identity"):
            raise Phase8Error("Phase 7 oracle code identity differs")
        oracle_profile = oracle.gate5_inventory_profile(
            oracle_manifest["lanes"], label="Phase 7 oracle Gate 5 manifest"
        )
        oracle_project = oracle.validate_project_and_source(
            project=project_root,
            note=oracle_note,
            promotion=oracle_promotion,
            code_identity=oracle_code_identity,
        )
        oracle_core = oracle.validate_core_controller(
            completion_path=descriptor_file(
                core["completion"], label="Phase 7 oracle core completion"
            ),
            gate5_manifest=gate5_manifest_path,
            gate5_runnote=gate5_runnote_path,
            gate5_promotion=gate5_promotion_path,
            code_identity=oracle_code_identity,
            runner_root=runner_root,
            gate5_profile=oracle_profile,
        )
        oracle_extended = oracle.validate_extended_controller(
            completion_path=descriptor_file(
                extended["completion"],
                label="Phase 7 oracle extended completion",
            ),
            gate5_manifest=gate5_manifest_path,
            gate5_runnote=gate5_runnote_path,
            gate5_promotion=gate5_promotion_path,
            code_identity=oracle_code_identity,
            runner_root=runner_root,
        )
        oracle_native = oracle.validate_native_controller(
            completion_path=descriptor_file(
                native["completion"], label="Phase 7 oracle native completion"
            ),
            gate5_manifest=gate5_manifest_path,
            gate5_runnote=gate5_runnote_path,
            gate5_promotion=gate5_promotion_path,
            code_identity=inputs["code_identity"],
        )
        oracle_runner = oracle.validate_runner_inventory(
            runner_root=runner_root,
            core=oracle_core,
            extended=oracle_extended,
            code_identity=oracle_code_identity,
            project_and_source=oracle_project,
            gate5_profile=oracle_profile,
        )
        oracle_recoveries = oracle.validate_phase6_recovery_completions(
            [
                descriptor_file(
                    item,
                    label="Phase 7 oracle recovery completion",
                )
                for item in inputs["canonical_recoveries"]["completion_order"]
            ],
            gate5_manifest=gate5_manifest_path,
            gate5_runnote=gate5_runnote_path,
            gate5_promotion=gate5_promotion_path,
            project_and_source=oracle_project,
        )
        oracle_followon = oracle.validate_followon_inventory(
            amendment_path=descriptor_file(
                inputs["followon"]["amendment"],
                label="Phase 7 oracle follow-on amendment",
            ),
            completion_path=descriptor_file(
                inputs["followon"]["completion"],
                label="Phase 7 oracle follow-on completion",
            ),
            gate5_promotion=gate5_promotion_path,
            code_identity=inputs["code_identity"],
        )
        oracle_seven = oracle.validate_seven_output_policy_inventory(
            amendment_path=descriptor_file(
                inputs["seven_output_policy_amendment"]["amendment"],
                label="Phase 7 oracle seven-row amendment",
            ),
            completion_path=descriptor_file(
                inputs["seven_output_policy_amendment"]["completion"],
                label="Phase 7 oracle seven-row completion",
            ),
            gate5_manifest=gate5_manifest_path,
            gate5_runnote=gate5_runnote_path,
            gate5_promotion=gate5_promotion_path,
            project_and_source=oracle_project,
        )
        oracle_current_ollama = oracle.validate_current_ollama_completion(
            gate5_path=descriptor_file(
                inputs["current_ollama"]["gate5"],
                label="Phase 7 oracle current Ollama Gate 5 amendment",
            ),
            completion_path=descriptor_file(
                inputs["current_ollama"]["completion"],
                label="Phase 7 oracle current Ollama Phase 6 completion",
            ),
            runner_root=runner_root,
        )
        oracle_vllm_stability = oracle.validate_vllm_stability_completion(
            descriptor_file(
                inputs["vllm_stability"]["completion"],
                label="Phase 7 oracle vLLM stability completion",
            ),
            runner_root=runner_root,
        )
        oracle_campaign = oracle.build_phase6_campaign_terminal_inventory(
            gate5_rows=oracle_manifest["lanes"],
            gate5_manifest=gate5_manifest_path,
            project_and_source=oracle_project,
            runner=oracle_runner,
            native=oracle_native,
            recoveries=oracle_recoveries,
            seven=oracle_seven,
            followon=oracle_followon,
            current_ollama=oracle_current_ollama,
            vllm_stability=oracle_vllm_stability,
        )
    except Phase8Error:
        raise
    except Exception as exc:  # noqa: BLE001 - pinned upstream validator boundary
        raise Phase8Error(f"frozen Phase 7 semantic replay failed: {exc}") from exc
    if (
        oracle_manifest
        != strict_loads(
            gate5_manifest_payload, label="Phase 7 oracle manifest snapshot"
        )
        or oracle_project != project_and_source
        or oracle_core != core
        or oracle_extended != extended
        or oracle_native != native
        or oracle_runner != runner
        or oracle_recoveries != inputs.get("canonical_recoveries")
        or oracle_followon != inputs.get("followon")
        or oracle_seven != inputs.get("seven_output_policy_amendment")
        or oracle_current_ollama != inputs.get("current_ollama")
        or oracle_vllm_stability != inputs.get("vllm_stability")
        or oracle_campaign != inputs.get("campaign_terminal_inventory")
    ):
        raise Phase8Error("Phase 7 frozen semantic replay differs from its input")


def validate_defense_response_audit(root: Path, *, label: str) -> None:
    response_paths = sorted(root.glob("*.responses.jsonl"))
    if not response_paths:
        raise Phase8Error(f"{label}: no defense response streams")
    exact_fields = {
        "schema", "stage", "judge", "label", "model", "model_revision",
        "model_identity", "device", "guardrail_queried", "parsed",
    }
    responses = 0
    two_stage = 0
    for response_path in response_paths:
        _response_path, response_payload = _stable_regular_bytes(
            response_path,
            label=f"{label} response stream",
            max_bytes=MAX_TEXT_BYTES,
        )
        for line in response_payload.splitlines():
            if not line.strip():
                continue
            response = strict_loads(line, label=f"{label} response")
            raw = response.get("raw") if isinstance(response, dict) else None
            audit = raw.get("defense_judge_audit") if isinstance(raw, dict) else None
            if not isinstance(audit, list) or len(audit) not in {1, 2}:
                raise Phase8Error(f"{label}: invalid defense audit length")
            expected_stages = ["input"] if len(audit) == 1 else ["input", "output"]
            if [item.get("stage") for item in audit if isinstance(item, dict)] != expected_stages:
                raise Phase8Error(f"{label}: defense stage order changed")
            for item in audit:
                if (
                    not isinstance(item, dict)
                    or set(item) != exact_fields
                    or item.get("schema") != "ura-defense-judge-audit/1"
                    or item.get("judge") != "guardrail"
                    or item.get("label") not in {"safe", "violation"}
                    or item.get("model") != EXPECTED_DEFENSE_GUARDRAIL["model"]
                    or item.get("model_revision")
                    != EXPECTED_DEFENSE_GUARDRAIL["revision"]
                    or item.get("model_identity")
                    != (
                        f"{EXPECTED_DEFENSE_GUARDRAIL['model']}@"
                        f"{EXPECTED_DEFENSE_GUARDRAIL['revision']}"
                    )
                    or item.get("device") != EXPECTED_DEFENSE_GUARDRAIL["device"]
                    or item.get("guardrail_queried") is not True
                    or item.get("parsed") is not True
                ):
                    raise Phase8Error(f"{label}: exact defense Guard facts changed")
            if len(audit) == 1:
                if (
                    audit[0].get("label") != "violation"
                    or raw.get("defense") != "blocked"
                    or raw.get("stage") != "input"
                    or raw.get("base_target_queried") is not False
                    or raw.get("defense_stages_evaluated") != ["input"]
                ):
                    raise Phase8Error(f"{label}: invalid input block evidence")
            else:
                if (
                    audit[0].get("label") != "safe"
                    or raw.get("base_target_queried") is not True
                    or raw.get("defense_stages_evaluated") != ["input", "output"]
                ):
                    raise Phase8Error(f"{label}: invalid two-stage defense evidence")
                two_stage += 1
            responses += 1
    if responses <= 0 or two_stage <= 0:
        raise Phase8Error(f"{label}: no target/output-defense observation")


def validate_llava_pair_artifact(
    path: Path,
    *,
    corpus: str,
    paired_invoked: bool,
    prerequisite_roles: Mapping[str, Any],
    left_model: str,
    right_model: str,
) -> None:
    value = strict_object(path, label=f"LLaVA base-vs-RR {corpus}")
    if value.get("schema") != RR_NON_ESTIMABLE_CONTRAST_SCHEMA:
        if not paired_invoked:
            raise Phase8Error(
                f"Phase 7 LLaVA paired artifact lacks its invocation: {corpus}"
            )
        facets = value.get("facets") if isinstance(value, dict) else None
        facet = facets.get(corpus) if isinstance(facets, dict) else None
        metrics = facet.get("metrics") if isinstance(facet, dict) else None
        if (
            value.get("schema_version") != "1.0-faceted"
            or value.get("attacker") != "replay"
            or value.get("requested_mode") != "auto"
            or value.get("left_selector")
            != {"model_spec": left_model, "defense": "none"}
            or value.get("right_selector")
            != {"model_spec": right_model, "defense": "none"}
            or set(facets or {}) != {corpus}
            or value.get("unavailable_facets") != {}
            or value.get("unexplained_exclusions") != 0
            or not isinstance(facet, dict)
            or facet.get("comparison_type") != "cross_target_endpoint_noncausal"
            or facet.get("causal_effect_established") is not False
            or type(facet.get("analysis_ready_real_run")) is not bool
            or facet.get("pairing_unit") != "datapoint_id x requested_seed"
            or facet.get("inference_cluster")
            != "source_cluster_id (fallback datapoint_id)"
            or facet.get("unexplained_exclusions") != 0
            or facet.get("static_exact_input_required") is not True
            or not isinstance(metrics, dict)
            or not metrics
            or prerequisite_roles != {}
        ):
            raise Phase8Error(
                f"Phase 7 measured LLaVA paired artifact changed: {corpus}"
            )
        estimated = [
            metric for metric in metrics.values()
            if isinstance(metric, dict) and metric.get("status") == "estimated"
        ]
        if facet["analysis_ready_real_run"] is not True or not estimated:
            raise Phase8Error(
                f"Phase 7 LLaVA measured pair is not analysis-ready: {corpus}"
            )
        return

    expected_fields = {
        "schema", "status", "contrast_id", "modality", "facet",
        "comparison_type", "planned_estimand", "planned_contrast_missing",
        "reason_code", "reason", "missing_roles", "prerequisite_roles",
        "analysis_ready_real_run", "estimate", "paired_compare_invoked",
        "failed_lane_metric_evidence_admitted", "human_audit_eligible", "facets",
        "target_calls", "judge_calls", "provider_http_attempts",
        "human_labels_consumed",
    }
    expected_planned_estimand = (
        "paired static-image endpoint by datapoint_id x requested_seed"
    )
    facet = value.get("facets", {}).get(corpus) if isinstance(
        value.get("facets"), dict
    ) else None
    evidence = (
        facet.get("paired_compare_evidence")
        if isinstance(facet, dict)
        else None
    )
    if (
        not isinstance(value, dict)
        or set(value) != expected_fields
        or value.get("schema") != RR_NON_ESTIMABLE_CONTRAST_SCHEMA
        or value.get("status") != "unavailable"
        or value.get("contrast_id") != "llava-base-vs-rr"
        or value.get("modality") != "image"
        or value.get("facet") != corpus
        or value.get("comparison_type") != "cross_target_endpoint_noncausal"
        or value.get("planned_estimand") != expected_planned_estimand
        or value.get("planned_contrast_missing") is not True
        or value.get("paired_compare_invoked") is not paired_invoked
        or not isinstance(value.get("missing_roles"), list)
        or value.get("prerequisite_roles") != dict(prerequisite_roles)
        or set(prerequisite_roles) != {"left_base", "right_rr"}
        or not set(value.get("missing_roles", [])) <= set(prerequisite_roles)
        or value.get("analysis_ready_real_run") is not False
        or value.get("estimate") is not None
        or value.get("failed_lane_metric_evidence_admitted") is not False
        or value.get("human_audit_eligible") is not False
        or value.get("facets")
        != {corpus: {
            "analysis_ready_real_run": False,
            "inference_cluster": "source_cluster_id (fallback datapoint_id)",
            "paired_compare_evidence": evidence,
        }}
        or any(value.get(field) != 0 for field in (
            "target_calls", "judge_calls", "provider_http_attempts"
        ))
        or value.get("human_labels_consumed") is not False
    ):
        raise Phase8Error(
            f"Phase 7 LLaVA base-vs-RR artifact is not failure-bound: {corpus}"
        )
    if not paired_invoked:
        expected_reason_code = {
            ("left_base",): "left_base_lane_failed",
            ("right_rr",): "right_rr_lane_failed",
            ("left_base", "right_rr"):
                "left_base_and_right_rr_lanes_failed",
        }.get(tuple(value["missing_roles"]))
        expected_reason = {
            "left_base_lane_failed": (
                "The bounded LLaVA base image lane failed, so the planned base-vs-RR "
                "endpoint contrast has no left arm."
            ),
            "right_rr_lane_failed": (
                "The bounded GraySwan RR image lane failed, so the planned base-vs-RR "
                "endpoint contrast has no right arm."
            ),
            "left_base_and_right_rr_lanes_failed": (
                "Both bounded LLaVA image lanes failed, so neither arm of the planned "
                "base-vs-RR endpoint contrast is available."
            ),
        }.get(value.get("reason_code"))
        if (
            value.get("reason_code") != expected_reason_code
            or expected_reason is None
            or value.get("reason") != expected_reason
            or not value["missing_roles"]
            or evidence is not None
        ):
            raise Phase8Error(
                f"Phase 7 LLaVA failed-lane contrast changed: {corpus}"
            )
        return
    expected_reason = {
        "paired_compare_validation_failed": (
            "The completed base and RR lanes did not satisfy the exact paired "
            "comparison validation contract for this facet."
        ),
        "paired_compare_readiness_failed": (
            "The completed base and RR facet failed one or more exact paired "
            "analysis-readiness checks, so no estimate is admitted."
        ),
    }.get(value.get("reason_code"))
    if (
        expected_reason is None
        or value.get("reason") != expected_reason
        or value["missing_roles"] != []
        or not isinstance(evidence, dict)
    ):
        raise Phase8Error(
            f"Phase 7 completed-lane non-estimable contrast changed: {corpus}"
        )
    evidence_path = descriptor_file(
        evidence.get("artifact"),
        label=f"Phase 7 LLaVA paired evidence {corpus}",
    )
    if evidence.get("kind") == "validation_failure":
        lines = evidence_path.read_text(encoding="utf-8").splitlines()
        if (
            set(evidence) != {"kind", "artifact"}
            or not lines
            or not lines[-1].startswith("paired comparison validation failed: ")
        ):
            raise Phase8Error(
                f"Phase 7 LLaVA validation-failure evidence changed: {corpus}"
            )
        return
    if evidence.get("kind") != "readiness_failure" or set(evidence) != {
        "kind", "artifact", "failed_checks",
    }:
        raise Phase8Error(
            f"Phase 7 LLaVA readiness-failure evidence changed: {corpus}"
        )
    paired = strict_object(
        evidence_path, label=f"Phase 7 LLaVA paired raw result {corpus}"
    )
    raw_facets = paired.get("facets") if isinstance(paired, dict) else None
    raw_facet = raw_facets.get(corpus) if isinstance(raw_facets, dict) else None
    checks = raw_facet.get("analysis_readiness_checks") if isinstance(
        raw_facet, dict
    ) else None
    failed_checks = sorted(
        key for key, passed in checks.items() if passed is False
    ) if isinstance(checks, dict) else []
    if (
        paired.get("schema_version") != "1.0-faceted"
        or paired.get("attacker") != "replay"
        or paired.get("requested_mode") != "auto"
        or paired.get("left_selector")
        != {"model_spec": left_model, "defense": "none"}
        or paired.get("right_selector")
        != {"model_spec": right_model, "defense": "none"}
        or set(raw_facets or {}) != {corpus}
        or paired.get("unavailable_facets") != {}
        or paired.get("unexplained_exclusions") != 0
        or not isinstance(raw_facet, dict)
        or raw_facet.get("comparison_type")
        != "cross_target_endpoint_noncausal"
        or raw_facet.get("causal_effect_established") is not False
        or raw_facet.get("pairing_unit") != "datapoint_id x requested_seed"
        or raw_facet.get("inference_cluster")
        != "source_cluster_id (fallback datapoint_id)"
        or raw_facet.get("unexplained_exclusions") != 0
        or raw_facet.get("static_exact_input_required") is not True
        or raw_facet.get("analysis_ready_real_run") is not False
        or not failed_checks
        or evidence.get("failed_checks") != failed_checks
    ):
        raise Phase8Error(
            f"Phase 7 LLaVA raw readiness evidence changed: {corpus}"
        )


def _canonical_view_relative_path(raw: object) -> str:
    if not isinstance(raw, str) or not raw or raw.startswith(("/", "\\")):
        raise Phase8Error("Phase 7 Runner view relative path is not canonical")
    parts = raw.split("/")
    if (
        "\\" in raw
        or any(part in {"", ".", ".."} for part in parts)
        or any(len(part) > 255 for part in parts)
        or "/".join(parts) != raw
    ):
        raise Phase8Error("Phase 7 Runner view relative path is not canonical")
    return raw


def validate_phase7_runner_view(
    value: object,
    *,
    expected_source_root: Path,
    expected_view_root: Path,
    expected_measured_lanes: Sequence[str],
) -> Path:
    """Revalidate every completed-view byte and independent source/copy identity."""

    expected_fields = {
        "schema",
        "status",
        "source_runner_root",
        "view_root",
        "included_measured_lanes",
        "regular_files_copied",
        "logical_bytes",
        "source_files_modified",
        "permitted_view_outputs",
        "file_inventory",
        "file_inventory_sha256",
    }
    if not isinstance(value, dict) or set(value) != expected_fields:
        raise Phase8Error("Phase 7 Runner view receipt fields differ")
    source_root = checked_dir(
        expected_source_root, label="Phase 7 Runner view source root"
    )
    view_root = checked_dir(
        expected_view_root, label="Phase 7 Runner input view"
    )
    inventory = value.get("file_inventory")
    if (
        value.get("schema") != "ura-phase7-runner-input-view/3"
        or value.get("status") != "complete"
        or value.get("source_runner_root") != str(source_root)
        or value.get("view_root") != str(view_root)
        or value.get("included_measured_lanes") != list(expected_measured_lanes)
        or type(value.get("regular_files_copied")) is not int
        or value.get("regular_files_copied", 0) < 1
        or type(value.get("logical_bytes")) is not int
        or value.get("logical_bytes", 0) < 1
        or value.get("source_files_modified") is not False
        or value.get("permitted_view_outputs") != []
        or not isinstance(inventory, list)
        or not inventory
        or value.get("file_inventory_sha256")
        != sha256_bytes(canonical(inventory))
    ):
        raise Phase8Error("Phase 7 Runner input view contract differs")

    source_files: set[Path] = set()
    for lane in expected_measured_lanes:
        if not isinstance(lane, str) or not lane:
            raise Phase8Error("Phase 7 Runner view lane identity differs")
        lane_root = checked_dir(
            source_root / lane, label=f"Phase 7 measured Runner lane {lane}"
        )
        for candidate in [lane_root, *sorted(lane_root.rglob("*"))]:
            if candidate.is_symlink():
                raise Phase8Error("Phase 7 Runner view source contains a symlink")
            if candidate.is_dir():
                continue
            if not candidate.is_file():
                raise Phase8Error(
                    "Phase 7 Runner view source contains a non-regular entry"
                )
            source_files.add(candidate.resolve(strict=True))

    view_files: set[Path] = set()
    for candidate in sorted(view_root.rglob("*")):
        if candidate.is_symlink():
            raise Phase8Error("Phase 7 Runner input view contains a symlink")
        if candidate.is_dir():
            continue
        if not candidate.is_file():
            raise Phase8Error(
                "Phase 7 Runner input view contains a non-regular entry"
            )
        view_files.add(candidate.resolve(strict=True))

    relative_paths: list[str] = []
    recorded_source_files: set[Path] = set()
    recorded_view_files: set[Path] = set()
    logical_bytes = 0
    for index, row in enumerate(inventory):
        if not isinstance(row, dict) or set(row) != {
            "relative_path",
            "source",
            "view",
            "source_file_identity",
            "view_file_identity",
            "independent_copy",
            "source_view_samefile",
            "view_mode",
            "view_link_count",
        }:
            raise Phase8Error(
                f"Phase 7 Runner view inventory row {index} fields differ"
            )
        relative = _canonical_view_relative_path(row.get("relative_path"))
        source_path, source_payload = descriptor_bytes(
            row.get("source"),
            label=f"Phase 7 Runner view source {relative}",
            max_bytes=512 * 1024 * 1024,
        )
        view_path, view_payload = descriptor_bytes(
            row.get("view"),
            label=f"Phase 7 Runner view file {relative}",
            max_bytes=512 * 1024 * 1024,
        )
        relative_path = Path(*relative.split("/"))
        if (
            row["source"].get("path") != str(source_path)
            or row["view"].get("path") != str(view_path)
            or source_path != (source_root / relative_path).resolve(strict=True)
            or view_path != (view_root / relative_path).resolve(strict=True)
            or source_payload != view_payload
            or row["source"].get("sha256") != row["view"].get("sha256")
            or row["source"].get("bytes") != row["view"].get("bytes")
        ):
            raise Phase8Error(
                f"Phase 7 Runner view source/view descriptor differs: {relative}"
            )
        source_stat = source_path.stat()
        view_stat = view_path.stat()
        expected_source_identity = {
            "device": source_stat.st_dev,
            "inode": source_stat.st_ino,
        }
        expected_view_identity = {
            "device": view_stat.st_dev,
            "inode": view_stat.st_ino,
        }
        for label, identity in (
            ("source", row.get("source_file_identity")),
            ("view", row.get("view_file_identity")),
        ):
            if (
                not isinstance(identity, dict)
                or set(identity) != {"device", "inode"}
                or type(identity.get("device")) is not int
                or identity["device"] < 0
                or type(identity.get("inode")) is not int
                or identity["inode"] < 0
            ):
                raise Phase8Error(
                    f"Phase 7 Runner view {label} file identity differs: {relative}"
                )
        if (
            row.get("source_file_identity") != expected_source_identity
            or row.get("view_file_identity") != expected_view_identity
            or row.get("independent_copy") is not True
            or row.get("source_view_samefile") is not False
            or expected_source_identity == expected_view_identity
            or source_path.samefile(view_path)
            or type(row.get("view_mode")) is not int
            or row.get("view_mode") != stat.S_IMODE(view_stat.st_mode)
            or row["view_mode"] & (stat.S_IWUSR | stat.S_IWGRP | stat.S_IWOTH)
            or row.get("view_link_count") != 1
            or view_stat.st_nlink != 1
        ):
            raise Phase8Error(
                f"Phase 7 Runner view independent-copy identity differs: {relative}"
            )
        relative_paths.append(relative)
        if source_path in recorded_source_files or view_path in recorded_view_files:
            raise Phase8Error("Phase 7 Runner view inventory contains a duplicate file")
        recorded_source_files.add(source_path)
        recorded_view_files.add(view_path)
        logical_bytes += len(view_payload)

    if (
        relative_paths != sorted(relative_paths)
        or len(set(relative_paths)) != len(relative_paths)
        or recorded_source_files != source_files
        or recorded_view_files != view_files
        or value["regular_files_copied"] != len(inventory)
        or value["logical_bytes"] != logical_bytes
    ):
        raise Phase8Error("Phase 7 Runner view exact file inventory differs")
    return view_root


def validate_phase7_human_sampling_view(
    value: object,
    *,
    core_view_receipt: Mapping[str, Any],
    runner_root: Path,
    expected_view_root: Path,
    runner: Mapping[str, Any],
    recoveries: Mapping[str, Any],
    seven: Mapping[str, Any],
    followon: Mapping[str, Any],
    current_ollama: Mapping[str, Any],
    vllm_stability: Mapping[str, Any],
) -> tuple[Path, dict[str, Any]]:
    """Revalidate the sampling-only union without reading failed sibling roots."""

    fields = {
        "schema", "status", "core_view_receipt", "source_runner_root",
        "view_root", "included_core_lanes", "included_amendment_lanes",
        "amendment_result_roots", "included_followon_lanes",
        "followon_result_roots", "included_current_ollama_lanes",
        "current_ollama_result_roots", "included_vllm_stability_lanes",
        "vllm_stability_result_roots", "regular_files_copied", "logical_bytes",
        "source_files_modified", "permitted_view_outputs", "file_inventory",
        "file_inventory_sha256",
    }
    contract = phase7_sampling_lane_contract(
        runner_root=runner_root,
        runner=runner,
        recoveries=recoveries,
        seven=seven,
        followon=followon,
        current_ollama=current_ollama,
        vllm_stability=vllm_stability,
    )
    inventory = value.get("file_inventory") if isinstance(value, dict) else None
    view_root = checked_dir(expected_view_root, label="Phase 7 human sampling view")
    runner_root = checked_dir(runner_root, label="Phase 7 human sampling source root")
    if (
        not isinstance(value, dict)
        or set(value) != fields
        or value.get("schema") != "ura-phase7-human-audit-sampling-view/4"
        or value.get("status") != "complete"
        or value.get("core_view_receipt") != dict(core_view_receipt)
        or value.get("source_runner_root") != str(runner_root)
        or value.get("view_root") != str(view_root)
        or value.get("included_core_lanes") != contract["canonical_lanes"]
        or value.get("included_amendment_lanes") != contract["seven_lanes"]
        or value.get("amendment_result_roots") != contract["seven_roots"]
        or value.get("included_followon_lanes") != contract["followon_lanes"]
        or value.get("followon_result_roots") != contract["followon_roots"]
        or value.get("included_current_ollama_lanes")
        != contract["current_ollama_lanes"]
        or value.get("current_ollama_result_roots")
        != contract["current_ollama_roots"]
        or value.get("included_vllm_stability_lanes")
        != contract["vllm_stability_lanes"]
        or value.get("vllm_stability_result_roots")
        != contract["vllm_stability_roots"]
        or value.get("source_files_modified") is not False
        or value.get("permitted_view_outputs") != []
        or not isinstance(inventory, list)
        or value.get("file_inventory_sha256")
        != sha256_bytes(canonical(inventory))
    ):
        raise Phase8Error("Phase 7 human sampling view contract differs")

    expected_sources: dict[str, Path] = {}
    for lane in contract["lane_order"]:
        root = checked_dir(
            contract["lane_roots"][lane], label=f"{lane} successful sampling root"
        )
        try:
            prefix = root.relative_to(runner_root).as_posix()
        except ValueError as exc:
            raise Phase8Error(f"{lane} sampling root escaped Runner storage") from exc
        for path in sorted(root.rglob("*")):
            if path.is_symlink() or (not path.is_dir() and not path.is_file()):
                raise Phase8Error(f"{lane} successful root contains an unsafe entry")
            if path.is_file():
                relative = f"{prefix}/{path.relative_to(root).as_posix()}"
                if relative in expected_sources:
                    raise Phase8Error("Phase 7 human sampling source path collides")
                expected_sources[relative] = path

    recorded: dict[str, Path] = {}
    logical_bytes = 0
    entry_fields = {
        "relative_path", "source", "view", "source_file_identity",
        "view_file_identity", "independent_copy", "source_view_samefile",
        "view_mode", "view_link_count",
    }
    for row in inventory:
        if not isinstance(row, dict) or set(row) != entry_fields:
            raise Phase8Error("Phase 7 human sampling file binding differs")
        relative = _canonical_view_relative_path(row.get("relative_path"))
        if relative not in expected_sources or relative in recorded:
            raise Phase8Error("Phase 7 human sampling source inventory differs")
        source_path, source_payload = descriptor_bytes(
            row["source"], label=f"Phase 7 human sampling source {relative}"
        )
        view_path, view_payload = descriptor_bytes(
            row["view"], label=f"Phase 7 human sampling copy {relative}"
        )
        expected_source = expected_sources[relative].resolve(strict=True)
        expected_view = view_root.joinpath(*relative.split("/")).resolve(strict=True)
        source_stat = source_path.stat()
        view_stat = view_path.stat()
        source_identity = {"device": source_stat.st_dev, "inode": source_stat.st_ino}
        view_identity = {"device": view_stat.st_dev, "inode": view_stat.st_ino}
        if (
            source_path != expected_source
            or view_path != expected_view
            or source_payload != view_payload
            or row.get("source_file_identity") != source_identity
            or row.get("view_file_identity") != view_identity
            or source_identity == view_identity
            or row.get("independent_copy") is not True
            or row.get("source_view_samefile") is not False
            or source_path.samefile(view_path)
            or row.get("view_mode") != stat.S_IMODE(view_stat.st_mode)
            or row["view_mode"] & (stat.S_IWUSR | stat.S_IWGRP | stat.S_IWOTH)
            or row.get("view_link_count") != 1
            or view_stat.st_nlink != 1
        ):
            raise Phase8Error("Phase 7 human sampling copy identity differs")
        recorded[relative] = view_path
        logical_bytes += len(view_payload)
    actual_files: set[str] = set()
    for path in view_root.rglob("*"):
        if path.is_symlink() or (not path.is_dir() and not path.is_file()):
            raise Phase8Error("Phase 7 human sampling view contains an unsafe entry")
        if path.is_file():
            actual_files.add(path.relative_to(view_root).as_posix())
    if (
        list(recorded) != sorted(recorded)
        or set(recorded) != set(expected_sources)
        or actual_files != set(expected_sources)
        or value.get("regular_files_copied") != len(recorded)
        or value.get("logical_bytes") != logical_bytes
    ):
        raise Phase8Error("Phase 7 human sampling exact inventory differs")
    return view_root, contract


def _sampling_lane_binding(
    *,
    lane: str,
    root: Path,
    evidence: Mapping[str, Any],
    expected_revision: str | None,
    expected_source: str | None,
) -> tuple[str, str]:
    """Bind one successful sampling root to its own sealed request artifacts."""

    root = checked_dir(root, label=f"{lane} successful sampling root")
    grids = sorted(root.glob("*.grid.json"))
    envelopes = sorted(root.glob("*.request-envelope.json"))
    eligibility = sorted(root.glob("*.eligibility.json"))
    if (
        len(grids) != 1
        or len(envelopes) != 1
        or len(eligibility) != 1
        or list(root.glob("*.grid.lock"))
        or list(root.glob("*.cell.lock"))
        or list(root.glob("*.error.json"))
    ):
        raise Phase8Error(f"{lane}: successful sampling root is ambiguous")
    bound = collect_descriptors(evidence)
    for path, label in (
        (grids[0], "grid"),
        (envelopes[0], "request envelope"),
        (eligibility[0], "eligibility plan"),
    ):
        if descriptor(path) not in bound:
            raise Phase8Error(f"{lane}: sampling {label} lacks lifecycle authorization")
    grid = strict_object(grids[0], label=f"{lane} sampling grid")
    request = grid.get("request") if isinstance(grid, dict) else None
    project = request.get("project_revision") if isinstance(request, dict) else None
    source = (
        request.get("source_conformance_artifact")
        if isinstance(request, dict)
        else None
    )
    revision_sha = project.get("sha256") if isinstance(project, dict) else None
    source_sha = source.get("sha256") if isinstance(source, dict) else None
    if (
        grid.get("status") != "complete"
        or grid.get("n_errors") != 0
        or not isinstance(request, dict)
        or request.get("execution_purpose") != "measured_run"
        or request.get("dry_run") is not False
        or request.get("attestation_probe") is not False
        or HEX64.fullmatch(str(revision_sha or "")) is None
        or HEX64.fullmatch(str(source_sha or "")) is None
        or (expected_revision is not None and revision_sha != expected_revision)
        or (expected_source is not None and source_sha != expected_source)
    ):
        raise Phase8Error(f"{lane}: sampling request stratum changed")
    envelope_path, envelope_payload = _stable_regular_bytes(
        envelopes[0], label=f"{lane} sampling request envelope", max_bytes=4 * 1024 * 1024
    )
    envelope, envelope_descriptor = _request_envelope_from_bytes(
        envelope_path, envelope_payload, label=f"{lane} sampling request envelope"
    )
    envelope_project = envelope.get("bindings", {}).get("project_revision")
    envelope_request = envelope.get("request")
    try:
        from ura.eligibility import validate_eligibility_plan
        from ura.request_envelope import validate_request_envelope_descriptor

        eligibility_value = validate_eligibility_plan(
            strict_object(eligibility[0], label=f"{lane} sampling eligibility")
        )
        grid_envelope_descriptor = validate_request_envelope_descriptor(
            request.get("request_envelope")
        )
    except Exception as exc:  # noqa: BLE001 - sealed sampling boundary
        raise Phase8Error(f"{lane}: sampling request artifacts are invalid") from exc
    if (
        grid_envelope_descriptor != envelope_descriptor
        or envelope_project != project
        or not isinstance(envelope_request, dict)
        or envelope_request.get("source_conformance_artifact", {}).get("sha256")
        != source_sha
        or eligibility_value.get("bindings", {}).get("request_envelope")
        != envelope_descriptor
    ):
        raise Phase8Error(f"{lane}: sampling grid/envelope/eligibility binding changed")
    return str(revision_sha), str(source_sha)


def phase7_sampling_lane_contract(
    *,
    runner_root: Path,
    runner: Mapping[str, Any],
    recoveries: Mapping[str, Any],
    seven: Mapping[str, Any],
    followon: Mapping[str, Any],
    current_ollama: Mapping[str, Any],
    vllm_stability: Mapping[str, Any],
) -> dict[str, Any]:
    """Return the exact successful Phase 7 sampling union and its strata."""

    runner_order = runner.get("lifecycle_lane_order")
    runner_states = runner.get("terminal_states")
    runner_roots = runner.get("lifecycle_lane_roots")
    authorizations = runner.get("lifecycle_authorizations")
    latest = recoveries.get("latest") if isinstance(recoveries, Mapping) else None
    if (
        not isinstance(runner_order, list)
        or not isinstance(runner_states, dict)
        or not isinstance(runner_roots, dict)
        or not isinstance(authorizations, dict)
        or not isinstance(latest, dict)
    ):
        raise Phase8Error("Phase 7 canonical sampling lifecycle is invalid")
    lane_order: list[str] = []
    lane_roots: dict[str, str] = {}
    revision_by_lane: dict[str, str] = {}
    source_by_lane: dict[str, str] = {}
    canonical_lanes: list[str] = []

    def add(
        lane: str,
        root_value: object,
        evidence: object,
        expected_revision: str | None,
        expected_source: str | None,
    ) -> None:
        if (
            lane in lane_roots
            or not isinstance(root_value, str)
            or not isinstance(evidence, Mapping)
        ):
            raise Phase8Error("Phase 7 sampling lane/root authorization is invalid")
        root = checked_dir(root_value, label=f"{lane} successful sampling root")
        try:
            root.relative_to(runner_root)
        except ValueError as exc:
            raise Phase8Error(f"{lane}: sampling root escaped Runner storage") from exc
        revision, source = _sampling_lane_binding(
            lane=lane,
            root=root,
            evidence=evidence,
            expected_revision=expected_revision,
            expected_source=expected_source,
        )
        lane_order.append(lane)
        lane_roots[lane] = str(root)
        revision_by_lane[lane] = revision
        source_by_lane[lane] = source

    for lane in runner_order:
        recovery = latest.get(lane)
        state = recovery.get("state") if isinstance(recovery, dict) else runner_states.get(lane)
        if state != "measured_complete":
            continue
        canonical_lanes.append(lane)
        if isinstance(recovery, dict):
            add(
                lane,
                recovery.get("result_root"),
                recovery.get("evidence"),
                recovery.get("project_revision_stratum"),
                recovery.get("source_conformance_stratum"),
            )
        else:
            add(lane, runner_roots.get(lane), authorizations.get(lane), None, None)

    def amendment_lanes(
        value: Mapping[str, Any],
        *,
        expected_lanes: Sequence[str],
        states: set[str],
        label: str,
    ) -> list[str]:
        terminal_states = value.get("terminal_states")
        metric_lanes = value.get("metric_lane_order")
        metric_roots = value.get("metric_roots")
        metric_evidence = value.get("metric_evidence")
        if (
            not isinstance(terminal_states, dict)
            or set(terminal_states) != set(expected_lanes)
            or set(terminal_states.values()) - states
            or not isinstance(metric_lanes, list)
            or metric_lanes
            != [lane for lane in expected_lanes if terminal_states[lane] == "measured_complete"]
            or not isinstance(metric_roots, dict)
            or set(metric_roots) != set(metric_lanes)
            or not isinstance(metric_evidence, dict)
            or set(metric_evidence) != set(metric_lanes)
            or HEX64.fullmatch(str(value.get("project_revision_receipt_sha256", ""))) is None
            or HEX64.fullmatch(str(value.get("source_conformance_sha256", ""))) is None
        ):
            raise Phase8Error(f"Phase 7 {label} sampling partition changed")
        for lane in metric_lanes:
            add(
                lane,
                metric_roots[lane],
                metric_evidence[lane],
                value["project_revision_receipt_sha256"],
                value["source_conformance_sha256"],
            )
        return list(metric_lanes)

    seven_lanes = amendment_lanes(
        seven,
        expected_lanes=SEVEN_AMENDMENT_LANES,
        states=SEVEN_TERMINAL_STATES,
        label="seven-row amendment",
    )
    followon_lanes = amendment_lanes(
        followon,
        expected_lanes=FOLLOWON_LANES,
        states=FOLLOWON_STATES,
        label="follow-on",
    )
    current_ollama_lanes = amendment_lanes(
        current_ollama,
        expected_lanes=(
            *CURRENT_OLLAMA_RUNNABLE_LANES,
            *CURRENT_OLLAMA_TYPED_TERMINAL_LANES,
        ),
        states={"measured_complete", "failed", "unavailable"},
        label="current Ollama cohort",
    )
    vllm_stability_lanes = amendment_lanes(
        vllm_stability,
        expected_lanes=tuple(row[0] for row in VLLM_STABILITY_UNIT_LAYOUT),
        states={"measured_complete"},
        label="vLLM stability cohort",
    )
    if not lane_order or len(set(lane_order)) != len(lane_order):
        raise Phase8Error("Phase 7 successful sampling lane inventory is invalid")
    revision_strata = {
        revision: [lane for lane in lane_order if revision_by_lane[lane] == revision]
        for revision in sorted(set(revision_by_lane.values()))
    }
    source_strata = {
        source: [lane for lane in lane_order if source_by_lane[lane] == source]
        for source in sorted(set(source_by_lane.values()))
    }
    return {
        "lane_order": lane_order,
        "lane_roots": lane_roots,
        "canonical_lanes": canonical_lanes,
        "seven_lanes": seven_lanes,
        "seven_roots": {lane: seven["metric_roots"][lane] for lane in seven_lanes},
        "followon_lanes": followon_lanes,
        "followon_roots": {
            lane: followon["metric_roots"][lane] for lane in followon_lanes
        },
        "current_ollama_lanes": current_ollama_lanes,
        "current_ollama_roots": {
            lane: current_ollama["metric_roots"][lane]
            for lane in current_ollama_lanes
        },
        "vllm_stability_lanes": vllm_stability_lanes,
        "vllm_stability_roots": {
            lane: vllm_stability["metric_roots"][lane]
            for lane in vllm_stability_lanes
        },
        "revision_strata": revision_strata,
        "source_conformance_strata": source_strata,
        "lane_strata": {
            lane: {
                "project_revision_receipt_sha256": revision_by_lane[lane],
                "source_conformance_sha256": source_by_lane[lane],
            }
            for lane in lane_order
        },
    }


def validate_phase7_completion(
    path: Path,
    *,
    manifest_sha: str,
    runnote_sha: str,
    promotion_sha: str,
    core_sha: str,
    extended_sha: str,
    native_sha: str,
    runner_root: Path,
    project_root: Path,
    work_root: Path,
    validate_gate5_artifacts: bool = True,
    payload: bytes | None = None,
) -> tuple[dict[str, Any], dict[str, Any]]:
    path = checked_file(path, label="Phase 7 completion")
    if payload is None:
        _path, payload = _stable_regular_bytes(
            path, label="Phase 7 completion", max_bytes=MAX_JSON_BYTES
        )
    value = strict_loads(payload, label="Phase 7 completion")
    if not isinstance(value, dict):
        raise Phase8Error("Phase 7 completion must contain one JSON object")
    expected_fields = {
        "schema",
        "status",
        "started_at_utc",
        "completed_at_utc",
        "inventory_complete",
        "input_manifest",
        "authorized_input_manifest_sha256",
        "payload",
        "analysis_root",
        "artifact_inventory",
        "campaign_terminal_inventory",
        "runner_input_view",
        "analysis_statuses",
        "explicit_limitations",
        "phase6_terminal_states",
        "target_calls",
        "judge_calls",
        "provider_http_attempts",
        "downloads_observed_bytes",
        "human_labels_consumed",
        "human_validity_claimed",
        "universal_safety_score_defined",
        "native_scales_pooled",
        "evaluator_modes_pooled",
        "human_audit_runner_input_view",
        "human_audit_sampling_index",
        "followon_terminal_states",
        "followon_metric_revision_strata",
        "seven_output_policy_terminal_states",
        "seven_output_policy_metric_revision_strata",
        "current_ollama_terminal_states",
        "current_ollama_metric_revision_strata",
        "current_ollama_target_execution",
        "vllm_stability_terminal_states",
        "vllm_stability_metric_revision_strata",
        "vllm_stability_target_execution",
    }
    if (
        set(value) != expected_fields
        or value.get("schema") != "ura-phase7-analysis-completion/2"
        or value.get("status") not in {"complete", "complete_with_explicit_limitations"}
        or not UTC_RE.fullmatch(str(value.get("started_at_utc", "")))
        or not UTC_RE.fullmatch(str(value.get("completed_at_utc", "")))
        or value.get("inventory_complete") is not True
        or value.get("human_labels_consumed") is not False
        or value.get("human_validity_claimed") is not False
        or value.get("universal_safety_score_defined") is not False
        or value.get("native_scales_pooled") is not False
        or value.get("evaluator_modes_pooled") is not False
    ):
        raise Phase8Error("Phase 7 completion contract differs")
    exact_zero_fields(
        value,
        (
            "target_calls",
            "judge_calls",
            "provider_http_attempts",
            "downloads_observed_bytes",
        ),
        label="Phase 7 completion",
    )
    control = checked_dir(path.parent, label="Phase 7 control root")
    engineering_root = checked_dir(
        work_root / "runs" / "engineering", label="canonical engineering root"
    )
    if (
        path != control / "completion.json"
        or control.parent != engineering_root
        or not control.name.startswith("phase7-analysis-")
    ):
        raise Phase8Error("Phase 7 completion moved outside its control root")
    _require_terminal_attempt(
        control,
        expected_exit=0,
        failure_names=("failure.json",),
        label="Phase 7 analysis control",
    )
    input_path, input_manifest_payload = descriptor_bytes(
        value.get("input_manifest"), label="Phase 7 input manifest"
    )
    if value.get("authorized_input_manifest_sha256") != sha256_bytes(
        input_manifest_payload
    ):
        raise Phase8Error("Phase 7 completion does not bind authorized input bytes")
    inputs = strict_loads(input_manifest_payload, label="Phase 7 input manifest")
    if not isinstance(inputs, dict):
        raise Phase8Error("Phase 7 input manifest must contain one JSON object")
    input_fields = {
        "schema",
        "inventory_complete",
        "scope",
        "controller_payload",
        "code_identity",
        "gate5",
        "project_and_source",
        "phase6",
        "runner",
        "canonical_recoveries",
        "native_runs",
        "native_outcomes",
        "seven_output_policy_amendment",
        "followon",
        "current_ollama",
        "vllm_stability",
        "campaign_terminal_inventory",
        "analysis_contract",
        "bound_artifacts",
        "bound_artifact_inventory",
    }
    if (
        set(inputs) != input_fields
        or inputs.get("schema") != "ura-phase7-analysis-inputs/2"
        or inputs.get("inventory_complete") is not True
        or inputs.get("scope")
        != "all_local_phase7_read_only_analysis_over_phase6_lifecycle"
        or inputs.get("code_identity")
        != {
            "expected_commit": EXPECTED_COMMIT,
            "framework_lock_id": EXPECTED_FRAMEWORK_LOCK,
        }
    ):
        raise Phase8Error("Phase 7 input identity differs")
    recoveries = inputs.get("canonical_recoveries")
    seven = inputs.get("seven_output_policy_amendment")
    followon = inputs.get("followon")
    current_ollama = inputs.get("current_ollama")
    vllm_stability = inputs.get("vllm_stability")
    campaign_inventory = inputs.get("campaign_terminal_inventory")
    if not all(
        isinstance(item, dict)
        for item in (
            recoveries,
            seven,
            followon,
            current_ollama,
            vllm_stability,
            campaign_inventory,
        )
    ):
        raise Phase8Error("Phase 7 current campaign snapshots are absent")
    bound = inputs.get("bound_artifacts")
    bound_inventory = inputs.get("bound_artifact_inventory")
    if not isinstance(bound, list) or not isinstance(bound_inventory, dict):
        raise Phase8Error("Phase 7 bound input inventory is absent")
    input_without_binding = dict(inputs)
    input_without_binding.pop("bound_artifacts")
    input_without_binding.pop("bound_artifact_inventory")
    if collect_descriptors(input_without_binding) != bound:
        raise Phase8Error("Phase 7 bound input inventory differs")
    bound_material = canonical(bound)
    if (
        set(bound_inventory) != {"count", "sha256", "bytes"}
        or type(bound_inventory.get("count")) is not int
        or type(bound_inventory.get("bytes")) is not int
        or bound_inventory
        != {
            "count": len(bound),
            "sha256": sha256_bytes(bound_material),
            "bytes": len(bound_material),
        }
    ):
        raise Phase8Error("Phase 7 bound input inventory digest differs")
    for row in bound:
        descriptor_file(row, label="Phase 7 bound input")
    digests = descriptor_digests(inputs)
    for expected, label in (
        (manifest_sha, "Gate 5 manifest"),
        (core_sha, "Phase 6 core completion"),
        (extended_sha, "Phase 6 extended completion"),
        (native_sha, "Phase 6 native completion"),
    ):
        if expected not in digests:
            raise Phase8Error(f"Phase 7 input omits {label}")
    gate5 = inputs.get("gate5")
    gate5_fields = {
        "manifest",
        "canonical_runnote",
        "promotion_receipt",
        "code_identity",
        "terminal_inventory",
        "lane_count",
        "runnable_lane_count",
        "terminal_lane_count",
        "target_runtime_terminal",
        "target_runtime_terminal_artifact",
        "conditional_na_lanes",
    }
    conditional_na_lanes = (
        gate5.get("conditional_na_lanes") if isinstance(gate5, dict) else None
    )
    if conditional_na_lanes not in ([], [DEFENSE_LOCAL_LANE]):
        raise Phase8Error("Phase 7 Gate 5 conditional N/A inventory differs")
    if (
        not isinstance(gate5, dict)
        or set(gate5) != gate5_fields
        or any(
            type(gate5.get(field)) is not int
            for field in (
                "lane_count",
                "runnable_lane_count",
                "terminal_lane_count",
                "target_runtime_terminal",
            )
        )
        or gate5.get("lane_count") != 46
        or not isinstance(gate5.get("code_identity"), dict)
    ):
        raise Phase8Error("Phase 7 Gate 5 inventory differs")
    gate5_observations = {
        field: descriptor_bytes(gate5[field], label=f"Phase 7 Gate 5 {field}")
        for field in ("manifest", "canonical_runnote", "promotion_receipt")
    }
    gate5_paths = {
        field: observation[0]
        for field, observation in gate5_observations.items()
    }
    if (
        sha256_bytes(gate5_observations["manifest"][1]) != manifest_sha
        or sha256_bytes(gate5_observations["canonical_runnote"][1]) != runnote_sha
        or sha256_bytes(gate5_observations["promotion_receipt"][1]) != promotion_sha
    ):
        raise Phase8Error("Phase 7 does not bind the canonical Gate 5 triple")
    gate5_manifest = strict_loads(
        gate5_observations["manifest"][1], label="Phase 7 Gate 5 manifest"
    )
    if not isinstance(gate5_manifest, dict):
        raise Phase8Error("Phase 7 Gate 5 manifest must be one JSON object")
    phase7_gate5_identity = _require_code_identity(
        gate5.get("code_identity"), label="Phase 7 Gate 5 snapshot"
    )
    if phase7_gate5_identity != _require_code_identity(
        gate5_manifest.get("code_identity"), label="Phase 7 Gate 5 manifest"
    ):
        raise Phase8Error("Phase 7 Gate 5 code identity differs")
    _gate5_runnable, gate5_terminals = _exact_inventory(
        gate5_manifest.get("lanes"),
        validate_artifact=validate_gate5_artifacts,
        code_identity=phase7_gate5_identity,
    )
    manifest_profile = _gate5_profile(_gate5_runnable, gate5_terminals)
    scheduled_core_lanes = manifest_profile["scheduled_core_lanes"]
    scheduled_runner_lanes = manifest_profile["scheduled_runner_lanes"]
    scheduled_extended_lanes = manifest_profile["scheduled_extended_lanes"]
    ollama_static_terminals = manifest_profile[
        "ollama_static_terminal_lanes"
    ]
    if (
        gate5.get("terminal_inventory") != gate5_terminals
        or manifest_profile["conditional_na_lanes"] != conditional_na_lanes
        or gate5.get("runnable_lane_count") != len(scheduled_runner_lanes)
        or gate5.get("terminal_lane_count") != len(gate5_terminals)
        or gate5.get("target_runtime_terminal")
        != manifest_profile["target_runtime_terminal"]
        or gate5.get("target_runtime_terminal_artifact")
        != manifest_profile["target_runtime_terminal_artifact"]
    ):
        raise Phase8Error("Phase 7 Gate 5 terminal snapshot differs")

    project_and_source = inputs.get("project_and_source")
    if not isinstance(project_and_source, dict) or set(project_and_source) != {
        "project_revision",
        "source_conformance",
        "source_config",
    }:
        raise Phase8Error("Phase 7 project/source inventory differs")
    project_revision = project_and_source.get("project_revision")
    source_conformance = project_and_source.get("source_conformance")
    if (
        not isinstance(project_revision, dict)
        or set(project_revision)
        != {"artifact", "revision_id", "binding", "experiment_binding"}
        or not isinstance(project_revision.get("revision_id"), str)
        or not project_revision["revision_id"].strip()
        or not isinstance(project_revision.get("binding"), dict)
        or not isinstance(project_revision.get("experiment_binding"), dict)
        or not isinstance(source_conformance, dict)
        or set(source_conformance) != {"artifact", "portfolio"}
        or source_conformance.get("portfolio") != EXPECTED_SOURCE_PORTFOLIO
    ):
        raise Phase8Error("Phase 7 project/source receipt shape differs")
    descriptor_file(
        project_revision["artifact"], label="Phase 7 project-revision receipt"
    )
    descriptor_file(
        source_conformance["artifact"], label="Phase 7 source-conformance receipt"
    )
    source_config = descriptor_file(
        project_and_source["source_config"], label="Phase 7 source-instance registry"
    )
    gate5_note = read_markdown_json_bytes(
        gate5_observations["canonical_runnote"][1],
        label="Phase 7 canonical Gate 5 RUNNOTE",
    )
    gate5_promotion = strict_loads(
        gate5_observations["promotion_receipt"][1],
        label="Phase 7 Gate 5 promotion receipt",
    )
    if not isinstance(gate5_promotion, dict):
        raise Phase8Error("Phase 7 Gate 5 promotion receipt must be one object")
    note_project = gate5_note.get("project_revision")
    note_source = gate5_note.get("source_conformance")
    promotion_inputs = gate5_promotion.get("inputs")
    deployed_project = checked_dir(project_root, label="deployed project root")
    if (
        not isinstance(note_project, dict)
        or note_project.get("artifact") != project_revision["artifact"]
        or note_project.get("binding") != project_revision["binding"]
        or not isinstance(note_source, dict)
        or note_source.get("artifact") != source_conformance["artifact"]
        or not isinstance(promotion_inputs, dict)
        or promotion_inputs.get("project_revision") != project_revision["artifact"]
        or promotion_inputs.get("source_conformance") != source_conformance["artifact"]
        or source_config
        != (deployed_project / "experiments" / "source-instances.json").resolve(
            strict=True
        )
    ):
        raise Phase8Error("Phase 7 project/source binding differs")

    phase6 = inputs.get("phase6")
    if (
        not isinstance(phase6, dict)
        or set(phase6)
        != {
            "core",
            "extended",
            "native",
            "runner_lane_count",
            "native_engine_count",
            "all_machine_inventories_complete",
        }
        or type(phase6.get("runner_lane_count")) is not int
        or phase6.get("runner_lane_count") != len(scheduled_runner_lanes)
        or type(phase6.get("native_engine_count")) is not int
        or phase6.get("native_engine_count") != 9
        or phase6.get("all_machine_inventories_complete") is not True
    ):
        raise Phase8Error("Phase 7 Phase 6 inventory differs")
    core = phase6.get("core")
    core_fields = {
        "control_root",
        "attempt_root",
        "launch",
        "completion",
        "exit_marker",
        "events_snapshot",
        "summary",
        "contract_self_test",
        "lane_specs",
        "lane_terminal_states",
        "measured_argv_states",
        "lane_evidence",
        "lane_failures",
        "conditional_na_lanes",
        "result_roots",
        "status",
    }
    if not isinstance(core, dict) or set(core) != core_fields:
        raise Phase8Error("Phase 7 core snapshot fields differ")
    core_states = core.get("lane_terminal_states")
    if (
        not isinstance(core_states, dict)
        or set(core_states) != set(scheduled_core_lanes)
        or set(core_states.values()) - {"measured_complete", "failed"}
    ):
        raise Phase8Error("Phase 7 core terminal states differ")
    core_complete = {
        lane
        for lane in scheduled_core_lanes
        if core_states[lane] == "measured_complete"
    }
    core_failed = set(scheduled_core_lanes) - core_complete
    if (
        not isinstance(core.get("lane_specs"), list)
        or len(core["lane_specs"]) != len(scheduled_core_lanes)
        or core.get("conditional_na_lanes") != conditional_na_lanes
        or not isinstance(core.get("measured_argv_states"), list)
        or len(core["measured_argv_states"]) != len(core_complete)
        or not isinstance(core.get("lane_evidence"), dict)
        or set(core["lane_evidence"]) != core_complete
        or not isinstance(core.get("lane_failures"), dict)
        or set(core["lane_failures"]) != core_failed
        or not isinstance(core.get("result_roots"), dict)
        or set(core["result_roots"]) != core_complete
        or core.get("status")
        != ("complete_with_failures" if core_failed else "complete")
    ):
        raise Phase8Error("Phase 7 core terminal partition differs")
    core_completion, core_completion_payload = descriptor_bytes(
        core["completion"], label="Phase 7 bound core completion"
    )
    core_exit, core_exit_payload = descriptor_bytes(
        core["exit_marker"], label="Phase 7 core exit"
    )
    if sha256_bytes(core_completion_payload) != core_sha or core_exit_payload != (
        b"1\n" if core_failed else b"0\n"
    ):
        raise Phase8Error("Phase 7 core completion or exit binding differs")
    authoritative_core = strict_loads(
        core_completion_payload, label="Phase 7 authoritative core completion"
    )
    if not isinstance(authoritative_core, dict):
        raise Phase8Error("Phase 7 authoritative core completion is not one object")
    if (
        authoritative_core.get("lane_terminal_states") != core_states
        or authoritative_core.get("conditional_na_lanes") != conditional_na_lanes
        or authoritative_core.get("status") != core.get("status")
    ):
        raise Phase8Error("Phase 7 core snapshot differs from its exact receipt")

    extended = phase6.get("extended")
    extended_fields = {
        "control_root",
        "attempt_root",
        "launch",
        "completion",
        "summary",
        "exit_marker",
        "typed_dispositions",
        "lane_specs",
        "lane_terminal_states",
        "measured_argv_states",
        "lane_completions",
        "lane_failures",
        "terminal_results",
        "conditional_na_lanes",
        "result_roots",
        "status",
    }
    if not isinstance(extended, dict) or set(extended) != extended_fields:
        raise Phase8Error("Phase 7 extended snapshot fields differ")
    extended_states = extended.get("lane_terminal_states")
    if (
        not isinstance(extended_states, dict)
        or set(extended_states) != set(scheduled_extended_lanes)
        or set(extended_states.values()) - {"measured_complete", "failed"}
    ):
        raise Phase8Error("Phase 7 extended terminal states differ")
    extended_complete = {
        lane
        for lane in scheduled_extended_lanes
        if extended_states[lane] == "measured_complete"
    }
    extended_failed = set(scheduled_extended_lanes) - extended_complete
    if (
        not isinstance(extended.get("lane_specs"), list)
        or len(extended["lane_specs"]) != len(scheduled_extended_lanes)
        or extended.get("conditional_na_lanes") != conditional_na_lanes
        or not isinstance(extended.get("measured_argv_states"), list)
        or len(extended["measured_argv_states"]) != len(extended_complete)
        or not isinstance(extended.get("lane_completions"), list)
        or len(extended["lane_completions"]) != len(extended_complete)
        or not isinstance(extended.get("lane_failures"), dict)
        or set(extended["lane_failures"]) != extended_failed
        or not isinstance(extended.get("result_roots"), dict)
        or set(extended["result_roots"]) != extended_complete
        or not isinstance(extended.get("terminal_results"), dict)
        or set(extended["terminal_results"])
        != set(EXTENDED_BASE_TERMINALS) | set(ollama_static_terminals)
        or extended.get("status")
        != ("complete_with_failures" if extended_failed else "complete")
    ):
        raise Phase8Error("Phase 7 extended terminal partition differs")
    extended_completion, extended_completion_payload = descriptor_bytes(
        extended["completion"], label="Phase 7 bound extended completion"
    )
    extended_exit, extended_exit_payload = descriptor_bytes(
        extended["exit_marker"], label="Phase 7 extended exit"
    )
    if sha256_bytes(extended_completion_payload) != extended_sha or extended_exit_payload != (
        b"1\n" if extended_failed else b"0\n"
    ):
        raise Phase8Error("Phase 7 extended completion or exit binding differs")
    authoritative_extended = strict_loads(
        extended_completion_payload, label="Phase 7 authoritative extended completion"
    )
    if not isinstance(authoritative_extended, dict):
        raise Phase8Error("Phase 7 authoritative extended completion is not one object")
    if authoritative_extended.get(
        "lane_terminal_states"
    ) != extended_states or authoritative_extended.get(
        "conditional_na_lanes"
    ) != conditional_na_lanes or authoritative_extended.get("status") != extended.get(
        "status"
    ):
        raise Phase8Error("Phase 7 extended snapshot differs from its exact receipt")

    native = phase6.get("native")
    native_fields = {
        "control_root",
        "attempt_root",
        "completion",
        "exit_marker",
        "plan",
        "project_revision",
        "payload",
        "launch",
        "summary",
        "gate5_inputs",
        "terminal_states",
        "terminal_artifacts",
        "engine_reservations",
        "canonical_native_envelopes",
        "conditional_na_lanes",
        "contract_self_test",
        "local_model_calls",
        "authorized_local_call_cap",
        "status",
    }
    if not isinstance(native, dict) or set(native) != native_fields:
        raise Phase8Error("Phase 7 native snapshot fields differ")
    native_states = native.get("terminal_states")
    if (
        not isinstance(native_states, dict)
        or set(native_states) != set(NATIVE_ENGINES)
        or any(
            native_states[engine] not in {"run", "failed"}
            for engine, planned in NATIVE_PLANNED_TERMINALS.items()
            if planned == "run"
        )
        or any(
            native_states[engine] != planned
            for engine, planned in NATIVE_PLANNED_TERMINALS.items()
            if planned != "run"
        )
        or not isinstance(native.get("terminal_artifacts"), dict)
        or set(native["terminal_artifacts"]) != set(NATIVE_ENGINES)
        or not isinstance(native.get("engine_reservations"), dict)
        or set(native["engine_reservations"])
        != {
            engine
            for engine, planned in NATIVE_PLANNED_TERMINALS.items()
            if planned == "run"
        }
        or not isinstance(native.get("canonical_native_envelopes"), dict)
        or native.get("conditional_na_lanes") != conditional_na_lanes
    ):
        raise Phase8Error("Phase 7 native terminal inventory differs")
    native_failed = {
        engine for engine in NATIVE_ENGINES if native_states[engine] == "failed"
    }
    native_runs = {
        engine for engine in NATIVE_ENGINES if native_states[engine] == "run"
    }
    if (
        set(native["canonical_native_envelopes"]) != native_runs
        or type(native.get("local_model_calls")) is not int
        or not 0 <= native["local_model_calls"] <= NATIVE_AUTHORIZED_LOCAL_CALL_CAP
        or type(native.get("authorized_local_call_cap")) is not int
        or native.get("authorized_local_call_cap") != NATIVE_AUTHORIZED_LOCAL_CALL_CAP
        or native.get("status")
        != ("complete_with_failures" if native_failed else "complete")
    ):
        raise Phase8Error("Phase 7 native terminal partition differs")
    native_completion, native_completion_payload = descriptor_bytes(
        native["completion"], label="Phase 7 bound native completion"
    )
    native_exit, native_exit_payload = descriptor_bytes(
        native["exit_marker"], label="Phase 7 native exit"
    )
    if sha256_bytes(native_completion_payload) != native_sha or native_exit_payload != (
        b"1\n" if native_failed else b"0\n"
    ):
        raise Phase8Error("Phase 7 native completion or exit binding differs")
    authoritative_native = strict_loads(
        native_completion_payload, label="Phase 7 authoritative native completion"
    )
    if not isinstance(authoritative_native, dict):
        raise Phase8Error("Phase 7 authoritative native completion is not one object")
    _native_plan_path, native_plan = descriptor_object(
        native["plan"], label="Phase 7 native plan"
    )
    _native_project_path, native_project_receipt = descriptor_object(
        native["project_revision"], label="Phase 7 native project-revision receipt"
    )
    native_plan_code = native_plan.get("code_identity")
    native_repository = native_project_receipt.get("repository")
    native_commit = authoritative_native.get("expected_commit")
    if (
        re.fullmatch(r"[0-9a-f]{40}", str(native_commit)) is None
        or authoritative_native.get("framework_lock_id") != EXPECTED_FRAMEWORK_LOCK
    ):
        raise Phase8Error("Phase 7 native historical identity is invalid")
    require_descriptor_identity(
        native["payload"],
        expected=phase6_payload_identity(
            "native",
            expected_commit=str(native_commit),
            label="Phase 7 native payload",
        ),
        label="Phase 7 native payload",
    )
    if (
        not isinstance(native_plan_code, dict)
        or native_plan_code.get("project_revision") != native["project_revision"]
        or not isinstance(native_repository, dict)
        or native_repository.get("clean") is not True
        or native_plan_code.get("expected_commit")
        != native_commit
        or native_repository.get("expected_commit")
        != native_commit
        or native_repository.get("observed_commit")
        != native_commit
    ):
        raise Phase8Error(
            "Phase 7 native snapshot is not bound to its current project revision"
        )
    if authoritative_native.get(
        "terminal_states"
    ) != native_states or authoritative_native.get(
        "conditional_na_lanes"
    ) != conditional_na_lanes or authoritative_native.get("status") != native.get(
        "status"
    ):
        raise Phase8Error("Phase 7 native snapshot differs from its exact receipt")

    native_outcomes = inputs.get("native_outcomes")
    if (
        not isinstance(native_outcomes, dict)
        or set(native_outcomes) != {"engine_order", "states", "terminals"}
        or native_outcomes.get("engine_order") != list(NATIVE_ENGINES)
        or native_outcomes.get("states") != native_states
        or native_outcomes.get("terminals") != native["terminal_artifacts"]
        or inputs.get("native_runs")
        != [
            native["canonical_native_envelopes"][engine]
            for engine in NATIVE_ENGINES
            if engine in native_runs
        ]
    ):
        raise Phase8Error("Phase 7 native outcome snapshot differs")

    runner = inputs.get("runner")
    runner_fields = {
        "root",
        "metric_lane_order",
        "lifecycle_lane_order",
        "lifecycle_lane_roots",
        "terminal_states",
        "lifecycle_states",
        "lifecycle_authorizations",
        "conditional_na_lanes",
        "metric_grids",
        "metric_completion_markers",
        "metric_eligibility_plans",
        "lifecycle_eligibility_plans",
        "failed_runner_artifacts",
        "lifecycle_live_attestations",
        "model_selectors",
        "guardrail_selector",
        "classification_lanes",
        "cascade_expected_lanes",
        "proxy_expected_conditions",
        "source_parser_common_metric_boundary",
    }
    runner_states = runner.get("terminal_states") if isinstance(runner, dict) else None
    expected_runner_states = {**core_states, **extended_states}
    measured_lanes = [
        lane
        for lane in scheduled_runner_lanes
        if expected_runner_states[lane] == "measured_complete"
    ]
    if (
        not isinstance(runner, dict)
        or set(runner) != runner_fields
        or runner_states != expected_runner_states
        or runner.get("conditional_na_lanes") != conditional_na_lanes
        or runner.get("metric_lane_order") != measured_lanes
        or runner.get("lifecycle_lane_order") != scheduled_runner_lanes
        or not measured_lanes
        or not isinstance(runner.get("lifecycle_lane_roots"), dict)
        or not isinstance(runner.get("lifecycle_states"), dict)
        or set(runner.get("lifecycle_states", {})) != set(scheduled_runner_lanes)
        or not isinstance(runner.get("lifecycle_authorizations"), dict)
        or set(runner.get("lifecycle_authorizations", {}))
        != set(scheduled_runner_lanes)
        or any(
            runner["lifecycle_states"].get(lane) != "complete"
            for lane in measured_lanes
        )
        or any(
            runner["lifecycle_states"].get(lane) not in {"partial", "failed"}
            for lane in set(scheduled_runner_lanes) - set(measured_lanes)
        )
        or not isinstance(runner.get("metric_grids"), list)
        or len(runner["metric_grids"]) != len(measured_lanes)
        or not isinstance(runner.get("metric_completion_markers"), list)
        or not runner["metric_completion_markers"]
        or not isinstance(runner.get("metric_eligibility_plans"), list)
        or len(runner["metric_eligibility_plans"]) != len(measured_lanes)
        or not isinstance(runner.get("lifecycle_eligibility_plans"), list)
        or len(runner["lifecycle_eligibility_plans"])
        < len(runner["metric_eligibility_plans"])
        or not isinstance(runner.get("failed_runner_artifacts"), dict)
        or set(runner["failed_runner_artifacts"])
        != set(scheduled_runner_lanes) - set(measured_lanes)
        or not isinstance(runner.get("lifecycle_live_attestations"), list)
        or not runner["lifecycle_live_attestations"]
        or not isinstance(runner.get("model_selectors"), dict)
        or set(runner["model_selectors"])
        != {"qwen3_vl", "llava_base"}
        or any(
            not isinstance(selector, str) or not selector.strip()
            for selector in runner.get("model_selectors", {}).values()
        )
        or runner.get("guardrail_selector") != EXPECTED_GUARDRAIL
        or runner.get("classification_lanes")
        != sorted(
            lane
            for lane in measured_lanes
            if lane.startswith("rjudge-") or lane.startswith("gptgeochat-")
        )
        or runner.get("source_parser_common_metric_boundary")
        != "source_metric_only_not_common_unless_separately_opted_in"
    ):
        raise Phase8Error("Phase 7 sealed Runner inventory differs")
    if checked_dir(
        str(runner.get("root", "")), label="Phase 7 Runner root"
    ) != checked_dir(runner_root, label="canonical measured Runner root"):
        raise Phase8Error("Phase 7 Runner root is not canonical")
    for lane in core_complete:
        if (
            checked_dir(core["result_roots"][lane], label=f"{lane} core result root")
            != runner_root / lane
        ):
            raise Phase8Error(f"{lane}: Phase 7 core result root is not canonical")
    for lane in extended_complete:
        if (
            checked_dir(
                extended["result_roots"][lane],
                label=f"{lane} extended result root",
            )
            != runner_root / lane
        ):
            raise Phase8Error(f"{lane}: Phase 7 extended result root is not canonical")

    specs: dict[str, dict[str, Any]] = {}
    spec_descriptors: dict[str, dict[str, Any]] = {}
    for rows, lanes, schema, label in (
        (
            core["lane_specs"],
            set(scheduled_core_lanes),
            "ura-phase6-core-lane-spec/1",
            "core",
        ),
        (
            extended["lane_specs"],
            set(scheduled_extended_lanes),
            "ura-phase6-extended-lane-spec/1",
            "extended",
        ),
        ):
        observed: set[str] = set()
        for raw in rows:
            _spec_path, spec = descriptor_object(
                raw, label=f"Phase 7 {label} lane spec"
            )
            lane = spec.get("lane_id")
            if (
                spec.get("schema") != schema
                or not isinstance(lane, str)
                or lane not in lanes
                or lane in observed
                or lane in specs
            ):
                raise Phase8Error(f"Phase 7 {label} lane-spec identity differs")
            target = spec.get("target")
            if (
                not isinstance(target, dict)
                or not isinstance(target.get("spec"), str)
                or not target["spec"]
                or not isinstance(spec.get("expected_corpora"), list)
                or not spec["expected_corpora"]
                or any(
                    not isinstance(corpus, str) or not corpus
                    for corpus in spec["expected_corpora"]
                )
                or not isinstance(spec.get("expected_attacker"), str)
                or not spec["expected_attacker"]
                or not isinstance(spec.get("expected_judges"), list)
                or spec.get("approximate_common_metrics") not in {True, False}
            ):
                raise Phase8Error(f"{lane}: Phase 7 lane-spec contract differs")
            expected_defense = "both" if lane == "defense-local" else "none"
            expected_defense_guard = (
                "guardrail" if lane == "defense-local" else "rules"
            )
            if (
                spec.get("defense", "none") != expected_defense
                or spec.get("defense_guard", "rules") != expected_defense_guard
            ):
                raise Phase8Error(f"{lane}: Phase 7 defense spec differs")
            observed.add(lane)
            specs[lane] = spec
            spec_descriptors[lane] = raw
        if observed != lanes:
            raise Phase8Error(f"Phase 7 {label} lane-spec inventory differs")
    if set(specs) != set(scheduled_runner_lanes):
        raise Phase8Error("Phase 7 Runner lane-spec inventory differs")

    def retained_descriptor(root: Path, raw: object, *, label: str) -> dict[str, Any]:
        if not isinstance(raw, dict) or set(raw) != {"file", "sha256", "bytes"}:
            raise Phase8Error(f"{label} retained descriptor differs")
        filename = raw.get("file")
        if (
            not isinstance(filename, str)
            or not filename
            or Path(filename).is_absolute()
        ):
            raise Phase8Error(f"{label} retained locator differs")
        artifact = (root / filename).resolve(strict=True)
        if not is_beneath(artifact, root):
            raise Phase8Error(f"{label} escaped its Runner lane")
        observed = descriptor(artifact)
        if observed["sha256"] != raw.get("sha256") or observed["bytes"] != raw.get(
            "bytes"
        ):
            raise Phase8Error(f"{label} retained bytes differ")
        return observed

    grid_paths: dict[str, Path] = {}
    grid_values: dict[str, dict[str, Any]] = {}
    expected_markers: set[Path] = set()
    seen_run_ids: set[str] = set()
    expected_eligibility: list[dict[str, Any]] = []
    attestation_by_sha: dict[str, dict[str, Any]] = {}
    for raw in runner["metric_grids"]:
        grid_path, grid = descriptor_object(raw, label="Phase 7 measured grid")
        lane = grid_path.parent.name
        if (
            lane not in measured_lanes
            or grid_path.parent != runner_root / lane
            or lane in grid_paths
        ):
            raise Phase8Error("Phase 7 measured grid placement differs")
        cells = grid.get("cells")
        request = grid.get("request")
        spec = specs[lane]
        target = spec["target"]
        if (
            grid.get("status") != "complete"
            or type(grid.get("n_errors")) is not int
            or grid.get("n_errors") != 0
            or type(grid.get("requested_cells")) is not int
            or type(grid.get("accounted_cells")) is not int
            or grid.get("requested_cells") != grid.get("accounted_cells")
            or not isinstance(cells, list)
            or len(cells) != grid.get("requested_cells")
            or not isinstance(request, dict)
        ):
            raise Phase8Error(f"{lane}: Phase 7 grid is not exactly complete")
        expected_corpora = list(spec["expected_corpora"])
        if (
            request.get("execution_purpose") != "measured_run"
            or request.get("dry_run") is not False
            or request.get("attestation_probe") is not False
            or request.get("corpora") != expected_corpora
            or request.get("attackers") != [spec["expected_attacker"]]
            or request.get("judges") != spec["expected_judges"]
            or request.get("approximate_common_metrics")
            is not spec["approximate_common_metrics"]
            or request.get("defense") != spec.get("defense", "none")
            or request.get("defense_guard") != spec.get("defense_guard", "rules")
            or request.get("group_keys") != list(GROUP_KEYS)
            or request.get("models") != [target["spec"]]
            or grid.get("requested_cells") != len(expected_corpora)
            or not isinstance(request.get("project_revision"), dict)
            or HEX64.fullmatch(
                str(request["project_revision"].get("sha256", ""))
            ) is None
            or not isinstance(request.get("source_conformance_artifact"), dict)
            or HEX64.fullmatch(
                str(request["source_conformance_artifact"].get("sha256", ""))
            ) is None
            or not isinstance(request.get("source_config_artifact"), dict)
            or HEX64.fullmatch(
                str(request["source_config_artifact"].get("sha256", ""))
            ) is None
        ):
            raise Phase8Error(
                f"{lane}: Phase 7 measured request differs from lane spec"
            )
        if lane == "defense-local":
            if (
                request.get("defense_guardrail_model")
                != EXPECTED_DEFENSE_GUARDRAIL["model"]
                or request.get("defense_guardrail_revision")
                != EXPECTED_DEFENSE_GUARDRAIL["revision"]
                or request.get("defense_guardrail_device")
                != EXPECTED_DEFENSE_GUARDRAIL["device"]
            ):
                raise Phase8Error("defense-local: Phase 7 defense binding changed")
            validate_defense_response_audit(
                grid_path.parent, label="defense-local Phase 7 evidence"
            )
        expected_eligibility.append(
            retained_descriptor(
                grid_path.parent,
                request.get("eligibility_plan"),
                label=f"{lane} final eligibility plan",
            )
        )
        live = request.get("live_attestation")
        live_artifacts = live.get("artifacts") if isinstance(live, dict) else None
        if (
            not isinstance(live, dict)
            or live.get("mode") != "measured"
            or not isinstance(live_artifacts, list)
            or not live_artifacts
        ):
            raise Phase8Error(f"{lane}: Phase 7 measured attestation differs")
        for index, live_raw in enumerate(live_artifacts, start=1):
            retained = retained_descriptor(
                grid_path.parent,
                live_raw,
                label=f"{lane} live attestation {index}",
            )
            existing = attestation_by_sha.get(retained["sha256"])
            if (
                existing is not None
                and _stable_regular_bytes(
                    existing["path"],
                    label="Phase 7 duplicate live attestation",
                    max_bytes=MAX_TEXT_BYTES,
                )[1]
                != _stable_regular_bytes(
                    retained["path"],
                    label="Phase 7 duplicate live attestation",
                    max_bytes=MAX_TEXT_BYTES,
                )[1]
            ):
                raise Phase8Error(
                    "Phase 7 equal attestation digests resolve to different bytes"
                )
            attestation_by_sha.setdefault(retained["sha256"], retained)
        lane_marker_names: set[str] = set()
        for cell in cells:
            marker_name = (
                cell.get("completion_marker") if isinstance(cell, dict) else None
            )
            run_id = cell.get("run_id") if isinstance(cell, dict) else None
            if (
                not isinstance(cell, dict)
                or cell.get("status") not in {"complete", "complete_existing"}
                or not isinstance(marker_name, str)
                or not marker_name
                or Path(marker_name).is_absolute()
                or not isinstance(run_id, str)
                or not run_id
                or run_id in seen_run_ids
            ):
                raise Phase8Error(f"{lane}: Phase 7 grid cell differs")
            marker_path = (grid_path.parent / marker_name).resolve(strict=True)
            if marker_path.parent != runner_root / lane:
                raise Phase8Error(f"{lane}: Phase 7 completion marker escaped")
            marker = strict_object(
                marker_path, label=f"{lane} Phase 7 completion marker"
            )
            if marker.get("status") != "complete" or marker.get("format_version") != 2:
                raise Phase8Error(
                    f"{lane}: Phase 7 completion marker is not v2 complete"
                )
            seen_run_ids.add(run_id)
            lane_marker_names.add(marker_name)
            expected_markers.add(marker_path)
        if lane_marker_names != {
            path.name for path in grid_path.parent.glob("*.complete.json")
        }:
            raise Phase8Error(f"{lane}: Phase 7 completion-marker inventory differs")
        grid_paths[lane] = grid_path
        grid_values[lane] = grid
    if set(grid_paths) != set(measured_lanes):
        raise Phase8Error("Phase 7 measured grid inventory differs")
    observed_markers = {
        descriptor_file(raw, label="Phase 7 completion marker")
        for raw in runner["metric_completion_markers"]
    }
    if observed_markers != expected_markers:
        raise Phase8Error("Phase 7 completion-marker inventory differs")
    if runner["metric_eligibility_plans"] != expected_eligibility:
        raise Phase8Error("Phase 7 final eligibility-plan inventory differs")
    expected_lifecycle_roots: dict[str, str] = {}
    expected_failed_artifacts: dict[str, list[dict[str, Any]]] = {}
    expected_lifecycle_states: dict[str, str] = {}
    expected_lifecycle_critical: dict[str, list[dict[str, Any]]] = {}
    expected_lifecycle_grid_statuses: dict[str, list[str]] = {}
    expected_lifecycle_groups: dict[
        str, dict[str, list[dict[str, Any]]]
    ] = {}
    lifecycle_plan_by_path = {
        str(descriptor_file(item, label="metric eligibility plan").resolve()): item
        for item in expected_eligibility
    }
    lifecycle_attestation_by_sha = dict(attestation_by_sha)

    def lifecycle_groups(root: Path | None) -> dict[str, list[dict[str, Any]]]:
        patterns = {
            "runner_grid_artifacts": "*.grid.json",
            "runner_request_envelopes": "*.request-envelope.json",
            "runner_eligibility_artifacts": "*.eligibility.json",
            "runner_error_artifacts": "*.error.json",
        }
        return {
            field: (
                [descriptor(path) for path in sorted(root.rglob(pattern))]
                if root is not None
                else []
            )
            for field, pattern in patterns.items()
        }

    def grouped_lifecycle_artifacts(
        groups: Mapping[str, Sequence[Mapping[str, Any]]],
    ) -> list[dict[str, Any]]:
        return sorted(
            [dict(item) for items in groups.values() for item in items],
            key=lambda item: str(item["path"]),
        )

    for lane in scheduled_runner_lanes:
        candidate = runner_root / lane
        if expected_runner_states[lane] == "measured_complete":
            lane_root = checked_dir(candidate, label=f"{lane} lifecycle Runner root")
            expected_lifecycle_roots[lane] = str(lane_root)
            expected_lifecycle_states[lane] = "complete"
            expected_lifecycle_grid_statuses[lane] = ["complete"]
            expected_lifecycle_groups[lane] = lifecycle_groups(lane_root)
            expected_lifecycle_critical[lane] = grouped_lifecycle_artifacts(
                expected_lifecycle_groups[lane]
            )
            continue
        expected_failed_artifacts[lane] = []
        if not candidate.exists() and not candidate.is_symlink():
            expected_lifecycle_states[lane] = "failed"
            expected_lifecycle_grid_statuses[lane] = []
            expected_lifecycle_groups[lane] = lifecycle_groups(None)
            expected_lifecycle_critical[lane] = []
            continue
        lane_root = checked_dir(
            candidate, label=f"{lane} failed lifecycle Runner root"
        )
        expected_lifecycle_roots[lane] = str(lane_root)
        expected_lifecycle_groups[lane] = lifecycle_groups(lane_root)
        expected_lifecycle_critical[lane] = grouped_lifecycle_artifacts(
            expected_lifecycle_groups[lane]
        )
        files: list[Path] = []
        for artifact in sorted(lane_root.rglob("*")):
            if artifact.is_symlink():
                raise Phase8Error(f"{lane}: failed Runner lifecycle contains a symlink")
            if artifact.is_dir():
                continue
            if not artifact.is_file():
                raise Phase8Error(
                    f"{lane}: failed Runner lifecycle contains a non-regular artifact"
                )
            if artifact.name.endswith((".grid.lock", ".cell.lock")):
                raise Phase8Error(f"{lane}: failed Runner lifecycle is still running")
            files.append(artifact)
        expected_failed_artifacts[lane] = [descriptor(artifact) for artifact in files]
        failed_grid_paths = sorted(lane_root.rglob("*.grid.json"))
        if len(failed_grid_paths) > 1:
            raise Phase8Error(f"{lane}: failed lifecycle contains multiple grids")
        grid_statuses: list[str] = []
        for grid_path in failed_grid_paths:
            failed_grid = strict_object(
                grid_path, label=f"{lane} failed Runner lifecycle grid"
            )
            status = failed_grid.get("status")
            request = failed_grid.get("request")
            if (
                status not in {"complete", "partial", "running"}
                or not isinstance(request, dict)
                or request.get("execution_purpose") != "measured_run"
                or request.get("dry_run") is not False
                or request.get("attestation_probe") is not False
            ):
                raise Phase8Error(f"{lane}: failed Runner grid is not terminal measured evidence")
            grid_statuses.append(str(status))
            live = request.get("live_attestation")
            artifacts = live.get("artifacts") if isinstance(live, dict) else None
            if (
                not isinstance(live, dict)
                or live.get("mode") != "measured"
                or not isinstance(artifacts, list)
                or not artifacts
            ):
                raise Phase8Error(
                    f"{lane}: failed measured grid lacks live-attestation binding"
                )
            for index, raw in enumerate(artifacts, start=1):
                retained = retained_descriptor(
                    lane_root,
                    raw,
                    label=f"{lane} failed-grid live attestation {index}",
                )
                existing = lifecycle_attestation_by_sha.get(retained["sha256"])
                if (
                    existing is not None
                    and _stable_regular_bytes(
                        existing["path"],
                        label="duplicate lifecycle attestation",
                        max_bytes=MAX_TEXT_BYTES,
                    )[1]
                    != _stable_regular_bytes(
                        retained["path"],
                        label="duplicate lifecycle attestation",
                        max_bytes=MAX_TEXT_BYTES,
                    )[1]
                ):
                    raise Phase8Error(
                        "same lifecycle attestation digest resolves to different bytes"
                    )
                lifecycle_attestation_by_sha.setdefault(retained["sha256"], retained)
        expected_lifecycle_states[lane] = (
            "partial" if "partial" in grid_statuses else "failed"
        )
        expected_lifecycle_grid_statuses[lane] = grid_statuses
        for plan_path in sorted(lane_root.rglob("*.eligibility.json")):
            lifecycle_plan_by_path.setdefault(
                str(plan_path.resolve()), descriptor(plan_path)
            )
    expected_lifecycle_plans = [
        lifecycle_plan_by_path[path] for path in sorted(lifecycle_plan_by_path)
    ]
    plan_ids: list[str] = []
    for item in expected_lifecycle_plans:
        _plan_path, plan = descriptor_object(
            item, label="lifecycle eligibility plan"
        )
        plan_id = plan.get("plan_id")
        if not isinstance(plan_id, str) or not plan_id:
            raise Phase8Error("lifecycle eligibility plan lacks a plan identity")
        plan_ids.append(plan_id)
    if len(set(plan_ids)) != len(plan_ids):
        raise Phase8Error("lifecycle eligibility plan identity is duplicated")
    expected_lifecycle_attestations = [
        lifecycle_attestation_by_sha[key]
        for key in sorted(lifecycle_attestation_by_sha)
    ]
    state_by_lane: dict[str, dict[str, Any]] = {}
    state_observations: dict[str, tuple[Path, bytes]] = {}
    controller_failure_by_lane = {
        **dict(core.get("lane_failures", {})),
        **dict(extended.get("lane_failures", {})),
    }
    for controller in (core, extended):
        for item in controller.get("measured_argv_states", []):
            state_path, state_payload = descriptor_bytes(
                item, label="Runner exact measured argv"
            )
            lane = state_path.parent.name
            if lane not in scheduled_runner_lanes or lane in state_by_lane:
                raise Phase8Error("exact measured argv lifecycle identity is ambiguous")
            state_by_lane[lane] = item
            state_observations[lane] = (state_path, state_payload)
        control_root = checked_dir(
            controller.get("control_root", ""),
            label="Phase 6 Runner controller root",
        )
        for lane, state in controller.get("lane_terminal_states", {}).items():
            if state != "failed":
                continue
            state_path = control_root / "lanes" / lane / "exact-measured-argv.json"
            if state_path.exists() or state_path.is_symlink():
                state_path, state_payload = _stable_regular_bytes(
                    state_path,
                    label=f"{lane} failed exact measured argv",
                    max_bytes=MAX_JSON_BYTES,
                )
                state_desc = descriptor_from_bytes(state_path, state_payload)
                existing = state_by_lane.setdefault(lane, state_desc)
                if existing != state_desc:
                    raise Phase8Error(
                        f"{lane}: failed exact measured argv binding differs"
                    )
                state_observations.setdefault(lane, (state_path, state_payload))
    for lane, state_descriptor in state_by_lane.items():
        state_path, state_payload = state_observations[lane]
        state = strict_loads(
            state_payload, label=f"{lane} exact measured argv lifecycle state"
        )
        if not isinstance(state, dict):
            raise Phase8Error(f"{lane}: exact measured argv state is not one object")
        expected_schema = (
            "ura-phase6-core-measured-argv/1"
            if lane in scheduled_core_lanes
            else "ura-phase6-extended-measured-argv/1"
        )
        result_root = state.get("result_root")
        runner_argv = state.get("runner_argv")
        if (
            state.get("schema") != expected_schema
            or state.get("lane_spec") != spec_descriptors[lane]
            or not isinstance(result_root, str)
            or Path(result_root).resolve() != (runner_root / lane).resolve()
            or not isinstance(runner_argv, list)
            or not runner_argv
            or any(
                not isinstance(argument, str) or not argument
                for argument in runner_argv
            )
            or runner_argv.count("--out") != 1
            or runner_argv.index("--out") + 1 >= len(runner_argv)
            or runner_argv[runner_argv.index("--out") + 1] != result_root
            or state.get("resume_semantics")
            != "invoke_exact_runner_argv_or_accept_strictly_revalidated_complete_runner_grid"
        ):
            raise Phase8Error(
                f"{lane}: exact measured argv lifecycle binding changed"
            )
    expected_lifecycle_authorizations: dict[str, dict[str, Any]] = {}
    for lane in scheduled_runner_lanes:
        terminal_state = expected_runner_states[lane]
        lifecycle_state = expected_lifecycle_states[lane]
        critical = expected_lifecycle_critical[lane]
        failure = controller_failure_by_lane.get(lane)
        if (terminal_state == "failed") != (failure is not None):
            raise Phase8Error(f"{lane}: controller failure/lifecycle partition differs")
        groups = expected_lifecycle_groups[lane]
        artifact_kinds = lifecycle_artifact_kinds(
            grid_statuses=expected_lifecycle_grid_statuses[lane],
            artifact_groups=groups,
        )
        status = lifecycle_authorization_status(
            terminal_state=terminal_state,
            lifecycle_state=lifecycle_state,
            artifact_kinds=artifact_kinds,
        )
        if status == "complete_runner_grid" and (
            not groups["runner_grid_artifacts"]
            or not groups["runner_request_envelopes"]
            or not groups["runner_eligibility_artifacts"]
            or groups["runner_error_artifacts"]
        ):
            raise Phase8Error(f"{lane}: complete lifecycle artifact groups differ")
        if status == "partial_runner_grid" and (
            not groups["runner_grid_artifacts"]
            or not groups["runner_request_envelopes"]
            or not groups["runner_eligibility_artifacts"]
            or not groups["runner_error_artifacts"]
        ):
            raise Phase8Error(f"{lane}: partial lifecycle artifact groups differ")
        expected_lifecycle_authorizations[lane] = {
            "terminal_state": terminal_state,
            "lifecycle_state": lifecycle_state,
            "lifecycle_registry_status": status,
            "level1_tool_input_status": (
                "retained_runner_artifacts"
                if status != "pre_runner_failure_no_request_artifact"
                else "registry_only_pre_runner_failure"
            ),
            "result_root": expected_lifecycle_roots.get(lane),
            "controller_failure": failure,
            "exact_measured_argv": state_by_lane.get(lane),
            "runner_lifecycle_artifacts": critical,
            **groups,
            "request_artifact_status": (
                "present"
                if groups["runner_request_envelopes"]
                else (
                    "runner_lifecycle_present_without_request_envelope"
                    if critical
                    else "no_runner_request_artifact"
                )
            ),
        }
    if (
        runner["lifecycle_lane_roots"] != expected_lifecycle_roots
        or runner["lifecycle_states"] != expected_lifecycle_states
        or runner["lifecycle_authorizations"]
        != expected_lifecycle_authorizations
        or runner["failed_runner_artifacts"] != expected_failed_artifacts
        or runner["lifecycle_eligibility_plans"] != expected_lifecycle_plans
        or runner["lifecycle_live_attestations"]
        != expected_lifecycle_attestations
    ):
        raise Phase8Error("Phase 7 lifecycle Runner authorization differs")

    qwen_lanes = {
        "local-qwen3-vl-text-primary-100",
        "local-qwen3-vl-image-primary-100",
        "rjudge-qwen3-vl",
        "gptgeochat-qwen3-vl",
        "crescendo-qwen3-vl",
        "defense-local",
        "bridge-pyrit",
        "bridge-deepteam",
        "bridge-h4rm3l",
        "bridge-spikee",
        "bridge-purplellama",
        "harmbench-replay",
    }
    qwen_lanes &= set(scheduled_runner_lanes)
    llava_base_lanes = {
        "local-llava-base-text-primary-100",
        "local-llava-base-image-primary-100",
        "rjudge-llava-base",
        "gptgeochat-llava-base",
    }
    model_selectors = runner["model_selectors"]
    if (
        set(model_selectors) != {"qwen3_vl", "llava_base"}
        or
        {specs[lane]["target"]["spec"] for lane in qwen_lanes}
        != {model_selectors["qwen3_vl"]}
        or {specs[lane]["target"]["spec"] for lane in llava_base_lanes}
        != {model_selectors["llava_base"]}
        or not isinstance(seven.get("rr_model_selector"), str)
        or not seven["rr_model_selector"]
        or seven["rr_model_selector"] == model_selectors["llava_base"]
    ):
        raise Phase8Error("Phase 7 exact target-selector families differ")
    classification_lanes = {
        lane
        for lane in measured_lanes
        if lane.startswith("rjudge-") or lane.startswith("gptgeochat-")
    }
    for lane in measured_lanes:
        request = grid_values[lane]["request"]
        if lane in classification_lanes:
            if (
                specs[lane]["expected_judges"] != ["rules"]
                or specs[lane]["approximate_common_metrics"] is not False
                or request.get("guardrail_model") is not None
                or request.get("guardrail_revision") is not None
                or request.get("guardrail_device") is not None
            ):
                raise Phase8Error(f"{lane}: Phase 7 source-parser boundary differs")
        elif (
            specs[lane]["expected_judges"] != ["rules", "guardrail"]
            or request.get("guardrail_model") != EXPECTED_GUARDRAIL["model"]
            or request.get("guardrail_revision") != EXPECTED_GUARDRAIL["revision"]
            or request.get("guardrail_device") != EXPECTED_GUARDRAIL["device"]
        ):
            raise Phase8Error(f"{lane}: Phase 7 guardrail boundary differs")

    analysis_contract = inputs.get("analysis_contract")
    analysis_contract_fields = {
        "level1_over_every_final_eligibility_plan",
        "lifecycle_registry_includes_every_scheduled_runner_lane",
        "level1_consumes_only_retained_runner_and_request_artifacts",
        "suite_and_level2_successful_runner_only",
        "suite_and_level2_native_scales_separate",
        "transfer_attacker",
        "llava_image_arms",
        "qwen_replay_vs_crescendo_arms",
        "paired_inference_unit",
        "evaluator_modes_are_compatibility_keys",
        "missingness_and_decision_coverage_required",
        "source_parser_classification_kept_out_of_common_metrics",
        "failed_phase6_lanes_excluded_from_metric_and_level2_views",
        "missing_prerequisites_emit_typed_unavailable_artifacts",
        "analysis_subprocesses_require_successful_prerequisite_lanes",
        "human_labels_consumed",
        "target_calls_permitted",
        "judge_calls_permitted",
        "provider_http_attempts_permitted",
    }
    if (
        not isinstance(analysis_contract, dict)
        or set(analysis_contract) != analysis_contract_fields
        or any(
            analysis_contract.get(field) is not True
            for field in (
                "level1_over_every_final_eligibility_plan",
                "lifecycle_registry_includes_every_scheduled_runner_lane",
                "level1_consumes_only_retained_runner_and_request_artifacts",
                "suite_and_level2_successful_runner_only",
                "suite_and_level2_native_scales_separate",
                "evaluator_modes_are_compatibility_keys",
                "missingness_and_decision_coverage_required",
                "source_parser_classification_kept_out_of_common_metrics",
                "failed_phase6_lanes_excluded_from_metric_and_level2_views",
                "missing_prerequisites_emit_typed_unavailable_artifacts",
                "analysis_subprocesses_require_successful_prerequisite_lanes",
            )
        )
        or analysis_contract.get("transfer_attacker") != "replay"
        or analysis_contract.get("llava_image_arms") != list(IMAGE_ARMS)
        or analysis_contract.get("qwen_replay_vs_crescendo_arms") != list(ADAPTIVE_ARMS)
        or analysis_contract.get("paired_inference_unit") != "source_cluster_id"
        or analysis_contract.get("human_labels_consumed") is not False
    ):
        raise Phase8Error("Phase 7 analysis boundary contract differs")
    exact_zero_fields(
        analysis_contract,
        (
            "target_calls_permitted",
            "judge_calls_permitted",
            "provider_http_attempts_permitted",
        ),
        label="Phase 7 analysis contract",
    )

    completion_states = value.get("phase6_terminal_states")
    if completion_states != {
        "core": core_states,
        "extended": extended_states,
        "native": native_states,
    }:
        raise Phase8Error("Phase 7 completion terminal-state snapshot differs")
    completion_payload, completion_payload_bytes = descriptor_bytes(
        value.get("payload"), label="Phase 7 controller payload"
    )
    input_payload, input_payload_bytes = descriptor_bytes(
        inputs.get("controller_payload"), label="Phase 7 input controller payload"
    )
    require_descriptor_identity(
        inputs["controller_payload"],
        expected=FROZEN_PHASE7_PAYLOAD,
        label="Phase 7 authorized payload",
    )
    require_descriptor_identity(
        value["payload"],
        expected=FROZEN_PHASE7_PAYLOAD,
        label="Phase 7 completion payload",
    )
    if (
        input_path != control / "phase7-inputs.json"
        or completion_payload != control / "payload.py"
        or completion_payload_bytes != input_payload_bytes
    ):
        raise Phase8Error("Phase 7 completion payload differs from authorized input")
    analysis_root = checked_dir(
        str(value.get("analysis_root", "")), label="Phase 7 analysis root"
    )
    if (
        analysis_root.parent != work_root / "runs" / "thesis" / "analysis"
        or not analysis_root.name.startswith("phase7-")
    ):
        raise Phase8Error("Phase 7 analysis root is not canonical")
    inventory_path, inventory = descriptor_object(
        value.get("artifact_inventory"), label="Phase 7 artifact inventory"
    )
    runner_view_path, runner_view = descriptor_object(
        value.get("runner_input_view"), label="Phase 7 runner input view receipt"
    )
    if inventory_path != analysis_root / "artifact-inventory.json":
        raise Phase8Error("Phase 7 artifact inventory moved outside its analysis root")
    inventory_fields = {
        "schema",
        "status",
        "analysis_root",
        "artifacts",
        "artifact_count",
        "status_inventory",
        "input_manifest_sha256",
        "payload_sha256",
        "runner_input_view",
        "campaign_terminal_inventory",
        "human_audit_runner_input_view",
        "human_audit_sampling_index",
        "target_calls",
        "judge_calls",
        "provider_http_attempts",
        "human_labels_consumed",
    }
    followon_status_names: set[str] = set()
    followon_metric_lanes: list[str] = []
    followon_states = followon.get("terminal_states")
    followon_strata = followon.get("revision_strata")
    followon_metric_lanes = followon.get("metric_lane_order")
    if (
        not isinstance(followon_states, dict)
        or set(followon_states) != set(FOLLOWON_LANES)
        or set(followon_states.values()) - FOLLOWON_STATES
        or not isinstance(followon_strata, dict)
        or not isinstance(followon_metric_lanes, list)
        or followon_metric_lanes
        != [
            lane
            for lane in FOLLOWON_LANES
            if followon_states[lane] == "measured_complete"
        ]
        or value.get("followon_terminal_states") != followon_states
        or value.get("followon_metric_revision_strata") != followon_strata
    ):
        raise Phase8Error("Phase 7 follow-on lifecycle partition differs")
    flattened = [lane for lanes in followon_strata.values() for lane in lanes]
    if (
        sorted(flattened) != sorted(followon_metric_lanes)
        or len(flattened) != len(set(flattened))
        or any(HEX64.fullmatch(str(revision)) is None for revision in followon_strata)
    ):
        raise Phase8Error("Phase 7 follow-on revision strata differ")
    followon_status_names = {
        "followon-lifecycle",
        *{
            f"followon-metric-inputs-{revision[:12]}"
            for revision in followon_strata
        },
    }
    seven_states = seven.get("terminal_states")
    seven_strata = seven.get("revision_strata")
    seven_metric_lanes = seven.get("metric_lane_order")
    if (
        not isinstance(seven_states, dict)
        or set(seven_states) != set(SEVEN_AMENDMENT_LANES)
        or set(seven_states.values()) - SEVEN_TERMINAL_STATES
        or not isinstance(seven_strata, dict)
        or not isinstance(seven_metric_lanes, list)
        or seven_metric_lanes
        != [
            lane
            for lane in SEVEN_AMENDMENT_LANES
            if seven_states[lane] == "measured_complete"
        ]
        or value.get("seven_output_policy_terminal_states") != seven_states
        or value.get("seven_output_policy_metric_revision_strata") != seven_strata
    ):
        raise Phase8Error("Phase 7 seven-row lifecycle partition differs")
    llava_pair_states = {
        "local-llava-base-image-primary-100": recoveries["latest"].get(
