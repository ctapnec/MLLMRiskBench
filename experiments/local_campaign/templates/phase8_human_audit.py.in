        globals()["EXPECTED_PROJECT_REVISION_SHA256"] = original_project_sha
        globals()["EXPECTED_SOURCE_CONFORMANCE_SHA256"] = original_source_sha

        gate_manifest = root / "covered-manifest.json"
        gate_runnote = root / "RUNNOTE.md"
