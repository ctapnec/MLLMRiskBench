    rejected(
        lambda: (
            UTC_RE.fullmatch("2026-02-30T00:00:00Z")
            or (_ for _ in ()).throw(Phase8Error("impossible UTC timestamp"))
        ),
        "impossible UTC timestamp",
    )

    def self_test_lifecycle_kinds(
        *, grids: Sequence[str], envelopes: int, eligibility: int, errors: int
    ) -> dict[str, int]:
        counts = {
            "runner_grid_artifacts": len(grids),
            "runner_request_envelopes": envelopes,
            "runner_eligibility_artifacts": eligibility,
            "runner_error_artifacts": errors,
        }
        groups = {
            field: [
                {
                    "path": f"/self-test/{field}-{index}.json",
                    "sha256": f"{index + 1:064x}",
                    "bytes": index + 1,
                }
                for index in range(count)
            ]
            for field, count in counts.items()
        }
        return lifecycle_artifact_kinds(
            grid_statuses=grids, artifact_groups=groups
        )

    lifecycle_cases = {
        "complete": lifecycle_authorization_status(
            terminal_state="measured_complete",
            lifecycle_state="complete",
            artifact_kinds=self_test_lifecycle_kinds(
                grids=["complete"], envelopes=1, eligibility=1, errors=0
            ),
        ),
        "partial": lifecycle_authorization_status(
            terminal_state="failed",
            lifecycle_state="partial",
            artifact_kinds=self_test_lifecycle_kinds(
                grids=["partial"], envelopes=1, eligibility=1, errors=1
            ),
        ),
        "failed-after-request": lifecycle_authorization_status(
            terminal_state="failed",
            lifecycle_state="failed",
            artifact_kinds=self_test_lifecycle_kinds(
                grids=[], envelopes=1, eligibility=0, errors=1
            ),
        ),
        "pre-runner-no-request": lifecycle_authorization_status(
            terminal_state="failed",
            lifecycle_state="failed",
            artifact_kinds=self_test_lifecycle_kinds(
                grids=[], envelopes=0, eligibility=1, errors=1
            ),
        ),
    }
    if lifecycle_cases != {
        "complete": "complete_runner_grid",
        "partial": "partial_runner_grid",
        "failed-after-request": "failed_after_runner_request",
        "pre-runner-no-request": "pre_runner_failure_no_request_artifact",
    }:
        raise AssertionError("lifecycle authorization cases changed")
    passed()
    empty_kinds = self_test_lifecycle_kinds(
        grids=[], envelopes=0, eligibility=0, errors=0
    )
    envelope_only_kinds = self_test_lifecycle_kinds(
        grids=[], envelopes=1, eligibility=0, errors=0
