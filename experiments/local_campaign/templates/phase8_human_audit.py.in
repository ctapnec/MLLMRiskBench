    )
    audit_runner_view_root = runner_view_root
    audit_runner_view_receipt = value["runner_input_view"]
    audit_runner_view_value = runner_view
    audit_runner_view_lanes = list(measured_lanes)
    audit_view_path, audit_view = descriptor_object(
        value.get("human_audit_runner_input_view"),
        label="Phase 7 human-audit Runner input view receipt",
    )
    if audit_view_path != control / "read-only-human-audit-runner-view.json":
