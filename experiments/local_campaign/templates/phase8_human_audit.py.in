def _terminal_contract(
    lane_id: str,
    family: str,
    disposition: str,
    reason_code: str,
    reason: str,
) -> dict[str, Any]:
    typed = {
        "status": "N/A" if disposition == "structural_na" else disposition.upper(),
        "value": None,
    }
    return {
        "lane_id": lane_id,
        "family": family,
        "disposition": disposition,
        "reason_code": reason_code,
        "reason": reason,
        "projection": typed,
        "canary": dict(typed),
        "final_preflight": dict(typed),
        "approved_caps": dict(typed),
    }


