            {"state": runner_states["local-llava-base-image-primary-100"]},
        )["state"],
        "local-llava-rr-image-primary-100": seven_states[
            "local-llava-rr-image-primary-100"
        ],
    }
    seven_flattened = [lane for lanes in seven_strata.values() for lane in lanes]
    if (
        set(seven_flattened) != set(seven_metric_lanes)
        or len(seven_flattened) != len(set(seven_flattened))
        or any(HEX64.fullmatch(str(revision)) is None for revision in seven_strata)
        or any(
            lanes != [lane for lane in seven_metric_lanes if lane in lanes]
            for lanes in seven_strata.values()
        )
    ):
        raise Phase8Error("Phase 7 seven-row revision strata differ")
    seven_status_names = {
        "seven-output-policy-lifecycle",
        "seven-output-policy-rr-comparison-inputs",
        *{
            f"seven-output-policy-metric-inputs-{revision[:12]}"
            for revision in seven_strata
        },
    }
    current_ollama_states = current_ollama.get("terminal_states")
    current_ollama_strata = current_ollama.get("revision_strata")
    current_ollama_metric_lanes = current_ollama.get("metric_lane_order")
    current_ollama_lane_order = [
        *CURRENT_OLLAMA_RUNNABLE_LANES,
        *CURRENT_OLLAMA_TYPED_TERMINAL_LANES,
    ]
    if (
        not isinstance(current_ollama_states, dict)
        or set(current_ollama_states) != set(current_ollama_lane_order)
        or set(current_ollama_states.values())
        - {"measured_complete", "failed", "unavailable"}
        or not isinstance(current_ollama_strata, dict)
        or any(not isinstance(lanes, list) for lanes in current_ollama_strata.values())
        or not isinstance(current_ollama_metric_lanes, list)
        or current_ollama_metric_lanes
        != [
            lane
            for lane in current_ollama_lane_order
            if current_ollama_states[lane] == "measured_complete"
        ]
        or value.get("current_ollama_terminal_states") != current_ollama_states
        or value.get("current_ollama_metric_revision_strata")
        != current_ollama_strata
        or value.get("current_ollama_target_execution")
        != current_ollama.get("target_execution")
    ):
        raise Phase8Error("Phase 7 current Ollama lifecycle partition differs")
    current_ollama_flattened = [
        lane for lanes in current_ollama_strata.values() for lane in lanes
    ]
    if (
        current_ollama_flattened != current_ollama_metric_lanes
        or len(current_ollama_flattened) != len(set(current_ollama_flattened))
        or any(
            HEX64.fullmatch(str(revision)) is None
            for revision in current_ollama_strata
        )
    ):
        raise Phase8Error("Phase 7 current Ollama revision strata differ")
    current_ollama_status_names = {
        "current-ollama-lifecycle",
        *{
            f"current-ollama-metric-inputs-{revision[:12]}"
            for revision in current_ollama_strata
        },
    }
    vllm_stability_states = vllm_stability.get("terminal_states")
    vllm_stability_strata = vllm_stability.get("revision_strata")
    vllm_stability_metric_lanes = vllm_stability.get("metric_lane_order")
    vllm_stability_lane_order = [row[0] for row in VLLM_STABILITY_UNIT_LAYOUT]
    if (
        vllm_stability_states
        != {lane: "measured_complete" for lane in vllm_stability_lane_order}
        or vllm_stability_metric_lanes != vllm_stability_lane_order
        or not isinstance(vllm_stability_strata, dict)
        or list(vllm_stability_strata.values()) != [vllm_stability_lane_order]
        or value.get("vllm_stability_terminal_states") != vllm_stability_states
        or value.get("vllm_stability_metric_revision_strata")
        != vllm_stability_strata
        or value.get("vllm_stability_target_execution")
        != vllm_stability.get("target_execution")
    ):
        raise Phase8Error("Phase 7 vLLM stability lifecycle partition differs")
    vllm_stability_status_names = {
        "vllm-stability-lifecycle",
        *{
            f"vllm-stability-metric-inputs-{revision[:12]}"
            for revision in vllm_stability_strata
        },
    }
    phase7_metric_lanes = [
        *measured_lanes,
        *current_ollama_metric_lanes,
        *vllm_stability_metric_lanes,
    ]
    if len(set(phase7_metric_lanes)) != len(phase7_metric_lanes):
        raise Phase8Error("Phase 7 metric lane union contains a duplicate")
    sampling_contract = phase7_sampling_lane_contract(
        runner_root=runner_root,
        runner=runner,
        recoveries=recoveries,
        seven=seven,
        followon=followon,
        current_ollama=current_ollama,
        vllm_stability=vllm_stability,
    )
    stratum_status_names = {
        "metric-stratum-"
        f"{row['project_revision_receipt_sha256'][:12]}-"
        f"{row['source_conformance_sha256'][:12]}"
        for row in sampling_contract["lane_strata"].values()
    }
    statuses = value.get("analysis_statuses")
    limitations = value.get("explicit_limitations")
    failed_runner_lanes = {
        lane
        for lane in scheduled_runner_lanes
        if recoveries["latest"].get(lane, {"state": runner_states[lane]})["state"]
        == "failed"
    }
    expected_status_names = {
        "campaign-terminal-inventory",
        "level1-evidence",
        "suite-summary",
        "level2-report",
        "judge-sensitivity",
        "kappa",
        "transfer-matrix",
        "analysis-boundaries",
        *{f"llava-base-vs-rr-{arm}" for arm in IMAGE_ARMS},
        *{f"qwen-replay-vs-crescendo-{arm}" for arm in ADAPTIVE_ARMS},
        *{f"native-{engine}" for engine in NATIVE_ENGINES},
        *{
            f"gate5-{lane}"
            for lane in gate5_terminals
        },
        *{f"runner-{lane}" for lane in failed_runner_lanes},
        *followon_status_names,
        *seven_status_names,
        *current_ollama_status_names,
        *vllm_stability_status_names,
        *stratum_status_names,
    }
    if (
        not isinstance(statuses, dict)
        or set(statuses) != expected_status_names
        or len(statuses)
        != (
            36
            + len(gate5_terminals)
            + len(failed_runner_lanes)
            + len(followon_status_names)
            + len(seven_status_names)
            + len(current_ollama_status_names)
            + len(vllm_stability_status_names)
            + len(stratum_status_names)
        )
        or any(
            not isinstance(name, str)
            or not isinstance(status, str)
            or not status.strip()
            for name, status in statuses.items()
        )
        or not isinstance(limitations, dict)
    ):
        raise Phase8Error("Phase 7 status or limitation inventory differs")
    expected_limitations = {
        name: status for name, status in statuses.items() if status != "complete"
    }
    expected_status = (
        "complete" if not expected_limitations else "complete_with_explicit_limitations"
    )
    if value.get("status") != expected_status or limitations != expected_limitations:
        raise Phase8Error("Phase 7 completion status does not match limitations")
    artifacts = inventory.get("artifacts")
    if (
        set(inventory) != inventory_fields
        or inventory.get("schema") != "ura-phase7-analysis-artifact-inventory/1"
        or inventory.get("status") != "complete"
        or inventory.get("analysis_root") != str(analysis_root)
        or not isinstance(artifacts, list)
        or type(inventory.get("artifact_count")) is not int
        or inventory.get("artifact_count") != len(artifacts)
        or artifacts
        != sorted(
            artifacts,
            key=lambda row: str(row.get("path", "")) if isinstance(row, dict) else "",
        )
        or inventory.get("status_inventory") != statuses
        or inventory.get("input_manifest_sha256")
        != sha256_bytes(input_manifest_payload)
        or inventory.get("payload_sha256") != sha256_bytes(completion_payload_bytes)
        or inventory.get("runner_input_view") != value.get("runner_input_view")
        or inventory.get("human_audit_runner_input_view")
        != value.get("human_audit_runner_input_view")
        or inventory.get("human_audit_sampling_index")
        != value.get("human_audit_sampling_index")
        or inventory.get("campaign_terminal_inventory")
        != value.get("campaign_terminal_inventory")
        or inventory.get("human_labels_consumed") is not False
    ):
