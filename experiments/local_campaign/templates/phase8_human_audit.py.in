        traditional_cache.mkdir()
        cache_tag = sys.implementation.cache_tag
        if not isinstance(cache_tag, str) or not cache_tag:
            raise AssertionError("self-test interpreter has no bytecode cache tag")
        bootstrap = __import__("importlib._bootstrap_external", fromlist=["*"])
        forged_code = compile(
            "VALUE = 'forged'\n", str(cache_probe_source), "exec", dont_inherit=True
        )
        forged_pyc = bootstrap._code_to_timestamp_pyc(  # noqa: SLF001
            forged_code,
            int(cache_probe_source.stat().st_mtime),
            cache_probe_source.stat().st_size,
        )
        write_new(
            traditional_cache / f"phase8_cache_probe.{cache_tag}.pyc",
            bytes(forged_pyc),
