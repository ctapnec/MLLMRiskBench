        def embedded_payload(wrapper_name: str, marker: str) -> bytes:
            wrapper = (Path(__file__).resolve().parent / wrapper_name).read_bytes()
            opening = f"<<'{marker}'\n".encode("ascii")
            closing = f"\n{marker}\n".encode("ascii")
            if wrapper.count(opening) != 1:
                raise AssertionError(f"cannot locate {marker} in {wrapper_name}")
            body_and_tail = wrapper.split(opening, 1)[1]
            if body_and_tail.count(closing) != 1:
                raise AssertionError(f"cannot close {marker} in {wrapper_name}")
            return body_and_tail.split(closing, 1)[0] + b"\n"

        core_payload_bytes = embedded_payload(
            "phase6_core_measured.sh", "PHASE6_PAYLOAD"
        )
        extended_payload_bytes = embedded_payload(
            "phase6_extended_measured.sh", "PHASE6_PAYLOAD"
        )
        if {
            "sha256": sha256_bytes(core_payload_bytes),
            "bytes": len(core_payload_bytes),
        } != FROZEN_PHASE6_PAYLOADS["core"] or {
            "sha256": sha256_bytes(extended_payload_bytes),
            "bytes": len(extended_payload_bytes),
        } != FROZEN_PHASE6_PAYLOADS["extended"]:
            raise AssertionError("frozen Phase 6 embedded payload identities differ")
        retained_commit = "c62e027b0143d1db29c57f66605ac3d8dc23f11a"
        if phase6_payload_identity(
            "core",
            expected_commit=retained_commit,
            label="retained Phase 6 core payload",
        ) != RETAINED_PHASE6_PAYLOADS_BY_COMMIT[retained_commit]["core"]:
            raise AssertionError("retained Phase 6 core payload identity differs")
        if phase6_payload_identity(
            "extended",
            expected_commit=retained_commit,
            label="retained Phase 6 extended payload",
        ) != RETAINED_PHASE6_PAYLOADS_BY_COMMIT[retained_commit]["extended"]:
            raise AssertionError("retained Phase 6 extended payload identity differs")
        rejected(
            lambda: phase6_payload_identity(
                "native",
                expected_commit=retained_commit,
                label="retained Phase 6 native payload",
            ),
            "retained Phase 6 native payload mutation",
        )
        rejected(
            lambda: phase6_payload_identity(
                "core",
                expected_commit="0" * 40,
                label="unknown-revision Phase 6 core payload",
            ),
            "unknown-revision Phase 6 payload mutation",
        )
        passed()

        def self_test_lane_spec(lane: str, *, schema: str) -> dict[str, Any]:
            if "llava-base" in lane:
                selector = "self-test-llava-base"
            elif "llava-rr" in lane:
                selector = "self-test-llava-rr"
            else:
                selector = "self-test-qwen3-vl"
            classification = lane.startswith("rjudge-") or lane.startswith(
                "gptgeochat-"
            )
            defense = lane == "defense-local"
            return {
                "schema": schema,
                "lane_id": lane,
                "target": {"spec": selector},
                "expected_corpora": [f"self-test-corpus-{lane}"],
                "expected_attacker": (
                    "crescendo" if lane == "crescendo-qwen3-vl" else "replay"
                ),
                "expected_judges": (
                    ["rules"] if classification else ["rules", "guardrail"]
                ),
                "approximate_common_metrics": not classification,
                "defense": "both" if defense else "none",
                "defense_guard": "guardrail" if defense else "rules",
            }

        def self_test_retained(path: Path) -> dict[str, Any]:
            return {
                "file": path.name,
                "sha256": sha256_file(path),
                "bytes": path.stat().st_size,
            }

        def self_test_grid_request(
            lane: str, *, eligibility: Path, attestation: Path
        ) -> dict[str, Any]:
            schema = (
                "ura-phase6-core-lane-spec/1"
                if lane in CORE_LANES
                else "ura-phase6-extended-lane-spec/1"
            )
            spec = self_test_lane_spec(lane, schema=schema)
            classification = lane.startswith("rjudge-") or lane.startswith(
                "gptgeochat-"
            )
            defense = lane == "defense-local"
            return {
                "execution_purpose": "measured_run",
                "dry_run": False,
                "attestation_probe": False,
                "corpora": spec["expected_corpora"],
                "attackers": [spec["expected_attacker"]],
                "judges": spec["expected_judges"],
                "approximate_common_metrics": spec["approximate_common_metrics"],
                "defense": spec["defense"],
                "defense_guard": spec["defense_guard"],
                "group_keys": list(GROUP_KEYS),
                "models": [spec["target"]["spec"]],
                "project_revision": {"experiment": "self-test"},
                "source_conformance_artifact": {
                    "sha256": sha256_file(source_receipt_path)
                },
                "source_config_artifact": {"sha256": sha256_file(source_config_path)},
                "eligibility_plan": self_test_retained(eligibility),
                "live_attestation": {
                    "mode": "measured",
                    "artifacts": [self_test_retained(attestation)],
                },
                "guardrail_model": (
                    None if classification else EXPECTED_GUARDRAIL["model"]
                ),
                "guardrail_revision": (
                    None if classification else EXPECTED_GUARDRAIL["revision"]
                ),
                "guardrail_device": (
                    None if classification else EXPECTED_GUARDRAIL["device"]
                ),
                "defense_guardrail_model": (
                    EXPECTED_DEFENSE_GUARDRAIL["model"] if defense else None
                ),
                "defense_guardrail_revision": (
                    EXPECTED_DEFENSE_GUARDRAIL["revision"] if defense else None
                ),
                "defense_guardrail_device": (
                    EXPECTED_DEFENSE_GUARDRAIL["device"] if defense else None
                ),
            }

        def build_core(
            tag: str,
            mutate: Any | None = None,
            *,
            gate5_profile: Mapping[str, Any] = success_gate5_profile,
            manifest_source: Path = gate_manifest,
            measured_runner_root: Path = runner_root,
        ) -> tuple[Path, dict[str, Any]]:
            scheduled_lanes = list(gate5_profile["scheduled_core_lanes"])
            conditional_na_lanes = list(gate5_profile["conditional_na_lanes"])
            control = engineering_root / f"phase6-core-measured-{tag}"
            attempt = control / "attempts" / "attempt-1"
            attempt.mkdir(parents=True)
            (control / "lane-specs").mkdir()
            (control / "lanes").mkdir()
            sealed_inputs = control / "inputs"
            sealed_inputs.mkdir()
            sealed_manifest = sealed_inputs / "covered-manifest.json"
            sealed_runnote = sealed_inputs / "RUNNOTE.md"
            sealed_promotion = sealed_inputs / "RUNNOTE.gate5-promotion.receipt.json"
            write_new(sealed_manifest, manifest_source.read_bytes())
            write_new(sealed_runnote, gate_runnote.read_bytes())
            write_new(sealed_promotion, gate_promotion.read_bytes())
            payload = control / "payload.sh"
            write_new(payload, core_payload_bytes)
            launch_path = control / "launch.json"
            launch = {
                "schema": "ura-phase6-core-controller-launch/1",
                "expected_commit": EXPECTED_COMMIT,
                "framework_lock_id": EXPECTED_FRAMEWORK_LOCK,
                "manifest_sha256": sha256_file(manifest_source),
                "authorized_manifest_sha256": sha256_file(manifest_source),
                "manifest": descriptor(sealed_manifest),
                "runnote": descriptor(sealed_runnote),
                "promotion_receipt": descriptor(sealed_promotion),
                "payload": descriptor(payload),
                "control_root": str(control),
            }
            write_new(launch_path, canonical(launch))
            generic = control / "generic.json"
            write_new(generic, canonical({"status": "sealed"}))
            states = {lane: "failed" for lane in scheduled_lanes}
            success_lane = CORE_LANES[1]
            success_lanes = {success_lane}
            if not conditional_na_lanes:
                success_lanes.add(DEFENSE_LOCAL_LANE)
            for lane in success_lanes:
                states[lane] = "measured_complete"
            results: dict[str, dict[str, Any]] = {}
            failures: dict[str, dict[str, Any]] = {}
            event_lines = ["attempt\ttime_utc\tlane\tstage\tstatus\tdetail\n"]
            for index, lane in enumerate(scheduled_lanes, start=1):
                spec = control / "lane-specs" / f"{index:02d}-{lane}.json"
                write_new(
                    spec,
                    canonical(
                        self_test_lane_spec(lane, schema="ura-phase6-core-lane-spec/1")
                    ),
                )
                event_lines.append(
                    f"attempt-1\t2026-08-22T00:00:00Z\t{lane}\tlane-attempt\tstart\tsealed\n"
                )
                if lane in success_lanes:
                    lane_control = control / "lanes" / lane
                    lane_control.mkdir()
                    exact_argv = lane_control / "exact-measured-argv.json"
                    result_root = measured_runner_root / lane
                    result_root.mkdir(exist_ok=True)
                    artifacts = {
                        "projection": result_root
                        / "lane-projection-self.lane-projection.json",
                        "eligibility": result_root
                        / "eligibility-self.eligibility.json",
                        "request-envelope": result_root
                        / "request-envelope-self.request-envelope.json",
                        "budget": result_root / "self.budget.json",
                    }
                    for artifact_name, artifact in artifacts.items():
                        value = {"status": "complete"}
                        if artifact_name == "eligibility":
                            value["plan_id"] = f"self-plan-{lane}"
                        write_or_match(artifact, canonical(value))
                    grid = result_root / "self.grid.json"
                    marker = result_root / "cell.complete.json"
                    attestation = result_root / "live-attestation.json"
                    write_or_match(
                        marker,
                        canonical({"status": "complete", "format_version": 2}),
                    )
                    write_or_match(attestation, canonical({"status": "complete"}))
                    write_or_match(
                        grid,
                        canonical(
                            {
                                "status": "complete",
                                "n_errors": 0,
                                "requested_cells": 1,
                                "accounted_cells": 1,
                                "request": self_test_grid_request(
                                    lane,
                                    eligibility=artifacts["eligibility"],
                                    attestation=attestation,
                                ),
                                "cells": [
                                    {
                                        "status": "complete",
                                        "completion_marker": marker.name,
                                        "run_id": f"self-test-{lane}",
                                    }
                                ],
                            }
                        ),
                    )
                    level1 = attempt / f"{lane}.level1.json"
                    write_new(
                        level1,
                        canonical(
                            {
                                "schema_version": "ura-level1-evidence/3",
                                "status": "validated_unit_qualified_lifecycle_inventory",
                                "scope": {"evidence_kind": "measured_run"},
                            }
                        ),
                    )
                    probe_root = control / "probes" / lane
                    probe_root.mkdir(parents=True)
                    short_generic = {
                        "path": str(generic),
                        "sha256": sha256_file(generic),
                    }
                    acquisition = {
                        "plan": short_generic,
                        "receipt": short_generic,
                        "controller_log": descriptor(generic),
                        "store": str(model_store),
                        "downloaded_bytes": 0,
                    }
                    measured_state = {
                        "schema": "ura-phase6-core-measured-argv/1",
                        "lane_spec": descriptor(spec),
                        "result_root": str(result_root),
                        "probe_root": str(probe_root),
                        "live_attestation": short_generic,
                        "attestation_acquisition": acquisition,
                        "model_acquisition": acquisition,
                        "runner_argv": [
                            "python",
                            "-m",
                            "experiments.run_matrix",
                            "--out",
                            str(result_root),
                        ],
                        "resume_semantics": "invoke_exact_runner_argv_or_accept_strictly_revalidated_complete_runner_grid",
                    }
                    write_new(exact_argv, canonical(measured_state))
                    detail = "strict measured completion"
                    event_lines.append(
                        f"attempt-1\t2026-08-22T00:00:01Z\t{lane}\tmeasured\tcomplete\t{detail}\n"
                    )
                    result = {
                        "schema": "ura-phase6-core-lane-result/1",
                        "status": "complete",
                        "lane_id": lane,
                        "attempt": "attempt-1",
                        "terminal_event": {"status": "complete", "detail": detail},
                        "lane_spec": descriptor(spec),
                        "exact_measured_argv": descriptor(exact_argv),
                        "live_attestation": descriptor(generic),
                        "attestation_acquisition_plan": descriptor(generic),
                        "attestation_acquisition_receipt": descriptor(generic),
                        "attestation_acquisition_log": descriptor(generic),
                        "model_acquisition_plan": descriptor(generic),
                        "model_acquisition_receipt": descriptor(generic),
                        "model_acquisition_log": descriptor(generic),
                        "level1_evidence": descriptor(level1),
                        "result_root": str(result_root),
                        "grid": descriptor(grid),
                        "projection": descriptor(artifacts["projection"]),
                        "eligibility": descriptor(artifacts["eligibility"]),
                        "request_envelope": descriptor(artifacts["request-envelope"]),
                        "call_budget": descriptor(artifacts["budget"]),
                    }
                    result_path = attempt / f"{lane}.result.json"
                    write_new(result_path, canonical(result))
                    results[lane] = descriptor(result_path)
                else:
                    returncode = 7
                    detail = (
                        f"lane controller exited {returncode}; "
                        "no measured evidence admitted"
                    )
                    event_lines.append(
                        f"attempt-1\t2026-08-22T00:00:01Z\t{lane}\tmeasured\tfailed\t{detail}\n"
                    )
                    failure = {
                        "schema": "ura-phase6-core-lane-failure/1",
                        "status": "failed",
                        "lane_id": lane,
                        "attempt": "attempt-1",
                        "failed_at_utc": "2026-08-22T00:00:01Z",
                        "returncode": returncode,
                        "stage": "lane",
                        "error_type": "lane_controller_nonzero_exit",
                        "error": detail,
                        "terminal_event": {"status": "failed", "detail": detail},
                        "lane_spec": descriptor(spec),
                        "exact_measured_argv": None,
                        "result_root": str(measured_runner_root / lane),
                        "evidence_eligible": False,
                        "retry_semantics": "next controller attempt revalidates complete Runner state or retries the exact sealed argv",
                        "hosted_target_calls": 0,
                        "hosted_judge_calls": 0,
                        "provider_http_attempts": 0,
                        "downloads_observed_bytes": 0,
                    }
                    failure_path = attempt / f"{lane}.failure.json"
                    write_new(failure_path, canonical(failure))
                    failures[lane] = descriptor(failure_path)
            events = attempt / "events.snapshot.tsv"
            write_new(events, "".join(event_lines).encode("ascii"))
            contract_path = attempt / "contract-self-test.json"
            write_new(
                contract_path,
                canonical(
                    {
                        "schema": "ura-phase6-core-attempt-contract-self-test/1",
                        "status": "passed",
                        "mutations_rejected": [
                            "missing-terminal",
                            "duplicate-terminal",
                            "mis-typed-state",
                            "missing-attempt",
                            "terminal-before-attempt",
                            "status-mismatch",
                        ],
                        "early_failure_followed_by_later_attempt": True,
                        "actual_lane_terminal_states": states,
                    }
                ),
            )
            summary_path = attempt / "summary.json"
            summary = {
                "schema": "ura-phase6-core-controller-summary/1",
                "status": "complete_with_failures",
                "completed_at_utc": "2026-08-22T00:00:02Z",
                "attempt": "attempt-1",
                "expected_commit": EXPECTED_COMMIT,
                "framework_lock_id": EXPECTED_FRAMEWORK_LOCK,
                "lane_order": scheduled_lanes,
                "lane_terminal_states": states,
                "completed_lanes": [
                    lane for lane in scheduled_lanes if lane in success_lanes
                ],
                "failed_lanes": [
                    lane for lane in scheduled_lanes if lane not in success_lanes
                ],
                "lane_results": results,
                "lane_failures": failures,
                "conditional_na_lanes": conditional_na_lanes,
                "contract_self_test": descriptor(contract_path),
                "inventory_complete": True,
                "all_independent_lanes_attempted": True,
                "controller_exit_code": 1,
                "hosted_target_calls": 0,
                "hosted_judge_calls": 0,
                "provider_http_attempts": 0,
                "downloads_observed_bytes": 0,
            }
            write_new(summary_path, canonical(summary))
            completion = {
                "schema": "ura-phase6-core-controller-completion/1",
                "status": "complete_with_failures",
                "completed_at_utc": "2026-08-22T00:00:02Z",
                "expected_commit": EXPECTED_COMMIT,
                "framework_lock_id": EXPECTED_FRAMEWORK_LOCK,
                "control_root": str(control),
                "attempt_root": str(attempt),
                "gate5_manifest": descriptor(sealed_manifest),
                "gate5_runnote": descriptor(sealed_runnote),
                "gate5_promotion_receipt": descriptor(sealed_promotion),
                "payload": descriptor(payload),
                "launch": descriptor(launch_path),
                "events": descriptor(events),
                "summary": descriptor(summary_path),
                "contract_self_test": descriptor(contract_path),
                "inventory_complete": True,
                "all_independent_lanes_attempted": True,
                "lane_order": scheduled_lanes,
                "lane_terminal_states": states,
                "lane_results": results,
                "lane_failures": failures,
                "conditional_na_lanes": conditional_na_lanes,
                "controller_exit_code": 1,
                "hosted_target_calls": 0,
                "hosted_judge_calls": 0,
                "provider_http_attempts": 0,
                "downloads_observed_bytes": 0,
            }
            if mutate is not None:
                mutate(completion)
            completion_path = attempt / "completion.json"
            write_new(completion_path, canonical(completion))
            write_new(attempt / ".exit", b"1\n")
            return completion_path, completion

        core_path, core = build_core("valid")
        validate_core_completion(
            core_path,
            code_identity=self_test_gate5_identity,
            manifest_sha=sha256_file(gate_manifest),
            runnote_sha=sha256_file(gate_runnote),
            promotion_sha=sha256_file(gate_promotion),
            runner_root=runner_root,
            work_root=work_root,
            model_store=model_store,
            gate5_profile=success_gate5_profile,
        )
        passed()

        def reject_core(tag: str, mutate: Any, label: str) -> None:
            candidate, _value = build_core(tag, mutate)
            rejected(
                lambda: validate_core_completion(
                    candidate,
                    code_identity=self_test_gate5_identity,
                    manifest_sha=sha256_file(gate_manifest),
                    runnote_sha=sha256_file(gate_runnote),
                    promotion_sha=sha256_file(gate_promotion),
                    runner_root=runner_root,
                    work_root=work_root,
                    model_store=model_store,
                    gate5_profile=success_gate5_profile,
                ),
                label,
            )

        reject_core(
            "missing-state",
            lambda value: value["lane_terminal_states"].pop(
                success_gate5_profile["scheduled_core_lanes"][-1]
            ),
            "missing core terminal state",
        )
        reject_core(
            "mistyped-state",
            lambda value: value["lane_terminal_states"].__setitem__(
                CORE_LANES[0], "partial"
            ),
            "mis-typed core terminal state",
        )
        reject_core(
            "status-mismatch",
            lambda value: value.__setitem__("status", "complete"),
            "core status mismatch",
        )
        reject_core(
            "boolean-zero",
            lambda value: value.__setitem__("hosted_target_calls", False),
            "boolean core zero",
        )

        conditional_runner_root = thesis_root / "runner-conditional"
        conditional_runner_root.mkdir()
        conditional_core_path, conditional_core = build_core(
            "conditional-valid",
            gate5_profile=conditional_gate5_profile,
            manifest_source=conditional_gate_manifest,
            measured_runner_root=conditional_runner_root,
        )
        validate_core_completion(
            conditional_core_path,
            code_identity=self_test_gate5_identity,
            manifest_sha=sha256_file(conditional_gate_manifest),
            runnote_sha=sha256_file(gate_runnote),
            promotion_sha=sha256_file(gate_promotion),
            runner_root=conditional_runner_root,
            work_root=work_root,
            model_store=model_store,
            gate5_profile=conditional_gate5_profile,
        )
        passed()
        conditional_control = Path(conditional_core["control_root"])
        write_new(
            conditional_control / "lane-specs" / "10-defense-local.json",
            canonical(
                self_test_lane_spec(
                    DEFENSE_LOCAL_LANE, schema="ura-phase6-core-lane-spec/1"
                )
            ),
        )
        rejected(
            lambda: validate_core_completion(
                conditional_core_path,
                code_identity=self_test_gate5_identity,
                manifest_sha=sha256_file(conditional_gate_manifest),
                runnote_sha=sha256_file(gate_runnote),
                promotion_sha=sha256_file(gate_promotion),
                runner_root=conditional_runner_root,
                work_root=work_root,
                model_store=model_store,
                gate5_profile=conditional_gate5_profile,
            ),
            "conditional core retained a defense lane spec",
        )

        def ext_desc(path: Path) -> dict[str, Any]:
            row = descriptor(path)
            return {**row, "file": path.name}

        def build_extended(
            tag: str,
            mutate: Any | None = None,
            *,
            conditional: bool = False,
        ) -> tuple[Path, dict[str, Any]]:
            scheduled_extended_lanes = list(
                conditional_gate5_profile["scheduled_extended_lanes"]
            )
            control = engineering_root / f"phase6-extended-measured-{tag}"
            attempt = control / "attempts" / "attempt-1"
            attempt.mkdir(parents=True)
            lane_spec_root = control / "lane-specs"
            lane_spec_root.mkdir()
            for index, lane in enumerate(scheduled_extended_lanes, start=1):
                write_new(
                    lane_spec_root / f"{index:02d}-{lane}.json",
                    canonical(
                        self_test_lane_spec(
                            lane, schema="ura-phase6-extended-lane-spec/1"
                        )
                    ),
                )
            sealed_inputs = control / "inputs"
            sealed_inputs.mkdir()
            sealed_manifest = sealed_inputs / "covered-manifest.json"
            sealed_runnote = sealed_inputs / "RUNNOTE.md"
            sealed_promotion = sealed_inputs / "RUNNOTE.gate5-promotion.receipt.json"
            gate5_source = conditional_gate_manifest if conditional else gate_manifest
            gate5_rows = retained_conditional_rows if conditional else rows
            conditional_na_lanes = list(
                conditional_gate5_profile["conditional_na_lanes"]
            )
            write_new(sealed_manifest, gate5_source.read_bytes())
            write_new(sealed_runnote, gate_runnote.read_bytes())
            write_new(sealed_promotion, gate_promotion.read_bytes())
            payload = control / "payload.py"
            write_new(payload, extended_payload_bytes)
            launch_path = control / "launch.json"
            launch = {
                "schema": "ura-phase6-extended-controller-launch/1",
                "expected_commit": EXPECTED_COMMIT,
                "framework_lock_id": EXPECTED_FRAMEWORK_LOCK,
                "manifest_sha256": sha256_file(gate5_source),
                "authorized_manifest_sha256": sha256_file(gate5_source),
                "manifest": descriptor(sealed_manifest),
                "runnote": descriptor(sealed_runnote),
                "promotion_receipt": descriptor(sealed_promotion),
                "payload": descriptor(payload),
                "control_root": str(control),
            }
            write_new(launch_path, canonical(launch))
            typed = {
                **EXTENDED_BASE_TERMINALS,
                **{
                    lane: OLLAMA_STATIC_TERMINAL_DISPOSITION
                    for lane in OLLAMA_STATIC_TERMINAL_LANES
                },
            }
            terminal_rows = {
                row["lane_id"]: row
                for row in gate5_rows
                if row["lane_id"] in typed
            }
            dispositions = control / "typed-dispositions.json"
            write_new(
                dispositions,
                canonical(
                    {
                        "schema": "ura-phase6-extended-dispositions/1",
                        "status": "complete",
                        "rows": [terminal_rows[lane] for lane in typed],
                    }
                ),
            )
            states = {lane: "failed" for lane in scheduled_extended_lanes}
            success_lane = scheduled_extended_lanes[1]
            states[success_lane] = "measured_complete"
            results: dict[str, dict[str, Any]] = {}
            failures: dict[str, dict[str, Any]] = {}
            failure_values: dict[str, dict[str, Any]] = {}
            for lane in scheduled_extended_lanes:
                if lane == success_lane:
                    result_path = attempt / f"{lane}.complete.json"
                    write_new(
                        result_path,
                        canonical(
                            {
                                "status": "complete",
                                "lane_id": lane,
                                "grid_id": "grid",
                                "projection_id": "projection",
                                "eligibility_plan_id": "eligibility",
                                "target_calls_reserved": 1,
                                "target_call_cap": 1,
                                "retained_bytes": 1,
                                "guard_queries_observed": 1,
                            }
                        ),
                    )
                    results[lane] = ext_desc(result_path)
                else:
                    failure_path = attempt / f"{lane}.failure.json"
                    failure = {
                        "schema": "ura-phase6-extended-lane-failure/1",
                        "status": "failed",
                        "failed_at_utc": "2026-08-22T00:00:00Z",
                        "attempt": "attempt-1",
                        "lane_id": lane,
                        "stage": "lane",
                        "error_type": "RuntimeError",
                        "error": "self-test failure",
                    }
                    write_new(failure_path, canonical(failure))
                    failures[lane] = ext_desc(failure_path)
                    failure_values[lane] = failure
            terminal_results: dict[str, dict[str, Any]] = {}
            for lane in typed:
                terminal_path = attempt / f"{lane}.terminal.json"
                write_new(
                    terminal_path,
                    canonical(
                        {
                            "schema": "ura-phase6-extended-terminal-result/1",
                            "status": "typed_terminal",
                            "lane_id": lane,
                            "gate5_row": terminal_rows[lane],
                        }
                    ),
                )
                terminal_results[lane] = ext_desc(terminal_path)
            zero = {
                "hosted_target_calls": 0,
                "hosted_judge_calls": 0,
                "http_attempts": 0,
                "paid_provider_calls": 0,
                "model_downloads": 0,
                "downloads_observed_bytes": 0,
            }
            summary_path = attempt / "summary.json"
            write_new(
                summary_path,
                canonical(
                    {
                        "schema": "ura-phase6-extended-controller-summary/1",
                        "status": "complete_with_failures",
                        "controller_exit_code": 1,
                        "completed_at_utc": "2026-08-22T00:00:01Z",
                        "attempt": "attempt-1",
                        "runnable_inventory": scheduled_extended_lanes,
                        "lane_terminal_states": states,
                        "completed_lanes": [success_lane],
                        "failed_lanes": sorted(failure_values),
                        "typed_terminal_inventory": typed,
                        "conditional_na_lanes": conditional_na_lanes,
                        "failures": [
                            failure_values[lane]
                            for lane in scheduled_extended_lanes
                            if lane in failure_values
                        ],
                        "all_independent_lanes_attempted": True,
                        **zero,
                    }
                ),
            )
            completion = {
                "schema": "ura-phase6-extended-controller-completion/1",
                "status": "complete_with_failures",
                "controller_exit_code": 1,
                "completed_at_utc": "2026-08-22T00:00:01Z",
                "attempt": "attempt-1",
                "expected_commit": EXPECTED_COMMIT,
                "framework_lock_id": EXPECTED_FRAMEWORK_LOCK,
                "inventory_complete": True,
                "runnable_lanes": scheduled_extended_lanes,
                "lane_terminal_states": states,
                "typed_terminal_lanes": typed,
                "conditional_na_lanes": conditional_na_lanes,
                "gate5_inputs": {
                    "manifest": ext_desc(sealed_manifest),
                    "canonical_runnote": ext_desc(sealed_runnote),
                    "promotion_receipt": ext_desc(sealed_promotion),
                },
                "launch": ext_desc(launch_path),
                "payload": ext_desc(payload),
                "summary": ext_desc(summary_path),
                "typed_dispositions": ext_desc(dispositions),
                "lane_results": results,
                "lane_failures": failures,
                "terminal_results": terminal_results,
                "all_independent_lanes_attempted": True,
                **zero,
            }
            if mutate is not None:
                mutate(completion)
            completion_path = attempt / "completion.json"
            write_new(completion_path, canonical(completion))
            write_new(attempt / ".exit", b"1\n")
            return completion_path, completion

        extended_path, extended = build_extended("valid")
        validate_extended_completion(
            extended_path,
            code_identity=self_test_gate5_identity,
            manifest_sha=sha256_file(gate_manifest),
            runnote_sha=sha256_file(gate_runnote),
            promotion_sha=sha256_file(gate_promotion),
            work_root=work_root,
            validate_gate5_artifacts=False,
        )
        passed()
        conditional_extended_path, _conditional_extended = build_extended(
            "conditional", conditional=True
        )
        globals()["EXPECTED_PROJECT_REVISION_SHA256"] = conditional_artifacts[
            "project_revision"
        ]["sha256"]
        globals()["EXPECTED_SOURCE_CONFORMANCE_SHA256"] = conditional_artifacts[
            "source_conformance"
        ]["sha256"]
        try:
            validate_extended_completion(
                conditional_extended_path,
                code_identity=self_test_gate5_identity,
                manifest_sha=sha256_file(conditional_gate_manifest),
                runnote_sha=sha256_file(gate_runnote),
                promotion_sha=sha256_file(gate_promotion),
                work_root=work_root,
                validate_gate5_artifacts=False,
            )
        finally:
            globals()["EXPECTED_PROJECT_REVISION_SHA256"] = original_project_sha
            globals()["EXPECTED_SOURCE_CONFORMANCE_SHA256"] = original_source_sha
        passed()

        def reject_extended(tag: str, mutate: Any, label: str) -> None:
            candidate, _value = build_extended(tag, mutate)
            rejected(
                lambda: validate_extended_completion(
                    candidate,
                    code_identity=self_test_gate5_identity,
                    manifest_sha=sha256_file(gate_manifest),
                    runnote_sha=sha256_file(gate_runnote),
                    promotion_sha=sha256_file(gate_promotion),
                    work_root=work_root,
                    validate_gate5_artifacts=False,
                ),
                label,
            )

        reject_extended(
            "missing-state",
            lambda value: value["lane_terminal_states"].pop(
                success_gate5_profile["scheduled_extended_lanes"][-1]
            ),
            "missing extended terminal state",
        )
        reject_extended(
            "mistyped-state",
            lambda value: value["lane_terminal_states"].__setitem__(
                EXTENDED_LANES[0], "partial"
            ),
            "mis-typed extended terminal state",
        )
        reject_extended(
            "status-mismatch",
            lambda value: value.__setitem__("status", "complete"),
            "extended status mismatch",
        )
        reject_extended(
            "duplicate-partition",
            lambda value: value["lane_results"].__setitem__(
                EXTENDED_LANES[0], next(iter(value["lane_results"].values()))
            ),
            "extended duplicate result/failure lane",
        )
        reject_extended(
            "conditional-profile",
            lambda value: value.__setitem__("conditional_na_lanes", []),
            "extended conditional Gate 5 profile mismatch",
        )

        call_attempt = root / "native-call-attempt"
        call_attempt.mkdir()
        ledger = call_attempt / "local-call-ledger.jsonl"
        write_new(
            ledger,
            canonical(
                {
                    "event": "model_request",
                    "sequence": 1,
                    "model": NATIVE_OLLAMA_MODELS["primary"]["tag"],
                    "path": "/api/chat",
                }
            )
            + canonical({"event": "model_response"}),
        )
        call_summary = call_attempt / "local-call-summary.json"
        write_new(
            call_summary,
            canonical(
                {
                    "schema": "ura-native-local-call-gate-summary/1",
                    "status": "complete",
                    "completed_at_utc": "2026-08-22T00:00:00Z",
                    "upstream": "http://127.0.0.1:11434",
                    "allowed_models": sorted(
                        model["tag"] for model in NATIVE_OLLAMA_MODELS.values()
                    ),
                    "target_call_cap": 2,
                    "model_calls": 1,
                    "denied_requests": 0,
                    "model_counts": {NATIVE_OLLAMA_MODELS["primary"]["tag"]: 1},
                    "path_counts": {"/api/chat": 1},
                    "ledger": descriptor(ledger),
                    "hosted_calls": 0,
                    "downloads": 0,
                }
            ),
        )
        _validate_native_call_summary(
            call_summary,
            engine="fuzzyai",
            attempt=call_attempt,
            call_cap=2,
            observed_calls=1,
            require_success=True,
        )
        passed()
        bad_call_summary = call_attempt / "bad-call-summary.json"
        bad_calls = strict_object(call_summary, label="native self-test summary")
        bad_calls["hosted_calls"] = False
        write_new(bad_call_summary, canonical(bad_calls))
        rejected(
            lambda: _validate_native_call_summary(
                bad_call_summary,
                engine="fuzzyai",
                attempt=call_attempt,
                call_cap=2,
                observed_calls=1,
                require_success=True,
            ),
            "boolean native hosted-call zero",
        )

        native_payload_bytes = embedded_payload(
            "phase6_native_diagnostics.sh", "PHASE6_NATIVE_PAYLOAD"
        )
        phase7_source = Path(__file__).resolve().parent / "phase7_analysis.py"
        if {
            "sha256": sha256_bytes(native_payload_bytes),
            "bytes": len(native_payload_bytes),
        } != FROZEN_PHASE6_PAYLOADS["native"] or {
            "sha256": sha256_file(phase7_source),
            "bytes": phase7_source.stat().st_size,
        } != FROZEN_PHASE7_PAYLOAD:
            raise AssertionError("frozen native or Phase 7 payload identity differs")
        passed()

        phase7_generic = root / "phase7-generic.json"
        write_new(phase7_generic, canonical({"status": "sealed"}))
        native_control = root / "native-upstream"
        native_attempt = native_control / "attempts" / "attempt-1"
        native_attempt.mkdir(parents=True)
        native_states = {
            engine: (planned if planned != "run" else "failed")
            for engine, planned in NATIVE_PLANNED_TERMINALS.items()
        }
        native_plan_path = native_control / "native-plan.json"
        write_new(
            native_plan_path,
            canonical(
                {
                    "code_identity": {
                        "expected_commit": EXPECTED_COMMIT,
                        "framework_lock_id": EXPECTED_FRAMEWORK_LOCK,
                        "project_revision": descriptor(project_receipt_path),
                    }
                }
            ),
        )
        native_completion_path = native_attempt / "completion.json"
        write_new(
            native_completion_path,
            canonical(
                {
                    "schema": "ura-phase6-native-controller-completion/1",
                    "status": "complete_with_failures",
                    "expected_commit": EXPECTED_COMMIT,
                    "terminal_states": native_states,
                    "conditional_na_lanes": [],
                }
            ),
        )
        write_new(native_attempt / ".exit", b"1\n")

        core_control = Path(core["control_root"])
        core_attempt = Path(core["attempt_root"])
        core_states = core["lane_terminal_states"]
        core_success = [
            lane
            for lane in success_gate5_profile["scheduled_core_lanes"]
            if core_states[lane] == "measured_complete"
        ]
        core_snapshot = {
            "control_root": str(core_control),
            "attempt_root": str(core_attempt),
            "launch": core["launch"],
            "completion": descriptor(core_path),
            "exit_marker": descriptor(core_attempt / ".exit"),
            "events_snapshot": core["events"],
            "summary": core["summary"],
            "contract_self_test": core["contract_self_test"],
            "lane_specs": [
                descriptor(core_control / "lane-specs" / f"{index:02d}-{lane}.json")
                for index, lane in enumerate(
                    success_gate5_profile["scheduled_core_lanes"], start=1
                )
            ],
            "lane_terminal_states": core_states,
            "measured_argv_states": [
                descriptor(core_control / "lanes" / lane / "exact-measured-argv.json")
                for lane in core_success
            ],
            "lane_evidence": core["lane_results"],
            "lane_failures": core["lane_failures"],
            "conditional_na_lanes": [DEFENSE_LOCAL_LANE],
            "result_roots": {lane: str(runner_root / lane) for lane in core_success},
            "status": core["status"],
        }
        extended_control = extended_path.parent.parent.parent
        extended_attempt = extended_path.parent
        extended_states = extended["lane_terminal_states"]
        extended_scheduled = list(
            success_gate5_profile["scheduled_extended_lanes"]
        )
        extended_success = [
            lane
            for lane in extended_scheduled
            if extended_states[lane] == "measured_complete"
        ]
        for lane in extended_success:
            (runner_root / lane).mkdir(exist_ok=True)
            state_path = (
                extended_control / "lanes" / lane / "exact-measured-argv.json"
            )
            state_path.parent.mkdir(parents=True, exist_ok=True)
            write_or_match(
                state_path,
                canonical(
                    {
                        "schema": "ura-phase6-extended-measured-argv/1",
                        "lane_spec": descriptor(
                            extended_control
                            / "lane-specs"
                            / f"{extended_scheduled.index(lane) + 1:02d}-{lane}.json"
                        ),
                        "result_root": str(runner_root / lane),
                        "runner_argv": [
                            "python",
                            "-m",
                            "experiments.run_matrix",
                            "--out",
                            str(runner_root / lane),
                        ],
                        "resume_semantics": "invoke_exact_runner_argv_or_accept_strictly_revalidated_complete_runner_grid",
                    }
                ),
            )
        extended_snapshot = {
            "control_root": str(extended_control),
            "attempt_root": str(extended_attempt),
            "launch": {
                "path": extended["launch"]["path"],
                "sha256": extended["launch"]["sha256"],
                "bytes": extended["launch"]["bytes"],
            },
            "completion": descriptor(extended_path),
            "summary": {
                "path": extended["summary"]["path"],
                "sha256": extended["summary"]["sha256"],
                "bytes": extended["summary"]["bytes"],
            },
            "exit_marker": descriptor(extended_attempt / ".exit"),
            "typed_dispositions": {
                "path": extended["typed_dispositions"]["path"],
                "sha256": extended["typed_dispositions"]["sha256"],
                "bytes": extended["typed_dispositions"]["bytes"],
            },
            "lane_specs": [
                descriptor(extended_control / "lane-specs" / f"{index:02d}-{lane}.json")
                for index, lane in enumerate(extended_scheduled, start=1)
            ],
            "lane_terminal_states": extended_states,
            "measured_argv_states": [
                descriptor(
                    extended_control
                    / "lanes"
                    / lane
                    / "exact-measured-argv.json"
                )
                for lane in extended_success
            ],
            "lane_completions": [
                {
                    "path": extended["lane_results"][lane]["path"],
                    "sha256": extended["lane_results"][lane]["sha256"],
                    "bytes": extended["lane_results"][lane]["bytes"],
                }
                for lane in extended_success
            ],
            "lane_failures": {
                lane: {
                    "path": row["path"],
                    "sha256": row["sha256"],
                    "bytes": row["bytes"],
                }
                for lane, row in extended["lane_failures"].items()
            },
            "terminal_results": {
                lane: {
                    "path": row["path"],
                    "sha256": row["sha256"],
                    "bytes": row["bytes"],
                }
                for lane, row in extended["terminal_results"].items()
            },
            "conditional_na_lanes": [],
            "result_roots": {
                lane: str(runner_root / lane) for lane in extended_success
            },
            "status": extended["status"],
        }
        native_terminal_descriptors = {
            engine: descriptor(phase7_generic) for engine in NATIVE_ENGINES
        }
        native_snapshot = {
            "control_root": str(native_control),
            "attempt_root": str(native_attempt),
            "completion": descriptor(native_completion_path),
            "exit_marker": descriptor(native_attempt / ".exit"),
            "plan": descriptor(native_plan_path),
            "project_revision": descriptor(project_receipt_path),
            "payload": descriptor(phase7_generic),
            "launch": descriptor(phase7_generic),
            "summary": descriptor(phase7_generic),
            "gate5_inputs": {
                "manifest": descriptor(gate_manifest),
                "canonical_runnote": descriptor(gate_runnote),
                "promotion_receipt": descriptor(gate_promotion),
            },
            "terminal_states": native_states,
            "terminal_artifacts": native_terminal_descriptors,
            "engine_reservations": {
                engine: descriptor(phase7_generic)
                for engine, planned in NATIVE_PLANNED_TERMINALS.items()
                if planned == "run"
            },
            "canonical_native_envelopes": {},
            "conditional_na_lanes": [],
            "contract_self_test": descriptor(phase7_generic),
            "local_model_calls": 0,
            "authorized_local_call_cap": NATIVE_AUTHORIZED_LOCAL_CALL_CAP,
            "status": "complete_with_failures",
        }
        runner_states = {**core_states, **extended_states}
        measured_lanes = [
            lane
            for lane in success_gate5_profile["scheduled_runner_lanes"]
            if runner_states[lane] == "measured_complete"
        ]
        phase7_grids: list[dict[str, Any]] = []
        phase7_markers: list[dict[str, Any]] = []
        phase7_eligibility: list[dict[str, Any]] = []
        phase7_attestations: list[dict[str, Any]] = []
        for lane in measured_lanes:
            lane_root = runner_root / lane
            lane_root.mkdir(exist_ok=True)
            existing_grids = sorted(lane_root.glob("*.grid.json"))
            if len(existing_grids) > 1:
                raise AssertionError("self-test runner lane has duplicate grids")
            grid_path = (
                existing_grids[0] if existing_grids else lane_root / "self.grid.json"
            )
            marker_path = lane_root / "cell.complete.json"
            existing_eligibility = sorted(
                lane_root.glob("eligibility-*.eligibility.json")
            )
            if len(existing_eligibility) > 1:
                raise AssertionError("self-test runner lane has duplicate eligibility")
            eligibility_path = (
                existing_eligibility[0]
                if existing_eligibility
                else lane_root / "eligibility-self.eligibility.json"
            )
            request_envelope_path = (
                lane_root / "request-envelope-self.request-envelope.json"
            )
            attestation_path = lane_root / "live-attestation.json"
            write_or_match(
                marker_path,
                canonical({"status": "complete", "format_version": 2}),
            )
            write_or_match(
                eligibility_path,
                canonical({"status": "complete", "plan_id": f"self-plan-{lane}"}),
            )
            write_or_match(
                request_envelope_path,
                canonical({"status": "complete"}),
            )
            write_or_match(attestation_path, canonical({"status": "complete"}))
            write_or_match(
                grid_path,
                canonical(
                    {
                        "status": "complete",
                        "n_errors": 0,
                        "requested_cells": 1,
                        "accounted_cells": 1,
                        "request": self_test_grid_request(
                            lane,
                            eligibility=eligibility_path,
                            attestation=attestation_path,
                        ),
                        "cells": [
                            {
                                "status": "complete",
                                "completion_marker": marker_path.name,
                                "run_id": f"self-test-{lane}",
                            }
                        ],
                    }
                ),
            )
            if lane == DEFENSE_LOCAL_LANE:
                write_or_match(
                    lane_root / "self.responses.jsonl",
                    canonical(
                        {
                            "raw": {
                                "defense": "passed",
                                "base_target_queried": True,
                                "defense_stages_evaluated": ["input", "output"],
                                "defense_judge_audit": [
                                    {**defense_audit_common, "stage": "input"},
                                    {**defense_audit_common, "stage": "output"},
                                ],
                            }
                        }
                    ),
                )
            phase7_grids.append(descriptor(grid_path))
            phase7_markers.append(descriptor(marker_path))
            phase7_eligibility.append(descriptor(eligibility_path))
            phase7_attestations.append(descriptor(attestation_path))
        unique_attestations: dict[str, dict[str, Any]] = {}
        for row in phase7_attestations:
            unique_attestations.setdefault(row["sha256"], row)
        phase7_attestations = [
            unique_attestations[key] for key in sorted(unique_attestations)
        ]
        phase7_lifecycle_roots: dict[str, str] = {}
        phase7_lifecycle_states: dict[str, str] = {}
        phase7_failed_artifacts: dict[str, list[dict[str, Any]]] = {}
        phase7_lifecycle_critical: dict[str, list[dict[str, Any]]] = {}
        phase7_lifecycle_grid_statuses: dict[str, list[str]] = {}
        phase7_lifecycle_groups: dict[
            str, dict[str, list[dict[str, Any]]]
        ] = {}

        def fixture_lifecycle_groups(
            lane_root: Path | None,
        ) -> dict[str, list[dict[str, Any]]]:
            patterns = {
                "runner_grid_artifacts": "*.grid.json",
                "runner_request_envelopes": "*.request-envelope.json",
                "runner_eligibility_artifacts": "*.eligibility.json",
                "runner_error_artifacts": "*.error.json",
            }
            return {
                field: (
                    [descriptor(path) for path in sorted(lane_root.rglob(pattern))]
                    if lane_root is not None
                    else []
                )
                for field, pattern in patterns.items()
            }

        def fixture_grouped_artifacts(
            groups: Mapping[str, Sequence[Mapping[str, Any]]],
        ) -> list[dict[str, Any]]:
            return sorted(
                [dict(item) for items in groups.values() for item in items],
                key=lambda item: str(item["path"]),
            )
        lifecycle_plan_by_path = {
            item["path"]: item for item in phase7_eligibility
        }
        lifecycle_attestation_by_sha = {
            item["sha256"]: item for item in phase7_attestations
        }
        for lane in success_gate5_profile["scheduled_runner_lanes"]:
            lane_root = runner_root / lane
            if runner_states[lane] == "measured_complete":
                phase7_lifecycle_roots[lane] = str(lane_root)
                phase7_lifecycle_states[lane] = "complete"
                phase7_lifecycle_grid_statuses[lane] = ["complete"]
                phase7_lifecycle_groups[lane] = fixture_lifecycle_groups(lane_root)
                phase7_lifecycle_critical[lane] = fixture_grouped_artifacts(
                    phase7_lifecycle_groups[lane]
                )
                continue
            phase7_failed_artifacts[lane] = []
            if not lane_root.is_dir():
                phase7_lifecycle_states[lane] = "failed"
                phase7_lifecycle_grid_statuses[lane] = []
                phase7_lifecycle_groups[lane] = fixture_lifecycle_groups(None)
                phase7_lifecycle_critical[lane] = []
                continue
            phase7_lifecycle_roots[lane] = str(lane_root)
            phase7_lifecycle_groups[lane] = fixture_lifecycle_groups(lane_root)
            phase7_lifecycle_critical[lane] = fixture_grouped_artifacts(
                phase7_lifecycle_groups[lane]
            )
            phase7_failed_artifacts[lane] = [
                descriptor(path)
                for path in sorted(lane_root.rglob("*"))
                if path.is_file() and not path.is_symlink()
            ]
            failed_grid_statuses: list[str] = []
            for failed_grid_path in sorted(lane_root.rglob("*.grid.json")):
                failed_grid = strict_object(
                    failed_grid_path, label="self-test failed lifecycle grid"
                )
                failed_grid_statuses.append(str(failed_grid.get("status")))
                live = failed_grid.get("request", {}).get("live_attestation")
                artifacts = live.get("artifacts", []) if isinstance(live, dict) else []
                for raw in artifacts:
                    retained = descriptor(lane_root / raw["file"])
                    lifecycle_attestation_by_sha.setdefault(
                        retained["sha256"], retained
                    )
            phase7_lifecycle_states[lane] = (
                "partial" if "partial" in failed_grid_statuses else "failed"
            )
            phase7_lifecycle_grid_statuses[lane] = failed_grid_statuses
            for plan_path in sorted(lane_root.rglob("*.eligibility.json")):
                plan = descriptor(plan_path)
                lifecycle_plan_by_path.setdefault(plan["path"], plan)
        phase7_lifecycle_eligibility = [
            lifecycle_plan_by_path[path] for path in sorted(lifecycle_plan_by_path)
        ]
        phase7_lifecycle_attestations = [
            lifecycle_attestation_by_sha[key]
            for key in sorted(lifecycle_attestation_by_sha)
        ]
        phase7_state_by_lane: dict[str, dict[str, Any]] = {}
        for snapshot in (core_snapshot, extended_snapshot):
            for item in snapshot["measured_argv_states"]:
                state_path = descriptor_file(item, label="self-test measured argv")
                phase7_state_by_lane[state_path.parent.name] = item
            control_root = Path(snapshot["control_root"])
            for lane, state in snapshot["lane_terminal_states"].items():
                if state != "failed":
                    continue
                state_path = control_root / "lanes" / lane / "exact-measured-argv.json"
                if state_path.exists() or state_path.is_symlink():
                    phase7_state_by_lane[lane] = descriptor(state_path)
        phase7_controller_failures = {
            **core_snapshot["lane_failures"],
            **extended_snapshot["lane_failures"],
        }
        phase7_lifecycle_authorizations: dict[str, dict[str, Any]] = {}
        for lane in success_gate5_profile["scheduled_runner_lanes"]:
            lifecycle_status = lifecycle_authorization_status(
                terminal_state=runner_states[lane],
                lifecycle_state=phase7_lifecycle_states[lane],
                artifact_kinds=lifecycle_artifact_kinds(
                    grid_statuses=phase7_lifecycle_grid_statuses[lane],
                    artifact_groups=phase7_lifecycle_groups[lane],
                ),
            )
            phase7_lifecycle_authorizations[lane] = {
                "terminal_state": runner_states[lane],
                "lifecycle_state": phase7_lifecycle_states[lane],
                "lifecycle_registry_status": lifecycle_status,
                "level1_tool_input_status": (
                    "retained_runner_artifacts"
                    if lifecycle_status != "pre_runner_failure_no_request_artifact"
                    else "registry_only_pre_runner_failure"
                ),
                "result_root": phase7_lifecycle_roots.get(lane),
                "controller_failure": phase7_controller_failures.get(lane),
                "exact_measured_argv": phase7_state_by_lane.get(lane),
                "runner_lifecycle_artifacts": phase7_lifecycle_critical[lane],
                **phase7_lifecycle_groups[lane],
                "request_artifact_status": (
                    "present"
                    if phase7_lifecycle_groups[lane]["runner_request_envelopes"]
                    else (
                        "runner_lifecycle_present_without_request_envelope"
                        if phase7_lifecycle_critical[lane]
                        else "no_runner_request_artifact"
                    )
                ),
            }
        boundary["runner_outcomes"] = runner_states
        boundary["lifecycle_registry_states"] = phase7_lifecycle_states
        boundary["runner_lifecycle_authorizations"] = (
            phase7_lifecycle_authorizations
        )
        boundary["conditional_na_lanes"] = [DEFENSE_LOCAL_LANE]
        boundary["native_outcomes"] = native_states
        boundary["classification"]["estimate_rows"] = 0
        boundary["defense_local_evidence"] = {
            "status": "N/A",
            "value": None,
            "disposition": "conditional_na",
            "reason_code": DEFENSE_LOCAL_CONDITIONAL_REASON_CODE,
            "reason": DEFENSE_LOCAL_CONDITIONAL_REASON,
            "measured_evidence_admitted": False,
        }
        phase7_input: dict[str, Any] = {
            "schema": "ura-phase7-analysis-inputs/2",
            "inventory_complete": True,
            "scope": "all_local_phase7_read_only_analysis_over_phase6_lifecycle",
            "controller_payload": descriptor(phase7_source),
            "code_identity": {
                "expected_commit": EXPECTED_COMMIT,
                "framework_lock_id": EXPECTED_FRAMEWORK_LOCK,
            },
            "gate5": {
                "manifest": descriptor(gate_manifest),
                "canonical_runnote": descriptor(gate_runnote),
                "promotion_receipt": descriptor(gate_promotion),
                "code_identity": {
                    "expected_commit": EXPECTED_COMMIT,
                    "framework_lock_id": EXPECTED_FRAMEWORK_LOCK,
                },
                "terminal_inventory": {
                    row["lane_id"]: row
                    for row in rows
                    if row["disposition"] != "runnable"
                },
                "lane_count": 46,
                "runnable_lane_count": HISTORICAL_GATE5_RUNNABLE,
                "terminal_lane_count": HISTORICAL_GATE5_TYPED_TERMINAL,
                "target_runtime_terminal": HISTORICAL_GATE5_TARGET_RUNTIME_TERMINAL,
                "target_runtime_terminal_artifact": dict(rr_terminal_descriptor),
                "conditional_na_lanes": [DEFENSE_LOCAL_LANE],
            },
            "project_and_source": {
                "project_revision": {
                    "artifact": descriptor(project_receipt_path),
                    "revision_id": "self-test-revision",
                    "binding": project_binding,
                    "experiment_binding": {"experiment": "self-test"},
                },
                "source_conformance": {
                    "artifact": descriptor(source_receipt_path),
                    "portfolio": dict(EXPECTED_SOURCE_PORTFOLIO),
                },
                "source_config": descriptor(source_config_path),
            },
            "phase6": {
                "core": core_snapshot,
                "extended": extended_snapshot,
                "native": native_snapshot,
                "runner_lane_count": HISTORICAL_GATE5_RUNNABLE,
                "native_engine_count": 9,
                "all_machine_inventories_complete": True,
            },
            "runner": {
                "root": str(runner_root),
                "metric_lane_order": measured_lanes,
                "lifecycle_lane_order": list(
                    success_gate5_profile["scheduled_runner_lanes"]
                ),
                "lifecycle_lane_roots": phase7_lifecycle_roots,
                "terminal_states": runner_states,
                "lifecycle_states": phase7_lifecycle_states,
                "lifecycle_authorizations": phase7_lifecycle_authorizations,
                "conditional_na_lanes": [DEFENSE_LOCAL_LANE],
                "metric_grids": phase7_grids,
                "metric_completion_markers": phase7_markers,
                "metric_eligibility_plans": phase7_eligibility,
                "lifecycle_eligibility_plans": phase7_lifecycle_eligibility,
                "failed_runner_artifacts": phase7_failed_artifacts,
                "lifecycle_live_attestations": phase7_lifecycle_attestations,
                "model_selectors": {
                    "qwen3_vl": "self-test-qwen3-vl",
                    "llava_base": "self-test-llava-base",
                },
                "guardrail_selector": EXPECTED_GUARDRAIL,
                "classification_lanes": sorted(
                    lane
                    for lane in measured_lanes
                    if lane.startswith("rjudge-") or lane.startswith("gptgeochat-")
                ),
                "cascade_expected_lanes": [],
                "proxy_expected_conditions": [],
                "source_parser_common_metric_boundary": "source_metric_only_not_common_unless_separately_opted_in",
            },
            "native_runs": [],
            "native_outcomes": {
                "engine_order": list(NATIVE_ENGINES),
                "states": native_states,
                "terminals": native_terminal_descriptors,
            },
            "analysis_contract": {
                "level1_over_every_final_eligibility_plan": True,
                "lifecycle_registry_includes_every_scheduled_runner_lane": True,
                "level1_consumes_only_retained_runner_and_request_artifacts": True,
                "suite_and_level2_successful_runner_only": True,
                "suite_and_level2_native_scales_separate": True,
                "transfer_attacker": "replay",
                "llava_image_arms": list(IMAGE_ARMS),
                "qwen_replay_vs_crescendo_arms": list(ADAPTIVE_ARMS),
                "paired_inference_unit": "source_cluster_id",
                "evaluator_modes_are_compatibility_keys": True,
                "missingness_and_decision_coverage_required": True,
                "source_parser_classification_kept_out_of_common_metrics": True,
                "failed_phase6_lanes_excluded_from_metric_and_level2_views": True,
                "human_labels_consumed": False,
                "target_calls_permitted": 0,
                "judge_calls_permitted": 0,
                "provider_http_attempts_permitted": 0,
            },
        }
        phase7_input["canonical_recoveries"] = {
            "completion_order": [descriptor(phase7_generic)],
        }
        phase7_input["seven_output_policy_amendment"] = {
            "amendment": descriptor(phase7_generic),
            "completion": descriptor(phase7_generic),
        }
        phase7_input["followon"] = {
            "amendment": descriptor(phase7_generic),
            "completion": descriptor(phase7_generic),
        }
        phase7_input["current_ollama"] = {
            "gate5": descriptor(phase7_generic),
            "completion": descriptor(phase7_generic),
        }
        phase7_input["vllm_stability"] = {
            "completion": descriptor(phase7_generic),
        }
        phase7_input["campaign_terminal_inventory"] = {
            "schema": "ura-phase6-campaign-terminal-inventory-self-test/1",
            "status": "recording-fixture",
        }
        phase7_input["bound_artifacts"] = collect_descriptors(phase7_input)
        bound_material = canonical(phase7_input["bound_artifacts"])
        phase7_input["bound_artifact_inventory"] = {
            "count": len(phase7_input["bound_artifacts"]),
            "sha256": sha256_bytes(bound_material),
            "bytes": len(bound_material),
        }
        phase7_control = engineering_root / "phase7-analysis-self-test"
        phase7_control.mkdir()
        phase7_input_path = phase7_control / "phase7-inputs.json"
        write_new(phase7_input_path, canonical(phase7_input))
        phase7_payload = phase7_control / "payload.py"
        write_new(phase7_payload, phase7_source.read_bytes())
        view_root = phase7_control / "read-only-runner-view"
        view_root.mkdir()
        view_inventory: list[dict[str, Any]] = []
        view_sources = sorted(
            (
                source
                for lane in measured_lanes
                for source in (runner_root / lane).rglob("*")
                if source.is_file() and not source.is_symlink()
            ),
            key=lambda source: source.relative_to(runner_root).as_posix(),
        )
        for source in view_sources:
            relative = source.relative_to(runner_root).as_posix()
            target = view_root / Path(*relative.split("/"))
            target.parent.mkdir(parents=True, exist_ok=True)
            write_new(target, source.read_bytes(), mode=0o400)
            os.chmod(target, 0o400)
            source_stat = source.stat()
            target_stat = target.stat()
            view_inventory.append(
                {
                    "relative_path": relative,
                    "source": descriptor(source),
                    "view": descriptor(target),
                    "source_file_identity": {
                        "device": source_stat.st_dev,
                        "inode": source_stat.st_ino,
                    },
                    "view_file_identity": {
                        "device": target_stat.st_dev,
                        "inode": target_stat.st_ino,
                    },
                    "independent_copy": True,
                    "source_view_samefile": False,
                    "view_mode": stat.S_IMODE(target_stat.st_mode),
                    "view_link_count": target_stat.st_nlink,
                }
            )
        if not view_inventory:
            raise AssertionError("Phase 8 self-test Runner view inventory is empty")
        view_receipt = {
            "schema": "ura-phase7-runner-input-view/3",
            "status": "complete",
            "source_runner_root": str(runner_root),
            "view_root": str(view_root),
            "included_measured_lanes": measured_lanes,
            "regular_files_copied": len(view_inventory),
            "logical_bytes": sum(row["view"]["bytes"] for row in view_inventory),
            "source_files_modified": False,
            "permitted_view_outputs": [],
            "file_inventory": view_inventory,
            "file_inventory_sha256": sha256_bytes(canonical(view_inventory)),
        }
        view_receipt_path = phase7_control / "read-only-runner-view.json"
        write_new(view_receipt_path, canonical(view_receipt))
        validate_phase7_runner_view(
            view_receipt,
            expected_source_root=runner_root,
            expected_view_root=view_root,
            expected_measured_lanes=measured_lanes,
        )
        passed()
        substituted_row = view_inventory[0]
        substituted_source = Path(substituted_row["source"]["path"])
        substituted_view = Path(substituted_row["view"]["path"])
        substituted_payload = substituted_view.read_bytes()
        os.chmod(substituted_view, 0o600)
        substituted_view.unlink()
        selector_visible_substitution = view_root / "transfer_matrix-shadow.jsonl"
        write_new(selector_visible_substitution, substituted_payload)
        rejected(
            lambda: validate_phase7_runner_view(
                view_receipt,
                expected_source_root=runner_root,
                expected_view_root=view_root,
                expected_measured_lanes=measured_lanes,
            ),
            "count-preserving selector-visible Runner view substitution",
        )
        selector_visible_substitution.unlink()
        write_new(substituted_view, substituted_source.read_bytes(), mode=0o400)
        os.chmod(substituted_view, 0o400)
        sealed_source_payload = substituted_source.read_bytes()
        os.chmod(substituted_view, 0o600)
        substituted_view.write_bytes(b"X" * len(sealed_source_payload))
        if substituted_source.read_bytes() != sealed_source_payload:
            raise AssertionError("independent Runner view mutation changed source bytes")
        rejected(
            lambda: validate_phase7_runner_view(
                view_receipt,
                expected_source_root=runner_root,
                expected_view_root=view_root,
                expected_measured_lanes=measured_lanes,
            ),
            "in-place independent Runner view mutation",
        )
        substituted_view.unlink()
        write_new(substituted_view, sealed_source_payload, mode=0o400)
        os.chmod(substituted_view, 0o400)
        restored_stat = substituted_view.stat()
        substituted_row["view"] = descriptor(substituted_view)
        substituted_row["view_file_identity"] = {
            "device": restored_stat.st_dev,
            "inode": restored_stat.st_ino,
        }
        substituted_row["view_mode"] = stat.S_IMODE(restored_stat.st_mode)
        substituted_row["view_link_count"] = restored_stat.st_nlink
        view_receipt["file_inventory_sha256"] = sha256_bytes(
            canonical(view_inventory)
        )
        view_receipt_path.unlink()
        write_new(view_receipt_path, canonical(view_receipt))
        validate_phase7_runner_view(
            view_receipt,
            expected_source_root=runner_root,
            expected_view_root=view_root,
            expected_measured_lanes=measured_lanes,
        )
        analysis_root = analysis_parent / "phase7-self-test"
        analysis_root.mkdir()
        boundary_path = analysis_root / "analysis-boundaries.json"
        write_new(boundary_path, canonical(boundary))
        failed_runner = {
            lane
            for lane in success_gate5_profile["scheduled_runner_lanes"]
            if runner_states[lane] == "failed"
        }
        status_names = {
            "level1-evidence",
            "suite-summary",
            "level2-report",
            "judge-sensitivity",
            "kappa",
            "transfer-matrix",
            "analysis-boundaries",
            *{f"llava-base-vs-rr-{arm}" for arm in IMAGE_ARMS},
            *{f"qwen-replay-vs-crescendo-{arm}" for arm in ADAPTIVE_ARMS},
            *{f"native-{engine}" for engine in NATIVE_ENGINES},
            *{f"gate5-{lane}" for lane in TERMINAL_LANES},
            *{f"runner-{lane}" for lane in failed_runner},
        }
        statuses = {name: "complete" for name in status_names}
        statuses["kappa"] = "no_human_labels"
        for arm in IMAGE_ARMS:
            statuses[f"llava-base-vs-rr-{arm}"] = "unavailable"
        for lane in RR_RUNTIME_TERMINAL_LANES:
            statuses[f"gate5-{lane}"] = "input_unavailable"
        for lane in failed_runner:
            statuses[f"runner-{lane}"] = "input_failed"
        limitations = {
            name: status for name, status in statuses.items() if status != "complete"
        }
        output_required = {
            "level1-evidence",
            "suite-summary",
            "level2-report",
            "judge-sensitivity",
            "kappa",
            "transfer-matrix",
            "analysis-boundaries",
            *{f"llava-base-vs-rr-{arm}" for arm in IMAGE_ARMS},
            *{f"qwen-replay-vs-crescendo-{arm}" for arm in ADAPTIVE_ARMS},
        }
        status_root = analysis_root / "status"
        output_root = analysis_root / "outputs"
        status_root.mkdir()
        output_root.mkdir()
        for name, status_value in statuses.items():
            detail = "self-test exact status"
            receipt_limitations: dict[str, Any] | None = (
                None if status_value == "complete" else {"self_test": True}
            )
            if name == "analysis-boundaries":
                outputs = [boundary_path]
            elif name.startswith("llava-base-vs-rr-"):
                corpus = name.removeprefix("llava-base-vs-rr-")
                output = output_root / f"{name}.json"
                prerequisite_roles = {}
                for role, lane in (
                    ("left_base", "local-llava-base-image-primary-100"),
                    ("right_rr", "local-llava-rr-image-primary-100"),
                ):
                    if lane == "local-llava-rr-image-primary-100":
                        prerequisite_roles[role] = {
                            "lane_id": lane,
                            "terminal_state": "failed",
                            "lifecycle_state": "failed",
                            "lifecycle_registry_status": (
                                "failed_after_runner_request"
                            ),
                            "controller_failure": descriptor(phase7_generic),
                        }
                        continue
                    authorization = phase7_input["runner"][
                        "lifecycle_authorizations"
                    ][lane]
                    prerequisite_roles[role] = {
                        "lane_id": lane,
                        "terminal_state": phase7_input["runner"][
                            "terminal_states"
                        ][lane],
                        "lifecycle_state": phase7_input["runner"][
                            "lifecycle_states"
                        ][lane],
                        "lifecycle_registry_status": authorization[
                            "lifecycle_registry_status"
                        ],
                        "controller_failure": authorization[
                            "controller_failure"
                        ],
                    }
                write_new(
                    output,
                    canonical(
                        {
                            "schema": RR_NON_ESTIMABLE_CONTRAST_SCHEMA,
                            "status": "unavailable",
                            "contrast_id": "llava-base-vs-rr",
                            "modality": "image",
                            "facet": corpus,
                            "comparison_type": "cross_target_endpoint_noncausal",
                            "planned_estimand": (
                                "paired static-image endpoint by datapoint_id x requested_seed"
                            ),
                            "planned_contrast_missing": True,
                            "reason_code": "left_base_and_right_rr_lanes_failed",
                            "reason": (
                                "Both bounded LLaVA image lanes failed, so neither "
                                "arm of the planned base-vs-RR endpoint contrast is "
                                "available."
                            ),
                            "missing_roles": ["left_base", "right_rr"],
                            "prerequisite_roles": prerequisite_roles,
                            "analysis_ready_real_run": False,
                            "estimate": None,
                            "paired_compare_invoked": False,
                            "failed_lane_metric_evidence_admitted": False,
                            "human_audit_eligible": False,
                            "facets": {
                                corpus: {
                                    "analysis_ready_real_run": False,
                                    "inference_cluster": (
                                        "source_cluster_id (fallback datapoint_id)"
                                    ),
                                    "paired_compare_evidence": None,
                                }
                            },
                            "target_calls": 0,
                            "judge_calls": 0,
                            "provider_http_attempts": 0,
                            "human_labels_consumed": False,
                        }
                    ),
                )
                outputs = [output]
                detail = (
                    "Both bounded LLaVA image lanes failed, so the planned "
                    "base-vs-RR endpoint contrast is unavailable."
                )
                receipt_limitations = {
                    "reason_code": "left_base_and_right_rr_lanes_failed",
                    "missing_roles": ["left_base", "right_rr"],
                    "prerequisite_roles": prerequisite_roles,
                    "paired_compare_invoked": False,
                }
            elif name in output_required:
                output = output_root / f"{name}.json"
                write_new(output, canonical({"analysis": name, "status": status_value}))
                outputs = [output]
            else:
                outputs = []
            if name.startswith("gate5-") and name.removeprefix(
                "gate5-"
            ) in RR_RUNTIME_TERMINAL_LANE_SET:
                detail = RR_RUNTIME_TERMINAL_REASON
                receipt_limitations = {
                    "reason_code": RR_RUNTIME_TERMINAL_REASON_CODE,
                    "family": "core",
                    "separate_native_protocol_may_have_phase6_outcome": False,
                    "evidence_status": "UNAVAILABLE",
                    "measured_evidence_admitted": False,
                    "successful_rr_responses": 0,
                    "target_runtime_terminal_artifact": dict(
                        rr_terminal_descriptor
                    ),
                }
            write_new(
                status_root / f"{name}.json",
                canonical(
                    {
                        "schema": "ura-phase7-analysis-status/1",
                        "analysis": name,
                        "status": status_value,
                        "detail": detail,
                        "outputs": [descriptor(output) for output in outputs],
                        "limitations": receipt_limitations,
                        "target_calls": 0,
                        "judge_calls": 0,
                        "provider_http_attempts": 0,
                        "human_labels_consumed": False,
                    }
                ),
            )
        inventory_path = analysis_root / "artifact-inventory.json"
        analysis_artifacts = [
            descriptor(candidate)
            for candidate in sorted(analysis_root.rglob("*"))
            if candidate.is_file()
        ]
        write_new(
            inventory_path,
            canonical(
                {
                    "schema": "ura-phase7-analysis-artifact-inventory/1",
                    "status": "complete",
                    "analysis_root": str(analysis_root),
                    "artifacts": analysis_artifacts,
                    "artifact_count": len(analysis_artifacts),
                    "status_inventory": statuses,
                    "input_manifest_sha256": sha256_file(phase7_input_path),
                    "payload_sha256": sha256_file(phase7_payload),
                    "runner_input_view": descriptor(view_receipt_path),
                    "target_calls": 0,
                    "judge_calls": 0,
                    "provider_http_attempts": 0,
                    "human_labels_consumed": False,
                }
            ),
        )
        phase7_completion = {
            "schema": "ura-phase7-analysis-completion/2",
            "status": "complete_with_explicit_limitations",
            "started_at_utc": "2026-08-22T00:00:00Z",
            "completed_at_utc": "2026-08-22T00:00:01Z",
            "inventory_complete": True,
            "input_manifest": descriptor(phase7_input_path),
            "authorized_input_manifest_sha256": sha256_file(phase7_input_path),
            "payload": descriptor(phase7_payload),
            "analysis_root": str(analysis_root),
            "artifact_inventory": descriptor(inventory_path),
            "runner_input_view": descriptor(view_receipt_path),
            "analysis_statuses": statuses,
            "explicit_limitations": limitations,
            "phase6_terminal_states": {
                "core": core_states,
                "extended": extended_states,
                "native": native_states,
            },
            "target_calls": 0,
            "judge_calls": 0,
            "provider_http_attempts": 0,
            "downloads_observed_bytes": 0,
            "human_labels_consumed": False,
            "human_validity_claimed": False,
            "universal_safety_score_defined": False,
            "native_scales_pooled": False,
            "evaluator_modes_pooled": False,
        }
        phase7_completion_path = phase7_control / "completion.json"
        write_new(phase7_completion_path, canonical(phase7_completion))
        write_new(phase7_control / ".exit", b"0\n")

        # The portable fixture is intentionally synthetic and must never be
        # accepted by the real Gate 5/6/7 oracle. Test the exact pinned loader and
        # its API separately, then exercise this controller's replay wiring with a
        # recording oracle over the already validated synthetic snapshots.
        # Force the deployed sibling fallback. A separate mutation below still
        # exercises and rejects an explicit project-local oracle with changed bytes.
        source_project_root = root / "project-without-campaign-oracle"
        api_validation_calls: list[Any] = []
        api_validator_symbol = "validate_frozen_phase7_oracle_api"
        original_api_validator = globals()[api_validator_symbol]

        def recording_api_validator(candidate_oracle: Any) -> None:
            api_validation_calls.append(candidate_oracle)
            original_api_validator(candidate_oracle)

        try:
            globals()[api_validator_symbol] = recording_api_validator
            frozen_oracle = load_frozen_phase7_oracle(source_project_root)
        finally:
            globals()[api_validator_symbol] = original_api_validator
        if api_validation_calls != [frozen_oracle]:
            raise AssertionError("frozen Phase 7 loader skipped exact API validation")
        passed()
        bad_api_oracle = types.SimpleNamespace(
            validate_gate5=lambda: None,
            validate_project_and_source=frozen_oracle.validate_project_and_source,
            validate_core_controller=frozen_oracle.validate_core_controller,
            validate_extended_controller=frozen_oracle.validate_extended_controller,
            validate_native_controller=frozen_oracle.validate_native_controller,
            validate_runner_inventory=frozen_oracle.validate_runner_inventory,
        )
        rejected(
            lambda: validate_frozen_phase7_oracle_api(bad_api_oracle),
            "changed frozen Phase 7 oracle API signature",
        )
        tampered_oracle_project = root / "tampered-oracle-project"
        tampered_oracle_campaign = tampered_oracle_project / ".campaign"
        tampered_oracle_campaign.mkdir(parents=True)
        tampered_oracle_source = Path(frozen_oracle.__file__).read_bytes()
        tampered_oracle_bytes = tampered_oracle_source.replace(
            b'"""Sealed ', b'"""sealed ', 1
        )
        if (
            len(tampered_oracle_bytes) != len(tampered_oracle_source)
            or tampered_oracle_bytes == tampered_oracle_source
        ):
            raise AssertionError("self-test could not make a valid same-length tamper")
        write_new(
            tampered_oracle_campaign / "phase7_analysis.py",
            bytes(tampered_oracle_bytes),
        )
        rejected(
            lambda: load_frozen_phase7_oracle(tampered_oracle_project),
            "same-length tampered frozen Phase 7 oracle",
        )
        rejected(
            lambda: replay_frozen_phase7_oracle(
                frozen_oracle,
                gate5=phase7_input["gate5"],
                inputs=phase7_input,
                project_and_source=phase7_input["project_and_source"],
                core=phase7_input["phase6"]["core"],
                extended=phase7_input["phase6"]["extended"],
                native=phase7_input["phase6"]["native"],
                runner=phase7_input["runner"],
                project_root=project_root,
                work_root=work_root,
                runner_root=runner_root,
            ),
            "synthetic evidence admitted by the real frozen Phase 7 oracle",
        )

        oracle_calls: list[str] = []
        oracle_note = {"fixture": "recording-note"}
        oracle_promotion = {"fixture": "recording-promotion"}

        def recording_gate5(
            manifest_path: Path,
            runnote_path: Path,
            promotion_path: Path,
            project: Path,
            work: Path,
            *,
            manifest_payload: bytes | None = None,
            runnote_payload: bytes | None = None,
            promotion_payload: bytes | None = None,
        ) -> tuple[dict[str, Any], dict[str, Any], dict[str, Any], dict[str, Any]]:
            if (
                manifest_path != gate_manifest
                or runnote_path != gate_runnote
                or promotion_path != gate_promotion
                or project != project_root
                or work != work_root
            ):
                raise AssertionError("recording oracle Gate 5 arguments differ")
            if manifest_payload is None:
                _path, manifest_payload = _stable_regular_bytes(
                    gate_manifest,
                    label="self-test recording manifest",
                    max_bytes=MAX_JSON_BYTES,
                )
            oracle_calls.append("gate5")
            return (
                strict_loads(manifest_payload, label="self-test recording manifest"),
                oracle_note,
                oracle_promotion,
                phase7_input["code_identity"],
            )

        def recording_project(
            *,
            project: Path,
            note: Mapping[str, Any],
            promotion: Mapping[str, Any],
            code_identity: Mapping[str, Any],
        ) -> Mapping[str, Any]:
            if (
                project != project_root
                or note != oracle_note
                or promotion != oracle_promotion
                or code_identity != phase7_input["code_identity"]
            ):
                raise AssertionError("recording oracle project arguments differ")
            oracle_calls.append("project")
            return phase7_input["project_and_source"]

        def recording_profile(
            observed_rows: object,
            *,
            label: str,
            validate_artifact: bool = True,
        ) -> Mapping[str, Any]:
            if (
                observed_rows != rows
                or label != "Phase 7 oracle Gate 5 manifest"
                or validate_artifact is not True
            ):
                raise AssertionError("recording oracle Gate 5 profile differs")
            oracle_calls.append("profile")
            return success_gate5_profile

        def recording_core(**kwargs: Any) -> Mapping[str, Any]:
            if kwargs != {
                "completion_path": core_path,
                "gate5_manifest": gate_manifest,
                "gate5_runnote": gate_runnote,
                "gate5_promotion": gate_promotion,
                "code_identity": phase7_input["code_identity"],
                "runner_root": runner_root,
                "gate5_profile": success_gate5_profile,
            }:
                raise AssertionError("recording oracle core arguments differ")
            oracle_calls.append("core")
            return phase7_input["phase6"]["core"]

        def recording_extended(**kwargs: Any) -> Mapping[str, Any]:
            if kwargs != {
                "completion_path": extended_path,
                "gate5_manifest": gate_manifest,
                "gate5_runnote": gate_runnote,
                "gate5_promotion": gate_promotion,
                "code_identity": phase7_input["code_identity"],
                "runner_root": runner_root,
            }:
                raise AssertionError("recording oracle extended arguments differ")
            oracle_calls.append("extended")
            return phase7_input["phase6"]["extended"]

        def recording_native(**kwargs: Any) -> Mapping[str, Any]:
            if kwargs != {
                "completion_path": native_completion_path,
                "gate5_manifest": gate_manifest,
                "gate5_runnote": gate_runnote,
                "gate5_promotion": gate_promotion,
                "code_identity": phase7_input["code_identity"],
            }:
                raise AssertionError("recording oracle native arguments differ")
            oracle_calls.append("native")
            return phase7_input["phase6"]["native"]

        def recording_runner(**kwargs: Any) -> Mapping[str, Any]:
            if kwargs != {
                "runner_root": runner_root,
                "core": phase7_input["phase6"]["core"],
                "extended": phase7_input["phase6"]["extended"],
                "code_identity": phase7_input["code_identity"],
                "project_and_source": phase7_input["project_and_source"],
                "gate5_profile": success_gate5_profile,
            }:
                raise AssertionError("recording oracle Runner arguments differ")
            oracle_calls.append("runner")
            return phase7_input["runner"]

        def recording_followon(
            *,
            amendment_path: Path,
            completion_path: Path,
            gate5_promotion: Path,
            code_identity: Mapping[str, Any],
        ) -> Mapping[str, Any]:
            if (
                amendment_path != phase7_generic
                or completion_path != phase7_generic
                or gate5_promotion != gate_promotion
                or code_identity != phase7_input["code_identity"]
            ):
                raise AssertionError("recording oracle follow-on arguments differ")
            oracle_calls.append("followon")
            return phase7_input["followon"]

        def recording_recoveries(
            paths: Sequence[Path],
            *,
            gate5_manifest: Path,
            gate5_runnote: Path,
            gate5_promotion: Path,
            project_and_source: Mapping[str, Any],
        ) -> Mapping[str, Any]:
            if (
                list(paths) != [phase7_generic]
                or gate5_manifest != gate_manifest
                or gate5_runnote != gate_runnote
                or gate5_promotion != gate_promotion
                or project_and_source != phase7_input["project_and_source"]
            ):
                raise AssertionError("recording oracle recovery arguments differ")
            oracle_calls.append("recoveries")
            return phase7_input["canonical_recoveries"]

        def recording_seven(
            *,
            amendment_path: Path,
            completion_path: Path,
            gate5_manifest: Path,
            gate5_runnote: Path,
            gate5_promotion: Path,
            project_and_source: Mapping[str, Any],
        ) -> Mapping[str, Any]:
            if (
                amendment_path != phase7_generic
                or completion_path != phase7_generic
                or gate5_manifest != gate_manifest
                or gate5_runnote != gate_runnote
                or gate5_promotion != gate_promotion
                or project_and_source != phase7_input["project_and_source"]
            ):
                raise AssertionError("recording oracle seven-row arguments differ")
            oracle_calls.append("seven")
            return phase7_input["seven_output_policy_amendment"]

        expected_current_ollama_runner_root = runner_root

        def recording_current_ollama(
            *,
            gate5_path: Path,
            completion_path: Path,
            runner_root: Path,
        ) -> Mapping[str, Any]:
            if (
                gate5_path != phase7_generic
                or completion_path != phase7_generic
                or runner_root != expected_current_ollama_runner_root
            ):
                raise AssertionError("recording oracle current Ollama arguments differ")
            oracle_calls.append("current_ollama")
            return phase7_input["current_ollama"]

        def recording_vllm_stability(
            completion_path: Path,
            *,
            runner_root: Path,
        ) -> Mapping[str, Any]:
            if completion_path != phase7_generic or runner_root != expected_current_ollama_runner_root:
                raise AssertionError("recording oracle vLLM stability arguments differ")
            oracle_calls.append("vllm_stability")
            return phase7_input["vllm_stability"]

        def recording_campaign(
            *,
            gate5_rows: Sequence[Mapping[str, Any]],
            gate5_manifest: Path,
            project_and_source: Mapping[str, Any],
            runner: Mapping[str, Any],
            native: Mapping[str, Any],
            recoveries: Mapping[str, Any],
            seven: Mapping[str, Any],
            followon: Mapping[str, Any],
            current_ollama: Mapping[str, Any],
            vllm_stability: Mapping[str, Any],
        ) -> Mapping[str, Any]:
            if {
                "gate5_rows": rows,
                "gate5_manifest": gate_manifest,
                "project_and_source": phase7_input["project_and_source"],
                "runner": phase7_input["runner"],
                "native": phase7_input["phase6"]["native"],
                "recoveries": phase7_input["canonical_recoveries"],
                "seven": phase7_input["seven_output_policy_amendment"],
                "followon": phase7_input["followon"],
                "current_ollama": phase7_input["current_ollama"],
                "vllm_stability": phase7_input["vllm_stability"],
            } != {
                "gate5_rows": list(gate5_rows),
                "gate5_manifest": gate5_manifest,
                "project_and_source": project_and_source,
                "runner": runner,
                "native": native,
                "recoveries": recoveries,
                "seven": seven,
                "followon": followon,
                "current_ollama": current_ollama,
                "vllm_stability": vllm_stability,
            }:
                raise AssertionError("recording oracle campaign arguments differ")
            oracle_calls.append("campaign")
            return phase7_input["campaign_terminal_inventory"]

        def recording_validate_campaign(value: object) -> Mapping[str, Any]:
            if value != phase7_input["campaign_terminal_inventory"]:
                raise AssertionError("recording campaign validation input differs")
            return phase7_input["campaign_terminal_inventory"]

        recording_oracle = types.SimpleNamespace(
            gate5_inventory_profile=recording_profile,
            validate_gate5=recording_gate5,
            validate_project_and_source=recording_project,
            validate_core_controller=recording_core,
            validate_extended_controller=recording_extended,
            validate_native_controller=recording_native,
            validate_runner_inventory=recording_runner,
            validate_phase6_recovery_completions=recording_recoveries,
            validate_followon_inventory=recording_followon,
            validate_seven_output_policy_inventory=recording_seven,
            validate_current_ollama_completion=recording_current_ollama,
            validate_vllm_stability_completion=recording_vllm_stability,
            validate_phase6_campaign_terminal_inventory=(
                recording_validate_campaign
            ),
            build_phase6_campaign_terminal_inventory=recording_campaign,
        )
        loader_calls: list[Path] = []

        def recording_loader(candidate_project_root: Path) -> Any:
            if candidate_project_root != project_root:
                raise AssertionError("recording oracle loader project root differs")
            loader_calls.append(candidate_project_root)
            return recording_oracle

        loader_symbol = "load_frozen_phase7_oracle"
        original_loader = globals()[loader_symbol]
        try:
            globals()[loader_symbol] = recording_loader
            replay_frozen_phase7_oracle(
                load_frozen_phase7_oracle(project_root),
                gate5=phase7_input["gate5"],
                inputs=phase7_input,
                project_and_source=phase7_input["project_and_source"],
                core=phase7_input["phase6"]["core"],
                extended=phase7_input["phase6"]["extended"],
                native=phase7_input["phase6"]["native"],
                runner=phase7_input["runner"],
                project_root=project_root,
                work_root=work_root,
                runner_root=runner_root,
            )
        finally:
            globals()[loader_symbol] = original_loader
        passed()
        expected_oracle_calls = [
            "gate5",
            "profile",
            "project",
            "core",
            "extended",
            "native",
            "runner",
            "recoveries",
            "followon",
            "seven",
            "current_ollama",
            "vllm_stability",
            "campaign",
        ]
        if loader_calls != [project_root] or oracle_calls != expected_oracle_calls:
            raise AssertionError("production frozen-oracle call wiring differs")
        passed()

        def with_snapshot_mismatch(
            value: Mapping[str, Any], kind: str
        ) -> dict[str, Any]:
            return {**value, "_self_test_mismatch": kind}

        def mismatch_oracle(kind: str) -> types.SimpleNamespace:
            def mismatched_gate5(
                manifest_path: Path,
                runnote_path: Path,
                promotion_path: Path,
                project: Path,
                work: Path,
                *,
                manifest_payload: bytes | None = None,
                runnote_payload: bytes | None = None,
                promotion_payload: bytes | None = None,
            ) -> tuple[dict[str, Any], dict[str, Any], dict[str, Any], dict[str, Any]]:
                manifest, note, promotion, code_identity = recording_gate5(
                    manifest_path,
                    runnote_path,
                    promotion_path,
                    project,
                    work,
                    manifest_payload=manifest_payload,
                    runnote_payload=runnote_payload,
                    promotion_payload=promotion_payload,
                )
                if kind == "manifest":
                    manifest = with_snapshot_mismatch(manifest, kind)
                return manifest, note, promotion, code_identity

            def mismatched_project(**kwargs: Any) -> Mapping[str, Any]:
                value = recording_project(**kwargs)
                return (
                    with_snapshot_mismatch(value, kind) if kind == "project" else value
                )

            def mismatched_core(**kwargs: Any) -> Mapping[str, Any]:
                value = recording_core(**kwargs)
                return with_snapshot_mismatch(value, kind) if kind == "core" else value

            def mismatched_extended(**kwargs: Any) -> Mapping[str, Any]:
                value = recording_extended(**kwargs)
                return (
                    with_snapshot_mismatch(value, kind) if kind == "extended" else value
                )

            def mismatched_native(**kwargs: Any) -> Mapping[str, Any]:
                value = recording_native(**kwargs)
                return (
                    with_snapshot_mismatch(value, kind) if kind == "native" else value
                )

            def mismatched_runner(**_kwargs: Any) -> Mapping[str, Any]:
                value = phase7_input["runner"]
                return (
                    with_snapshot_mismatch(value, kind) if kind == "runner" else value
                )

            def mismatched_current_ollama(
                *,
                gate5_path: Path,
                completion_path: Path,
                runner_root: Path,
            ) -> Mapping[str, Any]:
                value = recording_current_ollama(
                    gate5_path=gate5_path,
                    completion_path=completion_path,
                    runner_root=runner_root,
                )
                return (
                    with_snapshot_mismatch(value, kind)
                    if kind == "current_ollama"
                    else value
                )

            def mismatched_vllm_stability(
                completion_path: Path,
                *,
                runner_root: Path,
            ) -> Mapping[str, Any]:
                value = recording_vllm_stability(
                    completion_path,
                    runner_root=runner_root,
                )
                return (
                    with_snapshot_mismatch(value, kind)
                    if kind == "vllm_stability"
                    else value
                )

            return types.SimpleNamespace(
                gate5_inventory_profile=recording_profile,
                validate_gate5=mismatched_gate5,
                validate_project_and_source=mismatched_project,
                validate_core_controller=mismatched_core,
                validate_extended_controller=mismatched_extended,
                validate_native_controller=mismatched_native,
                validate_runner_inventory=mismatched_runner,
                validate_phase6_recovery_completions=recording_recoveries,
                validate_followon_inventory=recording_followon,
                validate_seven_output_policy_inventory=recording_seven,
                validate_current_ollama_completion=mismatched_current_ollama,
                validate_vllm_stability_completion=mismatched_vllm_stability,
                validate_phase6_campaign_terminal_inventory=(
                    recording_validate_campaign
                ),
                build_phase6_campaign_terminal_inventory=recording_campaign,
            )

        for mismatch_kind in (
            "manifest",
            "project",
            "core",
            "extended",
            "native",
            "runner",
            "current_ollama",
            "vllm_stability",
        ):
            candidate_oracle = mismatch_oracle(mismatch_kind)
            rejected(
                lambda candidate_oracle=candidate_oracle: replay_frozen_phase7_oracle(
                    candidate_oracle,
                    gate5=phase7_input["gate5"],
                    inputs=phase7_input,
                    project_and_source=phase7_input["project_and_source"],
                    core=phase7_input["phase6"]["core"],
                    extended=phase7_input["phase6"]["extended"],
                    native=phase7_input["phase6"]["native"],
                    runner=phase7_input["runner"],
                    project_root=project_root,
                    work_root=work_root,
                    runner_root=runner_root,
                ),
                f"frozen Phase 7 {mismatch_kind} replay snapshot mismatch",
            )

        def qualification_fixture_rows() -> list[dict[str, Any]]:
            rows: list[dict[str, Any]] = []
            for index in range(1, QUALIFICATION_ITEM_COUNT + 1):
                row = {
                    **{field: "" for field in QUALIFICATION_FIELDS},
                    "sample_key": f"qualification-{index:02d}-a",
                    "cluster_key": f"qualification|cluster-{index:02d}",
                    "run_id": f"qualification-run-{index:02d}",
                    "model": "model",
                    "model_spec": "spec",
                    "defense": "none",
                    "attacker": "replay",
                    "risk_category": "risk",
                    "modality": "text",
                    "expected_behavior": "refuse",
                    "source": "qualification",
                    "source_policy_id": "policy",
                    "source_policy_version": "1",
                    "source_policy_instruction": "instruction",
                    "prompt": "prompt",
                    "response": "response",
                    "media_references": "[]",
                }
                rows.append(row)
                if index == 1:
                    sibling = dict(row)
                    sibling["sample_key"] = "qualification-01-z"
                    sibling["run_id"] = "qualification-run-01-sibling"
                    sibling["response"] = "sibling response"
                    rows.append(sibling)
            return rows

        def qualification_fixture_candidates(
            *, runner_root: Path, excluded_clusters: set[str]
        ) -> list[dict[str, Any]]:
            if runner_root != view_root or excluded_clusters != {"source|cluster"}:
                raise AssertionError("qualification replay fixture arguments differ")
            eligible = [
                row
                for row in qualification_fixture_rows()
                if row["cluster_key"] not in excluded_clusters
            ]
            return _qualification_cluster_representatives(eligible)

        def with_qualification_fixture(operation: Any) -> Any:
            qualification_symbol = "_qualification_candidates"
            semantic_symbol = "semantic_revalidate"
            view_symbol = "revalidate_bound_audit_runner_view"
            original_qualification = globals()[qualification_symbol]
            original_semantic = globals()[semantic_symbol]
            original_view = globals()[view_symbol]

            def fixture_semantic(inputs: Mapping[str, Any]) -> dict[str, Any]:
                scope = inputs.get("scope")
                if (
                    not isinstance(scope, Mapping)
                    or scope.get("runner_root") != str(runner_root)
                    or scope.get("audit_runner_root") != str(view_root)
                ):
                    raise AssertionError("prepared fixture Runner scope differs")
                return {
                    "audit_runner_view_receipt": view_receipt,
                    "runner_root": runner_root,
                    "audit_runner_root": view_root,
                    "audit_runner_view_lanes": measured_lanes,
                    "core_runner_view_receipt": view_receipt,
                    "runner": phase7_input["runner"],
                    "canonical_recoveries": phase7_input["canonical_recoveries"],
                    "seven": phase7_input["seven_output_policy_amendment"],
                    "followon": phase7_input["followon"],
                    "current_ollama": phase7_input["current_ollama"],
                    "vllm_stability": phase7_input["vllm_stability"],
                }

            def fixture_view(**kwargs: Any) -> Path:
                if (
                    kwargs.get("receipt") != view_receipt
                    or kwargs.get("source_root") != runner_root
                    or kwargs.get("view_root") != view_root
                    or kwargs.get("measured_lanes") != measured_lanes
                ):
                    raise AssertionError("prepared fixture Runner view differs")
                return view_root

            try:
                globals()[qualification_symbol] = qualification_fixture_candidates
                globals()[semantic_symbol] = fixture_semantic
                globals()[view_symbol] = fixture_view
                return operation()
            finally:
                globals()[qualification_symbol] = original_qualification
                globals()[semantic_symbol] = original_semantic
                globals()[view_symbol] = original_view

        def build_prepared(
            tag: str,
            mutation: str = "",
        ) -> tuple[Path, dict[str, Any], str]:
            base = root / f"prepared-{tag}"
            control = base / "control"
            final_root = base / "prepared"
            control.mkdir(parents=True)
            final_root.mkdir()
            ethics_binding = {
                "artifact": descriptor(phase7_generic),
                "authorized_sha256": sha256_file(phase7_generic),
                "determination_id": "self-test-operator-record",
                "status": "authorized",
                "preparation_authorized": True,
                "human_labeling_authorized": False,
            }
            authorized_input = {
                "scope": {
                    "runner_root": str(runner_root),
                    "audit_runner_root": str(view_root),
                },
                "sampling": {
                    "common_unique_clusters": 1,
                    "source_task_unique_clusters": 1,
                },
                "ethics_determination": ethics_binding,
                "phase6": {
                    "core_status": "complete_with_failures",
                    "extended_status": "complete_with_failures",
                    "native_status": "complete_with_failures",
                    "core_terminal_states": core_states,
                    "extended_terminal_states": extended_states,
                    "native_terminal_states": native_states,
                },
                "phase7": {
                    "analysis_boundaries": descriptor(boundary_path),
                    "runner_input_view": descriptor(view_receipt_path),
                    "status": "complete_with_explicit_limitations",
                },
            }
            authorized_input_path = control / "phase8-inputs.json"
            write_new(authorized_input_path, canonical(authorized_input))
            authorized_sha = sha256_file(authorized_input_path)

            common_fields = list(COMMON_SAMPLE_FIELDS)
            if mutation == "common-extra-column":
                common_fields.append("automated_label")
            elif mutation == "common-reordered-column":
                common_fields[0], common_fields[1] = common_fields[1], common_fields[0]
            common_row = {field: "" for field in common_fields}
            common_row.update(
                {
                    "sample_key": "common-1",
                    "run_id": "run-common",
                    "model": "model",
                    "model_spec": "spec",
                    "defense": "none",
                    "attacker": "replay",
                    "risk_category": "risk",
                    "modality": "text",
                    "expected_behavior": "harmful",
                    "source": "source",
                    "source_policy_id": "policy",
                    "source_policy_version": "1",
                    "source_policy_instruction": "instruction",
                    "source_cluster_id": "cluster",
                    "cluster_key": "source|cluster",
                    "prompt": "prompt",
                    "response": "response",
                    "media_references": "[]",
                    "common_metrics_eligible": "True",
                }
            )
            if mutation == "human-label":
                common_row["label"] = "safe"
            common_path = final_root / "human-audit-sample.csv"
            write_csv(common_path, common_fields, [common_row])
            write_new(
                final_root / "human-audit-sample.INSTRUCTIONS.md",
                (
                    b"MUTATED COMMON INSTRUCTIONS\n"
                    if mutation == "common-instructions"
                    else common_instructions_text(1).encode("ascii")
                ),
            )
            common_form = final_root / "human-audit-rating-form.csv"
            write_csv(common_form, common_fields, [common_row, common_row])

            source_fields = list(SOURCE_SAMPLE_FIELDS)
            if mutation == "source-extra-column":
                source_fields.append("source_reference")
            source_row = {field: "" for field in source_fields}
            source_row.update(
                {
                    "sample_key": "source-1",
                    "run_id": "run-source",
                    "model": "model",
                    "model_spec": "spec",
                    "defense": "none",
                    "attacker": "replay",
                    "modality": "text",
                    "source": "rjudge",
                    "source_task_family": "rjudge_safety_judgment",
                    "task_label_vocabulary": "safe|unsafe",
                    "source_policy_id": "policy",
                    "source_policy_version": "1",
                    "source_policy_instruction": "classify",
                    "source_cluster_id": "source-cluster",
                    "cluster_key": "rjudge|source-cluster",
                    "prompt": "prompt",
                    "response": "unsafe",
                    "media_references": "[]",
                }
            )
            source_path = final_root / "source-task-audit-sample.csv"
            write_csv(source_path, source_fields, [source_row])
            write_new(
                final_root / "source-task-audit-sample.INSTRUCTIONS.md",
                (
                    b"MUTATED SOURCE INSTRUCTIONS\n"
                    if mutation == "source-instructions"
                    else source_task_instructions_text(1).encode("ascii")
                ),
            )
            source_form = final_root / "source-task-audit-rating-form.csv"
            write_csv(source_form, source_fields, [source_row, source_row])

            qualification_fields = list(QUALIFICATION_FIELDS)
            if mutation == "qualification-extra-column":
                qualification_fields.append("automated_verdict")
            qualification_candidates = qualification_fixture_candidates(
                runner_root=view_root,
                excluded_clusters={"source|cluster"},
            )
            qualification_rows, _represented = _select_qualification_candidates(
                qualification_candidates
            )
            if mutation == "qualification-sibling-substitution":
                selected_index = next(
                    index
                    for index, row in enumerate(qualification_rows)
                    if row["cluster_key"] == "qualification|cluster-01"
                )
                selected_id = qualification_rows[selected_index][
                    "qualification_item_id"
                ]
                sibling = next(
                    row
                    for row in qualification_fixture_rows()
                    if row["sample_key"] == "qualification-01-z"
                )
                qualification_rows[selected_index] = {
                    **sibling,
                    "qualification_item_id": selected_id,
                }
            qualification_path = final_root / "qualification-items.csv"
            write_csv(qualification_path, qualification_fields, qualification_rows)
            gold_fields = [
                "qualification_item_id",
                "sample_key",
                "cluster_key",
                "gold_label",
                "gold_refusal_label",
                "gold_harmfulness_label",
                "gold_convincingness_label",
                "gold_specificity_label",
                "adjudicator_id",
                "adjudication_notes",
            ]
            gold_rows = [
                {
                    **{field: "" for field in gold_fields},
                    "qualification_item_id": row["qualification_item_id"],
                    "sample_key": row["sample_key"],
                    "cluster_key": row["cluster_key"],
                }
                for row in qualification_rows
            ]
            write_csv(
                final_root / "qualification-gold.template.csv",
                gold_fields,
                gold_rows,
            )

            assignments = {
                "schema": ASSIGNMENT_SCHEMA,
                "status": "awaiting_independently_qualified_raters",
                "authorized_input_manifest_sha256": authorized_sha,
                "frames": {
                    "common": {
                        "sample": descriptor(common_path),
                        "rating_form": descriptor(common_form),
                        "item_rows": 1,
                        "unique_clusters": 1,
                        "assignment_slots_per_item": 2,
                        "assigned_rater_ids": None,
                        "item_assignments": assignment_rows(
                            [common_row], frame="common"
                        ),
                    },
                    "source_task": {
                        "sample": descriptor(source_path),
                        "rating_form": descriptor(source_form),
                        "item_rows": 1,
                        "unique_clusters": 1,
                        "assignment_slots_per_item": 2,
                        "assigned_rater_ids": None,
                        "item_assignments": assignment_rows(
                            [source_row], frame="source-task"
                        ),
                    },
                },
                "same_rater_may_fill_both_slots": False,
                "qualification_required_before_assignment": True,
                "labels_present": False,
                "adjudications_present": False,
            }
            if mutation == "assigned-rater":
                assignments["frames"]["common"]["assigned_rater_ids"] = ["rater"]
                assignments["frames"]["common"]["item_assignments"][0]["slots"][0][
                    "assigned_rater_id"
                ] = "rater"
            assignment_path = final_root / "assignment-manifest.json"
            write_new(assignment_path, canonical(assignments))

            boundary_record = {
                "schema": BOUNDARY_SCHEMA,
                "status": "validated_for_blinded_preparation",
                "gate5_inventory": {
                    "total": 46,
                    "runnable": HISTORICAL_GATE5_RUNNABLE,
                    "terminal": HISTORICAL_GATE5_TYPED_TERMINAL,
                    "native": 9,
                },
                "common_frame": {
                    "common_metrics_eligible_only": True,
                    "row_count": 1,
                    "cluster_count": 1,
                    "automated_labels_blinded": True,
                    "model_identity_visible": True,
                },
                "source_task_frame": {
                    "source_metric_only": True,
                    "row_count": 1,
                    "cluster_count": 1,
                    "parser_and_reference_blinded": True,
                    "never_common_metric_evidence": True,
                },
                "frames_disjoint": True,
                "evaluator_modes_pooled": False,
                "approximate_common_metrics": boundary["approximate_common_metrics"],
                "classification": boundary["classification"],
                "selected_guardrail": EXPECTED_GUARDRAIL,
                "queried_approximate_rows_bind_selected_guardrail": True,
                "human_labels_consumed": False,
                "human_validity_claimed": False,
            }
            boundary_record_path = final_root / "boundary-validation.json"
            write_new(boundary_record_path, canonical(boundary_record))
            workload = {
                "schema": WORKLOAD_SCHEMA,
                "status": "prospective_capacity_confirmation_required",
                "common": {
                    "exported_rows": 1,
                    "minimum_independent_ratings": 2,
                    "adjudications": "one per non-unanimous composite or dimension",
                },
                "source_task": {
                    "exported_rows": 1,
                    "minimum_independent_ratings": 2,
                    "adjudications": "one per non-unanimous task or parse-status label",
                },
                "total_minimum_independent_ratings": 4,
                "qualification_items": 20,
                "qualified_raters_required": 2,
                "capacity_confirmed": False,
            }
            workload_path = final_root / "workload.json"
            write_new(workload_path, canonical(workload))
            codebook = final_root / "CODEBOOK.md"
            qualification_sha = sha256_file(qualification_path)
            write_new(
                codebook,
                (
                    b"Machine prepared, but unbound guidance.\n"
                    if mutation == "codebook-mismatch"
                    else codebook_text(
                        common_rows=1,
                        source_rows=1,
                        qualification_sha=qualification_sha,
                    ).encode("ascii")
                ),
            )
            write_new(
                final_root / "human-rater-qualification.template.md",
                qualification_record_template(qualification_sha).encode("ascii"),
            )
            blocker = {
                "schema": BLOCKER_SCHEMA,
                "status": "human_only_blocked",
                "machine_preparation_complete": True,
                "gate8_met": False,
                "ethics_determination_supplied_not_created": ethics_binding,
                "human_labeling_authorized_by_determination": False,
                "required_operator_inputs": required_human_operator_inputs(
                    human_labeling_authorized=False
                ),
                "prohibited_inferences": list(PROHIBITED_HUMAN_INFERENCES),
                "human_raters": [],
                "qualification_complete": False,
                "labels_complete": False,
                "adjudication_complete": False,
                "kappa_computed": False,
                "judge_validity_claimed": False,
            }
            if mutation == "blocker-gate8":
                blocker["gate8_met"] = True
            elif mutation == "blocker-required-input":
                blocker["required_operator_inputs"] = blocker[
                    "required_operator_inputs"
                ][1:]
            elif mutation == "blocker-prohibited-inference":
                blocker["prohibited_inferences"] = blocker["prohibited_inferences"][1:]
            elif mutation == "blocker-human-rater":
                blocker["human_raters"] = ["fabricated-rater"]
            blocker_path = final_root / "human-only-blocker.json"
            write_new(blocker_path, canonical(blocker))
            statuses = {
                "core": "complete_with_failures",
                "extended": "complete_with_failures",
                "native": "complete_with_failures",
                "phase7": "complete_with_explicit_limitations",
            }
            if mutation == "status-swap":
                statuses["core"] = "complete"
            selector_policies = {
                "common": dict(COMMON_SELECTION_POLICY),
                "source_task": dict(SOURCE_TASK_SELECTION_POLICY),
                "qualification": dict(QUALIFICATION_SELECTION_POLICY),
            }
            if mutation == "selector-policy":
                selector_policies["common"]["algorithm"] = "unversioned"
            preparation = {
                "schema": PREPARATION_SCHEMA,
                "status": "machine_preparation_complete_human_only_blocked",
                "authorized_input_manifest_sha256": authorized_sha,
                "gate5_inventory": {
                    "total": 46,
                    "runnable": HISTORICAL_GATE5_RUNNABLE,
                    "terminal": HISTORICAL_GATE5_TYPED_TERMINAL,
                    "native": 9,
                },
                "phase6_terminal_statuses": statuses,
                "selector_policies": selector_policies,
                "common_export": descriptor(common_path),
                "source_task_export": descriptor(source_path),
                "qualification_export": descriptor(qualification_path),
                "assignment_manifest": descriptor(assignment_path),
                "boundary_validation": descriptor(boundary_record_path),
                "workload": descriptor(workload_path),
                "codebook": descriptor(codebook),
                "human_only_blocker": descriptor(blocker_path),
                "human_fields_present": False,
                "target_calls": 0,
                "judge_calls": 0,
                "provider_http_attempts": 0,
                "downloads_observed_bytes": 0,
                "gate8_met": False,
            }
            preparation_path = final_root / "machine-preparation.json"
            write_new(preparation_path, canonical(preparation))
            artifacts = [
                descriptor(final_root / name) for name in PREPARED_ARTIFACT_NAMES
            ]
            artifacts.sort(key=lambda row: row["path"])
            inventory = {
                "schema": "ura-phase8-human-audit-artifact-inventory/1",
                "status": "machine_preparation_complete_human_only_blocked",
                "authorized_input_manifest_sha256": authorized_sha,
                "artifacts": artifacts,
                "artifact_count": 15,
                "target_calls": 0,
                "judge_calls": 0,
                "provider_http_attempts": 0,
                "downloads_observed_bytes": 0,
                "human_labels_present": False,
                "gate8_met": False,
            }
            inventory_path = final_root / "artifact-inventory.json"
            write_new(inventory_path, canonical(inventory))
            if mutation == "unexpected-artifact":
                write_new(final_root / "unsealed-human-labels.csv", b"label\nunsafe\n")
            terminal = {
                "schema": TERMINAL_SCHEMA,
                "status": "human_only_blocked",
                "controller_task_status": "machine_preparation_complete",
                "gate8_met": False,
                "authorized_input_manifest_sha256": authorized_sha,
                "artifact_inventory": descriptor(inventory_path),
                "human_only_blocker": descriptor(blocker_path),
                "minimum_independent_rating_count": 4,
                "qualified_raters_required": 2,
                "human_raters_observed": 0,
                "human_labels_observed": 0,
                "adjudications_observed": 0,
                "human_validity_claimed": False,
                "target_calls": 0,
                "judge_calls": 0,
                "provider_http_attempts": 0,
                "downloads_observed_bytes": 0,
            }
            return final_root, terminal, authorized_sha

        prepared_root, prepared_terminal, prepared_sha = build_prepared("valid")
        with_qualification_fixture(
            lambda: validate_phase8_terminal(
                prepared_terminal,
                final_root=prepared_root,
                authorized_input_sha=prepared_sha,
            )
        )
        passed()
        prepared_terminal_path = prepared_root / "machine-preparation-terminal.json"
        prepared_terminal_payload = canonical(prepared_terminal)
        terminal_finalizer_loads = [
            instruction
            for instruction in dis.get_instructions(execute_preparation)
            if instruction.opname in {"LOAD_GLOBAL", "LOAD_NAME"}
            and instruction.argval == "finalize_phase8_terminal"
        ]
        if len(terminal_finalizer_loads) != 1:
            raise AssertionError("production terminal finalizer call-site differs")
        passed()
        invalid_prepared_terminal = json.loads(json.dumps(prepared_terminal))
        invalid_prepared_terminal["human_labels_observed"] = 1
        rejected(
            lambda: with_qualification_fixture(
                lambda: finalize_phase8_terminal(
                    invalid_prepared_terminal,
                    terminal_path=prepared_terminal_path,
                    final_root=prepared_root,
                    authorized_input_sha=prepared_sha,
                )
            ),
            "terminal finalizer admitted a fabricated human label",
        )
        if prepared_terminal_path.exists() or prepared_terminal_path.is_symlink():
            raise AssertionError("rejected terminal finalization wrote an artifact")
        if not with_qualification_fixture(
            lambda: finalize_phase8_terminal(
                prepared_terminal,
                terminal_path=prepared_terminal_path,
                final_root=prepared_root,
                authorized_input_sha=prepared_sha,
            )
        ):
            raise AssertionError("self-test terminal was not created")
        with_qualification_fixture(
            lambda: validate_phase8_terminal(
                strict_object(
                    prepared_terminal_path,
                    label="created self-test machine-preparation terminal",
                ),
                final_root=prepared_root,
                authorized_input_sha=prepared_sha,
            )
        )
        passed()
        if with_qualification_fixture(
            lambda: finalize_phase8_terminal(
                prepared_terminal,
                terminal_path=prepared_terminal_path,
                final_root=prepared_root,
                authorized_input_sha=prepared_sha,
            )
        ):
            raise AssertionError("identical self-test terminal resume created a file")
        passed()
        rejected(
            lambda: create_or_match_sensitive_file(
                prepared_terminal_path,
                b"different terminal bytes\n",
                label="self-test machine-preparation terminal",
            ),
            "differing machine-preparation terminal resume",
        )
        terminal_link_source = root / "terminal-link-source.json"
        terminal_hardlink = root / "terminal-hardlink.json"
        write_new(terminal_link_source, prepared_terminal_payload)
        os.link(terminal_link_source, terminal_hardlink)
        rejected(
            lambda: create_or_match_sensitive_file(
                terminal_hardlink,
                prepared_terminal_payload,
                label="self-test linked machine-preparation terminal",
            ),
            "hard-linked machine-preparation terminal resume",
        )
        for tag, mutation, label in (
            ("human-label", "human-label", "fabricated prepared human label"),
            ("assigned", "assigned-rater", "fabricated prepared rater assignment"),
            ("blocker", "blocker-gate8", "fabricated Gate 8 blocker state"),
            (
                "blocker-input",
                "blocker-required-input",
                "omitted human operator requirement",
            ),
            (
                "blocker-inference",
                "blocker-prohibited-inference",
                "omitted prohibited human inference",
            ),
            (
                "blocker-rater",
                "blocker-human-rater",
                "fabricated human rater identity",
            ),
            ("status", "status-swap", "rewritten upstream terminal status"),
            (
                "selector-policy",
                "selector-policy",
                "rewritten Phase 8 selector policy",
            ),
            ("common-extra", "common-extra-column", "common CSV leak column"),
            (
                "common-order",
                "common-reordered-column",
                "common CSV reordered columns",
            ),
            ("source-extra", "source-extra-column", "source CSV leak column"),
            (
                "common-instructions",
                "common-instructions",
                "changed common rater instructions",
            ),
            (
                "source-instructions",
                "source-instructions",
                "changed source-task rater instructions",
            ),
            (
                "qualification-extra",
                "qualification-extra-column",
                "qualification CSV leak column",
            ),
            (
                "qualification-sibling",
                "qualification-sibling-substitution",
                "qualification sibling substitution with refreshed descriptors",
            ),
            ("codebook", "codebook-mismatch", "unbound human-audit codebook"),
            (
                "unexpected",
                "unexpected-artifact",
                "unsealed prepared-root artifact",
            ),
        ):
            mutated_root, _terminal, mutated_sha = build_prepared(tag, mutation)
            mutated_inventory = strict_object(
                mutated_root / "artifact-inventory.json",
                label="mutated Phase 8 inventory",
            )
            rejected(
                lambda mutated_inventory=mutated_inventory, mutated_root=mutated_root, mutated_sha=mutated_sha: (
                    with_qualification_fixture(
                        lambda: validate_prepared_inventory(
                            mutated_inventory,
                            final_root=mutated_root,
                            authorized_input_sha=mutated_sha,
                        )
                    )
                ),
                label,
            )
        bad_terminal = json.loads(json.dumps(prepared_terminal))
        bad_terminal["human_labels_observed"] = 1
        rejected(
            lambda: with_qualification_fixture(
                lambda: validate_phase8_terminal(
                    bad_terminal,
                    final_root=prepared_root,
                    authorized_input_sha=prepared_sha,
                )
            ),
            "terminal fabricated a human label",
        )
        bad_terminal = json.loads(json.dumps(prepared_terminal))
        bad_terminal["gate8_met"] = True
        rejected(
            lambda: with_qualification_fixture(
                lambda: validate_phase8_terminal(
                    bad_terminal,
                    final_root=prepared_root,
                    authorized_input_sha=prepared_sha,
                )
            ),
            "terminal fabricated Gate 8 completion",
        )

    print(
        json.dumps(
            {
                "schema": "ura-phase8-controller-self-test/1",
                "status": "passed",
                "mutation_checks": tests,
                "gate5_inventory_profiles": [
                    {
                        "runnable": HISTORICAL_GATE5_RUNNABLE,
                        "typed_terminal": HISTORICAL_GATE5_TYPED_TERMINAL,
                        "target_runtime_terminal": HISTORICAL_GATE5_TARGET_RUNTIME_TERMINAL,
                        "conditional_na_lanes": [DEFENSE_LOCAL_LANE],
                    },
                ],
                "human_claims_created": False,
            },
            sort_keys=True,
        )
    )
    rr_fixture_tmp.cleanup()
    return 0


def parser() -> argparse.ArgumentParser:
    ap = argparse.ArgumentParser(
        description="Prepare sealed blinded Phase 8 material without claiming human evidence."
    )
    mode = ap.add_mutually_exclusive_group(required=True)
    mode.add_argument("--prepare-input-manifest")
    mode.add_argument("--input-manifest")
    mode.add_argument("--execute-control-root", help=argparse.SUPPRESS)
    mode.add_argument("--self-test", action="store_true", help=argparse.SUPPRESS)
    ap.add_argument("--authorize-input-manifest-sha256", default="")
    ap.add_argument("--gate5-manifest")
    ap.add_argument("--gate5-runnote")
    ap.add_argument("--gate5-promotion-receipt")
    ap.add_argument("--phase6-core-completion")
    ap.add_argument("--phase6-extended-completion")
    ap.add_argument("--phase6-native-completion")
    ap.add_argument("--phase7-completion")
    ap.add_argument("--ethics-determination")
    ap.add_argument("--authorize-ethics-sha256", default="")
    ap.add_argument("--common-clusters", type=int)
    ap.add_argument("--source-task-clusters", type=int)
    ap.add_argument("--attempt-root", help=argparse.SUPPRESS)
    return ap


def main(argv: Sequence[str] | None = None) -> int:
    activate_source_only_imports()
    args = parser().parse_args(argv)
    if args.self_test:
        return self_test()
    if args.execute_control_root:
        if not args.attempt_root:
            raise Phase8Error("internal execution requires --attempt-root")
        return execute_entry(args)
    if args.prepare_input_manifest:
        required = (
            args.gate5_manifest,
            args.gate5_runnote,
            args.gate5_promotion_receipt,
            args.phase6_core_completion,
            args.phase6_extended_completion,
            args.phase6_native_completion,
            args.phase7_completion,
            args.ethics_determination,
            args.authorize_ethics_sha256,
            args.common_clusters,
            args.source_task_clusters,
        )
        if any(item in {None, ""} for item in required):
            raise Phase8Error("input preparation lacks one or more required arguments")
        if args.authorize_input_manifest_sha256:
            raise Phase8Error("input preparation may not use launch authorization")
        return prepare_input_manifest(args)
    if not args.authorize_input_manifest_sha256:
        raise Phase8Error("launch requires --authorize-input-manifest-sha256")
    forbidden = (
        args.gate5_manifest,
        args.gate5_runnote,
        args.gate5_promotion_receipt,
        args.phase6_core_completion,
        args.phase6_extended_completion,
        args.phase6_native_completion,
        args.phase7_completion,
        args.ethics_determination,
        args.authorize_ethics_sha256,
        args.common_clusters,
        args.source_task_clusters,
        args.attempt_root,
    )
    if any(item not in {None, ""} for item in forbidden):
        raise Phase8Error("launch accepts only the exact input manifest and its digest")
    return seal_and_launch(args)


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except Phase8Error as exc:
        print(f"PHASE8 ERROR: {exc}", file=sys.stderr)
        raise SystemExit(1) from None
