    )
    expected_sampling_index = {
        "schema": "ura-phase7-human-audit-sampling-view-index/1",
        "status": "complete",
        "view_receipt": value["human_audit_runner_input_view"],
        "lane_order": audit_runner_view_lanes,
        "revision_strata": sampling_contract["revision_strata"],
        "source_conformance_strata": sampling_contract[
            "source_conformance_strata"
        ],
        "sampling_only": True,
        "metric_pooling_permitted": False,
        "cross_revision_pooling_permitted": False,
        "cross_source_pooling_permitted": False,
        "all_successful_lanes_retained": True,
    }
    if (
