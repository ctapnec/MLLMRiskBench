    def rr_terminal_fixture(lane: str, index: int) -> dict[str, Any]:
        def artifact(kind: str) -> dict[str, Any]:
            value = dict(rr_projection_descriptors[(lane, kind)])
            if kind == "projection":
                value["file"] = Path(value["path"]).name
            elif kind == "request":
                value["envelope_id"] = f"request-{index}-{lane}"
                value["file"] = Path(value["path"]).name
            return value

        unavailable = {"status": "UNAVAILABLE", "value": None}
        return {
            "lane_id": lane,
            "family": "core",
            "disposition": "unavailable",
            "reason_code": RR_RUNTIME_TERMINAL_REASON_CODE,
            "reason": RR_RUNTIME_TERMINAL_REASON,
