#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

# Phase 6 controller for the six admitted Runner-safe bridge lanes and the six
# admitted exact-digest Ollama lanes. The controller launches one durable tmux
# session and attempts every lane sequentially. One lane failure is retained
# and does not hide later independent failures. A terminal partial attempt
# emits the same sealed completion schema with disjoint measured/failure lanes
# and exits 1; only measured-complete lanes are evidence.

usage() {
  printf '%s\n' \
    'usage:' \
    '  phase6_extended_measured.sh --gate5-manifest PATH --gate5-runnote PATH --gate5-promotion-receipt PATH --authorize-manifest-sha256 HEX' \
    '  phase6_extended_measured.sh --resume-control-root PATH' >&2
  exit 2
}

GATE5_MANIFEST=''
GATE5_RUNNOTE=''
GATE5_PROMOTION=''
AUTHORIZED_SHA=''
RESUME_ROOT=''
while (( "$#" )); do
  case "$1" in
    --gate5-manifest)
      (( "$#" >= 2 )) || usage
      GATE5_MANIFEST="$2"
      shift 2
      ;;
    --gate5-runnote)
      (( "$#" >= 2 )) || usage
      GATE5_RUNNOTE="$2"
      shift 2
      ;;
    --gate5-promotion-receipt)
      (( "$#" >= 2 )) || usage
      GATE5_PROMOTION="$2"
      shift 2
      ;;
    --authorize-manifest-sha256)
      (( "$#" >= 2 )) || usage
      AUTHORIZED_SHA="$2"
      shift 2
      ;;
    --resume-control-root)
      (( "$#" >= 2 )) || usage
      RESUME_ROOT="$2"
      shift 2
      ;;
    *) usage ;;
  esac
done

source ~/.ura_campaign_env
cd ~/MLLMRiskBench

EXPECTED_COMMIT='@@EXPECTED_COMMIT@@'
EXPECTED_FRAMEWORK_LOCK='@@FRAMEWORK_LOCK_SHA256@@'
EXPECTED_PROJECT_REVISION_MANIFEST='@@PROJECT_RECEIPT_PATH@@'
EXPECTED_PROJECT_REVISION_SHA256='@@PROJECT_RECEIPT_SHA256@@'
EXPECTED_SOURCE_CONFORMANCE_MANIFEST='@@SOURCE_RECEIPT_PATH@@'
EXPECTED_SOURCE_CONFORMANCE_SHA256='@@SOURCE_RECEIPT_SHA256@@'
PY="$PWD/.venv/bin/python"

test "$(git rev-parse HEAD)" = "$EXPECTED_COMMIT"
test -z "$(git status --porcelain)"
test "$URA_FRAMEWORK_LOCK_ID" = "$EXPECTED_FRAMEWORK_LOCK"
test "$URA_FRAMEWORK_STATE" = "$URA_WORK/runs/engineering/framework-runtime-${EXPECTED_FRAMEWORK_LOCK:0:12}"
test -x "$PY"
test "$URA_PROJECT_REVISION_MANIFEST" = "$EXPECTED_PROJECT_REVISION_MANIFEST"
test "$URA_PROJECT_REVISION_SHA256" = "$EXPECTED_PROJECT_REVISION_SHA256"
test "$URA_SOURCE_CONFORMANCE_MANIFEST" = "$EXPECTED_SOURCE_CONFORMANCE_MANIFEST"
test "$URA_SOURCE_CONFORMANCE_SHA256" = "$EXPECTED_SOURCE_CONFORMANCE_SHA256"
test "$(sha256sum -- "$URA_PROJECT_REVISION_MANIFEST" | awk '{print $1}')" = "$EXPECTED_PROJECT_REVISION_SHA256"
test "$(sha256sum -- "$URA_SOURCE_CONFORMANCE_MANIFEST" | awk '{print $1}')" = "$EXPECTED_SOURCE_CONFORMANCE_SHA256"

"$PY" - "$URA_SOURCE_CONFORMANCE_MANIFEST" <<'PY'
from pathlib import Path
import sys

from ura.source_conformance import validate_source_conformance_manifest
from ura.strict_json import strict_json_loads

receipt = validate_source_conformance_manifest(
    strict_json_loads(Path(sys.argv[1]).read_bytes())
)
registry = strict_json_loads(
    (Path.cwd() / "experiments" / "source-instances.json").read_bytes()
)
rows = receipt.get("arms")
if not isinstance(rows, list):
    raise SystemExit("source receipt arm inventory is invalid")
by_arm = {row.get("arm_id"): row for row in rows if isinstance(row, dict)}
admitted = [row for row in rows if row.get("disposition") == "admitted"]
blocked = [row for row in rows if row.get("disposition") == "blocked"]
if (
    not isinstance(registry, dict)
    or len(rows) != 45
    or len(by_arm) != 45
    or set(by_arm) != set(registry)
    or len(admitted) != 44
    or len(blocked) != 1
    or blocked[0].get("arm_id") != "bipia_test_qa"
):
    raise SystemExit(
        "source receipt is not the exact 45-row portfolio: "
        "44 admitted plus blocked bipia_test_qa"
    )
PY

checked_regular() {
  local unresolved="$1" resolved
  test -n "$unresolved"
  test ! -L "$unresolved"
  resolved="$(readlink -e -- "$unresolved")"
  test -f "$resolved" && test ! -L "$resolved"
  printf '%s\n' "$resolved"
}

initial_launch='yes'
if [[ -n "$RESUME_ROOT" ]]; then
  [[ -z "$GATE5_MANIFEST" && -z "$GATE5_RUNNOTE" && -z "$GATE5_PROMOTION" && -z "$AUTHORIZED_SHA" ]] || usage
  initial_launch='no'
  CONTROL_ROOT="$(readlink -e -- "$RESUME_ROOT")"
  test -d "$CONTROL_ROOT" && test ! -L "$CONTROL_ROOT"
  case "$CONTROL_ROOT" in
    "$URA_WORK"/runs/engineering/phase6-extended-measured-*) ;;
    *) printf 'unsafe Phase 6 control root: %s\n' "$CONTROL_ROOT" >&2; exit 1 ;;
  esac
  PAYLOAD_PATH="$(checked_regular "$CONTROL_ROOT/payload.py")"
  test "$(stat -c '%a' -- "$PAYLOAD_PATH")" = '700'
  test "$(stat -c '%h' -- "$PAYLOAD_PATH")" = '1'
  LAUNCH_META="$(checked_regular "$CONTROL_ROOT/launch.json")"
  mapfile -d '' -t resume_values < <(
    "$PY" - "$LAUNCH_META" "$EXPECTED_COMMIT" "$EXPECTED_FRAMEWORK_LOCK" \
      "$CONTROL_ROOT" "$PAYLOAD_PATH" <<'PY'
import hashlib
from pathlib import Path
import sys

from ura.strict_json import strict_json_loads

path = Path(sys.argv[1])
value = strict_json_loads(path.read_bytes())
required = {
    "schema", "expected_commit", "framework_lock_id", "manifest_sha256",
    "authorized_manifest_sha256", "manifest", "runnote", "control_root",
    "promotion_receipt", "payload",
}
if not isinstance(value, dict) or set(value) != required:
    raise SystemExit("invalid Phase 6 extended launch metadata")
if value["schema"] != "ura-phase6-extended-controller-launch/1":
    raise SystemExit("unsupported Phase 6 extended launch metadata")
if value["expected_commit"] != sys.argv[2] or value["framework_lock_id"] != sys.argv[3]:
    raise SystemExit("Phase 6 extended launch code identity changed")
if value["manifest_sha256"] != value["authorized_manifest_sha256"]:
    raise SystemExit("Phase 6 extended authorization no longer matches its manifest")
if value["control_root"] != sys.argv[4]:
    raise SystemExit("Phase 6 extended control-root identity changed")
expected_paths = {
    "manifest": Path(sys.argv[4]) / "inputs" / "covered-manifest.json",
    "runnote": Path(sys.argv[4]) / "inputs" / "RUNNOTE.md",
    "promotion_receipt": (
        Path(sys.argv[4]) / "inputs" / "RUNNOTE.gate5-promotion.receipt.json"
    ),
    "payload": Path(sys.argv[5]),
}
for key in ("manifest", "runnote", "promotion_receipt", "payload"):
    descriptor = value[key]
    if not isinstance(descriptor, dict) or set(descriptor) != {"path", "sha256", "bytes"}:
        raise SystemExit(f"stored {key} descriptor changed")
    candidate = Path(descriptor["path"])
    if (
        not candidate.is_absolute()
        or candidate.is_symlink()
        or not candidate.is_file()
        or candidate.resolve(strict=True) != candidate
        or candidate != expected_paths[key]
    ):
        raise SystemExit(f"stored {key} input is absent or unsafe")
    material = candidate.read_bytes()
    if len(material) != descriptor["bytes"] or hashlib.sha256(material).hexdigest() != descriptor["sha256"]:
        raise SystemExit(f"stored {key} input bytes changed")
    if key != "payload":
        print(str(candidate), end="\0")
print(value["manifest_sha256"], end="\0")
PY
  )
  test "${#resume_values[@]}" -eq 4
  GATE5_MANIFEST="${resume_values[0]}"
  GATE5_RUNNOTE="${resume_values[1]}"
  GATE5_PROMOTION="${resume_values[2]}"
  AUTHORIZED_SHA="${resume_values[3]}"
else
  [[ -n "$GATE5_MANIFEST" && -n "$GATE5_RUNNOTE" && -n "$GATE5_PROMOTION" && -n "$AUTHORIZED_SHA" ]] || usage
  [[ "$AUTHORIZED_SHA" =~ ^[0-9a-f]{64}$ ]] || usage
  GATE5_MANIFEST="$(checked_regular "$GATE5_MANIFEST")"
  GATE5_RUNNOTE="$(checked_regular "$GATE5_RUNNOTE")"
  GATE5_PROMOTION="$(checked_regular "$GATE5_PROMOTION")"
  test "$(sha256sum -- "$GATE5_MANIFEST" | awk '{print $1}')" = "$AUTHORIZED_SHA"

  TAG="$(date -u +%Y%m%dT%H%M%SZ)"
  CONTROL_ROOT="$URA_WORK/runs/engineering/phase6-extended-measured-${TAG}"
  test ! -e "$CONTROL_ROOT"
  mkdir -m 700 "$CONTROL_ROOT"
  mkdir -m 700 "$CONTROL_ROOT/inputs" "$CONTROL_ROOT/attempts" "$CONTROL_ROOT/lanes"

  "$PY" - "$GATE5_MANIFEST" "$CONTROL_ROOT/inputs/covered-manifest.json" \
    "$GATE5_RUNNOTE" "$CONTROL_ROOT/inputs/RUNNOTE.md" \
    "$GATE5_PROMOTION" "$CONTROL_ROOT/inputs/RUNNOTE.gate5-promotion.receipt.json" <<'PY'
import os
from pathlib import Path
import sys

for source_value, target_value in (
    (sys.argv[1], sys.argv[2]),
    (sys.argv[3], sys.argv[4]),
    (sys.argv[5], sys.argv[6]),
):
    source = Path(source_value)
    target = Path(target_value)
    payload = source.read_bytes()
    fd = os.open(target, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, "wb") as handle:
        handle.write(payload)
        handle.flush()
        os.fsync(handle.fileno())
PY
  GATE5_MANIFEST="$CONTROL_ROOT/inputs/covered-manifest.json"
  GATE5_RUNNOTE="$CONTROL_ROOT/inputs/RUNNOTE.md"
  GATE5_PROMOTION="$CONTROL_ROOT/inputs/RUNNOTE.gate5-promotion.receipt.json"
  PAYLOAD_PATH="$CONTROL_ROOT/payload.py"
fi

if [[ "$initial_launch" == 'yes' ]]; then
  "$PY" -c '
import os
import sys
path = sys.argv[1]
payload = sys.stdin.buffer.read()
fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o700)
with os.fdopen(fd, "wb") as handle:
    handle.write(payload)
    handle.flush()
    os.fsync(handle.fileno())
os.chmod(path, 0o700)
' "$PAYLOAD_PATH" <<'PHASE6_PAYLOAD'
