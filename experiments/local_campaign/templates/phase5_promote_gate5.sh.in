def exact_typed_int_contract(
    raw: object, expected: Mapping[str, Any], int_fields: Sequence[str]
) -> bool:
    return (
        isinstance(raw, Mapping)
        and dict(raw) == dict(expected)
        and all(type(raw.get(field)) is int for field in int_fields)
    )


