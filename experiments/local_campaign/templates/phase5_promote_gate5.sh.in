#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

# This controller never launches a model, framework, acquisition, or Runner job.
# First invocation validates evidence and writes one create-only promotion plan.
# Second invocation requires the exact plan SHA-256 and publishes only its bound
# canonical bytes.

if [[ ! -r "$HOME/.ura_campaign_env" ]]; then
  printf 'missing campaign environment: %s/.ura_campaign_env\n' "$HOME" >&2
  exit 2
fi
# shellcheck disable=SC1091
source "$HOME/.ura_campaign_env"

PROJECT_ROOT="${URA_PROJECT_ROOT:-$HOME/MLLMRiskBench}"
if [[ ! -d "$PROJECT_ROOT" ]]; then
  printf 'missing project checkout: %s\n' "$PROJECT_ROOT" >&2
  exit 2
fi
cd "$PROJECT_ROOT"

PY="$PROJECT_ROOT/.venv/bin/python"
if [[ ! -x "$PY" ]]; then
  printf 'missing project interpreter: %s\n' "$PY" >&2
  exit 2
fi

export PYTHONDONTWRITEBYTECODE=1
exec "$PY" - "$@" <<'PY'
from __future__ import annotations

import argparse
import copy
import ctypes
from datetime import datetime, timezone
