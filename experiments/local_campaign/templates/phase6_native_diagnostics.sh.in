#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

# Phase 6 controller for bounded, source-native framework diagnostics. The
# canaries are engineering diagnostics. They remain outside runs/thesis and
# are admitted only through each framework's complete native artifact contract.

usage() {
  printf '%s\n' \
    'usage:' \
    '  phase6_native_diagnostics.sh --plan-only --expected-commit 40HEX --out ABSOLUTE_PATH \' \
    '    --gate5-manifest PATH --gate5-runnote PATH --gate5-promotion-receipt PATH \' \
    '    --authorize-gate5-manifest-sha256 64HEX' \
    '  phase6_native_diagnostics.sh --plan PATH --authorize-plan-sha256 64HEX' \
    '  phase6_native_diagnostics.sh --resume-control-root PATH' >&2
  exit 2
}

MODE=''
EXPECTED_COMMIT=''
OUT=''
PLAN=''
AUTHORIZED_SHA=''
RESUME_ROOT=''
GATE5_MANIFEST=''
GATE5_RUNNOTE=''
GATE5_PROMOTION=''
GATE5_AUTHORIZED_SHA=''
while (( "$#" )); do
  case "$1" in
    --plan-only)
      [[ -z "$MODE" ]] || usage
      MODE='plan'
      shift
      ;;
    --expected-commit)
      (( "$#" >= 2 )) || usage
      EXPECTED_COMMIT="$2"
      shift 2
      ;;
    --out)
      (( "$#" >= 2 )) || usage
      OUT="$2"
      shift 2
      ;;
    --gate5-manifest)
      (( "$#" >= 2 )) || usage
      GATE5_MANIFEST="$2"
      shift 2
      ;;
    --gate5-runnote)
      (( "$#" >= 2 )) || usage
      GATE5_RUNNOTE="$2"
      shift 2
      ;;
    --gate5-promotion-receipt)
      (( "$#" >= 2 )) || usage
      GATE5_PROMOTION="$2"
      shift 2
      ;;
    --authorize-gate5-manifest-sha256)
      (( "$#" >= 2 )) || usage
      GATE5_AUTHORIZED_SHA="$2"
      shift 2
      ;;
    --plan)
      [[ -z "$MODE" ]] || usage
      MODE='launch'
      (( "$#" >= 2 )) || usage
      PLAN="$2"
      shift 2
      ;;
    --authorize-plan-sha256)
      (( "$#" >= 2 )) || usage
      AUTHORIZED_SHA="$2"
      shift 2
      ;;
    --resume-control-root)
      [[ -z "$MODE" ]] || usage
      MODE='resume'
      (( "$#" >= 2 )) || usage
      RESUME_ROOT="$2"
      shift 2
      ;;
    *) usage ;;
  esac
done

[[ -n "$MODE" ]] || usage
source ~/.ura_campaign_env
cd ~/MLLMRiskBench

export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HF_DATASETS_OFFLINE=1
unset HF_TOKEN HUGGING_FACE_HUB_TOKEN OPENAI_API_KEY ANTHROPIC_API_KEY \
  GOOGLE_API_KEY GEMINI_API_KEY MISTRAL_API_KEY TOGETHER_API_KEY \
  DEEPSEEK_API_KEY XAI_API_KEY
unset URA_MODEL_ACQUISITION_PLAN_DIR URA_MODEL_ACQUISITION_PLAN \
  URA_MODEL_ACQUISITION_PLAN_SHA256 URA_MODEL_ACQUISITION_RECEIPT \
  URA_MODEL_ACQUISITION_RECEIPT_SHA256 URA_MODEL_ACQUISITION_STORE

LOCK_ID='@@FRAMEWORK_LOCK_SHA256@@'
PROJECT_COMMIT='@@EXPECTED_COMMIT@@'
EXPECTED_PROJECT_REVISION_MANIFEST='@@PROJECT_RECEIPT_PATH@@'
EXPECTED_PROJECT_REVISION_SHA256='@@PROJECT_RECEIPT_SHA256@@'
EXPECTED_SOURCE_CONFORMANCE_MANIFEST='@@SOURCE_RECEIPT_PATH@@'
EXPECTED_SOURCE_CONFORMANCE_SHA256='@@SOURCE_RECEIPT_SHA256@@'
PY="$PWD/.venv/bin/python"
test -x "$PY"
test "$URA_FRAMEWORK_LOCK_ID" = "$LOCK_ID"
test "$URA_FRAMEWORK_LOCK" = "$PWD/experiments/framework_runtime_lock.json"
test "$URA_FRAMEWORK_STATE" = "$URA_WORK/runs/engineering/framework-runtime-${LOCK_ID:0:12}"
test -d "$URA_FRAMEWORK_ENVS"
test -x "$URA_FRAMEWORK_PYTHON"
test "$URA_PROJECT_REVISION_MANIFEST" = "$EXPECTED_PROJECT_REVISION_MANIFEST"
test "$URA_PROJECT_REVISION_SHA256" = "$EXPECTED_PROJECT_REVISION_SHA256"
test "$URA_SOURCE_CONFORMANCE_MANIFEST" = "$EXPECTED_SOURCE_CONFORMANCE_MANIFEST"
test "$URA_SOURCE_CONFORMANCE_SHA256" = "$EXPECTED_SOURCE_CONFORMANCE_SHA256"
test "$(sha256sum -- "$URA_PROJECT_REVISION_MANIFEST" | awk '{print $1}')" = "$EXPECTED_PROJECT_REVISION_SHA256"
test "$(sha256sum -- "$URA_SOURCE_CONFORMANCE_MANIFEST" | awk '{print $1}')" = "$EXPECTED_SOURCE_CONFORMANCE_SHA256"

"$PY" - "$URA_SOURCE_CONFORMANCE_MANIFEST" <<'PY'
from pathlib import Path
import sys

from ura.source_conformance import validate_source_conformance_manifest
from ura.strict_json import strict_json_loads

receipt = validate_source_conformance_manifest(
    strict_json_loads(Path(sys.argv[1]).read_bytes())
)
registry = strict_json_loads(
    (Path.cwd() / "experiments" / "source-instances.json").read_bytes()
)
rows = receipt.get("arms")
if not isinstance(rows, list):
    raise SystemExit("source receipt arm inventory is invalid")
by_arm = {row.get("arm_id"): row for row in rows if isinstance(row, dict)}
admitted = [row for row in rows if row.get("disposition") == "admitted"]
blocked = [row for row in rows if row.get("disposition") == "blocked"]
if (
    not isinstance(registry, dict)
    or len(rows) != 45
    or len(by_arm) != 45
    or set(by_arm) != set(registry)
    or len(admitted) != 44
    or len(blocked) != 1
    or blocked[0].get("arm_id") != "bipia_test_qa"
):
    raise SystemExit(
        "source receipt is not the exact 45-row portfolio: "
        "44 admitted plus blocked bipia_test_qa"
    )
PY

checked_regular() {
  local unresolved="$1" resolved
  test -n "$unresolved"
  test ! -L "$unresolved"
  resolved="$(readlink -e -- "$unresolved")"
  test -f "$resolved" && test ! -L "$resolved"
  printf '%s\n' "$resolved"
}

if [[ "$MODE" == 'plan' ]]; then
  [[ "$EXPECTED_COMMIT" =~ ^[0-9a-f]{40}$ && -n "$OUT" ]] || usage
  test "$EXPECTED_COMMIT" = "$PROJECT_COMMIT"
  [[ -n "$GATE5_MANIFEST" && -n "$GATE5_RUNNOTE" && -n "$GATE5_PROMOTION" ]] || usage
  [[ "$GATE5_AUTHORIZED_SHA" =~ ^[0-9a-f]{64}$ ]] || usage
  test "$(git rev-parse HEAD)" = "$EXPECTED_COMMIT"
  test -z "$(git status --porcelain)"
  [[ "$OUT" = /* ]] || usage
  OUT_PARENT="$(readlink -e -- "$(dirname -- "$OUT")")"
  test -d "$OUT_PARENT" && test ! -L "$OUT_PARENT"
  case "$OUT_PARENT" in
    "$URA_WORK"/runs/engineering|"$URA_WORK"/runs/engineering/*) ;;
    *) printf 'native plan output must be under the resolved engineering root\n' >&2; exit 1 ;;
  esac
  test ! -e "$OUT"
  GATE5_MANIFEST="$(checked_regular "$GATE5_MANIFEST")"
  GATE5_RUNNOTE="$(checked_regular "$GATE5_RUNNOTE")"
  GATE5_PROMOTION="$(checked_regular "$GATE5_PROMOTION")"
  test "$(sha256sum -- "$GATE5_MANIFEST" | awk '{print $1}')" = "$GATE5_AUTHORIZED_SHA"

  "$PY" - "$EXPECTED_COMMIT" "$OUT" "$LOCK_ID" "$GATE5_MANIFEST" \
    "$GATE5_RUNNOTE" "$GATE5_PROMOTION" "$GATE5_AUTHORIZED_SHA" \
    "$EXPECTED_PROJECT_REVISION_MANIFEST" \
    "$EXPECTED_PROJECT_REVISION_SHA256" <<'PY'
from __future__ import annotations

