models = {item.get("label"): item for item in transformers_raw["models"] if isinstance(item, dict)}
if set(models) != {"base", "rr"}:
    fail("RR Transformers base/control inventory changed")
base_raw = models["base"]
rr_raw = models["rr"]
special_ids = {"bos": 1, "eos": 2, "pad": 32001, "unk": 0}
if (
    base_raw.get("resource_id") != BASE_RESOURCE
    or base_raw.get("prompt_tokens") != 20
    or base_raw.get("completion_tokens") != 226
    or base_raw.get("last_token_is_eos") is not True
    or base_raw.get("special_token_ids") != special_ids
    or base_raw.get("special_token_counts")
    != {"bos": 0, "eos": 1, "pad": 0, "unk": 0}
    or not isinstance(base_raw.get("tail_token_ids"), list)
    or len(base_raw["tail_token_ids"]) != 64
    or base_raw["tail_token_ids"][-1] != 2
    or base_raw.get("text_sha256")
    != "7d966860772f8185567a9c1742536f823a49facfadaae6847a97069ddc011499"
    or rr_raw.get("resource_id") != TARGET_RESOURCE
    or rr_raw.get("prompt_tokens") != 20
    or rr_raw.get("completion_tokens") != 512
    or rr_raw.get("last_token_is_eos") is not False
    or rr_raw.get("unique_completion_tokens") != 2
    or rr_raw.get("most_common_token_counts") != [[644, 503], [22627, 9]]
    or rr_raw.get("special_token_ids") != special_ids
    or rr_raw.get("special_token_counts")
    != {"bos": 0, "eos": 0, "pad": 0, "unk": 0}
    or rr_raw.get("tail_token_ids") != [644] * 64
    or rr_raw.get("text_sha256")
    != "1f8e655ab40cbcd5a5ef23839d6845bd7aaa24ce7d693cfb29b077af590d1bbf"
):
    fail("RR Transformers base/control termination evidence changed")

value = {
    "schema": SCHEMA,
    "status": "unavailable",
    "disposition": "unavailable",
    "reason_code": REASON_CODE,
    "reason": REASON,
    "classified_at_utc": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
    "target": {
        "spec": TARGET_SPEC,
        "model": TARGET_MODEL,
        "revision": TARGET_REVISION,
        "resource_id": TARGET_RESOURCE,
        "runtime": "vllm",
        "runtime_version": "0.27.1",
        "modalities": ["text", "image"],
        "configured_max_tokens": 4096,
        "local_config": config_descriptor,
    },
    "bindings": {
        "classification_project_commit": expected_commit,
        "framework_lock_sha256": framework_lock,
        "project_revision": descriptor(project_receipt_path),
        "semantic_source_continuity": {
            "observed_project_commit": observed_commit,
            "unchanged_paths": CONTINUITY_PATHS,
            "git_diff_empty": True,
        },
        "evidence_roots": {
            "text_vllm_4096": tree_descriptor(text_root),
            "image_vllm_4096": tree_descriptor(image_root),
            "vllm_token_tail_512": tree_descriptor(tail_root),
            "transformers_reference_512": tree_descriptor(transformers_root),
        },
    },
    "observations": {
        "text_vllm_4096": {
            "modality": "text",
            "corpus": "strongreject_official",
            "sample_seeds": [0, 1, 8],
            "max_tokens": 4096,
            "finish_reasons": ["length", "length", "length"],
            "stop_reasons": [None, None, None],
            "successful_responses": 0,
            "error_artifacts": text_errors,
        },
        "image_vllm_4096": {
            "modality": "image",
            "corpus": "harmbench_multimodal",
            "sample_seed": 1,
            "max_tokens": 4096,
            "finish_reason": "length",
            "stop_reason": None,
            "successful_responses": 0,
            "error_artifact": image_error,
        },
        "vllm_token_tail_512": {
            "probe_schema": tail_raw["schema"],
            "max_tokens": 512,
            "prompt_tokens": tail_raw["prompt_tokens"],
            "completion_tokens": tail_raw["completion_tokens"],
            "finish_reason": tail_raw["finish_reason"],
            "stop_reason": tail_raw["stop_reason"],
            "unique_completion_tokens": tail_raw["unique_completion_tokens"],
            "most_common_token_counts": tail_raw["most_common_token_counts"],
            "special_token_ids": tail_raw["special_token_ids"],
            "special_token_counts": tail_raw["special_token_counts"],
            "text_sha256": tail_raw["text_sha256"],
            "probe_log": descriptor(tail_log),
        },
        "transformers_reference_512": {
            "probe_schema": transformers_raw["schema"],
            "generation": transformers_raw["generation"],
            "base": {
                "label": "base",
                "resource_id": base_raw["resource_id"],
                "prompt_tokens": base_raw["prompt_tokens"],
                "completion_tokens": base_raw["completion_tokens"],
                "last_token_is_eos": base_raw["last_token_is_eos"],
                "eos_token_id": base_raw["special_token_ids"]["eos"],
                "eos_token_count": base_raw["special_token_counts"]["eos"],
                "text_sha256": base_raw["text_sha256"],
            },
            "rr": {
                "label": "rr",
                "resource_id": rr_raw["resource_id"],
                "prompt_tokens": rr_raw["prompt_tokens"],
                "completion_tokens": rr_raw["completion_tokens"],
                "last_token_is_eos": rr_raw["last_token_is_eos"],
                "eos_token_id": rr_raw["special_token_ids"]["eos"],
                "eos_token_count": rr_raw["special_token_counts"]["eos"],
                "unique_completion_tokens": rr_raw["unique_completion_tokens"],
                "most_common_token_counts": rr_raw["most_common_token_counts"],
                "text_sha256": rr_raw["text_sha256"],
            },
            "probe_log": descriptor(transformers_log),
        },
    },
    "call_accounting": {
        "accounting_semantics": "durable_pre_call_logical_reservation_v1",
        "runner_target_call_reservations": 4,
        "vllm_diagnostic_generations": 1,
        "transformers_reference_generations": 2,
        "successful_rr_responses": 0,
        "hosted_target_calls": 0,
        "model_judge_calls": 0,
        "local_guardrail_evaluations": 0,
        "hosted_judge_calls": 0,
        "http_attempts": 0,
    },
    "applies_to_lanes": LANES,
    "evidence_eligible": False,
}

payload = (
    json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(",", ":"), allow_nan=False)
    + "\n"
).encode("utf-8")
if out.exists() or out.is_symlink():
    fail(f"RR terminal artifact is create-only: {out}")
try:
    parent = out.parent.resolve(strict=True)
except OSError as exc:
    fail(f"RR terminal artifact parent is invalid: {exc}")
fd = os.open(out, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
try:
    with os.fdopen(fd, "wb", closefd=True) as handle:
        fd = -1
        handle.write(payload)
        handle.flush()
        os.fsync(handle.fileno())
finally:
    if fd >= 0:
        os.close(fd)
dir_fd = os.open(parent, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
try:
    os.fsync(dir_fd)
finally:
    os.close(dir_fd)
PY
}


run_canary() {
  local lane="$1" spec="$2" config="$3" attackers="$4" arm="$5"
  local judges="$6" max_queries="$7" max_turns="$8" approximate="$9"
  local attestation_file="${10}" attestation_sha="${11}"
  local defense_enabled="${12:-no}"
  local config_sha rehearsal_base rehearsal_plan rehearsal_run diagnostic_base diagnostic_plan diagnostic_run
  local projection_id target_cap guard_evals eligibility canary_id stages target_status attacker_status source_status
  local target_attempts successful_target_generations
  config_sha="$(sha256sum -- "$config" | awk '{print $1}')"
  rehearsal_base="$PREFLIGHT_ROOT/${lane}-${TAG}"
  rehearsal_plan="$rehearsal_base/plan"
  rehearsal_run="$rehearsal_base/run"
  diagnostic_base="$DIAGNOSTIC_ROOT/${lane}-${TAG}"
  diagnostic_plan="$diagnostic_base/plan"
  diagnostic_run="$diagnostic_base/run"
  test ! -e "$rehearsal_base" && mkdir -p "$rehearsal_base"
  test ! -e "$diagnostic_base" && mkdir -p "$diagnostic_base"

  local -a common=(
    --project-revision "$PROJECT_RECEIPT"
    --project-revision-sha256 "$PROJECT_SHA256"
    --local "$spec"
    --local-config "$config"
    --local-config-sha256 "$config_sha"
    --attackers "$attackers"
    --judges "$judges"
    --corpora "$arm"
    --source-config "$SOURCE_CONFIG"
    --source-config-sha256 "$SOURCE_CONFIG_SHA256"
    --source-conformance "$SOURCE_RECEIPT"
    --source-conformance-sha256 "$SOURCE_RECEIPT_SHA256"
    --limit 1
    --sample-seed 0
    --seeds 0
    --max-queries "$max_queries"
    --max-turns "$max_turns"
    --group "$GROUP"
  )
  if [[ "$judges" == 'rules,guardrail' ]]; then
    common+=(
      --guardrail-model "$SCORE_GUARD"
      --guardrail-revision "$SCORE_GUARD_REV"
      --guardrail-device cuda:1
    )
  fi
  if [[ "$approximate" == 'yes' ]]; then
    common+=(--approximate-common-metrics)
  fi
  if [[ "$defense_enabled" == 'yes' ]]; then
    common+=(
      --defense both
      --defense-guard guardrail
      --defense-guardrail-model "$DEFENSE_GUARD"
      --defense-guardrail-revision "$DEFENSE_GUARD_REV"
      --defense-guardrail-device cuda:1
    )
  else
    test "$defense_enabled" = 'no'
  fi

  local -a rehearsal_args=(
    "${common[@]}"
    --max-total-target-calls 1000
    --max-total-http-attempts 0
    --deadline-seconds 3600
    --out "$rehearsal_run"
  )
  if [[ "$judges" == 'rules,guardrail' ]]; then
    rehearsal_args+=(--max-total-judge-calls 0)
  fi

  printf 'CANARY_REHEARSAL_START=%s TIME=%s\n' "$lane" "$(date -Is)"
  plan_acquire "${lane}-rehearsal" "$rehearsal_plan" \
    "${rehearsal_args[@]}" --preflight-only
  local -a acq=()
  while IFS= read -r -d '' item; do acq+=("$item"); done < <(acquisition_args)
  CUDA_VISIBLE_DEVICES=0,1 "$PY" -m experiments.rig_check \
    "${rehearsal_args[@]}" "${acq[@]}" > "$CONTROL_ROOT/${lane}.rehearsal.log" 2>&1
  read -r projection_id target_cap guard_evals < <(projection_fields "$rehearsal_run")

  test -f "$attestation_file" && test ! -L "$attestation_file"
  test "$(sha256sum -- "$attestation_file" | awk '{print $1}')" = "$attestation_sha"
  "$PY" -m experiments.live_attestation \
    --validate "$attestation_file" --sha256 "$attestation_sha" \
    > "$CONTROL_ROOT/${lane}.attestation-validate.log" 2>&1

  local -a canary_args=(
    "${common[@]}"
    --diagnostic-canary
    --execution-scope-id "$SCOPE"
    --live-attestation "$attestation_file"
    --live-attestation-sha256 "$attestation_sha"
    --live-attestation-max-age-hours "$MAX_ATTESTATION_AGE_HOURS"
    --max-total-target-calls "$target_cap"
    --max-total-http-attempts 0
    --deadline-seconds 3600
    --out "$diagnostic_run"
  )
  if [[ "$judges" == 'rules,guardrail' ]]; then
    canary_args+=(--max-total-judge-calls 0)
  fi

  plan_acquire "${lane}-canary" "$diagnostic_plan" "${canary_args[@]}"
  acq=()
  while IFS= read -r -d '' item; do acq+=("$item"); done < <(acquisition_args)
  local canary_rc conditional_artifact='' conditional_attempts='' conditional_successes=''
  set +e
  CUDA_VISIBLE_DEVICES=0,1 "$PY" -m experiments.run_matrix \
    "${canary_args[@]}" "${acq[@]}" > "$CONTROL_ROOT/${lane}.canary.log" 2>&1
  canary_rc=$?
  set -e
  if (( canary_rc != 0 )); then
    if [[ "$lane" == 'defense-local' && "$defense_enabled" == 'yes' ]]; then
      conditional_artifact="$CONTROL_ROOT/defense-local.conditional-na.json"
      if write_defense_conditional_na \
        "$conditional_artifact" "$CONTROL_ROOT/${lane}.canary.log" \
        "$diagnostic_run" "$canary_rc" "$spec" "$config" "$config_sha" \
        "$arm" "$target_cap" "$attestation_file" "$attestation_sha" \
        "$ACQ_PLAN_PATH" "$ACQ_PLAN_SHA" "$ACQ_RECEIPT_PATH" "$ACQ_RECEIPT_SHA" \
        "$CONTROL_ROOT/${lane}-canary.acquire.log"
      then
        conditional_attempts=0
        conditional_successes=0
      elif write_defense_output_noncompletion_na \
        "$conditional_artifact" "$CONTROL_ROOT/${lane}.canary.log" \
        "$diagnostic_run" "$canary_rc" "$spec" "$config" "$config_sha" \
        "$arm" "$target_cap" "$attestation_file" "$attestation_sha" \
        "$ACQ_PLAN_PATH" "$ACQ_PLAN_SHA" "$ACQ_RECEIPT_PATH" "$ACQ_RECEIPT_SHA" \
        "$CONTROL_ROOT/${lane}-canary.acquire.log"
      then
        conditional_attempts=1
        conditional_successes=0
      else
        return "$canary_rc"
      fi
      if [[ -f "$conditional_artifact" && ! -L "$conditional_artifact" ]]; then
        printf '%s\t%s\t%s\t%s\t\t\t\t\t\tconditional_na\t%s\t\t%s\t%s\n' \
          "$lane" "$projection_id" "$target_cap" "$guard_evals" \
          "$conditional_artifact" "$conditional_attempts" \
          "$conditional_successes" | tee -a "$STATUS"
        printf 'CANARY_CONDITIONAL_NA=%s ARTIFACT=%s TIME=%s\n' \
          "$lane" "$conditional_artifact" "$(date -Is)"
        return 0
      fi
    fi
    return "$canary_rc"
  fi

  mapfile -t eligibility_files < <(find "$diagnostic_run" -maxdepth 1 -type f \
    -name 'eligibility-*.eligibility.json' -print | sort)
  test "${#eligibility_files[@]}" -eq 1
  eligibility="${eligibility_files[0]}"
  "$PY" -m experiments.lane_canary \
    --results "$diagnostic_run" \
    --eligibility "$eligibility" \
    --out-dir "$diagnostic_run" > "$CONTROL_ROOT/${lane}.lane-canary.log" 2>&1
  IFS=$'\t' read -r canary_id stages target_status attacker_status source_status \
    target_attempts successful_target_generations < <(
    canary_fields "$diagnostic_run" "$spec" "$config" "$config_sha" \
      "$attackers" "$arm" "$judges" "$max_queries" "$max_turns" \
      "$approximate" "$target_cap" "$defense_enabled"
  )
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\trunnable\t\t\t%s\t%s\n' \
    "$lane" "$projection_id" "$target_cap" "$guard_evals" "$canary_id" \
    "$stages" "$target_status" "$attacker_status" "$source_status" \
    "$target_attempts" "$successful_target_generations" | tee -a "$STATUS"
  printf 'CANARY_END=%s TIME=%s\n' "$lane" "$(date -Is)"
}

QWEN='vllm:Qwen/Qwen3-VL-8B-Instruct'
QWEN_CFG="$PWD/experiments/local-qwen3-vl.json"
BASE='vllm:llava-hf/llava-v1.6-mistral-7b-hf'
BASE_CFG="$PWD/experiments/local-llava-base.json"
RR_CFG="$PWD/experiments/local-llava-rr.json"
RR_TERMINAL="$CONTROL_ROOT/llava-rr.target-runtime-terminal.json"

write_rr_target_runtime_terminal "$RR_TERMINAL" "$RR_CFG"
test -f "$RR_TERMINAL" && test ! -L "$RR_TERMINAL"
for lane in \
  local-llava-rr-text-full local-llava-rr-image-full \
  rjudge-llava-rr gptgeochat-llava-rr
do
  printf '%s\t\t\t\t\t\t\t\t\tunavailable\t\t%s\t\t\n' \
    "$lane" "$RR_TERMINAL" | tee -a "$STATUS"
done

probe_target qwen3-vl text "$QWEN" "$QWEN_CFG" strongreject_official 0 1 8
QWEN_TEXT_ATTEST="$LAST_ATTESTATION_FILE"; QWEN_TEXT_SHA="$LAST_ATTESTATION_SHA"
probe_target qwen3-vl image "$QWEN" "$QWEN_CFG" harmbench_multimodal 1 4 6 0 5
QWEN_IMAGE_ATTEST="$LAST_ATTESTATION_FILE"; QWEN_IMAGE_SHA="$LAST_ATTESTATION_SHA"
probe_target llava-base text "$BASE" "$BASE_CFG" strongreject_official 0 1 8
BASE_TEXT_ATTEST="$LAST_ATTESTATION_FILE"; BASE_TEXT_SHA="$LAST_ATTESTATION_SHA"
probe_target llava-base image "$BASE" "$BASE_CFG" harmbench_multimodal 1 4 6 0 5
BASE_IMAGE_ATTEST="$LAST_ATTESTATION_FILE"; BASE_IMAGE_SHA="$LAST_ATTESTATION_SHA"

run_canary local-qwen3-vl-text-primary-100 "$QWEN" "$QWEN_CFG" replay airbench_full rules,guardrail 1 1 yes "$QWEN_TEXT_ATTEST" "$QWEN_TEXT_SHA"
run_canary local-qwen3-vl-image-primary-100 "$QWEN" "$QWEN_CFG" replay mmsafety_official rules,guardrail 1 1 yes "$QWEN_IMAGE_ATTEST" "$QWEN_IMAGE_SHA"
run_canary local-llava-base-text-primary-100 "$BASE" "$BASE_CFG" replay airbench_full rules,guardrail 1 1 yes "$BASE_TEXT_ATTEST" "$BASE_TEXT_SHA"
run_canary local-llava-base-image-primary-100 "$BASE" "$BASE_CFG" replay mmsafety_official rules,guardrail 1 1 yes "$BASE_IMAGE_ATTEST" "$BASE_IMAGE_SHA"

run_canary rjudge-qwen3-vl "$QWEN" "$QWEN_CFG" replay rjudge_release rules 1 1 no "$QWEN_TEXT_ATTEST" "$QWEN_TEXT_SHA"
run_canary rjudge-llava-base "$BASE" "$BASE_CFG" replay rjudge_release rules 1 1 no "$BASE_TEXT_ATTEST" "$BASE_TEXT_SHA"
run_canary gptgeochat-qwen3-vl "$QWEN" "$QWEN_CFG" replay gptgeochat_release rules 1 1 no "$QWEN_IMAGE_ATTEST" "$QWEN_IMAGE_SHA"
run_canary gptgeochat-llava-base "$BASE" "$BASE_CFG" replay gptgeochat_release rules 1 1 no "$BASE_IMAGE_ATTEST" "$BASE_IMAGE_SHA"

run_canary crescendo-qwen3-vl "$QWEN" "$QWEN_CFG" crescendo cyberseceval_mitre rules,guardrail 4 4 yes "$QWEN_TEXT_ATTEST" "$QWEN_TEXT_SHA"
run_canary defense-local "$QWEN" "$QWEN_CFG" replay jailbreakbench_benign rules,guardrail 1 1 yes "$QWEN_TEXT_ATTEST" "$QWEN_TEXT_SHA" yes

IFS=$'\t' read -r TARGET_ATTEMPTS SUCCESSFUL_TARGET_GENERATIONS < <(
"$PY" - "$STATUS" "$ATTEST_STATUS" "$ATTEST_FAILURES" <<'PY'
import csv
import pathlib
import sys

from experiments.local_campaign.target_execution import aggregate_target_execution

with open(sys.argv[1], encoding="utf-8", newline="") as handle:
    rows = list(csv.DictReader(handle, delimiter="\t"))
if len(rows) != 14:
    raise SystemExit(f"expected 14 core canary rows, found {len(rows)}")
expected_lanes = {
    "local-qwen3-vl-text-primary-100", "local-qwen3-vl-image-primary-100",
    "local-llava-base-text-primary-100", "local-llava-base-image-primary-100",
    "local-llava-rr-text-full", "local-llava-rr-image-full",
    "rjudge-qwen3-vl", "rjudge-llava-base", "rjudge-llava-rr",
    "gptgeochat-qwen3-vl", "gptgeochat-llava-base", "gptgeochat-llava-rr",
    "crescendo-qwen3-vl", "defense-local",
}
if {row["lane"] for row in rows} != expected_lanes:
    raise SystemExit("core canary lane inventory differs")
rr_lanes = {
    "local-llava-rr-text-full", "local-llava-rr-image-full",
    "rjudge-llava-rr", "gptgeochat-llava-rr",
}
failures = []
rr_artifacts = set()
execution_rows = []
for row in rows:
    lane = row["lane"]
    disposition = row["disposition"]
    if lane in rr_lanes:
        artifact = pathlib.Path(row["target_runtime_terminal_artifact"])
        if (
            disposition != "unavailable"
            or any(row[field] for field in (
                "rehearsal_projection_id", "target_cap",
                "local_guardrail_evaluations", "canary_id",
                "all_configured_stages_represented", "target_status",
                "attacker_status", "source_evaluator_status",
                "conditional_na_artifact",
                "target_attempts", "successful_target_generations",
            ))
            or not artifact.is_absolute()
            or artifact.is_symlink()
            or not artifact.is_file()
        ):
            failures.append(f"{lane}: RR target-runtime terminal row is malformed")
        else:
            rr_artifacts.add(str(artifact.resolve()))
        continue
    if lane == "defense-local" and disposition == "conditional_na":
        artifact = pathlib.Path(row["conditional_na_artifact"])
        if (
            row["canary_id"]
            or row["all_configured_stages_represented"]
            or row["target_status"]
            or row["attacker_status"]
            or row["source_evaluator_status"]
            or row["target_runtime_terminal_artifact"]
            or not artifact.is_absolute()
            or artifact.is_symlink()
            or not artifact.is_file()
        ):
            failures.append("defense-local: conditional N/A status row is malformed")
        else:
            execution_rows.append(row)
        continue
    if (
        disposition != "runnable"
        or row["conditional_na_artifact"]
        or row["target_runtime_terminal_artifact"]
    ):
        failures.append(f"{lane}: unexpected canary disposition/artifact")
        continue
    if lane.startswith(("rjudge-", "gptgeochat-")):
        if row["source_evaluator_status"] != "exercised":
            failures.append(f"{lane}: source evaluator was not exercised")
    elif row["all_configured_stages_represented"] != "true":
        failures.append(f"{lane}: not all configured scoring stages were represented")
    execution_rows.append(row)
if len(rr_artifacts) != 1:
    failures.append("RR terminal lanes do not share one exact target-runtime artifact")

with open(sys.argv[2], encoding="utf-8", newline="") as handle:
    attestations = list(csv.DictReader(handle, delimiter="\t"))
expected_attestations = {
    ("qwen3-vl", "text"), ("qwen3-vl", "image"),
    ("llava-base", "text"), ("llava-base", "image"),
}
if (
    len(attestations) != 4
    or {(row["target"], row["modality"]) for row in attestations}
    != expected_attestations
):
    failures.append("core target attestation inventory drift")
else:
    execution_rows.extend(attestations)
if failures:
    raise SystemExit("; ".join(failures))
with open(sys.argv[3], encoding="utf-8", newline="") as handle:
    failed_attestations = list(csv.DictReader(handle, delimiter="\t"))
execution = aggregate_target_execution(
    execution_rows,
    accounting_unavailable=bool(failed_attestations),
)
if execution is None:
    print("UNAVAILABLE", "UNAVAILABLE", sep="\t")
else:
    print(*execution, sep="\t")
PY
)
if [[ "$TARGET_ATTEMPTS" == 'UNAVAILABLE' ]]; then
  test "$SUCCESSFUL_TARGET_GENERATIONS" = 'UNAVAILABLE'
  printf 'TARGET_EXECUTION_UNAVAILABLE=failed_attestation_candidates\n'
else
  PYTHONDONTWRITEBYTECODE=1 "$PY" -m experiments.local_campaign.console_events \
    target-execution --work-root "$URA_WORK" --control-root "$CONTROL_ROOT" \
    --target-attempts "$TARGET_ATTEMPTS" \
    --successful-target-generations "$SUCCESSFUL_TARGET_GENERATIONS"
fi

printf 'PHASE5_CORE_CANARIES_COMPLETE=%s\n' "$(date -Is)"
INNER
)"

PAYLOAD_PATH="$CONTROL_ROOT/payload.sh"
test ! -e "$PAYLOAD_PATH"
umask 077
printf '%s\n' "$PAYLOAD" > "$PAYLOAD_PATH"
chmod 700 "$PAYLOAD_PATH"
test -f "$PAYLOAD_PATH" && test ! -L "$PAYLOAD_PATH"
tmux -L "$SOCKET" new-session -d -s "$SESSION" \
  "exec bash $(printf '%q' "$PAYLOAD_PATH")"

printf 'SESSION=%s\n' "$SESSION"
printf 'SOCKET=%s\n' "$SOCKET"
printf 'ATTACH=tmux -L %s attach -t %s\n' "$SOCKET" "$SESSION"
printf 'CONTROL_ROOT=%s\n' "$CONTROL_ROOT"
printf 'LOG=%s/phase5-canary.log\n' "$CONTROL_ROOT"
printf 'EXIT_MARKER=%s/.exit\n' "$CONTROL_ROOT"
