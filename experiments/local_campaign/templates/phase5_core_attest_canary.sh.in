transformers_log = transformers_root / "probe.log"
if set(item.name for item in transformers_root.iterdir()) != {".exit", "probe.log"}:
    fail("RR Transformers evidence file inventory changed")
transformers_raw = engineering_json_line(
    transformers_log, "ura-engineering-transformers-termination-probe/1"
)
if (
